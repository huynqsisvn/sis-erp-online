    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string _SEARCH_TYPE = "";
        if (firstRender)
        {
            try
            {
                _SEARCH_TYPE = options.GetOptionsValue("M_SEARCH_TYPE").Trim();
                M_GRD_CELL_Color = options.GetOptionsValue("M_GRD_CELL_CL").Trim();
                M_GRD_CELL_BG_Color = options.GetOptionsValue("M_GRD_CELL_BG").Trim();
                M_GRD_HEAD_BG_Color = options.GetOptionsValue("M_GRD_HEAD_BG").Trim();
                M_GRD_HEAD_Color = options.GetOptionsValue("M_GRD_HEAD_CL").Trim();
                M_GRD_FOOTER_BG_Color = options.GetOptionsValue("M_GRD_FOOTER_BG").Trim();
                M_GRD_FOOTER_Color = options.GetOptionsValue("M_GRD_FOOTER_CL").Trim();
                if (string.IsNullOrEmpty(_SEARCH_TYPE))
                {
                    _GridSearchTextParseMode = GridSearchTextParseMode.GroupWordsByOr;
                }
                else
                {
                    if (_SEARCH_TYPE.Equals("0"))
                    {
                        _GridSearchTextParseMode = GridSearchTextParseMode.GroupWordsByOr;
                    }
                    else if (_SEARCH_TYPE.Equals("1"))
                    {
                        _GridSearchTextParseMode = GridSearchTextParseMode.GroupWordsByAnd;
                    }
                    else if (_SEARCH_TYPE.Equals("2"))
                    {
                        _GridSearchTextParseMode = GridSearchTextParseMode.ExactMatch;
                    }
