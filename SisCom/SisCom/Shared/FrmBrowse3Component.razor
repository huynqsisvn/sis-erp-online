    [Parameter]
    public bool EnableCheck { get; set; } = true;
    [Parameter]
    public string SelectCol { get; set; } = "checkcol";
    [Parameter]
    public EventCallback<bool> CheckChangedCallBack { get; set; }
    void CheckedChanged(bool value, DataRowView rowval)
    {
        if (rowval.Row.Table.Columns[SelectCol].DataType == typeof(bool))
            rowval.Row[SelectCol] = value;
        else
            rowval.Row[SelectCol] = (value ? "1" : "0");
        CheckChangedCallBack.InvokeAsync(true);
    }

    bool? _SelectAll = false;
    bool? SelectAll
    {
        get => _SelectAll;
        set
        {
            _SelectAll = value;
            CheckAll(value);
        }
    }
    private void CheckAll(bool? chkVal)
    {
        if (chkVal == true)
        {
            foreach (DataRow row in TblData.Rows)
            {
                if (row.Table.Columns[SelectCol].DataType == typeof(bool))
                    row[SelectCol] = true;
                else
                    row[SelectCol] = "1";
            }
        }
        else
        {
            foreach (DataRow row in TblData.Rows)
            {
                if (row.Table.Columns[SelectCol].DataType == typeof(bool))
                    row[SelectCol] = false;
                else
                    row[SelectCol] = "0";
            }
        }
    }
    public DataTable GetFilterTable()
    {
        DataTable dat = Grid.Data as DataTable;
        DataTable tblmoi = dat.Clone();
        for (int i = 0; i < Grid.GetVisibleRowCount(); i++)
        {
            DataRow a = (Grid.GetDataItem(i) as DataRowView).Row;
            tblmoi.Rows.Add(a.ItemArray);
        }
        return tblmoi;
    }
