@layout Empty
@inject NavigationManager navigation
@inject Statemanagerment myStatemanagerment
@inject ICommandManager Commands
@inject IDbManager myDb
@inject IChatService SisChatService

@using System.Globalization
@using System.Timers

@inject ILocalStorageService Localstore
@implements IDisposable
@inject IStringLocalizer<App> Lap

<DxLayoutBreakpoint MaxWidth="1025" @bind-IsActive="@IsMobileLayout"/>
<DxLayoutBreakpoint MaxWidth="600" @bind-IsActive="@IsMobile" />

<div>
    <div class="row align-items-center">
        <div class="d-flex justify-content-between">
            <div class="d-flex justify-content-start">
                <div class="justify-content-center dropdown">
                    <div class="dropdown-body">
                        <button class="col-ali dropbtn" id="dropfButton">
                            <img class="ipicture" src="./Images/erpFav.svg" />
                            @if (!IsMobileLayout)
                            {
                                <span class="icaption pt-2">@Lap["Favourite"]</span>
                                <img style="width:8px;height:9px;margin-right:10px;" src="./Images/erpSe.png" />
                            }
                        </button>
                        <div class="dropdown-content" aria-labelledby="dropfButton">
                            @foreach (Command _command in LSCommand)
                            {
                                string strsrc = (!IsLangEn ? _command.Bar : _command.Bar2);
                                <a @onclick="() => OnComandChanged(_command)" style="cursor:pointer;"> @strsrc </a>
                            }
                        </div>
                    </div>
                </div>
                <div class="justify-content-center dropdown">
                    <div class="dropdown-body">
                        <button class="col-ali dropbtn" id="droppButton">
                            <span class="icaption pt-2" style="margin-left:20px;"> @strdvcs </span>
                            <img style="width:8px;height:9px;margin-right:10px;" src="./Images/erpSe.png" />
                        </button>
                        <div class="dropdown-content" aria-labelledby="droppButton">
                            @foreach (Dmdvcs dvcs in LSDVCS)
                            {
                                string strsrc = (!IsLangEn ? dvcs.Ten_dvcs : dvcs.Ten_dvcs2);
                                <a @onclick="() => OnDVCSChanged(dvcs.Ma_dvcs)" style="cursor:pointer;"> @strsrc </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            @(new MarkupString(String.IsNullOrEmpty(strtb) || IsMobileLayout ? "" : strtb))
            <div class="d-flex justify-content-end">
                <div class="d-flex align-items-center">
                    <div class="col-ali d-flex align-items-center">
                        <div Id="flyout-placement-target-mail" class="col-ald" style="cursor:pointer;" @onclick="OnMail_click">
                            <img class="ipicture" src="./Images/erpEmail.svg" title=@Lap["Works"]/>
                            <span class="@_blinkEmail">@Slemail</span>
                        </div>
                        <div Id="flyout-placement-target-Alert" class="col-ald" style="cursor:pointer;" @onclick="OnAlert_click">
                            <img class="ipicture" style="margin-left:10px;" src="./Images/erpAlert.svg" title=@Lap["Notices"] />
                            <span class="@_blinkAlert">@Slalter</span>
                        </div>
                    </div>

                    @if (!IsMobileLayout)
                    {
                        <div style="width:20px;"></div>
                        <div class="col-ali">
                            <div class="d-flex justify-content-center">
                                <div class="img-with-text" @onclick="OnSis_click" >
                                    <img class="fpicture" src="./Images/erpWeb.svg" alt="https://sis.vn" title="Website" />
                                    <p class="ismallcaption">Website</p>
                                </div>

                                <div class="img-with-text" @onclick="OnSis_click">
                                    <img class="fpicture" src="./Images/erpHelp.svg" alt="https://sis.vn" title="@Lap["Help"]" />
                                    <p class="ismallcaption">@Lap["Help"]</p>
                                </div>

                                <div class="img-with-text" @onclick="OnSis_click">
                                    <img class="fpicture" src="./Images/erpInfo.svg" alt="https://sis.vn" title="@Lap["Infor"]" />
                                    <p class="ismallcaption">@Lap["Infor"]</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="justify-content-end dropdown">
                    <button class="col-ali" Id="flyout-placement-target-container" @onclick="OnUser_click">
                        @if (!IsMobileLayout)
                        {
                            <img class="ipicture" src="./Images/erpUser.svg" />
                            <span class="icaption">@strUser</span>
                            <img style="width:8px;height:9px;margin-right:10px;" src="./Images/erpSe.png" />
                        }
                        else
                        {
                            <span class="icaption">@strUser</span>
                        }
                    </button>
                </div>
                <div class="justify-content-end dropdown">
                    <button class="col-ali dropbtn" id="dropdButton" style="width:65px;margin-right:1px;">
                        <img class="ipicture" src="@srclang" />
                        <img style="width:8px;height:9px;margin-left:7px;" src="./Images/erpSe.png" />
                    </button>
                    <div class="dropdown-content" aria-labelledby="dropdButton" style="left:-50%">
                        <a @onclick="SetLangVi">
                            <img src="./Images/Viflag.png"
                                 width="18" height="15"> Tiếng Việt
                        </a>
                        <a @onclick="SetLangEn">
                            <img src="./Images/Enflag.png"
                                 width="18" height="15"> English
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<DxFlyout @bind-IsOpen="IsOpen"
          PositionTarget="#flyout-placement-target-container"
          Position="FlyoutPosition.Auto"
          RestrictionTarget="#Navigation-Flyout-Overview"
          FitToRestriction=false
          CloseMode="FlyoutCloseMode.Close"
          HeaderVisible="false"
          FooterVisible="true"
          HeaderText="Header"
          Width="max(25vw, 400px)">
    <BodyContentTemplate>
        <div class="w-100 custom-flyout-body">
            <EmployeeCard EmployeeInfo=@_curUser OnHideClick="HideClickHandler" />
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="w-100">
            <div class="custom-flyout-footer justify-content-center">
                <div class="row m-0">
                    <button class="col-ali1" @onclick=@(()=> {IsOpen = false;})>
                        <span class="icaption">@Lap["Cancel"]</span>
                    </button>
                </div>
            </div>
        </div>
    </FooterContentTemplate>
</DxFlyout>

