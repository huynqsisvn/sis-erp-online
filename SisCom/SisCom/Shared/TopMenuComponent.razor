        }
        StateHasChanged();
    }
    async void OnReloadNotification(string NotificationID)
    {
        if (!string.IsNullOrEmpty(NotificationID))
        {
            DataRow? _row = TblNotification.Select(string.Format("NotificationID = '{0}'", NotificationID)).FirstOrDefault();
            if (_row != null)
            {               
                string sql = string.Format("Update [Notification] set users_check = '' where NotificationID = '{0}' AND users_check is null;Update [Notification] set users_check = RTRIM(users_check) + '{1};' where NotificationID = '{0}'", NotificationID, _curUser.User_name);
                await myDb.ExecuteSqlQueryAsync(sql);
                await LoadNotification(_curUser.User_name, AlertLoai);
                StateHasChanged();
            }
        }
    }
