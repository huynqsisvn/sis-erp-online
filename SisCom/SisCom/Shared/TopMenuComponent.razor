        aTimer = new System.Timers.Timer(3000);
        aTimer.Elapsed += CountDownTimer;
        aTimer.Enabled = true;
    }
    void CountDownTimer(Object source, ElapsedEventArgs e)
    {
        if (LSmessage.Count > 0)
        {
            Notification _curMessage = LSmessage.Dequeue();
            myStatemanagerment.SetNewThongbao(_curMessage.Noi_dung);
        }
