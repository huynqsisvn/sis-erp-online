    public async void BrowDMClick(object Item,string Ifiled,object Ivalue, string Idm = "")
    {
        if(Item != null)
            SelectedDataItem = Item;
        #region Tim DMDM
        string _ma_dm = Idm.Substring(6);
        string sqltext = string.Format("Select * from dmdm where lower(ma_dm) = '{0}'", _ma_dm);
        DataSet ds = await myDb.LoadDataset(sqltext);
        if (ds.Tables[0].Rows.Count <= 0 && !String.IsNullOrEmpty(Ifiled))
        {
            sqltext = string.Format("Select top 1 * from dmdm where lower([key]) = '{0}' order by ma_dm", Ifiled.ToLower().Trim());
            ds = await myDb.LoadDataset(sqltext);
        }

        if (ds.Tables[0].Rows.Count <= 0)
        {
            myStatemanagerment.SetNewThongbao(@Lap["No data selected"] + " !");
            return;
        }
        Dmdm lsdm = myDb.ConvertDataTable<Dmdm>(ds.Tables[0])[0];
        if (lsdm == null)
            return;
        _ma_dm = lsdm.Ma_dm;
        #endregion

        ICommandManager comm = myStatemanagerment.GetCommand();
        Command _command = comm.GetMenuByStore(_ma_dm.Trim().ToLower());
        if (_command == null)
        {
            myStatemanagerment.SetNewThongbao(@Lap["No Command"] + " !");
            return;
        }        

        string _form = _command.Mobile_page.ToLower().Trim();
        string pmenu_id = _command.Menu_id.Trim();
        if (!String.IsNullOrEmpty(pmenu_id) && !String.IsNullOrEmpty(_command.Mobile_page) && !String.IsNullOrEmpty(_form))
        {
            Users curuser = await Lcstore.GetItemAsync<Users>("user");
            if (curuser == null)
            {
                myStatemanagerment.SetNewThongbao(@Lap["No User, Please log back in"] + " !");
                return;
            }
            if(!curuser.CheckRight(pmenu_id,"EDIT") && !curuser.CheckRight(pmenu_id,"READ"))
            {
                myStatemanagerment.SetNewThongbao(@Lap["You don't have permission"] + " !");
                return;
            }
            ActionTask pActionTask = ActionTask.View;
            @* if(curuser.CheckRight(pmenu_id,"EDIT"))
            {
                pActionTask= ActionTask.Edit;
            } *@

            SisType sTypw = mySType.GetValue(_command.Mobile_page.ToLower().Trim());
            if (sTypw != null)
            {
                Dictionary<string, object> Par = new Dictionary<string, object>();
                Par.Add("Ma_ma", (object)Ivalue);                
                Par.Add("Menu_id", (object)pmenu_id);
                Par.Add("ShowAdd", (object)true);                
                Par.Add("curActionTask", (object)pActionTask);

                string tname = (String.IsNullOrEmpty(lsdm.Form_edit)?"":lsdm.Form_edit.Trim());
                if(!String.IsNullOrEmpty(tname) && tname.Split(";").Length > 1)
                    tname = tname.Split(";")[1].Trim();
                string nHeight = "";
                string nWidth = "";
                if(tname.Split(":").Length>=3)
                {
                    nHeight =tname.Split(":")[2].Trim();
                }
                if(tname.Split(":").Length>=2)
                {
                    nWidth =tname.Split(":")[1].Trim();
                }
                tname = tname.Split(":")[0].Trim();
                tname = String.IsNullOrEmpty(tname) ? "edit" + _form.ToLower().Trim() : tname;
                Type[] types = sTypw.Type.Assembly.GetTypes().Where(t => t.Namespace == sTypw.Type.Namespace && t.Name.ToLower() == tname.ToLower()).ToArray();
                if(types.Length <= 0)
                {
                    tname = "frm" + _form.ToLower().Trim();
                    types = sTypw.Type.Assembly.GetTypes().Where(t => t.Namespace == sTypw.Type.Namespace && t.Name.ToLower() == tname.ToLower()).ToArray();
                }
                Type HDtype = types.FirstOrDefault();
                if (HDtype == null)
                {
                    myStatemanagerment.SetNewThongbao(@Lap["No Command"] + " !");
                    return;
                }
                DxWindowModel model = new DxWindowModel(HDtype, Par, true,"DM");
