    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e is null) return;

        try
        {
            if (string.Equals(e.Key, "ArrowDown", StringComparison.OrdinalIgnoreCase))
            {
                await MoveSelectionAsync(1);
            }
            else if (string.Equals(e.Key, "ArrowUp", StringComparison.OrdinalIgnoreCase))
            {
                await MoveSelectionAsync(-1);
            }
            else if (string.Equals(e.Key, "Home", StringComparison.OrdinalIgnoreCase))
            {
                await MoveToAsync(0);
            }
            else if (string.Equals(e.Key, "End", StringComparison.OrdinalIgnoreCase))
            {
                if (TblData?.DefaultView != null && TblData.DefaultView.Count > 0)
                    await MoveToAsync(TblData.DefaultView.Count - 1);
            }
            else if (string.Equals(e.Key, "PageDown", StringComparison.OrdinalIgnoreCase))
            {
                await ChangePageAsync(1);
            }
            else if (string.Equals(e.Key, "PageUp", StringComparison.OrdinalIgnoreCase))
            {
                await ChangePageAsync(-1);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"HandleKeyDown error: {ex.Message}");
        }
    }

    private Task MoveToAsync(int index)
    {
        return MoveSelectionInternalAsync(index);
    }

    private Task MoveSelectionAsync(int delta)
    {
        if (TblData == null || TblData.DefaultView == null || TblData.DefaultView.Count == 0)
            return Task.CompletedTask;

        int currentIndex = 0;
        if (SelectedDataItem != null && SelectedDataItem is DataRowView drvCur)
        {            
            for (int i = 0; i < TblData.DefaultView.Count; i++)
            {
                if (TblData.DefaultView[i].Row == drvCur.Row)
                {
                    currentIndex = i;
                    break;
                }
            }
        }

        int next = Math.Clamp(currentIndex + delta, 0, TblData.DefaultView.Count - 1);
        return MoveSelectionInternalAsync(next);
    }

    private Task MoveSelectionInternalAsync(int targetIndex)
    {
        if (TblData == null || TblData.DefaultView == null || TblData.DefaultView.Count == 0)
            return Task.CompletedTask;

        if (targetIndex < 0 || targetIndex >= TblData.DefaultView.Count)
            return Task.CompletedTask;

        SelectedDataItem = TblData.DefaultView[targetIndex];
        _ = SelectItem.InvokeAsync(SelectedDataItem);

        try
        {
            SetSelectRow(targetIndex);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MoveSelectionInternalAsync - SetSelectRow error: {ex.Message}");
        }

        StateHasChanged();
        return Task.CompletedTask;
    }
    private Task ChangePageAsync(int delta)
    {
        try
        {
            if (TblData == null || TblData.DefaultView == null || TblData.DefaultView.Count == 0)
                return Task.CompletedTask;

            int totalRows = TblData.DefaultView.Count;
            int pageSize = (Page_size <= 0) ? 10 : Page_size;
            int totalPages = Math.Max(1, (int)Math.Ceiling((double)totalRows / pageSize));

            int newPage = Math.Clamp(Pageindex + delta, 0, totalPages - 1);
            if (newPage == Pageindex)
                return Task.CompletedTask;

            // update internal page index and persistent state
            Pageindex = newPage;
            myStatemanagerment.SetCurpage(newPage);            
            SetPageindex(newPage);            
            int firstRowIndex = newPage * pageSize;
            if (firstRowIndex >= totalRows) firstRowIndex = totalRows - 1;
            if (firstRowIndex >= 0)
            {
                SelectedDataItem = TblData.DefaultView[firstRowIndex];
                _ = SelectItem.InvokeAsync(SelectedDataItem);

                try
                {                    
                    Grid?.SelectRow(0);
                }
                catch { }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ChangePageAsync error: {ex.Message}");
        }

        return Task.CompletedTask;
    }

