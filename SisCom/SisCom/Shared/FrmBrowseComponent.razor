    public DataTable GetFilterTable()
    {
        try{
        DataTable dat = Grid.Data as DataTable;
        DataTable tblmoi = dat.Clone();
        for (int i = 0; i < Grid.GetVisibleRowCount(); i++)
        {
            DataRow a = (Grid.GetDataItem(i) as DataRowView).Row;
            tblmoi.Rows.Add(a.ItemArray);
        }
        return tblmoi;
        }
        catch
        {
            return (DataTable)null;
        }
    }
