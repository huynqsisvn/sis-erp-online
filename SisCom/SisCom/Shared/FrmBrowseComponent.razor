<div class="container-fluid" @ref="ContainerRef" tabindex="0" @onkeydown="HandleKeyDown">
    <DxGrid @ref="@Grid"
            CssClass="@CssClass"
            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
            Data="@TblData"
            PageSize="@Page_size"
            PagerPosition="GridPagerPosition.Bottom"
            PageSizeSelectorVisible="true"
            PageSizeSelectorItems="@(new int[] { 10, 20, 30, 100 })"
            PageSizeSelectorAllRowsItemVisible="true"
            PagerAutoHideNavButtons="true"
            PagerSwitchToInputBoxButtonCount="10"
            PagerVisibleNumericButtonCount="10"
            PageIndexChanged="@PageSelectChange"
            SearchTextParseMode="@_GridSearchTextParseMode"
            PageIndex="@Pageindex"
            ShowFilterRow="@IsFilter"
            PagerVisible="@IsPageSize"
            AllowSelectRowByClick=true            
            SelectionMode="GridSelectionMode.Single"
            @bind-SelectedDataItem="@SelectedDataItem"
            SearchText="@GridSearchText"
            CustomizeElement="@GridCustomizeElement"                     
            CustomizeSummaryDisplayText="@Grid_SummaryDisplayText_Alternative"
            SelectedDataItemsChanged="@OnSelectedDataItemsChanged"
            VirtualScrollingEnabled="@IsVirtualScrollingEnabled"
            RowClick="@OnrowClick"
            RowDoubleClick="@OnRowdbClick">
        <Columns>
            @if (TblData != null)
            {
                Fbrowse=Fbrowse.Replace("H=", "h=");
                fields = Fbrowse.Split(';');
                if (!String.IsNullOrEmpty(Fbrowse) && fields != null && fields.Length > 0)
                {
                    foreach (string str in fields)
                    { 
                        if(!String.IsNullOrEmpty(str))
                        {
                            string dinhdang = "";
                            string[] _data = str.Split(':');
                            string ma = _data[0];
                            string rong = _data[1] + "px";
                            string ten = "";
                            if (_data[1].StartsWith("h="))
                                ten = _data[1].Split('=')[1].Replace("[M_MA_NT0]", M_Ma_nt0);
                            else if (_data[2].StartsWith("h="))
                                ten = _data[2].Split('=')[1].Replace("[M_MA_NT0]", M_Ma_nt0);

                            string BI = "";
                            string BG = "";
                            _GridColumnFixedPosition = GridColumnFixedPosition.None;
                            if (_data.Length > 3)
                            {
                                if (_data.Contains("FL"))
                                {
                                    _GridColumnFixedPosition = GridColumnFixedPosition.Left;
                                }
                                else if (_data.Contains("FR"))
                                {
                                    _GridColumnFixedPosition = GridColumnFixedPosition.Right;
                                }
                                else
                                {
                                    _GridColumnFixedPosition = GridColumnFixedPosition.None;
                                }
                                for (int x = 3; x < _data.Length; x++)
                                {
                                    dinhdang = "";
                                    string d = _data[x].ToUpper();
                                    if (d.StartsWith("D") || d.StartsWith("N") || d.StartsWith("R") || d.StartsWith("P") || d.StartsWith("Q") || d.StartsWith("IMG") || d.StartsWith("SOLID") || d.StartsWith("TEXT") || d.StartsWith("COLOR") || d.StartsWith("HIDE") || d.StartsWith("BUTTON") || d.StartsWith("LINK"))
                                    {
                                        if (d.ToUpper().StartsWith("N"))
                                        {
                                            if (d.ToUpper().Equals("N0"))
                                                dinhdang = M_IP_TIEN;
                                            else
                                                dinhdang = M_IP_TIEN_NT;
                                        }
                                        else if (d.ToUpper().StartsWith("P0"))
                                        {
                                            dinhdang = M_IP_GIA;
                                        }
                                        else if (d.ToUpper().StartsWith("P1"))
                                        {
                                            dinhdang = M_IP_GIA_NT;
                                        }
                                        else if (d.ToUpper().StartsWith("Q"))
                                        {
                                            dinhdang = M_IP_SL;
                                        }
                                        else if (d.ToUpper().StartsWith("RF"))
                                        {
                                            dinhdang = M_IP_TY_GIAF;
                                        }
                                        else if (d.ToUpper().StartsWith("R"))
                                        {
                                            dinhdang = M_IP_TY_GIA;
                                        }
                                        else
                                            dinhdang = d;
                                        break;
                                    }
                                    if ("BI".Contains(d))
                                        BI = d;
                                    if ("G".Contains(d))
                                        BG = d;
                                }
                            }
                            foreach (DataColumn col in TblData.Columns)
                        {
                            if (col.ColumnName.ToLower().Equals(ma.ToLower()))
                            {
                                ten = String.IsNullOrEmpty(ten) ? col.ColumnName : ten;
                                if (col.DataType.Name.ToLower().Equals("boolean"))
                                {
                                    bool _check = false;
                                    <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong">
                                        <CellDisplayTemplate>
                                            @if (!string.IsNullOrEmpty(context.Value.ToString()))
                                            {
                                                _check = (bool)context.Value;
                                            }
                                            <DxCheckBox CssClass="d-inline-block" Enabled="false" Checked="@_check" />
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                }
                                else if (col.DataType.Name.ToLower().Equals("datetime"))
                                {
                                    string _dformat = "MM/dd/yyyy";
                                    string _dformat1 = "{0:MM/dd/yyyy}";
                                    if (IsLangEn)
                                    {
                                        _dformat = "MM/dd/yyyy";
                                        _dformat1 = "{0:MM/dd/yyyy}";
                                    }
                                    else
                                    {
                                        _dformat = "dd-MM-yyyy";
                                        _dformat1 = "{0:dd-MM-yyyy}";
                                    }

                                    if (dinhdang.Equals("DG"))
                                    {
                                        string _style = string.Format("background-color:{0};color:{1};text-align:center;border-radius:5px;padding:5px;", M_GRD_CELL_BG_Color, M_GRD_CELL_Color);
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" DisplayFormat="@_dformat" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                            <FilterRowCellTemplate>
                                                <DxDateEdit Date="(DateTime?)context.FilterRowValue"
                                                            Format="@_dformat"
                                                            DisplayFormat="@_dformat"
                                                            DateChanged="(DateTime? v) => context.FilterRowValue = v"
                                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                                            </FilterRowCellTemplate>
                                            <CellDisplayTemplate>
                                                @if (string.IsNullOrEmpty(context.Value.ToString()))
                                                {
                                                    _style = "font-weight:normal;";
                                                }
                                                else
                                                {
                                                    _style = string.Format("background-color:{0};text-align:center;border-radius:5px;padding:5px;", M_GRD_CELL_BG_Color);
                                                }
                                                <div style="@_style"> @(string.Format(_dformat1, context.Value))</div>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    }
                                    else            //if (dinhdang.Equals("D"))
                                    {
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" DisplayFormat="@_dformat" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                            <FilterRowCellTemplate>
                                                <DxDateEdit Date="(DateTime?)context.FilterRowValue"
                                                            Format="@_dformat"
                                                            DisplayFormat="@_dformat"
                                                            DateChanged="(DateTime? v) => context.FilterRowValue = v"
                                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                                            </FilterRowCellTemplate>
                                        </DxGridDataColumn>
                                    }

                                }
                                else
                                {
                                    if (string.IsNullOrEmpty(dinhdang))
                                    {
                                        string _style = "text-wrap: wrap;";
                                        string _style1 = "text-wrap: wrap;";
                                        if (BI == "B")
                                        {
                                            _style1 = "font-weight:bold;text-wrap: wrap;";
                                        }
                                        else if (BI == "I")
                                        {
                                            _style1 = "font-weight:italic;text-wrap: wrap;";
                                        }
                                        else if (BI == "BI")
                                        {
                                            _style1 = "font-weight:bold;font-style:italic;text-wrap: wrap;";
                                        }
                                        else if (BG.Equals("G"))
                                        {
                                            _style1 = "text-wrap: wrap;text-align:center;border-radius:5px;padding:5px;background-color:" + M_GRD_CELL_BG_Color;
                                        }
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" FixedPosition="@_GridColumnFixedPosition" FilterRowOperatorType="GridFilterRowOperatorType.Contains" Width="@rong">
                                            <CellDisplayTemplate>
                                                @if (!string.IsNullOrEmpty(context.Value.ToString()))
                                                {
                                                    _style = _style1;
                                                }
                                                <div style="@_style">@context.Value</div>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    }
                                    else if (dinhdang.StartsWith("IMG"))
                                    {
                                        if (dinhdang.Equals("IMGR"))
                                        {
                                            <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                                <CellDisplayTemplate>
                                                    @if (context.Value.ToString().Split(";").Count() > 0)
                                                    {
                                                        string[] arrs = context.Value.ToString().Split(";");
                                                        foreach (string str1 in arrs)
                                                        {
                                                            if (!String.IsNullOrEmpty(str1))
                                                            {
                                                                string str = str1.Trim();
                                                                if (!str.Contains(@"."))
                                                                    str = str + ".PNG";
                                                                if (!str.Contains(@"/"))
                                                                    str = @"./Pict/" + str;

                                                                if (SysFunc.PictureHelper.Exits(str, hostEnvironment))
                                                                {
                                                                    if (arrs.Count() == 1)
                                                                    {
                                                                        <img style="position: relative; width: 35px; height: 35px; overflow: hidden; border-radius: 50%;" src="@str" title="@str1" />
                                                                    }
                                                                    else if (arrs.Count() < 4)
                                                                    {
                                                                        <img style="position: relative; width: 30px; height: 30px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <img style="position: relative; width: 20px; height: 20px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    str = @"./Pict/User.png";
                                                                    if (arrs.Count() == 1)
                                                                    {
                                                                        <img style="position: relative; width: 35px; height: 35px; overflow: hidden; border-radius: 50%;" src="@str" title="@str1" />
                                                                    }
                                                                    else if (arrs.Count() < 4)
                                                                    {
                                                                        <img style="position: relative; width: 30px; height: 30px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <img style="position: relative; width: 20px; height: 20px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        }
                                        else if (dinhdang.Equals("IMGM"))
                                        {
                                            <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                                <CellDisplayTemplate>
                                                    @if (context.Value.ToString().Split(";").Count() > 0)
                                                    {
                                                        string[] arrs = context.Value.ToString().Split(";");
                                                        foreach (string str1 in arrs)
                                                        {
                                                            if (!String.IsNullOrEmpty(str1))
                                                            {
                                                                string str = str1.Trim();
                                                                if (!str.Contains(@"."))
                                                                    str = str + ".PNG";
                                                                if (!str.Contains(@"/"))
                                                                    str = @"./Pict/" + str;

                                                                if (SysFunc.PictureHelper.Exits(str, hostEnvironment))
                                                                {
                                                                    <img style="position: relative; width: 30px; height: 30px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                }
                                                                else
                                                                {
                                                                    str = @"./Pict/User.png";
                                                                    <img style="position: relative; width: 30px; height: 30px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                }
                                                            }
                                                        }
                                                    }
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        }
                                        else if (dinhdang.Equals("IMGS"))
                                        {
                                            <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                                <CellDisplayTemplate>
                                                    @if (context.Value.ToString().Split(";").Count() > 0)
                                                    {
                                                        string[] arrs = context.Value.ToString().Split(";");
                                                        foreach (string str1 in arrs)
                                                        {
                                                            if (!String.IsNullOrEmpty(str1))
                                                            {
                                                                string str = str1.Trim();
                                                                if (!str.Contains(@"."))
                                                                    str = str + ".PNG";
                                                                if (!str.Contains(@"/"))
                                                                    str = @"./Pict/" + str;

                                                                if (SysFunc.PictureHelper.Exits(str, hostEnvironment))
                                                                {
                                                                    <img style="position: relative; width: 20px; height: 20px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                }
                                                                else
                                                                {
                                                                    str = @"./Pict/User.png";
                                                                    <img style="position: relative; width: 20px; height: 20px; overflow: hidden; border-radius: 50%;margin-right:2px;" src="@str" title="@str1" />
                                                                }
                                                            }
                                                        }
                                                    }
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        }
                                        else if (dinhdang.Equals("IMGC"))
                                        {
                                            <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                                <CellDisplayTemplate>
                                                    <div>
                                                        @if (context.Value.ToString().Split(";").Count() > 0)
                                                        {
                                                            string[] arrs = context.Value.ToString().Split(";");
                                                            foreach (string str1 in arrs)
                                                            {
                                                                if (!String.IsNullOrEmpty(str1))
                                                                {
                                                                    string[] str = str1.Trim().Split(':');
                                                                    string ma_nv = str[0];
                                                                    string type = "0";
                                                                    string tooltip = "";
                                                                    if (str.Length > 1)
                                                                        type = str[1];

                                                                    if (str.Length > 2)
                                                                        tooltip = str[2];

                                                                    if (!ma_nv.Contains(@"."))
                                                                        ma_nv = ma_nv + ".PNG";

                                                                    if (!ma_nv.Contains(@"/"))
                                                                        ma_nv = @"./Pict/" + ma_nv;

                                                                    string checkicon = @"./Pict/imgcheck.PNG";
                                                                    if (type.Equals("0"))
                                                                    {
                                                                        checkicon = @"./Pict/imgnormal.PNG";
                                                                    }
                                                                    else if (type.Equals("1"))
                                                                    {
                                                                        checkicon = @"./Pict/imgcheck.PNG";
                                                                    }
                                                                    else if (type.Equals("2"))
                                                                    {
                                                                        checkicon = @"./Pict/imgcancel.PNG";
                                                                    }
                                                                    if (SysFunc.PictureHelper.Exits(ma_nv, hostEnvironment))
                                                                    {
                                                                        <span style="width:30px;height:25px;display: inline-block;">
                                                                            <img style="position:relative;top:0px;left:0px;width: 25px; height: 25px; overflow: hidden; border-radius: 50%" src="@ma_nv" title="@tooltip" />
                                                                            <img style="position:relative;top:5px;left:-25px;width: 27px; height:15px; overflow: hidden" src="@checkicon" title="@tooltip" />
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        ma_nv = @"./Pict/User.png";
                                                                        <span style="width:30px;height:25px;display: inline-block;">
                                                                            <img style="position:relative;top:0px;left:0px;width: 25px; height: 25px; overflow: hidden; border-radius: 50%" src="@ma_nv" title="@tooltip" />
                                                                            <img style="position:relative;top:5px;left:-25px;width:27px; height:15px; overflow: hidden" src="@checkicon" title="@tooltip" />
                                                                        </span>
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    </div>
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        }
                                        else if (dinhdang.Equals("IMGL"))
                                        {
                                            <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                                <CellDisplayTemplate>
                                                    @if (context.Value.ToString().Split(",").Count() > 0 || context.Value.ToString().Split(";").Count() > 0)
                                                    {
                                                        string[] arrs = context.Value.ToString().Contains(",") ? context.Value.ToString().Split(",") : context.Value.ToString().Split(";");
                                                        foreach (string str1 in arrs)
                                                        {
                                                            if (!String.IsNullOrEmpty(str1))
                                                            {
                                                                string str = str1.Trim();
                                                                if (str.Contains(@"."))
                                                                {
                                                                    if (!str.Contains(@"/"))
                                                                        str = @"./uploads/" + str;
                                                                    if (SysFunc.PictureHelper.Exits1(str, hostEnvironment))
                                                                    {
                                                                        <div class="row">
                                                                            <a href="@str" target="_blank">
                                                                                @str1.Split('.')[0]
                                                                            </a>
                                                                        </div>
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        }
                                        else
                                        {
                                            <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                                <CellDisplayTemplate>
                                                    <img style="max-width:100px;max-height:100px" src="@context.Value" />
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        }
                                    }
                                    else if (dinhdang.Equals("SOLID"))
                                    {
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                            <CellDisplayTemplate>
                                                <div class="d-flex justify-content-center">
                                                    <div style="border-radius:5px;width:16px;height:16px;background-color:@context.Value"></div>
                                                </div>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    }
                                    else if (dinhdang.Equals("SOLIDL"))
                                    {
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                            <CellDisplayTemplate>
                                                <div class="d-flex justify-content-center">
                                                    <div style="border-radius:5px;width:@rong;height:@rong;background-color:@context.Value"></div>
                                                </div>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    }
                                    else if (dinhdang.Equals("SOLIDLB"))
                                    {
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                            <CellDisplayTemplate>
                                                <div class="d-flex justify-content-center">
                                                    <div style="border-radius:5px;border:solid;border-width:1px;border-color:silver;width:@rong;height:@rong;background-color:@context.Value"></div>
                                                </div>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    }
                                    else if (dinhdang.Equals("TEXT") || dinhdang.Equals("COLOR"))
                                    {
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" FixedPosition="@_GridColumnFixedPosition" FilterRowOperatorType="GridFilterRowOperatorType.Contains" Width="@rong">
                                            <CellDisplayTemplate>
                                                @{
                                                    string[] str = context.Value.ToString().Split('|');
                                                    string _value = str[0];
                                                    string _fw = "normal";
                                                    string _color = "black";
                                                    if (str.Length > 1)
                                                    {
                                                        _color = str[1];
                                                    }
                                                    if (str.Length > 2)
                                                    {
                                                        if (str[2].ToUpper().Contains("B"))
                                                        {
                                                            _fw = "bold";
                                                        }
                                                        else if (str[2].ToUpper().Contains("I"))
                                                        {
                                                            _fw = "italic";
                                                        }
                                                        else
                                                        {
                                                            _fw = "normal";
                                                        }
                                                    }
                                                }
                                                <span style="color:@_color;font-weight:@_fw;text-wrap: wrap;">@_value</span>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    }
                                    else if (dinhdang.Equals("BUTTON"))
                                    {
                                        <DxGridDataColumn FieldName="@ma" Name="@ma" Caption="@ten" Width="@rong" FixedPosition="@_GridColumnFixedPosition">
                                            <CellDisplayTemplate>
                                                @if (!string.IsNullOrEmpty(context.Value.ToString()))
                                                {
                                                    string scolor = "w-100 empty-bck";
                                                    string[] rows = new string[] { };
                                                    @if (context.Value.ToString().Contains("&"))
                                                    {
                                                        rows = context.Value.ToString().Split('&');
                                                    }
                                                    @if (rows.Length > 1)
                                                    {
                                                        <div class="d-flex justify-content-around">
                                                            @{
                                                                string[] value = rows[0].Split(':');
                                                                if (value.Length > 2)
                                                                    scolor = value[2] + "-bck";
                                                            }
                                                            <div class="justify-content-center" style="min-width:100px; margin-right:5px;">
                                                                <DxButton RenderStyle="ButtonRenderStyle.Primary" CssClass="@scolor"
                                                                          Text="@value[0]" Click="@(()=>FunctionButton(value.Length >= 2 ? value[1] : value[0]))"></DxButton>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex justify-content-around mt-1">
                                                            @{
                                                                string[] value1 = rows[1].Split(':');
                                                                if (value.Length > 2)
                                                                    scolor = value1[2] + "-bck";
                                                            }
                                                            <div class="justify-content-center" style="min-width:100px; margin-right:5px;">
                                                                <DxButton RenderStyle="ButtonRenderStyle.Danger" CssClass="@scolor"
                                                                          Text="@value1[0]" Click="@(()=>FunctionButton(value1.Length >= 2 ? value1[1] : value1[0]))"></DxButton>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex justify-content-around">
                                                            @{
                                                                string[] value = context.Value.ToString().Split(':');
                                                                if (value.Length > 2)
