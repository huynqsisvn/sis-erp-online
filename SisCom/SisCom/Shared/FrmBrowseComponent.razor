    void CustomizeExcelCell(GridExportCustomizeCellEventArgs e)
    {
        if (e.AreaType == DevExpress.Export.SheetAreaType.TotalFooter)
        {
            e.Formatting.BackColor = System.Drawing.ColorTranslator.FromHtml(M_GRD_FOOTER_Color);
            try
            {
                if (!string.IsNullOrEmpty(M_GRD_FOOTER_BG_Color) && M_GRD_FOOTER_BG_Color != "transparent")
                {
                    e.Formatting.BackColor = System.Drawing.ColorTranslator.FromHtml(M_GRD_FOOTER_BG_Color);
                }

                if (e.Formatting.Font == null)
                {
                    e.Formatting.Font = new DevExpress.Export.XlCellFont();
                }
                if (!string.IsNullOrEmpty(M_GRD_FOOTER_Color))
                {
                    e.Formatting.Font.Color = System.Drawing.ColorTranslator.FromHtml(M_GRD_FOOTER_Color);
                }
                e.Formatting.Font.Bold = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"CustomizeExcelCell - TotalFooter formatting error: {ex.Message}");
            }
        }

        // Xử lý format cho cả DataArea và TotalFooter
        if (e.AreaType == DevExpress.Export.SheetAreaType.DataArea ||
            e.AreaType == DevExpress.Export.SheetAreaType.TotalFooter)
        {
            if (e.Value == null || e.Value == DBNull.Value)
                return;

            // Kiểm tra xem column có phải là numeric không
            bool isNumericColumn = false;
            string columnName = e.ColumnFieldName;

            if (!string.IsNullOrEmpty(Fbrowse) && fields != null)
            {
                foreach (string str in fields)
                {
                    if (!string.IsNullOrEmpty(str))
                    {
                        string[] _data = str.Split(':');
                        string ma = _data[0];

                        if (ma.Equals(columnName, StringComparison.OrdinalIgnoreCase))
                        {
                            if (_data.Length > 3)
                            {
                                for (int x = 3; x < _data.Length; x++)
                                {
                                    string d = _data[x].ToUpper();
                                    if (d.StartsWith("N") || d.StartsWith("P") ||
                                        d.StartsWith("Q") || d.StartsWith("R") ||
                                        d.Equals("S") || d.StartsWith("SC"))
                                    {
                                        isNumericColumn = true;
                                        break;
                                    }
                                }
                            }
                            break;
                        }
                    }
                }
            }           
            if (!isNumericColumn)
            {
                if (e.AreaType == DevExpress.Export.SheetAreaType.TotalFooter)
                {                    
                    e.Handled = true;
                }
                return;
            }            
            if (e.Value is decimal || e.Value is double || e.Value is int ||  e.Value is long || e.Value is float)
            {                
                if (e.AreaType == DevExpress.Export.SheetAreaType.TotalFooter)
                {                    
                    if (e.Value is decimal decVal)
                    {
                        e.Value = decVal;
                    }
                    else
                    {
                        e.Value = Convert.ToDecimal(e.Value);
                    }
                    e.Handled = true;
                }
                else
                {                    
                    e.Handled = true;
                }
                return;
            }

            // Xử lý string cần convert sang số
            string valueStr = e.Value.ToString().Trim();
            if (string.IsNullOrWhiteSpace(valueStr))
                return;

            string cleanValue = valueStr;
            int lastCommaIndex = valueStr.LastIndexOf(',');
            int lastDotIndex = valueStr.LastIndexOf('.');

            int commaCount = valueStr.Count(c => c == ',');
            int dotCount = valueStr.Count(c => c == '.');

            if (commaCount > 0 && dotCount > 0)
            {
                // Có cả dấu phẩy và chấm
                if (lastCommaIndex > lastDotIndex)
                {
                    cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(".", "").Replace(",", ".");
                }
                else
                {
                    cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(",", "");
                }
            }
            else if (commaCount > 0)
            {
                // Chỉ có dấu phẩy
                if (commaCount == 1)
                {
                    string afterComma = valueStr.Substring(lastCommaIndex + 1);
                    if (afterComma.Length <= 3 && afterComma.All(char.IsDigit))
                    {
                        cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(",", ".");
                    }
                    else
                    {
                        cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(",", "");
                    }
                }
                else
                {
                    cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(",", "");
                }
            }
            else if (dotCount > 0)
            {
                if (dotCount == 1)
                {
                    string afterDot = valueStr.Substring(lastDotIndex + 1);
                    if (afterDot.Length <= 3 && afterDot.All(char.IsDigit))
                    {
                        cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "");
                    }
                    else
                    {
                        cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(".", "");
                    }
                }
                else
                {
                    cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "").Replace(".", "");
                }
            }
            else
            {
                cleanValue = valueStr.Replace(" ", "").Replace("\u00A0", "");
            }

            if (decimal.TryParse(cleanValue, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal numValue))
            {
                e.Value = numValue;
                e.Handled = true;
            }
        }
    }
