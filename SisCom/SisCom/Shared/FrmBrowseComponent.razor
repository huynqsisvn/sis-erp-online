    public async Task FocusGridAsync()
    {
        try
        {            
            if (TblData != null) if (SelectedDataItem == null && TblData.DefaultView.Count > 0)
                    SelectedDataItem = TblData.DefaultView[0];
            await ContainerRef.FocusAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"FocusGridAsync error: {ex.Message}");
        }
