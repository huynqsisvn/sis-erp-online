@inject IDbManager myDb
@inject Statemanagerment myStatemanagerment
@inject ILocalStorageService Localstore
@inject NavigationManager navigation
@inject ICommandManager Commands
@inject IStringLocalizer<App> Lap

<DxLayoutBreakpoint MaxWidth="1025" @bind-IsActive="@IsMobileLayout" />
@if (IsShowToolBar)
{
    <div class="fform-control-sm form-toolbar m-0 py-1 px-1 css-toolbar">
        <div class="row w-100 justify-content-evenly">
            @if (!IsMobileLayout)
            {
                <div class="col-7 justify-content-start">
                    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Contained" Data="@ToolbarItems" ItemClick="@OnItemClicked">
                        <DataMappings>
                            <DxToolbarDataMapping Name="ValueName" Tooltip="Tooltip" Text="Text" Key="Id" CssClass="CssClass" IconCssClass="IconCssClass" ParentKey="ParentId" BeginGroup="BeginGroup" />
                        </DataMappings>
                    </DxToolbar>                    
                </div>
                <div class="col-2 justify-content-end">
                    @*  <DxCheckBox @bind-Checked="IsMauNT" style="color:black;">@Lap["FC"]</DxCheckBox> *@
                </div>
                <div class="col-2 justify-content-end">
                    @* <SearchItem SearchData="@OnSearchChanged" Placehoder="@searchPlaceholder" /> *@
                    <DxSearchBox TextChanged="@OnSearchChanged" CssClass="search" aria-label="search" NullText="@Lap["Search"]" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>
                <div class="col-1 justify-content-end">
                    <div class="row justify-content-end">
                        <span style="width:44px;height:28px;background-color:white;border:solid 1px #CCC;align-items:end;">
                            <img src=".\Images\Icon_cai_dat.svg" style="cursor:pointer;margin-top:2px;" width="20" height="20" onclick="@( ()=> BtnSetting())" />
                        </span>                        
                    </div>
                </div>
            }
            else
            {
                <div class="col">
                    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Contained" Data="@ToolbarItems" ItemClick="@OnItemClicked">
                        <DataMappings>
                            <DxToolbarDataMapping Name="ValueName" Tooltip="Tooltip" Text="Text" Key="Id" CssClass="CssClass" IconCssClass="IconCssClass" ParentKey="ParentId" BeginGroup="BeginGroup" />
                        </DataMappings>
                    </DxToolbar>
                </div>
                <div class="col-3">
                    <div class="row m-0 p-0 justify-content-end">
                        @* <SearchItem SearchData="@OnSearchChanged" Placehoder="@searchPlaceholder" /> *@
                        <DxSearchBox TextChanged="@OnSearchChanged" CssClass="search" aria-label="search" NullText="@Lap["Search"]" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </div>
                </div>
            }
        </div>
    </div>
    @if (windowVisible)
    {
        <CascadingValue Name="wtitle" Value="@wtitle">
            <CascadingValue Name="curCommand" Value="@curCommand">
                <CascadingValue Name="lang" Value="@IsLangEn">
                    <SisCom.Shared.Commandfolder.CommandComponent Closeform="Closeform"> </SisCom.Shared.Commandfolder.CommandComponent>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    }
}

