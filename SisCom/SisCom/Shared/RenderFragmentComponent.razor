@typeparam TItem
@if (Items != null)
{
    //  @Header(headeritem)
    @foreach (var item in Items)
    {
        @Row(item)
    }
}

@code {
    // [Parameter]
    // public TItem headeritem { get; set; }
    [Parameter]
    public RenderFragment<TItem> Header { get; set; }
    [Parameter]
    public RenderFragment<TItem> Row { get; set; }
    [Parameter]
    public List<TItem> Items { get; set; }
}

