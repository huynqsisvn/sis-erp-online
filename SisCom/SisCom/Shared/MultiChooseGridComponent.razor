    record QuantityFilterInterval(CriteriaOperator Criteria, string DisplayText)
    {
        public QuantityFilterInterval(string CriteriaText, string DisplayText)
            : this(CriteriaOperator.Parse(CriteriaText), DisplayText)
        {
        }
    }
    protected override void OnInitialized()
    {
        myStatemanagerment.OnActionTaskChanged += OnActionTaskchanged;
        if (string.IsNullOrEmpty(SelectCol))
            SelectCol = "tag";

        if (TblData != null)
            TblData.Columns[SelectCol].ReadOnly = false;
    }
    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                GridSearchText = myStatemanagerment.GetSearchText();
                StateHasChanged();
                break;
        }
    }
    private void CheckAll (bool? chkVal)
    {
        if(chkVal == true)
        {
            foreach (DataRow row in TblData.Rows)
            {
                row[SelectCol] = "1";
            }            
        }
        else
        {
            foreach (DataRow row in TblData.Rows)
            {
                row[SelectCol] = "0";
            }            
        }
        //myStatemanagerment.SetNewThongbao(chkVal.ToString());
    }
    private void KeyPress()
    {
        pressCheck = !pressCheck;
        if (pressCheck)
        {
            foreach (DataRow row in TblData.Rows)
            {
                row[SelectCol] = "1";
            }
            btnCheckText = "Uncheck All";
        }
        else
        {
            foreach (DataRow row in TblData.Rows)
            {
                row[SelectCol] = "0";
            }
            btnCheckText = "Check All";
        }

        CheckChangedCallBack.InvokeAsync(true);
    }
    public void Dispose()
    {
        myStatemanagerment.OnActionTaskChanged -= OnActionTaskchanged;
    }
