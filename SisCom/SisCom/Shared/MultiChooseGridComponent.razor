    void Grid_CustomizeElement(GridCustomizeElementEventArgs e)
    {
        //if(e.ElementType == GridElementType.DataRow && e.VisibleIndex % 2 == 1) {
        //    e.CssClass = "alt-item";
        //}

        if (e.ElementType == GridElementType.DataRow)
        {
            IReadOnlyList<IGridColumn> grdcol = e.Grid.GetColumns();
            foreach (IGridColumn grd in grdcol)
            {
                if (grd.Name != null)
                {
                    if (grd.Name.ToLower().StartsWith("bold_color"))
                    {
                        if (!string.IsNullOrEmpty(e.Grid.GetRowValue(e.VisibleIndex, "bold_color").ToString()))
                        {
                            string[] value = e.Grid.GetRowValue(e.VisibleIndex, "bold_color").ToString().Split(';');
                            if (value.Length > 1)
                            {
                                string cssclass = "";
                                if (value[0].Equals("1"))
                                {
                                    cssclass = "bold-item";
                                    if (!string.IsNullOrEmpty(value[1]))
                                    {
                                        cssclass += string.Format(" {0}-item", value[1].Trim());
                                    }
                                    e.CssClass = cssclass;
                                }
                                else
                                {
                                    if (!string.IsNullOrEmpty(value[1]))
                                    {
                                        cssclass = string.Format("{0}-item", value[1].Trim());
                                    }
                                }
                                e.CssClass = cssclass;
                            }
                            else
                            {
                                if (value[0].Equals("1"))
                                {
                                    e.CssClass = "bold-item";
                                }
