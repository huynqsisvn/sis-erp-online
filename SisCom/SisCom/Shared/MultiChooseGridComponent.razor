    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            string nrow = options.GetOptionsValue("M_GRID_NROW");
            if (Page_size <= 0)
                Page_size = string.IsNullOrEmpty(nrow) ? 10 : int.Parse(nrow);

            M_Ma_nt0 = options.GetOptionsValue("M_MA_NT0").Trim();
            M_IP_TY_GIA = options.GetOptionsValue("M_IP_TY_GIA").Trim();
            M_IP_TY_GIAF = options.GetOptionsValue("M_IP_TY_GIAF").Trim();
            M_IP_TIEN = options.GetOptionsValue("M_IP_TIEN").Trim();
            M_IP_TIEN_NT = options.GetOptionsValue("M_IP_TIEN_NT").Trim();
            M_IP_SL = options.GetOptionsValue("M_IP_SL").Trim();
            M_IP_GIA = options.GetOptionsValue("M_IP_GIA").Trim();
            M_IP_GIA_NT = options.GetOptionsValue("M_IP_GIA_NT").Trim();
            M_GRD_CELL_Color = options.GetOptionsValue("M_GRD_CELL_CL").Trim();
            M_GRD_CELL_BG_Color = options.GetOptionsValue("M_GRD_CELL_BG").Trim();
            M_GRD_HEAD_BG_Color = options.GetOptionsValue("M_GRD_HEAD_BG").Trim();
            M_GRD_HEAD_Color = options.GetOptionsValue("M_GRD_HEAD_CL").Trim();
            M_GRD_FOOTER_BG_Color = options.GetOptionsValue("M_GRD_FOOTER_BG").Trim();
            M_GRD_FOOTER_Color = options.GetOptionsValue("M_GRD_FOOTER_CL").Trim();
            if (!string.IsNullOrEmpty(Fbrowse))
                fields = Fbrowse.Split(';');
            StateHasChanged();
            base.OnAfterRender(firstRender);
        }
