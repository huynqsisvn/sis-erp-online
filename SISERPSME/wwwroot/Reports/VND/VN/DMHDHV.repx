      <Controls>
        <Item1 Ref="4" ControlType="XRLabel" Name="label90" Text="Khi hai bên ký kết phụ lục hợp đồng  " SizeF="282.2918,23" LocationFloat="452.3748,1619.708" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="5" UseFont="false" />
        </Item1>
        <Item2 Ref="6" ControlType="XRLabel" Name="label89" Multiline="true" Text="lao động thì nội dung của phụ lục hợp đồng lao động cũng có giá trị như các nội dung của bản hợp đồng lao động này" SizeF="734.6667,46.03979" LocationFloat="0,1653.125" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="7" UseFont="false" />
        </Item2>
        <Item3 Ref="8" ControlType="XRLabel" Name="label88" Multiline="true" TextAlignment="TopLeft" SizeF="156.2499,23.95837" LocationFloat="292.7085,1618.75" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <Scripts Ref="9" OnBeforePrint="label88_BeforePrint" />
          <StylePriority Ref="10" UseFont="false" UseTextAlignment="false" />
        </Item3>
        <Item4 Ref="11" ControlType="XRLabel" Name="label87" Text="- Bảo đảm thực hiện đầy đủ những điều đã cam kết trong hợp đồng học việc." SizeF="734.6667,22.91663" LocationFloat="0,1342.708" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="12" UseFont="false" />
        </Item4>
        <Item5 Ref="13" ControlType="XRLabel" Name="label86" Text="1. Nghĩa vụ" SizeF="148.2083,22.91663" LocationFloat="0,1304.167" Font="Times New Roman, 12pt, style=Bold" Padding="2,2,0,0,100">
          <StylePriority Ref="14" UseFont="false" />
        </Item5>
        <Item6 Ref="15" ControlType="XRLabel" Name="label85" Text="Điều 4: Nghĩa vụ và quyền hạn của người sử dụng lao động" SizeF="563.542,22.91675" LocationFloat="0,1267.708" Font="Times New Roman, 12pt, style=Bold" Padding="2,2,0,0,100">
          <StylePriority Ref="16" UseFont="false" />
        </Item6>
        <Item7 Ref="17" ControlType="XRLabel" Name="label84" Multiline="true" Text="- Bồi thường vi phạm và vật chất: Theo quy định của Pháp luật Việt Nam, Luật Lao động và nội quy, quy định công ty." SizeF="734.6667,44.79163" LocationFloat="3.125127,1206.25" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="18" UseFont="false" />
        </Item7>
        <Item8 Ref="19" ControlType="XRLabel" Name="label83" Multiline="true" Text=" - Hợp đồng học việc có hiệu lực từ: " SizeF="292.7085,23.95837" LocationFloat="0,1618.75" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="20" UseFont="false" />
        </Item8>
        <Item9 Ref="21" ControlType="XRLabel" Name="label82" Text="- Những vấn đề về lao động không ghi trong hợp đồng học việc này thì áp dụng theo quy định của thỏa ước lao động tập thể và Nội quy lao động của  doanh nghiệp." SizeF="734.6667,44.79163" LocationFloat="0,1560.417" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="22" UseFont="false" />
        </Item9>
        <Item10 Ref="23" ControlType="XRLabel" Name="label81" Text="Điều 5: Điều khoản thi hành" SizeF="226.3332,22.91675" LocationFloat="0,1521.875" Font="Times New Roman, 12pt, style=Bold" Padding="2,2,0,0,100">
          <StylePriority Ref="24" UseFont="false" />
        </Item10>
        <Item11 Ref="25" ControlType="XRLabel" Name="label80" Multiline="true" Text="- Tạm hoãn, chấm dứt hợp đồng lao động, kỷ luật người lao động theo quy định của pháp luật, thỏa ước lao&#xD;&#xA;động tập thể và Nội quy lao động của doanh nghiệp." SizeF="734.6667,45.83337" LocationFloat="0,1470.833" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="26" UseFont="false" />
        </Item11>
        <Item12 Ref="27" ControlType="XRLabel" Name="label79" Text="- Đào tạo người lao động thực hiện theo hợp đồng học việc" SizeF="734.6667,22.91663" LocationFloat="0,1433.333" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="28" UseFont="false" />
        </Item12>
        <Item13 Ref="29" ControlType="XRLabel" Name="label78" Text="2. Quyền hạn" SizeF="148.2083,22.91675" LocationFloat="0,1408.333" Font="Times New Roman, 12pt, style=Bold" Padding="2,2,0,0,100">
          <StylePriority Ref="30" UseFont="false" />
        </Item13>
        <Item14 Ref="31" ControlType="XRLabel" Name="label77" Text="- Thanh toán đầy đủ, đúng thời hạn các chế độ và quyền lợi cho người lao động theo hợp đồng học việc." SizeF="734.6667,22.91663" LocationFloat="0,1365.625" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="32" UseFont="false" />
        </Item14>
        <Item15 Ref="33" ControlType="XRLabel" Name="label76" Text="- Chấp hành lệnh điều hành sản xuất - kinh doanh, nội quy kỷ luật, an toàn lao động." SizeF="734.6667,22.91663" LocationFloat="3.125,1171.875" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="34" UseFont="false" />
        </Item15>
        <Item16 Ref="35" ControlType="XRLabel" Name="label75" Text="2. Nghĩa vụ" SizeF="146.8752,22.91675" LocationFloat="1.333109,1136.458" Font="Times New Roman, 12pt, style=Bold" Padding="2,2,0,0,100">
          <StylePriority Ref="36" UseFont="false" />
        </Item16>
        <Item17 Ref="37" ControlType="XRLabel" Name="label74" Text="- Được trang bị bảo hộ lao động gồm: tùy thuộc từng công việc." SizeF="734.6667,22.91663" LocationFloat="3.125,1100" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="38" UseFont="false" />
        </Item17>
        <Item18 Ref="39" ControlType="XRLabel" Name="label73" Text="sử dụng lao động khi thời gian học việc chưa đủ tròn tháng thì người lao động sẽ không nhận được số" SizeF="734.6667,22.91663" LocationFloat="3.125,1028.125" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="40" UseFont="false" />
        </Item18>
        <Item19 Ref="41" ControlType="XRLabel" Name="label72" Multiline="true" Text="tiền lương tính theo ngày làm việc tương ứng (tức người lao động nếu vào học việc được 15 ngày tự ý nghỉ ngang không báo trước thì người lao dộng sẽ không được trả lương các ngày làm việc này)." SizeF="734.6667,48.95825" LocationFloat="3.125,1051.042" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="42" UseFont="false" />
        </Item19>
        <Item20 Ref="43" ControlType="XRLabel" Name="label71" Text="mà không báo trước cho người sử dụng lao động  hoặc không bàn giao đầy đủ công việc, tài sản cho người" SizeF="734.6667,22.91663" LocationFloat="3.125,1005.208" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="44" UseFont="false" />
        </Item20>
        <Item21 Ref="45" ControlType="XRLabel" Name="label70" Text="- Được trả lương vào ngày 10 tháng kế tiếp. Trường hợp đơn phương hoặc tự ý chấm dứt hợp đồng học việc" SizeF="734.6667,22.91663" LocationFloat="3.125,982.2917" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="46" UseFont="false" />
        </Item21>
        <Item22 Ref="47" ControlType="XRLabel" Name="label69" Text="- Hình thức trả lương: Tiền mặt VNĐ hoặc chuyển khoản." SizeF="542.7084,22.91669" LocationFloat="3.125,948.9584" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="48" UseFont="false" />
        </Item22>
        <Item23 Ref="49" ControlType="XRLabel" Name="label68" Text="VNĐ" SizeF="44.83359,22.91669" LocationFloat="355.1664,914.5834" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
