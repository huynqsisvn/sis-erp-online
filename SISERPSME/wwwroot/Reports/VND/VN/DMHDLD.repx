          <StylePriority Ref="60" UseFont="false" />
        </Item23>
        <Item24 Ref="61" ControlType="XRLabel" Name="label152" Text="Article 5: Implementation provisions" SizeF="502.0833,22.91669" LocationFloat="2.62536216,2792.406" Font="Times New Roman, 10pt, style=Bold" Padding="2,2,0,0,100">
          <StylePriority Ref="62" UseFont="false" />
        </Item24>
        <Item25 Ref="63" ControlType="XRLabel" Name="label128" Text="- Chấp hành lệnh sản xuất - kinh doanh, nội quy kỷ luật, an toàn lao động." SizeF="720.958435,22.9165039" LocationFloat="0.541202247,2189.855" Font="Times New Roman, 12pt" Padding="2,2,0,0,100">
          <StylePriority Ref="64" UseFont="false" />
        </Item25>
