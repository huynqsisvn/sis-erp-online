        </Item28>
        <Item29 Ref="65" ControlType="XRLabel" Name="label67" Multiline="true" Text="nghĩa Việt Nam và chịu trách nhiệm hoàn toàn về việc giao nhận số hàng trên. Do đơn hàng làm bằng fax nên không có bản" TextAlignment="MiddleLeft" SizeF="714,22" LocationFloat="0,819.0004" Font="Arial, 9pt" Padding="2,2,0,0,100">
