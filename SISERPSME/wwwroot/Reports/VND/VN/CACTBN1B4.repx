        </Item26>
        <Item27 Ref="61" ControlType="XRLabel" Name="label64" Multiline="true" Text="We commit ourselves in this payment orderto respect all regulations on foreign exchange control of Socialist Republic of Viet " TextAlignment="MiddleLeft" SizeF="714,22" LocationFloat="0,863.0004" Font="Arial, 9pt, style=Italic" Padding="2,2,0,0,100">
