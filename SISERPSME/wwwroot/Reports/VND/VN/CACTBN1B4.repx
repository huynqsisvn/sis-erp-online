        <Item25 Ref="57" ControlType="XRLabel" Name="label63" Multiline="true" Text="theo nội dung sau:" TextAlignment="MiddleLeft" SizeF="714,22" LocationFloat="0,116" Font="Arial, 9pt" Padding="2,2,0,0,100">
