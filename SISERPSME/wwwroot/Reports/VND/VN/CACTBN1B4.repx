        <Item28 Ref="63" ControlType="XRLabel" Name="label68" Multiline="true" Text="Chúng tôi cam kết lệnh chuyển tiền này đúng mọi quy định hiện hành về quản lý ngoại hối của nước Cộng hòa Xã hội Chủ " TextAlignment="MiddleLeft" SizeF="714,22" LocationFloat="0,797.0004" Font="Arial, 9pt" Padding="2,2,0,0,100">
