        <Item26 Ref="59" ControlType="XRLabel" Name="label6" Multiline="true" Text="Với trách nhiệm thuộc về chúng tôi, Quý ngân hàng được phép ghi nợ tài khoản của chúng tôi để thực hiện lệnh chuyển tiền &#xD;&#xA;" TextAlignment="MiddleLeft" SizeF="714,22" LocationFloat="0,94" Font="Arial, 9pt" Padding="2,2,0,0,100">
