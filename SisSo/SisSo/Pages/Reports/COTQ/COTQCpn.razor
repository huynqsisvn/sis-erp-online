    private async Task oBrowse_F5()
    {
        try
        {
            DataRowView selectedObj = CurItem as DataRowView;
            if (selectedObj == null)
            {
                myStateMN.SetNewThongbao(Lap["Please select a row to view detail"] + " !");
                return;
            }

            string selectedMaVt = selectedObj.Row.Table.Columns.Contains("ma_vt")
                ? selectedObj["ma_vt"]?.ToString().Trim()
                : "";

            string selectedSttRec = selectedObj.Row.Table.Columns.Contains("stt_rec")
               ? selectedObj["stt_rec"]?.ToString().Trim()
               : "";

            DateTime? selectedNgayGiao = selectedObj.Row.Table.Columns.Contains("ngay_giao") && selectedObj["ngay_giao"] != DBNull.Value
                ? Convert.ToDateTime(selectedObj["ngay_giao"])
                : (DateTime?)null;

            if (string.IsNullOrWhiteSpace(selectedMaVt) || string.IsNullOrWhiteSpace(selectedSttRec) || selectedNgayGiao == null)
            {
                myStateMN.SetNewThongbao("Không tìm thấy thông tin dòng được chọn!");
                return;
            }

            Selected_ma_vt = selectedMaVt;
            Selected_stt_rec = selectedSttRec;
            Selected_ngay_giao = selectedNgayGiao.Value;
            Ngay_giao_ncc_input = selectedNgayGiao.Value;
            NgayGiaoNccError = "";

            PopupNgayGiaoNccVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            myStateMN.SetNewThongbao("Error: " + ex.Message);
        }
    }

