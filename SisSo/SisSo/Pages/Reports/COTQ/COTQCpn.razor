@page "/cotqmb"
@page "/cotqmb/{Menu_id}"
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,cotqmb")]

@if (!IsDetail)
{
    <div class="row g-3 mb-3 cotq-stat-row">
        <div class="col-6 col-md-3">
            <div class="cotq-stat-card cotq-card-primary">
                <div class="cotq-stat-icon"><i class="fa-solid fa-cart-shopping"></i></div>
                <div>
                    <div class="cotq-stat-value">@TotalPO</div>
                    <div class="cotq-stat-label">@(IsLangEn ? "Purchase orders (PO)" : "Đơn đặt hàng (PO)")</div>
                    <div class="cotq-stat-sub">@(IsLangEn ? "Total active orders" : "Tổng số đơn đang hiệu lực")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cotq-stat-card cotq-card-info">
                <div class="cotq-stat-icon"><i class="fa-solid fa-truck"></i></div>
                <div>
                    <div class="cotq-stat-value">@CountDangGiao</div>
                    <div class="cotq-stat-label">@(IsLangEn ? "In delivery" : "Đang giao hàng")</div>
                    <div class="cotq-stat-sub">@(IsLangEn ? "Orders being fulfilled" : "Đơn hàng đang thực hiện")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cotq-stat-card cotq-card-success">
                <div class="cotq-stat-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div>
                    <div class="cotq-stat-value">@CountDaGiaoDu</div>
                    <div class="cotq-stat-label">@(IsLangEn ? "Fully delivered" : "Đã giao đủ")</div>
                    <div class="cotq-stat-sub">@(IsLangEn ? "Delivery completed" : "Hoàn thành giao hàng")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cotq-stat-card cotq-card-warning">
                <div class="cotq-stat-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <div>
                    <div class="cotq-stat-value">@CountCanGiao</div>
                    <div class="cotq-stat-label">@(IsLangEn ? "Need to deliver" : "Cần giao (sắp đến hạn)")</div>
                    <div class="cotq-stat-sub">@(IsLangEn ? "Needs attention" : "Cần xử lý gấp")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3 justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <div class="cotq-panel">
                <div class="cotq-panel-title">@(IsLangEn ? "Order status" : "Tình trạng đơn hàng")</div>
                @if (TotalPO > 0)
                {
                    <div class="cotq-donut-wrap">
                        <DxPieChart Data="@DonutData" Height="220px" InnerRadius="0.6" CssClass="cotq-donut-chart">
                            <DxPieChartSeries T="OrderStatusPoint" TArgument="string" TValue="int"
                                              ArgumentField="@(s => s.Category)" ValueField="@(s => s.Value)">
                            </DxPieChartSeries>
                            <DxChartLegend Visible="true" Position="RelativePosition.Outside" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalEdge.Bottom" Orientation="Orientation.Horizontal" />
                        </DxPieChart>
                        <div class="cotq-donut-center">
                            <div class="cotq-donut-center-value">@TotalPO</div>
                            <div class="cotq-donut-center-label">@(IsLangEn ? "Orders" : "Đơn hàng")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted text-center py-4">@Lap["No data available"]</div>
                }
            </div>
        </div>
    </div>

    <div class="row" @onkeydown="OnKeyDown" @onkeydown:preventDefault="true">
        <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" Fbrowse="@Fbrowse" SelectItem="@SelectedItem" RowStyleFunc="@GetRowStyle" CustomSummaryTextFormatter="@FormatSummaryText" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}
else
{
    <div class="row mt-1" @onkeydown="OnKeyDownCT" @onkeydown:preventDefault="true">
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblDataCT" SelectItem="@SelectItemCT" Fbrowse="@FbrowseCT" RowStyleFunc="@GetRowStyle" CustomSummaryTextFormatter="@FormatSummaryText" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}
<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup" onkeydown="ModifyEnterKeyPressAsTab(event);"
@bind-Visible="@PopupVisible"
Width="500px"
Height="Auto"
ShowFooter="true" Context="windowContext"
HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-3">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Customer code"]">
                        <Template>
                            <div class="col p-0">
                                <AutocompleteComponent Ma_dm="dmkh" @bind-Value="@Ma_kh" IsEnable="@AllowEditKh" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Item code"]">
                        <Template>
                            <div class="col p-0">
                                <AutocompleteComponent Ma_dm="dmvt" @bind-Value="@Ma_vt" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_Ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report template"]">
                        <DxComboBox Data="@StatusList2"
                                    @bind-Value="@Ma_nt"
                                    ValueField="Value"
                                    TextField="Text"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="VND" />
                    </DxFormLayoutItem>
                </DxFormLayout>

                @if (Errors.Any())
                {
                    <div class="mt-2 alert alert-danger p-2">
                        <ul class="mb-0">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>

    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end align-content-end">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

<DxPopup @ref="popNgayGiaoNcc" CloseOnOutsideClick="false" CssClass="dxPopup"
@bind-Visible="@PopupNgayGiaoNccVisible"
Width="400px"
Height="Auto"
ShowFooter="true" Context="ngayGiaoNccContext"
HeaderText="Ngày giao NCC">
    <BodyTemplate>
        <div class="p-3" @onkeydown="OnKeyDownNgayGiaoNcc">
            <DxFormLayout CssClass="w-100">
                <DxFormLayoutItem ColSpanMd="12" Caption="Ngày giao NCC">
                    <DxDateEdit CssClass="col" @bind-Date="@Ngay_giao_ncc_input" NullText=""
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                InputId="idNgayGiaoNcc" />
                </DxFormLayoutItem>
            </DxFormLayout>
            @if (!string.IsNullOrEmpty(NgayGiaoNccError))
            {
                <div class="mt-2 alert alert-danger p-2">@NgayGiaoNccError</div>
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="row m-0 justify-content-end align-content-end">
            <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmNgayGiaoNcc_OnOk" />
            <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancelNgayGiaoNcc" />
        </div>
    </FooterTemplate>
</DxPopup>

<style>
    .popup-button-footer {
    width: 100px;
    margin-right: 20px;
    margin-top: 5px;
    margin-bottom: 5px;
    }

    .input-invalid {
        border: 1px solid red !important;
        border-radius: 4px;
    }

    .tb-icon-btntoolbar1 {
    width: 24px;
    height: 24px;
    background-image: url('.\\Images\\detail.png');
    }

    .tb-icon-btntoolbar2 {
    width: 24px;
    height: 24px;
    background-image: url('.\\Images\\detail.png');
    }

    .dxbl-grid-footer td {
        white-space: pre-line;
        line-height: 1.4em;
    }

    /* ===== COTQ dashboard (cotq-*) ===== */
    .cotq-stat-card,
    .cotq-panel {
        --cotq-surface: #fff;
        --cotq-radius: 10px;
        --cotq-shadow: 0 1px 3px rgba(0,0,0,.08);
        --cotq-muted: #6c757d;
        background: var(--cotq-surface);
        border-radius: var(--cotq-radius);
        box-shadow: var(--cotq-shadow);
        height: 100%;
    }

    /* Stat cards */
    .cotq-stat-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-left: 4px solid var(--cotq-accent, #0d6efd);
    }

    .cotq-stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        background: var(--cotq-icon-bg, #e7f1ff);
        color: var(--cotq-icon-fg, #0d6efd);
    }

    .cotq-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
    }

    .cotq-stat-label {
        font-size: .8rem;
        font-weight: 600;
        margin-top: 2px;
    }

    .cotq-stat-sub {
        font-size: .72rem;
        color: var(--cotq-muted);
    }

    .cotq-card-primary {
        --cotq-accent: #0d6efd;
        --cotq-icon-bg: #e7f1ff;
        --cotq-icon-fg: #0d6efd;
    }

    .cotq-card-info {
        --cotq-accent: #0dcaf0;
        --cotq-icon-bg: #e0f7fb;
        --cotq-icon-fg: #0b96ac;
    }

    .cotq-card-success {
        --cotq-accent: #198754;
        --cotq-icon-bg: #e2f3ea;
        --cotq-icon-fg: #198754;
    }

    .cotq-card-warning {
        --cotq-accent: #fd7e14;
        --cotq-icon-bg: #fff0e0;
        --cotq-icon-fg: #fd7e14;
    }

    /* Donut panel: the legend sits under the chart, so the total is centred horizontally
       and shifted up by half the (approximate) legend height. */
    .cotq-panel {
        padding: 14px 16px;
        --cotq-legend-h: 32px;
    }

    .cotq-panel-title {
        font-weight: 600;
        margin-bottom: 8px;
    }

    .cotq-donut-wrap {
        position: relative;
    }

    .cotq-donut-center {
        position: absolute;
        top: calc(50% - (var(--cotq-legend-h) / 2));
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    .cotq-donut-center-value {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .cotq-donut-center-label {
        font-size: .75rem;
        color: var(--cotq-muted);
    }
</style>

@code {
    public DataTable TblDmtk { get; set; }
    public DataTable TblDmkh { get; set; }
    public FrmBrowseComponent oBrowseCT;
    public DataTable TblDmtkFilteredAsync { get; set; }
    // Filter values
    private DateTime Tu_ngay = DateTime.Now.Date;
    private DateTime Den_ngay = DateTime.Now.Date;
    private string Condition = "";
    private string Ma_bc = "";
    private string Ma_nt = "VND";
    private int luy_ke = 0;
    private string Ma_kh = "";
    private string Ma_vt = "";
    // Template / UI
    IList<ReportStyle> ReportTemplate = new List<ReportStyle>();
    private List<string> Errors { get; set; } = new();
    private bool AllowEditMode = true;
    // Cho phep sua o loc ma ncc (Customer code). Non-admin bi khoa, mac dinh lay theo ma_ncc cua tai khoan.
    private bool AllowEditKh = true;
    // Non-admin: chi xem theo ma ncc cua minh; neu khong co ma_ncc thi khong hien du lieu.
    private bool IsNonAdmin = false;
    private List<COTQModel> LsData;
    private List<object> StatusPsLK;
    // Popup nhap ngay giao NCC (F5) va cap nhat dmhdmctgt
    private DxPopup popNgayGiaoNcc;
    private bool PopupNgayGiaoNccVisible = false;
    private DateTime? Ngay_giao_ncc_input = DateTime.Now.Date;
    private string Selected_stt_rec = "";
    private string Selected_ma_vt = "";
    private DateTime Selected_ngay_giao = DateTime.Now.Date;
    private string NgayGiaoNccError = "";

    // Tong quan: thong ke theo PO (gom theo so_ct), tinh tu TblData sau moi lan Loaddata()
    private int TotalPO = 0;
    private int CountDangGiao = 0;
    private int CountDaGiaoDu = 0;
    private int CountCanGiao = 0;
    private List<OrderStatusPoint> DonutData = new();

    public class OrderStatusPoint
    {
        public string Category { get; set; }
        public int Value { get; set; }
    }

    public bool IsDetail { get; set; } = false;
    public bool IsDetailSum { get; set; } = false;
    public bool IsDetailSumCT { get; set; } = false;
    public DataTable TblDataCT;
    public DataTable TblDataCT1;
    public DataTable TblDataCT2;
    private object CurItemCT{ get; set;}
    public string FbrowseCT = "";
    public string Tk = "";
    public string Tk_du = "";
    public string[] sFieldArrays;
    public string ma_ncc = "";

    private async Task<DataTable> LoadTblDmtkFilteredAsync()
    {
        // Câu SQL chỉ lấy các dòng có tk_cn = 1
        string sqlTk = "SELECT * FROM dmtk WHERE tk_cn = 1";

        // Thực thi SQL, trả về DataSet
        var dsTk = await myDb.LoadDataset(sqlTk);

        // Nếu có dữ liệu, trả về DataTable đầu tiên, nếu không thì trả về DataTable rỗng
        if (dsTk != null && dsTk.Tables.Count > 0 && dsTk.Tables[0].Rows.Count > 0)
        {
            return dsTk.Tables[0].Copy();
        }
        else
        {
            return new DataTable(); // rỗng
        }
    }
    public void SelectItemCT(object obj)
    {
        CurItemCT = obj;
    }
    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wp.ct.21";
        base.OnInitialized();
        Users curUser = myStateMN.GetCurUser();

        ma_ncc = myDb.GetValue($"SELECT TOP 1 ma_kh FROM dmkh WHERE tk_portal = '{curUser.User_name.Trim()}'")?.ToString() ?? "";
        // Non-admin: mac dinh loc theo ma ncc cua minh va khong cho sua o loc ncc.
        IsNonAdmin = curUser.Is_admin == 0;
        if (IsNonAdmin)
        {
            Ma_kh = ma_ncc.Trim();
            AllowEditKh = false;
        }
        Ngay_ct1 = myStateMN.GetStartDate();
        Ngay_ct2 = myStateMN.GetEndDate();
        Tk = myStateMN.GetItem("M_TK")?.ToString() ?? "";
        TblDmtkFilteredAsync = await LoadTblDmtkFilteredAsync();
        StatusPsLK = new()
        {
            new { Value = 0, Text = Lap["No"] },
            new { Value = 1, Text = Lap["Yes"] }

        };
        StatusList2 = new()
            {
                new { Value = "VND", Text = Lap["VND form"] },
                new { Value = "NT", Text = Lap["FC form"] },
            };
    }
    private List<object> StatusList2;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e is null) return;
        if (string.Equals(e.Key, "F5", StringComparison.OrdinalIgnoreCase) || string.Equals(e.Code, "F5", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                oBrowse_F5();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        if (string.Equals(e.Key, "F", StringComparison.OrdinalIgnoreCase) && e.CtrlKey)
        {
            try
            {
                PopupVisible = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
    }
    private async Task OnKeyDownCT(KeyboardEventArgs e)
    {
        if (e is null) return;
        if (string.Equals(e.Key, "F5", StringComparison.OrdinalIgnoreCase) || string.Equals(e.Code, "F5", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                oBrowse_F5();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        if (string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase) || string.Equals(e.Key, "Esc", StringComparison.OrdinalIgnoreCase))
        {
            HideDetail();
            StateHasChanged();
        }
    }

    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Button1:
                oBrowse_F5();
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
            case ActionTask.Quit:
                HideDetail();
                StateHasChanged();
                break;
        }
    }
    public void HideDetail()
    {
        if (IsDetailSum)
        {
            IsDetail = false;
            IsDetailSum = false;
            ShowToolBar();
            IsDetailSumCT = false;
        }
        else
        {
            IsDetail = false;
            IsDetailSum = false;
            ShowToolBar();
        }
        StateHasChanged();
    }
    public override async Task ShowToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.AddOrderToolBarButton("Button1", Lap["Update ETA"], 1);
        myStateMN.SetToolBar(new MyToolbar("Search", true));
        myStateMN.SetToolBar(new MyToolbar("Print", true));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }
    public async Task ShowDetailToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Quit", true));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }
    public async Task ShowDetailSumToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.AddOrderToolBarButton("Button1", Lap["Update ETA"], 1);
        myStateMN.SetToolBar(new MyToolbar("Quit", true,"",17));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;

            if (curCommand != null)
                Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;

            ComputeDashboardStats();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(Ngay_ct1);
        myStateMN.SetEndDate(Ngay_ct2);
        myStateMN.SetItem("M_TK",Tk.Trim());
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;
        if (Tu_ngay == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Den_ngay == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Tu_ngay > Den_ngay)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        StateHasChanged();
        return ok;
    }

    public override async Task Loaddata()
    {
        if (Ngay_ct1 == null || Ngay_ct2 == null || Ngay_ct1 > Ngay_ct2)
        {
            myStateMN.SetNewThongbao(Lap["Incorrect date declaration"] + " !");
            return;
        }
        // Non-admin khong co ma ncc -> khong hien gi (tranh lay tat ca khach hang).
        if (IsNonAdmin && string.IsNullOrWhiteSpace(ma_ncc))
        {
            TblData = new DataTable();
            ComputeDashboardStats();
            ShowLoadding = false;
            StateHasChanged();
            return;
        }
        if (curCommand != null)
        {
            sFieldArrays = !(IsLangEn == false)
                ? (Ma_nt != "VND" ? curCommand.Ebrowse2.ToString().Split("|".ToCharArray()) : curCommand.Ebrowse1.Split("|".ToCharArray()))
                : (Ma_nt != "VND" ? curCommand.Vbrowse2.ToString().Split("|".ToCharArray()) : curCommand.Vbrowse1.Split("|".ToCharArray()));

            Fbrowse = sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
        }

        ShowLoadding = true;

        string maKh = string.IsNullOrWhiteSpace(Ma_kh) ? "" : Ma_kh.Trim();
        string maVt = string.IsNullOrWhiteSpace(Ma_vt) ? "" : Ma_vt.Trim();

        string param_name = "@hdTuNg;@hdDenNg;@ma_kh";
        string param_value =
            $"{Ngay_ct1:yyyyMMdd};" +
            $"{Ngay_ct2:yyyyMMdd};" +
            $"{maKh}";

        DataSet ds = await myDb.LoadStoreProcedure("COTQ", param_name, param_value);

        if (ds?.Tables?.Count > 0)
        {
            TblData = ds.Tables[0].Copy();
        }
        else
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
        }

        ComputeDashboardStats();
        ShowLoadding = false;
        StateHasChanged();
    }

    // Gom theo so_ct (PO): trang thai cua 1 PO = trang thai "xau nhat" trong cac dong giao hang cua no
    // uu tien: Can giao (qua han, chua xac nhan) > Dang giao (chua den han) > Da giao du (da co ngay xac nhan/duyet)
    private void ComputeDashboardStats()
    {
        TotalPO = 0;
        CountDangGiao = 0;
        CountDaGiaoDu = 0;
        CountCanGiao = 0;
        DonutData = new List<OrderStatusPoint>();

        if (TblData == null || TblData.Columns.Count == 0 || !TblData.Columns.Contains("so_ct"))
            return;

        DateTime today = DateTime.Today;
        var poStatus = new Dictionary<string, int>(); // 0 = Da giao du, 1 = Dang giao, 2 = Can giao

        foreach (DataRow row in TblData.Rows)
        {
            string soCt = row["so_ct"]?.ToString().Trim();
            if (string.IsNullOrEmpty(soCt))
                continue;

            DateTime? etaXn = GetDate(row, "ETA_XN");
            DateTime? etaNcc = GetDate(row, "ETA_NCC");
            DateTime? etaPic = GetDate(row, "ETA_PIC");
            DateTime? hanGiao = etaNcc ?? etaPic;

            int lineStatus;
            if (etaXn != null)
                lineStatus = 0;
            else if (hanGiao != null && hanGiao.Value.Date < today)
                lineStatus = 2;
            else
                lineStatus = 1;

            if (!poStatus.ContainsKey(soCt) || lineStatus > poStatus[soCt])
                poStatus[soCt] = lineStatus;
        }

        TotalPO = poStatus.Count;
        CountDaGiaoDu = poStatus.Values.Count(v => v == 0);
        CountDangGiao = poStatus.Values.Count(v => v == 1);
        CountCanGiao = poStatus.Values.Count(v => v == 2);

        DonutData.Add(new OrderStatusPoint { Category = IsLangEn ? "Fully delivered" : "Đã giao đủ", Value = CountDaGiaoDu });
        DonutData.Add(new OrderStatusPoint { Category = IsLangEn ? "In delivery" : "Đang giao", Value = CountDangGiao });
        DonutData.Add(new OrderStatusPoint { Category = IsLangEn ? "Need to deliver" : "Cần giao", Value = CountCanGiao });
    }

    private DateTime? GetDate(DataRow row, string col)
    {
        if (!row.Table.Columns.Contains(col))
            return null;
        var v = row[col];
        if (v == null || v == DBNull.Value)
            return null;
        if (v is DateTime dt)
            return dt;
        string s = v.ToString().Trim();
        if (string.IsNullOrEmpty(s))
            return null;
        if (DateTime.TryParseExact(s, "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var d1))
            return d1;
        if (DateTime.TryParse(s, out var d2))
            return d2;
        return null;
    }

