@page "/frmarbp"
@page "/frmarbp/{menu_id}"
@page "/frmarbp/{menu_id}/{ma_bp}"
@inject Statemanagerment myStatemanagerment
@inject NavigationManager navigation
@inject IDbManager myDb
@inject IJSRuntime JavacriptS
@inject IStringLocalizer<App> Lap

<DxPopup @bind-Visible="@PopVisible"
         ShowFooter="false" ShowHeader="false"
         CloseOnEscape="false"
         CloseOnOutsideClick="false"
         ShowCloseButton="false"
         Width="auto"
         MinWidth="650px"
         MinHeight="200px"
         MaxHeight="98vh"
         AllowResize="true"
         AllowDrag="true"
         AllowDragByHeaderOnly="true">
    <BodyTemplate>
        <div class="row">
            <EditArbp Ma_ma="@ma_bp" Menu_id="@menu_id" curActionTask="@curActionTask" ShowAdd="@ShowAdd" OnClose="ClickHandler"></EditArbp>
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter]
    public string menu_id { get; set; }
    [Parameter]
    public string ma_bp { get; set; }
    [Parameter]
    public ActionTask curActionTask { get; set; } = ActionTask.None;
    [Parameter]
    public bool ShowAdd { get; set; }

    public bool PopVisible { get; set; } = true;

    protected override void OnInitialized()
    {
        if (curActionTask == ActionTask.None)
        {
            curActionTask = myStatemanagerment.GetCurrentActionTask();
        }
    }
    private void ClickHandler()
    {
        PopVisible = false;
        OnClose.InvokeAsync();
    }
}
