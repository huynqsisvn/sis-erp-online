    // Delete - Xóa
    public override async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        { 
            MessageDl = String.Format(Lap["Do you want to delete :{0} ?"], SqlTableKeyValue);
            ResultDl = await myDlSvc.ConfirmAsync(new MessageBoxOptions()
            {
                Text = MessageDl,
                Title = Lap["Confirm deletion of list"],
                OkButtonText = Lap["OK"],
                CancelButtonText = Lap["Cancel"],
                ShowIcon = true,
                ShowCloseButton = false,
                RenderStyle = MessageBoxRenderStyle.Danger,
            });
            if (ResultDl == true)
            {
                Dongy_xoa(rview, true);
                StateHasChanged();
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }
    
    public async Task Dongy_xoa(DataRowView rview, bool status)
    {
        if (status)
        {
            string ngayBanFormatted = "";
            if (rview["ngay_ban"] != null && rview["ngay_ban"] != DBNull.Value)
            {
                // Cast trực tiếp nếu là DateTime, nếu không thì lấy ToString()
                if (rview["ngay_ban"] is DateTime)
                {
                    ngayBanFormatted = ((DateTime)rview["ngay_ban"]).ToString("yyyyMMdd");
                }
                else
                {
                    ngayBanFormatted = rview["ngay_ban"].ToString().Trim();
                }
            }
            
            string sql = "Delete " + sqlTableName + $" where ma_vt ='{rview["ma_vt"].ToString().Trim()}' AND nh_kh3 = N'{rview["nh_kh3"].ToString().Trim()}' AND CONVERT(char(8), ngay_ban, 112) = '{ngayBanFormatted}'";
            await myDb.ExecuteSqlQueryAsync(sql);
            await Loaddata();
            string ToastMessage = String.Format(Lap["Delete successfully : {0}"], rview["ma_vt"].ToString().Trim());
            myStateMN.SetNewThongbao(ToastMessage);
        }
        MessageDl = "";
    }
    
}
