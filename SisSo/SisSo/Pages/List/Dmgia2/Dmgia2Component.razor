@page "/sogia2"
@page "/sogia2/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,sogia2")]

<div class="row mt-1" @onkeydown="@OnoBrowseKeyDown" @onkeydown:preventDefault="true">
    <FrmBrowseComponent @ref="oBrowse" TblData="@TblData" Fbrowse="@fbrowse" Page_size="@Page_size" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>
@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="40vw"
              MinWidth="500px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible" List_ID="@sqlTableName" Ma_ma="@SqlTableKeyValue" Title="@Lap["Change Item code"]" Ten_item="@Ten_item" OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
  
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportDM @bind-IsImportPopupVisible="@IsImportPopupVisible" CurDmimex="@CurDmimex" OnImportCompleted="@ImportOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {

    protected override void OnInitialized()
    {
        mPage = "sogia2";
        IsShowCopy = true;
        IsShowImport = true;
        FrmType = typeof(List.Dmgia2.EditDmgia2);
        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "ws_dm_06";
        base.OnInitialized();
    }

    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                myStateMN.SetCurrentActionTask(ActionTask.New);
                V_Moi();
                break;
            case ActionTask.Copy:
                myStateMN.SetCurrentActionTask(ActionTask.Copy);
                V_Copy();
                break;
            case ActionTask.Edit:
                myStateMN.SetCurrentActionTask(ActionTask.Edit);
                V_Sua();
                break;
            case ActionTask.View:
                myStateMN.SetCurrentActionTask(ActionTask.View);
                V_Xem();
                break;
            case ActionTask.Delete:
                V_Xoa();
                break;           
            case ActionTask.Import:
                V_Import();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }
    // View - Xem chi tiết
    public override void V_Xem()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string[] strKeys = SqlTableKey.Split(";");
            bool hasAllKeys = true;
            foreach (string key in strKeys)
            {
                if (!rview.DataView.Table.Columns.Contains(key))
                {
                    hasAllKeys = false;
                    break;
                }
            }

            if (!hasAllKeys)
                return;

            List<string> keyValues = new List<string>();
            foreach (string key in strKeys)
            {
                if (rview[key] != null && rview[key] != DBNull.Value)
                {
                    string value;                    
                    if (rview[key] is DateTime)
                    {
                        value = ((DateTime)rview[key]).ToString("yyyyMMdd");
                    }
                    else
                    {
                        value = rview[key].ToString().Trim();
                    }
                    keyValues.Add(value);
                }
            }

            if (keyValues.Count == strKeys.Length)
            {
                SqlTableKeyValue = String.Join(";", keyValues);

                if (editPage.ToUpper().StartsWith("FRM"))
                    myNavi.NavigateTo(editPage + "/" + Menu_id + "/" + SqlTableKeyValue);
                else
                {
                    Par.Clear();
                    Par.Add("Ma_ma", (object)SqlTableKeyValue);
                    Par.Add("Menu_id", (object)Menu_id);
                    Par.Add("ShowAdd", (object)true);
                    Par.Add("curActionTask", (object)ActionTask.View);
                    Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
                    IsShowFrm = true;
                    StateHasChanged();
                }
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }
