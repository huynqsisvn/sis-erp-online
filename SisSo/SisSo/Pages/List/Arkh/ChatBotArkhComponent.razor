    public async Task<string> CallChatGPT(string prompt)
    {
        try
        {
            using var client = new HttpClient();
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);
            chatHistory.Add(new GptMessage { role = "user", content = prompt });

            var requestBody = new
            {
                model = ChatBotConfig.ModelName,
                messages = chatHistory,
                max_tokens = ChatBotConfig.MaxTokens,
                temperature = ChatBotConfig.Temperature
            };

            var json = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync("https://api.openai.com/v1/chat/completions", content);
            var resultJson = await response.Content.ReadAsStringAsync();

            using var doc = JsonDocument.Parse(resultJson);
            var reply = doc.RootElement
                   .GetProperty("choices")[0]
                   .GetProperty("message")
                   .GetProperty("content")
                   .GetString();
            chatHistory.Add(new GptMessage { role = "assistant", content = reply });

            return reply;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            return "";
        }
    }

    private Dmkh ParseCustomerFromResponse(string response, out string message, out string missingFields)
    {
        message = response;
        missingFields = "";
        try
        {
            int jsonStart = response.IndexOf("{");
            int jsonEnd = response.LastIndexOf("}");

            if (jsonStart >= 0 && jsonEnd > jsonStart)
            {
                string jsonStr = response.Substring(jsonStart, jsonEnd - jsonStart + 1);
                using var doc = JsonDocument.Parse(jsonStr);
                var root = doc.RootElement;

                var customer = new Dmkh();

                if (root.TryGetProperty("ma_kh", out var maKh) && !string.IsNullOrEmpty(maKh.GetString()))
                    customer.Ma_kh = maKh.GetString();

                if (root.TryGetProperty("ten_kh", out var tenKh) && !string.IsNullOrEmpty(tenKh.GetString()))
                    customer.Ten_kh = tenKh.GetString();

                if (root.TryGetProperty("ma_so_thue", out var mst) && !string.IsNullOrEmpty(mst.GetString()))
                {
                    customer.Ma_so_thue = mst.GetString();
                    // MST sẽ được xử lý sau khi parse xong - không gọi API ở đây
                }

                if (root.TryGetProperty("dia_chi", out var diaChi) && !string.IsNullOrEmpty(diaChi.GetString()))
                    customer.Dia_chi = diaChi.GetString();

                if (root.TryGetProperty("dien_thoai", out var dienThoai) && !string.IsNullOrEmpty(dienThoai.GetString()))
                    customer.Dien_thoai = dienThoai.GetString();

                if (root.TryGetProperty("doi_tac", out var doiTac) && !string.IsNullOrEmpty(doiTac.GetString()))
                    customer.Doi_tac = doiTac.GetString();

                if (root.TryGetProperty("message", out var msg))
                    message = msg.GetString();

                customer.Status = "1";
                customer.Date = DateTime.Now.Date;
                customer.Date0 = DateTime.Now.Date;

                // Kiểm tra missing fields - sẽ được tự động enable sau khi API load xong
                List<string> missing = new List<string>();
                if (string.IsNullOrEmpty(customer.Ma_kh))
                    missing.Add("Mã khách hàng");
                if (string.IsNullOrEmpty(customer.Ten_kh))
                    missing.Add("Tên khách hàng");

                if (missing.Count > 0)
                {
                    missingFields = "⚠ Thiếu: " + string.Join(", ", missing);
                }

                return customer;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Parse error: {ex.Message}");
        }

        return null;
    }

    private async void ConfirmCreateCustomer(Dmkh customer)
    {
        if (customer != null)
        {
            // Validate required fields
            if (string.IsNullOrEmpty(customer.Ma_kh) || string.IsNullOrEmpty(customer.Ten_kh))
            {
                AddMessage("⚠ Không thể lưu: Thiếu thông tin bắt buộc (Mã KH và Tên KH).");
                return;
            }

            ChatContent confirmMsg = new ChatContent();
            confirmMsg.Name = "Hệ thống";
            confirmMsg.Time = DateTime.Now;
            confirmMsg.Role = "assistant";

            if (_isEditingExistingCustomer)
            {
                // Update existing customer
                await OnCustomerUpdated.InvokeAsync(customer);
                confirmMsg.Text = $"✓ Đã cập nhật khách hàng: {customer.Ten_kh} (Mã: {customer.Ma_kh})";
                _isEditingExistingCustomer = false;
                _originalMaKh = "";
            }
            else
            {
                // Create new customer (or restore deleted customer)
                bool isRestore = (_lastDeletedCustomer != null && 
                                 _lastDeletedCustomer.Ma_kh == customer.Ma_kh);
                
                await OnCustomerCreated.InvokeAsync(customer);
                
                if (isRestore)
                {
                    confirmMsg.Text = $"✅ **ĐÃ KHÔI PHỤC THÀNH CÔNG**\n\nKhách hàng: **{customer.Ten_kh}**\nMã KH: {customer.Ma_kh}\n\nDữ liệu đã được khôi phục vào hệ thống.";
                    _lastDeletedCustomer = null; // Clear backup sau khi khôi phục
                    Console.WriteLine($"[RESTORE SUCCESS] Cleared backup for {customer.Ma_kh}");
                }
                else
                {
                    confirmMsg.Text = $"✓ Đã gửi yêu cầu tạo khách hàng: {customer.Ten_kh} (Mã: {customer.Ma_kh})";
                }
            }

            LSmessage.Add(confirmMsg);

            // Reset editing state
            _editingCustomer = null;

            StateHasChanged();
        }
    }

    private async Task SearchCustomer(string searchText)
    {
        try
        {
            // Input đã được auto-correct từ ChatFunc() - không cần correct lại
            
            // Parse search keyword
            string keyword = searchText.ToLower()
                .Replace("tìm", "").Replace("tim", "")
                .Replace("sửa", "").Replace("sua", "")
                .Replace("edit", "").Replace("search", "")
                .Replace("mã", "").Replace("ma", "")
                .Replace("khách", "").Replace("khach", "")
                .Replace("customer", "")
                .Trim();

            if (string.IsNullOrEmpty(keyword))
            {
                AddMessage("⚠ Vui lòng nhập mã hoặc tên khách hàng cần tìm.\n\n📝 **Cú pháp đúng:**\n• 'Tìm khách KH001'\n• 'Tìm khách Công ty ABC'\n• 'Sửa khách hàng KH001'\n\n⚠️ Lưu ý: Phải có từ **'khách'** hoặc **'KH'**");
                await Task.Delay(100);
                await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
                return;
            }

            // ========== SMART SEARCH với Priority Ranking ==========
            string sql = $@"
                SELECT TOP 10 *, 
                    CASE 
                        -- Exact match (highest priority)
                        WHEN ma_kh = '{keyword}' THEN 1000
                        WHEN LOWER(ten_kh) = N'{keyword.ToLower()}' THEN 950
                        
                        -- Start with (high priority)
                        WHEN ma_kh LIKE '{keyword}%' THEN 900
                        WHEN LOWER(ten_kh) LIKE N'{keyword.ToLower()}%' THEN 850
                        
                        -- End with (medium priority)
                        WHEN ma_kh LIKE '%{keyword}' THEN 800
                        WHEN LOWER(ten_kh) LIKE N'%{keyword.ToLower()}' THEN 750
                        
                        -- Contains (lower priority)
                        WHEN ma_kh LIKE '%{keyword}%' THEN 700
                        WHEN LOWER(ten_kh) LIKE N'%{keyword.ToLower()}%' THEN 650
                        
                        -- MST match (medium priority)
                        WHEN ma_so_thue = '{keyword}' THEN 880
                        WHEN ma_so_thue LIKE '{keyword}%' THEN 780
                        WHEN ma_so_thue LIKE '%{keyword}%' THEN 680
                        
                        ELSE 500
                    END AS MatchScore
                FROM dmkh
                WHERE ma_kh LIKE '%{keyword}%'
                   OR LOWER(ten_kh) LIKE N'%{keyword.ToLower()}%'
                   OR ma_so_thue LIKE '%{keyword}%'
                ORDER BY MatchScore DESC, ma_kh";

            var ds = await myDb.LoadDataset(sql);

            if (ds == null || ds.Tables[0].Rows.Count == 0)
            {
                AddMessage($"❌ Không tìm thấy khách hàng với từ khóa: **'{keyword}'**\n\n💡 Gợi ý:\n• Kiểm tra lại mã/tên khách hàng\n• Thử tìm với từ khóa khác");
                await Task.Delay(100);
                await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
                return;
            }

            // ========== SMART SELECTION LOGIC ==========
            
            var rows = ds.Tables[0].Rows;
            int bestScore = rows[0]["MatchScore"] != DBNull.Value ? Convert.ToInt32(rows[0]["MatchScore"]) : 0;
            int secondScore = rows.Count > 1 && rows[1]["MatchScore"] != DBNull.Value 
                ? Convert.ToInt32(rows[1]["MatchScore"]) 
                : 0;

            // ========== Auto-select nếu có EXACT MATCH hoặc BEST MATCH rõ ràng ==========
            bool autoSelect = false;
            string reason = "";

            if (bestScore >= 1000)
            {
                // Exact match found → Always auto-select
                autoSelect = true;
                reason = "Tìm thấy khách hàng **khớp chính xác**";
            }
            else if (bestScore >= 900 && secondScore < 850)
            {
                // Best match có score cao hơn rõ ràng (gap >= 50)
                autoSelect = true;
                reason = "Tìm thấy khách hàng **phù hợp nhất**";
            }
            else if (rows.Count == 1)
            {
                // Chỉ có 1 kết quả → Auto-select
                autoSelect = true;
                reason = "Tìm thấy **1 khách hàng duy nhất**";
            }

            // Display results
            ChatContent resultMsg = new ChatContent();
            resultMsg.Name = "Trợ lý AI";
            resultMsg.Time = DateTime.Now;
            resultMsg.Role = "assistant";

            if (autoSelect)
            {
                // ========== AUTO-SELECT: Show customer detail ==========
                var row = rows[0];
                var customer = new Dmkh
                {
                    Ma_kh = row["Ma_kh"]?.ToString() ?? "",
                    Ten_kh = row["Ten_kh"]?.ToString() ?? "",
                    Ma_so_thue = row["Ma_so_thue"]?.ToString() ?? "",
                    Dia_chi = row["Dia_chi"]?.ToString() ?? "",
                    Dien_thoai = row["Dien_thoai"]?.ToString() ?? "",
                    Doi_tac = row["Doi_tac"]?.ToString() ?? "",
                    Status = row["Status"]?.ToString() ?? "1",
                    Date = row["Date"] != DBNull.Value ? Convert.ToDateTime(row["Date"]) : DateTime.Now.Date,
                    Date0 = row["Date0"] != DBNull.Value ? Convert.ToDateTime(row["Date0"]) : DateTime.Now.Date
                };

                resultMsg.Text = $"✅ {reason} cho từ khóa **'{keyword}'**:\n\n" +
                                $"📋 Bạn có thể **chỉnh sửa** thông tin hoặc xem chi tiết.";
                resultMsg.CustomerData = customer;
            }
            else
            {
                // ========== SHOW LIST: Multiple similar matches ==========
                string resultText = $"🔍 Tìm thấy **{rows.Count} khách hàng** phù hợp với **'{keyword}'**:\n\n";
                
                // Show top 5 results với score
                for (int i = 0; i < Math.Min(rows.Count, 5); i++)
                {
                    var row = rows[i];
                    int score = row["MatchScore"] != DBNull.Value ? Convert.ToInt32(row["MatchScore"]) : 0;
                    string matchType = score >= 1000 ? "✅ Khớp chính xác" :
                                      score >= 900 ? "🎯 Bắt đầu với" :
                                      score >= 800 ? "🔚 Kết thúc với" :
                                      "🔎 Chứa từ khóa";
                    
                    resultText += $"{i + 1}. **{row["Ma_kh"]}** - {row["Ten_kh"]}\n";
                    if (i == 0) resultText += $"   {matchType}\n";
                }
                
                if (rows.Count > 5)
                {
                    resultText += $"\n... và {rows.Count - 5} khách hàng khác.\n";
                }
                
                resultText += $"\n💡 **Để xem chi tiết:**\n";
                resultText += $"• Nhập **chính xác** mã KH: 'Tìm {rows[0]["Ma_kh"]}'\n";
                resultText += $"• Hoặc nhập **đầy đủ** tên công ty\n";
                resultText += $"\n⚡ **Gợi ý nhanh:** 'Sửa {rows[0]["Ma_kh"]}'";

                resultMsg.Text = resultText;
            }

            LSmessage.Add(resultMsg);
            StateHasChanged();
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
        catch (Exception ex)
        {
            AddMessage($"❌ Lỗi khi tìm kiếm: {ex.Message}");
            Console.WriteLine($"Search error: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

