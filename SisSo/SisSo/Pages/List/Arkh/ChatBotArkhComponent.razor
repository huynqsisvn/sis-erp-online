    /// <summary>
    /// Xử lý yêu cầu xóa khách hàng - AI tự nhận dạng
    /// VD: "Xóa khách Công ty ABC", "Delete khách KH001", "Xóa KH MST 0123456789"
    /// </summary>
    private async Task ProcessDeleteRequest(string input)
    {
        try
        {
            // Input đã được auto-correct từ ChatFunc() - không cần correct lại
            
            // Extract keyword từ input
            string keyword = input.ToLower()
                .Replace("xóa", "").Replace("xoa", "")
                .Replace("delete", "").Replace("remove", "")
                .Replace("mã", "").Replace("ma", "")
                .Replace("khách", "").Replace("khach", "")
                .Replace("customer", "")
                .Replace("mst", "").Replace("công ty", "").Replace("cong ty", "")
                .Trim();

            if (string.IsNullOrEmpty(keyword) || keyword.Length < 2)
            {
                AddMessage("⚠ Vui lòng cung cấp thêm thông tin:\n\n📝 **Cú pháp đúng:**\n• 'Xóa khách KH001' - xóa theo mã\n• 'Xóa khách 0123456789' - xóa theo MST\n• 'Xóa khách Công ty ABC' - xóa theo tên\n\n⚠️ Lưu ý: Phải có từ **'khách'** hoặc **'KH'**");
                await Task.Delay(100);
                await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
                return;
            }

            // ========== SMART SEARCH với Priority Ranking (giống SearchCustomer) ==========
            string sql = $@"
                SELECT TOP 10 *, 
                    CASE 
                        -- Exact match (highest priority)
                        WHEN ma_kh = '{keyword}' THEN 1000
                        WHEN LOWER(ten_kh) = N'{keyword.ToLower()}' THEN 950
                        
                        -- Start with (high priority)
                        WHEN ma_kh LIKE '{keyword}%' THEN 900
                        WHEN LOWER(ten_kh) LIKE N'{keyword.ToLower()}%' THEN 850
                        
                        -- End with (medium priority)
                        WHEN ma_kh LIKE '%{keyword}' THEN 800
                        WHEN LOWER(ten_kh) LIKE N'%{keyword.ToLower()}' THEN 750
                        
                        -- Contains (lower priority)
                        WHEN ma_kh LIKE '%{keyword}%' THEN 700
                        WHEN LOWER(ten_kh) LIKE N'%{keyword.ToLower()}%' THEN 650
                        
                        -- MST match (medium priority)
                        WHEN ma_so_thue = '{keyword}' THEN 880
                        WHEN ma_so_thue LIKE '{keyword}%' THEN 780
                        WHEN ma_so_thue LIKE '%{keyword}%' THEN 680
                        
                        ELSE 500
                    END AS MatchScore
                FROM dmkh
                WHERE ma_kh LIKE '%{keyword}%'
                   OR LOWER(ten_kh) LIKE N'%{keyword.ToLower()}%'
                   OR ma_so_thue LIKE '%{keyword}%'
                ORDER BY MatchScore DESC, ma_kh";

            var ds = await myDb.LoadDataset(sql);

            if (ds == null || ds.Tables[0].Rows.Count == 0)
            {
                AddMessage($"❌ Không tìm thấy khách hàng phù hợp với: **'{keyword}'**\n\n💡 Gợi ý:\n• Kiểm tra lại mã/tên khách hàng\n• Dùng lệnh 'Tìm {keyword}' để xem danh sách");
                await Task.Delay(100);
                await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
                return;
            }

            // ========== SMART SELECTION LOGIC ==========
            var rows = ds.Tables[0].Rows;
            int bestScore = rows[0]["MatchScore"] != DBNull.Value ? Convert.ToInt32(rows[0]["MatchScore"]) : 0;
            int secondScore = rows.Count > 1 && rows[1]["MatchScore"] != DBNull.Value 
                ? Convert.ToInt32(rows[1]["MatchScore"]) 
                : 0;

            string maKh = rows[0]["Ma_kh"]?.ToString() ?? "";
            string tenKh = rows[0]["Ten_kh"]?.ToString() ?? "";
            string mst = rows[0]["Ma_so_thue"]?.ToString() ?? "";

            // ========== Auto-proceed nếu có EXACT MATCH hoặc BEST MATCH rõ ràng ==========
            bool autoSelect = false;

            if (bestScore >= 1000)
            {
                // Exact match → Auto-proceed to delete check
                autoSelect = true;
            }
            else if (bestScore >= 900 && secondScore < 850)
            {
                // Best match rõ ràng (gap >= 50) → Auto-proceed
                autoSelect = true;
            }
            else if (rows.Count == 1)
            {
                // Chỉ có 1 kết quả → Auto-proceed
                autoSelect = true;
            }

            if (autoSelect)
            {
                // ========== AUTO-SELECT: Proceed to delete check ==========
                await CheckAndConfirmDelete(maKh, tenKh, mst);
            }
            else
            {
                // ========== SHOW LIST: User needs to choose ==========
                string resultText = $"🔍 Tìm thấy **{rows.Count} khách hàng** phù hợp với **'{keyword}'**:\n\n";
                
                for (int i = 0; i < Math.Min(rows.Count, 5); i++)
                {
                    var row = rows[i];
                    int score = row["MatchScore"] != DBNull.Value ? Convert.ToInt32(row["MatchScore"]) : 0;
                    string matchType = score >= 1000 ? "✅ Khớp chính xác" :
                                      score >= 900 ? "🎯 Bắt đầu với" :
                                      score >= 800 ? "🔚 Kết thúc với" :
                                      "🔎 Chứa từ khóa";
                    
                    resultText += $"{i + 1}. **{row["Ma_kh"]}** - {row["Ten_kh"]}\n";
                    if (i == 0) resultText += $"   {matchType}\n";
                }
                
                if (rows.Count > 5)
                {
                    resultText += $"\n... và {rows.Count - 5} khách hàng khác.\n";
                }
                
                resultText += $"\n⚠️ **Để xóa khách hàng cụ thể:**\n";
                resultText += $"• Nhập **chính xác** mã KH: 'Xóa {rows[0]["Ma_kh"]}'\n";
                resultText += $"• Hoặc nhập **đầy đủ** tên công ty\n";
                resultText += $"\n⚡ **Gợi ý nhanh:** 'Xóa {rows[0]["Ma_kh"]}'";

                ChatContent confirmMsg = new ChatContent();
                confirmMsg.Name = "Trợ lý AI";
                confirmMsg.Time = DateTime.Now;
                confirmMsg.Text = resultText;
                confirmMsg.Role = "assistant";

                LSmessage.Add(confirmMsg);
                StateHasChanged();
                await Task.Delay(100);
                await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
            }
        }
        catch (Exception ex)
        {
            AddMessage($"❌ Lỗi khi xử lý yêu cầu xóa: {ex.Message}");
            Console.WriteLine($"ProcessDeleteRequest error: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

    /// <summary>
    /// Kiểm tra phát sinh và yêu cầu xác nhận xóa
    /// Stored procedure trả về: 1 = được phép xóa, 0 = đã có phát sinh
    /// </summary>
    private async Task CheckAndConfirmDelete(string maKh, string tenKh, string mst)
    {
        try
        {
            // Gọi stored procedure để kiểm tra phát sinh
            string checkSql = $"EXEC [dbo].[CheckDeleteListId] @ma_dm = 'dmkh', @value = '{maKh}', @notvalue = ''";
            var checkDs = await myDb.LoadDataset(checkSql);

            bool canDelete = true;
            string transactionInfo = "";

            if (checkDs != null && checkDs.Tables.Count > 0 && checkDs.Tables[0].Rows.Count > 0)
            {
                var row = checkDs.Tables[0].Rows[0];
                
                // Stored Procedure trả về 1 = được xóa, 0 = có phát sinh
                if (checkDs.Tables[0].Columns.Contains("CanDelete"))
                {
                    int canDeleteValue = Convert.ToInt32(row["CanDelete"]);
                    canDelete = (canDeleteValue == 1);  // 1 = OK, 0 = Blocked
                    transactionInfo = row["Message"]?.ToString() ?? "";
                }
                else if (checkDs.Tables[0].Columns.Count > 0)
                {
                    // Fallback: Nếu có column đầu tiên chứa kết quả số
                    try
                    {
                        int result = Convert.ToInt32(row[0]);
                        canDelete = (result == 1);  // 1 = OK, 0 = Blocked
                        
                        // Nếu có column thứ 2 = message
                        if (checkDs.Tables[0].Columns.Count > 1 && row[1] != DBNull.Value)
                        {
                            transactionInfo = row[1].ToString();
                        }
                    }
                    catch
                    {
                        // Nếu không parse được số → có data = có phát sinh
                        canDelete = false;
                        transactionInfo = row[0]?.ToString() ?? "Khách hàng đã có phát sinh giao dịch";
                    }
                }
            }

            ChatContent resultMsg = new ChatContent();
            resultMsg.Name = "Trợ lý AI";
            resultMsg.Time = DateTime.Now;
            resultMsg.Role = "assistant";

            if (!canDelete)
            {
                // Không cho phép xóa (return 0)
                resultMsg.Text = $"⛔ **KHÔNG THỂ XÓA KHÁCH HÀNG**\n\n";
                resultMsg.Text += $"**{tenKh}**\n";
                resultMsg.Text += $"• Mã KH: {maKh}\n";
                if (!string.IsNullOrEmpty(mst))
                    resultMsg.Text += $"• MST: {mst}\n";
                
                if (!string.IsNullOrEmpty(transactionInfo))
                {
                    resultMsg.Text += $"\n❌ **Lý do:** {transactionInfo}\n\n";
                }
                else
                {
                    resultMsg.Text += $"\n❌ **Lý do:** Khách hàng đã có phát sinh giao dịch\n\n";
                }
                
                resultMsg.Text += $"📊 **Khách hàng này đã có phát sinh:**\n";
                resultMsg.Text += $"• Hóa đơn bán hàng\n";
                resultMsg.Text += $"• Chứng từ kế toán\n";
                resultMsg.Text += $"• Phiếu thu/chi\n";
                resultMsg.Text += $"• Phiếu nhập/xuất kho\n\n";
                resultMsg.Text += $"💡 **Khuyến nghị:**\n";
                resultMsg.Text += $"• Đặt trạng thái 'Ngừng hoạt động'\n";
                resultMsg.Text += $"• Lưu trữ thay vì xóa để giữ dữ liệu lịch sử\n";
                resultMsg.Text += $"• Liên hệ quản trị viên nếu thực sự cần xóa";
            }
            else
            {
                // Cho phép xóa (return 1) - Yêu cầu xác nhận
                resultMsg.Text = $"⚠️ **XÁC NHẬN XÓA KHÁCH HÀNG**\n\n";
                resultMsg.Text += $"📋 **Thông tin khách hàng:**\n";
                resultMsg.Text += $"• Tên: **{tenKh}**\n";
                resultMsg.Text += $"• Mã KH: {maKh}\n";
                if (!string.IsNullOrEmpty(mst))
                    resultMsg.Text += $"• MST: {mst}\n";
                resultMsg.Text += $"\n✅ Khách hàng này **chưa có phát sinh** giao dịch.\n\n";
                resultMsg.Text += $"⚠️ **Cảnh báo:** Hành động này **KHÔNG THỂ HOÀN TÁC**!\n\n";
                resultMsg.Text += $"Nhấn nút **'Xóa'** bên dưới để xác nhận.";

                // Attach customer data for delete button
                resultMsg.CustomerData = new Dmkh
                {
                    Ma_kh = maKh,
                    Ten_kh = tenKh,
                    Ma_so_thue = mst,
                    Status = "DELETE_READY"  // Ready to delete
                };
            }

            LSmessage.Add(resultMsg);
            StateHasChanged();
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
        catch (Exception ex)
        {
            AddMessage($"❌ Lỗi khi kiểm tra phát sinh: {ex.Message}");
            Console.WriteLine($"CheckAndConfirmDelete error: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

    /// <summary>
    /// Thực hiện xóa khách hàng sau khi đã xác nhận
    /// </summary>
    private async Task ExecuteDeleteCustomer(Dmkh customer)
    {
        if (customer == null || string.IsNullOrEmpty(customer.Ma_kh))
        {
            AddMessage("❌ Thông tin khách hàng không hợp lệ");
            return;
        }

        try
        {
            // Lưu thông tin khách hàng trước khi xóa để có thể khôi phục
            // Load full customer data from database
            string sqlLoad = $"SELECT * FROM dmkh WHERE ma_kh = '{customer.Ma_kh}'";
            var dsLoad = await myDb.LoadDataset(sqlLoad);
            
            if (dsLoad != null && dsLoad.Tables[0].Rows.Count > 0)
            {
                var row = dsLoad.Tables[0].Rows[0];
                _lastDeletedCustomer = new Dmkh
                {
                    Ma_kh = row["Ma_kh"]?.ToString() ?? "",
                    Ten_kh = row["Ten_kh"]?.ToString() ?? "",
                    Ten_kh2 = row["Ten_kh2"]?.ToString() ?? "",
                    Ma_so_thue = row["Ma_so_thue"]?.ToString() ?? "",
                    Dia_chi = row["Dia_chi"]?.ToString() ?? "",
                    Dien_thoai = row["Dien_thoai"]?.ToString() ?? "",
                    Doi_tac = row["Doi_tac"]?.ToString() ?? "",
                    Fax = row["Fax"]?.ToString() ?? "",
                    Status = row["Status"]?.ToString() ?? "1",
                    Date = row["Date"] != DBNull.Value ? Convert.ToDateTime(row["Date"]) : DateTime.Now.Date,
                    Date0 = row["Date0"] != DBNull.Value ? Convert.ToDateTime(row["Date0"]) : DateTime.Now.Date,
                    Time = row["Time"]?.ToString() ?? DateTime.Now.ToString("HH:mm:ss"),
                    Time0 = row["Time0"]?.ToString() ?? DateTime.Now.ToString("HH:mm:ss"),
                    User_id = row["User_id"] != DBNull.Value ? Convert.ToInt32(row["User_id"]) : 0,
                    User_id0 = row["User_id0"] != DBNull.Value ? Convert.ToInt32(row["User_id0"]) : 0,
                    User_name = row["User_name"]?.ToString() ?? "",
                    User_name0 = row["User_name0"]?.ToString() ?? ""
                };
                
                Console.WriteLine($"[DELETE BACKUP] Saved customer data for restore: {_lastDeletedCustomer.Ma_kh} - {_lastDeletedCustomer.Ten_kh}");
            }

            // Call parent component to delete
            await OnCustomerDeleted.InvokeAsync(customer.Ma_kh);

            // Success message with restore hint
            ChatContent successMsg = new ChatContent();
            successMsg.Name = "Hệ thống";
            successMsg.Time = DateTime.Now;
            successMsg.Text = $"✅ **ĐÃ XÓA THÀNH CÔNG**\n\nKhách hàng: **{customer.Ten_kh}**\nMã KH: {customer.Ma_kh}\n\nDữ liệu đã được xóa khỏi hệ thống.\n\n💡 **Lưu ý:** Nếu xóa nhầm, bạn có thể khôi phục bằng lệnh:\n• **'Tạo lại khách hàng vừa xóa'**\n• **'Khôi phục khách hàng'**\n• **'Undo'**";
            successMsg.Role = "assistant";
            LSmessage.Add(successMsg);

            StateHasChanged();
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
        catch (Exception ex)
        {
            AddMessage($"❌ Lỗi khi xóa khách hàng: {ex.Message}");
            Console.WriteLine($"ExecuteDeleteCustomer error: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

