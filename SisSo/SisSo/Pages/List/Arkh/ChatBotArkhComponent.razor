    /// <summary>
    /// Xử lý lệnh KHÔI PHỤC khách hàng vừa xóa
    /// VD: "Tạo lại khách hàng vừa xóa", "Khôi phục khách hàng", "Undo"
    /// </summary>
    private async Task ProcessRestoreCustomer()
    {
        try
        {
            if (_lastDeletedCustomer == null)
            {
                AddMessage("⚠️ **Không có khách hàng nào để khôi phục**\n\nChưa có khách hàng nào bị xóa trong phiên làm việc này.\n\n💡 **Gợi ý:**\n• Chức năng khôi phục chỉ hoạt động ngay sau khi xóa\n• Nếu đã đóng chatbot hoặc reload trang → không thể khôi phục\n• Liên hệ quản trị viên để khôi phục từ backup");
                return;
            }

            // Check if customer with same code already exists
            string checkSql = $"SELECT ma_kh FROM dmkh WHERE ma_kh = '{_lastDeletedCustomer.Ma_kh}'";
            var checkDs = await myDb.LoadDataset(checkSql);
            
            if (checkDs != null && checkDs.Tables[0].Rows.Count > 0)
            {
                AddMessage($"⚠️ **Không thể khôi phục**\n\nKhách hàng với mã **{_lastDeletedCustomer.Ma_kh}** đã tồn tại trong hệ thống.\n\n💡 Có thể khách hàng đã được tạo lại với cùng mã.");
                return;
            }

            // Show confirmation message with customer data
            ChatContent confirmMsg = new ChatContent();
            confirmMsg.Name = "Trợ lý AI";
            confirmMsg.Time = DateTime.Now;
            confirmMsg.Role = "assistant";
            confirmMsg.Text = $"🔄 **XÁC NHẬN KHÔI PHỤC KHÁCH HÀNG**\n\n📋 **Thông tin khách hàng sẽ được khôi phục:**\n\n✅ Sẵn sàng khôi phục khách hàng vừa xóa.\n\nNhấn nút **'Tạo'** bên dưới để xác nhận khôi phục.";
            confirmMsg.CustomerData = _lastDeletedCustomer;
            confirmMsg.MissingFields = ""; // Đã đủ thông tin

            LSmessage.Add(confirmMsg);
            StateHasChanged();
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ProcessRestoreCustomer error: {ex.Message}");
            AddMessage($"❌ Lỗi khi xử lý yêu cầu khôi phục: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

    /// <summary>
    /// Xử lý lệnh TẠO KHÁCH HÀNG bằng ChatGPT
    /// VD: "Tạo kh Mã:00123, tên: Công ty TNHH", "Tạo khách MST 0123456789"
    /// </summary>
    private async Task ProcessCreateCustomer(string input)
    {
        try
        {
            // Tạo prompt cho ChatGPT để parse thông tin khách hàng
            string prompt = $@"
Người dùng muốn tạo khách hàng mới với thông tin sau:

""{input}""

Hãy trích xuất thông tin khách hàng theo định dạng JSON sau:
{{
  ""ma_kh"": ""[Mã khách hàng - bỏ khoảng trắng, chữ hoa]"",
  ""ten_kh"": ""[Tên khách hàng đầy đủ]"",
  ""ma_so_thue"": ""[Mã số thuế nếu có]"",
  ""dia_chi"": ""[Địa chỉ nếu có]"",
  ""dien_thoai"": ""[Số điện thoại nếu có]"",
  ""doi_tac"": ""[Tên người đại diện nếu có]"",
  ""message"": ""[Thông báo ngắn gọn về khách hàng này]""
}}

QUY TẮC:
- Bỏ khoảng trắng trong mã khách hàng
- Chuyển mã khách hàng thành chữ HOA
- VD: 'Mã:00123' → ma_kh = '00123', 'Mã: KH 001' → ma_kh = 'KH001'
- Nếu không có mã → để trống (hệ thống tự sinh)
- Nếu có MST → tự động điền vào ma_kh nếu chưa có
- Trích xuất CHÍNH XÁC tên công ty từ input
- Không bịa đặt thông tin không có trong input";

            string response = await CallChatGPT(prompt);

            if (string.IsNullOrEmpty(response))
            {
                AddMessage("❌ Không thể kết nối AI để xử lý yêu cầu.");
                return;
            }

            string message = "";
            string missingFields = "";
            var customer = ParseCustomerFromResponse(response, out message, out missingFields);

            if (customer != null)
            {
                // Nếu có MST trong input → Gọi API tra cứu để bổ sung thông tin
                if (!string.IsNullOrEmpty(customer.Ma_so_thue))
                {
                    await LoadFromTaxCodeApiAndUpdateCustomer(customer, customer.Ma_so_thue);
                }

                ChatContent resultMsg = new ChatContent();
                resultMsg.Name = "Trợ lý AI";
                resultMsg.Time = DateTime.Now;
                resultMsg.Role = "assistant";
                resultMsg.Text = message;
                resultMsg.CustomerData = customer;
                resultMsg.MissingFields = missingFields;

                LSmessage.Add(resultMsg);
                StateHasChanged();
                await Task.Delay(100);
                await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
            }
            else
            {
                AddMessage($"⚠️ Không thể trích xuất thông tin khách hàng.\n\n💡 **Cách gõ đúng:**\n• 'Tạo kh Mã:00123, tên: Công ty ABC'\n• 'Tạo khách: Mã KH001, Tên Công ty XYZ'\n• 'Tạo kh MST 0123456789'\n• 'Thêm khách: Công ty ABC, MST 0123456789'\n\nResponse: {response}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ProcessCreateCustomer error: {ex.Message}");
            AddMessage($"❌ Lỗi khi xử lý yêu cầu tạo khách hàng: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

    /// <summary>
    /// Xử lý câu hỏi chung bằng ChatGPT (không phải lệnh CRUD)
    /// Hỗ trợ trả lời câu hỏi về hệ thống, hướng dẫn, giải thích...
    /// ChatGPT có thể gọi API tra cứu MST nếu cần
    /// </summary>
    private async Task ProcessGeneralQuestion(string question)
    {
        try
        {
            // ========== BƯỚC 1: Tạo system context ==========
            string systemContext = @"
Bạn là trợ lý AI của hệ thống quản lý khách hàng (ERP) với khả năng tra cứu thông tin công ty.

THÔNG TIN HỆ THỐNG:
- Quản lý danh mục khách hàng (Mã KH, Tên KH, MST, Địa chỉ, Điện thoại, Người đại diện)
- **Có khả năng tra cứu thông tin công ty THỰC từ API** khi người dùng hỏi về MST
- Kiểm tra phát sinh trước khi xóa khách hàng
- Tự động sửa lỗi đánh máy và chuẩn hóa câu lệnh

CHỨC NĂNG ĐẶC BIỆT:
📋 **Tra cứu thông tin công ty:**
- Khi người dùng hỏi về thông tin công ty/MST → BẠN SẼ TRẢ LỜI 'SEARCH_MST:[số MST]'
- VD: 'cho tôi thông tin công ty có MST 0101218690' → Trả lời: 'SEARCH_MST:0101218690'
- VD: 'tìm hiểu về công ty 0123456789' → Trả lời: 'SEARCH_MST:0123456789'
- VD: 'mã số thuế 0101218690 là công ty gì' → Trả lời: 'SEARCH_MST:0101218690'
- Sau đó hệ thống sẽ tự động gọi API và trả thông tin thực

CHỨC NĂNG KHÁC:
1. 🆕 Tạo khách hàng: 'Tạo kh Mã:00123, tên: Công ty ABC'
2. 🔍 Tìm kiếm: 'Tìm khách ABC'
3. ✏️ Sửa thông tin: 'Sửa khách KH001'
4. 🗑️ Xóa khách hàng: 'Xóa khách KH001'

LƯU Ý:
- Trả lời ngắn gọn, dễ hiểu
- Sử dụng emoji phù hợp
- Format markdown: **in đậm**, *in nghiêng*
- Nếu người dùng hỏi về thông tin công ty/MST → PHẢI trả lời 'SEARCH_MST:[số]'
";

            // ========== BƯỚC 2: Gọi ChatGPT để phân tích câu hỏi ==========
            string analysisPrompt = $"{systemContext}\n\nCÂU HỎI CỦA NGƯỜI DÙNG:\n{question}\n\nNẾU câu hỏi về thông tin công ty/MST → Trả lời: 'SEARCH_MST:[số MST]'\nNẾU KHÔNG → Trả lời câu hỏi bình thường.";

            string response = await CallChatGPTWithContext(analysisPrompt);

            if (string.IsNullOrEmpty(response))
            {
                AddMessage("⚠️ Không thể kết nối đến AI. Vui lòng thử lại sau.");
                return;
            }

            // ========== BƯỚC 3: Kiểm tra nếu ChatGPT yêu cầu search MST ==========
            if (response.Contains("SEARCH_MST:"))
            {
                // Extract MST từ response
                var match = System.Text.RegularExpressions.Regex.Match(response, @"SEARCH_MST:([0-9\-]+)");
                if (match.Success)
                {
                    string mstNumber = match.Groups[1].Value.Trim();
                    Console.WriteLine($"[ChatGPT] Requested MST lookup: {mstNumber}");

                    // ========== BƯỚC 4: Gọi SIS API tra cứu MST ==========
                    try
                    {
                        ClassMasothue apiResult = await GetDatafromSISAPIAsync(mstNumber);

                        if (apiResult != null && !string.IsNullOrEmpty(apiResult.TenChinhThuc))
                        {
                            // ========== BƯỚC 5: Format kết quả từ SIS API ==========
                            string companyInfo = $"🏢 **Thông tin công ty MST {mstNumber}:**\n\n";
                            
                            if (!string.IsNullOrEmpty(apiResult.TenChinhThuc))
                                companyInfo += $"📌 **Tên công ty:** {apiResult.TenChinhThuc}\n";
                            
                            if (!string.IsNullOrEmpty(apiResult.ChuDoanhNghiep))
                                companyInfo += $"👤 **Chủ doanh nghiệp:** {apiResult.ChuDoanhNghiep}\n";
                            
                            if (!string.IsNullOrEmpty(apiResult.DiaChiGiaoDichChinh))
                                companyInfo += $"📍 **Địa chỉ:** {apiResult.DiaChiGiaoDichChinh}\n";
                            else if (!string.IsNullOrEmpty(apiResult.DiaChiGiaoDichPhu))
                                companyInfo += $"📍 **Địa chỉ:** {apiResult.DiaChiGiaoDichPhu}\n";
                            
                            if (!string.IsNullOrEmpty(apiResult.SoDienThoai))
                                companyInfo += $"☎️ **Điện thoại:** {apiResult.SoDienThoai}\n";
                            
                            if (!string.IsNullOrEmpty(apiResult.TrangThaiHoatDong))
                                companyInfo += $"📊 **Trạng thái:** {apiResult.TrangThaiHoatDong}\n";

                            // ========== BƯỚC 6: Gọi ChatGPT để phân tích & trả lời ==========
                            string contextWithData = $@"
Người dùng hỏi: ""{question}""

Thông tin công ty từ API:
{companyInfo}

Hãy phân tích và trả lời câu hỏi của người dùng dựa trên thông tin trên.
- Trả lời TỰ NHIÊN, không copy nguyên văn
- Làm nổi bật thông tin quan trọng
- Sử dụng emoji phù hợp
- Format markdown đẹp
- Nếu thiếu thông tin nào → nói rõ
";

                            string finalResponse = await CallChatGPTWithContext(contextWithData);
                            
                            ChatContent aiMsg = new ChatContent
                            {
                                Name = "Trợ lý AI",
                                Time = DateTime.Now,
                                Role = "assistant",
                                Text = finalResponse
                            };

                            LSmessage.Add(aiMsg);
                        }
                        else
                        {
                            AddMessage($"⚠️ Không tìm thấy thông tin cho MST: **{mstNumber}**\n\n💡 Có thể MST không tồn tại hoặc API không có dữ liệu.");
                        }
                    }
                    catch (Exception apiEx)
                    {
                        Console.WriteLine($"[ChatGPT MST Lookup] API Error: {apiEx.Message}");
                        AddMessage($"❌ Lỗi khi tra cứu MST: {apiEx.Message}");
                    }
                }
            }
            else
            {
                // ========== Câu hỏi thông thường - không cần API ==========
                ChatContent aiMsg = new ChatContent
                {
                    Name = "Trợ lý AI",
                    Time = DateTime.Now,
                    Role = "assistant",
                    Text = response
                };

                LSmessage.Add(aiMsg);
            }

            StateHasChanged();
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ProcessGeneralQuestion error: {ex.Message}");
            AddMessage($"❌ Lỗi khi xử lý câu hỏi: {ex.Message}");
            await Task.Delay(100);
            await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
        }
    }

    /// <summary>
    /// Gọi ChatGPT với context cụ thể (không lưu vào chat history chính)
    /// </summary>
    private async Task<string> CallChatGPTWithContext(string prompt)
    {
        try
        {
            using var client = new HttpClient();
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);

            var requestBody = new
            {
                model = ChatBotConfig.ModelName,
                messages = new[]
                {
                    new { role = "system", content = "Bạn là trợ lý AI thông minh, thân thiện và hữu ích. Trả lời ngắn gọn, rõ ràng." },
                    new { role = "user", content = prompt }
                },
                max_tokens = ChatBotConfig.MaxTokens,
                temperature = ChatBotConfig.Temperature
            };

            var json = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync("https://api.openai.com/v1/chat/completions", content);
            var resultJson = await response.Content.ReadAsStringAsync();

            using var doc = JsonDocument.Parse(resultJson);
            var reply = doc.RootElement
                   .GetProperty("choices")[0]
                   .GetProperty("message")
                   .GetProperty("content")
                   .GetString();

            return reply;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CallChatGPTWithContext error: {ex.Message}");
            return "";
        }
    }

    /// <summary>
    /// Sử dụng ChatGPT để chuẩn hóa câu lệnh nhập vào
    /// Tự động sửa lỗi chính tả, viết tắt và các lỗi đánh máy thường gặp
    /// </summary>
    private async Task<string> NormalizeInputWithChatGPT(string input)
    {
        if (string.IsNullOrEmpty(input))
            return input;

        try
        {
            // Tạo prompt cho ChatGPT để chuẩn hóa câu lệnh
            string normalizationPrompt = $@"
Bạn là trợ lý chuẩn hóa văn bản tiếng Việt. Nhiệm vụ: Sửa lỗi chính tả và chuẩn hóa câu sau đây.

QUY TẮC CHUẨN HÓA:
1. Sửa lỗi đánh máy phổ biến:
   - 'ách' → 'khách'
   - 'kh' + số → 'khách' + số
   - 'tim' → 'tìm'
   - 'sua' → 'sửa'
   - 'xoa' → 'xóa'
   - 'dia chi' → 'địa chỉ'
   - 'dien thoai' → 'điện thoại'
   - 'cong ty' → 'công ty'

2. Chuẩn hóa viết tắt:
   - 'kh' hoặc 'KH' (khi đứng một mình) → 'khách'
   - 'mst' hoặc 'MST' → giữ nguyên 'MST'
   - 'sdt' → 'điện thoại'

3. GIỮ NGUYÊN:
   - Mã số (VD: KH001, 009, 0123456789)
   - Tên riêng, tên công ty
   - Số điện thoại
   - Ký tự đặc biệt trong mã

4. Trả về ĐÚNG câu đã sửa, KHÔNG thêm giải thích, KHÔNG thêm dấu ngoặc kép.

CÂU CẦN CHUẨN HÓA:
{input}

CHỈ TRẢ VỀ CÂU ĐÃ SỬA:";

            using var client = new HttpClient();
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);

            var requestBody = new
            {
                model = "gpt-3.5-turbo",  // Dùng model nhẹ để xử lý nhanh
                messages = new[]
                {
                    new { role = "system", content = "Bạn là trợ lý chuẩn hóa văn bản. Chỉ trả về câu đã sửa, không giải thích." },
                    new { role = "user", content = normalizationPrompt }
                },
                max_tokens = 150,
                temperature = 0.1  // Nhiệt độ thấp để có kết quả ổn định
            };

            var json = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync("https://api.openai.com/v1/chat/completions", content);
            var resultJson = await response.Content.ReadAsStringAsync();

            using var doc = JsonDocument.Parse(resultJson);
            var normalizedText = doc.RootElement
                   .GetProperty("choices")[0]
                   .GetProperty("message")
                   .GetProperty("content")
                   .GetString()
                   ?.Trim() ?? input;

            // Log để debug
            if (input != normalizedText)
            {
                Console.WriteLine($"[INPUT NORMALIZATION]");
                Console.WriteLine($"Original: {input}");
                Console.WriteLine($"Normalized: {normalizedText}");
            }

            return normalizedText;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"NormalizeInputWithChatGPT error: {ex.Message}");
            // Nếu có lỗi, trả về input gốc
            return input;
        }
    }

