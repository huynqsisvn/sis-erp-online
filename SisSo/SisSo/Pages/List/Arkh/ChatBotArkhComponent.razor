    private async void UpdateCustomerInfo(string input)
    {
        if (_editingCustomer == null) return;

        string inputLower = input.ToLower();
        bool hasUpdate = false;
        List<string> updates = new List<string>();

        // Parse và update các trường - Priority order matters!

        // 1. MST (highest priority - always numeric)
        if (inputLower.Contains("mst") || inputLower.Contains("mã số thuế"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(input, @"(?:mst|mã\s*số\s*thuế)\s*:?\s*([0-9\-]+)", RegexOptions.IgnoreCase);
            if (match.Success)
            {
                _editingCustomer.Ma_so_thue = match.Groups[1].Value.Trim();

                // Mặc định Mã KH = MST nếu chưa có
                if (string.IsNullOrEmpty(_editingCustomer.Ma_kh))
                {
                    _editingCustomer.Ma_kh = _editingCustomer.Ma_so_thue;
                    updates.Add($"Mã KH → {_editingCustomer.Ma_kh} (tự động từ MST)");
                }

                updates.Add($"MST → {_editingCustomer.Ma_so_thue}");
                hasUpdate = true;

                // Tự động tra cứu thông tin từ API khi có MST
                await LoadFromTaxCodeApi(_editingCustomer.Ma_so_thue);
            }
        }

        // 2. Điện thoại (extract before processing text fields)
        if (inputLower.Contains("điện thoại") || inputLower.Contains("dien thoai") || inputLower.Contains("sdt") || inputLower.Contains("phone"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(input, @"(?:điện\s*thoại|dien\s*thoai|sdt|phone)\s*:?\s*([0-9\+\-\s]+)", RegexOptions.IgnoreCase);
            if (match.Success)
            {
                _editingCustomer.Dien_thoai = match.Groups[1].Value.Trim();
                updates.Add($"Điện thoại → {_editingCustomer.Dien_thoai}");
                hasUpdate = true;
            }
        }

        // 3. Mã KH
        if (inputLower.Contains("mã") && (inputLower.Contains("kh") || inputLower.Contains("khách")))
        {
            var match = System.Text.RegularExpressions.Regex.Match(input, @"(?:mã\s*(?:kh|khách)\s*:?\s*)([A-Za-z0-9_\-]+)", RegexOptions.IgnoreCase);
            if (match.Success)
            {
                _editingCustomer.Ma_kh = match.Groups[1].Value.Trim();
                updates.Add($"Mã KH → {_editingCustomer.Ma_kh}");
                hasUpdate = true;
            }
        }

        // 4. Tên KH - Extract carefully
        if (inputLower.Contains("tên"))
        {
            // Find "tên" keyword position
            int tenPos = inputLower.IndexOf("tên");
            // Find next field keyword after "tên"
            var keywords = new[] { "địa", "dia", "mst", "sdt", "điện", "phone", "đại", "dai" };
            int nextKeyPos = input.Length;

            foreach (var kw in keywords)
            {
                int pos = inputLower.IndexOf(kw, tenPos + 3);
                if (pos > tenPos && pos < nextKeyPos)
                {
                    nextKeyPos = pos;
                }
            }

            // Extract text between "tên:" and next keyword
            var match = System.Text.RegularExpressions.Regex.Match(
                input.Substring(tenPos),
                @"^tên\s*(?:kh|khách|công\s*ty)?\s*:?\s*(.+)",
                RegexOptions.IgnoreCase
            );

            if (match.Success)
            {
                string fullText = match.Groups[1].Value;
                int endPos = fullText.Length;

                // Find where next field starts
                foreach (var kw in keywords)
                {
                    int kwPos = fullText.ToLower().IndexOf(kw);
                    if (kwPos > 0 && kwPos < endPos)
                    {
                        endPos = kwPos;
                    }
                }

                string tenValue = fullText.Substring(0, endPos).Trim().TrimEnd(',', ';', '.', '|');
                if (!string.IsNullOrEmpty(tenValue))
                {
                    _editingCustomer.Ten_kh = tenValue;
                    updates.Add($"Tên KH → {_editingCustomer.Ten_kh}");
                    hasUpdate = true;
                }
            }
        }
        else if (!inputLower.Contains("mst") && !inputLower.Contains("địa") && !inputLower.Contains("điện")
                 && !inputLower.Contains("đại") && !inputLower.Contains("sdt") && !inputLower.Contains("phone")
                 && !inputLower.Contains("mã") && input.Length > 3 && !input.All(char.IsDigit))
        {
            // Plain text without any keyword - treat as name
            _editingCustomer.Ten_kh = input.Trim();
            updates.Add($"Tên KH → {_editingCustomer.Ten_kh}");
            hasUpdate = true;
        }

        // 5. Địa chỉ - Extract carefully
        if (inputLower.Contains("địa chỉ") || inputLower.Contains("dia chi"))
        {
            int diaPos = inputLower.IndexOf("địa");
            if (diaPos < 0) diaPos = inputLower.IndexOf("dia");

            if (diaPos >= 0)
            {
                // Keywords that end address
                var endKeywords = new[] { "điện", "phone", "sdt", "mst", "đại", "dai" };
                int nextKeyPos = input.Length;

                foreach (var kw in endKeywords)
                {
                    int pos = inputLower.IndexOf(kw, diaPos + 6);
                    if (pos > diaPos && pos < nextKeyPos)
                    {
                        nextKeyPos = pos;
                    }
                }

                // Extract from "địa chỉ:" to next keyword
                var match = System.Text.RegularExpressions.Regex.Match(
                    input.Substring(diaPos),
                    @"^(?:địa\s*chỉ|dia\s*chi)\s*:?\s*(.+)",
                    RegexOptions.IgnoreCase
                );

                if (match.Success)
                {
                    string fullText = match.Groups[1].Value;
                    int endPos = fullText.Length;

                    // Find where next field starts
                    foreach (var kw in endKeywords)
                    {
                        int kwPos = fullText.ToLower().IndexOf(kw);
                        if (kwPos > 0 && kwPos < endPos)
                        {
                            endPos = kwPos;
                        }
                    }

                    string diaValue = fullText.Substring(0, endPos).Trim().TrimEnd(',', ';', '|');
                    if (!string.IsNullOrEmpty(diaValue))
                    {
                        _editingCustomer.Dia_chi = diaValue;
                        updates.Add($"Địa chỉ → {_editingCustomer.Dia_chi}");
                        hasUpdate = true;
                    }
                }
            }
        }

        // 6. Đại diện
        if (inputLower.Contains("đại diện") || inputLower.Contains("dai dien") || inputLower.Contains("đại tác") || inputLower.Contains("doi tac"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(input, @"(?:đại\s*diện|dai\s*dien|đại\s*tác|doi\s*tac)\s*:?\s*([^,;|]+?)(?:\s*(?:,|;|\||điện|phone|sdt|mst)|$)", RegexOptions.IgnoreCase);
            if (match.Success)
            {
                _editingCustomer.Doi_tac = match.Groups[1].Value.Trim();
                updates.Add($"Đại diện → {_editingCustomer.Doi_tac}");
                hasUpdate = true;
            }
        }

        // Tạo response message
        ChatContent responseMsg = new ChatContent();
        responseMsg.Name = "Trợ lý AI";
        responseMsg.Time = DateTime.Now;
        responseMsg.Role = "assistant";

        if (hasUpdate)
        {
            responseMsg.Text = $"✅ Đã cập nhật:\n{string.Join("\n", updates)}\n\nBạn có thể tiếp tục chỉnh sửa hoặc xác nhận tạo.";
            responseMsg.CustomerData = _editingCustomer;

            // Check missing fields
            List<string> missing = new List<string>();
            if (string.IsNullOrEmpty(_editingCustomer.Ma_kh))
                missing.Add("Mã khách hàng");
            if (string.IsNullOrEmpty(_editingCustomer.Ten_kh))
                missing.Add("Tên khách hàng");

            if (missing.Count > 0)
                responseMsg.MissingFields = "⚠ Thiếu: " + string.Join(", ", missing);
        }
        else
        {
            responseMsg.Text = "⚠ Không nhận diện được thông tin cần cập nhật.\n\nVD hợp lệ:\n• MST 0123456789\n• Địa chỉ: 123 ABC, HN\n• Điện thoại: 0987654321\n• Tên: Công ty XYZ";
            responseMsg.CustomerData = _editingCustomer;
        }

        LSmessage.Add(responseMsg);
        StateHasChanged();
        await Task.Delay(100);
        await JavacriptS.InvokeVoidAsync("MoveIntoView", "chat-bottom");
    }

    private string FormatMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text))
            return text;

        text = text.Replace("\n", "<br/>");
        text = Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        text = Regex.Replace(text, @"\*(.+?)\*", "<em>$1</em>");

        return text;
    }

    /// <summary>
    /// Tra cứu thông tin doanh nghiệp từ SIS API dựa vào MST và cập nhật vào customer đang edit
    /// URL: http://help.sis.vn:7785/AP/getmasothue/{mst}
    /// </summary>
    private async Task LoadFromTaxCodeApi(string taxCode)
    {
        if (string.IsNullOrEmpty(taxCode) || _editingCustomer == null)
            return;

        try
        {
            // Gọi SIS API
            Console.WriteLine($"[SIS API EDIT] Calling API for MST {taxCode}");
            var sisApiResult = await GetDatafromSISAPIAsync(taxCode);

            if (sisApiResult != null && !string.IsNullOrEmpty(sisApiResult.TenChinhThuc))
            {
                Console.WriteLine($"[SIS API EDIT] SUCCESS: {sisApiResult.TenChinhThuc}");
                
                // Mặc định Mã KH = MST nếu chưa có
                if (string.IsNullOrEmpty(_editingCustomer.Ma_kh))
                    _editingCustomer.Ma_kh = taxCode.Trim();

                // Cập nhật thông tin từ SIS API
                if (!string.IsNullOrEmpty(sisApiResult.TenChinhThuc) && string.IsNullOrEmpty(_editingCustomer.Ten_kh))
                    _editingCustomer.Ten_kh = sisApiResult.TenChinhThuc;

                if (!string.IsNullOrEmpty(sisApiResult.ChuDoanhNghiep) && string.IsNullOrEmpty(_editingCustomer.Doi_tac))
                    _editingCustomer.Doi_tac = sisApiResult.ChuDoanhNghiep;

                // Priority: DiaChiGiaoDichChinh → DiaChiGiaoDichPhu
                if (string.IsNullOrEmpty(_editingCustomer.Dia_chi))
                {
                    if (!string.IsNullOrEmpty(sisApiResult.DiaChiGiaoDichChinh))
                        _editingCustomer.Dia_chi = sisApiResult.DiaChiGiaoDichChinh;
                    else if (!string.IsNullOrEmpty(sisApiResult.DiaChiGiaoDichPhu))
                        _editingCustomer.Dia_chi = sisApiResult.DiaChiGiaoDichPhu;
                }

                if (!string.IsNullOrEmpty(sisApiResult.SoDienThoai) && string.IsNullOrEmpty(_editingCustomer.Dien_thoai))
                    _editingCustomer.Dien_thoai = sisApiResult.SoDienThoai;

                // Thông báo thành công
                AddMessage($"✅ Đã tra cứu thành công MST {taxCode}:\n• Mã KH: {_editingCustomer.Ma_kh}\n• Tên: {sisApiResult.TenChinhThuc}\n• Địa chỉ: {sisApiResult.DiaChiGiaoDichChinh ?? sisApiResult.DiaChiGiaoDichPhu}\n• Điện thoại: {sisApiResult.SoDienThoai}\n• Chủ doanh nghiệp: {sisApiResult.ChuDoanhNghiep}");
            }
            else
            {
                Console.WriteLine($"[SIS API EDIT] No data returned for MST {taxCode}");
                AddMessage($"⚠ Không tìm thấy thông tin cho MST: {taxCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SIS API EDIT] EXCEPTION: {ex.Message}");
            AddMessage($"❌ Lỗi khi tra cứu MST: {ex.Message}");
        }
    }

    /// <summary>
    /// Tra cứu thông tin doanh nghiệp từ SIS API dựa vào MST và cập nhật customer object
    /// URL: http://help.sis.vn:7785/AP/getmasothue/{mst}
    /// </summary>
    private async Task LoadFromTaxCodeApiAndUpdateCustomer(Dmkh customer, string taxCode)
    {
        if (string.IsNullOrEmpty(taxCode) || customer == null)
            return;

        try
        {
            // Gọi SIS API để lấy thông tin
            Console.WriteLine($"[SIS API LOOKUP] Calling API for MST {taxCode}");
            var sisApiResult = await GetDatafromSISAPIAsync(taxCode);

            if (sisApiResult != null && !string.IsNullOrEmpty(sisApiResult.TenChinhThuc))
            {
                Console.WriteLine($"[SIS API LOOKUP] SUCCESS for MST {taxCode}: {sisApiResult.TenChinhThuc}");
                
                // Mặc định Mã KH = MST nếu chưa có
                if (string.IsNullOrEmpty(customer.Ma_kh))
                    customer.Ma_kh = taxCode.Trim();

                // Cập nhật thông tin từ SIS API (chỉ cập nhật nếu trống)
                if (!string.IsNullOrEmpty(sisApiResult.TenChinhThuc) && string.IsNullOrEmpty(customer.Ten_kh))
                    customer.Ten_kh = sisApiResult.TenChinhThuc;

                if (!string.IsNullOrEmpty(sisApiResult.ChuDoanhNghiep) && string.IsNullOrEmpty(customer.Doi_tac))
                    customer.Doi_tac = sisApiResult.ChuDoanhNghiep;

                // Priority: DiaChiGiaoDichChinh → DiaChiGiaoDichPhu
                if (string.IsNullOrEmpty(customer.Dia_chi))
                {
                    if (!string.IsNullOrEmpty(sisApiResult.DiaChiGiaoDichChinh))
                        customer.Dia_chi = sisApiResult.DiaChiGiaoDichChinh;
                    else if (!string.IsNullOrEmpty(sisApiResult.DiaChiGiaoDichPhu))
                        customer.Dia_chi = sisApiResult.DiaChiGiaoDichPhu;
                }

                if (!string.IsNullOrEmpty(sisApiResult.SoDienThoai) && string.IsNullOrEmpty(customer.Dien_thoai))
                    customer.Dien_thoai = sisApiResult.SoDienThoai;

                Console.WriteLine($"[SIS API LOOKUP] Data loaded successfully");
            }
            else
            {
                Console.WriteLine($"[SIS API LOOKUP] No data returned for MST {taxCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SIS API LOOKUP] EXCEPTION: {ex.Message}");
        }
    }

    /// <summary>
    /// Gọi API để lấy thông tin doanh nghiệp từ MST (thongtindoanhnghiep.co)
    /// </summary>
    private async Task<Customerinfo> GetDataFromApi(string url)
    {
        Customerinfo custom = null;
        try
        {
            WebRequest request = WebRequest.Create(url);
            WebResponse response = await request.GetResponseAsync();
            string status = ((HttpWebResponse)response).StatusDescription;

            using (Stream dataStream = response.GetResponseStream())
            {
                StreamReader reader = new StreamReader(dataStream);
                string responseFromServer = await reader.ReadToEndAsync();
                custom = JsonConvert.DeserializeObject<Customerinfo>(responseFromServer);
            }
            response.Close();
            return custom;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"GetDataFromApi error: {ex.Message}");
            return custom;
        }
    }

