@page "/arcd1"
@page "/arcd1/{Menu_id}"
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,arcd1")]

@if (!IsDetail)
{
    <div class="row" @onkeydown="OnKeyDown" @onkeydown:preventDefault="true">
        <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" Fbrowse="@Fbrowse" SelectItem="@SelectedItem" RowStyleFunc="@GetRowStyle" CustomSummaryTextFormatter="@FormatSummaryText" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}
else
{
    <div class="row mt-1" @onkeydown="OnKeyDownCT" @onkeydown:preventDefault="true">
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblDataCT" SelectItem="@SelectItemCT" Fbrowse="@FbrowseCT" RowStyleFunc="@GetRowStyle" CustomSummaryTextFormatter="@FormatSummaryText" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}
<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup" onkeydown="ModifyEnterKeyPressAsTab(event);"
@bind-Visible="@PopupVisible"
Width="500px"
Height="Auto"
ShowFooter="true" Context="windowContext"
HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-3">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Account"]">
                        <Template>
                            <div class="col p-0">
                                <AutocompleteComponent TblData="@TblDmtkFilteredAsync"
                                                       Ma_dm="dmtk"
                                                       @bind-Value="@Tk"
                                                       IsEnable="@AllowEditMode"
                                                       IsLangEn="@IsLangEn"
                                                       CssClass="@(string.IsNullOrWhiteSpace(Tk) ? "input-invalid" : "")">
                                </AutocompleteComponent>

                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Customer code"]">
                        <Template>
                            <div class="col p-0">
                                <AutocompleteComponent TblData="@TblDmkh" Ma_dm="dmkh" @bind-Value="@Ma_kh" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_Ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report template"]">
                        <DxComboBox Data="@StatusList2"
                                    @bind-Value="@Ma_nt"
                                    ValueField="Value"
                                    TextField="Text"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="VND" />
                    </DxFormLayoutItem>
                </DxFormLayout>

                @if (Errors.Any())
                {
                    <div class="mt-2 alert alert-danger p-2">
                        <ul class="mb-0">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>

    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end align-content-end">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

<style>
    .popup-button-footer {
    width: 100px;
    margin-right: 20px;
    margin-top: 5px;
    margin-bottom: 5px;
    }

    .input-invalid {
        border: 1px solid red !important;
        border-radius: 4px;
    }

    .tb-icon-btntoolbar1 {
    width: 24px;
    height: 24px;
    background-image: url('.\\Images\\detail.png');
    }

    .tb-icon-btntoolbar2 {
    width: 24px;
    height: 24px;
    background-image: url('.\\Images\\detail.png');
    }

    .dxbl-grid-footer td {
        white-space: pre-line;
        line-height: 1.4em;
    }
</style>

