    private async Task<DataTable> LoadTblDmtkFilteredAsync()
    {
        // Câu SQL chỉ lấy các dòng có tk_cn = 1
        string sqlTk = "SELECT * FROM dmtk WHERE tk_cn = 1";

        // Thực thi SQL, trả về DataSet
        var dsTk = await myDb.LoadDataset(sqlTk);

        // Nếu có dữ liệu, trả về DataTable đầu tiên, nếu không thì trả về DataTable rỗng
        if (dsTk != null && dsTk.Tables.Count > 0 && dsTk.Tables[0].Rows.Count > 0)
        {
            return dsTk.Tables[0].Copy();
        }
        else
        {
            return new DataTable(); // rỗng
        }
    }
    public void SelectItemCT(object obj)
    {
