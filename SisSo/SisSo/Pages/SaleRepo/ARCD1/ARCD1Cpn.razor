    public override void Print()
    {
        LsData = new List<ARCD1Model>();
        ARCD1Model Data = new ARCD1Model();
        Data.Startdate = (DateTime)Ngay_ct1;
        Data.Enddate = (DateTime)Ngay_ct2;

        Data.LsData = myDb.ConvertDataTable<ARCD1>(TblData);
        Data.LsDataCT2 = myDb.ConvertDataTable<dttk>(TblDataCT2);
        Data.LsDataCT1 = myDb.ConvertDataTable<dtInfo>(TblDataCT1);
        LsData.Add(Data);

        ShowReport(LsData, typeof(ARCD1Model));
    }
   
