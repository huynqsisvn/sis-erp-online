    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(Ngay_ct1);
        myStateMN.SetEndDate(Ngay_ct2);
        myStateMN.SetItem("M_TK",Tk.Trim());
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;
        if (Ngay_ct1 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Ngay_ct2 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Ngay_ct1 > Ngay_ct2)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        StateHasChanged();
        return ok;
    }

    public override async Task Loaddata()
    {
        if (Ngay_ct1 == null || Ngay_ct2 == null || Ngay_ct1 > Ngay_ct2)
        {
            myStateMN.SetNewThongbao(Lap["Incorrect date declaration"] + " !");
            return;
        }
        if (string.IsNullOrWhiteSpace(Tk))
        {
            myStateMN.SetNewThongbao(Lap["Chưa nhập tài khoản"] + " !");
            PopupVisible = true;  
            return;                  
        }
        if (curCommand != null)
        {
            sFieldArrays = !(IsLangEn == false)
                ? (Ma_nt != "VND" ? curCommand.Ebrowse2.ToString().Split("|".ToCharArray()) : curCommand.Ebrowse1.Split("|".ToCharArray()))
                : (Ma_nt != "VND" ? curCommand.Vbrowse2.ToString().Split("|".ToCharArray()) : curCommand.Vbrowse1.Split("|".ToCharArray()));

            Fbrowse = sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
        }

        ShowLoadding = true;

        string tkParam = string.IsNullOrWhiteSpace(Tk) ? "" : Tk.Trim() + "%";

        string maKh = string.IsNullOrWhiteSpace(Ma_kh) ? "%" : Ma_kh.Trim();

        string maDvcs = myStateMN.GetDvcs().Ma_dvcs.Trim();
        maDvcs = (maDvcs == "ALL" ? "%" : maDvcs + "%");

        string advance = "1=1";

        if (!string.IsNullOrWhiteSpace(maKh.Trim()))
            advance += $" AND ma_kh like '{maKh}'";

        if (!string.IsNullOrWhiteSpace(maDvcs))
            advance += $" AND ma_dvcs like '{maDvcs}'";
        string param_name = "@Tk;@Ngay_ct1;@Ngay_ct2;@Advance";
        string param_value =
            $"{tkParam};" +
            $"{Ngay_ct1:yyyyMMdd};" +
            $"{Ngay_ct2:yyyyMMdd};" +
            $"{advance}";

        DataSet ds = await myDb.LoadStoreProcedure("ARCD1", param_name, param_value);

        if (ds?.Tables?.Count > 0)
        {
            TblData = ds.Tables[0].Copy();
            TblDataCT1 = ds.Tables[4].Copy();
            TblDataCT2 = ds.Tables[2].Copy();
        }
        else
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
        }

        ShowLoadding = false;
        StateHasChanged();
    }


    async void OnDvcsChanged(string ma_dvcs)
