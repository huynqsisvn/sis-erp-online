    // Tương đương UpdateMoney_NT() trong WinForm - tính các tổng nguyên tệ
    private void UpdateMoney_NT()
    {
        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
        decimal tinh_ck = CurPh.Tinh_ck;
        decimal sua_thue = CurPh.Sua_thue;

        // Tổng tiền hàng nguyên tệ (chỉ lấy dòng không phải khuyến mại)
        decimal t_tien_nt2 = CurPh.T_tien_nt2;

        // Tổng chiết khấu dòng + khuyến mại hóa đơn + tiền_km (pt_km)
        decimal t_ck_nt = 0;
        if (CurrentEditModel != null)
        {
            t_ck_nt = LSCt.Where(x => x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck_nt) + CurrentEditModel.Ck_nt;
            // decimal kmhd_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_tb) + CurrentEditModel.Tien_tb;     // tiền_tb là KM hóa đơn
        }
        else
        {
            t_ck_nt = LSCt.Sum(x => x.Ck_nt);
        }


        // CurPh.T_ck_nt = t_ck_nt + kmhd_nt + tien_km_nt;
        CurPh.T_ck_nt = t_ck_nt;

        // Tiền sau chiết khấu nguyên tệ
        decimal t_tien_sau_ck_nt = t_tien_nt2 - CurPh.T_ck_nt;
        CurPh.T_tien_sau_ck_nt = t_tien_sau_ck_nt;

        // Tính thuế GTGT nguyên tệ
        if (sua_thue == 0m)
        {
            decimal co_so_thue_nt = tinh_ck != 1 ? t_tien_sau_ck_nt : t_tien_nt2;
            decimal t_thue_nt = LSCt.Where(x => x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Thue) + CurrentEditModel.Thue;
            CurPh.T_thue_nt = t_thue_nt;

            // Nếu là VND thì đồng bộ luôn sang trường VND
            if (CurPh.Ma_nt.Trim() == M_ma_nt0.Trim())
                CurPh.T_thue = t_thue_nt;
        }

        // Tổng thanh toán nguyên tệ
        CurPh.T_tt_nt = CurPh.T_tien_sau_ck_nt + CurPh.T_thue_nt;
    }

    // Tương đương UpdateMoney() trong WinForm - tính các tổng quy đổi VND
    private void UpdateMoney()
    {
        decimal tinh_ck = CurPh.Tinh_ck;
        decimal sua_thue = CurPh.Sua_thue;

        // Tổng tiền hàng VND
        decimal t_tien2 = CurPh.T_tien2;
        decimal t_ck = 0;
        if (CurrentEditModel != null)
        {

            // Tổng chiết khấu + KM hóa đơn + tiền_km quy đổi
            t_ck = LSCt.Where(x => x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck) + CurrentEditModel.Ck;
        }
        else
        {
            t_ck = LSCt.Sum(x => x.Ck);
        }

        // CurPh.T_ck = t_ck + kmhd + tien_km;
        CurPh.T_ck = t_ck;

        // Tiền sau chiết khấu VND
        decimal t_tien_sau_ck = t_tien2 - CurPh.T_ck;
        CurPh.T_tien_sau_ck = t_tien_sau_ck;

        // Tính thuế GTGT VND
        if (sua_thue == 0)
        {
            decimal co_so_thue = tinh_ck != 1 ? t_tien_sau_ck : t_tien2;
            decimal t_thue = LSCt.Where(x => x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Thue) + CurrentEditModel.Thue;
            CurPh.T_thue = t_thue;
        }

        // Tổng thanh toán VND
        CurPh.T_tt = CurPh.T_tien_sau_ck + CurPh.T_thue;
    }

    private async Task CalculateTyGia()
    {

        // 1. Nếu là VND → tỷ giá = 1
        if (CurPh?.Ma_nt?.Trim() == M_ma_nt0?.Trim())
        {
            CurPh.Ty_gia = 1m;
        }

        // 2. Nếu tỷ giá rỗng hoặc = 0 → không làm gì
        if (CurPh.Ty_gia <= 0m) return;

        decimal ty_gia = CurPh.Ty_gia;

        // === 3. Quy đổi tất cả chi tiết hàng (DsCt) ===
        if (LSCt.Any(x => x.Stt_rec == CurPh.Stt_rec))
        {
            foreach (var row in LSCt.Where(x => x.Stt_rec == CurPh.Stt_rec))
            {
                decimal sl = row.So_luong;
                decimal Gia_nt2 = row.Gia_nt2;

                // Chỉ tính lại nếu có số lượng và đơn giá nguyên tệ
                if (sl > 0m && Gia_nt2 > 0m)
                {
                    row.Tien_nt2 = Math.Round(sl * Gia_nt2, M_ROUND_NT);
                    row.Gia2 = Math.Round(Gia_nt2 * ty_gia, M_ROUND_GIA);
                    row.Tien2 = Math.Round(row.Tien_nt2 * ty_gia, M_ROUND);
                }
            }
        }


        UpdateTotalHT();
        StateHasChanged();
    }

    private void UpdateTotalHT()
    {
        var details = LSCt;
        decimal sum_Tien2 = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien2) + (CurrentEditModel?.Tien2 ?? 0);
        decimal sum_Tien_nt2 = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt2) + (CurrentEditModel?.Tien_nt2 ?? 0);
        decimal sum_ck = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck) + (CurrentEditModel?.Ck ?? 0); ;
        decimal sum_ck_nt = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck_nt) + (CurrentEditModel?.Ck_nt ?? 0); ;
        decimal sum_so_luong = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.So_luong) + (CurrentEditModel?.So_luong ?? 0); ;
        decimal sum_thue_nt = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Thue_nt) + (CurrentEditModel?.Thue_nt ?? 0); ;
        decimal sum_thue = details.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Thue) + (CurrentEditModel?.Thue ?? 0); ;
        // Làm tròn theo quy tắc hệ thống
        decimal t_Tien2 = Math.Round(sum_Tien2, M_ROUND);
        decimal t_Tien_nt2 = Math.Round(sum_Tien_nt2, M_ROUND_NT);
        decimal t_ck = Math.Round(sum_ck, M_ROUND);
        decimal t_ck_nt = Math.Round(sum_ck_nt, M_ROUND_NT);


        decimal t_thue = Math.Round(sum_thue, M_ROUND);
        decimal t_thue_nt = Math.Round(sum_thue_nt, M_ROUND_NT);

        if (!NotMaNt0Voucher)
        {
            t_Tien2 = t_Tien_nt2;
            t_ck = t_ck_nt;
            t_thue = t_thue_nt;
        }

        // === TÍNH TIỀN SAU CHIẾT KHẤU ===
        decimal t_tien_sau_ck = t_Tien2 - t_ck;
        decimal t_tien_sau_ck_nt = t_Tien_nt2 - t_ck_nt;

        // === TỔNG THANH TOÁN (TIỀN PHẢI TRẢ) ===
        decimal t_tt = t_tien_sau_ck + t_thue;
        decimal t_tt_nt = t_tien_sau_ck_nt + t_thue_nt;

        CurPh.T_tien2 = t_Tien2;
        CurPh.T_tien_nt2 = t_Tien_nt2;
        CurPh.T_ck = t_ck;
        CurPh.T_ck_nt = t_ck_nt = t_ck_nt;
        CurPh.T_tien_sau_ck = t_tien_sau_ck;
        CurPh.T_tien_sau_ck_nt = t_tien_sau_ck_nt;
        CurPh.T_thue = t_thue;
        CurPh.T_thue_nt = t_thue_nt;
        CurPh.T_tt = t_tt;
        CurPh.T_tt_nt = t_tt_nt;
        CurPh.T_so_luong = sum_so_luong;


        StateHasChanged();

    }

    private void UpdateTotalThue()
    {
        if (curActionTask == ActionTask.View || CurPh == null)
            return;

        decimal tThueNt = LSCt.Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0)
                   .Sum(x => x.Thue_nt) + (CurrentEditModel?.Thue_nt ?? 0);
        CurPh.T_thue_nt = tThueNt;


        decimal tTienNt = CurPh.T_tien_nt;

        decimal tongCongNt = tTienNt + tThueNt;
        CurPh.T_tt_nt = tongCongNt;

        if (NotMaNt0Voucher)
        {

            decimal tTienVnd = CurPh.T_tien;             // Tiền hàng đã quy đổi
            decimal tThueVnd = LSCt
                           .Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0)
                           .Sum(x => x.Thue)
                           + (CurrentEditModel?.Thue ?? 0);
            CurPh.T_thue = Math.Round(tThueVnd, M_ROUND);
            CurPh.T_tt = Math.Round(tTienVnd + tThueVnd, M_ROUND);
        }
        else
        {
            CurPh.T_thue = tThueNt;
            CurPh.T_tt = tongCongNt;
        }
        StateHasChanged();
    }
