    private void CanBangTien()
    {
        if (CurPh == null) return;

        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;

        // 1. Lấy tổng tiền hàng từ chi tiết phân bổ (DsCp = Table[1])
        decimal sum_Tien_nt2_cp = LSCt.Where(x => x.Stt_rec == CurPh.Stt_rec).Sum(x => x.Tien_nt2);
        decimal sum_Tien2_cp = LSCt.Where(x => x.Stt_rec == CurPh.Stt_rec).Sum(x => x.Tien2);

        // 2. Cập nhật lại tổng tiền hàng chứng từ (t_Tien_nt2 vẫn giữ nguyên, chỉ quy đổi t_Tien2)
        CurPh.T_tien2 = Math.Round(CurPh.T_tien_nt2 * ty_gia, M_ROUND);

        // 3. Cân bằng tiền trên các dòng phân bổ: bù chênh lệch vào dòng có Tien_nt2 <> 0 đầu tiên
        decimal chenlech = CurPh.T_tien2 - sum_Tien2_cp;

        var dongCanBu = LSCt.FirstOrDefault(x => x.Stt_rec == CurPh.Stt_rec && (x.Tien_nt2) != 0m);
        if (dongCanBu != null)
        {
            dongCanBu.Tien2 = (dongCanBu.Tien2) + chenlech;
            @* dongCanBu.Tien = (dongCanBu.Tien2); *@
        }

        // 4. Tính lại tổng thanh toán (t_tt và t_tt_nt)
        CurPh.T_tt_nt = (CurPh.T_tien_nt2) + (CurPh.T_thue_nt) - (CurPh.T_ck_nt);
        CurPh.T_tt = (CurPh.T_tien2) + (CurPh.T_thue) - (CurPh.T_ck);

        // Gọi cập nhật lại tổng chứng từ (nếu cần làm tròn hoặc đồng bộ thêm)
        UpdateTotalHT();
        StateHasChanged();
    }

