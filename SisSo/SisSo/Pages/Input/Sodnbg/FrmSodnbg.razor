    void OnGridCT_Value_Changed(decimal newvalue, string name)
    {
        if (!string.IsNullOrEmpty(name))
        {
            switch (name.ToLower())
            {
                case "so_luong":
                    {
                        // Lấy giá trị số lượng mới từ editor
                        var newValue = Convert.ToDecimal(newvalue);
                        CurrentEditModel.So_luong = newValue;


                        if (newvalue == null)
                            CurrentEditModel.So_luong = 0;

                        decimal soLuong = CurrentEditModel.So_luong;



                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);

                        // === LẤY ĐƠN GIÁ ===
                        decimal Gia_nt2 = CurrentEditModel.Gia_nt2;
                        decimal Gia2 = CurrentEditModel.Gia2;

                        // Nếu có đơn giá ngoại tệ → quy đổi sang VND
                        if (!isVND && Gia_nt2 != 0)
                        {
                            Gia2 = Math.Round(Gia_nt2 * ty_gia, M_ROUND_GIA);
                            CurrentEditModel.Gia2 = Gia2;
                        }

                        // === TÍNH TIỀN NGUYÊN TỆ ===
                        decimal Tien_nt2 = soLuong != 0 ? Math.Round(soLuong * Gia_nt2, M_ROUND_NT) : 0;
                        CurrentEditModel.Tien_nt2 = Tien_nt2;

                        // === TÍNH TIỀN QUY ĐỔI (VND) ===
                        decimal Tien2 = Math.Round(Tien_nt2 * ty_gia, M_ROUND);
                        CurrentEditModel.Tien2 = Tien2;

                        // === ĐỒNG BỘ KHI DÙNG VND ===
                        if (isVND)
                        {
                            CurrentEditModel.Gia2 = Gia_nt2;
                            CurrentEditModel.Tien2 = Tien_nt2;
                            CurPh.T_tien2 = CurPh.T_tien_nt2;
                        }


                        CurrentEditModel.Tien2 = Tien2;
                        CurrentEditModel.Tien_nt2 = Tien_nt2;

                        // === XỬ LÝ CHIẾT KHẤU THEO TỶ LỆ (%) ===
                        decimal tl_ck = CurrentEditModel.Tl_ck;

                        if (tl_ck > 0)
                        {
                            decimal ck = Math.Round(Tien2 * tl_ck / 100, M_ROUND);
                            decimal ck_nt = Math.Round(Tien_nt2 * tl_ck / 100, M_ROUND_NT);

                            CurrentEditModel.Ck = ck;
                            CurrentEditModel.Ck_nt = ck_nt;

                            // Trừ chiết khấu khỏi tổng tiền
                            Tien2 = Tien2 - ck;
                            Tien_nt2 = Tien_nt2 - ck_nt;
                        }
                        string ma_thue = CurrentEditModel.Ma_thue;
                        if (!string.IsNullOrEmpty(ma_thue))
                        {

                            decimal thue_suat = CurrentEditModel.Thue_suat;
                            decimal thue_nt = Math.Round(Tien_nt2 * thue_suat / 100, M_ROUND_NT);
                            decimal thue = Math.Round(Tien2 * thue_suat / 100, M_ROUND);
                            CurrentEditModel.Thue_nt = thue_nt;
                            CurrentEditModel.Thue = thue;


                        }
                        UpdateTotalHT();
                        StateHasChanged();
                        break;
                    }
                case "gia_nt2":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Gia_nt2 = 0;
                        }
                        else
                        {
                            CurrentEditModel.Gia_nt2 = Convert.ToDecimal(newvalue);
                        }

                        decimal Gia_nt2 = CurrentEditModel.Gia_nt2;
                        decimal so_luong = CurrentEditModel.So_luong;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);

                        // Chỉ tính tiền tự động nếu KHÔNG bật chế độ "Sửa tiền trực tiếp"
                        bool canAutoCalcTien = !(CurPh.Sua_tien == 1); // Giả sử ChkSuaTien là bool trong model chứng từ

                        if (canAutoCalcTien && so_luong != 0)
                        {
                            // === TÍNH TIỀN NGUYÊN TỆ ===
                            decimal Tien_nt2 = Math.Round(so_luong * Gia_nt2, M_ROUND_NT);
                            CurrentEditModel.Tien_nt2 = Tien_nt2;

                            if (isVND)
                            {
                                // Trường hợp dùng VND: đồng bộ hoàn toàn
                                CurrentEditModel.Gia2 = Gia_nt2;
                                CurrentEditModel.Tien2 = Tien_nt2;
                            }
                            else
                            {
                                // Quy đổi sang VND
                                CurrentEditModel.Gia2 = Math.Round(Gia_nt2 * ty_gia, M_ROUND_GIA);
                                CurrentEditModel.Tien2 = Math.Round(Tien_nt2 * ty_gia, M_ROUND);
                            }
                        }
                        else if (isVND)
                        {
                            // Nếu là VND nhưng không tự động tính tiền → vẫn đồng bộ giá
                            CurrentEditModel.Gia2 = Gia_nt2;
                        }
                        else if (!isVND)
                        {
                            // Ngoại tệ: quy đổi giá sang VND dù không tính tiền
                            CurrentEditModel.Gia2 = Math.Round(Gia_nt2 * ty_gia, M_ROUND_GIA);
                        }

                        // === CỘNG CHI PHÍ VÀO TỔNG TIỀN (sau cùng) ===
                        decimal Tien2 = CurrentEditModel.Tien2;
                        decimal Tien_nt2_final = CurrentEditModel.Tien_nt2;


                        CurrentEditModel.Tien2 = Tien2;
                        CurrentEditModel.Tien_nt2 = Tien_nt2_final;

                        decimal tl_ck = CurrentEditModel.Tl_ck;
                        if (tl_ck > 0 && canAutoCalcTien)
                        {
                            decimal ck = Math.Round(Tien2 * tl_ck / 100, M_ROUND);
                            decimal ck_nt = Math.Round(Tien_nt2_final * tl_ck / 100, M_ROUND_NT);

                            CurrentEditModel.Ck = ck;
                            CurrentEditModel.Ck_nt = ck_nt;

                            Tien2 = Tien2 - ck;
                            Tien_nt2_final = Tien_nt2_final - ck_nt;
                        }
                        string ma_thue = CurrentEditModel.Ma_thue;

