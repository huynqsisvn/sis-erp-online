                decimal tien_nt = LSCt.Sum(a => a.Tien_nt2);
                decimal tien = LSCt.Sum(a => a.Tien2);

                if (curActionTask == ActionTask.Copy && (t_tien_nt_gt != tien_nt || t_tien_gt != tien))
                {

                    if (CurPh.T_thue != 0 && CurPh.T_thue_nt != 0)
                    {
                        Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
                        myStateMN.SetNewThongbao(Message);
                        IsSaved = false;
                        flag = false;

                    }
                }
                else if (CurPh.T_thue != 0 && CurPh.T_thue_nt != 0)
                {

                    Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
                    myStateMN.SetNewThongbao(Message);
                    IsSaved = false;
                    flag = false;

                }
            }

        } *@
        return flag;
    }
    private async void OnPrint()
    {
        DataSet DataSource = CopyVoucherToDataSet(Stt_rec);

        string tk_no = "";
        string tk_co = "";
        var uniqueTk = new HashSet<string>();
        if (DataSource != null && DataSource.Tables.Count > 0)
        {

            LSData = new List<DNBGModel>();
            DNBGModel _curModel = new DNBGModel();
            _curModel.Ten_cty = myOption.GetOptionsValue("M_TEN_CTY").Trim();
            _curModel.Dia_chi_cty = myOption.GetOptionsValue("M_DIA_CHI").Trim();
            _curModel.Ma_so_thue_cty = myOption.GetOptionsValue("M_MA_THUE").Trim();
            _curModel.Dien_thoai_cty = myOption.GetOptionsValue("M_PHONE").Trim();
            _curModel.LSPh = myDb.ConvertDataTable<Ph110>(DataSource.Tables[0]);

            string strnh = myDb.GetValue("SELECT tk_nh + '#' + ten_nh FROM dmkh WHERE ma_kh = '" + _curModel.LSPh[0].Ncc.Trim() + "'").ToString();

            _curModel.LSCt = myDb.ConvertDataTable<Ct110>(DataSource.Tables[1]).OrderBy(x => x.Stt_rec0).ToList();

            for (int i = 0; i < _curModel.LSCt.Count; i++)
            {
                string ma = _curModel.LSCt[i].Tk_vt?.Trim();
                if (string.IsNullOrEmpty(ma)) continue;

                if (uniqueTk.Add(ma)) // chỉ thêm nếu chưa có
                {
                    tk_no += ma + "\n";
                }
                _curModel.LSCt[i].Stt = i + 1;
            }

            _curModel.TotalString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tien2, myOption, myDb, IsLangEn);
            _curModel.TotalTTString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tt, myOption, myDb, IsLangEn);
            _curModel.TotalStringNT = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt2, myOption, myDb, IsLangEn);
            _curModel.TotalTTStringNT = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tt_nt, myOption, myDb, IsLangEn);
            _curModel.So_lien = curDmct.So_lien;
            _curModel.NgayString = ToDateString(_curModel.LSPh[0].Ngay_ct);
            _curModel.TknoString = tk_no;

            LSData.Add(_curModel);
        }
        IsShowVoucher = false;
        StateHasChanged();
    }

    public string ToDateString(DateTime date)
    {
        return $"ngày {date.Day} tháng {date.Month} năm {date.Year}";
    }

