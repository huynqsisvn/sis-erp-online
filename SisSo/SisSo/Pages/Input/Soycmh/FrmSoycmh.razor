            }
        }

        myStateMN.SetNewThongbao(Message);
    }
    private void Post(int ispostck)
    {
        string _poststore = (Post_store == null || Post_store.Length <= 2) ? "[SOPh109B-Post]" : Post_store[2];
        string format = string.Format("exec [dbo].{0} '{1}',0,{2}", _poststore, CurPh.Stt_rec, ispostck);
        myDb.ExecuteSqlQueryAsync(format);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurPh.Ma_ns))
        {
            Message = "Chưa vào Mã nhân sự.";
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrEmpty(CurPh.Ma_bp))
        {
            Message = "Chưa vào Mã bpns.";
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrEmpty(CurPh.Ma_qs))
        {
            Message = "Chưa vào quyển số.";
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrEmpty(CurPh.So_ct))
        {
            Message = "Chưa vào Số c.từ.";
            StateHasChanged();
            return false;
        }

        return true;
    }

    private async void OnPrint()
    {
        LoadVoucher();
        DataSet DataSource = CopyVoucherToDataSet(Stt_rec);
        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<HYMModel>();
            HYMModel _curModel = new HYMModel();
            _curModel.LSPh = myDb.ConvertDataTable<Ph109>(DataSource.Tables[0]);
            _curModel.LSCt = myDb.ConvertDataTable<Ct109>(DataSource.Tables[1]);

            LSData.Add(_curModel);
        }
        IsShowVoucher = false;
        StateHasChanged();
    }
    private async void OnPrintBack()
    {
        IsShowVoucher = true;
        StateHasChanged();
    }
