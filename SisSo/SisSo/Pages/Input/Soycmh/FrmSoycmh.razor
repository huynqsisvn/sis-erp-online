    public void OnGridCT_Value_Changed(decimal newvalue, string name)
    {
        if (string.IsNullOrEmpty(name) || CurPh == null || CurrentEditModel == null) return;

        bool isVND = CurPh.Ma_nt.Equals("VND", StringComparison.OrdinalIgnoreCase);
        decimal tyGia = CurPh.Ty_gia != 0 ? CurPh.Ty_gia : 1;

        switch (name.ToLower())
        {
            case "so_luong":
                CurrentEditModel.So_luong = newvalue; // Gán giá trị mới ngay lập tức
                if (newvalue == 0)
                {
                    CurrentEditModel.Gia_nt2 = 0;
                    CurrentEditModel.Gia2 = 0;
                    CurrentEditModel.Tien_nt2 = 0;
                    CurrentEditModel.Tien2 = 0;
                }
                else if (CurrentEditModel.Gia_nt2 != 0 || CurrentEditModel.Gia2 != 0)
                {
                    if (isVND)
                    {
                        CurrentEditModel.Tien2 = newvalue * CurrentEditModel.Gia2;
                        CurrentEditModel.Tien_nt2 = CurrentEditModel.Tien2;
                    }
                    else
                    {
                        CurrentEditModel.Tien_nt2 = newvalue * CurrentEditModel.Gia_nt2;
                        CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2 * tyGia;
                    }
                }
                CurrentEditModel.Tien_nt2_duyet = CurrentEditModel.So_luong1 * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;
                break;

            case "gia_nt2":
                CurrentEditModel.Gia_nt2 = newvalue;
                if (CurrentEditModel.So_luong > 0)
                {
                    CurrentEditModel.Tien_nt2 = CurrentEditModel.So_luong * newvalue;
                    if (isVND)
                    {
                        CurrentEditModel.Gia2 = newvalue;
                        CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2;
                    }
                    else
                    {
                        CurrentEditModel.Gia2 = newvalue * tyGia;
                        CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2 * tyGia;
                    }
                }
                CurrentEditModel.Tien_nt2_duyet = CurrentEditModel.So_luong1 * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;
                break;

            case "gia2":
                CurrentEditModel.Gia2 = newvalue; // Cho phép sửa Gia2
                if (CurrentEditModel.So_luong > 0)
                {
                    if (isVND)
                    {
                        CurrentEditModel.Tien2 = CurrentEditModel.So_luong * newvalue;
                        CurrentEditModel.Tien_nt2 = CurrentEditModel.Tien2;
                        CurrentEditModel.Gia_nt2 = newvalue;
                    }
                    else
                    {
                        CurrentEditModel.Gia_nt2 = newvalue / tyGia;
                        CurrentEditModel.Tien_nt2 = CurrentEditModel.So_luong * CurrentEditModel.Gia_nt2;
                        CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2 * tyGia;
                    }
                }
                CurrentEditModel.Tien_nt2_duyet = CurrentEditModel.So_luong1 * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;
                break;

            case "so_luong1":
                CurrentEditModel.So_luong1 = newvalue; // Cho phép sửa So_luong1
                CurrentEditModel.Tien_nt2_duyet = newvalue * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;
                break;

            case "tien_nt2":
                CurrentEditModel.Tien_nt2 = newvalue;
                if (CurrentEditModel.So_luong > 0)
                {
                    CurrentEditModel.Gia_nt2 = newvalue / CurrentEditModel.So_luong;
                    if (isVND)
                    {
                        CurrentEditModel.Tien2 = newvalue;
                        CurrentEditModel.Gia2 = CurrentEditModel.Gia_nt2;
                    }
                    else
                    {
                        CurrentEditModel.Tien2 = newvalue * tyGia;
                        CurrentEditModel.Gia2 = CurrentEditModel.Gia_nt2 * tyGia;
                    }
                }
                CurrentEditModel.Tien_nt2_duyet = CurrentEditModel.So_luong1 * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;
                break;

            case "tien2":
                CurrentEditModel.Tien2 = newvalue;
                if (CurrentEditModel.So_luong > 0)
                {
                    if (isVND)
                    {
                        CurrentEditModel.Gia2 = newvalue / CurrentEditModel.So_luong;
                        CurrentEditModel.Tien_nt2 = newvalue;
                        CurrentEditModel.Gia_nt2 = CurrentEditModel.Gia2;
                    }
                    else
                    {
                        CurrentEditModel.Tien_nt2 = newvalue / tyGia;
                        CurrentEditModel.Gia_nt2 = CurrentEditModel.Tien_nt2 / CurrentEditModel.So_luong;
                        CurrentEditModel.Gia2 = CurrentEditModel.Gia_nt2 * tyGia;
                    }
                }
                CurrentEditModel.Tien_nt2_duyet = CurrentEditModel.So_luong1 * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;
                break;

            case "tien_nt2_duyet":
            case "tien2_duyet":
                // Không cho sửa trực tiếp Tien_nt2_duyet và Tien2_duyet
                return;
        }

        Sum_All();
        StateHasChanged();
    }
    async void OnGridCT_DMDM_Changed(ExpandoObject value)
    {
        if (value == null || CurrentEditModel == null) return;

        var dict = (IDictionary<string, object>)value;
        if (dict.TryGetValue("ma_vt", out var ma_vt))
        {
            CurrentEditModel.Ma_vt = ma_vt?.ToString();
            CurrentEditModel.Dvt1 = dict.TryGetValue("dvt", out var dvt) ? dvt?.ToString() : CurrentEditModel.Dvt1;
            CurrentEditModel.Ten_vt = dict.TryGetValue("ten_vt", out var ten_vt) ? ten_vt?.ToString() : CurrentEditModel.Ten_vt;

            if (CurPh != null)
            {
                DataRow dataRow = Getdmgia2(CurrentEditModel.Ma_vt?.Trim(), string.Format("{0:yyyyMMdd}", CurPh.Ngay_ct), "");
                if (dataRow != null)
                {
                    CurrentEditModel.Gia_nt2 = decimal.TryParse(dataRow["gia_nt2"]?.ToString(), out var gia_nt2) ? gia_nt2 : 0;
                    CurrentEditModel.Gia2 = decimal.TryParse(dataRow["gia2"]?.ToString(), out var gia2) ? gia2 : 0;
                }
            }
        }
        else if (dict.TryGetValue("ma_kh", out var ma_kh))
        {
            CurrentEditModel.Ncc = ma_kh?.ToString();
        }
        else if (dict.TryGetValue("dvt", out var dvt2))
        {
            CurrentEditModel.Dvt1 = dvt2?.ToString();
        }

        Sum_All();
        StateHasChanged();
    }
    async void OnGridCT_DMDM_Changed(ExpandoObject value, string ma_dm)
    {
        if (value == null || CurrentEditModel == null)
            return;
        switch (ma_dm.ToLower())
        {
            case "ma_vt":
                {
                    CurrentEditModel.Ma_vt = value.Where(a => a.Key.Equals("ma_vt")).FirstOrDefault().Value.ToString();
                    CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt")).FirstOrDefault().Value.ToString();
                    CurrentEditModel.Ten_vt = value.Where(a => a.Key.Equals("ten_vt")).FirstOrDefault().Value.ToString();

                    if (!string.IsNullOrEmpty(CurPh.Ma_dvcs_bl))
                    {
                        string sql = string.Format("select top(1) ma_px from [cosxlt-dmdmvt] where ma_sp = '{0}' and ma_dvcs = '{1}'", CurrentEditModel.Ma_vt.Trim(), CurPh.Ma_dvcs_bl.Trim());
                        DataSet _ds = await myDb.LoadDataset(sql);
                        DataTable tblMaPX = _ds.Tables[0];
                        if (tblMaPX.Rows.Count != 0)
                        {
                            CurrentEditModel.Ma_px_i = tblMaPX.Rows[0]["ma_px"].ToString();
                        }
                    }
                    if (CurPh.Ngay_ct != new DateTime())
                    {
                        DataRow dataRow = Getdmgia2(CurrentEditModel.Ma_vt.Trim(), string.Format("{0:yyyyMMdd}", CurPh.Ngay_ct), CurPh.Nh_kh3);
                        if (dataRow != null)
                        {
                            CurrentEditModel.Gia_nt2 = !CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim()) ? decimal.Parse(dataRow["gia_nt2"].ToString()) : decimal.Parse(dataRow["gia2"].ToString());
                            CurrentEditModel.Gia2 = decimal.Parse(dataRow["gia2"].ToString());
                        }
                    }

                    if (CurrentEditModel.Vt_ton_kho == 1)
                    {
                        if (M_QL_LO_CK.ToString().Trim() != "1")
                        {
                            CurrentEditModel.Ton13 = GetTon13(CurrentEditModel.Ma_kho_i, CurrentEditModel.Ma_vt.Trim(), CurrentEditModel.Ma_vv_i);
                        }
                        else
                        {
                            CurrentEditModel.Ton13 = GetTon13Lo(CurrentEditModel.Ma_kho_i, CurrentEditModel.Ma_vt.Trim(), CurrentEditModel.Ma_vv_i, CurrentEditModel.Ma_lo);
                        }
                    }
                    else
                        CurrentEditModel.Ton13 = 0;
                    break;
                }
            case "ma_kho_i":
                CurrentEditModel.Ma_kho_i = value.Where(a => a.Key.Equals("ma_kho")).FirstOrDefault().Value.ToString();
                break;
            case "ma_px_i":
                CurrentEditModel.Ma_px_i = value.Where(a => a.Key.Equals("ma_px")).FirstOrDefault().Value.ToString();
                break;
            case "ma_thue":
                {
                    CurrentEditModel.Ma_thue = value.Where(a => a.Key.Equals("ma_thue")).FirstOrDefault().Value.ToString();
                    CurrentEditModel.Thue_suat = decimal.Parse(value.Where(a => a.Key.Equals("thue_suat")).FirstOrDefault().Value.ToString());
                    decimal newValue = CurrentEditModel.Thue_suat;
                    if (newValue != new Decimal(0))
                    {
                        Decimal tienThue = (CurrentEditModel.Tien_nt2 * newValue / new Decimal(100));
                        CurrentEditModel.Thue_nt = tienThue;

                        Decimal tienThueQuyDoi = (tienThue * CurPh.Ty_gia);

                        if (tienThueQuyDoi != new Decimal(0))
                        {
                            CurrentEditModel.Thue = tienThueQuyDoi;
                        }
                    }
                    else
                    {
                        CurrentEditModel.Thue = 0;
                        CurrentEditModel.Thue_nt = 0;
                    }
                    CurrentEditModel.Thue_nt = CurrentEditModel.Thue;
                    break;
                }
            case "ncc":
                CurrentEditModel.Ncc = value.Where(a => a.Key.Equals("ma_kh")).FirstOrDefault().Value.ToString();
                break;
        }
        Sum_All();
        StateHasChanged();
    }
