@inherits TranBaseComponent
@using System.Data
@using DevExpress.Blazor

<div class="m-0 p-0 w-100" data-spy="scroll">
    @if (IsShowVoucher)
    {
        <FormTrans Title="@Pagetitle" @bind-curActionTask="@curActionTask" OnNew="@OnNew" OnCopy="@OnCopy" OnEdit="@OnEdit" OnSave="@OnSave" OnCancel="@OnCancel" OnPrint="@OnPrint" Stt_rec="@CurPh.Stt_rec" curUser="@curUser" Ma_ct="@Ma_ct" Menu_id="@Menu_id" Phdbf="@M_Phdbf">
            <div class="row m-1 me-2 rounded-1 border border-light shadow">
                <DxFormLayout SizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
                    <DxFormLayoutTabPages ColSpanMd="12">
                        <DxFormLayoutTabPage Caption="@Lap["Infomation"]" CssClass="css-header">
                            <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None">
                                <DxFormLayoutGroup ColSpanMd="8" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode">
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row align-items-center">
                                                <label class="col-2">@Lap["Requester"]</label>
                                                <div class="col-3 p-0">
                                                    <AutocompleteComponent TblData="@TblDmns"
                                                                           Ma_dm="dmns"
                                                                           @bind-Value="@CurPh.Ma_ns"
                                                                           SelectChanged="@OnAutoCompleteNhanSuChanged"
                                                                           IsEnable="@AllowEditMode"
                                                                           IsLangEn="@IsLangEn" />
                                                </div>
                                                <label class="col ms-2">@Ten_ns</label>
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row align-items-center">
                                                <label class="col-2">@Lap["Part"]</label>
                                                <div class="col-3 p-0">
                                                    <AutocompleteComponent TblData="@TblDmbpns"
                                                                           Ma_dm="dmbpns"
                                                                           @bind-Value="@CurPh.Ma_bp"
                                                                           SelectChanged="@OnAutoCompleteBoPhanChanged"
                                                                           IsEnable="@AllowEditMode"
                                                                           IsLangEn="@IsLangEn" />
                                                </div>
                                                <label class="col ms-2">@Ten_bpns</label>
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row">
                                                <label class="col-2">@Lap["Priority"]</label>
                                                <div class="col-3 p-0 d-flex align-items-center">
                                                    <DxComboBox CssClass="col-12"
                                                                Data="@PriorityLevels"
                                                                @bind-Value="@CurPh.Muc_do"
                                                                Enabled="@AllowEditMode" />
                                                </div>
                                                <label class="col ms-2">1 - Mức 1, 2 - Mức 2, 3 - Mức 3</label>
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row">
                                                <label class="col-2">@Lap["Description"]</label>
                                                <div class="col-10 p-0">
                                                    <DxTextBox CssClass="col-12 p-0"
                                                               @bind-Text="@CurPh.Dien_giai"
                                                               Enabled="@AllowEditMode" />
                                                </div>
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                </DxFormLayoutGroup>
                                <DxFormLayoutGroup Caption="@Lap["Voucher"]" ColSpanMd="4" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode">
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row">
                                                <label class="col-4">@Lap["Request Date"]</label>
                                                <DxDateEdit CssClass="col"
                                                            @bind-Date="@CurPh.Ngay_ct"
                                                            DisplayFormat="dd-MM-yyyy"
                                                            Format="dd-MM-yyyy"
                                                            Enabled="@AllowEditMode" />
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row">
                                                <label class="col-4">@Lap["Voucher Book"]</label>
                                                <AutocompleteComponent CssClass="col p-0"
                                                                       Ma_dm="dmqs"
                                                                       @bind-Value="@CurPh.Ma_qs"
                                                                       SelectChanged="@OnAutoCompleteQuyensoChanged"
                                                                       Filter="@_filter_qs"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn" />
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row">
                                                <label class="col-4">@Lap["Request Number"]</label>
                                                <DxTextBox CssClass="col"
                                                           @bind-Text="@CurPh.So_ct"
                                                           Enabled="@AllowEditMode" />
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row">
                                                <label class="col-4">@Lap["Exchange Rate"]</label>
                                                <AutocompleteComponent CssClass="col p-0"
                                                                       Ma_dm="dmnt"
                                                                       @bind-Value="@CurPh.Ma_nt"
                                                                       SelectChanged="@OnAutoCompleteMaNTChanged"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn" />
                                                <DxSpinEdit CssClass="col"
                                                            @bind-Value="@CurPh.Ty_gia"
                                                            DisplayFormat="@M_IP_TY_GIA"
                                                            Enabled="@AllowEditMode" />
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div class="row align-items-center">
                                                <label class="col-4">@Lap["Status"]</label>
                                                <div class="col-8 p-0">
                                                    <DxComboBox Data="@StatusItems"
                                                                TextFieldName="DisplayText"
                                                                ValueFieldName="Value"
                                                                @bind-Value="@CurPh.Status"
                                                                Enabled="@AllowEditMode"
                                                                CssClass="w-100" />
                                                </div>
                                            </div>
                                        </Template>
                                    </DxFormLayoutItem>
                                </DxFormLayoutGroup>
                            </DxFormLayoutGroup>
                        </DxFormLayoutTabPage>
                    </DxFormLayoutTabPages>
                    <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail">
                        <DxFormLayoutTabPage Caption="@Lap["Details"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <DxGrid @ref="GridCT" SizeMode="@Itemsizemode" CssClass="@grd_Css"
                                            AllowSelectRowByClick="true"
                                            Data="@LSCt"
                                            @bind-SelectedDataItem="@SelectedDataItemCT"
                                            ValidationEnabled="false"
                                            EditMode="GridEditMode.EditCell"
                                            CustomizeEditModel="Grid_CustomizeEditModelCT"
                                            EditModelSaving="Grid_EditModelSavingCT"
                                            DataItemDeleting="Grid_DataItemDeletingCT"
                                            CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                            ColumnResizeMode="GridColumnResizeMode.NextColumn"
                                            EditNewRowPosition="@NewItemRowPosition"
                                            ShowAllRows="true"
                                            TextWrapEnabled="false"
                                            HighlightRowOnHover="true">
                                        <Columns>
                                            <DxGridCommandColumn Width="30px" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                                <CellDisplayTemplate Context="cntedit">
                                                    <div class="grid-cell-align-center">
                                                        <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                                  RenderStyle="ButtonRenderStyle.Link"
                                                                  CssClass="grid-delete-btn"
                                                                  Click="@(() => GridCT.ShowRowDeleteConfirmation(cntedit.VisibleIndex))" />
                                                    </div>
                                                </CellDisplayTemplate>
                                                <CellEditTemplate Context="cntedit1">
                                                    <div class="grid-cell-align-center">
                                                        <DxButton Enabled="false"
                                                                  CssClass="grid-disabled-button"
                                                                  IconCssClass="grid-icon grid-icon-delete"
                                                                  RenderStyle="ButtonRenderStyle.Link" />
                                                    </div>
                                                </CellEditTemplate>
                                            </DxGridCommandColumn>
                                            <DxGridDataColumn FieldName="Ma_vt" Caption="@Lap["Product code"]" Width="100px" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("1")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct109 = (Ct109)GrdContext.EditModel;
                                                    }
                                                    <AutocompleteComponent Ma_dm="dmvt" @bind-Value="@_Ct109.Ma_vt" SelectChanged="@((ExpandoObject val) => OnGridCT_DMDM_Changed(val, "Ma_vt"))" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ten_vt" ReadOnly="true" Caption="@Lap["Product name"]" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("2")" />
                                            <DxGridDataColumn FieldName="Dvt1" Caption="@Lap["Unit"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="80px"  VisibleIndex="@CtOrder.GetKey("2")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct109 = (Ct109)GrdContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct109.Dvt1" ReadOnly="true"/>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ngay_ct" Caption="@Lap["Request Date"]"
                                                              CaptionAlignment="GridTextAlignment.Center" Width="110px" VisibleIndex="4">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct109 = (Ct109)GrdContext.EditModel;
                                                    }
                                                    <DxDateEdit @bind-Date="@_Ct109.Ngay_ct"
                                                                DisplayFormat="dd-MM-yyyy"
                                                                Format="dd-MM-yyyy"
                                                                Enabled="@AllowEditMode" />
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="So_luong" Caption="@Lap["Requested Quantity"]" CaptionAlignment="GridTextAlignment.Center" Width="120px" DisplayFormat="N2" VisibleIndex="5">
    <CellEditTemplate Context="GrdContext">
        @{
            var _Ct109 = (Ct109)GrdContext.EditModel;
        }
                                                    <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct109.So_luong" ValueExpression="@(() => _Ct109.So_luong)" ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "so_luong"))" />
                                                </CellEditTemplate>
</DxGridDataColumn>

@if (CurPh.Ma_nt.Equals("VND"))
{
                                                <DxGridDataColumn FieldName="Gia2" Caption="@Lap["Selling Price"]" Width="130px" DisplayFormat="N2" VisibleIndex="6">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct109 = (Ct109)GrdContext.EditModel;
                                                            bool isFullyEntered = _Ct109.So_luong > 0 &&
                                                            ((_Ct109.Gia_nt2 != 0 || _Ct109.Gia2 != 0) ||
                                                            (_Ct109.Tien_nt2 != 0 || _Ct109.Tien2 != 0));
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct109.Gia2" ValueExpression="@(() => _Ct109.Gia2)" ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "gia2"))" />
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Tien2" Caption="@Lap["Total Amount"]" Width="130px" DisplayFormat="N2" VisibleIndex="7">
        <CellEditTemplate Context="GrdContext">
            @{
                var _Ct109 = (Ct109)GrdContext.EditModel;
            }
            <DxSpinEdit Enabled="@(AllowEditMode && (_Ct109.So_luong == 0 || _Ct109.Gia2 == 0))" Value="@_Ct109.Tien2" ValueExpression="@(() => _Ct109.Tien2)" ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "Tien2"))" />
        </CellEditTemplate>
    </DxGridDataColumn>
}
else
{
                                                <DxGridDataColumn FieldName="Gia_nt2" Caption="@String.Concat(Lap["Selling Price"], " ", CurPh.Ma_nt ?? "")" Width="130px" DisplayFormat="N2" VisibleIndex="6">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct109 = (Ct109)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct109.Gia_nt2" ValueExpression="@(() => _Ct109.Gia_nt2)" ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "gia_nt2"))" />
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Tien_nt2" Caption="@String.Concat(Lap["Total Amount"], " ", CurPh.Ma_nt ?? "")" Width="130px" DisplayFormat="N2" VisibleIndex="7">
        <CellEditTemplate Context="GrdContext">
            @{
                var _Ct109 = (Ct109)GrdContext.EditModel;
            }
            <DxSpinEdit Enabled="@(AllowEditMode && (_Ct109.So_luong == 0 || _Ct109.Gia_nt2 == 0 || _Ct109.Gia2 == 0))" Value="@_Ct109.Tien_nt2" ValueExpression="@(() => _Ct109.Tien_nt2)" ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "Tien_nt2"))" />
        </CellEditTemplate>
    </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Gia2" Caption="@String.Concat(Lap["Selling Price VND"])" Width="130px" DisplayFormat="N2" VisibleIndex="8">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct109 = (Ct109)GrdContext.EditModel;
                                                            bool isFullyEntered = _Ct109.So_luong > 0 &&
                                                            ((_Ct109.Gia_nt2 != 0 || _Ct109.Gia2 != 0) ||
                                                            (_Ct109.Tien_nt2 != 0 || _Ct109.Tien2 != 0));
                                                        }
                                                        <DxSpinEdit Enabled="@(AllowEditMode && !isFullyEntered)"
                                                                    Value="@_Ct109.Gia2"
                                                                    ValueExpression="@(() => _Ct109.Gia2)"
                                                                    ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "Gia2"))" />
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Tien2" Caption="@String.Concat(Lap["Total Amount VND"])" Width="130px" DisplayFormat="N2" VisibleIndex="9">
        <CellEditTemplate Context="GrdContext">
            @{
                var _Ct109 = (Ct109)GrdContext.EditModel;
            }
            <DxSpinEdit Enabled="false" Value="@_Ct109.Tien2" ValueExpression="@(() => _Ct109.Tien2)" /> <!-- Không cho sửa Tien2 -->
        </CellEditTemplate>
    </DxGridDataColumn>
}

                                            <DxGridDataColumn FieldName="So_luong1" Caption="@Lap["Approved Quantity"]" CaptionAlignment="GridTextAlignment.Center" Width="120px" DisplayFormat="N2" VisibleIndex="@(CurPh.Ma_nt.Equals("VND") ? 8 : 10)">
    <CellEditTemplate Context="GrdContext">
        @{
            var _Ct109 = (Ct109)GrdContext.EditModel;
        }
                                                    <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct109.So_luong1" ValueExpression="@(() => _Ct109.So_luong1)" ValueChanged="@((decimal newvalue) => OnGridCT_Value_Changed(newvalue, "so_luong1"))" />
                                                </CellEditTemplate>
</DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Tien_nt2_duyet" Caption="@String.Concat(Lap["Approved Total Amount"], " ", CurPh.Ma_nt ?? "")"
                  Width="130px" DisplayFormat="N2" VisibleIndex="@(CurPh.Ma_nt.Equals("VND") ? 9 : 11)">
    <CellEditTemplate Context="GrdContext">
        @{
            var _Ct109 = (Ct109)GrdContext.EditModel;
        }
        <DxSpinEdit Enabled="false" Value="@_Ct109.Tien_nt2_duyet" ValueExpression="@(() => _Ct109.Tien_nt2_duyet)" /> 
    </CellEditTemplate>
</DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Tien2_duyet" Caption="@Lap["Approved Total Amount VND"]"
                  Width="130px" DisplayFormat="N2" Visible="@(!CurPh.Ma_nt.Equals("VND"))" VisibleIndex="@(CurPh.Ma_nt.Equals("VND") ? 10 : 12)">
    <CellEditTemplate Context="GrdContext">
        @{
            var _Ct109 = (Ct109)GrdContext.EditModel;
        }
        <DxSpinEdit Enabled="false" Value="@_Ct109.Tien2_duyet" ValueExpression="@(() => _Ct109.Tien2_duyet)" /> 
    </CellEditTemplate>
</DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ncc" Caption="@Lap["NCC"]" Width="120px" VisibleIndex="@(CurPh.Ma_nt.Equals("VND") ? 10 : 13)">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct109 = (Ct109)GrdContext.EditModel;
                                                    }
                                                    <AutocompleteComponent Ma_dm="dmkh"
                                                                           @bind-Value="@_Ct109.Ncc"
                                                                           SelectChanged="@((ExpandoObject val) => OnGridCT_DMDM_Changed(val, "Ncc"))"
                                                                           IsEnable="@AllowEditMode"
                                                                           IsLangEn="@IsLangEn" />
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Duyet" Caption="@Lap["Approval"]" Width="80px" VisibleIndex="@(CurPh.Ma_nt.Equals("VND") ? 11 : 14)">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct109 = (Ct109)GrdContext.EditModel;
                                                    }
                                                    <DxCheckBox @bind-Checked="@_Ct109.Duyet" Enabled="@AllowEditMode" />
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ghi_chu" Caption="@Lap["Note"]" Width="160px" VisibleIndex="@(CurPh.Ma_nt.Equals("VND") ? 12 : 15)">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct109 = (Ct109)GrdContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct109.Ghi_chu" Enabled="@AllowEditMode" />
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                        </Columns>
                                        <TotalSummary>
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="N2" Name="So_luong" FieldName="So_luong" />
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="N2" Name="Tien2" FieldName="Tien2" />
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="N2" Name="Tien_nt2_duyet" FieldName="Tien_nt2_duyet" />
                                            @if (CurPh.Ma_nt.Equals("VND"))
                                            {
                                              
                                            }
                                            else
                                            {
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="N2" Name="Tien_nt2" FieldName="Tien_nt2" />
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="N2" Name="Tien2_duyet" FieldName="Tien2_duyet" />
                                            }
                                        </TotalSummary>
                                    </DxGrid>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>
                        <DxFormLayoutTabPage Caption="@Lap["Note"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div class="row">
                                        <label class="col-2">@Lap["Voucher Note"]</label>
                                        <div class="col-10 p-0">
                                            <DxTextBox CssClass="col-12 p-0"
                                                       @bind-Text="@CurPh.Ghi_chu0"
                                                       Enabled="@AllowEditMode"
                                                       Height="100px"
                                                       TextWrapping="Wrap" />
                                        </div>
                                    </div>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>
                    </DxFormLayoutTabPages>
                    <DxFormLayoutGroup Caption="@Lap["Total"]" ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="custom-summary-section">
                        <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None">

                            <!-- Một dòng: Số lượng YC + Tiền YC + (ngoại tệ nếu có) -->
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div class="row align-items-center">
                                        <!-- Số lượng YC -->
                                        <label class="col-md-2 fw-bold">@Lap["Requested Quantity"]</label>
                                        <div class="col-md-2">
                                            <DxSpinEdit Id="t_so_luong" Enabled="false" @bind-Value="@CurPh.T_so_luong" DisplayFormat="N2" />
                                        </div>

                                        <!-- Tiền YC -->
                                        <label class="col-md-2 fw-bold">@Lap["Requested Amount"]</label>
                                        <div class="col-md-2">
                                            <DxSpinEdit Id="t_tien_nt2" Enabled="false" @bind-Value="@CurPh.T_tien_nt2" DisplayFormat="N2" />
                                        </div>

                                        <!-- Tiền ngoại tệ (nếu có) -->
                                        @if (!CurPh.Ma_nt.Equals("VND"))
                                        {
                                            <div class="col-md-2">
                                                <DxSpinEdit Id="t_tien2" Enabled="false" @bind-Value="@CurPh.T_tien2" DisplayFormat="N2" />
                                            </div>
                                        }
                                    </div>
                                </Template>
                            </DxFormLayoutItem>

                            <!-- Một dòng: Số lượng duyệt + Tiền duyệt + (ngoại tệ nếu có) -->
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div class="row align-items-center">
                                        <!-- Số lượng duyệt -->
                                        <label class="col-md-2 fw-bold">@Lap["Approved Quantity"]</label>
                                        <div class="col-md-2">
                                            <DxSpinEdit Id="t_so_luong1" Enabled="false" @bind-Value="@CurPh.T_so_luong1" DisplayFormat="N2" />
                                        </div>

                                        <!-- Tiền duyệt -->
                                        <label class="col-md-2 fw-bold">@Lap["Approved Amount"]</label>
                                        <div class="col-md-2">
                                            <DxSpinEdit Id="t_tien_nt2_duyet" Enabled="false" @bind-Value="@CurPh.T_tien_nt2_duyet" DisplayFormat="N2" />
                                        </div>

                                        <!-- Tiền ngoại tệ duyệt (nếu có) -->
                                        @if (!CurPh.Ma_nt.Equals("VND"))
                                        {
                                            <div class="col-md-2">
                                                <DxSpinEdit Id="t_tien2_duyet" Enabled="false" @bind-Value="@CurPh.T_tien2_duyet" DisplayFormat="N2" />
                                            </div>
                                        }
                                    </div>
                                </Template>
                            </DxFormLayoutItem>

                        </DxFormLayoutGroup>
                    </DxFormLayoutGroup>

                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <hr />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        </FormTrans>
    }
    else
    {
        <SisLib.Ctrl.ReportOptionComponent LSItems="LSData" Menu_id="@Menu_id.Replace('_', '.')" Parent_url="@mPage" OnBack="@OnPrintBack" />
    }
</div>

<style>
    .disabled-grid {
        pointer-events: none;
        opacity: 0.7;
    }
    .css-textcolor {
        color: black !important;
    }
    .css-header {
        height: 190px;
    }

    .mt-4 .row {
        margin-bottom: 0.5rem;
    }

    .mt-4 .col-3 {
        padding: 0 5px;
    }
    .css-detail {
        height: 270px;
    }

    .grd-detail {
        height: 250px;
    }
    .custom-summary-section {
    padding: 16px;    
    margin-top: 10px;   
    border-radius: 8px;  
    min-height: 120px; 
  }
   .grd-detail .dxbl-grid-table tr {
            height: 20px;
        }

    .chkclass {
        width: fit-content;
    }

    .mt-4{
        height: 100px;
    }
    .grid-icon {
        background-color: transparent;
    }

    .text-black {
        color: black !important;
    }

    .grid-icon-delete {
        width: 8px;
        height: 8px;
        padding: 0px;
        margin: 0px;
    }
</style>
@code {
    #region Parameter

    DxWindow windowRef;
    public DataTable TblDmns { get; set; }
    public DataTable TblDmbpns { get; set; }
    public List<string> PriorityLevels { get; set; } = new List<string> { "1", "2", "3" };
    Ph109 LastPh = new Ph109();
    Ph109 CurPh;
    Ct109 CurCt;
