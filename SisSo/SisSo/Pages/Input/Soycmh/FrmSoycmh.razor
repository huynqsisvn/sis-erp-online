                cts.Ncc = CurrentEditModel.Ncc;
                cts.Duyet = CurrentEditModel.Duyet;
                cts.Ghi_chu = CurrentEditModel.Ghi_chu;
            }
        }

        // Cập nhật tổng và làm mới giao diện
