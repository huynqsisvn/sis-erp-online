    public async Task Grid_EditModelSavingCT(GridEditModelSavingEventArgs e)
    {
        // Gán mô hình chỉnh sửa hiện tại
        CurrentEditModel = (Ct109)e.EditModel;

        // Kiểm tra điều kiện hợp lệ
        if (string.IsNullOrEmpty(CurrentEditModel.Ma_vt) || CurrentEditModel.So_luong < 0)
        {
            Message = "Chưa vào mã vật tư hoặc số lượng không hợp lệ.";
            StateHasChanged();
            return;
        }

        // Lấy thông tin tỷ giá và trạng thái tiền tệ
        bool isVND = CurPh.Ma_nt.Equals("VND", StringComparison.OrdinalIgnoreCase);
        decimal tyGia = CurPh.Ty_gia != 0 ? CurPh.Ty_gia : 1;

        // Tính toán lại các giá trị dựa trên dữ liệu mới từ CurrentEditModel
        if (CurrentEditModel.So_luong != 0 && (CurrentEditModel.Gia_nt2 != 0 || CurrentEditModel.Gia2 != 0))
        {
            if (isVND)
            {
                CurrentEditModel.Tien2 = CurrentEditModel.So_luong * CurrentEditModel.Gia2;
                CurrentEditModel.Tien_nt2 = CurrentEditModel.Tien2;
            }
            else
            {
                CurrentEditModel.Tien_nt2 = CurrentEditModel.So_luong * CurrentEditModel.Gia_nt2;
                CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2 * tyGia;
            }
        }
        else if (CurrentEditModel.So_luong != 0 && (CurrentEditModel.Tien_nt2 != 0 || CurrentEditModel.Tien2 != 0))
        {
            if (isVND)
            {
                CurrentEditModel.Gia2 = CurrentEditModel.Tien2 / CurrentEditModel.So_luong;
                CurrentEditModel.Gia_nt2 = CurrentEditModel.Gia2;
            }
            else
            {
                CurrentEditModel.Gia_nt2 = CurrentEditModel.Tien_nt2 / CurrentEditModel.So_luong;
                CurrentEditModel.Gia2 = CurrentEditModel.Gia_nt2 * tyGia;
            }
        }
        else
        {
            CurrentEditModel.Gia_nt2 = 0;
            CurrentEditModel.Gia2 = 0;
            CurrentEditModel.Tien_nt2 = 0;
            CurrentEditModel.Tien2 = 0;
        }

        // Cập nhật tiền duyệt dựa trên So_luong1 và Gia_nt2/Gia2 mới nhất
        CurrentEditModel.Tien_nt2_duyet = CurrentEditModel.So_luong1 * CurrentEditModel.Gia_nt2;
        CurrentEditModel.Tien2_duyet = isVND ? CurrentEditModel.Tien_nt2_duyet : CurrentEditModel.Tien_nt2_duyet * tyGia;

        // Xử lý lưu dữ liệu
        if (e.IsNew)
        {
            LSCt.Add(CurrentEditModel);
        }
        else
        {
            var cts = LSCt.FirstOrDefault(a => a.Stt_rec.Equals(CurrentEditModel.Stt_rec) && a.Stt_rec0 == CurrentEditModel.Stt_rec0);
            if (cts != null)
            {
                cts.Ma_vt = CurrentEditModel.Ma_vt;
                cts.Dvt1 = CurrentEditModel.Dvt1;
                cts.Dien_giai = CurrentEditModel.Dien_giai;
                cts.So_luong = CurrentEditModel.So_luong;
                cts.So_luong1 = CurrentEditModel.So_luong1;
                cts.Gia = CurrentEditModel.Gia;
                cts.Gia_nt = CurrentEditModel.Gia_nt;
                cts.Gia2 = CurrentEditModel.Gia2;
                cts.Gia_nt2 = CurrentEditModel.Gia_nt2;
                cts.Tien = CurrentEditModel.Tien;
                cts.Tien_nt = CurrentEditModel.Tien_nt;
                cts.Tien2 = CurrentEditModel.Tien2;
                cts.Tien_nt2 = CurrentEditModel.Tien_nt2;
                cts.Tien_nt2_duyet = CurrentEditModel.Tien_nt2_duyet;
                cts.Tien2_duyet = CurrentEditModel.Tien2_duyet;
                cts.Han_gh_i = CurrentEditModel.Han_gh_i;
                cts.Ma_thue = CurrentEditModel.Ma_thue;
                cts.Thue = CurrentEditModel.Thue;
                cts.Thue_nt = CurrentEditModel.Thue_nt;
                cts.Thue_suat = CurrentEditModel.Thue_suat;
                cts.Tl_ck = CurrentEditModel.Tl_ck;
                cts.Ck = CurrentEditModel.Ck;
                cts.Ck_nt = CurrentEditModel.Ck_nt;
                cts.Ma_kho_i = CurrentEditModel.Ma_kho_i;
                cts.Ma_px_i = CurrentEditModel.Ma_px_i;
                cts.Ma_phi_i = CurrentEditModel.Ma_phi_i;
                cts.Tk_thue_i = CurrentEditModel.Tk_thue_i;
                cts.Ma_tb_i = CurrentEditModel.Ma_tb_i;
                cts.Ma_bpht_i = CurrentEditModel.Ma_bpht_i;
                cts.Ma_ns_i = CurrentEditModel.Ma_ns_i;
                cts.Ma_vv_i = CurrentEditModel.Ma_vv_i;
                cts.Tk_dt = CurrentEditModel.Tk_dt;
                cts.Tk_gv = CurrentEditModel.Tk_gv;
