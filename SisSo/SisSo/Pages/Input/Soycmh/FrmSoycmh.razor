                cts.Sl_td1_i = CurrentEditModel.Sl_td1_i;
                cts.Sl_td2_i = CurrentEditModel.Sl_td2_i;
                cts.Sl_td3_i = CurrentEditModel.Sl_td3_i;
                cts.Gc_td1_i = CurrentEditModel.Gc_td1_i;
