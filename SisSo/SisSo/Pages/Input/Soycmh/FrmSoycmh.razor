    public void OnAutoCompleteMaNTChanged(ExpandoObject value)
    {
        if (value == null) return;

        string sql = $"select ty_gia from dmtgnt where ma_nt = '{CurPh.Ma_nt.Trim()}'";
        DataSet ds = myDb.LoadDataSet(sql);
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            CurPh.Ty_gia = decimal.Parse(ds.Tables[0].Rows[0][0].ToString());
        }

        NotMaNt0Voucher = !CurPh.Ma_nt.Trim().Equals(M_ma_nt0, StringComparison.OrdinalIgnoreCase);
        decimal tyGia = CurPh.Ty_gia != 0 ? CurPh.Ty_gia : 1;

        foreach (var ct in LSCt)
        {
            if (CurPh.Ma_nt.Equals("VND", StringComparison.OrdinalIgnoreCase))
            {
                ct.Gia_nt2 = ct.Gia2;
                ct.Tien_nt2 = ct.So_luong * ct.Gia_nt2;
                ct.Tien2 = ct.Tien_nt2;
                ct.Tien_nt2_duyet = ct.So_luong1 * ct.Gia_nt2;
                ct.Tien2_duyet = ct.Tien_nt2_duyet;
            }
            else
            {
                ct.Gia2 = ct.Gia_nt2 * tyGia;
                ct.Tien_nt2 = ct.So_luong * ct.Gia_nt2;
                ct.Tien2 = ct.Tien_nt2 * tyGia;
                ct.Tien_nt2_duyet = ct.So_luong1 * ct.Gia_nt2;
                ct.Tien2_duyet = ct.Tien_nt2_duyet * tyGia;
            }
        }

        Sum_All(); // Cập nhật tổng cộng
        StateHasChanged(); // Làm mới giao diện
    }
