@code {
    public string Ma_kh = "";
    public string ma_ncc = "";

    bool IsAdminUser => curUser != null && curUser.Is_admin == 1;

    public string Ma_qs = "";
    public string Ghi_no_co = "";
    public string Tk_i = "";
    public string Status = "";
    public string Ps_no = "";
    public string Ps_co = "";
    public string So_ct1 = "";
    public string So_ct2 = "";
    public string Ma_dvcs = "";
    public string NSD = "";

    string _filter_qs = "";
    string filter_status = "ma_ct like '%HDM%' ";

    private List<(string Caption, string Value, string Color, string Icon)> GetKpiTiles()
    {
        var tiles = new List<(string, string, string, string)>();
        if (TblPH == null) return tiles;

        int total = TblPH.Rows.Count;
        tiles.Add(("Tổng số đơn hàng", total.ToString(), "purple", "oi-document"));
        if (total == 0) return tiles;

        bool hasStatus = TblPH.Columns.Contains("status");
        int soLapPhieu = hasStatus ? TblPH.AsEnumerable().Count(r => (r["status"]?.ToString() ?? "").Trim() == "1") : 0;
        int soDongPhieu = hasStatus ? TblPH.AsEnumerable().Count(r => (r["status"]?.ToString() ?? "").Trim() == "2") : 0;
        tiles.Add(("Đang lập phiếu", soLapPhieu.ToString(), "orange", "oi-pencil"));
        tiles.Add(("Đã đóng phiếu", soDongPhieu.ToString(), "teal", "oi-circle-check"));

        var (dueSoon, overdue) = GetDeliveryStats();
        tiles.Add(("Cần giao (sắp đến hạn)", dueSoon.ToString(), "red", "oi-warning"));
        tiles.Add(("Quá hạn giao hàng", overdue.ToString(), "dark-red", "oi-clock"));

        decimal tongTien = TblPH.Columns.Contains("t_tt")
            ? TblPH.AsEnumerable().Sum(r => r["t_tt"] == DBNull.Value ? 0 : Convert.ToDecimal(r["t_tt"]))
            : 0;
        tiles.Add(("Tổng giá trị", tongTien.ToString("N0") + " đ", "blue", "oi-bar-chart"));

        return tiles;
    }

    private (int DueSoon, int Overdue) GetDeliveryStats()
    {
        if (TblPH == null || TblCT == null) return (0, 0);
        if (!TblCT.Columns.Contains("han_gh") || !TblCT.Columns.Contains("stt_rec")
            || !TblPH.Columns.Contains("stt_rec") || !TblPH.Columns.Contains("status"))
            return (0, 0);

        // Chỉ xét các đơn đang "Lập phiếu" (status = 1), tức còn chưa hoàn tất giao hàng.
        var openSttRec = new HashSet<string>(
            TblPH.AsEnumerable()
                .Where(r => (r["status"]?.ToString() ?? "").Trim() == "1")
                .Select(r => (r["stt_rec"]?.ToString() ?? "").Trim())
                .Where(s => s.Length > 0));

        DateTime today = DateTime.Today;
        var soon = new HashSet<string>();
        var late = new HashSet<string>();
        foreach (DataRow r in TblCT.Rows)
        {
            string sttRec = (r["stt_rec"]?.ToString() ?? "").Trim();
            if (sttRec.Length == 0 || !openSttRec.Contains(sttRec)) continue;
            if (r["han_gh"] == DBNull.Value) continue;

            DateTime han = Convert.ToDateTime(r["han_gh"]).Date;
            if (han < today) late.Add(sttRec);
            else if ((han - today).TotalDays <= 7) soon.Add(sttRec);
        }
        return (soon.Count, late.Count);
    }

    protected override void OnInitialized()
    {
        Menu_id = (String.IsNullOrEmpty(Menu_id) ? "wp.ct.15" : Menu_id);
        FrmType = typeof(Input.Soddh.FrmSoddh);
        IsShowImport = true;
        LanguageID = "";
        _filter_qs = String.Format("ma_cts like '%{0}%'", "HDM");
        curUser = myStateMN.GetCurUser();
        ma_ncc = myDb.GetValue($"SELECT TOP 1 ma_kh FROM dmkh WHERE tk_portal = '{curUser.User_name.Trim()}'")?.ToString() ?? "";
        if (curUser.Is_admin != 1)
        {
            // Neu khong tim duoc ma ncc (ma_ncc rong) thi khong hien gi, tranh LIKE '%' lay tat ca.
            if (string.IsNullOrEmpty(ma_ncc.Trim()))
            {
                phFilter = "1=0";
            }
            else
            {
                phFilter = "1=1 and status2 = 1 AND ma_kh LIKE ''" + ma_ncc.Trim() + "%''";
            }
        }
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender && curCommand != null && (curUser.Is_admin == 1 || curUser.CheckRight(Menu_id.Replace("_", "."), "VIEW")))
        {
            // The base toolbar turns New/Edit/Delete/Copy on for every voucher page;
            // this page is approval-only, so rebuild it with just view/aproval actions.
            myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            myStateMN.SetToolBar(new MyToolbar("toolbar", true));
            myStateMN.SetToolBar(new MyToolbar("View", true));
            myStateMN.SetToolBar(new MyToolbar("Print", true));
            myStateMN.SetToolBar(new MyToolbar("Search", true));
            myStateMN.SetToolBar(new MyToolbar("Export", true));
            if (IsShowImport) myStateMN.SetToolBar(new MyToolbar("Import", true));
            myStateMN.SetToolBar(new MyToolbar("Aproval", true));
        }
    }

    public override void OnActionTaskchanged(ActionTask ac)
    {
        base.OnActionTaskchanged(ac);
        if (ac == ActionTask.Aproval)
        {
            V_Duyet();
        }
    }

    public virtual async void V_Duyet()
    {
        string _ma_dvcs = myStateMN.GetMa_Dvcs();
        if (String.IsNullOrWhiteSpace(_ma_dvcs) || _ma_dvcs.ToUpper().Trim() == "ALL")
        {
            myStateMN.SetNewThongbao(Lap["Please select a unit!"]);
            return;
        }

        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }

        SqlTableKeyValue = rview[SqlTableKey].ToString().Trim();

        if (rview.Row.Table.Columns.Contains("status") && rview["status"].ToString().Trim().Equals("8"))
        {
            myStateMN.SetNewThongbao(Lap["Voucher is already approved"]);
            return;
        }

        MessageDl = String.Format(Lap["Do you want to approve :{0} ?"], rview["so_ct"].ToString().Trim());
        ResultDl = await myDlSvc.ConfirmAsync(new MessageBoxOptions()
        {
            Text = MessageDl,
            Title = Lap["Confirm approval of voucher"],
            OkButtonText = Lap["OK"],
            CancelButtonText = Lap["Cancel"],
            ShowIcon = true,
            ShowCloseButton = false,
            RenderStyle = MessageBoxRenderStyle.Info,
        });

        if (ResultDl == true)
        {
            myDb.LoadDataSet($"UPDATE {M_Phdbf} SET status = '5' WHERE {SqlTableKey} = '{SqlTableKeyValue}'");
            await Loaddata(false);
            StateHasChanged();
        }
    }

    private async void BtnFilterOK()
    {
        ShowLoadding = true;

        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);
        string dvcs = myStateMN.GetMa_Dvcs();
        phFilter = "1=1";
        if (curUser.Is_admin != 1)
        {
            phFilter = phFilter + $" and (user_id = {curUser.User_id}) ";
        }

        if (!IsAdminUser)
        {
            // Không phải admin: chỉ cho tìm theo từ số/đến số/từ ngày/đến ngày, mặc định ma_kh là mã ncc của tài khoản đang đăng nhập.
            Ma_qs = "";
            Tk_i = "";
            Status = "";
            Ma_dvcs = "";
            NSD = "";
            Ma_kh = ma_ncc;
        }

        if (!string.IsNullOrEmpty(Ma_dvcs))
        {
            phFilter = phFilter + " AND ma_dvcs LIKE ''" + Ma_dvcs.Trim() + "%''";
        }
        if (string.IsNullOrEmpty(Ma_dvcs))
        {
            if (dvcs != "ALL")
            {
                phFilter = phFilter + " AND ma_dvcs LIKE ''" + dvcs.Trim() + "%''";
            }
        }
        if (Ngay_ct1 != null)
        {
            phFilter = phFilter + " AND ngay_ct >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            phFilter = phFilter + " AND ngay_ct <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }
        if (!String.IsNullOrEmpty(So_ct1))
        {
            phFilter = phFilter + " AND so_ct >= ''" + So_ct1.ToString() + "''";
        }
        if (!String.IsNullOrEmpty(So_ct2))
        {
            phFilter = phFilter + " AND so_ct <= ''" + So_ct2.ToString() + "''";
        }

        if (!String.IsNullOrEmpty(Ma_qs))
        {
            phFilter = phFilter + " AND ma_qs LIKE ''" + Ma_qs.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Status))
        {
            phFilter = phFilter + " AND status  LIKE ''" + Status.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Tk_i))
        {
            phFilter = phFilter + " AND ma_nx  LIKE ''" + Tk_i.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(NSD) && NSD.Trim().Equals("1"))
        {
            phFilter = phFilter + " AND user_id  = " + curUser.User_id + " ";
        }
        if (!String.IsNullOrEmpty(Ma_kh))
        {
            phFilter = phFilter + " AND ma_kh LIKE ''" + Ma_kh.Trim() + "%''";
        }
        await Loaddata(false);

        ShowLoadding = false;
        popFilterVisible = false;
        InvokeAsync(StateHasChanged);
    }
    public override async void V_In()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }

        DataSet DataSource = CopyVoucherToDataSet(SqlTableKeyValue);
        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<DDHModel>();
            DDHModel _curModel = new DDHModel();
            _curModel.LSPh = myDb.ConvertDataTable<Dmhdm>(DataSource.Tables[0]);
            _curModel.LSCt = myDb.ConvertDataTable<Dmhdmct>(DataSource.Tables[1]);

            MST mst = new MST();
            MST mst_kh = new MST();

            string tk_no = "";
            string tk_co = "";
            int i = 0;
            foreach (Dmhdmct ct in _curModel.LSCt)
            {
                if (!tk_no.Contains(ct.Tk_gv))
                    tk_no += ct.Tk_gv + "; ";
                if (!tk_co.Contains(ct.Tk_vt))
                    tk_co += ct.Tk_vt + "; ";
                _curModel.LSCt[i].Stt = i + 1;
                i++;

            }
            String sql = $"SELECT tk,ps_no ,ps_co FROM ct00 WHERE stt_rec = '{_curModel.LSPh[0].Stt_rec}' ";
            DataSet ds = myDb.LoadDataSet(sql);
            List<HachToan> lstHachToan = new List<HachToan>();
            decimal total_ps_no = 0;
            decimal total_ps_co = 0;
            if (ds != null && ds.Tables.Count > 0)
            {

                int stt = 0;
                foreach (DataRow dr in ds.Tables[0].Rows)
                {
                    HachToan hachToan = new HachToan();
                    hachToan.Tk = dr["tk"].ToString();
                    hachToan.Ps_no = decimal.Parse(dr["ps_no"].ToString());
                    hachToan.Ps_co = decimal.Parse(dr["ps_co"].ToString());
                    hachToan.Stt = stt;
                    hachToan.Dien_giai = _curModel.LSPh[0].Dien_giai;
                    stt++;
                    total_ps_no += hachToan.Ps_no;
                    total_ps_co += hachToan.Ps_co;
                    lstHachToan.Add(hachToan);
                }
            }
            _curModel.Tk_co = tk_co;
            _curModel.Tk_no = tk_no;
            _curModel.TotalString = DocSo.Doc_so(_curModel.LSPh[0].T_tt_nt, myOption, myDb, false);
            _curModel.T_tien_nt_String = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, false);
            _curModel.DateString = ToDateString(_curModel.LSPh[0].Ngay_ct);
            _curModel.Ten_lien = "Liên 1 : giao khách hàng";
            _curModel.So_lien = curDmct.So_lien;
            _curModel.LstHachToan = lstHachToan;
            _curModel.T_ps_co = total_ps_co;
            _curModel.T_ps_no = total_ps_no;
            _curModel.MST = TachMaSoThueVaoCacSo(myOption.GetOptionsValue("M_MA_THUE").Trim());

            LSData.Add(_curModel);
        }
        ShowReport(LSData, typeof(DDHModel));
    }
    public string ToDateString(DateTime date)
    {
        return $"ngày {date.Day} tháng {date.Month} năm {date.Year}";
    }

    private MST TachMaSoThueVaoCacSo(string MST)
    {
        // Nếu không có mã số thuế hoặc rỗng thì để trống hết
        if (string.IsNullOrWhiteSpace(MST))
        {
            return null;
        }
        MST m = new MST();
        // Đảm bảo chuỗi đủ dài (nếu MST chỉ có 10 số thì các ô sau để trống)
        string mst = MST.PadRight(14, ' '); // bổ sung khoảng trắng nếu ngắn

        m.So_1 = mst.Length >= 1 ? mst[0].ToString() : "";
        m.So_2 = mst.Length >= 2 ? mst[1].ToString() : "";
        m.So_3 = mst.Length >= 3 ? mst[2].ToString() : "";
        m.So_4 = mst.Length >= 4 ? mst[3].ToString() : "";
        m.So_5 = mst.Length >= 5 ? mst[4].ToString() : "";
        m.So_6 = mst.Length >= 6 ? mst[5].ToString() : "";
        m.So_7 = mst.Length >= 7 ? mst[6].ToString() : "";
        m.So_8 = mst.Length >= 8 ? mst[7].ToString() : "";
        m.So_9 = mst.Length >= 9 ? mst[8].ToString() : "";
        m.So_10 = mst.Length >= 10 ? mst[9].ToString() : "";
        m.So_11 = mst.Length >= 11 ? mst[10].ToString() : "";
        m.So_12 = mst.Length >= 12 ? mst[11].ToString() : "";
        m.So_13 = mst.Length >= 13 ? mst[12].ToString() : "";
        m.So_14 = mst.Length >= 14 ? mst[13].ToString() : "";

        return m;
    }

