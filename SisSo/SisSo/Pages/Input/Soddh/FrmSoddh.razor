<style>
    .disabled-grid {
        pointer-events: none;
        opacity: 0.7;
    }

    .css-header {
        height: auto;
    }

    .css-detail {
        height: 230px;
    }

    .grd-detail {
        height: 200px;
        padding: 0px;
        margin: 0px;
    }

    .css-detail .dxbl-formlayout-tabpage {
        height: 100% !important;
        display: flex;
        flex-direction: column;
        min-height: 0; /* allow children to shrink */
    }

        .css-detail .dxbl-formlayout-tabpage .dxbl-formlayout,
        .css-detail .dxbl-formlayout-tabpage .dxbl-formlayout-group {
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }

        .css-detail .dxbl-formlayout-tabpage #grid-wrapper,
        .css-detail .dxbl-formlayout-tabpage .dxbl-grid {
            flex: 1 1 auto;
            min-height: 0;
            overflow: auto;
        }

    .dxbl-fl .dxbl-fl-tab-content {
        padding: 3px 3px 3px 10px !important;
    }

    .dxbl-checkbox.dxbl-state-checked .dxbl-checkbox-check-element {
        background-color: #ccc !important;
        border-color: #ccc !important;
    }

    .text-end-custom ::deep input {
        text-align: right !important;
    }

    .toolbar-check {
        white-space: nowrap; /* Không cho xuống dòng */
        overflow-x: auto; /* Nếu màn nhỏ thì kéo ngang */
        padding-bottom: 0px;
    }

        .toolbar-check .chk {
            margin-right: 10px;
        }

    .btn-mini {
        padding: 0 6px !important;
        white-space: nowrap;
    }

    /* ===== Làm đẹp UI (dùng chung cho các phiếu) ===== */

    /* Card nhóm thông tin / tổng tiền */
    .frm-header .dxbl-fl-group.dxbl-card,
    .frm-header .dx-total-box.dxbl-card {
        border: 1px solid #e3e6ea;
        border-radius: 10px;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
        background: #fff;
    }

    /* Tiêu đề (caption) của card */
    .frm-header .dxbl-fl-group > .dxbl-fl-group-caption,
    .frm-header .dxbl-card-header {
        font-weight: 600;
        color: #344054;
        letter-spacing: 0.01em;
    }

    /* Card "Tổng" nổi bật hơn một chút */
    .dx-total-box.dxbl-card {
        background: linear-gradient(180deg, #fbfdff 0%, #f6f9fc 100%);
    }

    /* Ô số tổng tiền: canh phải, chữ đậm, màu nhấn */
    .dx-total-box .dxbl-spinedit input,
    .text-end-custom ::deep input {
        text-align: right !important;
        font-weight: 600;
        color: #1d2939;
    }

    /* Lưới chi tiết: bo góc, viền mềm */
    #grid-wrapper .dxbl-grid {
        border: 1px solid #e3e6ea;
        border-radius: 8px;
        overflow: hidden;
    }

        /* Header của lưới */
        #grid-wrapper .dxbl-grid .dxbl-grid-header-content,
        #grid-wrapper .dxbl-grid thead {
            background: #f8fafc;
            font-weight: 600;
            color: #475467;
        }

        /* Hover dòng */
        #grid-wrapper .dxbl-grid .dxbl-grid-data-row:hover > td {
            background: #f5f8ff;
        }

    /* Nút xóa dòng trên lưới */
    .grid-delete-btn .grid-icon-delete {
        color: #d92d20;
    }

    .grid-delete-btn:hover {
        background: rgba(217, 45, 32, 0.08);
        border-radius: 6px;
    }

    /* Tab chi tiết: pill đẹp hơn */
    .css-detail .dxbl-fl-tab .dxbl-fl-tab-item.dxbl-active {
        font-weight: 600;
    }
</style>

