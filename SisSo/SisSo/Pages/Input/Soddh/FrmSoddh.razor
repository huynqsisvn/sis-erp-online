    private void PhanBoThueInCT_CBTien()
    {
        try
        {
            if (!LSCt.Any()) return;

            decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;

            // Các tổng thuế và tiền ở header
            decimal t_thue_nt = CurPh.T_thue_nt;
            decimal t_thue = CurPh.T_thue;
            decimal T_tien_nt = CurPh.T_tien_nt;
            decimal T_tien = CurPh.T_tien;
            decimal t_thue_km_nt = CurPh.T_thue_km_nt;
            decimal t_thue_km = CurPh.T_thue_km;

            // Cơ sở tính thuế (trước hay sau chiết khấu)
         
            // === Bước 1: Điều chỉnh tiền làm tròn (nếu có sai số do làm tròn tỷ giá) ===
            bool daDieuChinhTien = false;
            bool daDieuChinhTienKm = false;

            foreach (var row in LSCt)
            {
                if (row.Tien_nt != 0 && row.Tien != 0)
                {
                    // Điều chỉnh tiền VND nếu có sai số làm tròn tỷ giá
                    if (!daDieuChinhTien && row.Km_ck == "0")
                    {
                        row.Tien += (T_tien - Math.Round(T_tien_nt * ty_gia, M_ROUND));
                        daDieuChinhTien = true;
                    }
                    
                }
            }

            // === Bước 2: Phân bổ thuế cho từng dòng ===
            int firstNormalRow = -1;   // dòng đầu tiên không phải KM
            int firstKmRow = -1;   // dòng đầu tiên là KM

            decimal tongThueNormal = 0m;
            decimal tongThueNormalNt = 0m;
            decimal tongThueKm = 0m;
            decimal tongThueKmNt = 0m;

            // === Bước 3: Bù trừ sai số làm tròn (gán vào dòng đầu tiên) ===
            if (firstNormalRow != -1)
            {
                if (t_thue != tongThueNormal)
                    LSCt[firstNormalRow].Thue += (t_thue - tongThueNormal);
                if (t_thue_nt != tongThueNormalNt)
                    LSCt[firstNormalRow].Thue_nt += (t_thue_nt - tongThueNormalNt);
            }

            if (firstKmRow != -1)
            {
                if (t_thue_km != tongThueKm)
                    LSCt[firstKmRow].Thue += (t_thue_km - tongThueKm);
                if (t_thue_km_nt != tongThueKmNt)
                    LSCt[firstKmRow].Thue_nt += (t_thue_km_nt - tongThueKmNt);
            }

            // Refresh UI
            StateHasChanged();
        }
        catch (Exception ex)
        {

        }
    }
    public DataSet CheckData(int mode)
    {
        string format = "exec [dbo].{0} @status, @mode, @stt_rec;";
        string[] Check_Valid_Store = (curDmct == null ? "" : curDmct.Check_valid_store.Trim()).Split("|");
        string sqlcmd = (Check_Valid_Store == null || Check_Valid_Store.Length <= 8) ? string.Format(format, (object)"[Socthda-CheckData]") : string.Format(format, (object)Check_Valid_Store[8]);
        DataSet dsResult = myDb.LoadDataSet(sqlcmd, new Dictionary<string, object>
        {
            ["@status"] = CurPh.Status,
            ["@mode"] = mode,
            ["@stt_rec"] = CurPh.Stt_rec
        });
        return dsResult;
    }

