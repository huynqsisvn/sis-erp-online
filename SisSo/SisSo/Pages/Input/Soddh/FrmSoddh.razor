            if (selectedDataItemCT != null && string.IsNullOrWhiteSpace(((Dmhdmct)selectedDataItemCT).Ma_vt))
            {
                isBlockingCT = true;
                myStateMN.SetNewThongbao(Lap["Code cannot be empty"] + "!");
                _ = InvokeAsync(async () =>
                {
                    if (GridCT.IsEditing()) // nếu đang edit dòng hiện tại
                    {
                        await GridCT.SaveChangesAsync();
                    }
                    await Task.Yield();
                    await GridCT.StartEditDataItemAsync(LSCt.IndexOf((Dmhdmct)selectedDataItemCT), "Ma_vt");
                    isBlockingCT = false;
                });

                return;
            }
            selectedDataItemCT = value;
        }
    }
