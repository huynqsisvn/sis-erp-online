                        // Tính chiết khấu theo tỷ lệ (nếu có)
                        if (CurrentEditModel.Tl_ck > 0)
                        {
                            decimal ck_nt = Math.Round(CurrentEditModel.Tien_nt * CurrentEditModel.Tl_ck / 100m, M_ROUND_NT);
                            CurrentEditModel.Ck_nt = ck_nt;
                            CurPh.T_ck_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck_nt) + ck_nt;

                            decimal ck = Math.Round(ck_nt * ty_gia, M_ROUND);
                            if (ck != 0)
                            {
                                CurrentEditModel.Ck = ck;
                                CurPh.T_ck = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck) + ck;

                            }
                        }
                        if (CurrentEditModel.Pt_km > 0)
                        {
                            decimal co_so = CurrentEditModel.Tien_nt - CurrentEditModel.Ck_nt;
                            decimal km_nt = Math.Round(co_so * CurrentEditModel.Pt_km / 100m, M_ROUND_NT);
                            CurrentEditModel.Tien_km_nt = km_nt;
                            CurPh.Tien_km_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_km_nt) + km_nt;

                            decimal km = Math.Round(km_nt * ty_gia, M_ROUND);
                            if (km != 0)
                            {
                                CurrentEditModel.Tien_km = km;
                                CurPh.Tien_km = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_km) + km;

                            }
                        }
                        else
                        {
                            CurrentEditModel.Ck_nt = 0;
                            CurrentEditModel.Ck = 0;
                        }
                        CurPh.T_tien_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt) + CurrentEditModel.Tien_nt;
                        // Quy đổi tiền sang VND
                        CurrentEditModel.Tien = Math.Round(CurrentEditModel.Tien_nt * ty_gia, M_ROUND);
                        CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien) + CurrentEditModel.Tien;

                        if (isVND)
                        {
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurrentEditModel.Ck = CurrentEditModel.Ck_nt;
                            CurrentEditModel.Tien_km = CurrentEditModel.Tien_km_nt;
                            CurPh.T_tien = CurPh.T_tien_nt;
                            CurPh.T_ck = CurPh.T_ck_nt;
                            CurPh.T_tien_km = CurPh.T_tien_km_nt;

                        }
                        if (CurrentEditModel.Km_ck == "1")
                        {
                            this.UpdateKM();
                        } *@
                        this.UpdateTotalHT();

                        // Refresh UI
                        StateHasChanged();
                        break;
                    }

                case "gia_nt":
                    {
                        // Lấy giá trị mới người dùng nhập
                        CurrentEditModel.Gia_nt = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        // Quy đổi đơn giá sang VND
                        decimal gia = Math.Round(CurrentEditModel.Gia_nt * ty_gia, M_ROUND_GIA);
                        if (CurrentEditModel.So_luong != 0 && gia != 0)
                            CurrentEditModel.Gia = gia;


                        decimal tien_nt = Math.Round(CurrentEditModel.So_luong * CurrentEditModel.Gia_nt, M_ROUND_NT);
                        if (tien_nt != 0)
                        {
                            CurrentEditModel.Tien_nt = tien_nt;
                            CurPh.T_tien_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt) + CurrentEditModel.Tien_nt;
                        }

                        // Quy đổi tiền sang VND
                        decimal tien = Math.Round(CurrentEditModel.Tien_nt * ty_gia, M_ROUND);
                        if (tien != 0)
                        {
                            CurrentEditModel.Tien = tien;
                            CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien) + CurrentEditModel.Tien;
                        }

                        // Nếu chứng từ là VND → đồng bộ toàn bộ giá và tiền
                        if (isVND)
                        {
                            CurrentEditModel.Gia = CurrentEditModel.Gia_nt;
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurPh.T_tien = CurPh.T_tien_nt;
                        }
                        this.UpdateTotalHT();


                        // Refresh UI
                        StateHasChanged();
                        break;
                    }
                case "tien_nt":
                    {
                        // Lấy giá trị mới người dùng nhập
                        CurrentEditModel.Tien_nt = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        // Cập nhật tổng tiền nguyên tệ lên header (loại trừ dòng khuyến mại)
                        CurPh.T_tien_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt) + CurrentEditModel.Tien_nt;

                        // Quy đổi tiền sang VND
                        decimal tien = Math.Round(CurrentEditModel.Tien_nt * ty_gia, M_ROUND);
                        if (tien != 0)
                        {
                            CurrentEditModel.Tien = tien;
                            CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien) + CurrentEditModel.Tien;
                        }
                        else
                        {
                            CurrentEditModel.Tien = 0;
                        }

                        // Nếu chứng từ là VND → đồng bộ hoàn toàn
                        if (isVND)
                        {
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurPh.T_tien = CurPh.T_tien_nt;
                        }

                        // Không cần tính lại chiết khấu hay khuyến mại ở đây (theo code WinForm gốc không có)
                        this.UpdateTotalHT();

                        // Refresh UI
                        StateHasChanged();
                        break;
                    }
            
                case "ck_nt":
                    {
                        // Lấy giá trị chiết khấu nguyên tệ mới
                        CurrentEditModel.Ck_nt = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        // Cập nhật tổng chiết khấu nguyên tệ lên header (loại trừ dòng khuyến mại)
                        // CurPh.T_ck_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Ck_nt) + CurrentEditModel.Ck_nt;

                        // Quy đổi chiết khấu sang VND
                        decimal ck = Math.Round(CurrentEditModel.Ck_nt * ty_gia, M_ROUND);
                        if (ck != 0)
                        {
                            CurrentEditModel.Ck = ck;
                            // CurPh.T_ck = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Ck) + CurrentEditModel.Ck;
                        }
                        else
                        {
                            CurrentEditModel.Ck = 0;
                            // Nếu ck = 0 thì tổng cũng sẽ được cập nhật đúng ở trên (do cộng 0)
                        }
                        string ma_thue = CurrentEditModel.Ma_thue;
                        decimal thue_nt = CurrentEditModel.Thue_nt;
                        decimal Tien_nt = CurrentEditModel.Tien_nt;
                        decimal thue = CurrentEditModel.Thue;
                        decimal Tien = CurrentEditModel.Tien;
                        Tien_nt = Tien_nt - newvalue;
                        Tien = Tien - ck;

                        if (!string.IsNullOrEmpty(ma_thue))
                        {
                            decimal thue_suat = CurrentEditModel.Thue_suat;
                            thue_nt = Math.Round(Tien_nt * thue_suat / 100, M_ROUND);
                            CurrentEditModel.Thue_nt = thue_nt;
                            @* CurrentEditModel.Tien_nt = Tien_nt - newvalue - thue_nt; *@

                            thue = Math.Round(Tien * thue_suat / 100, M_ROUND);
                            CurrentEditModel.Thue = thue;
                            Tien = Tien - thue;
                            Tien_nt = Tien_nt - thue_nt;
                            @* CurrentEditModel.Tien = Tien - ck - thue; *@
                        }

                        decimal pt_km = CurrentEditModel.Pt_km;
                        if (pt_km > 0)
                        {
                            decimal km = Math.Round(Tien * pt_km / 100, M_ROUND);
                            decimal km_nt = Math.Round(Tien_nt * pt_km / 100, M_ROUND_NT);
                            CurrentEditModel.Tien_km = km;
                            CurrentEditModel.Tien_km_nt = km_nt;

                        }

                        // Nếu chứng từ là VND → đồng bộ hoàn toàn
                        if (isVND)
                        {
                            CurrentEditModel.Ck = CurrentEditModel.Ck_nt;
                            CurrentEditModel.Thue = CurrentEditModel.Thue_nt;

                            CurPh.T_ck = CurPh.T_ck_nt;
                        }
                        this.UpdateTotalHT();

                        // Refresh UI
                        StateHasChanged();
                        break;
                    }
                case "ck":
                    {
                        CurrentEditModel.Ck = newvalue;
                        string ma_thue = CurrentEditModel.Ma_thue;

                        decimal thue = CurrentEditModel.Thue;
                        decimal Tien = CurrentEditModel.Tien;
                        Tien = Tien - newvalue;

                        if (!string.IsNullOrEmpty(ma_thue))
                        {
                            decimal thue_suat = CurrentEditModel.Thue_suat;

                            thue = Math.Round(Tien * thue_suat / 100, M_ROUND);
                            CurrentEditModel.Thue = thue;
@*                             Tien = Tien - km;
 *@                            @* CurrentEditModel.Tien = Tien - newvalue - thue; *@
                        }

                        decimal pt_km = CurrentEditModel.Pt_km;
                        if (pt_km > 0)
                        {
                            decimal km = Math.Round(Tien * pt_km / 100, M_ROUND);
                            CurrentEditModel.Tien_km = km;

                        }

                        CurPh.T_ck = LSCt.Where(x => x.Ck == 0 && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck) + newvalue;
                        this.UpdateTotalHT();

                        break;

                    }
                case "pt_km":
                    {
                        // Lấy giá trị phần trăm khuyến mại mới
                        CurrentEditModel.Pt_km = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        if (CurrentEditModel.Pt_km != 0)
                        {
                            // Khi nhập % khuyến mại thì tự động bỏ chọn km_ck (chiết khấu theo tài khoản)
                            CurrentEditModel.Km_ck = "0";

                            // Cơ sở tính KM = tiền_nt2 trừ đi chiết khấu dòng (nếu có)
                            decimal co_so = CurrentEditModel.Tien_nt - CurrentEditModel.Ck_nt - CurrentEditModel.Thue_nt;

                            decimal tien_km_nt = Math.Round(co_so * CurrentEditModel.Pt_km / 100m, M_ROUND_NT);
                            CurrentEditModel.Tien_km_nt = tien_km_nt;   // nếu bạn có trường này
                            CurrentEditModel.Tien_km = tien_km_nt;   // tạm lưu NT trước

                            // Quy đổi sang VND
                            decimal tien_km = Math.Round(tien_km_nt * ty_gia, M_ROUND);
                            if (tien_km != 0)
                                CurrentEditModel.Tien_km = tien_km;
                        }
                        else
                        {
                            // Nếu % KM = 0 → xóa tiền khuyến mại
                            CurrentEditModel.Tien_km_nt = 0;
                            CurrentEditModel.Tien_km = 0;
                        }

                        this.UpdateTotalHT();



                        // Refresh UI
                        StateHasChanged();
                        break;
                    }
               
                case "Tien":
                    {
                        CurrentEditModel.Tien = newvalue;
                        CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien) + newvalue;
                        this.UpdateTotalHT();

                        break;

                    }
                case "tien":
                    {
                        CurrentEditModel.Tien = newvalue;
                        CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien) + newvalue;
                        this.UpdateTotalHT();

                        break;
                    }

                case "thue_suat":
                    {

                        Decimal T_tien_nt = CurrentEditModel.Tien_nt - CurrentEditModel.Ck_nt;
                        Decimal T_tien = CurrentEditModel.Tien - CurrentEditModel.Ck;
                        Decimal thue_suat = CurrentEditModel.Thue_suat = newvalue;
                        Decimal num0 = T_tien_nt * (thue_suat / 100) * CurPh.Ty_gia;
                        Decimal num1 = T_tien * (thue_suat / 100) * CurPh.Ty_gia;

                        if (num0 != 0)
                        {
                            CurrentEditModel.Thue_nt = num0;
                            @* CurrentEditModel.T_tt_nt = num0 + T_tien_nt; *@
                        }
                        if (num1 != 0)
                        {
                            CurrentEditModel.Thue = num1;
                            @* CurrentEditModel.T_tt = num1 + T_tien; *@
                        }
                        if (!NotMaNt0Voucher)
                        {
                            CurrentEditModel.Thue = CurrentEditModel.Thue_nt;
                            @* CurrentEditModel.T_tt = CurrentEditModel.T_tt_nt; *@

                        }
                        decimal Tien = CurrentEditModel.Tien - CurrentEditModel.Ck - CurrentEditModel.Thue;
                        decimal Tien_nt = CurrentEditModel.Tien - CurrentEditModel.Ck - CurrentEditModel.Thue;

                        decimal pt_km = CurrentEditModel.Pt_km;
                        if (pt_km > 0)
                        {
                            decimal km = Math.Round(Tien * pt_km / 100, M_ROUND);
                            decimal km_nt = Math.Round(Tien_nt * pt_km / 100, M_ROUND_NT);
                            CurrentEditModel.Tien_km = km;
                            CurrentEditModel.Tien_km_nt = km_nt;

                        }
                        this.UpdateTotalHT();

                        break;
                    }
              
                case "thue":
                    {
                        CurrentEditModel.Thue = newvalue;
                        Decimal T_tien = CurrentEditModel.Tien - CurrentEditModel.Ck;
                        Decimal t_thue = newvalue;
                        if (t_thue == 0)
                        {
                            Decimal thue_suat = CurrentEditModel.Thue_suat;
                            t_thue = T_tien * thue_suat / 100;
                            CurrentEditModel.Thue = t_thue;
                        }
                        @* CurrentEditModel.T_tt = T_tien + t_thue - CurrentEditModel.Ck; *@
                        decimal Tien = CurrentEditModel.Tien - CurrentEditModel.Ck - CurrentEditModel.Thue;

                        decimal pt_km = CurrentEditModel.Pt_km;
                        if (pt_km > 0)
                        {
                            decimal km = Math.Round(Tien * pt_km / 100, M_ROUND);
                            CurrentEditModel.Tien_km = km;

                        }
                        this.UpdateTotalHT();
                        break;

                    }


            }
        }
        // PreSum_All();
    }
    async void OnGridCT_DMDM_Changed(ExpandoObject value, string ma_dm)
    {
        if (value == null)
            return;
        switch (ma_dm.ToLower())
        {
            case "ma_vt":
                {
                    CurrentEditModel.Ma_vt = value.Where(a => a.Key.Equals("ma_vt")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt")).FirstOrDefault().Value?.ToString() ?? "";
                    @* CurrentEditModel.Tk_km_i = value.Where(a => a.Key.Equals("tk_km")).FirstOrDefault().Value?.ToString() ?? ""; *@
                    CurrentEditModel.Tk_vt = value.Where(a => a.Key.Equals("tk_vt")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Tk_gv = value.Where(a => a.Key.Equals("tk_gv")).FirstOrDefault().Value?.ToString() ?? "";
                    _filter_dvt = String.Format(" ma_vt = '{0}'", CurrentEditModel.Ma_vt);
                    object heso = myDb.GetValue("select hs_qd from v_dmvtdvt where ma_vt = '" + CurrentEditModel.Ma_vt.Trim() + "' AND dvt1=N'" + (CurrentEditModel.Dvt1?.Trim() ?? "") + "'");

                    if (heso != null && heso != DBNull.Value && decimal.TryParse(heso.ToString(), out decimal parsedHeso))
                    {
                        CurrentEditModel.He_so1 = parsedHeso;
                    }
                    else
                    {
                        CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt")).FirstOrDefault().Value?.ToString() ?? "";
                        CurrentEditModel.He_so1 = 1;
                    }

                    string _vt_tk = value.Where(a => a.Key.Equals("vt_ton_kho")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Vt_ton_kho = string.IsNullOrEmpty(_vt_tk) ? 0 : decimal.Parse(_vt_tk);

                    if (CurrentEditModel.Vt_ton_kho == 0)
                    {
                        CurrentEditModel.So_luong = 0;
                        CurrentEditModel.Gia_nt = CurrentEditModel.Gia = 0;
                        CurrentEditModel.Gia_nt = CurrentEditModel.Gia = 0;
                        CurrentEditModel.Tien_nt = CurrentEditModel.Tien = 0;
                        CurrentEditModel.Tien_nt = CurrentEditModel.Tien = 0;
                    }

                    if (!string.IsNullOrEmpty(CurPh.Ma_dvcs))
                    {
                        string sql = string.Format("select top(1) ma_px from [cosxlt-dmdmvt] where ma_sp = '{0}' ", CurrentEditModel.Ma_vt.Trim());
                        DataSet _ds = await myDb.LoadDataset(sql);
                        DataTable tblMaPX = _ds.Tables[0];
                        if (tblMaPX.Rows.Count != 0)
                        {
                            CurrentEditModel.Ma_px_i = tblMaPX.Rows[0]["ma_px"].ToString();
                        }
                    }
                    if (CurPh.Ngay_ct != new DateTime())
                    {
                        DataRow dataRow = GetdmGia(CurrentEditModel.Ma_vt.Trim(), string.Format("{0:yyyyMMdd}", CurPh.Ngay_ct), CurPh.Nh_kh3);
                        if (dataRow != null)
                        {
                            CurrentEditModel.Gia_nt = !CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim()) ? decimal.Parse(dataRow["Gia_nt"].ToString()) : decimal.Parse(dataRow["Gia"].ToString());
                            CurrentEditModel.Gia = decimal.Parse(dataRow["Gia"].ToString());
                        }
                    }

                    if (CurrentEditModel.Vt_ton_kho == 1)
                    {
                        if (M_QL_LO_CK.ToString().Trim() != "1")
                        {
                            CurrentEditModel.Ton13 = GetTon13(CurrentEditModel.Ma_kho_i, CurrentEditModel.Ma_vt.Trim(), CurrentEditModel.Ma_vv_i);
                        }
                        else
                        {
                        }
                    }
                    else
                        CurrentEditModel.Ton13 = 0;
                    StateHasChanged();
                    break;
                }
            case "dvt1":
                CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt1")).FirstOrDefault().Value?.ToString() ?? "";
                var hs_qd = value.Where(a => a.Key.Equals("hs_qd")).FirstOrDefault().Value?.ToString() ?? "" ?? "0";
                CurrentEditModel.He_so1 = decimal.TryParse(hs_qd, out var hs) ? hs : 0m;
                StateHasChanged();
                break;
            @* case "tk_km_i":
                CurrentEditModel.Tk_km_i = value.Where(a => a.Key.Equals("tk")).FirstOrDefault().Value?.ToString() ?? "";
                if (string.IsNullOrEmpty(CurrentEditModel.Tk_gv))
                    CurrentEditModel.Tk_gv = CurrentEditModel.Tk_km_i;
                break; *@

            case "ma_kho_i":
                CurrentEditModel.Ma_kho_i = value.Where(a => a.Key.Equals("ma_kho")).FirstOrDefault().Value?.ToString() ?? "";
                if (value.Where(a => a.Key.Equals("tk_dl")).FirstOrDefault().Value?.ToString().Trim() != "")
                {
                    CurrentEditModel.Tk_vt = value.Where(a => a.Key.Equals("tk_dl")).FirstOrDefault().Value?.ToString() ?? "";
                }
                if (CurrentEditModel.Vt_ton_kho == 1)
                {
                    if (CurrentEditModel.Ma_vt != "" && CurrentEditModel.Ma_kho_i != "")
                    {
                        CurrentEditModel.Ton13 = GetTon13(CurrentEditModel.Ma_kho_i, CurrentEditModel.Ma_vt.Trim(), CurrentEditModel.Ma_vv_i);
                    }

                }
                else
                    CurrentEditModel.Ton13 = 0;

                break;

            case "ma_lo":
                CurrentEditModel.Han_sd_lot = DateTime.TryParse(value.Where(a => a.Key.Equals("ngay_hh")).FirstOrDefault().Value?.ToString() ?? "", out var han_sd) ? han_sd : (DateTime?)null;
                if (CurrentEditModel.Vt_ton_kho == 1)
                {
                    if (CurrentEditModel.Ma_vt != "" && CurrentEditModel.Ma_kho_i != "")
                    {
                        if (M_QL_LO_CK.ToString().Trim() != "1")
                        {
                            CurrentEditModel.Ton13 = GetTon13(CurrentEditModel.Ma_kho_i, CurrentEditModel.Ma_vt.Trim(), CurrentEditModel.Ma_vv_i);
                        }
                        else
                        {
                        }
                    }

                }
                else
                    CurrentEditModel.Ton13 = 0;
                break;
            case "ma_thue":
                {
                    CurrentEditModel.Ma_thue = (value.Where(a => a.Key.Equals("ma_thue")).FirstOrDefault().Value.ToString());
                    CurrentEditModel.Thue_suat = decimal.Parse(value.Where(a => a.Key.Equals("thue_suat")).FirstOrDefault().Value.ToString());
                    CurPh.Tk_thue_no = value.Where(a => a.Key.Equals("tk_thue_no")).FirstOrDefault().Value.ToString();
                    Decimal num7 = CurrentEditModel.Tien_nt - CurrentEditModel.Ck_nt;
                    Decimal num8 = CurrentEditModel.Tien - CurrentEditModel.Ck;
                    Decimal num9 = CurrentEditModel.Thue_suat;
                    Decimal num2 = new Decimal(0);
                    Decimal num10 = Converts.Round(num7 * (num9 / 100), M_IP_TIEN_NT);
                    CurrentEditModel.Thue_nt = num10;
                    @* CurrentEditModel.T_tt_nt = (num7 + num10); *@

                    Decimal num11 = Converts.Round(num8 * num9 / 100, M_IP_TIEN);
                    CurrentEditModel.Thue = num11;
                    @* CurrentEditModel.T_tt = (num8 + num11); *@

                    if (!NotMaNt0Voucher)
                    {
                        CurrentEditModel.Thue = CurrentEditModel.Thue_nt;
                        @* CurrentEditModel.T_tt = CurrentEditModel.T_tt_nt; *@
                    }
                    decimal Tien = CurrentEditModel.Tien - CurrentEditModel.Ck - CurrentEditModel.Thue;
                    decimal Tien_nt = CurrentEditModel.Tien_nt - CurrentEditModel.Ck_nt - CurrentEditModel.Thue_nt;

                    decimal pt_km = CurrentEditModel.Pt_km;
                    if (pt_km > 0)
                    {
                        decimal km = Math.Round(Tien * pt_km / 100, M_ROUND);
                        decimal km_nt = Math.Round(Tien_nt * pt_km / 100, M_ROUND_NT);
                        CurrentEditModel.Tien_km = km;
                        CurrentEditModel.Tien_km_nt = km_nt;
                        Tien = Tien - km;
                        Tien_nt = Tien_nt - km_nt;

                    }
                    this.UpdateTotalHT();
                    StateHasChanged();

                    break;

                }
        
            case "tk_gv":
                {
                    CurrentEditModel.Tk_gv = value.Where(a => a.Key.Equals("tk")).FirstOrDefault().Value?.ToString() ?? "";
                    break;

                }
            case "tk_vt":
                {
                    CurrentEditModel.Tk_vt = value.Where(a => a.Key.Equals("tk")).FirstOrDefault().Value?.ToString() ?? "";
                    break;

                }

     
        }
