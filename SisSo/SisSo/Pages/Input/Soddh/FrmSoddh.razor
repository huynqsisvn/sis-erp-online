    private async void OnPrint()
    {
        DataSet DataSource = CopyVoucherToDataSet(Stt_rec);
        string tk_no = "";
        string tk_co = "";
        int i = 0;
        foreach (Dmhdmct ct in LSCt)
        {
            if (!tk_no.Contains(ct.Tk_gv))
                tk_no += ct.Tk_gv + "; ";
            if (!tk_co.Contains(ct.Tk_vt))
                tk_co += ct.Tk_vt + "; ";
            LSCt[i].Stt = i + 1;
            i++;
        }

        String sql = $"SELECT tk,ps_no ,ps_co AS ps_co FROM ct00 WHERE stt_rec = '{CurPh.Stt_rec}'";
        DataSet ds = myDb.LoadDataSet(sql);
        List<HachToan> lstHachToan = new List<HachToan>();
        decimal total_ps_no = 0;
        decimal total_ps_co = 0;
        if (ds != null && ds.Tables.Count > 0)
        {

            int stt = 0;
            foreach (DataRow dr in ds.Tables[0].Rows)
            {
                HachToan hachToan = new HachToan();
                hachToan.Tk = dr["tk"].ToString();
                hachToan.Ps_no = decimal.Parse(dr["ps_no"].ToString());
                hachToan.Ps_co = decimal.Parse(dr["ps_co"].ToString());
                hachToan.Stt = stt;
                hachToan.Dien_giai = CurPh.Dien_giai;
                stt++;
                total_ps_no += hachToan.Ps_no;
                total_ps_co += hachToan.Ps_co;
                lstHachToan.Add(hachToan);
            }
        }

        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<DDHModel>();
            DDHModel _curModel = new DDHModel();
            _curModel.LSPh = myDb.ConvertDataTable<Dmhdm>(DataSource.Tables[0]);
            _curModel.LSCt = myDb.ConvertDataTable<Dmhdmct>(DataSource.Tables[1]);
            _curModel.TotalString = DocSo.Doc_so(CurPh.T_tt_nt, myOption, myDb, false);
            _curModel.T_tien_nt_String = DocSo.Doc_so(CurPh.T_tien_nt, myOption, myDb, false);
            _curModel.T_tien_nt_String = DocSo.Doc_so(CurPh.T_tien_nt, myOption, myDb, false);
            _curModel.DateString = ToDateString(CurPh.Ngay_ct);
            _curModel.Tk_co = tk_co;
            _curModel.Tk_no = tk_no;
            _curModel.LstHachToan = lstHachToan;
            _curModel.Ten_lien = "Liên 1 : giao khách hàng";
            _curModel.So_lien = curDmct.So_lien;
            _curModel.T_ps_co = total_ps_co;
            _curModel.T_ps_no = total_ps_no;
            _curModel.MST = TachMaSoThueVaoCacSo(myOption.GetOptionsValue("M_MA_THUE").Trim());
            LSData.Add(_curModel);
        }
        IsShowVoucher = false;
        StateHasChanged();
    }

    private MST TachMaSoThueVaoCacSo(string MST)
    {
        // Nếu không có mã số thuế hoặc rỗng thì để trống hết
        if (string.IsNullOrWhiteSpace(MST))
        {
            return null;
        }
        MST m = new MST();
        // Đảm bảo chuỗi đủ dài (nếu MST chỉ có 10 số thì các ô sau để trống)
        string mst = MST.PadRight(14, ' '); // bổ sung khoảng trắng nếu ngắn

        m.So_1 = mst.Length >= 1 ? mst[0].ToString() : "";
        m.So_2 = mst.Length >= 2 ? mst[1].ToString() : "";
        m.So_3 = mst.Length >= 3 ? mst[2].ToString() : "";
        m.So_4 = mst.Length >= 4 ? mst[3].ToString() : "";
        m.So_5 = mst.Length >= 5 ? mst[4].ToString() : "";
        m.So_6 = mst.Length >= 6 ? mst[5].ToString() : "";
        m.So_7 = mst.Length >= 7 ? mst[6].ToString() : "";
        m.So_8 = mst.Length >= 8 ? mst[7].ToString() : "";
        m.So_9 = mst.Length >= 9 ? mst[8].ToString() : "";
        m.So_10 = mst.Length >= 10 ? mst[9].ToString() : "";
        m.So_11 = mst.Length >= 11 ? mst[10].ToString() : "";
        m.So_12 = mst.Length >= 12 ? mst[11].ToString() : "";
        m.So_13 = mst.Length >= 13 ? mst[12].ToString() : "";
        m.So_14 = mst.Length >= 14 ? mst[13].ToString() : "";

        return m;
    }

