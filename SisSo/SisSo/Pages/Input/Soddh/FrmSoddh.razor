    bool IsVisibleGridColumn(string fieldName)
    {
        if (fieldName is "Gia" or "Tien" or "Gia" or "Tien" or "Ck" or "Tien_km")
        {
            if (!NotMaNt0Voucher)
                return false;                    // Không phải ngoại tệ → ẩn luôn
        }

        // Các trường khác vẫn theo quy tắc cũ
        if (!FieldBlockConfig.ContainsKey(fieldName))
            return true; // không cấu hình -> cho phép

        // Có cấu hình → ẩn nếu mẫu hiện tại nằm trong danh sách block
        return !FieldBlockConfig[fieldName].Contains(Stt_mau_temlate);
    }

    void UpdateTotalChkSua_tien()
    {
        if (LSCt == null || LSCt.Count == 0)
            return;

        decimal tyGia = CurPh.Ty_gia;

        foreach (var ct in LSCt)
        {
            decimal soLuong = ct.So_luong;
            decimal giaNt2 = ct.Gia_nt;
            decimal giaNt = ct.Gia_nt;
            // decimal tlCk = ct.Tl_ck; // Tl_ck field removed from Dmhdmct
            decimal ptKm = ct.Pt_km;

            if (soLuong != 0)
            {
                // --- TÍNH TIỀN NT2 ---
                if (giaNt2 != 0)
                {
                    ct.Tien_nt = Math.Round(soLuong * giaNt2, M_ROUND_NT);

                    // --- TÍNH CHIẾT KHẤU ---
                    /* if (tlCk != 0)
                    {
                        ct.Ck_nt = Math.Round(ct.Tien_nt * tlCk / 100, M_ROUND_NT);

                        decimal ck = Math.Round(ct.Ck_nt * tyGia, M_ROUND);
                        if (ck != 0)
                            ct.Ck = ck;
                    } */
                    if (ptKm != 0)
                    {
                        decimal co_so = ct.Tien_nt - ct.Ck_nt;
                        ct.Tien_km_nt = Math.Round(co_so * ptKm / 100, M_ROUND_NT);

                        decimal km = Math.Round(ct.Tien_km_nt * tyGia, M_ROUND);
                        if (km != 0)
                            ct.Tien_km = km;
                    }
                }

                // --- TÍNH TIỀN NT ---
                if (giaNt != 0)
                {
                    ct.Tien_nt = Math.Round(soLuong * giaNt, M_ROUND_NT);
                }
            }
            if (CurrentEditModel != null && ct.Stt_rec0 == CurrentEditModel.Stt_rec0)
            {
                CurrentEditModel.Tien_km = ct.Tien_km;
                CurrentEditModel.Tien_km_nt = ct.Tien_km_nt;
                CurrentEditModel.Ck_nt = ct.Ck_nt;
                CurrentEditModel.Ck = ct.Ck;

            }

        }

        // --- TÍNH TỔNG HEADER ---
        // CurPh.T_tien_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_nt); // Km_ck field removed from Dmhdmct
