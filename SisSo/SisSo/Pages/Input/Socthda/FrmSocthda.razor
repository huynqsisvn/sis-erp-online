    private async Task TyGiaValueChanged(bool isMaNtChanged)
    {
        if (curActionTask == ActionTask.Delete || curActionTask == ActionTask.View)
            return;

        decimal tyGia = CurPh.Ty_gia;
        decimal suaTien = CurPh.Sua_tien;
        decimal thueSuat = CurPh.Thue_suat;

        if (tyGia == 0 || (suaTien != 0 && !isMaNtChanged))
            return;

        UpdateTotal("ck", "ck_nt", false);
        UpdateTotal("gia2", "gia_nt2", true);
        UpdateTotal("tien2", "tien_nt2", false);
        UpdateTotal("gia", "gia_nt", true);
        UpdateTotal("tien", "tien_nt", false);
        UpdateTotalKM("tien_km", "tien_km_nt", false);

        // Tính tổng
        CurPh.T_tien_km = LSCt.Where(x => x.Km_ck == "1").Sum(a => a.Tien2);

        if (CurPh.Tinh_ck == 1)
            CurPh.T_thue_km = Math.Round(CurPh.T_tien_km * thueSuat / 100, M_ROUND);

        // Tiền KM ngoại tệ
        if (CurPh.Ma_nt.Trim() != M_ma_nt0.Trim())
        {
            CurPh.Tien_km = Math.Round(CurPh.Tien_km_nt / tyGia, M_ROUND_NT);
        }
        CurPh.T_tien2 = LSCt.Where(x => x.Km_ck == "0").Sum(a => a.Tien2);
        CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0").Sum(a => a.Tien);
        CurPh.T_ck = LSCt.Where(x => x.Km_ck == "0").Sum(a => a.Ck) + LSCt.Where(x => x.Km_ck == "0").Sum(a => a.Tien_km);
        CurPh.T_ck_nt = LSCt.Where(x => x.Km_ck == "0").Sum(a => a.Ck_nt) + LSCt.Where(x => x.Km_ck == "0").Sum(a => a.Tien_km_nt);

        await InvokeAsync(StateHasChanged);
    }

    private void UpdateTotal(string column, string columnNt, bool isPrice)
    {
        decimal tyGia = CurPh.Ty_gia;
        bool isLocalCurrency = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

        foreach (var ct in LSCt)
        {
            decimal ck_nt = ct.Ck_nt;
            decimal gia_nt2 = ct.Gia_nt2;
            decimal tien_nt2 = ct.Tien_nt2;
            decimal gia_nt = ct.Gia_nt;
            decimal tien_nt = ct.Tien_nt;


            if (isLocalCurrency)
            {
                ct.Ck = ck_nt;
                ct.Gia2 = gia_nt2;
                ct.Tien2 = tien_nt2;
                ct.Gia = gia_nt;
                ct.Tien = tien_nt;
            }
            else
            {
                decimal ck = Math.Round(ck_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                decimal gia2 = Math.Round(gia_nt2 * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                decimal tien2 = Math.Round(tien_nt2 * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                decimal gia = Math.Round(gia_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                decimal tien = Math.Round(tien_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);


                if (ck != 0) ct.Ck = ck;
                if (gia2 != 0) ct.Gia2 = gia2;
                if (tien2 != 0) ct.Tien2 = tien2;
                if (gia != 0) ct.Gia = gia;
                if (tien != 0) ct.Tien = tien;
            }
        }
    }
    private void UpdateTotalKM(string column, string columnNt, bool isPrice)
    {
        decimal tyGia = CurPh.Ty_gia;
        bool isLocalCurrency = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

        foreach (var ct in LSCt)
        {
            decimal value = ct.Tien_km_nt;

            if (isLocalCurrency)
            {
                ct.Tien_km_nt = value;
            }
            else
            {
                decimal rounded = Math.Round(
                    value / tyGia,
                    isPrice ? M_ROUND_GIA_NT : M_ROUND
                );

                if (rounded != 0)
                    ct.Tien_km = rounded;
            }
        }
    }
