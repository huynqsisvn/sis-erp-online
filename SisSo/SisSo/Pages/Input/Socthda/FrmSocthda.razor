                            CurPh.Tien_km_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_km_nt) + km_nt;

                            decimal km = Math.Round(km_nt * ty_gia, M_ROUND);
                            if (km != 0)
                            {
                                CurrentEditModel.Tien_km = km;
                                CurPh.Tien_km = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_km) + km;

                            }
                        }
                        else
                        {
                            CurrentEditModel.Ck_nt = 0;
                            CurrentEditModel.Ck = 0;
                        }
                        CurPh.T_tien_nt2 = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt2) + CurrentEditModel.Tien_nt2;
                        // Quy đổi tiền sang VND
