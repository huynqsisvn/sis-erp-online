    // Tương đương UpdateMoney_NT() trong WinForm - tính các tổng nguyên tệ
    private void UpdateMoney_NT()
    {
        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
        decimal thue_suat = CurPh.Thue_suat;
        decimal tinh_ck = CurPh.Tinh_ck;
        decimal sua_thue = CurPh.Sua_thue;

        // Tổng tiền hàng nguyên tệ (chỉ lấy dòng không phải khuyến mại)
        decimal t_tien_nt2 = CurPh.T_tien_nt2;

        // Tổng chiết khấu dòng + khuyến mại hóa đơn + tiền_km (pt_km)
        decimal t_ck_nt = 0;
        decimal tien_km_nt = 0;
        if (CurrentEditModel != null)
        {
            t_ck_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck_nt) + CurrentEditModel.Ck_nt;
            // decimal kmhd_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_tb) + CurrentEditModel.Tien_tb;     // tiền_tb là KM hóa đơn
            tien_km_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_km_nt) + CurrentEditModel.Tien_km_nt; // hoặc x.Tien_km nếu bạn dùng chung
        }
        else
        {
            t_ck_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Ck_nt);
            tien_km_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_km_nt);
        }

        CurPh.Tien_km_nt = tien_km_nt;      // KM hóa đơn

        // CurPh.T_ck_nt = t_ck_nt + kmhd_nt + tien_km_nt;
        CurPh.T_ck_nt = t_ck_nt + tien_km_nt;

        // Tiền sau chiết khấu nguyên tệ
        decimal t_tien_sau_ck_nt = t_tien_nt2 - CurPh.T_ck_nt;
        CurPh.T_tien_sau_ck_nt = t_tien_sau_ck_nt;

        // Tính thuế GTGT nguyên tệ
        if (sua_thue == 0m)
        {
            decimal co_so_thue_nt = tinh_ck != 1 ? t_tien_sau_ck_nt : t_tien_nt2;
            decimal t_thue_nt = Math.Round(co_so_thue_nt * thue_suat / 100m, M_ROUND_NT);
            CurPh.T_thue_nt = t_thue_nt;

            // Nếu là VND thì đồng bộ luôn sang trường VND
            if (CurPh.Ma_nt.Trim() == M_ma_nt0.Trim())
                CurPh.T_thue = t_thue_nt;
        }

        // Tổng thanh toán nguyên tệ
        CurPh.T_tt_nt = CurPh.T_tien_sau_ck_nt + CurPh.T_thue_nt;
    }

    // Tương đương UpdateMoney() trong WinForm - tính các tổng quy đổi VND
    private void UpdateMoney()
    {
        decimal thue_suat = CurPh.Thue_suat;
        decimal tinh_ck = CurPh.Tinh_ck;
        decimal sua_thue = CurPh.Sua_thue;

        // Tổng tiền hàng VND
        decimal t_tien2 = CurPh.T_tien2;
        decimal t_ck = 0;
        decimal tien_km = 0;
        if (CurrentEditModel != null)
        {

            // Tổng chiết khấu + KM hóa đơn + tiền_km quy đổi
            t_ck = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck) + CurrentEditModel.Ck;
            // decimal kmhd = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_tb) + CurrentEditModel.Tien_tb;
            tien_km = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_km) + CurrentEditModel.Tien_km;
        }
        else
        {
            t_ck = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Ck);
            tien_km = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_km);
        }
        // Gán các trường phụ nếu cần hiển thị riêng
        CurPh.Tien_km = tien_km;      // KM hóa đơn

        // CurPh.T_ck = t_ck + kmhd + tien_km;
        CurPh.T_ck = t_ck + tien_km;

        // Tiền sau chiết khấu VND
        decimal t_tien_sau_ck = t_tien2 - CurPh.T_ck;
        CurPh.T_tien_sau_ck = t_tien_sau_ck;

        // Tính thuế GTGT VND
        if (sua_thue == 0)
        {
            decimal co_so_thue = tinh_ck != 1 ? t_tien_sau_ck : t_tien2;
            decimal t_thue = Math.Round(co_so_thue * thue_suat / 100m, M_ROUND);
            CurPh.T_thue = t_thue;
        }

        // Tổng thanh toán VND
        CurPh.T_tt = CurPh.T_tien_sau_ck + CurPh.T_thue;
    }

    void Sum_all()
    {
        decimal t_so_luong = 0m;
        decimal t_tien_nt2 = 0m;
        decimal t_tien2 = 0m;

        // Duyệt qua tất cả dòng chi tiết (chỉ lấy dòng không phải khuyến mại và cùng stt_rec)
        foreach (var row in LSCt.Where(x => x.Km_ck != "1"))
        {
            t_so_luong += row.So_luong;
            t_tien_nt2 += row.Tien_nt2;
            t_tien2 += row.Tien2;
        }

        // Nếu chứng từ dùng VND → đồng bộ tiền quy đổi = tiền nguyên tệ
        if (CurPh.Ma_nt.Trim() == M_ma_nt0.Trim())
            t_tien2 = t_tien_nt2;

        // Gán lại vào header phiếu
        CurPh.T_so_luong = t_so_luong;
        CurPh.T_tien_nt2 = t_tien_nt2;
        CurPh.T_tien2 = t_tien2;

        // Cập nhật lại tổng thuế (nếu có hàm này)
        UpdateTongThue();
        UpdateTienKM();
        UpdateTienKM_NT();
        UpdateThueKM();
        // Refresh giao diện
        StateHasChanged();
    }
    private void UpdateTienKM_NT()
    {
        // Tổng tiền khuyến mãi nguyên tệ từ các dòng chi tiết
        decimal t_tien_km_nt = LSCt.Where(x => x.Km_ck == "1").Sum(a => a.Tien_nt2);

        // Thuế suất từ header phiếu
        decimal thue_suat = CurPh.Thue_suat;

        // Gán tổng tiền khuyến mãi nguyên tệ
        CurPh.T_tien_km_nt = t_tien_km_nt; // hoặc tên property tương ứng của bạn

        // Tính thuế trên khuyến mãi (nếu có cấu hình tính thuế KM/CK)
        decimal t_thue_km_nt = 0m;
        if (CurPh.Tinh_ck == 1m)
        {
            t_thue_km_nt = Math.Round(t_tien_km_nt * thue_suat / 100m, M_ROUND_NT);
        }

        // Gán thuế khuyến mãi nguyên tệ
        CurPh.T_thue_km_nt = t_thue_km_nt;

        // Tính tổng tiền thuế có khuyến mãi: tiền KM + thuế KM
        CurPh.Tien_tc_nt = t_tien_km_nt + t_thue_km_nt;

        // Tổng tiền thanh toán có khuyến mãi = tổng tiền trước KM + tiền KM + thuế KM
        decimal t_tt_truoc_km_nt = CurPh.T_tt_nt;
        CurPh.T_tt_km_nt = t_tt_truoc_km_nt + t_tien_km_nt + t_thue_km_nt;

        // Nếu là VND thì đồng bộ sang nội tệ
        if (CurPh.Ma_nt.Trim() == M_ma_nt0.Trim())
        {
            CurPh.T_tien_km = CurPh.T_tien_km_nt;
            CurPh.T_thue_km = CurPh.T_thue_km_nt;
            CurPh.Tien_tc = CurPh.Tien_tc_nt;
            CurPh.T_tt_km = CurPh.T_tt_km_nt;
        }

        // Cập nhật giao diện Blazor
        StateHasChanged();
    }
    private void UpdateTienKM()
    {
        decimal t_tien_km = LSCt.Where(x => x.Km_ck == "1").Sum(a => a.Tien2);
        decimal thue_suat = CurPh.Thue_suat;

        CurPh.T_tien_km = t_tien_km;
        decimal t_thue_km = 0m;

        if (CurPh.Tinh_ck == 1m)
        {
            t_thue_km = Math.Round(t_tien_km * thue_suat / 100m, M_ROUND_NT);
        }
        CurPh.T_thue_km = Math.Round(CurPh.T_thue_km * CurPh.Ty_gia, M_ROUND);

        // Tổng tiền có KM + thuế KM
        CurPh.Tien_tc = t_tien_km + CurPh.T_thue_km;

        // Tổng thanh toán cuối cùng sau khuyến mãi
        CurPh.T_tt_km = CurPh.T_tt + CurPh.Tien_tc;



        StateHasChanged();
    }
    private void UpdateTongThue()
    {
        decimal thue_suat = CurPh.Thue_suat;
        decimal tinh_ck = CurPh.Tinh_ck;
        decimal sua_thue = CurPh.Sua_thue;

        decimal t_thue_nt = 0m;
        decimal t_thue = 0m;

        if (tinh_ck == 1m)
        {
            // Tính thuế trên tổng tiền trước chiết khấu
            decimal co_so_nt = CurPh.T_tien_nt2;
            decimal co_so = CurPh.T_tien2;

            t_thue_nt = Math.Round(co_so_nt * thue_suat / 100m, M_ROUND_NT);
            t_thue = Math.Round(co_so * thue_suat / 100m, M_ROUND);
        }
        else
        {
            // Tính thuế trên tiền sau chiết khấu
            decimal co_so_nt = CurPh.T_tien_sau_ck_nt;
            decimal co_so = CurPh.T_tien_sau_ck;

            t_thue_nt = Math.Round(co_so_nt * thue_suat / 100m, M_ROUND_NT);
            t_thue = Math.Round(co_so * thue_suat / 100m, M_ROUND);
        }

        // Nếu người dùng đang sửa thuế tay → không tự động tính lại
        if (sua_thue != 0m)
            return;

        // Gán lại vào header phiếu
        CurPh.T_thue_nt = t_thue_nt;
        CurPh.T_thue = t_thue;

        // // Tự động tính tổng thanh toán (tổng tiền sau CK + thuế)
        CurPh.T_tt_nt = CurPh.T_tien_sau_ck_nt + CurPh.T_thue_nt;
        CurPh.T_tt = CurPh.T_tien_sau_ck + CurPh.T_thue;

        // Nếu là VND → đồng bộ
        if (CurPh.Ma_nt.Trim() == M_ma_nt0.Trim())
        {
            CurPh.T_thue = CurPh.T_thue_nt;
            CurPh.T_tt = CurPh.T_tt_nt;
        }

        // Refresh giao diện
        StateHasChanged();
    }

    private void UpdateThueKM()
    {
        // Đảm bảo các giá trị không null
        // CurPh.T_tien_km_nt ??= 0m;
        // CurPh.T_tien_km ??= 0m;
        // CurPh.Thue_suat ??= 0m;

        // Tính thuế chiết khấu
        CurPh.T_thue_km_nt = Math.Round(CurPh.T_tien_km_nt * CurPh.Thue_suat / 100m, M_ROUND_NT);
        CurPh.T_thue_km = Math.Round(CurPh.T_tien_km * CurPh.Thue_suat / 100m, M_ROUND);

        // Tổng tiền thanh toán = tiền KM + thuế KM
        CurPh.Tien_tc_nt = CurPh.T_tien_km_nt + CurPh.T_thue_km_nt;
        CurPh.Tien_tc = CurPh.T_tien_km + CurPh.T_thue_km;

        // Gọi StateHasChanged nếu cần cập nhật UI ngay
        StateHasChanged();
    }

