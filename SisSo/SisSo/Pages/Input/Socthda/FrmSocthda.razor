                            CurrentEditModel.Tien_km = CurrentEditModel.Tien_km_nt;
                            CurPh.T_tien2 = CurPh.T_tien_nt2;
                            CurPh.T_ck = CurPh.T_ck_nt;
                            CurPh.T_tien_km = CurPh.T_tien_km_nt;

                        }
                        if (CurrentEditModel.Km_ck == "1")
                        {
                            this.UpdateKM();
                        }
                        this.UpdateMoney();
                        this.UpdateMoney_NT();
                        // Refresh UI
                        StateHasChanged();
                        break;
                    }

                case "gia_nt":
