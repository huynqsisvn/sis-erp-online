    private void PhanBoThueInCT_CBTien()
    {
        try
        {
            if (!LSCt.Any()) return;

            decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;

            // Các tổng thuế và tiền ở header
            decimal t_thue_nt = CurPh.T_thue_nt;
            decimal t_thue = CurPh.T_thue;
            decimal t_tien_nt2 = CurPh.T_tien_nt2;
            decimal t_tien2 = CurPh.T_tien2;
            decimal t_tien_km_nt = CurPh.T_tien_km_nt;
            decimal t_tien_km = CurPh.T_tien_km;
            decimal t_thue_km_nt = CurPh.T_thue_km_nt;
            decimal t_thue_km = CurPh.T_thue_km;

            // Cơ sở tính thuế (trước hay sau chiết khấu)
            bool tinhSauCk = CurPh.Tinh_ck == 0;   // false → tính sau chiết khấu
            decimal co_so_nt = tinhSauCk ? CurPh.T_tien_sau_ck_nt : CurPh.T_tien_nt2;
            decimal co_so = tinhSauCk ? CurPh.T_tien_sau_ck : CurPh.T_tien2;

            // === Bước 1: Điều chỉnh tiền làm tròn (nếu có sai số do làm tròn tỷ giá) ===
            bool daDieuChinhTien = false;
            bool daDieuChinhTienKm = false;

            foreach (var row in LSCt)
            {
                if (row.Tien_nt2 != 0 && row.Tien2 != 0)
                {
                    // Điều chỉnh tiền VND nếu có sai số làm tròn tỷ giá
                    if (!daDieuChinhTien && row.Km_ck == "0")
                    {
                        row.Tien2 += (t_tien2 - Math.Round(t_tien_nt2 * ty_gia, M_ROUND));
                        daDieuChinhTien = true;
                    }
                    else if (!daDieuChinhTienKm && row.Km_ck == "1")
                    {
                        row.Tien2 += (t_tien_km - Math.Round(t_tien_km_nt * ty_gia, M_ROUND));
                        daDieuChinhTienKm = true;
                    }
                }
            }

            // === Bước 2: Phân bổ thuế cho từng dòng ===
            int firstNormalRow = -1;   // dòng đầu tiên không phải KM
            int firstKmRow = -1;   // dòng đầu tiên là KM

            decimal tongThueNormal = 0m;
            decimal tongThueNormalNt = 0m;
            decimal tongThueKm = 0m;
            decimal tongThueKmNt = 0m;

            for (int i = 0; i < LSCt.Count; i++)
            {
                var row = LSCt[i];

                // Tiền dòng (trước/sau chiết khấu)
                decimal tienDauVao = tinhSauCk ? row.Tien2 - row.Ck : row.Tien2;
                decimal tienDauVaoNt = tinhSauCk ? row.Tien_nt2 - row.Ck_nt : row.Tien_nt2;

                decimal thue_nt = 0m;
                decimal thue = 0m;

                if (row.Km_ck == "0") // Dòng bình thường
                {
                    if (co_so_nt != 0)
                        thue_nt = Math.Round(tienDauVaoNt / co_so_nt * t_thue_nt, M_ROUND_NT);
                    if (co_so != 0)
                        thue = Math.Round(tienDauVao / co_so * t_thue, M_ROUND);

                    row.Thue_nt = thue_nt;
                    row.Thue = thue;

                    tongThueNormal += thue;
                    tongThueNormalNt += thue_nt;

                    if (firstNormalRow == -1) firstNormalRow = i;
                }
                else // Dòng khuyến mại (km_ck = 1)
                {
                    if (t_tien_km_nt != 0)
                        thue_nt = Math.Round(row.Tien_nt2 / t_tien_km_nt * t_thue_km_nt, M_ROUND_NT);
                    if (t_tien_km != 0)
                        thue = Math.Round(row.Tien2 / t_tien_km * t_thue_km, M_ROUND);

                    row.Thue_nt = thue_nt;
                    row.Thue = thue;

                    tongThueKm += thue;
                    tongThueKmNt += thue_nt;

                    if (firstKmRow == -1) firstKmRow = i;
                }
            }

            // === Bước 3: Bù trừ sai số làm tròn (gán vào dòng đầu tiên) ===
            if (firstNormalRow != -1)
            {
                if (t_thue != tongThueNormal)
                    LSCt[firstNormalRow].Thue += (t_thue - tongThueNormal);
                if (t_thue_nt != tongThueNormalNt)
                    LSCt[firstNormalRow].Thue_nt += (t_thue_nt - tongThueNormalNt);
            }

            if (firstKmRow != -1)
            {
                if (t_thue_km != tongThueKm)
                    LSCt[firstKmRow].Thue += (t_thue_km - tongThueKm);
                if (t_thue_km_nt != tongThueKmNt)
                    LSCt[firstKmRow].Thue_nt += (t_thue_km_nt - tongThueKmNt);
            }

            // Refresh UI
            StateHasChanged();
        }
        catch (Exception ex)
        {

        }
    }
