    public override async Task Loaddata()
    {
        LoadVoucher();

        if (DsTrans != null && DsTrans.Tables.Count > 0)
        {
            List<Ph81> ls81 = myDb.ConvertDataTable<Ph81>(DsTrans.Tables[0]);
            if (ls81 != null && ls81.Count > 0)
            {
                CurPh = ls81[0];
                NotMaNt0Voucher = !CurPh.Ma_nt.Equals(M_ma_nt0) ? true : false;
            }

            if (DsTrans != null && DsTrans.Tables.Count > 1)
                LSCt = myDb.ConvertDataTable<Ct81>(DsTrans.Tables[1]);
            if (!String.IsNullOrWhiteSpace(CurPh.Stt_rec_pt))
            {
                string strsql = string.Format("SELECT stt_rec,ma_ct,ma_gd,ma_qs,so_ct,ma_nt,ong_ba,dien_giai FROM {0} WHERE stt_rec LIKE '{1}'", CurPh.Ma_ct_pt.Equals("PT1") ? (object)"ph41" : (object)"ph51", CurPh.Stt_rec_pt);
                DataTable tblpt1 = myDb.GetTable(strsql);
                if (tblpt1.Rows.Count > 0)
                {
                    CurPh.Ma_gd_pt = tblpt1.Rows[0]["ma_gd"].ToString();
                    CurPh.Ma_nt_pt = tblpt1.Rows[0]["ma_nt"].ToString();
                    CurPh.Ong_ba_pt = tblpt1.Rows[0]["ong_ba"].ToString();
                    CurPh.Dien_giai_pt = tblpt1.Rows[0]["dien_giai"].ToString();
                }
            }
            if (!String.IsNullOrEmpty(CurPh.Ma_ct_pt))
            {
                _filter_pt = String.Format("ma_cts = '' OR ma_cts like '%{0}%'", CurPh.Ma_ct_pt);
                _filter_gd = String.Format("[status] = '1' AND ma_ct = '{0}' AND ( ma_gd = '2' OR ma_gd = '9')", CurPh.Ma_ct_pt);

            }
            else
            {
                _filter_pt = "";
                _filter_gd = "1=0";
            }
        }
    }
    private async Task Save()
    {
