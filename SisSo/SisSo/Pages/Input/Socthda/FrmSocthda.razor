            flag = false;
        }
        if (flag && string.IsNullOrEmpty(CurPh.Tk_thue_co))
        {
            Message = Lap["Chưa vào tài khoản thuế có!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('tk_thue_co_input')?.focus()");
            IsSaved = false;

            flag = false;
        }

        // else
        // {
        //     if (string.IsNullOrEmpty(CurPh.So_ct) && flag)
        //     {
        //         CurPh.So_ct = await GetNewSoctAsync(StartupBase.SasObj, CurPh.Ma_qs);
        //         StateHasChanged();
        //     }

        //     if (flag && !await CheckSo_ctAsync(CurPh.Transform, CurPh.So_ct1, CurPh.So_ct2, CurPh.So_ct))
        //     {
        //         Snackbar.Add("Số hóa đơn không thuộc ký hiệu hiện hành!", Severity.Error);
        //         CurPh.So_ct = await GetNewSoctAsync(StartupBase.SasObj, CurPh.Ma_qs);
        //         StateHasChanged();
        //         flag = false;
        //     }
        // }

        return flag;
