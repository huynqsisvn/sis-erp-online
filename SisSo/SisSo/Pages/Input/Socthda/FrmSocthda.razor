    private async Task btnAddInvoice_Click()
    {
        if (AllowEditMode) return;

        // try
        // {
        string voucherIds = CurPh?.Stt_rec;
        if (string.IsNullOrWhiteSpace(voucherIds))
        {
            myStateMN.SetNewThongbao(Lap["No voucher selected"]);
            return;
        }
        string format = "exec {0} @ma_ct, @PhFilter, @CtFilter, @GtFilter,@sl_ct;";
        string proc = "[LoadVoucher]";
        try
        {
            if (curDmct != null)
            {
                var ps = (curDmct?.Process_Store ?? "").Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries);
                if (ps.Length > 0 && !string.IsNullOrWhiteSpace(ps[0]))
                    proc = ps[0].Trim();
            }
        }
        catch { }

        string sqlcmd = string.Format(format, proc);
        DataSet ds = await Task.Run(() =>
            myDb.LoadDataSet(sqlcmd, new Dictionary<string, object>
            {
                ["@ma_ct"] = CurPh?.Ma_ct ?? "",
                ["@PhFilter"] = "stt_rec = '" + voucherIds.Replace("'", "''") + "'",
                ["@CtFilter"] = "1=1",
                ["@GtFilter"] = "1=1",
                ["@sl_ct"] = 1
            })
        );

        if (ds == null)
        {
            myStateMN.SetNewThongbao(Lap["Error"] + ": " + Lap["No data found for invoice"]);
            return;
        }
        string msg = string.Empty;
        string sGUID = string.Empty;
        string sInvoiceForm = string.Empty;
        string sInvoiceSerial = string.Empty;
        string sInvoiceNo = string.Empty;
@* 
        try
        {
            var updateInvoice = new SasCusEinvoice.UpdateInvoice(myDb, myStateMN, ds.Copy(), "BKAV", CurPh?.Ma_ct ?? "HDA");
            ds.Clear();
            ds.Dispose();
            msg = updateInvoice.BKAV_Create(out sGUID, out sInvoiceForm, out sInvoiceSerial, out sInvoiceNo);
        }
        catch (Exception exInv)
        {
            myStateMN.SetNewThongbao(Lap["Invoice creation error"] + ": " + exInv.Message);
            return;
        } *@

        if (!string.IsNullOrEmpty(msg))
        {
           if(msg.ToUpper().StartsWith("NO_"))
            {
                myStateMN.SetNewThongbao(msg);
                return;
            }
        }
    
        CurPh.Inv_guid = sGUID?.Trim();
        CurPh.So_ct_hddt = sInvoiceNo?.Trim();
        CurPh.So_seri_hddt = sInvoiceSerial?.Trim();
        CurPh.Mau_hddt = sInvoiceForm?.Trim();  
        // persist invoice info back to DB (single command like original)
        string uStt = voucherIds.Replace("'", "''");
        string updateSql = $"Update PH81 SET inv_guid = '{CurPh.Inv_guid}', mau_hddt= '{CurPh.Mau_hddt}', so_seri_hddt = '{CurPh.So_seri_hddt}', so_ct_hddt ='{CurPh.So_ct_hddt}' WHERE stt_rec = '" + voucherIds + "'; ";
        updateSql += $"Update PH21 SET inv_guid = N'{sGUID?.Replace("'", "''")}', mau_hddt = N'{sInvoiceForm?.Replace("'", "''")}', so_seri_hddt = N'{sInvoiceSerial?.Replace("'", "''")}', so_ct_hddt = N'{sInvoiceNo?.Replace("'", "''")}' WHERE stt_rec = '{uStt}';";
        updateSql += $" Update CTTT20 SET inv_guid = N'{sGUID?.Replace("'", "''")}', mau_hddt = N'{sInvoiceForm?.Replace("'", "''")}', so_seri_hddt = N'{sInvoiceSerial?.Replace("'", "''")}', so_ct_hddt = N'{sInvoiceNo?.Replace("'", "''")}' WHERE stt_rec = '{uStt}';";
        updateSql += string.Format(" Update CT00 SET mau_hddt = N'{0}', so_seri_hddt = N'{1}', so_ct_hddt = N'{2}' WHERE stt_rec = '{3}';",
                                    sInvoiceForm?.Replace("'", "''") ?? "",
                                    sInvoiceSerial?.Replace("'", "''") ?? "",
                                    sInvoiceNo?.Replace("'", "''") ?? "", uStt);
        updateSql += string.Format(" Update CTGT20 SET mau_hddt = N'{0}', so_seri_hddt = N'{1}', so_ct_hddt = N'{2}' WHERE stt_rec = '{3}';",
                        sInvoiceForm?.Replace("'", "''") ?? "",
                        sInvoiceSerial?.Replace("'", "''") ?? "",
                        sInvoiceNo?.Replace("'", "''") ?? "", uStt);

        try
        {
            await myDb.ExecuteSqlQueryAsync(updateSql);
            myStateMN.SetNewThongbao(string.Format(Lap["Successfully added new : {0}"], sGUID?.Trim()));
        }
        catch (Exception exUpd)
        {
            myStateMN.SetNewThongbao(string.Format(Lap["Successfully added new : {0}"], sGUID?.Trim() + " - " + Lap["Error updating invoice info"]));
        }

        StateHasChanged();
        // }
        // catch (Exception ex)
        // {
        //     myStateMN.SetNewThongbao(Lap["Error"] + ": " + ex.Message);
        // }
        // finally
        // {
        //     isAddingInvoice = false;
        //     StateHasChanged();
        // }
    }
