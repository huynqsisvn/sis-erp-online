    void UpdateTotalChkSua_tien()
    {
        if (LSCt == null || LSCt.Count == 0)
            return;

        decimal tyGia = CurPh.Ty_gia;

        foreach (var ct in LSCt)
        {
            decimal soLuong = ct.So_luong;
            decimal giaNt2 = ct.Gia_nt2;
            decimal giaNt = ct.Gia_nt;
            decimal tlCk = ct.Tl_ck;
            decimal ptKm = ct.Pt_km;

            if (soLuong != 0)
            {
                // --- TÍNH TIỀN NT2 ---
                if (giaNt2 != 0)
                {
                    ct.Tien_nt2 = Math.Round(soLuong * giaNt2, M_ROUND_NT);

                    // --- TÍNH CHIẾT KHẤU ---
                    if (tlCk != 0)
                    {
                        ct.Ck_nt = Math.Round(ct.Tien_nt2 * tlCk / 100, M_ROUND_NT);

                        decimal ck = Math.Round(ct.Ck_nt * tyGia, M_ROUND);
                        if (ck != 0)
                            ct.Ck = ck;
                    }
                    if (ptKm != 0)
                    {
                        decimal co_so = ct.Tien_nt2 - ct.Ck_nt;
                        ct.Tien_km_nt = Math.Round(co_so * ptKm / 100, M_ROUND_NT);

                        decimal km = Math.Round(ct.Tien_km_nt * tyGia, M_ROUND);
                        if (km != 0)
                            ct.Tien_km = km;
                    }
                }

                // --- TÍNH TIỀN NT ---
                if (giaNt != 0)
                {
                    ct.Tien_nt = Math.Round(soLuong * giaNt, M_ROUND_NT);
                }
            }
            if (CurrentEditModel != null && ct.Stt_rec0 == CurrentEditModel.Stt_rec0)
            {
                CurrentEditModel.Tien_km = ct.Tien_km;
                CurrentEditModel.Tien_km_nt = ct.Tien_km_nt;
                CurrentEditModel.Ck_nt = ct.Ck_nt;
                CurrentEditModel.Ck = ct.Ck;

            }

        }

        // --- TÍNH TỔNG HEADER ---
        CurPh.T_tien_nt2 = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_nt2);
        CurPh.T_tien_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Tien_nt);

        // --- UPDATE KM ---
        UpdateKM();

        StateHasChanged();
    }
    private void UpdateKM()
    {
        // --- TÍNH TỔNG TIỀN KM ---
        decimal num1 = LSCt.Sum(x => x.Tien_nt2); // tổng tien_nt2
        decimal num2 = LSCt.Sum(x => x.Tien2);    // tổng tien2
        decimal thueSuat = CurPh.Thue_suat;

        decimal num4 = Math.Round(num1 * thueSuat / 100, M_ROUND);
        decimal num5 = Math.Round(num2 * thueSuat / 100, M_ROUND);

        decimal num6 = CurPh.T_tt_nt; // tổng tiền thực tế NT trước KM
        decimal num7 = CurPh.T_tt;    // tổng tiền thực tế VND trước KM

        // --- Cập nhật header ---
        CurPh.T_sl_km = LSCt.Sum(x => x.So_luong);
        CurPh.T_tien_km_nt = num1;
        CurPh.T_tien_km = num2;
        CurPh.T_thue_km_nt = num4;
        CurPh.T_thue_km = num5;

        CurPh.Tien_tc_nt = num1 + num4;
        CurPh.Tien_tc = num2 + num5;

        CurPh.T_tt_km_nt = num6 + num1 + num4;
        CurPh.T_tt_km = num7 + num2 + num5;

        StateHasChanged();
    }
