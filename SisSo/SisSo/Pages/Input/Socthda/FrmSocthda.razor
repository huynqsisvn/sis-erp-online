    void OnGridCT_Value_Changed(decimal newvalue, string name)
    {
        if (!string.IsNullOrEmpty(name))
        {
            switch (name.ToLower())
            {
                case "so_luong":
                    {
                        // Lấy giá trị mới từ editor
                        CurrentEditModel.So_luong = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        CurPh.T_so_luong = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.So_luong) + newvalue;
                        CurPh.T_sl_km = LSCt.Where(x => x.Km_ck == "1" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.So_luong) + newvalue;
                        // Nếu số lượng = 0 → reset giá về 0
                        if (CurrentEditModel.So_luong == 0)
                        {
                            CurrentEditModel.Gia_nt = CurrentEditModel.Gia = 0;
                            CurrentEditModel.Gia_nt2 = CurrentEditModel.Gia2 = 0;
                        }
                        else
                        {
                            // Quy đổi đơn giá về VND nếu có giá ngoại tệ
                            decimal gia_nt2 = CurrentEditModel.Gia_nt2;
                            decimal gia_nt = CurrentEditModel.Gia_nt;

                            decimal gia2 = Math.Round(gia_nt2 * ty_gia, M_ROUND_GIA);
                            decimal gia = Math.Round(gia_nt * ty_gia, M_ROUND_GIA);

                            if (gia2 != 0) CurrentEditModel.Gia2 = gia2;
                            if (gia != 0) CurrentEditModel.Gia = gia;
                        }

                        // === Tính tiền nguyên tệ ===
                        decimal tien_nt2 = Math.Round(CurrentEditModel.So_luong * (CurrentEditModel.Gia_nt2), M_ROUND_NT);
                        decimal tien_nt = Math.Round(CurrentEditModel.So_luong * (CurrentEditModel.Gia_nt), M_ROUND_NT);

                        // === Quy đổi sang VND ===
                        CurrentEditModel.Tien2 = Math.Round(tien_nt2 * ty_gia, M_ROUND);
                        CurrentEditModel.Tien = Math.Round(tien_nt * ty_gia, M_ROUND);

                        CurrentEditModel.Tien_nt2 = tien_nt2 != 0 ? tien_nt2 : 0;
                        CurrentEditModel.Tien_nt = tien_nt != 0 ? tien_nt : 0;

                        CurPh.T_tien_nt2 = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt2) + CurrentEditModel.Tien_nt2;
                        CurPh.T_tien_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt) + CurrentEditModel.Tien_nt;
                        CurPh.T_tien2 = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien2) + CurrentEditModel.Tien2;
                        CurPh.T_tien = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien) + CurrentEditModel.Tien;


                        // === Tính chiết khấu theo tỷ lệ ===
                        if (CurrentEditModel.Tl_ck > 0)
                        {
                            decimal ck_nt = Math.Round(tien_nt2 * CurrentEditModel.Tl_ck / 100m, M_ROUND_NT);
                            decimal ck = Math.Round(ck_nt * ty_gia, M_ROUND);

                            CurrentEditModel.Ck_nt = ck_nt;
                            CurrentEditModel.Ck = ck != 0 ? ck : 0;
                            // CurPh.T_ck_nt = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Ck_nt) ;
                            // CurPh.T_ck = LSCt.Where(x => x.Km_ck == "0").Sum(x => x.Ck) ;

                        }
                        else
                        {
                            CurrentEditModel.Ck_nt = 0;
                            CurrentEditModel.Ck = 0;
                        }

                        // === Nếu chứng từ dùng VND → đồng bộ các trường ===
                        if (isVND)
                        {
                            CurrentEditModel.Gia = CurrentEditModel.Gia_nt;
                            CurrentEditModel.Gia2 = CurrentEditModel.Gia_nt2;
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2;
                            CurrentEditModel.Ck = CurrentEditModel.Ck_nt;

                            CurPh.T_tien2 = CurPh.T_tien_nt2;
                            CurPh.T_tien = CurPh.T_tien_nt;
                            CurPh.T_ck = CurPh.T_ck_nt;
                        }
                        this.UpdateMoney();
                        this.UpdateMoney_NT();
                        // Refresh UI
                        StateHasChanged();
                        break;
                    }
                case "gia_nt2":
                    {
                        // Lấy giá trị mới người dùng nhập

                        CurrentEditModel.Gia_nt2 = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        // Quy đổi đơn giá sang VND
                        decimal gia2 = Math.Round(CurrentEditModel.Gia_nt2 * ty_gia, M_ROUND_GIA);
                        if (CurrentEditModel.So_luong != 0 && gia2 != 0)
                            CurrentEditModel.Gia2 = gia2;

                        // Tính tiền (chỉ tính nếu checkbox "Sửa tiền" không được check - tức là cho phép tự động tính tiền từ giá x sl)
                        if ((CurPh.Sua_tien == 1m) != true) // ChkSua_tien là bool trong Blazor, true = đang cho sửa tiền tay, false = tự động tính
                        {
                            decimal tien_nt2 = Math.Round(CurrentEditModel.So_luong * CurrentEditModel.Gia_nt2, M_ROUND_NT);
                            if (tien_nt2 != 0)
                            {
                                CurrentEditModel.Tien_nt2 = tien_nt2;
                                CurPh.T_tien_nt2 = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien_nt2) + CurrentEditModel.Tien_nt2;
                            }
                        }

                        // Quy đổi tiền sang VND
                        decimal tien2 = Math.Round(CurrentEditModel.Tien_nt2 * ty_gia, M_ROUND);
                        if (tien2 != 0)
                        {
                            CurrentEditModel.Tien2 = tien2;
                            CurPh.T_tien2 = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Tien2) + CurrentEditModel.Tien2;
                        }

                        // Nếu chứng từ là VND → đồng bộ toàn bộ giá và tiền
                        if (isVND)
                        {
                            CurrentEditModel.Gia2 = CurrentEditModel.Gia_nt2;
                            CurrentEditModel.Tien2 = CurrentEditModel.Tien_nt2;
                            CurPh.T_tien2 = CurPh.T_tien_nt2;

                        }

                        this.UpdateMoney();
                        this.UpdateMoney_NT();
                        // Refresh UI
                        StateHasChanged();
                        break;
                    }
                case "tien_nt2":
                    {
                        // Lấy giá trị mới người dùng nhập

                        CurrentEditModel.Tien_nt2 = newvalue;

                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        // Nếu số lượng > 0 và chưa có đơn giá → tính ngược lại đơn giá từ tiền
