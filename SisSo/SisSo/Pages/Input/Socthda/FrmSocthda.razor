                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('tk_gv_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
            // else if (row.Gia_ton == "3" && row.So_luong == 0)
            // {
            //     Message = Lap["Vật tư NTXT không được nhập số lượng = 0!"];
            //     myStateMN.SetNewThongbao(Message);
            //     flag = false;
            // }
        }

        // 8. Tài khoản thuế GTGT
        if (flag && string.IsNullOrEmpty(CurPh.Tk_thue_no))
        {

            Message = Lap["Chưa vào tài khoản thuế nợ!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('tk_thue_no_input')?.focus()");
