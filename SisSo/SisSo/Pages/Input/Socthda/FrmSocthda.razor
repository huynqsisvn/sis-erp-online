                        {
                            CurrentEditModel.Gia_nt2 = Math.Round(CurrentEditModel.Tien_nt2 / CurrentEditModel.So_luong, M_ROUND_GIA);
                        }

                        // Tính chiết khấu theo tỷ lệ (nếu có)
                        if (CurrentEditModel.Tl_ck > 0)
                        {
                            decimal ck_nt = Math.Round(CurrentEditModel.Tien_nt2 * CurrentEditModel.Tl_ck / 100m, M_ROUND_NT);
                            CurrentEditModel.Ck_nt = ck_nt;
                            CurPh.T_ck_nt = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck_nt) + ck_nt;

                            decimal ck = Math.Round(ck_nt * ty_gia, M_ROUND);
                            if (ck != 0)
                            {
                                CurrentEditModel.Ck = ck;
                                CurPh.T_ck = LSCt.Where(x => x.Km_ck == "0" && x.Stt_rec0 != CurrentEditModel.Stt_rec0).Sum(x => x.Ck) + ck;

                            }
                        }
                        if (CurrentEditModel.Pt_km > 0)
