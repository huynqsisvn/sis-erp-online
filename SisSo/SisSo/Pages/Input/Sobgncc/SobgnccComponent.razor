<style>
    /* Vung chua 2 luoi + dai phan cach, lap day chieu cao con lai cua man hinh */
    .vc-sobgncc-fill {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 135px); /* tru top-menu + toolbar + footer */
        min-height: 420px;
    }

        /* Cac hang bao luoi tro thanh flex item, chia 3:2 */
        .vc-sobgncc-fill > .vc-ph-row {
            flex: 3 1 0;
            min-height: 0;
            flex-wrap: nowrap;
        }

        .vc-sobgncc-fill > .vc-ct-row {
            flex: 2 1 0;
            min-height: 0;
            flex-wrap: nowrap;
        }

        /* Root cua FrmBrowseComponent (.container-fluid) phai cao het hang de luoi lap day */
        .vc-sobgncc-fill > .vc-ph-row > .container-fluid,
        .vc-sobgncc-fill > .vc-ct-row > .container-fluid {
            width: 100%;
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding-left: 0;
            padding-right: 0;
        }

    /* Luoi an theo chieu cao flex item thay vi chieu cao co dinh -> khong con khoang trang dung */
    .grid-frm-height,
    .grid-frmct-height {
        height: 100% !important;
        flex: 1 1 auto;
        min-height: 0;
    }

    /* Dải phân cách giữa lưới phiếu và lưới chi tiết */
    .vc-section-divider {
        position: relative;
        display: flex;
        align-items: center;
        margin: 10px 4px 2px;
    }

        .vc-section-divider::after {
            content: "";
            flex: 1 1 auto;
            height: 1px;
            background: linear-gradient(90deg, #d0d5dd 0%, rgba(208, 213, 221, 0) 100%);
            margin-left: 10px;
        }

    .vc-section-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 14px;
        font-size: 0.78rem;
        font-weight: 600;
