    string _filter_qs = "";
    string filter_status = "ma_ct like '%BGC%' and status = 1 ";

    private List<(string Caption, string Value, string Color, string Icon)> GetKpiTiles()
    {
        var tiles = new List<(string, string, string, string)>();
        if (TblPH == null) return tiles;

        int total = TblPH.Rows.Count;
        tiles.Add(("Tổng số báo giá", total.ToString(), "purple", "oi-document"));
        if (total == 0) return tiles;

        bool hasStatus = TblPH.Columns.Contains("status");
        int soLapPhieu = hasStatus ? TblPH.AsEnumerable().Count(r => (r["status"]?.ToString() ?? "").Trim() == "1") : 0;
        int soDongPhieu = hasStatus ? TblPH.AsEnumerable().Count(r => (r["status"]?.ToString() ?? "").Trim() == "2") : 0;
        tiles.Add(("Đang lập phiếu", soLapPhieu.ToString(), "orange", "oi-pencil"));
        tiles.Add(("Đã đóng phiếu", soDongPhieu.ToString(), "teal", "oi-circle-check"));

        var (dueSoon, overdue) = GetDeliveryStats();
        tiles.Add(("Cần giao (sắp đến hạn)", dueSoon.ToString(), "red", "oi-warning"));
        tiles.Add(("Quá hạn giao hàng", overdue.ToString(), "dark-red", "oi-clock"));

        decimal tongTien = TblPH.Columns.Contains("t_tt")
            ? TblPH.AsEnumerable().Sum(r => r["t_tt"] == DBNull.Value ? 0 : Convert.ToDecimal(r["t_tt"]))
            : 0;
        tiles.Add(("Tổng giá trị", tongTien.ToString("N0") + " đ", "blue", "oi-bar-chart"));

        return tiles;
    }

    private (int DueSoon, int Overdue) GetDeliveryStats()
    {
        if (TblPH == null || TblCT == null) return (0, 0);
        if (!TblCT.Columns.Contains("han_gh_i") || !TblCT.Columns.Contains("stt_rec")
            || !TblPH.Columns.Contains("stt_rec") || !TblPH.Columns.Contains("status"))
            return (0, 0);

        // Chỉ xét các phiếu đang "Lập phiếu" (status = 1), tức còn chưa hoàn tất giao hàng.
        var openSttRec = new HashSet<string>(
            TblPH.AsEnumerable()
                .Where(r => (r["status"]?.ToString() ?? "").Trim() == "1")
                .Select(r => (r["stt_rec"]?.ToString() ?? "").Trim())
                .Where(s => s.Length > 0));

        DateTime today = DateTime.Today;
        var soon = new HashSet<string>();
        var late = new HashSet<string>();
        foreach (DataRow r in TblCT.Rows)
        {
            string sttRec = (r["stt_rec"]?.ToString() ?? "").Trim();
            if (sttRec.Length == 0 || !openSttRec.Contains(sttRec)) continue;
            if (r["han_gh_i"] == DBNull.Value) continue;

            DateTime han = Convert.ToDateTime(r["han_gh_i"]).Date;
            if (han < today) late.Add(sttRec);
            else if ((han - today).TotalDays <= 7) soon.Add(sttRec);
        }
        return (soon.Count, late.Count);
    }

