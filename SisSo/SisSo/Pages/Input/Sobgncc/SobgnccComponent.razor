        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }

    .vc-kpi-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        flex-shrink: 0;
