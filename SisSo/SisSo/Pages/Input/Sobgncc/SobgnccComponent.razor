    private async void BtnFilterOK()
    {
        ShowLoadding = true;

        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);
        string dvcs = myStateMN.GetMa_Dvcs();
        phFilter = "1=1";
        if (!IsAdminUser)
        {
            // Không phải admin: chỉ cho tìm theo từ số/đến số/từ ngày/đến ngày, mặc định ma_kh là mã ncc của tài khoản đang đăng nhập.
            Ma_qs = "";
            Tk_i = "";
            Status = "";
            Ma_dvcs = "";
            NSD = "";
            Ma_kh = ma_ncc;

            // Giống OnInitialized: non-admin chỉ xem chứng từ theo mã ncc của mình; nếu ma_ncc rỗng thì không hiện gì.
            if (string.IsNullOrEmpty(ma_ncc.Trim()))
            {
                phFilter = "1=0";
            }
            else
            {
                phFilter = phFilter + " AND ncc LIKE ''" + ma_ncc.Trim() + "%''";
            }
        }

        if (!string.IsNullOrEmpty(Ma_dvcs))
        {
            phFilter = phFilter + " AND ma_dvcs LIKE ''" + Ma_dvcs.Trim() + "%''";
        }
        if (string.IsNullOrEmpty(Ma_dvcs))
        {
            if (dvcs != "ALL")
            {
                phFilter = phFilter + " AND ma_dvcs LIKE ''" + dvcs.Trim() + "%''";
            }
        }
        if (Ngay_ct1 != null)
        {
            phFilter = phFilter + " AND ngay_ct >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            phFilter = phFilter + " AND ngay_ct <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }
        if (!String.IsNullOrEmpty(So_ct1))
        {
            phFilter = phFilter + " AND so_ct >= ''" + So_ct1.ToString() + "''";
        }
        if (!String.IsNullOrEmpty(So_ct2))
        {
            phFilter = phFilter + " AND so_ct <= ''" + So_ct2.ToString() + "''";
        }

        if (!String.IsNullOrEmpty(Ma_qs))
        {
            phFilter = phFilter + " AND ma_qs LIKE ''" + Ma_qs.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Status))
        {
            phFilter = phFilter + " AND status  LIKE ''" + Status.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Tk_i))
        {
            phFilter = phFilter + " AND ma_nx  LIKE ''" + Tk_i.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(NSD) && NSD.Trim().Equals("1"))
        {
            phFilter = phFilter + " AND user_id  = " + curUser.User_id + " ";
        }
        if (IsAdminUser && !String.IsNullOrEmpty(Ma_kh))
        {
            phFilter = phFilter + " AND ncc LIKE ''" + Ma_kh.Trim() + "%''";
        }
        await Loaddata(false);

        ShowLoadding = false;
        popFilterVisible = false;
        InvokeAsync(StateHasChanged);
    }
    public override async void V_In()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }

        DataSet DataSource = CopyVoucherToDataSet(SqlTableKeyValue);
        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<BGNCCModel>();
            BGNCCModel _curModel = new BGNCCModel();
            _curModel.LSPh = myDb.ConvertDataTable<Ph111>(DataSource.Tables[0]);
            _curModel.LSCt = myDb.ConvertDataTable<Ct111>(DataSource.Tables[1]);

            MST mst = new MST();
            MST mst_kh = new MST();

            string tk_no = "";
            string tk_co = "";
            int i = 0;
            foreach (Ct111 ct in _curModel.LSCt)
            {
                if (!tk_no.Contains(ct.Tk_gv))
                    tk_no += ct.Tk_gv + "; ";
                if (!tk_co.Contains(ct.Tk_vt))
                    tk_co += ct.Tk_vt + "; ";
                _curModel.LSCt[i].Stt = i + 1;
                i++;

            }
            String sql = $"SELECT tk,ps_no ,ps_co FROM ct00 WHERE stt_rec = '{_curModel.LSPh[0].Stt_rec}' ";
            DataSet ds = myDb.LoadDataSet(sql);
            List<HachToan> lstHachToan = new List<HachToan>();
            decimal total_ps_no = 0;
            decimal total_ps_co = 0;
            if (ds != null && ds.Tables.Count > 0)
            {

                int stt = 0;
                foreach (DataRow dr in ds.Tables[0].Rows)
                {
                    HachToan hachToan = new HachToan();
                    hachToan.Tk = dr["tk"].ToString();
                    hachToan.Ps_no = decimal.Parse(dr["ps_no"].ToString());
                    hachToan.Ps_co = decimal.Parse(dr["ps_co"].ToString());
                    hachToan.Stt = stt;
                    hachToan.Dien_giai = _curModel.LSPh[0].Dien_giai;
                    stt++;
                    total_ps_no += hachToan.Ps_no;
                    total_ps_co += hachToan.Ps_co;
                    lstHachToan.Add(hachToan);
                }
            }
            _curModel.Tk_co = tk_co;
            _curModel.Tk_no = tk_no;
            _curModel.TotalString = DocSo.Doc_so(_curModel.LSPh[0].T_tt_nt, myOption, myDb, false);
            _curModel.T_tien_nt_String = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, false);
            _curModel.T_tien_nt2_String = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt2, myOption, myDb, false);
            _curModel.DateString = ToDateString(_curModel.LSPh[0].Ngay_ct);
