        color: #b54708;
        background: #fff6ed;
        border: 1px solid #fcd9b6;
        border-radius: 999px;
        box-shadow: 0 1px 2px rgba(181, 71, 8, 0.08);
    }

        .vc-section-badge::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #f79009;
        }

    /* Dải thẻ KPI tổng quan phía trên lưới phiếu */
