<div class="w-100">
    <div class="d-flex justify-content-between align-items-center mb-2 mx-2 rounded-1 border  border-1 bg-light">
        <div>
            <h8 class="fw-semibold m-0 ps-2" style="color:dodgerblue">@Lap["Import data from Excel file"] - @CurDmimex.Ten</h8>
        </div>
        <div class="d-flex justify-content-end gap-2 me-1">
            <DxButton Text="Nhận"
                      RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="@InsertDataToDatabase"
                      CssClass="px-4  my-1">
                <span><i class="fas fa-save"></i>@context</span>
            </DxButton>
            <DxButton Text="Hủy"
                      RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="@Cancel"
                      CssClass="px-4  my-1"><span><i class="fas fa-close"></i>@context</span></DxButton>
        </div>
   </div>
   <div class="row m-2 rounded-1 border  border-1 ">
        <DxFormLayout Data="@CurDmimex" SizeMode="@Itemsizemode" CssClass="frm-header sis-form my-2" onkeydown="ModifyEnterKeyPressAsTab(event);">
            <DxFormLayoutItem Caption="@Lap["Data to be transferred"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                <Template>
                    <DxTextBox Text="@CurDmimex.Ten" ReadOnly="true" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["File name"]"BeginRow="true">
                <Template>
                    <DxTextBox @bind-Text="@FilePath" ReadOnly="true"/>                    
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="2">
                <Template>
                    <DxButton Id="overviewDemoSelectButton"                            
                              RenderStyle="ButtonRenderStyle.Primary" CssClass="w-100"
                              Text="..." />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="2">
                <Template>
                    <DxButton Text="@Lap["See"]" CssClass="w-100"
                              RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"                              
                              Click="@OpenExcelFile" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="2">
                <Template>
                    <DxButton Text="@Lap["Download example"]" CssClass="w-100 h-60"
                              RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"                              
                              Click="DownloadExamle" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@Lap["Book code"]" ColSpanMd="6">
                <Template>
                    <AutocompleteComponent Id="ma_qs_input" CssClass="col p-0" Ma_dm="dmqs" @bind-Value="@CurDmimex.Ma_qs" Filter="@_filter_qs" IsLangEn="@IsLangEn"></AutocompleteComponent>
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@Lap["Documents with duplicate numbers"]" ColSpanMd="6" BeginRow="true">
                <DxComboBox ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                            Data="@(new List<listItem> { new listItem { ma_item = "0", ten_item = Lap["No duplicates"] }, new listItem { ma_item = "1", ten_item = Lap["Overwrite"] }, new listItem { ma_item = "2", ten_item = Lap["Duplicate"] } })"
                            TextFieldName="@nameof(listItem.ten_item)"
                            ValueFieldName="@nameof(listItem.ma_item)"
                            AllowUserInput="true"
                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                            @bind-Value="@CurDmimex.Overwrite">
                    <Columns>
                        <DxListEditorColumn FieldName="@nameof(listItem.ma_item)" Caption=@Lap["ID"] Width="80px" />
                        <DxListEditorColumn FieldName="@nameof(listItem.ten_item)" Caption=@Lap["Name"] />
                    </Columns>
                </DxComboBox>
            </DxFormLayoutItem>
        </DxFormLayout>

    </div>
</div>
<DxFileInput Visible="@UploadVisible"
             ExternalSelectButtonCssSelector="#overviewDemoSelectButton"
             ExternalDropZoneCssSelector="#overviewDemoDropZone"
             ExternalDropZoneDragOverCssClass="custom-drop-zone-hover"
             MaxFileSize="2147483647"
             AllowMultiFileUpload="false"
             FilesUploading="OnFilesUploading"
             SelectedFilesChanged="@SelectedFilesChanged">
</DxFileInput>
<DxPopup @bind-Visible="@isPopupVisible"
         HeaderText=@Lap["Data Excel file"]
         Width="80%"
         Height="600px"
         ShowCloseButton="true"
         CloseOnOutsideClick="true">
    <BodyContentTemplate>
        @if (dataExcel == null || dataExcel.Rows.Count == 0)
        {
            <p>@Lap["No data"]</p>
        }
        else
        {
            <DxGrid Data="@dataExcel"
                    ShowBorders="true"
                    ShowRowLines="true"
                    ColumnAutoWidth="true"
                    CssClass="p-2"
                    HorizontalScrollMode="HorizontalScrollMode.Auto"
                    ShowPager="true"
                    PageSize="20">
                <Columns>
                    @foreach (DataColumn col in dataExcel.Columns)
                    {
                        <DxGridDataColumn FieldName="@col.ColumnName" Width="150px" />
                    }
                </Columns>
            </DxGrid>
            @*  <div class="mt-3">
                <DxButton Text="Chèn dữ liệu vào cơ sở dữ liệu" Click="InsertDataToDatabase" />
            </div> *@
        }
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public Dmimex CurDmimex { get; set; }
    [Parameter] public EventCallback OnImportCompleted { get; set; }
