    public virtual async Task InsertDataToDatabase()
    {
        if (String.IsNullOrEmpty(FilePath))
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }        
        if (String.IsNullOrEmpty(CurDmimex.Ma_qs))
        {
            myStateMN.SetNewThongbao(Lap["Book code is required"]);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_qs_input')?.focus()");
            return;
        }

        if (dataImport == null || dataImport.Tables["DataExcel"] == null ||
            dataImport.Tables["StrucDmhd"] == null || dataImport.Tables["StrucDmhdct"] == null)
        {
            myStateMN.SetNewThongbao(Lap["Upload error"] + ":" + Lap["Invalid table structure"]);
            return;
        }

        try
        {
            DataTable dataExcel = dataImport.Tables["DataExcel"];
            DataTable structDmhd = dataImport.Tables["StrucDmhd"];
            DataTable structDmhdct = dataImport.Tables["StrucDmhdct"];

            // Chuẩn bị cột cho Dmhd
            string columnsDmhd = "[stt_rec],[ma_ct],[status],";
            foreach (DataRow row in structDmhd.Rows)
            {
                string columnName = row["column_name"].ToString();
                if (dataExcel.Columns.Contains(columnName) && columnName != "[stt_rec]")
                {
                    columnsDmhd += $"[{columnName}],";
                }
            }
            columnsDmhd = columnsDmhd.TrimEnd(',');

            // Chuẩn bị cột cho Dmhdct
            string columnsDmhdct = "[stt_rec],[ma_ct],[ma_hd],";
            foreach (DataRow row in structDmhdct.Rows)
            {
                string columnName = row["column_name"].ToString();
                if (dataExcel.Columns.Contains(columnName) && columnName != "[stt_rec]")
                {
                    columnsDmhdct += $"[{columnName}],";
                }
            }
            columnsDmhdct = columnsDmhdct.TrimEnd(',');

            if (string.IsNullOrEmpty(columnsDmhd) && string.IsNullOrEmpty(columnsDmhdct))
            {
                myStateMN.SetNewThongbao(Lap["Upload error"] + ":" + Lap["Invalid column"] + "!");
                return;
            }
            int i = 0;
            DataTable tblDbfmau = myDb.GetTable("Delete from " + CurDmimex.Dbf_mau.Trim() + ";Select * from " + CurDmimex.Dbf_mau.Trim() + " where 1=0");
            if (tblDbfmau != null)
            {
                DataRow rowDbfmau = tblDbfmau.NewRow();
                rowDbfmau["stt"] = 0;
                rowDbfmau["user_id"] = curUser.User_id;
                rowDbfmau["user_id0"] = curUser.User_id;
                rowDbfmau["date0"] = DateTime.Now.Date;
                rowDbfmau["time0"] = DateTime.Now.ToString("HH:mm:ss");
                int jrow = 0;
                foreach (DataRow row in dataExcel.Rows)
                {
                    jrow++;
                    CopyDataRow(row, rowDbfmau);
                    rowDbfmau["stt"] = jrow;
                    await myDb.InsertData(CurDmimex.Dbf_mau.Trim(), rowDbfmau);
                }
                //CheckData
                string _ma_dvcs = myStateMN.GetMa_Dvcs();
                string strsql = $"EXEC {CurDmimex.Postproc.Split(',')[0].ToString()} {curUser.User_id}, '{CurDmimex.Ma_qs.Trim()}', '{_ma_dvcs.Trim()}', '{CurDmimex.Overwrite.Trim()}'";
                DataSet dataSet = myDb.LoadDataSet(strsql);
                tbStt_rec = dataSet.Tables[dataSet.Tables.Count - 1].Copy();
                tbDuLieuTrung = dataSet.Tables[dataSet.Tables.Count - 2].Copy();
                bool flag = ShowErr(dataSet, CurDmimex.Ma_imex);
                if (flag)
                {
                    myStateMN.SetNewThongbao(Lap[$"Import erro"]);
                }
                else
                {
                    await Post();
                    myStateMN.SetNewThongbao(Lap["Data import success"] + " !");
                }
                await OnImportCompleted.InvokeAsync();
                await Cancel();                
            }        
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap[$"Import erro"] + ":" + ex.Message);
        }

        InvokeAsync(StateHasChanged);
    }
    public static DataTable tbStt_rec = new DataTable();
    public static DataTable tbDuLieuTrung = new DataTable();
    public static DataTable tb_Post_Error = new DataTable();
    public virtual async Task Post()
    {            
        if (dataImport?.Tables["DataExcel"] == null ||
            dataImport.Tables["StrucDmhd"] == null ||
            dataImport.Tables["StrucDmhdct"] == null)
        {
            myStateMN.SetNewThongbao(Lap["Invalid table structure"]);
            return;
        }

        try
        {
            var postProcName = CurDmimex.Postproc?.Split(',')[1]?.Trim();
            if (string.IsNullOrEmpty(postProcName))
            {
                myStateMN.SetNewThongbao(Lap["Invalid post procedure"]);
                return;
            }

            tb_Post_Error = tbStt_rec.Clone();
            tb_Post_Error.Columns.Add("ly_do_loi", typeof(string));
            int count = tbStt_rec.Rows.Count;           

            bool hasError = false;
            int processedCount = 0;

            foreach (DataRow row in tbStt_rec.Rows)
            {
                try
                {
                    string sttRec = row["stt_rec"]?.ToString().Trim() ?? "";
                    string storedProc = $"EXEC {postProcName} '{sttRec}'";

                    await myDb.ExecuteSqlQueryAsync(storedProc);
                    processedCount++;
                }
                catch (Exception ex)
                {
                    DataRow errorRow = tb_Post_Error.NewRow();
                    errorRow.ItemArray = row.ItemArray;
                    errorRow["ly_do_loi"] = ex.Message;
                    tb_Post_Error.Rows.Add(errorRow);
                    hasError = true;
                }                
            }

            if (hasError)
            {                
                foreach (DataRow row2 in tbStt_rec.Rows)
                {
                    string CommandText = string.Format("EXEC [dbo].[DeleteVoucher] '{0}', '{1}'", CurDmimex.Ma_ct.Trim(), row2["stt_rec"].ToString().Trim());
                    await myDb.ExecuteSqlQueryAsync(CommandText);
                }
                myStateMN.SetNewThongbao(Lap["Some records failed to post"]);
                //Show bảng lỗi
                string TitleErr = (!IsLangEn ? "Các chứng từ bị lỗi khi post" : "The post data errors");
                string strbrowse = !IsLangEn ? "ly_do_loi:H=Lý do lỗi;ngay_ct:H=Ngày c.từ:130;ma_qs:H=Mã quyển c.từ  :130;so_ct:H=Số c.từ:130;stt_rec:0:H=stt_rec" : "ly_do_loi:H=Error description;ngay_ct:H=Voucher date:130;ma_qs:H=Book code:130;so_ct:H=Voucher no.:130;stt_rec:0:H=Stt_rec";
                SisLib.ReportLib.BrowTable(myModal, tb_Post_Error, strbrowse, " : " + TitleErr, Lap["Cancel"]);
            }
            else if (CurDmimex.Overwrite?.Trim() == "1")
            {     
                foreach (DataRow row3 in tbDuLieuTrung.Rows)
                {
                    string CommandText = string.Format("EXEC [dbo].[DeleteVoucher] '{0}', '{1}'", CurDmimex.Ma_ct.Trim(), row3["stt_rec"].ToString().Trim());
                    myDb.ExecuteSqlQueryAsync(CommandText);
                }                          
            }
            else
                myStateMN.SetNewThongbao(Lap["Post completed successfully"]);
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Post error"] + ": " + ex.Message);
        }    
    }
    public bool ShowErr(DataSet dsError, string maImex)
    {
        if (dsError != null && dsError.Tables.Count != 0 && ShowError is not null)
        {
            return ShowError(new DataErrArgs(dsError, maImex)); 
        }

        return false;
    }
    public static void CopyDataRow(DataRow source, DataRow target)
    {
        foreach (DataColumn col in source.Table.Columns)
        {
            if (target.Table.Columns.Contains(col.ColumnName))
            {
                object value = source[col.ColumnName];

                if (value == DBNull.Value)
                {
                    target[col.ColumnName] = DBNull.Value;
                    continue;
                }

                Type targetType = target.Table.Columns[col.ColumnName].DataType;

                try
                {                    
                    if (value.GetType() == targetType)
                    {
                        target[col.ColumnName] = value;
                    }
                    else
                    {                        
                        var converted = Convert.ChangeType(value, targetType);
                        target[col.ColumnName] = converted;
                    }
                }
                catch
                {                    
                    target[col.ColumnName] = DBNull.Value;
                }
                bool isNumericType = targetType == typeof(byte) ||
                                 targetType == typeof(short) ||
                                 targetType == typeof(int) ||
                                 targetType == typeof(long) ||
                                 targetType == typeof(float) ||
                                 targetType == typeof(double) ||
                                 targetType == typeof(decimal);

                if (isNumericType)
                {
                    if (target.IsNull(col.ColumnName))
                    {
                        target[col.ColumnName] = 0;
                    }
                }
            }
        }
    }

    private object ConvertToPropertyType(object value, Type targetType)
    {
        if (targetType == typeof(string)) return value.ToString();
        if (targetType == typeof(int) || targetType == typeof(int?)) return Convert.ToInt32(value);
        if (targetType == typeof(decimal) || targetType == typeof(decimal?)) return Convert.ToDecimal(value);
        if (targetType == typeof(DateTime) || targetType == typeof(DateTime?)) return Convert.ToDateTime(value);
        if (targetType == typeof(bool) || targetType == typeof(bool?)) return Convert.ToBoolean(value);
        return Convert.ChangeType(value, targetType);
    }

