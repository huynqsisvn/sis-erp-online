    public virtual async void InsertDataToDatabase()
    {
        if(String.IsNullOrEmpty(fileName))
        {
            myStateMN.SetNewThongbao(Lap["Please select excel file"]);
            return;
        }
        if (dataImport == null || dataImport.Tables["DataExcel"] == null || string.IsNullOrEmpty(sqlTableName))
        {
            myStateMN.SetNewThongbao(Lap["Data error"] +"!");
            return;
        }

        try
        {
            DataTable dataExcel = dataImport.Tables["DataExcel"];
            DataTable structTable = dataImport.Tables["StrucImex"];
            if (dataExcel == null || dataExcel.Rows.Count == 0)
            {
                myStateMN.SetNewThongbao(Lap["No data"] + "!");
                return ;
            }

            string columns = "";
            foreach (DataRow row in structTable.Rows)
            {
                string columnName = row["column_name"].ToString();
                if (dataExcel.Columns.Contains(columnName))
                {
                    columns += $"[{columnName}],";
                }
            }
            if (string.IsNullOrEmpty(columns))
            {
                myStateMN.SetNewThongbao(Lap["Data error"] + "!");
                return;
            }
            if (!CheckKeyNull(dataExcel, CurDmimex.Khoa))
                return;
            if (!KiemTraKyTuDacBiet(dataExcel, CurDmimex.Ma_imex))
            {
                return;
            }
            if (CheckDataBeForeIns != null)
            {
                if (!CheckDataBeForeIns.Invoke(dataExcel))
                {
                    return;
                }
            }

            columns = columns.TrimEnd(',');

            foreach (DataRow row in dataExcel.Rows)
            {
                DataTable tempTable = dataExcel.Clone();
                DataRow filteredRow = tempTable.NewRow();
                string values = "";
                foreach (DataRow structRow in structTable.Rows)
                {
                    string columnName = structRow["column_name"].ToString();
                    if (dataExcel.Columns.Contains(columnName))
                    {                        
                        if (row[columnName] == null || row[columnName] == DBNull.Value || string.IsNullOrWhiteSpace(row[columnName]?.ToString()))
                        {
                            values += "NULL,";
                        }
                        else
                        {
                            string value = row[columnName].ToString();
                            string dataType = structRow["data_type"]?.ToString().ToLower() ?? "nvarchar";
                            if (dataType.Contains("char") || dataType.Contains("text"))
                            {
                                value = "N'" + value.Replace("'", "''") + "'";
                            }
                            else if (dataType.Contains("date") || dataType.Contains("time"))
                            {
                                if (DateTime.TryParse(value, out DateTime dateValue))
                                {
                                    value = $"'{dateValue:yyyy-MM-dd HH:mm:ss}'";
                                }
                                else
                                {
                                    value = "NULL";
                                }
                            }
                            else if (dataType.Contains("int") || dataType.Contains("decimal") || dataType.Contains("float") || dataType.Contains("numeric"))
                            {
                                value = value.Replace(",", "."); // Đảm bảo định dạng số phù hợp
                            }
                            else
                            {
                                value = "N'" + value.Replace("'", "''") + "'";
                            }
                            values += $"{value},";
                        }
                    }
                }                
                values = values.TrimEnd(',');

                string sql = $"INSERT INTO {CurDmimex.Dbf_mau.Trim()} ({columns}) VALUES ({values})";

                await myDb.ExecuteSqlQueryAsync(sql);
            }

            bool ok = await Post();
            if (!ok)
            {
                return;
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["Data import successful"] + " !");
                await OnImportCompleted.InvokeAsync();
                Cancel();
            }

        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Error while importing data"] + ": " + ex.Message);

        }
    }
    public async Task<bool> Post()
    {
        try
        {
            string text = CurDmimex.Kt_long;
            string M_CHECK_LONG = myOptions.GetOptionsValue("M_CHECK_LONG").ToString().Trim();
            string pMa_dvcs = myStateMN.GetMa_Dvcs();
            string pUser_id = myStateMN.GetCurUser().User_id.ToString().Trim();
            if (M_CHECK_LONG.Equals("1"))
            {
                text = "0";
            }
            string strsql = $"EXEC {CurDmimex.Postproc} '{CurDmimex.Kt_trung}', '{text}', {pUser_id}, '{CurDmimex.Overwrite}', '{pMa_dvcs.Trim()}'";           
            DataSet dataSet = myDb.LoadDataSet(strsql);
            bool flag = await ShowErr(dataSet, CurDmimex.Ma_imex);
            if (flag)
            {
                myStateMN.SetNewThongbao(Lap[$"Import erro"]);
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["Data import success"] + "!");
            }
            return !flag;
        }
        catch (Exception ex)
        { 
            myStateMN.SetNewThongbao(Lap["Data import fail"] + " !");
            return false;
        }
    }
    public async Task<bool> ShowErr(DataSet dsError, string maImex)
    {
        if (dsError != null && dsError.Tables.Count != 0 && ShowError is not null)
        {
            bool ok = await ShowError(new DataErrArgs(dsError, maImex));
            return ok;
        }

        return false;
    }
    private bool KiemTraKyTuDacBiet(DataTable tb_excel, string ma_iemx)
    {
        string M_CHR_ERR = mySysVar.GetSysVar("M_CHR_ERR");
        string text = ma_iemx;
        string[] array = text.Split(';');
        DataTable dataTable = tb_excel.Clone();
        for (int i = 0; i < tb_excel.Rows.Count; i++)
        {
            bool isImportR = false;
            for (int j = 0; j < array.Length; j++)
            {
                if (!tb_excel.Columns.Contains(array[j].Trim()))
                {
                    continue;
                }
                
                for (int k = 0; k < M_CHR_ERR.Length; k++)
                {
                    if (M_CHR_ERR[k].ToString().Trim() != "")
                    if (tb_excel.Rows[i][array[j].Trim()].ToString().Trim().IndexOf(M_CHR_ERR[k].ToString().Trim()) >= 0 || tb_excel.Rows[i][array[j].Trim()].ToString().Trim().IndexOf(" ") > 0)
                    {                        
                        isImportR = true;
                        break;
                    }
                }               
            }
            if (isImportR)
            {
                dataTable.ImportRow(tb_excel.Rows[i]);                
            }
        }
        if (dataTable.Rows.Count > 0)
        {
            SisLib.ReportLib.BrowTable(myModal, dataTable, StrBrowseKhoa_dac_biet, Lap["ID are not allowed to contain spaces or special characters"] + " :" + M_CHR_ERR + "!");
            return false;
        }
        return true;
    }
