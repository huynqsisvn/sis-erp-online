@inherits FrmListBaseComponent

<div class="w-100">
    <FormList Title="@Title" @bind-curActionTask="@curActionTask" OnSave="@SaveDM" OnEdit="@OnEdit" OnCopy="@OnCopy" OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmtknh" ItemSizeMode="@Itemsizemode" CssClass="frm-header sis-form" onkeydown="ModifyEnterKeyPressAsTab(event);">
                
                <DxFormLayoutItem Caption="@Lap["Account"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                    <Template>
                        <AutocompleteComponent Id="tk_input" Ma_dm="dmtk" @bind-Value="@CurDmtknh.Tk" AllowNull="false" IsEnable="@AllowEditMa" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Bank account number"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Tk_nh" Enabled="@AllowEditMode" InputCssClass="uppercase" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Bank name"]" ColSpanMd="12">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Ten_nh" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@(Lap["Bank name"] + " 2")" ColSpanMd="12">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Ten_nh2" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Province/City"]" ColSpanMd="12">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Tinh_thanh" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Phone"]" ColSpanMd="6">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Dien_thoai" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Fax"]" ColSpanMd="6">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Fax" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["E mail"]" ColSpanMd="6">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.E_mail" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Website"]" ColSpanMd="6">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Home_page" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Contact"]" ColSpanMd="12">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtknh.Doi_tac" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12">
                    <Template>
                        <DxMemo @bind-Text="@CurDmtknh.Ghi_chu" Enabled="@AllowEditMode" Rows="3" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmtknh.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="@nameof(Dmtk.Ma)" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="@nameof(Dmtk.Ten)" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmtknh CurDmtknh;
    private string menu_id = "wa.dm.03";

    protected override void OnInitialized()
    {
        sqlTableName = "dmtknh";
        sqlTableView = "v_dmtknh";
        SqlTableKey = "tk";
        CheckSqlTableKey = "tk";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "dmtknh" : ParentPage;
        CurDmtknh = new Dmtknh();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    {
                        if (!string.IsNullOrEmpty(Ma_ma))
                            await ViewDM(Ma_ma);
                        myStateMN.SetToolBar(new MyToolbar("save", false));
                        break;
                    }
                case ActionTask.Edit:
                    {
                        if (!string.IsNullOrEmpty(Ma_ma))
                            await EditDM(Ma_ma);
                        break;
                    }
                case ActionTask.New:
                    {
                        await CreateNewDM();
                        break;
                    }
                case ActionTask.Copy:
                    {
                        await CreateCopyDM(Ma_ma);
                        break;
                    }
                default:
                    {
                        if (!string.IsNullOrEmpty(Ma_ma))
                            await ViewDM(Ma_ma);
                        break;
                    }
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('tk_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string SqlTableKeyValue)
    {
        CurDmtknh = new Dmtknh();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(SqlTableKeyValue);
        StateHasChanged();
    }

    async Task EditDM(string SqlTableKeyValue)
    {
        CurDmtknh = new Dmtknh();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(SqlTableKeyValue);
        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(Ma_ma);
    }

    async Task SaveDM()
    {
        if (curActionTask == ActionTask.New)
            if (!CheckValidCode())
                return;

        if (!CheckValid())
            return;

        CurDmtknh.Tk = CurDmtknh.Tk.ToUpper().Trim();
        SqlTableKeyValue = CurDmtknh.Tk;

        if (curActionTask == ActionTask.New)
        {
            CurDmtknh.Date = DateTime.Now.Date;
            CurDmtknh.Date0 = DateTime.Now.Date;
            CurDmtknh.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmtknh.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtknh.User_id = curUser.User_id;
                CurDmtknh.User_id0 = curUser.User_id;
                CurDmtknh.User_name = curUser.User_name;
                CurDmtknh.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmtknh.Tk.Trim();
            string[] strKey = CheckSqlTableKey.Split(';');
            string[] strKeyValue = CheckSqlTableKeyValue.Split(';');
            string condition = "";
            if (strKey.Length > 0)
            {
                for (int x = 0; x < strKey.Length; x++)
                {
                    condition += strKey[x] + " = N'" + strKeyValue[x].ToUpper() + "' and ";
                }
                if (!string.IsNullOrEmpty(condition))
                    condition = condition.Substring(0, condition.Length - 4);
            }
            string check = "Select " + strKey[0] + " from " + sqlTableName + " where " + condition;
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
            }
            else
            {
                CurDmtknh.Search = $"{CurDmtknh.Tk} {CurDmtknh.Ten_nh} {CurDmtknh.Ten_nh2}";
                await myDb.InsertOneRow<Dmtknh>(CurDmtknh, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmtknh.Date = DateTime.Now.Date;
            CurDmtknh.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtknh.User_id = curUser.User_id;
                CurDmtknh.User_name = curUser.User_name;
            }

            CurDmtknh.Search = $"{CurDmtknh.Tk} {CurDmtknh.Ten_nh} {CurDmtknh.Ten_nh2}";
            await myDb.UpdateOneRow<Dmtknh>(CurDmtknh, sqlTableName, SqlTableKey, Ma_ma);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        // Đóng Form nhập
        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmtknh.Tk))
        {
            myStateMN.SetNewThongbao(Lap["Account is required"]);
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrEmpty(CurDmtknh.Ten_nh))
        {
            myStateMN.SetNewThongbao(Lap["Bank name is required"]);
            StateHasChanged();
            return false;
        }
        return true;
    }

    public async Task LoadData(string SqlTableKeyValue)
    {
        string sql = $"Select * from {sqlTableView} where {SqlTableKey} = '{SqlTableKeyValue}'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmtknh> lsdetai = myDb.ConvertDataTable<Dmtknh>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmtknh = lsdetai[0];
            }
        }
    }

    public async Task CreateNewDM()
    {
        CurDmtknh = new Dmtknh();
        CurDmtknh.Status = "1";
        
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string SqlTableKeyValue)
    {
        CurDmtknh = new Dmtknh();
        await LoadData(SqlTableKeyValue);

        CurDmtknh.Status = "1";
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }   
}
