                                                    <DxDateEdit @bind-Date="@_Ct32.Ngay_ct0" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode">
                                                    </DxDateEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

