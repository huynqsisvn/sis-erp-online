                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct32.Tt_nt" ValueExpression="@(() => _Ct32.Tt_nt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tt_nt"); })" Id="Tt_nt"></DxSpinEdit>
