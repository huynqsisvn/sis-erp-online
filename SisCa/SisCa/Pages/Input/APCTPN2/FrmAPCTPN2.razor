                                                    <DxTextBox @bind-Text="@_Ct32.Dien_giaii" Enabled="@AllowEditMode" Id="Dien_giaii"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Loai_hd" Caption="@Lap["Type HD"].ToString()" Width="110" CaptionAlignment="GridTextAlignment.Center">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct32 = (Ct32)GrdContext.EditModel;
                                                    }
