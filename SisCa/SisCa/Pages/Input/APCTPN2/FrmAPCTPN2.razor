    private async Task OnPopupVisibleChanged(bool newVisible)
    {
        Visible = newVisible;
        if (!newVisible)
        {
            if (SelectedDataItems != null)
            {
                @foreach (DataRowView product in SelectedDataItems.Cast<Object>())
                {
                    if (CurrentEditModel != null)
                    {
                        CurrentEditModel.Stt_rec_tt = product.Row["stt_rec"].ToString();
                    }
                }

                foreach (DataRow row in sourceTable.Rows)
                {
                    if (CurrentEditModel.Stt_rec_tt.Equals(row["stt_rec"].ToString()))
                    {
                        CurrentEditModel.Tien_hd = row["tien_hd"] == DBNull.Value ? 0 : Convert.ToDecimal(row["tien_hd"]);
                        CurrentEditModel.Ngay_ct0 = Convert.ToDateTime(row["ngay_ct"]);
                        CurrentEditModel.So_ct0 = row["so_ct"].ToString();
                        CurrentEditModel.Tk_i = row["tk"].ToString();
                        CurrentEditModel.Ma_nt_i = row["ma_nt"].ToString();
                        CurrentEditModel.Tien_nt = CurrentEditModel.Tien_hd;
                        CurrentEditModel.Stt_rec_tt = row["stt_rec"].ToString();
                        CurrentEditModel.Ma_vv_i = row["ma_vv"].ToString();
                        CurrentEditModel.Ma_td_i = row["ma_td"].ToString();
                        CurrentEditModel.Ma_td2_i = row["ma_td2"].ToString();
                        CurrentEditModel.Ma_td3_i = row["ma_td3"].ToString();
                        CurrentEditModel.So_lsx_i = row["so_lsx"].ToString();
                        CurrentEditModel.So_dh_i = row["so_dh"].ToString();
                        CurrentEditModel.Ma_bpht_i = row["ma_bpht"].ToString();
                        CurrentEditModel.Ma_hd_i = row["ma_hd"].ToString();
                        CurrentEditModel.Ma_ku_i = row["ma_ku"].ToString();
                        CurrentEditModel.Ma_phi_i = row["ma_phi"].ToString();
                        CurrentEditModel.Ma_sp = row["ma_sp"].ToString();
                        StateHasChanged();
                        IsShowHD = true;

                    }
                }
            }
            else
            {
                if (CurrentEditModel != null)
                {
                    LSCt.RemoveAll(x => x.Stt_rec == CurPh.Stt_rec && x.Stt_rec0 == CurrentEditModel.Stt_rec0);
                    await GridCT.SaveChangesAsync();
                }

            }
        }
    }


    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        CurPh = new Ph32();
        CurCt = new Ct32();
        LSCt = new List<Ct32>();
        LSCtgt = new List<Ct32gt>();

        LoadQuyenso();
        LoadOptions();
        _filter_qs = String.Format("ma_cts = '' OR ma_cts like '{0}%'", Ma_ct);
        M_DC_THUE_CK = myOption.GetOptionsValue("M_DC_THUE_CK");
        M_MAU_THUE_CK = myOption.GetOptionsValue("M_MAU_THUE_CK");
        M_ma_ms = myOption.GetOptionsValue("M_MA_MS");
        Ma_dvcs = myStateMN.GetMa_Dvcs();
        LanguageID = "ca";
        ParentReload = false;
        switch (curActionTask)
        {
            case ActionTask.View:
                {
                    Pagetitle = Lap["View"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                    V_Xem();
                    break;
                }
            case ActionTask.Edit:
                {
                    Pagetitle = Lap["Edit"] + ": " + (IsLangEn ? curDmct.Ten_ct2.ToString().Trim() : curDmct.Ten_ct.ToString().Trim());
                    V_Sua();
                    break;
                }
            case ActionTask.New:
                {
                    Pagetitle = Lap["New"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                    V_Moi();
                    break;
                }
            default:
                {
                    Pagetitle = Lap["View"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                    V_Xem();
                    break;
                }
        }
