                                                </CellEditTemplate>
                                            </DxGridDataColumn>


                                            <DxGridDataColumn FieldName="Ma_ms" Caption="@Lap["Group hd"].ToString()" Width="120" CaptionAlignment="GridTextAlignment.Center" Visible="@IsVisibleGridColumn("Ma_ms")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct32 = (Ct32)GrdContext.EditModel;
                                                    }
                                                    <AutocompleteComponent Ma_dm="dmms" @bind-Value="@_Ct32.Ma_ms" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_ms"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            <DxGridDataColumn FieldName="So_ct0" Caption="@Lap["Invoice no."].ToString()"
