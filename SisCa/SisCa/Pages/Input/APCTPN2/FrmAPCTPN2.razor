    public override object SelectedDataItemCT
    {
        get => selectedDataItemCT;
        set
        {
            if (isBlockingCT) return;
            if (selectedDataItemCT != null && string.IsNullOrWhiteSpace(((Ct32)selectedDataItemCT).Tk_vt))
            {
                isBlockingCT = true;
                myStateMN.SetNewThongbao(Lap["Code cannot be empty"] + "!");
                _ = InvokeAsync(async () =>
                {
                    if (GridCT.IsEditing()) // nếu đang edit dòng hiện tại
                    {
                        await GridCT.SaveChangesAsync();
                    }
                    await Task.Yield();
                    await GridCT.StartEditDataItemAsync(LSCt.IndexOf((Ct32)selectedDataItemCT), "Tk_vt");
                    isBlockingCT = false;
                });

                return;
            }
            selectedDataItemCT = value;
        }
    }
    public override object SelectedDataItemCTGT
    {
