    private async Task GridCT_OnKeyDown(KeyboardEventArgs e)
    {
        if (!AllowEditMode)
            return;

        switch (e.Key)
        {
            case "Enter":
                await GridCT.SaveChangesAsync();
                await SaveAndMoveNextRow();
                break;

            case "F4":
                // Add new row
                AddNewCT();
                break;

            case "F8":
                // Delete selected row (confirm)
                if (SelectedDataItemCT != null)
                {
                    GridCT.ShowDataItemDeleteConfirmation(SelectedDataItemCT);
                }
                else
                {
                    Message = Lap["No data selected"];
                    StateHasChanged();
                }
                break;

            case "Escape":
                // Cancel current edit
                try
                {
                    await GridCT.CancelEditAsync();
                    // if user cancels a newly added empty row, remove it
                    if (LSCt.Count > 0 && CurrentEditModel != null && string.IsNullOrEmpty(CurrentEditModel.Tk_i))
                        LSCt.Remove(CurrentEditModel);
                }
                catch { }
                break;


        }
    }
