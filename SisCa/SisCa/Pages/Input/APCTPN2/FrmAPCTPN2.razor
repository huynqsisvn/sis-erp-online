    private void UpdateTotalThue()
    {
        try
        {
            if (curActionTask == ActionTask.View)
                return;

            decimal result1 = 0; // t_thue_nt
            decimal result2 = 0; // t_thue

            if (LSCtgt != null && LSCtgt.Any())
            {
                result1 = LSCtgt.Sum(th => th.T_thue_nt);
                result2 = LSCtgt.Sum(th => th.T_thue);
            }

            decimal num3 = CurPh.T_tien_nt + result1;
            decimal num4 = CurPh.T_tien + result2;

            CurPh.T_thue_nt = result1;
            CurPh.T_thue = result2;
            CurPh.T_tt_nt = num3;
            CurPh.T_tt = num4;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi trong UpdateTotalThue: {ex.Message}");
        }
    }

    private void CalculateTyGia()
    {
        if (CurPh.Ty_gia != new Decimal(0))
        {
            Decimal num1 = new Decimal(0);
            Decimal nValue = CurPh.Ty_gia;
            Decimal num2;
            Decimal num3;
            Decimal num4;
            if (CurPh.Sua_tien == 0)
            {
                for (int index = 0; index < LSCt.Count; ++index)
                {
                    if (LSCt[index].Loai_hd.Trim().Equals("2"))
                    {
                        this.CalculateHd2(LSCt[index]);
                    }
                    else
                    {
                        num2 = new Decimal(0);
                        num3 = new Decimal(0);
                        Decimal num5 = new Decimal(0);
                        Decimal num6 = new Decimal(0);
                        Decimal num7 = LSCt[index].Tien_nt;
                        if (nValue * num7 > new Decimal(0))
                        {
                            Decimal num8 = Math.Round(nValue * num7, (int)Convert.ToInt16(M_ROUND));
                            LSCt[index].Tien = num8;
                            Decimal num9;
                            Decimal num10;
                            if (LSCt[index].Thue_suat != 0)
                            {
                                num4 = new Decimal(0);
                                Decimal num11 = LSCt[index].Thue_suat;
                                num9 = Math.Round(num7 * num11 / new Decimal(100), M_ROUND_NT);
                                num10 = Math.Round(num8 * num11 / new Decimal(100), (int)Convert.ToInt16(M_ROUND));
                                LSCt[index].Thue_nt = num9;
                                LSCt[index].Thue = num10;
                            }
                            else
                            {
                                num9 = LSCt[index].Thue_nt;
                                num10 = LSCt[index].Thue;
                            }
                            LSCt[index].Tt_nt = (num7 + num9);
                            LSCt[index].Tt = (num8 + num10);
                        }
                    }
                }
            }
            if (LSCtgt.Count > 0 && CurPh.Sua_tien == 0)
            {
                for (int index = 0; index < LSCtgt.Count; ++index)
                {
                    if (LSCtgt[index].T_tien_nt != 0)
                    {
                        num2 = new Decimal(0);
                        Decimal num5 = new Decimal(0);
                        num3 = new Decimal(0);
                        Decimal num6 = new Decimal(0);
                        Decimal num7 = LSCtgt[index].T_tien_nt;
                        if (nValue * num7 > new Decimal(0))
                        {
                            Decimal num8 = Math.Round(nValue * num7, (int)Convert.ToInt16(M_ROUND));
                            LSCtgt[index].T_tien = num8;
                            if (LSCtgt[index].Thue_suat != 0)
                            {
                                num4 = new Decimal(0);
                                Decimal num9 = LSCtgt[index].Thue_suat;
                                num5 = Math.Round(num7 * num9 / new Decimal(100), (int)Convert.ToInt16(M_ROUND_NT));
                                LSCtgt[index].T_thue_nt = num5;
                                num6 = Math.Round(num5 * nValue, (int)Convert.ToInt16(M_ROUND));
                                LSCtgt[index].T_thue = num6;
                            }
                            LSCtgt[index].T_tt_nt = (num7 + num5);
                            LSCtgt[index].T_tt = (num8 + num6);
                        }
                    }
                }
            }
        }
        this.UpdateTotalHT();
    }


    private void Update_nt0()
    {
        if (CurPh.Ma_nt != M_ma_nt0)
            return;

        CurPh.T_tien = CurPh.T_tien_tt = CurPh.T_tien_nt;
        CurPh.T_tt = CurPh.T_tt_nt;
        CurPh.T_tien_cltg = 0;
        CurPh.T_thue = CurPh.T_thue_nt;

        foreach (var row in LSCt)
        {
            row.Tien = row.Tien_tt = row.Tien_nt;
            row.Tt = row.Tt_nt;
            row.Thue = row.Thue_nt;
        }

        foreach (var tax in LSCtgt)
        {
            tax.T_thue = tax.T_thue_nt;
            tax.T_tien = tax.T_tien_nt;
        }
    }

