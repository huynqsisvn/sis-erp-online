        CheckedTien = !value;

        IsVisibilityFieldsXamDataGridBySua_Tien();

        if (CurPh.Ma_nt.Trim().ToUpper() == M_ma_nt0.Trim().ToUpper())
            return;

        if (!value)
            return;

        decimal nValue1 = CurPh.Ty_gia;
        UpdateTotalHT();
        if (LSCtgt != null && LSCtgt.Any())
        {
            foreach (var ct in LSCtgt)
            {
                decimal t_tien_nt = ct.T_tien_nt;
                decimal t_thue_nt = ct.T_thue_nt;
                decimal thue_suat = ct.Thue_suat;

                decimal t_tien = Math.Round(nValue1 * t_tien_nt, M_ROUND);

                ct.T_tien = t_tien;

                if (thue_suat > 0)
                {
                    t_thue_nt = Math.Round(t_tien_nt * thue_suat / 100, M_ROUND_NT);
                    decimal t_thue = Math.Round(t_thue_nt * nValue1, M_ROUND);
                    ct.T_thue_nt = t_thue_nt;
                    ct.T_thue = t_thue;
                }

                ct.T_tt_nt = t_tien_nt + t_thue_nt;
                ct.T_tt = t_tien + ct.T_thue;
            }
        }
        StateHasChanged();
    }

    private void CalculateHd2(Ct32 ct)
    {
        // Nếu có thuế suất
        if (ct.Thue_suat > 0)
        {
            decimal tt_nt = ct.Tt_nt;
            decimal ty_gia_ht = CurPh.Ty_gia_ht;
            decimal thue_suat = ct.Thue_suat;

            // Tính tiền và thuế bằng ngoại tệ
            decimal tien_nt = Math.Round(tt_nt / (1 + thue_suat / 100));
            decimal thue_nt = tt_nt - tien_nt;

            ct.Tien_nt = tien_nt;
            ct.Thue_nt = thue_nt;

            // Nếu đơn vị tiền khác tiền chuẩn (VD: ngoại tệ)
            if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                decimal tien = Math.Round(tien_nt * ty_gia_ht);
                decimal thue = Math.Round(thue_nt * ty_gia_ht);
                decimal tt = Math.Round(tt_nt * ty_gia_ht);

                ct.Tien = tien;
                ct.Thue = thue;
                ct.Tt = tt;
            }
            else
            {
                ct.Tien = tien_nt;
                ct.Thue = thue_nt;
                ct.Tt = tt_nt;
            }
        }
        else
        {
            decimal tt_nt = ct.Tt_nt;
            decimal thue_nt = ct.Thue_nt;
            decimal tien_nt = tt_nt - thue_nt;

            ct.Tien_nt = tien_nt;

            if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                decimal ty_gia_ht = CurPh.Ty_gia_ht;
                decimal tien = Math.Round(tien_nt * ty_gia_ht);
                decimal thue = Math.Round(thue_nt * ty_gia_ht);
                decimal tt = Math.Round(tt_nt * ty_gia_ht);

                ct.Tien = tien;
                ct.Thue = thue;
                ct.Tt = tt;
            }
            else
            {
                ct.Tien = tien_nt;
                ct.Thue = thue_nt;
                ct.Tt = tt_nt;
            }
        }
    }


    private void UpdateNt0()
    {
        if (!CurPh.Ma_nt.Equals(M_ma_nt0, StringComparison.OrdinalIgnoreCase))
            return;

        CurPh.T_tien = CurPh.T_tien_tt = CurPh.T_tien_nt;
        CurPh.T_tt = CurPh.T_tt_nt;
        CurPh.T_tien_cltg = 0;
        CurPh.T_thue = CurPh.T_thue_nt;

        if (LSCt != null && LSCt.Any())
        {
            foreach (var ct in LSCt)
            {
                ct.Tien = ct.Tien_tt = ct.Tien_nt;
                ct.Tt = ct.Tt_nt;
                ct.Thue = ct.Thue_nt;
            }
        }

        if (LSCtgt != null && LSCtgt.Any())
        {
            foreach (var ctgt in LSCtgt)
            {
                ctgt.T_thue = ctgt.T_thue_nt;
                ctgt.T_tien = ctgt.T_tien_nt;
            }
        }
        StateHasChanged();
    }

