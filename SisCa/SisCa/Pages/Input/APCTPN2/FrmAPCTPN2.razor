                                                    }
                                                    <DxTextBox @bind-Text="@_Ct32.Kh_mau_hd" Enabled="@AllowEditMode" Id="Kh_mau_hd"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>


