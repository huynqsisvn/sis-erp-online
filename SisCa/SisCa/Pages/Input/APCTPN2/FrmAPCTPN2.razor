                                                    }
                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct32.Thue" ValueExpression="@(() => _Ct32.Thue)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Thue"); })" Id="Thue"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            <DxGridDataColumn FieldName="Tk_thue_cn" ReadOnly="true" Width="0" Visible="@IsVisibleGridColumn("tk_thue_cn")">
