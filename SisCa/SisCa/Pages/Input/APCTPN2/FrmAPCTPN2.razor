    private void CalculateHd2()
    {
        Decimal num1;
        if (CurrentEditModel.Thue_suat != 0)
        {
            num1 = new Decimal(0);
            Decimal result1 = CurrentEditModel.Tt_nt;
            Decimal num2 = new Decimal(0);
            Decimal num3 = new Decimal(0);
            Decimal result2 = CurrentEditModel.Thue_suat;

            Decimal nValue = CurPh.Ty_gia;
            Decimal num4 = result1 / Decimal.Add(result2 / new Decimal(100), 1);
            Decimal num5 = CurPh.Ma_nt.Equals(M_ma_nt0) ? num4 : num4;
            CurrentEditModel.Tien_nt = num5;
            CurrentEditModel.Thue_nt = (result1 - num5);
            if (!CurPh.Ma_nt.Equals(M_ma_nt0))
            {
                Decimal num6 = (num5 * nValue);
                if (num6 > new Decimal(0))
                {
                    Decimal num7 = new Decimal(0);
                    Decimal num8 = new Decimal(0);
                    Decimal num9 = new Decimal(0);
                    Decimal num10 = new Decimal(0);
                    Decimal num11 = new Decimal(0);
                    Decimal num12 = (num6 * result2 / new Decimal(100));
                    Decimal num13 = (result1 * nValue);
                    Decimal num14 = num13 - (num6 + num12);
                    Decimal num15 = (num14 / Decimal.Add(result2 / new Decimal(100), 1));
                    Decimal num16 = num14 - num15;
                    CurrentEditModel.Tien = (num6 + num15);
                    CurrentEditModel.Thue = (num12 + num16);
                    CurrentEditModel.Tt = num13;
                }
            }
            else
            {
                CurrentEditModel.Tien = num5;
                CurrentEditModel.Thue = (result1 - num5);
                CurrentEditModel.Tt = result1;
            }
        }
        else
        {
            Decimal result1 = CurrentEditModel.Tt_nt;
            Decimal result2 = CurrentEditModel.Thue_suat;
            num1 = new Decimal(0);
            Decimal num2 = result1 - result2;
            CurrentEditModel.Tien_nt = num2;
            if (!CurPh.Ma_nt.Equals(M_ma_nt0))
            {
                Decimal num3 = new Decimal(0);
                Decimal num4 = (CurPh.Ty_gia * num2);
                if (num4 > new Decimal(0))
                {
                    Decimal result3 = new Decimal(0);
                    CurrentEditModel.Tien = num4;
                    if (CurrentEditModel.Thue != 0)
                        result3 = CurrentEditModel.Thue;
                    CurrentEditModel.Tt = (num4 + result3);
                }
            }
            else
            {
                CurrentEditModel.Tien = num2;
                CurrentEditModel.Thue = result2;
                CurrentEditModel.Tt = result1;
            }
        }
    }

    string GetTk_cn(string tk)
    {
        string tk_cn = "0";
