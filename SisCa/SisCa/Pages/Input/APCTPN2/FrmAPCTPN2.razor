                                                    }
                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct32.Tt" ValueExpression="@(() => _Ct32.Tt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tt"); })" Id="Tt"></DxSpinEdit>
