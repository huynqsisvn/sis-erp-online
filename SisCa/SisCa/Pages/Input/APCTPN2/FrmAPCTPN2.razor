                                            <DxGridDataColumn FieldName="Mst_t" ReadOnly="true" Caption="@Lap["Tax code"]" CaptionAlignment="GridTextAlignment.Center" Width="120" Visible="@IsVisibleGridColumn("Mst_t")" />

