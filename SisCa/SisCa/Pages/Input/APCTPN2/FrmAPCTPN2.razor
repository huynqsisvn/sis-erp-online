    private async Task Save()
    {
        await GridCT.SaveChangesAsync();
        if (GridCTGT != null)
            await GridCTGT.SaveChangesAsync();

        if (LSCt.Count <= 0)
        {
            Message = Lap["No details entered"] + " !";
            myStateMN.SetNewThongbao(Message);
            return;
        }
        decimal tggs = GetTggs(CurPh.Tk, CurPh.Ty_gia, "CO");
        if (CurPh.Ty_gia != tggs)
        {
            CurPh.Ty_giaf = tggs;
            CurPh.Ty_gia = tggs;
        }
        if (CurPh.Ap_tggd == 1)
        {
            CurPh.Ty_gia_htf = CurPh.Ty_giaf;
            CurPh.Ty_gia_ht = CurPh.Ty_gia;
        }
        CalculateTyGia();
        Update_nt0();
        ParentReload = true;
        CurPh.Date = DateTime.Now.Date;
        CurPh.Time = DateTime.Now.ToString("HH:mm:ss");
        CurPh.Ma_hd = CurPh.So_ct;
        if (curUser != null)
            CurPh.User_id = curUser.User_id.ToString();
        CurPh.Ma_dvcs = myStateMN.GetMa_Dvcs();
        if (curActionTask == ActionTask.New)
        {
            CurPh.Date0 = DateTime.Now.Date;
            CurPh.Time0 = DateTime.Now.ToString("HH:mm:ss");

            if (curUser != null)
            {
                CurPh.User_id0 = curUser.User_id.ToString();
            }
            myDb.UpdateDataRowFromModel<Ph32>(DsTrans.Tables[0].Rows[0], CurPh);
            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

            if (LSCt.Count > 0)
                await myDb.SaveDataTable<Ct32>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec);
            if (LSCtgt.Count > 0)
                await myDb.SaveDataTable<Ct32gt>(LSCtgt, M_Ctgtdbf, "stt_rec", CurPh.Stt_rec);

            curActionTask = ActionTask.View;
            Message = String.Format(Lap["Successfully added new : {0}"], CurPh.So_ct);
        }
        else if (curActionTask == ActionTask.Edit)
        {
            myDb.UpdateDataRowFromModel<Ph32>(DsTrans.Tables[0].Rows[0], CurPh);
            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

            string _saveXml = myOption.GetOptionsValue("M_SAVE_XML");
            if (LSCt.Count > 0)
            {
                xmlpath = Path.Combine(myWebhost.WebRootPath, "upload_tmp", CurPh.Stt_rec);
                await myDb.SaveDataTable<Ct32>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec, "", xmlpath, _saveXml);
            }

            if (LSCtgt.Count > 0)
            {
                xmlpath = Path.Combine(myWebhost.WebRootPath, "upload_tmp", CurPh.Stt_rec + "CT");
                await myDb.SaveDataTable<Ct32gt>(LSCtgt, M_Ctgtdbf, "stt_rec", CurPh.Stt_rec, "", xmlpath, _saveXml);
            }

            curActionTask = ActionTask.View;
            Message = ("Sửa đơn: " + CurPh.So_ct + " thành công.");
        }
        SaveLastPh(CurPh);

        if (CurPh.Status.Equals("2"))
            Post();

        myStateMN.SetNewThongbao(Message);
    }
