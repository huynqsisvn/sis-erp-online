                        strTitle = "Danh sách mã tự do 2 không có trong danh mục tự do 2";
                        break;
                    case "ma_td3_i":
                        strbrowse = @"ma_td3_i:200:H=Mã tự do 3";
                        strTitle = "Danh sách mã tự do 3 không có trong danh mục tự do 3";
                        break;
                }
                if (!string.IsNullOrEmpty(strbrowse))
                {
                    IsShowErr = true;
                    SisLib.ReportLib.BrowTable(myModal, tblErr, strbrowse, " : " + strTitle, Lap["Cancel"]);
                }
            }
        }
        return IsShowErr;
    }

}
