                                                        <AutocompleteComponent TblData="@TblDmkh" Ma_dm="dmkh" @bind-Value="@_Ct41.Ma_kh_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_kh_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </div>

                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ten_kh_i" ReadOnly="true" Caption="@Lap["Customer name"]" CaptionAlignment="GridTextAlignment.Center" Width="300" Visible="@IsVisibleGridColumn("Ten_kh_i")" VisibleIndex="@CtOrder.GetKey("5")" />

                                            <DxGridDataColumn FieldName="T_tt_nt0" Caption="@Lap["Accounts receivable"].ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("6")" Visible="@IsVisibleGridColumn("T_tt_nt0")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct41.T_tt_nt0" ValueExpression="@(() => _Ct41.T_tt_nt0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "T_tt_nt0"); })" Id="T_tt_nt0"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            <DxGridDataColumn FieldName="T_tt_qd" Caption="@Lap["Cash Collected"].ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("7")" Visible="@IsVisibleGridColumn("T_tt_qd")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct41.T_tt_qd" ValueExpression="@(() => _Ct41.T_tt_qd)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "T_tt_qd"); })" Id="T_tt_qd"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            <DxGridDataColumn FieldName="Phai_tt_nt" Caption="@Lap["Cash Receivable"].ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("8")" Visible="@IsVisibleGridColumn("Phai_tt_nt")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct41.Phai_tt_nt" ValueExpression="@(() => _Ct41.Phai_tt_nt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Phai_tt_nt"); })" Id="Phai_tt_nt"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>



                                            <DxGridDataColumn FieldName="Tien_nt" Caption="@GetPSCoNtCaption().ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("9")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxSpinEdit Value="@_Ct41.Tien_nt" ValueExpression="@(() => _Ct41.Tien_nt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien_nt"); })" Id="Tien_nt"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            <DxGridDataColumn FieldName="Phai_tt_nt2" Caption="@Lap["Cash Receivable 2"].ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("10")" Visible="@IsVisibleGridColumn("Phai_tt_nt2")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxSpinEdit ReadOnly="true" Value="@_Ct41.Phai_tt_nt2" ValueExpression="@(() => _Ct41.Phai_tt_nt2)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Phai_tt_nt2"); })" Id="Phai_tt_nt2"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            @if (NotMaNt0Voucher)
                                            {
                                                <DxGridDataColumn FieldName="Tien" Caption="@GetPSCoCaption().ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("11")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct41 = (Ct41)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit ReadOnly="@(CurPh.Sua_tien == 0)" Value="@_Ct41.Tien" ValueExpression="@(() => _Ct41.Tien)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien"); })" Id="Tien"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Ty_giahtf2" Caption="@Lap["TGGS"].ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("12")" Visible="@IsVisibleGridColumn("Ty_giahtf2")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct41 = (Ct41)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit ReadOnly="@(CurPh.Sua_tggs == 0)" Value="@_Ct41.Ty_giahtf2" ValueExpression="@(() => _Ct41.Ty_giahtf2)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Ty_giahtf2"); })" Id="Ty_giahtf2"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Tien_tt" Caption="@GetPSNoCaption().ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("13")" Visible="@IsVisibleGridColumn("Tien_tt")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct41 = (Ct41)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit ReadOnly="@(CurPh.Sua_tien == 0)" Value="@_Ct41.Tien_tt" ValueExpression="@(() => _Ct41.Tien_tt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien_tt"); })" Id="Tien_tt"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Tien_cltg" Caption="@Lap["Difference amount"].ToString()" Width="120" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("14")" Visible="@IsVisibleGridColumn("Tien_cltg")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct41 = (Ct41)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit ReadOnly="true" Value="@_Ct41.Tien_cltg" ValueExpression="@(() => _Ct41.Tien_cltg)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien_cltg"); })" Id="Tien_cltg"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                            }

                                            <DxGridDataColumn FieldName="Dien_giaii" Caption="@Lap["Dien giai"].ToString()" Width="400" DisplayFormat="@M_IP_SL" VisibleIndex="@CtgtOrder.GetKey("15")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct41.Dien_giaii" Enabled="@AllowEditMode" Id="Dien_giaii"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>


                                        </Columns>
                                        <TotalSummary>
                                            @* <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_SL" Name="So_luong" FieldName="So_luong" /> *@
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Tien" FieldName="Tien" />
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN_NT" Name="Tien_nt" FieldName="Tien_nt" />
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Tien_tt" FieldName="Tien_tt" />
                                            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Tien_cltg" FieldName="Tien_cltg" />
                                        </TotalSummary>
                                    </DxGrid>
                                </Template>
