    bool CheckValid()
    {
        bool flag = true;

        // Kiểm tra ngày hạch toán
        if (string.IsNullOrEmpty(CurPh.Ngay_ct.ToString()) && flag)
        {
            Message = Lap["Chưa vào ngày hạch toán!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }
        if (CurPh.Ma_dvcs.ToUpper() == "ALL" && flag)
        {
            Message = Lap["Chưa chọn dvcs!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }
        // Kiểm tra quyển số
        if (string.IsNullOrEmpty(CurPh.Ma_qs) && flag)
        {
            Message = Lap["Chưa vào quyển số!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra số chứng từ
        if (string.IsNullOrEmpty(CurPh.So_ct) && flag)
        {
            Message = Lap["Chưa vào Số c.từ!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra tài khoản nợ
        if (string.IsNullOrEmpty(CurPh.Tk) && flag)
        {
            Message = Lap["Chưa vào tài khoản nợ!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra mã giao dịch = 3 và ngoại tệ
        if (CurPh.Ma_gd.Equals("3") && CurPh.Ma_nt != M_ma_nt0)
        {
            Message = Lap["Đồng tiền giao dịch với mã gd số 3 phải là đồng tiền hạch toán."];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra chi tiết
        if (LSCt.Count > 0 && flag)
        {
            foreach (Ct41 ct in LSCt)
            {
                if (string.IsNullOrEmpty(ct.Tk_i?.Trim()) && CurPh.Ma_gd != "1")
                {
                    Message = Lap["Chưa vào tài khoản có!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;
                }
                if (string.IsNullOrEmpty(ct.So_ct0?.Trim()) && CurPh.Ma_gd == "1")
                {
                    Message = Lap["Chưa vào chi tiết!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;
                }
            }
        }

        // Logic từ WinForm - kiểm tra tổng tiền và xử lý dữ liệu

        Decimal result1 = new Decimal(0);
        Decimal num1 = new Decimal(0);
        Decimal.TryParse(CurPh.T_tien_nt.ToString(), out result1);

        // Kiểm tra tổng tiền ngoại tệ
        if (result1 != CurPh.T_tien_nt)
        {
            Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = true;
        }
        else if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim()) && num1 != CurPh.T_tien_nt)
        {
            Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = true;
        }

        UpdateTotalHT();



        if (!flag)
        {

            Decimal _ty_gia = CurPh.Ty_gia;

            // Kiểm tra và xử lý tỷ giá
            if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim()) && LSCt.Count > 0 &&
                _ty_gia != new Decimal(0) && CurPh.Sua_tien != 1)
            {
                // Đếm số dòng có tiền ngoại tệ hoặc tiền VND khác 0
                int countWithMoney = LSCt.Count(ct =>
                    ct.Tien_nt != 0 || ct.Tien != 0);

                if (countWithMoney < LSCt.Count)
                {
                    Decimal result = LSCt.Sum(ct => ct.Tien_nt);
                    Decimal num0 = Math.Round(_ty_gia * result);
                    Decimal num2 = new Decimal(0);
                    Decimal dec1 = LSCt.Sum(ct => ct.Tien_tt);

                    // Cập nhật tiền cho dòng đầu tiên có tiền
                    var firstCtWithMoney = LSCt.FirstOrDefault(ct =>
                        ct.Tien_nt != 0 && ct.Tien_tt != 0);

                    if (firstCtWithMoney != null)
                    {
                        firstCtWithMoney.Tien_tt = dec1 + num0 - dec1;
                        CurPh.T_tien_tt = num0;

                        if (CurPh.Ma_gd == "2" && LSCt.All(ct =>
                            IsEquals(ct.Ty_gia_ht2, CurPh.Ty_gia, ct.Stt_rec)))
                        {
                            firstCtWithMoney.Tien = dec1 + num0 - dec1;
                        }
                    }
                }
            }

            // Cập nhật các trường bắt buộc
            if (string.IsNullOrEmpty(CurPh.Ma_gd))
                CurPh.Ma_gd = curDmct.Ma_gd;

            if (string.IsNullOrEmpty(CurPh.Ma_dvcs))
                CurPh.Ma_dvcs = myStateMN.GetMa_Dvcs();

            if (string.IsNullOrEmpty(CurPh.Loai_ct?.Trim()))
            {
                // Logic để lấy loai_ct từ ma_gd
                // Có thể cần implement thêm
            }

            // Kiểm tra tiền bằng 0
            if (CurPh.T_tien == 0 && CurPh.T_tien_nt == 0)
            {
                int M_CHK_ZERO = 1; // Có thể lấy từ config
                if (M_CHK_ZERO == 1)
                {
                    Message = Lap["Hạch toán tiền bằng 0!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                }
                else if (M_CHK_ZERO == 2)
                {
                    Message = Lap["Hạch toán tiền bằng 0, không lưu được!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = true;
                }
            }
            if (CheckData().Tables.Count > 0)
            {
                // DataTable dsCheckData = CheckData().Tables[0].Copy();
                // foreach (DataRow row in dsCheckData.Rows)
                // {

                // }
            }

            // Cập nhật các trường cuối cùng
            CurPh.So_ct_tt = "";

            // Cập nhật ngày_ct, so_ct, ma_ct cho các chi tiết
            foreach (var ct in LSCt)
            {

                ct.Ngay_ct = CurPh.Ngay_ct;
                ct.So_ct = CurPh.So_ct;
                ct.Ma_ct = Ma_ct;
            }
        }

        return flag;
    }

    // Method hỗ trợ để so sánh tỷ giá
    bool IsEquals(decimal ty_gia_ht2, decimal ty_gia, string stt_rec)
    {
        return Math.Abs(ty_gia_ht2 - ty_gia) < 0.0001m;
    }

    // Method để cập nhật tổng
    void UpdateTotalHT()
    {
        try
        {
            if (curActionTask == ActionTask.View)
                return;

            Decimal result1 = new Decimal(0);
            Decimal result2 = new Decimal(0);
            Decimal result3 = new Decimal(0);
            Decimal result4 = new Decimal(0);

            // Sử dụng LINQ để tính tổng từ LSCt thay vì CtData
            if (LSCt != null && LSCt.Count > 0)
            {
                result1 = LSCt.Sum(ct => ct.Tien_nt);
                result2 = LSCt.Sum(ct => ct.Tien);
                result3 = LSCt.Sum(ct => ct.Tien_tt);
                result4 = LSCt.Sum(ct => ct.Tien_cltg);

                // Cập nhật vào CurPh thay vì PhView[0]
                CurPh.T_tien_nt = result1;
                CurPh.T_tien = result2;
                CurPh.T_tien_tt = result3;
                CurPh.T_tien_cltg = result4;
            }
            else
            {
                // Nếu không có chi tiết, reset về 0
                CurPh.T_tien_nt = 0;
                CurPh.T_tien = 0;
                CurPh.T_tien_tt = 0;
                CurPh.T_tien_cltg = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi trong UpdateTotalHT: {ex.Message}");
            // Có thể thêm logging hoặc thông báo lỗi
        }
    }
    private void CalculateTyGia()
    {
        if (CurrentEditModel == null) return;
        decimal tyGia = CurPh.Ty_gia;
        decimal tyGiaf = CurPh.Ty_giaf;

        if (CurPh.Sua_tien == 1)
        {
            if (CurPh.Ma_gd.Trim().IndexOfAny(new char[] { '2', '3', '4', '5', '6', '7' }) >= 0 && !NotMaNt0Voucher)
            {
                foreach (var record in LSCt)
                {
                    record.Ty_gia_ht2 = CurPh.Ty_gia;
                    record.Ty_giahtf2 = CurPh.Ty_giaf;
                    record.Tien_tt = record.Tien = record.Tien_nt;

                    if (record.Stt_rec0 == CurrentEditModel.Stt_rec0)
                    {
                        CurrentEditModel.Ty_gia_ht2 = record.Ty_gia_ht2;
                        CurrentEditModel.Ty_giahtf2 = record.Ty_giahtf2;
                        CurrentEditModel.Tien_tt = record.Tien_tt;
                    }
                }
            }

            UpdateTotalHT();
        }
        else
        {
            foreach (var record in LSCt)
            {
                decimal tienNt = record.Tien_nt;
                decimal tienQuyDoi = tyGia * tienNt; // làm tròn theo quy tắc hệ thống

                if (NotMaNt0Voucher)
                {
                    record.Tien_tt = tienQuyDoi;

                    if (CurPh.Ma_gd.IndexOfAny(new char[] { '2', '5' }) >= 0)
                    {
                        // decimal tienTheoTyGiaHt2 = 0;

                        if (CurrentEditModel.Ty_giahtf2 != 0m)
                        {
                            record.Ty_giahtf2 = CurrentEditModel.Ty_giahtf2;
                            record.Tien = CurrentEditModel.Ty_giahtf2 * tienNt;
                        }

                        record.Tien_cltg = tienQuyDoi - CurrentEditModel.Ty_giahtf2 * tienNt;
                    }
                    if (record.Stt_rec0 == CurrentEditModel.Stt_rec0)
                    {
                        CurrentEditModel.Tien = record.Tien;
                        CurrentEditModel.Tien_cltg = record.Tien_cltg;
                        CurrentEditModel.Tien_tt = record.Tien_tt;
                    }
                }


            }

            UpdateTotalHT();
        }
    }

    private void Update_nt0()
    {
        if (CurPh.Ma_nt != M_ma_nt0)
