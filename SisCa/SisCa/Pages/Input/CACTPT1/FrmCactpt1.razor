                                                           SelectChanged="OnAutoCompleteMaNTChanged"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn">
                                    </AutocompleteComponent>

                                    <DxSpinEdit ReadOnly="@(CurPh?.Ma_nt?.Trim().Equals(M_ma_nt0) == true)"
