                                               Enabled="@AllowEditMode"
                                               Id="dien_giai_input">
                                    </DxTextBox>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Debit account"]" ColSpanMd="6">
                                <Template>
                                    <AutocompleteComponent TblData="@TblDmnx"
                                                           Ma_dm="dmnx"
                                                           @bind-Value="@CurPh.Tk"
                                                           SelectChanged="OnAutoCompleteDMNXChanged"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn">
                                    </AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>


                        </DxFormLayoutGroup>
                        <DxFormLayoutGroup Caption="@Lap["Voucher"].ToString()" ColSpanMd="4" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode">
                            <DxFormLayoutItem Caption="@Lap["GL date"]" ColSpanMd="12">
                                <Template>
                                    <DxDateEdit CssClass="w-100"
                                                @bind-Date="@CurPh.Ngay_ct"
                                                DisplayFormat="dd-MM-yyyy"
                                                Format="dd-MM-yyyy"
                                                Enabled="@AllowEditMode">
                                    </DxDateEdit>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["LCT date"]" ColSpanMd="12">
                                <Template>
                                    <DxDateEdit CssClass="w-100"
                                                @bind-Date="@CurPh.Ngay_lct"
