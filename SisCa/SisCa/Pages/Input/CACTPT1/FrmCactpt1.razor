    public DataTable AddTbTkPs(string sttrec)
    {
        string str = "ct41";

        string sql = string.Format("select tk_i as tk,MIN(stt_rec0) as stt_rec0, case when abs(sum(tien_tt))> 0 then sum(tien_tt) else sum(tien) end as tien, sum(tien_nt) as tien_nt from " + str + " where stt_rec='" + sttrec + "' group by tk_i order by stt_rec0");
        DataTable ds = myDb.LoadDataSet(sql).Tables[0].Copy();
        return ds;

    }
