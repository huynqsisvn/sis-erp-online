                                                ValueChanged="@((decimal newvalue) => { OnValueMaNTChanged(newvalue); })"
                                                Id="Ty_gia"
                                                DisplayFormat="@M_IP_TY_GIA"
                                                Enabled="@AllowEditMode">
                                    </DxSpinEdit>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="12">
                                <Template>
                                    <AutocompleteComponent CssClass="w-100"
                                                           Ma_dm="dmpost"
                                                           @bind-Value="@CurPh.Status"
                                                           Filter="@filter_status"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn">
                                    </AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>

                        </DxFormLayoutGroup>
                    </DxFormLayoutGroup>
                    <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail">
                        <DxFormLayoutTabPage Caption="@Lap["Details"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill" CssClass="tab-grd">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <DxGrid @ref="GridCT" SizeMode="@Itemsizemode" CssClass="@grd_Css" @onkeydown="GridCT_OnKeyDown"
