                                    CurrentEditModel.Tien_tt = Math.Round(nValue1 * nValue2, M_ROUND);
                                }
                                else
                                {
                                    CurrentEditModel.Tien = Math.Round(nValue1 * nValue2, M_ROUND);
                                    CurrentEditModel.Tien_tt = Math.Round(nValue1 * nValue2, M_ROUND);
                                }

