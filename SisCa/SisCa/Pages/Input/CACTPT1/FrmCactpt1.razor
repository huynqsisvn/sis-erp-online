    public static Decimal ToDec(object value)
    {
        return value == null || value is DBNull ? new Decimal(0) : (Decimal)value;
    }

    private bool Phan_bo()
    {
        DataF3 dataF3 = new DataF3();
        dataF3.Tien = this.GetTienPb(SelectedDataPh);
        if (dataF3.Tien <= new Decimal(0))
        {
            Message = Lap["Phiếu đã phân bổ hết, không thể phân bổ tiếp!"];
            myStateMN.SetNewThongbao(Message);
            return false;
        }
        string str1 = "";
        string dien_giai = "";
        Decimal num1;
        DataRowView dataItem;

        foreach (DataRowView ph in SelectedDataPh.Cast<Object>())
        {
            dataF3.Stt_rec = ph.Row["stt_rec"].ToString();           
            dataF3.Ma_ct = ph.Row["ma_ct"].ToString();
            dataF3.Tk_i = ph.Row["tk_i"].ToString();
            dataF3.Tk_tt = ph.Row["tk_tt"].ToString();
            dien_giai = ph.Row["dien_giaii"].ToString().Replace("'", "''");
            num1 = new Decimal(0);
            foreach (DataRowView dataRowView in (dataCt?.DefaultView?.Cast<DataRowView>().Where(v => v["check"]?.ToString() == "1")) ?? Enumerable.Empty<DataRowView>())
            {
                dataF3.Tien_dt = dataF3.Tien_con_pt = ToDec(dataRowView["tien_con_pt"]);
                if (dataF3.Tien < dataF3.Tien_dt)
                    dataF3.Tien_dt = dataF3.Tien;
                if (!(dataF3.Tien_dt <= new Decimal(0)))
                {
                    dataF3.Stt_rec_tt = dataRowView["stt_rec"].ToString();
                    dataRowView["tag"] = (object)"*";
                    dataRowView["tien_con_pt"] = (object)(dataF3.Tien_con_pt - dataF3.Tien_dt);
                    dataRowView["tien_dt"] = (object)dataF3.Tien_dt;
                    dataRowView["date_pb"] = (object)DateTime.Today.Date;
                    dataRowView["time_pb"] = (object)DateTime.Now.ToString("HH:mm:ss");
                    dataRowView["user_id_pb"] = curUser.User_id;
                    dataRowView["user_name_pb"] = curUser.User_name;
                    str1 += this.GetUpdateCommand(dataF3.Stt_rec,dataF3.Stt_rec_tt, dataF3.Tk_i, dataF3.Tk_tt, dien_giai, dataF3.Ma_ct, (Decimal)dataRowView["tien_dt"]);
                    dataF3.Tien -= dataF3.Tien_dt;
                    num1 += dataF3.Tien_dt;

                    // DataRow _rowct = dataCt.Select("stt_rec='" + dataF3.Stt_rec_tt + "'").FirstOrDefault();
                    // if(_rowct != null)
                    //     _rowct["tien_dt"] = (object)dataF3.Tien_dt;

                    if (dataF3.Tien <= new Decimal(0))
                        break;
                }
            }
            ph.Row["da_pb"] = (object)num1;
            ph.Row["tien_chua_pb"] = (object)(ToDec(ph.Row["t_tien_nt"]) - num1);
        }

        string str2 = str1 + string.Format("\nEXEC dbo." + paramerter[0] + ";70 '{0}', '{1}'; \n", (object)dataF3.Stt_rec, (object)dataF3.Ma_ct);
        Console.WriteLine(str2);
        myDb.ExecuteSqlQueryAsync(str2);
        return true;
    }

