                            <DxFormLayoutItem Caption="@Lap["Transaction code"]" ColSpanMd="12">
                                <Template>
                                    <AutocompleteComponent TblData="@TblDmmagd"
                                                           Ma_dm="dmmagd"
                                                           Filter="@filter_status"
                                                           @bind-Value="@CurPh.Ma_gd"
                                                           SelectChanged="OnAutoCompleteGiaodichChanged"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn">
                                    </AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Customer"]" ColSpanMd="12">
                                <Template>
