                                                              Width="150px"
                                                              VisibleIndex="@CtOrder.GetKey("0")" Visible="@IsVisibleGridColumn("So_ct0")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
                                                    <DxTextBox Enabled="@AllowEditMode" Id="So_ct0" Text="@_Ct41.So_ct0" TextExpression="(() =>  _Ct41.So_ct0)" TextChanged="@LoadHD"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ngay_ct0" ReadOnly="true" Caption="@Lap["Invoice date"]" CaptionAlignment="GridTextAlignment.Center" Width="200" VisibleIndex="@CtOrder.GetKey("1")" Visible="@IsVisibleGridColumn("Ngay_ct0")" />


                                            @if (CurPh.Ma_gd == "1")
                                            {

                                                <DxGridDataColumn FieldName="Tk_i" Caption="@Lap["Credit account"].ToString()" Width="200" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("2")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct41 = (Ct41)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent TblData="@TblDmtk" Ma_dm="dmtk1" @bind-Value="@_Ct41.Tk_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Tk_i"); })" IsEnable="false" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                            }
                                            @if (CurPh.Ma_gd != "1")
                                            {

                                                <DxGridDataColumn FieldName="Tk_i" Caption="@Lap["Credit account"].ToString()" Width="200" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("2")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct41 = (Ct41)GrdContext.EditModel;
                                                        }
                                                        <div id="@($"Tk_i_{_Ct41.Stt}")" class="autocomplete-cell-wrapper m-0 p-0">

                                                            <AutocompleteComponent TblData="@TblDmtk" Ma_dm="dmtk1" @bind-Value="@_Ct41.Tk_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Tk_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ten_tk_i" ReadOnly="true" Caption="@Lap["Credit name"]" CaptionAlignment="GridTextAlignment.Center" Width="300" VisibleIndex="@CtOrder.GetKey("3")" />
                                            }


                                            <DxGridDataColumn FieldName="Ma_kh_i" Caption="@Lap["Customer"].ToString()" Width="200" CaptionAlignment="GridTextAlignment.Center" Visible="@IsVisibleGridColumn("Ma_kh_i")" VisibleIndex="@CtOrder.GetKey("4")">
                                                <CellEditTemplate Context="GrdContext">
                                                    @{
                                                        var _Ct41 = (Ct41)GrdContext.EditModel;
                                                    }
