                            Tinh_tien_cltg();
                            UpdateTotalHT();
                        }
                        else
                        {

                            if (!CheckedChangeTien && newvalue != 0)
                            {
                                Decimal num1 = new Decimal(0);
                                Decimal num2 = new Decimal(0);
                                Decimal num3 = new Decimal(0);
                                Decimal dec = CurPh.Ty_gia;
                                Decimal num4 = CurrentEditModel.Ty_gia_ht2;
