                                                Format="dd-MM-yyyy"
                                                Enabled="@AllowEditMode">
                                    </DxDateEdit>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Book code"]" ColSpanMd="12">
                                <Template>
                                    <AutocompleteComponent CssClass="w-100"
                                                           Ma_dm="dmqs"
                                                           @bind-Value="@CurPh.Ma_qs"
                                                           SelectChanged="OnAutoCompleteQuyensoChanged"
                                                           Filter="@_filter_qs"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn">
                                    </AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Voucher No"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox CssClass="w-100"
