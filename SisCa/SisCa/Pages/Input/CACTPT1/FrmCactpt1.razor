                                string[] strArray = new string[5] { "3", "4", "6", "7", "9" };

                                switch (CurPh.Ma_gd)
                                {
                                    case "1":
                                    case "2":
                                    case "3":
                                    case "8":
                                    case "9":
                                        if (((IEnumerable<string>)strArray).Contains<string>(str))
                                        {
                                            CurrentEditModel.Ty_giahtf2 = CurPh.Ty_gia;
