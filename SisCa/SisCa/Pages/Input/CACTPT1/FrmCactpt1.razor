        Decimal num1 = new Decimal(0);
        Decimal num2 = new Decimal(0);
        Decimal num3 = new Decimal(0);
        Decimal num4 = new Decimal(0);

        bool? isChecked = value;

        // Kiểm tra điều kiện tương đương với WinForm
        if ((isChecked.GetValueOrDefault() ? 0 : (isChecked.HasValue ? 1 : 0)) == 0 ||
            CurPh.Ma_nt.ToUpper().Trim().Equals(M_ma_nt0.ToUpper().Trim()))
            return;

        // Xử lý từng dòng trong danh sách chi tiết
        foreach (var ct in LSCt)
        {
            Decimal dec1 = ct.Ty_giahtf2; // Tương đương với ty_giahtf2
            Decimal dec2 = ct.Tien_nt; // Tương đương với tien_nt
            Decimal num5;
            Decimal num6 = num5 = Math.Round(dec2 * nValue); // Tương đương với SysFunc.Round

            if (CurPh.Ma_gd == "1" || CurPh.Ma_gd == "2")
                num6 = Math.Round(dec2 * dec1);

            ct.Tien = num6; // Tương đương với tien
            ct.Tien_tt = num5; // Tương đương với tien_tt
            ct.Tien_cltg = num5 - num6; // Tương đương với tien_cltg
        }

        StateHasChanged(); // Cập nhật UI
    }

