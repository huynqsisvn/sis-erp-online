    private void grdPh_RecordActivated()
    {
        if (dataPh == null || dataPh.Rows.Count <= 0) return;

        DataRow rec = dataPh.Rows[0];
        string _stt_rec = rec["stt_rec"].ToString();
        string _ma_dvcs = rec["ma_dvcs"].ToString();
        string _ma_kh = rec["ma_kh"].ToString();
        string _tk_i = rec["tk_i"].ToString();
        string _ma_nt = rec["ma_nt"].ToString();
        dataCt.DefaultView.RowFilter = GetFilter(_ma_dvcs, _ma_kh, _tk_i, _ma_nt, false);

        string str = "SELECT stt_rec_tt, SUM(ISNULL(tien_dt, 0)) tien_dt FROM cttt20  WHERE stt_rec = '" + _stt_rec + "' AND tk = '" + _tk_i + "' AND ma_kh = '" + _ma_kh + "' GROUP BY stt_rec_tt ";
        DataSet dataSet1 = myDb.LoadDataSet(str);
        DataRowCollection dataRowCollection1 = (DataRowCollection)null;
        if (dataSet1 != null && dataSet1.Tables.Count > 0 && dataSet1.Tables[0].Rows.Count > 0)
        {
            dataSet1.Tables[0].PrimaryKey = new DataColumn[1] { dataSet1.Tables[0].Columns[0] };
            dataRowCollection1 = dataSet1.Tables[0].Rows;
        }
        string[] array = dataCt.DefaultView.Cast<DataRowView>().Select<DataRowView, string>((Func<DataRowView, string>)(x => x["stt_rec"].ToString())).ToArray<string>();
        string cmdText = "SELECT stt_rec_tt, SUM(ISNULL(tien_dt, 0)) tien_dt FROM cttt20  WHERE stt_rec != '" + _stt_rec + "' AND dbo.InList(stt_rec_tt, '" + string.Join(",", array) + "', ',') = 1 AND tk = '" + _tk_i + "' AND ma_kh = '" + _ma_kh + "' GROUP BY stt_rec_tt ";
        DataSet dataSet2 = myDb.LoadDataSet(cmdText);
        DataRowCollection dataRowCollection2 = (DataRowCollection)null;
        if (dataSet2 != null && dataSet2.Tables.Count > 0 && dataSet2.Tables[0].Rows.Count > 0)
        {
            dataSet2.Tables[0].PrimaryKey = new DataColumn[1] { dataSet2.Tables[0].Columns[0] };
            dataRowCollection2 = dataSet2.Tables[0].Rows;
        }
        Decimal num1 = new Decimal(0);
        Decimal num2 = new Decimal(0);
        foreach (DataRowView row in dataCt.DefaultView)
        {
            DataRow dataRow;
            if (dataRowCollection2 != null && (dataRow = dataRowCollection2.Find(row["stt_rec"])) != null)
            {
                row["t_tien_dt"] = dataRow["tien_dt"];
            }
            else
            {
                row["tien_con_pt"] = row["tien_hd"];
                row["t_tien_dt"] = (object)0;
            }

            if (dataRowCollection1 != null && (dataRow = dataRowCollection1.Find(row["stt_rec"])) != null)
            {
                row["tien_dt"] = dataRow["tien_dt"];
            }
            else
            {
                row["tien_dt"] = 0;
            }
            row["tien_con_pt0"] = (object)(ToDec(row["tien_hd"]) - ToDec(row["t_tien_dt"]));
            Decimal dec;
            row["tien_con_pt"] = (object)(ToDec(row["tien_con_pt0"]) - (dec = ToDec(row["tien_dt"])));
            num1 += dec;
        }
        rec["da_pb"] = (object)num1;
        rec["tien_chua_pb"] = (object)(ToDec(rec["t_tien_nt"]) - num1);
        dataCt.AcceptChanges();
        dataCt.DefaultView.RowFilter = GetFilter(_ma_dvcs, _ma_kh, _tk_i, _ma_nt, true);

        try
        {
            cmdText = "SELECT a.stt_rec_tt, a.date_pb, a.time_pb, a.user_id_pb, b.user_name as user_name_pb FROM cttt20 a LEFT JOIN userinfo b ON a.user_id_pb = b.user_id WHERE a.stt_rec = '" + _stt_rec + "'";
            DataSet dataSet = myDb.LoadDataSet(cmdText);
            DataRowCollection dataRowCollection = (DataRowCollection)null;
            if (dataSet != null && dataSet.Tables.Count > 0 && dataSet.Tables[0].Rows.Count > 0)
            {
                dataSet.Tables[0].PrimaryKey = new DataColumn[1]
              {
              dataSet.Tables[0].Columns[0]
   };
                dataRowCollection = dataSet.Tables[0].Rows;
            }
            DataRow dataRow = (DataRow)null;
            foreach (DataRowView row in dataCt.DefaultView)
            {
                if (dataRowCollection != null && (dataRow = dataRowCollection.Find(row["stt_rec"])) != null)
                {
                    row["tag"] = (object)"*";
                    row["date_pb"] = dataRow["date_pb"];
                    row["time_pb"] = dataRow["time_pb"];
                    row["user_id_pb"] = dataRow["user_id_pb"];
                    row["user_name_pb"] = dataRow["user_name_pb"];
                }
                else
                {
                    row["tag"] = (object)"";
                    row["date_pb"] = (object)DBNull.Value;
                    row["time_pb"] = (object)DBNull.Value;
                    row["user_id_pb"] = (object)DBNull.Value;
                    row["user_name_pb"] = (object)DBNull.Value;
                }
            }

            if (dataCt.DefaultView.Count <= 0)
                return;
        }
        catch (Exception ex)
        {

        }
    }
    private string GetFilter(string ma_dvcs, string ma_kh, string tk, string ma_nt, bool tag)
    {
        string str;
        if (M_PB_DVCS_CK == "1")
            str = string.Format("ma_dvcs like '{0}' AND ma_kh like '{1}' AND tk like '{2}' AND ma_nt LIKE '{3}'", (object)ma_dvcs, (object)ma_kh, (object)tk, (object)ma_nt);
        else
            str = string.Format("ma_kh like '{0}' AND tk like '{1}' AND ma_nt LIKE '{2}'", (object)ma_kh, (object)tk, (object)ma_nt);
