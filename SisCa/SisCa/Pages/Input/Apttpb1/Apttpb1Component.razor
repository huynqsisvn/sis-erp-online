    private async void BtnFilterOK()
    {
        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);
        phFilter = "1=1";      

        string _ma_dvcs = Ma_dvcs;
        if (Ma_dvcs.ToUpper().Equals("ALL"))
            _ma_dvcs = "%";

        phFilter = phFilter + " AND ma_dvcs  LIKE ''" + _ma_dvcs + "''";
        if (Ngay_ct1 != null)
        {
            phFilter = phFilter + " AND ngay_ct >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            phFilter = phFilter + " AND ngay_ct <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }

        if (!String.IsNullOrEmpty(Tk_cn))
        {
            phFilter = phFilter + " AND tk_i  LIKE ''" + Tk_cn.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Tk_tt))
        {
            phFilter = phFilter + " AND tk_tt  LIKE ''" + Tk_tt.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Ma_kh))
        {
            phFilter = phFilter + " AND ma_kh LIKE ''" + Ma_kh.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Ma_nt))
        {
            phFilter = phFilter + " AND ma_nt LIKE ''" + Ma_nt.Trim() + "%''";
        }
        ShowArtTPBC();
        popFilterVisible = false;
        InvokeAsync(StateHasChanged);
    }

