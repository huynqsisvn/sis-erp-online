                dataRowView["tien_dt"] = (object)0;
                dataRowView["date_pb"] = (object)DBNull.Value;
                dataRowView["time_pb"] = (object)DBNull.Value;
                dataRowView["user_id_pb"] = (object)DBNull.Value;
                dataRowView["user_name_pb"] = (object)DBNull.Value;
            }
        }
    }
    public static Decimal ToDec(object value)
    {
        return value == null || value is DBNull ? new Decimal(0) : (Decimal)value;
    }
    private bool CanModify(string stt_rec, string ma_ct, string action)
    {
        string _sql = string.Format("Exec {0} '{1}', '{2}'", paramerter[1], stt_rec, ma_ct);
        DataSet dataSet = myDb.LoadDataSet(_sql);
        if (dataSet == null || dataSet.Tables.Count <= 0 || dataSet.Tables[0].Rows.Count <= 0 || !(dataSet.Tables[0].Rows[0][0].ToString() != "1"))
            return true;

        switch (action)
        {
            case "F3":
                Message = string.Format("Không được sửa phiếu này.");
                myStateMN.SetNewThongbao(Message);
                break;
            case "F8":
                Message = string.Format("Không xoá được phân bổ của phiếu này!");
                myStateMN.SetNewThongbao(Message);
                break;
        }
        return false;
    }

