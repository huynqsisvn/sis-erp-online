    <BodyContentTemplate>
        <DxFormLayout CssClass="frm-header">
            <DxFormLayoutGroup ColSpanMd="12" Caption="@Lap["Information"]" Decoration="FormLayoutGroupDecoration.Card" HeaderCssClass="css-header-grp" CaptionCssClass="css-header-cap" CssClass="css-header mt-2" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide">
                <DxFormLayoutItem Caption="@Lap["Remaining payable amount"]" ColSpanMd="12" Context="FrmF3">
