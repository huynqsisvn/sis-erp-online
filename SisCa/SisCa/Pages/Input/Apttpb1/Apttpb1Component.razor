            </DxFormLayoutGroup>

            <DxFormLayoutItem Caption="" ColSpanMd="12" Context="FrmF3">
                <Template>
                    <div class="row mt-3">
                        <DxButton Text="@Lap["OK"]" CssClass="col-2" Click="@OnDataF3OkClick"></DxButton>
                    </div>
                </Template>
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>
</DxPopup>


