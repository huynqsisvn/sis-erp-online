        else
            rowval.Row["check"] = (value ? "1" : "0");
    }

    private async void ShowArtTPBC()
    {
        VisiblePb = true;
        PbInfo pbInfo = new PbInfo(Ngay_ct1, Ngay_ct2, (object)"", "", "");
        pbInfo.TitleView = "Phan bo";

        Pb_tt("", pbInfo);
        grdPh_RecordActivated();
        await InvokeAsync(StateHasChanged);
    }

    private void grdPh_RecordActivated()
    {
        if (dataPh == null || dataPh.Rows.Count <= 0) return;

        DataRow rec = dataPh.Rows[0];
        string _stt_rec = rec["stt_rec"].ToString();
        string _ma_dvcs = rec["ma_dvcs"].ToString();
        string _ma_kh = rec["ma_kh"].ToString();
        string _tk_i = rec["tk_i"].ToString();
        string _ma_nt = rec["ma_nt"].ToString();
        dataCt.DefaultView.RowFilter = GetFilter(_ma_dvcs, _ma_kh, _tk_i, _ma_nt, false);

        string str = "SELECT stt_rec_tt, SUM(ISNULL(tien_dt, 0)) tien_dt FROM cttt30  WHERE stt_rec = '" + _stt_rec + "' AND tk = '" + _tk_i + "' AND ma_kh = '" + _ma_kh + "' GROUP BY stt_rec_tt ";
        DataSet dataSet1 = myDb.LoadDataSet(str);
        DataRowCollection dataRowCollection1 = (DataRowCollection)null;
        if (dataSet1 != null && dataSet1.Tables.Count > 0 && dataSet1.Tables[0].Rows.Count > 0)
        {
            dataSet1.Tables[0].PrimaryKey = new DataColumn[1] { dataSet1.Tables[0].Columns[0] };
            dataRowCollection1 = dataSet1.Tables[0].Rows;
        }
        string[] array = dataCt.DefaultView.Cast<DataRowView>().Select<DataRowView, string>((Func<DataRowView, string>)(x => x["stt_rec"].ToString())).ToArray<string>();
        string cmdText = "SELECT stt_rec_tt, SUM(ISNULL(tien_dt, 0)) tien_dt FROM cttt30  WHERE stt_rec != '" + _stt_rec + "' AND dbo.InList(stt_rec_tt, '" + string.Join(",", array) + "', ',') = 1 AND tk = '" + _tk_i + "' AND ma_kh = '" + _ma_kh + "' GROUP BY stt_rec_tt ";
        DataSet dataSet2 = myDb.LoadDataSet(cmdText);
        DataRowCollection dataRowCollection2 = (DataRowCollection)null;
        if (dataSet2 != null && dataSet2.Tables.Count > 0 && dataSet2.Tables[0].Rows.Count > 0)
        {
            dataSet2.Tables[0].PrimaryKey = new DataColumn[1] { dataSet2.Tables[0].Columns[0] };
            dataRowCollection2 = dataSet2.Tables[0].Rows;
        }
        Decimal num1 = new Decimal(0);
        Decimal num2 = new Decimal(0);
        foreach (DataRowView row in dataCt.DefaultView)
        {
            DataRow dataRow;
            if (dataRowCollection2 != null && (dataRow = dataRowCollection2.Find(row["stt_rec"])) != null)
            {
                row["t_tien_dt"] = dataRow["tien_dt"];
            }
            else
            {
                row["tien_con_pt"] = row["tien_hd"];
                row["t_tien_dt"] = (object)0;
            }

            if (dataRowCollection1 != null && (dataRow = dataRowCollection1.Find(row["stt_rec"])) != null)
            {
                row["tien_dt"] = dataRow["tien_dt"];
            }
            else
            {
                row["tien_dt"] = 0;
            }
            row["tien_con_pt0"] = (object)(ToDec(row["tien_hd"]) - ToDec(row["t_tien_dt"]));
            Decimal dec;
            row["tien_con_pt"] = (object)(ToDec(row["tien_con_pt0"]) - (dec = ToDec(row["tien_dt"])));
            num1 += dec;
        }
        rec["da_pb"] = (object)num1;
        rec["tien_chua_pb"] = (object)(ToDec(rec["t_tien_nt"]) - num1);
        dataCt.AcceptChanges();
        dataCt.DefaultView.RowFilter = GetFilter(_ma_dvcs, _ma_kh, _tk_i, _ma_nt, true);

        try
        {
            cmdText = "SELECT a.stt_rec_tt, a.date_pb, a.time_pb, a.user_id_pb, b.user_name as user_name_pb FROM cttt30 a LEFT JOIN userinfo b ON a.user_id_pb = b.user_id WHERE a.stt_rec = '" + _stt_rec + "'";
            DataSet dataSet = myDb.LoadDataSet(cmdText);
            DataRowCollection dataRowCollection = (DataRowCollection)null;
            if (dataSet != null && dataSet.Tables.Count > 0 && dataSet.Tables[0].Rows.Count > 0)
            {
                dataSet.Tables[0].PrimaryKey = new DataColumn[1]
              {
              dataSet.Tables[0].Columns[0]
   };
                dataRowCollection = dataSet.Tables[0].Rows;
            }
            DataRow dataRow = (DataRow)null;
            foreach (DataRowView row in dataCt.DefaultView)
            {
                if (dataRowCollection != null && (dataRow = dataRowCollection.Find(row["stt_rec"])) != null)
                {
                    row["tag"] = (object)"*";
                    row["date_pb"] = dataRow["date_pb"];
                    row["time_pb"] = dataRow["time_pb"];
                    row["user_id_pb"] = dataRow["user_id_pb"];
                    row["user_name_pb"] = dataRow["user_name_pb"];
                }
                else
                {
                    row["tag"] = (object)"";
                    row["date_pb"] = (object)DBNull.Value;
                    row["time_pb"] = (object)DBNull.Value;
                    row["user_id_pb"] = (object)DBNull.Value;
                    row["user_name_pb"] = (object)DBNull.Value;
                }
            }

            if (dataCt.DefaultView.Count <= 0)
                return;
        }
        catch (Exception ex)
        {

        }
    }

    public void Pb_tt(string stt_rec, PbInfo loc)
    {
        if (string.IsNullOrEmpty(Ma_dvcs) || Ma_dvcs.ToUpper().Equals("ALL"))
            Ma_dvcs = "%";
        if (string.IsNullOrEmpty(Ma_kh))
            Ma_kh = "%";
        string str = "";
        string _poststore = paramerter[0];
        string format = string.Format("exec [dbo].{0} '{1}','{2}','{3}','{4}','{5}','{6}','{7}','{8}'", _poststore, Ngay_ct1.ToString("yyyyMMdd"), Ngay_ct2.ToString("yyyyMMdd"), Ma_kh, "%", "", Ma_dvcs, stt_rec, Ma_nt);
        DataSet _ds = myDb.LoadDataSet(format).Copy();
        dataPh = _ds.Tables[0];
        dataCt = _ds.Tables[1];

        if (stt_rec != "" && dataPh.Rows.Count > 0)
            Ma_nt = dataPh.Rows[0]["ma_nt"].ToString().Trim();
    }

    private string GetFilter(string ma_dvcs, string ma_kh, string tk, string ma_nt, bool tag)
    {
        string str;
        if (M_PB_DVCS_CK == "1")
            str = string.Format("ma_dvcs like '{0}' AND ma_kh like '{1}' AND tk like '{2}' AND ma_nt LIKE '{3}'", (object)ma_dvcs, (object)ma_kh, (object)tk, (object)ma_nt);
        else
            str = string.Format("ma_kh like '{0}' AND tk like '{1}' AND ma_nt LIKE '{2}'", (object)ma_kh, (object)tk, (object)ma_nt);
        if (tag)
            str += " AND (tag = '*' OR tien_con_pt0 <> 0 OR tien_dt <> 0 OR tien_con_pt <> 0)";
        return str;
    }
    private void AutoAllocate()
    {
        int num2 = allocationType != "0" ? 0 : 1;
        Auto(num2);
    }

    public void Auto(int pb)
    {
        string ma_ct = "";

        if (SelectedDataPh != null)
        {
            DataRowView ph = (DataRowView)SelectedDataPh;
            ma_ct = ph.Row["ma_ct"].ToString();
            foreach (DataRowView dataRowView in (dataCt?.DefaultView?.Cast<DataRowView>().Where(v => v["check"]?.ToString() == "1" && v["tag"].ToString() == "*")) ?? Enumerable.Empty<DataRowView>())
            {
                Message = Lap["Phải xóa phân bổ của các hóa đơn trước!"];
                myStateMN.SetNewThongbao(Message);
                return;
            }
            string str = "ngay_dh";
            if (pb == 1)
                str = "ngay_ct,so_ct";

            dataCt.DefaultView.Sort = str;

            if (Phan_bo())
            {
                Message = Lap["Đã phân bổ xong!"];
                myStateMN.SetNewThongbao(Message);
                dataCt.AcceptChanges();
                StateHasChanged();
            }
            dataCt.DefaultView.Sort = "";
        }
    }
    private bool Phan_bo()
    {
        DataF3 dataF3 = new DataF3();
        dataF3.Tien = this.GetTienPb(SelectedDataPh);
        if (dataF3.Tien <= new Decimal(0))
        {
            Message = Lap["Phiếu đã phân bổ hết, không thể phân bổ tiếp!"];
            myStateMN.SetNewThongbao(Message);
            return false;
        }
        string str1 = "";
        string dien_giai = "";
        Decimal num1;
        DataRowView dataItem;
        DataRowView ph = (DataRowView)SelectedDataPh;
        dataF3.Stt_rec = ph.Row["stt_rec"].ToString();
        dataF3.Stt_rec0 = "001";
        dataF3.Ma_ct = ph.Row["ma_ct"].ToString();
        dataF3.Tk_i = ph.Row["tk_i"].ToString();
        dataF3.Tk_tt = ph.Row["tk_tt"].ToString();
        dien_giai = ph.Row["dien_giaii"].ToString().Replace("'", "''");
        num1 = new Decimal(0);
        foreach (DataRowView dataRowView in (dataCt?.DefaultView?.Cast<DataRowView>().Where(v => v["check"]?.ToString() == "1")) ?? Enumerable.Empty<DataRowView>())
        {
            dataF3.Tien_dt = dataF3.Tien_con_pt = ToDec(dataRowView["tien_con_pt"]);
            if (dataF3.Tien < dataF3.Tien_dt)
                dataF3.Tien_dt = dataF3.Tien;
            if (!(dataF3.Tien_dt <= new Decimal(0)))
            {
                dataF3.Stt_rec_tt = dataRowView["stt_rec"].ToString();
                dataRowView["tag"] = (object)"*";
                dataRowView["tien_con_pt"] = (object)(dataF3.Tien_con_pt - dataF3.Tien_dt);
                dataRowView["tien_dt"] = (object)dataF3.Tien_dt;
                dataRowView["date_pb"] = (object)DateTime.Today.Date;
                dataRowView["time_pb"] = (object)DateTime.Now.ToString("HH:mm:ss");
