    private Decimal GetTienPb(object ph)
    {
        DataRowView rec = (DataRowView)ph;
        string str = "SELECT stt_rec, SUM(tien_dt) as tien_dt FROM cttt30 WHERE stt_rec_tt IS NOT NULL AND RTRIM(stt_rec_tt) != '' AND stt_rec = '{1}' AND tk = '{2}' AND ma_kh = '{3}' GROUP BY stt_rec";
        Console.WriteLine(str);
        string cmdText = string.Format(str, M_ma_nt0, rec["stt_rec"].ToString(), rec["tk_i"].ToString(), rec["ma_kh"].ToString());
        DataSet dataSet = myDb.LoadDataSet(cmdText);
        Decimal dec = ToDec(rec["t_tien_nt"]);
        Decimal num = new Decimal(0);
        if (dataSet != null && dataSet.Tables.Count > 0 && dataSet.Tables[0].Rows.Count > 0)
            num = ToDec(dataSet.Tables[0].Rows[0]["tien_dt"]);
        rec["tien_chua_pb"] = (object)(dec - num);
        return dec - num;

        return 0m;
    }
