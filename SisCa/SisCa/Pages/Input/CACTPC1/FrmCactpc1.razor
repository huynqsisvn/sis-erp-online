    void OnSuaTienChanged(bool value)
    {
        CurPh.Sua_tien = value ? 1 : 0;
        CheckedChangeTien = value;
        CheckedTien = !value;

        IsVisibilityFieldsXamDataGridBySua_Tien();

        if (CurPh.Ma_nt.Trim().ToUpper() == M_ma_nt0.Trim().ToUpper())
            return;

        if (!value)
            return;

        decimal nValue1 = CurPh.Ty_gia;       // Tương đương txtTy_gia.nValue
        decimal nValue2 = CurPh.Ty_gia_htf;   // Tương đương txtTy_gia_ht.nValue

        switch (CurPh.Ma_gd)
        {
            case "1":
            case "2":
                foreach (var ct in LSCt)
                {
                    decimal ty_gia_ht2 = ct.Ty_gia_ht2;
                    decimal tien_nt = ct.Tien_nt;

                    decimal tien = Math.Round(ty_gia_ht2 * tien_nt, M_ROUND);
                    decimal tien_tt = (CurPh.Loai_cl_no == "0")
                        ? Math.Round(tien_nt * nValue1, M_ROUND)
                        : Math.Round(tien_nt * nValue2, M_ROUND);

                    ct.Tien = tien;
                    ct.Tien_tt = tien_tt;
                    ct.Tt = tien; // nếu tồn tại cột tt

                    TinhTienCltg(ct);
                }
                break;

            case "9":
                foreach (var ct in LSCt)
                {
                    decimal tien_nt = ct.Tien_nt;
                    decimal tien = Math.Round(nValue2 * tien_nt, M_ROUND);
                    decimal tien_tt = (CurPh.Loai_cl_no == "0")
                        ? Math.Round(tien_nt * nValue1, M_ROUND)
                        : Math.Round(tien_nt * nValue2, M_ROUND);

                    ct.Tien = tien;
                    ct.Tien_tt = tien_tt;
                    ct.Tt = tien;

                    TinhTienCltg(ct);
                }
                break;

            case "8":
            case "3":
                foreach (var ct in LSCt)
                {
                    decimal tien_nt = ct.Tien_nt;
                    decimal thue_nt = ct.Thue_nt;
                    decimal thue = ct.Thue;
                    decimal thue_suat = ct.Thue_suat;

                    if (ct.Loai_hd.Trim() == "2")
                    {
                        CalculateHd2(ct);
                    }
                    else
                    {
                        decimal tien = Math.Round(nValue2 * tien_nt, M_ROUND);
                        ct.Tien = tien;

                        // Tính thuế nếu có
                        if (thue_suat > 0)
                        {
                            thue_nt = Math.Round(tien_nt * thue_suat / 100, M_ROUND_NT);
                            thue = Math.Round(nValue2 * thue_nt, M_ROUND);
                            ct.Thue_nt = thue_nt;
                            ct.Thue = thue;
                        }

                        ct.Tt_nt = tien_nt + thue_nt;
                        ct.Tt = tien + thue;

                        decimal tien_tt = (CurPh.Loai_cl_no == "0")
                            ? Math.Round((tien_nt + thue_nt) * nValue1, M_ROUND)
                            : Math.Round((tien_nt + thue_nt) * nValue2, M_ROUND);

                        ct.Tien_tt = tien_tt;

                        TinhTienCltg(ct);
                    }
                }
                break;
        }
        UpdateTotalHT();
        if (LSCtgt != null && LSCtgt.Any())
        {
            foreach (var ct in LSCtgt)
            {
                decimal t_tien_nt = ct.T_tien_nt;
                decimal t_thue_nt = ct.T_thue_nt;
                decimal thue_suat = ct.Thue_suat;

                decimal t_tien = Math.Round(nValue2 * t_tien_nt, M_ROUND);

                ct.T_tien = t_tien;

                if (thue_suat > 0)
                {
                    t_thue_nt = Math.Round(t_tien_nt * thue_suat / 100, M_ROUND_NT);
                    decimal t_thue = Math.Round(t_thue_nt * nValue2, M_ROUND);
                    ct.T_thue_nt = t_thue_nt;
                    ct.T_thue = t_thue;
                }

                ct.T_tt_nt = t_tien_nt + t_thue_nt;
                ct.T_tt = t_tien + ct.T_thue;
            }
        }
        StateHasChanged();
    }

    private void TinhTienCltg(Ct46 ct)
    {
        decimal tien_tt = ct.Tien_tt;
        decimal tien = (CurPh.Ma_gd.Trim() == "8" || CurPh.Ma_gd.Trim() == "3")
            ? ct.Tt
            : ct.Tien;

        ct.Tien_cltg = tien - tien_tt;
    }
    private void CalculateHd2(Ct46 ct)
    {
        // Nếu có thuế suất
        if (ct.Thue_suat > 0)
        {
            decimal tt_nt = ct.Tt_nt;
            decimal ty_gia_ht = CurPh.Ty_gia_ht; // tương đương txtTy_gia_ht.nValue
            decimal thue_suat = ct.Thue_suat;

            // Tính tiền và thuế bằng ngoại tệ
            decimal tien_nt = Math.Round(tt_nt / (1 + thue_suat / 100));
            decimal thue_nt = tt_nt - tien_nt;

            ct.Tien_nt = tien_nt;
            ct.Thue_nt = thue_nt;

            // Nếu đơn vị tiền khác tiền chuẩn (VD: ngoại tệ)
            if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                decimal tien = Math.Round(tien_nt * ty_gia_ht);
                decimal thue = Math.Round(thue_nt * ty_gia_ht);
                decimal tt = Math.Round(tt_nt * ty_gia_ht);

                ct.Tien = tien;
                ct.Thue = thue;
                ct.Tt = tt;
            }
            else // Nếu cùng loại tiền với chuẩn (VNĐ)
            {
                ct.Tien = tien_nt;
                ct.Thue = thue_nt;
                ct.Tt = tt_nt;
            }
        }
        else // Không có thuế suất
        {
            decimal tt_nt = ct.Tt_nt;
            decimal thue_nt = ct.Thue_nt;
            decimal tien_nt = tt_nt - thue_nt;

            ct.Tien_nt = tien_nt;

            if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                decimal ty_gia_ht = CurPh.Ty_gia_ht;
                decimal tien = Math.Round(tien_nt * ty_gia_ht);
                decimal thue = Math.Round(thue_nt * ty_gia_ht);
                decimal tt = Math.Round(tt_nt * ty_gia_ht);

                ct.Tien = tien;
                ct.Thue = thue;
                ct.Tt = tt;
            }
            else
            {
                ct.Tien = tien_nt;
                ct.Thue = thue_nt;
                ct.Tt = tt_nt;
            }
        }
    }


    private void UpdateNt0()
    {
        // Nếu loại tiền khác đơn vị chuẩn thì không làm gì
        if (!CurPh.Ma_nt.Equals(M_ma_nt0, StringComparison.OrdinalIgnoreCase))
            return;

        // Gán lại các giá trị tổng của chứng từ (CurPh ~ PhView[0])
        CurPh.T_tien = CurPh.T_tien_tt = CurPh.T_tien_nt;
        CurPh.T_tt = CurPh.T_tt_nt;
        CurPh.T_tien_cltg = 0;
        CurPh.T_thue = CurPh.T_thue_nt;

        // Cập nhật từng dòng chi tiết (tương đương CtView)
        if (LSCt != null && LSCt.Any())
        {
            foreach (var ct in LSCt)
            {
                ct.Tien = ct.Tien_tt = ct.Tien_nt;
                ct.Tt = ct.Tt_nt;
                ct.Tien_cltg = 0;
                ct.Thue = ct.Thue_nt;
            }
        }

        // Cập nhật chi tiết thuế (tương đương DsTrans.Tables[2])
        if (LSCtgt != null && LSCtgt.Any())
        {
            foreach (var ctgt in LSCtgt)
            {
                ctgt.T_thue = ctgt.T_thue_nt;
                ctgt.T_tien = ctgt.T_tien_nt;
            }
        }

        StateHasChanged(); // Cập nhật lại UI
    }

