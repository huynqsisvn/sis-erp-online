                break;
            case "ma_kh_i":
                // CurrentEditModel.Ma_kh_i = value.Where(a => a.Key.Equals("ma_kh")).FirstOrDefault().Value.ToString();
                CurrentEditModel.Ten_kh_i = value.Where(a => a.Key.Equals("ten_kh")).FirstOrDefault().Value.ToString();
                break;
            case "ma_kh_t":
                // CurrentEditModel.Ma_kh_i = value.Where(a => a.Key.Equals("ma_kh")).FirstOrDefault().Value.ToString();
                CurrentEditModel.Ten_kh_t = value.Where(a => a.Key.Equals("ten_kh")).FirstOrDefault().Value.ToString();
                CurrentEditModel.Mst_t = value.Where(a => a.Key.Equals("ma_so_thue")).FirstOrDefault().Value.ToString();
                // CurrentEditModel.Dia_chi_t = value.Where(a => a.Key.Equals("dia_chi_t")).FirstOrDefault().Value.ToString();
                break;
            case "ma_thue_i":
                CurrentEditModel.Thue_suat = Convert.ToDecimal(value.Where(a => a.Key.Equals("thue_suat")).FirstOrDefault().Value);
                CurrentEditModel.Tk_thue_i = value.Where(a => a.Key.Equals("tk_thue_no")).FirstOrDefault().Value.ToString();

                if (CurrentEditModel.Thue_suat != 0)
                {
                    Decimal result1N = new Decimal(0);
                    result1N = CurrentEditModel.Thue_suat;
                    if (CurrentEditModel.Loai_hd.ToString().Trim().Equals("2"))
                    {
                        this.CalculateHd2(CurrentEditModel);
                    }
                    else
                    {
                        Decimal result2 = new Decimal(0);
                        result2 = CurrentEditModel.Tien_nt;
                        Decimal num1 = new Decimal(0);
                        Decimal num5 = result2 * result1N / new Decimal(100);
                        Decimal num6 = CurPh.Ma_nt.Trim().Equals(this.M_ma_nt0) ? Math.Round(num5, this.M_ROUND) : Math.Round(num5, this.M_ROUND_NT);
                        CurrentEditModel.Thue_nt = num6;
                        CurrentEditModel.Tt_nt = num6 + result2;


                        if (!CurPh.Ma_nt.Trim().Equals(this.M_ma_nt0))
                        {
                            Decimal result3 = new Decimal(0);
                            result3 = CurrentEditModel.Tien;
                            Decimal num4 = new Decimal(0);
                            Decimal num7 = Math.Round(result3 * result1N / new Decimal(100), this.M_ROUND);
                            CurrentEditModel.Thue = num7;
                            CurrentEditModel.Tt = result3 + num7;


                        }
                        else
                        {
                            CurrentEditModel.Tien = result2;
                            CurrentEditModel.Thue = num6;
                            CurrentEditModel.Tt = num6 + result2;

                        }
                    }
                    Decimal result4 = new Decimal(0);
                    Decimal nValue3 = CurPh.Ty_gia;
                    Decimal nValue4 = CurPh.Ty_gia_ht;
                    result4 = CurrentEditModel.Tt_nt;
                    Decimal num8 = !(CurPh.Loai_cl_no.ToString() == "0") ? Math.Round(result4 * nValue4, this.M_ROUND) : Math.Round(result4 * nValue3, this.M_ROUND);
                    CurrentEditModel.Tien_tt = num8;
                    this.Tinh_tien_cltg(CurrentEditModel);
                }
                break;
            case "loai_hd":
                {
                    if (!string.IsNullOrEmpty(CurrentEditModel.Loai_hd))
                    {
                        switch (CurrentEditModel.Loai_hd.ToString().Trim())
                        {
                            case "0":
                                CurrentEditModel.Ma_thue_i = "";
                                CurrentEditModel.Thue_suat = 0;
                                CurrentEditModel.Thue_nt = 0;
                                CurrentEditModel.Thue = 0;
                                CurrentEditModel.Tt_nt = CurrentEditModel.Tien_nt;
                                CurrentEditModel.Tt = CurrentEditModel.Tien;
                                CurrentEditModel.Ma_kh_t = "";
                                CurrentEditModel.Ma_ms = "";
                                break;
                            case "2":
                                this.CalculateHd2(CurrentEditModel);
                                break;
                        }
                    }
                    if (CurrentEditModel.Loai_hd.Trim() != "0")
                    {
                        if (string.IsNullOrEmpty(CurrentEditModel.Ma_kh_t) && string.IsNullOrEmpty(CurrentEditModel.Ten_kh_t))
                        {
                            if (CurrentEditModel.Stt > 1)
                            {
                                CurrentEditModel.Ma_kh_t = LSCt[LSCt.Count - 1].Ma_kh_t;
                                CurrentEditModel.Ten_kh_t = LSCt[LSCt.Count - 1].Ten_kh_t;
                                CurrentEditModel.Mst_t = LSCt[LSCt.Count - 1].Mst_t;
                            }
                            else
                            {
                                CurrentEditModel.Ma_kh_t = CurPh.Ma_kh;
                                CurrentEditModel.Ten_kh_t = CurPh.Ten_kh;
                                CurrentEditModel.Mst_t = CurPh.Ma_so_thue;
                            }

                        }
                        if (CurrentEditModel.Ma_ms.ToString().Trim() == "")
                            CurrentEditModel.Ma_ms = "1";
                        break;
                    }
                    break;

                }
            case "ma_ms":
                CurrentEditModel.Ma_ms = value.Where(a => a.Key.Equals("ma_ms")).FirstOrDefault().Value.ToString();
                break;

        }
        UpdateTotalHT();
    }

    void OnGridCTGT_DMDM_Changed(ExpandoObject value, string ma_dm)
    {
        switch (ma_dm.ToLower())
        {
            case "ma_kh":
                {
                    CurrentEditModelctgt.Ten_kh = value.Where(a => a.Key.Equals("ten_kh")).FirstOrDefault().Value.ToString();
                    CurrentEditModelctgt.Dia_chi = value.Where(a => a.Key.Equals("dia_chi")).FirstOrDefault().Value.ToString();
                    CurrentEditModelctgt.Ma_so_thue = value.Where(a => a.Key.Equals("ma_so_thue")).FirstOrDefault().Value.ToString();

                    break;
                }
            case "so_ct0":
                {

                    if (LSCtgt.Count == 1)
                    {
                        decimal result1 = 0;
                        decimal result2 = 0;

                        var enumerable = LSCt.Where(b => b.Stt_rec == CurPh.Stt_rec)
                            .Select(x => new
                            {
                                Tien_nt = x.Tien_nt,
                                Tien = x.Tien
                            });

                        if (enumerable != null)
                        {
                            result1 = enumerable.Sum(p => p.Tien_nt);
                            result2 = enumerable.Sum(p => p.Tien);

                            CurrentEditModelctgt.T_tien_nt = result1;
                            CurrentEditModelctgt.T_tien = result2;
                        }
                    }
                    break;
                }


            case "t_tien_nt":
                {
                    if (decimal.TryParse(CurrentEditModelctgt.T_tien_nt.ToString(), out var tienNt))
                    {
                        decimal thueSuat = CurrentEditModelctgt.Thue_suat;
                        decimal numThueNt = tienNt * thueSuat / 100;
                        decimal numThueNtRounded = NotMaNt0Voucher ? Math.Round(numThueNt, M_ROUND_NT) : Math.Round(numThueNt, M_ROUND);
                        CurrentEditModelctgt.T_thue_nt = numThueNtRounded;
                        CurrentEditModelctgt.T_tt_nt = tienNt + numThueNtRounded;

                        if (!NotMaNt0Voucher)
                        {
                            decimal numTien = Math.Round(CurPh.Ty_gia * tienNt, M_ROUND);
                            CurrentEditModelctgt.T_tien = numTien;
                            decimal numThue = Math.Round(numTien * thueSuat / 100, M_ROUND);
                            CurrentEditModelctgt.T_thue = numThue;
                            CurrentEditModelctgt.T_tt = numTien + numThue;
                        }
                        else
                        {
                            CurrentEditModelctgt.T_tien = tienNt;
                            CurrentEditModelctgt.T_thue = numThueNtRounded;
                            CurrentEditModelctgt.T_tt = tienNt + numThueNtRounded;
                        }
                    }
                    UpdateTotalThue();
                    break;
                }

            case "t_tien":
                {
                    if (CurrentEditModelctgt.T_tien == 0)
                    {
                        decimal tyGia = CurPh.Ty_gia;
                        CurrentEditModelctgt.T_tien = Math.Round(tyGia * CurrentEditModelctgt.T_tien_nt, M_ROUND);
                    }

                    decimal thueSuat = CurrentEditModelctgt.Thue_suat;
                    decimal thue = Math.Round(CurrentEditModelctgt.T_tien * thueSuat / 100, M_ROUND);
                    CurrentEditModelctgt.T_thue = thue;
                    CurrentEditModelctgt.T_tt = CurrentEditModelctgt.T_tien + thue;
                    UpdateTotalThue();
                    break;
                }

            case "ma_thue":
                {
                    CurrentEditModelctgt.Thue_suat = decimal.Parse(value.First(a => a.Key == "thue_suat").Value.ToString());
                    CurrentEditModelctgt.Tk_thue_no = value.First(a => a.Key == "tk_thue_no").Value.ToString();

                    decimal num7 = CurrentEditModelctgt.T_tien_nt;
                    decimal num8 = CurrentEditModelctgt.T_tien;
                    decimal num9 = CurrentEditModelctgt.Thue_suat;

                    decimal num10 = num7 * (num9 / 100) * CurPh.Ty_gia;
                    if (num10 != 0)
                    {
                        CurrentEditModelctgt.T_thue_nt = num10;
                        CurrentEditModelctgt.T_tt_nt = num7 + num10;
                    }

                    decimal num11 = num8 * num9 / 100;
                    if (num11 != 0)
                    {
                        CurrentEditModelctgt.T_thue = num11;
                        CurrentEditModelctgt.T_tt = num8 + num11;
                    }

                    if (!NotMaNt0Voucher)
                    {
                        CurrentEditModelctgt.T_thue_nt = CurrentEditModelctgt.T_thue;
                    }

                    UpdateTotalThue();
                    break;
                }

            case "t_thue_nt":
                {
                    if (CurrentEditModelctgt.T_thue_nt == 0)
                    {
                        decimal thue_nt = CurrentEditModelctgt.T_tien_nt * CurrentEditModelctgt.Thue_suat / 100;
                        CurrentEditModelctgt.T_thue_nt = NotMaNt0Voucher ? Math.Round(thue_nt, M_ROUND_NT) : Math.Round(thue_nt, M_ROUND);
                    }

                    CurrentEditModelctgt.T_tt_nt = CurrentEditModelctgt.T_tien_nt + CurrentEditModelctgt.T_thue_nt;

                    if (NotMaNt0Voucher)
                    {
                        decimal nValue = CurPh.Ty_gia;
                        CurrentEditModelctgt.T_thue = Math.Round(CurrentEditModelctgt.T_thue_nt * nValue, M_ROUND);
                        CurrentEditModelctgt.T_tt = CurrentEditModelctgt.T_tien + CurrentEditModelctgt.T_thue;
                    }
                    else
                    {
                        CurrentEditModelctgt.T_tien = CurrentEditModelctgt.T_tien_nt;
                        CurrentEditModelctgt.T_thue = CurrentEditModelctgt.T_thue_nt;
                        CurrentEditModelctgt.T_tt = CurrentEditModelctgt.T_tt_nt;
                    }

                    UpdateTotalThue();
                    break;
                }

            case "t_thue":
                {
                    if (CurrentEditModelctgt.T_thue == 0)
                    {
                        CurrentEditModelctgt.T_thue = Math.Round(CurrentEditModelctgt.T_tien * CurrentEditModelctgt.Thue_suat / 100, M_ROUND);
                    }

                    CurrentEditModelctgt.T_tt = CurrentEditModelctgt.T_tien + CurrentEditModelctgt.T_thue;
                    UpdateTotalThue();
                    break;
                }



        }

    }
