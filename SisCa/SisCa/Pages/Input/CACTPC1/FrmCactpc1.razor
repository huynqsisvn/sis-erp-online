    private void UpdateTotalHT()
    {
        var current = LSCt.Where(x => x.Stt_rec == CurPh.Stt_rec);

        CurPh.T_tien_nt = current.Sum(x => x.Tien_nt);
        CurPh.T_tien = current.Sum(x => x.Tien);
        CurPh.T_thue_nt = current.Sum(x => x.Thue_nt);
        CurPh.T_thue = current.Sum(x => x.Thue);
        CurPh.T_tt_nt = CurPh.T_tien_nt + CurPh.T_thue_nt;
        CurPh.T_tt = CurPh.T_tien + CurPh.T_thue;

        if (CurPh.T_thue_nt == 0)
            UpdateTotalThue();
    }

