    private void Tinh()
    {
        if (LSCt != null && CurPh != null && CurPh.Sua_tggs != 1m)
        {
            if (!(CurPh.Ma_nt == M_ma_nt0))
            {
                Exec();
            }
        }
    }

    private void Exec()
    {
        TinhPh();
        TinhCt();
    }

    private void TinhPh()
    {
        if (!(CurPh.Ma_ct == "PT1") && !(CurPh.Ma_ct == "BC1"))
        {
            decimal tggs = GetTggs(CurPh.Tk, CurPh.Ty_gia, "CO");
            if (!(CurPh.Ty_gia == tggs))
            {
                CurPh.Ty_giaf = tggs;
                CurPh.Ty_gia = tggs;
            }
        }
    }

    private void TinhCt()
    {
        if (CurPh.Ma_gd == "1" || CurPh.Ma_gd != "2")
        {
            return;
        }


        foreach (Ct46 ct in LSCt)
        {
            string text = ct.Tk_i.Trim();
            if (text == "")
            {
                break;
            }

            decimal ty_gia = ct.Ty_gia_ht2;
            decimal tggs;
            int loaicl_no_co;
            if (CurPh.Ma_ct == "PT1" || CurPh.Ma_ct == "BC1")
            {
                tggs = GetTggs(text, ty_gia, "CO");
                loaicl_no_co = GetLoaicl_no_co(text, "CO");
            }
            else
            {
                tggs = GetTggs(text, ty_gia, "NO");
                loaicl_no_co = GetLoaicl_no_co(text, "NO");
            }

            if (loaicl_no_co != 2)
            {
                // Xác định tỷ giá hiển thị theo loại
                decimal ty_giahtf2 = tggs;

                // Gán lại các giá trị tương ứng vào record
                ct.Ty_giahtf2 = ty_giahtf2;
                ct.Ty_gia_ht2 = tggs;

                // Nếu không cho phép sửa tiền thì tính lại tiền quy đổi
                if (CurPh.Sua_tien != 1m)
                {
                    decimal tien_nt = ct.Tien_nt;
                    ct.Tien = Math.Round(tien_nt * tggs, M_ROUND);
                }
            }
        }
    }

    private decimal GetTggs(string tk, decimal ty_gia, string loai_cl)
    {
        DataSet dataSet = myDb.LoadDataSet(GetCommandTggs(tk));
        if (dataSet == null || dataSet.Tables.Count == 0 || dataSet.Tables[0].Rows.Count == 0)
        {
            return ty_gia;
        }

        if (dataSet != null && dataSet.Tables.Count > 1 && dataSet.Tables[dataSet.Tables.Count - 1].Rows.Count > 0)
        {

            int num = Convert.ToInt32(dataSet.Tables[1].Rows[0]["loai_cl_no"]);
            int num2 = Convert.ToInt32(dataSet.Tables[1].Rows[0]["loai_cl_co"]);
            if (dataSet.Tables[1].Rows[0]["ma_nt"].ToString() == M_ma_nt0)
            {
                return ty_gia;
            }

            int num3 = ((loai_cl == "NO") ? num : num2);
            switch (num3)
            {
                case 0:
                case 2:
                    return ty_gia;
                case 5:
                    return CurPh.Ty_gia;
            }

            if (num3 != 1 && num3 != 4)
            {
                return ty_gia;
            }
        }

        return (decimal)dataSet.Tables[0].Rows[0]["ty_gia"];
    }

