    public static int ToInt(object value)
    {
        if (value == null || value is DBNull)
        {
            return 0;
        }

        int result = 0;
        int.TryParse(value.ToString(), out result);
        return result;
    }

    public int GetLoaicl_no_co(string tk, string sloai_cl)
    {
        int num = -1;
        string sqlCommand;
        if (sloai_cl.Equals("NO"))
        {
            sqlCommand = string.Format("Select loai_cl_no From dmtk Where tk like '{0}'", tk.Trim());
        }
        else
        {
            sqlCommand = string.Format("Select loai_cl_co From dmtk Where tk like '{0}'", tk.Trim());
        }
        DataSet ds = myDb.LoadDataSet(sqlCommand);

        return (ds == null) ? num : Convert.ToInt32(ds.Tables[0].Rows[0][0].ToString());
    }


