    private void UpdateTotalThue()
    {
        try
        {
            if (curActionTask == ActionTask.View)
                return;

            decimal result1 = 0; // t_thue_nt
            decimal result2 = 0; // t_thue

            if (LSCtgt != null && LSCtgt.Any())
            {
                result1 = LSCtgt.Sum(th => th.T_thue_nt);
                result2 = LSCtgt.Sum(th => th.T_thue);
            }

            decimal num3 = CurPh.T_tien_nt + result1;
            decimal num4 = CurPh.T_tien + result2;

            CurPh.T_thue_nt = result1;
            CurPh.T_thue = result2;
            CurPh.T_tt_nt = num3;
            CurPh.T_tt = num4;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi trong UpdateTotalThue: {ex.Message}");
        }
    }

    private void CalculateTyGia()
    {
        if (CurrentEditModel == null) return;
        decimal ty_gia = CurPh.Ty_gia;
        decimal ty_gia_ht = CurPh.Ty_gia_ht;
        string loai_cl_no = CurPh.Loai_cl_no;
        string ma_gd = CurPh.Ma_gd;
        string ma_nt = CurPh.Ma_nt;
        string ma_nt0 = M_ma_nt0;

        if (CurPh.Sua_tien == 1)
            return;

        if (ma_gd is "2" or "3")
        {
            foreach (var r in LSCt)
            {
                var tien_nt = r.Tien_nt;
                var tien_tt = (loai_cl_no == "0")
                    ? Math.Round(tien_nt * ty_gia, M_ROUND)
                    : Math.Round(tien_nt * ty_gia_ht, M_ROUND);

                if (!ma_nt.Equals(ma_nt0, StringComparison.OrdinalIgnoreCase))
                {
                    r.Tien_tt = tien_tt;
                    Tinh_tien_cltg(r);
                }

                if (CurrentEditModel != null &&r.Stt_rec0 == CurrentEditModel.Stt_rec0)
                {
                    CurrentEditModel.Tt = r.Tt;
                }
            }
        }
        else if (ma_gd == "9")
        {
            foreach (var r in LSCt)
            {
                var tien_nt = r.Tien_nt;
                r.Tien = Math.Round(tien_nt * ty_gia_ht, M_ROUND);
                r.Tien_tt = (loai_cl_no == "0")
                    ? Math.Round(tien_nt * ty_gia, M_ROUND)
                    : Math.Round(tien_nt * ty_gia_ht, M_ROUND);
                r.Tt = r.Tien_tt;
                Tinh_tien_cltg(r);


                if (CurrentEditModel != null &&r.Stt_rec0 == CurrentEditModel.Stt_rec0)
                {
                    CurrentEditModel.Tien = r.Tien;
                    CurrentEditModel.Tien_tt = r.Tien_tt;
                    CurrentEditModel.Tt = r.Tt;
                }
            }
        }
        else if (ma_gd is "8" or "3")
        {
            foreach (var r in LSCt)
            {
                if (r.Loai_hd == "2")
                {
                    CalculateHd2(r);
                    continue;
                }

                var tien_nt = r.Tien_nt;
                var thue_nt = r.Thue_nt;
                var thue = r.Thue;

                r.Tien = Math.Round(ty_gia_ht * tien_nt, M_ROUND);

                if (CurPh.Sua_tien == 0 && r.Thue_suat != 0)
                {
                    thue_nt = Math.Round(tien_nt * r.Thue_suat / 100, M_ROUND_NT);
                    thue = Math.Round(ty_gia_ht * thue_nt, M_ROUND);
                    r.Thue_nt = thue_nt;
                    r.Thue = thue;
                }

                var tien_tt = (loai_cl_no == "0")
                    ? Math.Round((tien_nt + thue_nt) * ty_gia, M_ROUND)
                    : Math.Round((tien_nt + thue_nt) * ty_gia_ht, M_ROUND);

                r.Tt_nt = tien_nt + thue_nt;
                r.Tt = r.Tien + r.Thue;
                r.Tien_tt = tien_tt;
                Tinh_tien_cltg(r);

                if (CurrentEditModel != null && r.Stt_rec0 == CurrentEditModel.Stt_rec0)
                {
                    CurrentEditModel.Tt_nt = r.Tien;
                    CurrentEditModel.Tien_tt = r.Tien_tt;
                    CurrentEditModel.Tt = r.Tt;
                    CurrentEditModel.Tien = r.Tien;
                    CurrentEditModel.Thue_nt = r.Thue_nt;
                    CurrentEditModel.Thue = r.Thue;


                }
            }
        }
        else if (ma_gd == "1")
        {
            foreach (var r in LSCt)
            {
                var tien_nt = r.Tien_nt;
                var ty_gia_ht2 = r.Ty_gia_ht2;
                r.Tien = Math.Round(tien_nt * ty_gia_ht2, M_ROUND);
                r.Tien_tt = (loai_cl_no == "0")
                    ? Math.Round(tien_nt * ty_gia, M_ROUND)
                    : Math.Round(tien_nt * ty_gia_ht, M_ROUND);
                Tinh_tien_cltg(r);
                if (CurrentEditModel != null && r.Stt_rec0 == CurrentEditModel.Stt_rec0)
                {
                    CurrentEditModel.Tien_tt = r.Tien_tt;
                    CurrentEditModel.Tien = r.Tien;
                }
            }
        }

        // PreSum_All();
        UpdateTotalHT();
        if (LSCtgt.Any())
        {
            foreach (var r in LSCtgt)
            {
                if (r.T_tien_nt == 0) continue;

                var t_tien_nt = r.T_tien_nt;
                var t_thue_nt = r.T_thue_nt;
                var t_thue = r.T_thue;

                r.T_tien = Math.Round(ty_gia_ht * t_tien_nt, M_ROUND);

                if (CurPh.Sua_tien == 0 && r.Thue_suat != 0)
                {
                    t_thue_nt = Math.Round(t_tien_nt * r.Thue_suat / 100, M_ROUND_NT);
                    t_thue = Math.Round(t_thue_nt * ty_gia_ht, M_ROUND);
                    r.T_thue_nt = t_thue_nt;
                    r.T_thue = t_thue;
                }

                r.T_tt_nt = t_tien_nt + t_thue_nt;
                r.T_tt = r.T_tien + r.T_thue;
            }
        }
        StateHasChanged(); // Cập nhật lại UI

    }

    private void Update_nt0()
    {
        if (CurPh.Ma_nt != M_ma_nt0)
            return;

        CurPh.T_tien = CurPh.T_tien_tt = CurPh.T_tien_nt;
        CurPh.T_tt = CurPh.T_tt_nt;
        CurPh.T_tien_cltg = 0;
        CurPh.T_thue = CurPh.T_thue_nt;

        foreach (var row in LSCt)
        {
            row.Tien = row.Tien_tt = row.Tien_nt;
            row.Tt = row.Tt_nt;
            row.Tien_cltg = 0;
            row.Thue = row.Thue_nt;
        }

        foreach (var tax in LSCtgt)
        {
            tax.T_thue = tax.T_thue_nt;
            tax.T_tien = tax.T_tien_nt;
        }
    }

