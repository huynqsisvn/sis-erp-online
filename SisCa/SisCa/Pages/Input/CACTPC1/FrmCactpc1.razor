    public static Decimal ToDec(object value)
    {
        return value == null || value is DBNull ? new Decimal(0) : (Decimal)value;
    }

    public void UpdateF3()
    {
        if (Tt_dn_nt > dataF3.Tien)
        {
            string message = "Số tiền thanh toán không được lớn hơn số tiền còn phải trả!";
            myStateMN.SetNewThongbao(message);
            return;
        }
        Decimal num1 = 0;
        DataRowView dataItem1 = (DataRowView)SelectedDataPh;
        dataF3.Tien_dt = Tt_dn_nt;
        if (dataF3.Tien < dataF3.Tien_dt)
            dataF3.Tien_dt = dataF3.Tien;

        if (dataF3.Tien_dt > new Decimal(0))
        {
            foreach (DataRowView dataRowView in (dataCt?.DefaultView?.Cast<DataRowView>().Where(v => v["check"]?.ToString() == "1")) ?? Enumerable.Empty<DataRowView>())
            {
                if (num1 < dataF3.Tien_dt)
                {
                    dataF3.Stt_rec_tt = dataRowView["stt_rec"].ToString();
                    UpdateOnServerF3();
                    dataF3.Tien_con_pt = (ToDec(dataRowView["tien_con_pt0"]) - dataF3.Tien_dt);
                    dataF3.Tien -= dataF3.Tien_dt;
                    num1 += dataF3.Tien_dt;
                    dataRowView["tien_con_pt"] = (object)dataF3.Tien_con_pt;
                    dataRowView["tien_dt"] = (object)dataF3.Tien_dt;
                    dataRowView["tag"] = (object)"*";
                    dataRowView["date_pb"] = (object)DateTime.Today.Date;
                    dataRowView["time_pb"] = (object)DateTime.Now.ToString("hh:mm:ss");
                    dataRowView["user_id_pb"] = curUser.User_id;
                    dataRowView["user_name_pb"] = curUser.User_name;
                    Decimal da_pb = ToDec(dataItem1["da_pb"]);
                    dataItem1["da_pb"] = (object)(da_pb - dataF3.Tien_dt0 + dataF3.Tien_dt);
                    da_pb = ToDec(dataItem1["da_pb"]);
                    dataItem1["tien_chua_pb"] = (object)(ToDec(dataItem1["t_tien_nt"]) - da_pb);
                    if (da_pb >= dataF3.Tien_dt)
                        break;
                }
            }
        }
        Message = Lap["Đã phân bổ xong!"];
        myStateMN.SetNewThongbao(Message);
        VisibleF3 = false;
        StateHasChanged();
    }

    private void UpdateOnServerF3()
    {
        string sqlcmd = string.Format(CultureInfo.InvariantCulture, "\nEXEC " + paramerter[2] + " '{0}', '{1}', '{2}', '{3}', N'{4}', '{5}', '{6}', 1, {7};", (object)dataF3.Stt_rec, (object)dataF3.Stt_rec_tt, (object)dataF3.Tk_i, (object)dataF3.Tk_tt, (object)dataF3.Dien_giai, (object)dataF3.Ma_ct, (object)dataF3.Tien_dt, (object)curUser.User_id);
        myDb.ExecuteSqlQueryAsync(sqlcmd);
    }

