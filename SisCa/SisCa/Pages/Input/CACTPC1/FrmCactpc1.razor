                        result5 = newvalue;
                        result2 = CurrentEditModel.Tien;
                        CurrentEditModel.Tt = (result5 + result2);
                        this.Tinh_tien_cltg(CurrentEditModel);
                    }
                    break;
            }
        }
        UpdateTotalHT();
    }



