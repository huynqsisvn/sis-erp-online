    private async Task ChangeTyGia()
    {
        Decimal nValue1 = CurPh.Ty_gia;
        Decimal nValue2 = CurPh.Ty_gia_ht;
        Decimal num1;
        Decimal num2;
        Decimal num3;
        switch (CurPh.Ma_gd)
        {
            case "8":
            case "3":
                foreach (var record in LSCt)
                {
                    decimal tien_nt = record.Tien_nt;
                    decimal tien = Math.Round(nValue2 * tien_nt, M_ROUND);

                    decimal thue_nt = record.Thue_nt;
                    decimal thue = Math.Round(nValue2 * thue_nt, M_ROUND);

                    decimal tien_tt = (CurPh.Loai_cl_no == "0")
                        ? Math.Round((tien_nt + thue_nt) * nValue1, M_ROUND)
                        : Math.Round((tien_nt + thue_nt) * nValue2, M_ROUND);

                    record.Tien = tien;
                    record.Tien_tt = tien_tt;
                    record.Thue = thue;
                    record.Tt = tien + thue;

                    if (CurrentEditModel != null && record.Stt_rec0 == CurrentEditModel.Stt_rec0)
                    {
                        CurrentEditModel.Tien = record.Tien;
                        CurrentEditModel.Tien_tt = record.Tien_tt;
                        CurrentEditModel.Thue = record.Thue;
                        CurrentEditModel.Tt = record.Tt;
                    }

                    // Tinh_tien_cltg(record);
                }
                break;

            case "9":
                foreach (var record in LSCt)
                {
                    decimal tien_nt = record.Tien_nt;
                    decimal tien = Math.Round(nValue2 * tien_nt, M_ROUND);
                    decimal tien_tt = (CurPh.Loai_cl_no == "0")
                        ? Math.Round(tien_nt * nValue1, M_ROUND)
                        : Math.Round(tien_nt * nValue2, M_ROUND);

                    record.Tien = tien;
                    record.Tien_tt = tien_tt;
                    record.Tt = tien;

                    if (CurrentEditModel != null && record.Stt_rec0 == CurrentEditModel.Stt_rec0)
                    {
                        CurrentEditModel.Tien = record.Tien;
                        CurrentEditModel.Tien_tt = record.Tien_tt;
                        CurrentEditModel.Tt = record.Tt;
                    }
                    // Tinh_tien_cltg(record);
                }
                break;

            default:

                foreach (var record in LSCt)
                {
                    decimal tien_nt = record.Tien_nt;
                    decimal tien_tt = (CurPh.Loai_cl_no == "0")
                        ? Math.Round(tien_nt * nValue1, M_ROUND)
                        : Math.Round(tien_nt * nValue2, M_ROUND);

                    record.Tien_tt = tien_tt;


                    if (CurrentEditModel != null && record.Stt_rec0 == CurrentEditModel.Stt_rec0)
                    {
                        CurrentEditModel.Tt = record.Tt;
                    }
                    // Tinh_tien_cltg(record);
                }
                break;
        }
        CalculateTyGia();
        await GridCT.SaveChangesAsync();

    }

