    void OnAutoCompleteDMNXChanged(ExpandoObject value)
    {
        CurPh.Tk = value.Where(a => a.Key.Equals("tk0")).FirstOrDefault().Value.ToString();
        CurPh.Ma_nt = value.Where(a => a.Key.Equals("ma_nt")).FirstOrDefault().Value.ToString();

        string sql = string.Format("select ty_gia from dmtgnt where ma_nt = '{0}' ORDER by ngay_ct DESC", CurPh.Ma_nt == null ? "VND" : CurPh.Ma_nt);
        DataSet ds = myDb.LoadDataSet(sql);
        if (ds != null && ds.Tables.Count > 0)
        {
            CurPh.Ty_gia = decimal.Parse(ds.Tables[0].Rows[0][0].ToString());
        }
        NotMaNt0Voucher = !(CurPh?.Ma_nt?.Equals(M_ma_nt0) ?? true);
        if (NotMaNt0Voucher) CheckedTien = true;
        else CheckedTien = false;
        // if (LSCt.Count() > 0)
        // {
        //     Tinh_tien_cltg();
        // }
        if (CurPh.Ma_gd == "3" && value.Where(a => a.Key.Equals("ma_nt")).FirstOrDefault().Value.ToString() != M_ma_nt0)
        {
            Message = Lap["Đồng tiền giao dịch với mã gd số 3 phải là đồng tiền hạch toán."];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
        }
        else
        {

            CurPh.Loai_cl_co = value.Where(a => a.Key.Equals("loai_cl_co")).FirstOrDefault().Value.ToString();
            CurPh.Loai_cl_no = value.Where(a => a.Key.Equals("loai_cl_no")).FirstOrDefault().Value.ToString();
            string str = CurPh.Loai_cl_no.ToString();
            if (CurPh.Ma_nt.Trim().Equals(M_ma_nt0))
            {
                CurPh.Ty_gia = 1;
            }
            else
            {
                switch (CurPh.Ma_gd)
                {
                    case "1":
                    case "2":
                    case "3":
                        if (str == "0")
                        {
                            CurPh.Ty_gia_ht = 0;
                            break;
                        }
                        CurPh.Ty_gia = 0;

                        if (CurPh.Ty_gia_ht == 0)
                            CurPh.Ty_gia_ht = this.GetTggd(CurPh.Ma_nt, CurPh.Ngay_ct);
                        break;
                    case "8":
                    case "9":
                        if (str != "0")
                            CurPh.Ty_gia = 0;
                        if (CurPh.Ty_gia_ht == 0)
                        {
                            CurPh.Ty_gia_ht = this.GetTggd(CurPh.Ma_nt, CurPh.Ngay_ct);
                            break;
                        }
                        break;
                }
                OnAutoCompleteMaNTHTChanged(0);
            }
        }
        StateHasChanged();

    }


    private Decimal GetTggd(string ma_nt, DateTime ngay_ct)
    {
        Decimal num = new Decimal(0);
        string format = string.Format("SELECT ty_gia FROM dmtgnt WHERE ma_nt = '{0}' AND ngay_ct <= '{1}' ORDER by ngay_ct DESC", ma_nt, ngay_ct.ToString("yyyyMMdd"));
        DataTable dataTable = myDb.LoadDataSet(format).Tables[0].Copy();
        if (dataTable.Rows.Count != 0)
            num = (Decimal)dataTable.Rows[0][0];
        return num;
    }

