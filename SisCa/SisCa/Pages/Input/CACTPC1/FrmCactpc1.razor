    bool CheckValid()
    {
        bool flag = true;

        // Kiểm tra ngày hạch toán
        if (string.IsNullOrEmpty(CurPh.Ngay_ct.ToString()) && flag)
        {
            Message = Lap["Chưa vào ngày hạch toán!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra quyển số
        if (string.IsNullOrEmpty(CurPh.Ma_qs) && flag)
        {
            Message = Lap["Chưa vào quyển số!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra số chứng từ
        if (string.IsNullOrEmpty(CurPh.So_ct) && flag)
        {
            Message = Lap["Chưa vào Số c.từ!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra tài khoản nợ
        if (string.IsNullOrEmpty(CurPh.Tk) && flag)
        {
            Message = Lap["Chưa vào tài khoản có!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }
        // Kiểm tra tài khoản nợ
        if (CurPh.Ma_dvcs.ToUpper() == "ALL" && flag)
        {
            Message = Lap["Chưa chọn dvcs!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra mã giao dịch = 3 và ngoại tệ
        if (CurPh.Ma_gd.Equals("3") && CurPh.Ma_nt != M_ma_nt0)
        {
            Message = Lap["Đồng tiền giao dịch với mã gd số 3 phải là đồng tiền hạch toán."];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }

        // Kiểm tra chi tiết
        if (LSCt.Count > 0 && flag)
        {
            foreach (Ct46 ct in LSCt)
            {
                if (string.IsNullOrEmpty(ct.Tk_i?.Trim()))
                {
                    Message = Lap["Chưa vào tài khoản nợ!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;
                }
                if (string.IsNullOrEmpty(ct.So_ct0?.Trim()) && CurPh.Ma_gd == "1")
                {
                    Message = Lap["Chưa vào chi tiết!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;
                }
                if (!string.IsNullOrEmpty(ct.Ma_thue_i?.Trim()) && string.IsNullOrEmpty(ct.Tk_thue_i?.Trim()))
                {
                    Message = Lap["Chưa vào tk thuế, không lưu được!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;
                }
                if (string.IsNullOrEmpty(ct.Ma_kh_i?.Trim()) && CurPh.Ma_gd == "3")
                {
                    Message = Lap["Chưa vào mã khách hàng, không lưu được!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;
                }

            }
        }

        // Logic từ WinForm - kiểm tra tổng tiền và xử lý dữ liệu

        Decimal result1 = new Decimal(0);
        Decimal num1 = new Decimal(0);
        Decimal.TryParse(CurPh.T_tien_nt.ToString(), out result1);

        // Kiểm tra tổng tiền ngoại tệ
        if (result1 != CurPh.T_tien_nt)
        {
            Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = true;
        }
        else if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0.Trim()) && num1 != CurPh.T_tien_nt)
        {
            Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = true;
        }
        if (LSCtgt.Count > 0 && flag)
        {
            foreach (Ct46gt ctgt in LSCtgt)
            {
                string so_ct0 = ctgt.So_ct0.Trim();
                string so_seri0 = (ctgt.So_seri0 ?? "").Trim();
                string str;
                if (!string.IsNullOrEmpty(ctgt.Ngay_ct0.ToString().Trim()))
                {
                    DateTime dateTime = ctgt.Ngay_ct0 ?? DateTime.Now;
                    dateTime = dateTime.Date;
                    str = dateTime.ToShortDateString().Substring(0, 10);
                }
                else
                    str = "";
                string ngay_ct0 = str;
                string ma_so_thue = ctgt.Ma_so_thue.ToString().Trim();
                if (CheckExistHDVao(CurPh.Stt_rec, so_ct0, so_seri0, ngay_ct0, ma_so_thue))
                {
                    string mes = string.Format("Hoá đơn số [{0}], ký hiệu [{1}], ngày [{2}], MST [{3}] đã tồn tại!", (object)so_ct0, (object)so_seri0, (object)ngay_ct0, (object)ma_so_thue);
                    Message = Lap[mes];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = true;
                }
                if (!string.IsNullOrEmpty(ctgt.So_ct0.ToString().Trim()) && string.IsNullOrEmpty(ctgt.Ngay_ct0.ToString().Trim()))
                {
                    Message = Lap["Chưa vào ngày hóa đơn. Không lưu được!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = true;
                }
                if (string.IsNullOrEmpty(ctgt.Tk_thue_no.ToString().Trim()))
                {
                    Decimal result = new Decimal(0);
                    result = ctgt.T_thue_nt;
                    if (!string.IsNullOrEmpty(ctgt.So_ct0.ToString().Trim()) && result > new Decimal(0))
                    {
                        Message = Lap["Chưa vào tk thuế, không lưu được!"];
                        myStateMN.SetNewThongbao(Message);
                        StateHasChanged();
                        flag = true;
                    }
                }
            }
        }



        if (!flag)
        {

            decimal sumTienNt = 0m;
            decimal sumTien = 0m;
            decimal sumTienTt = 0m;
            decimal sumTtNt = 0m;


            decimal ty_gia = CurPh.Ty_gia;
            decimal ty_gia_ht = CurPh.Ty_gia_ht;

            if (!CurPh.Ma_nt.Trim().Equals(M_ma_nt0) && (LSCt?.Count ?? 0) > 0 && ty_gia != 0m && !(CurPh.Sua_tien == 1))
            {

                if (CurPh.Ma_gd == "1" || CurPh.Ma_gd == "2")
                {
                    // Tổng tiền_nt của chi tiết cùng stt_rec
                    decimal totalTienNt = LSCt.Sum(x => x.Tien_nt);
                    // Tính d6 theo loai_cl_no
                    decimal d6 = CurPh.Loai_cl_no == "0"
                        ? Math.Round(ty_gia * totalTienNt, M_ROUND)
                    : Math.Round(ty_gia_ht * totalTienNt, M_ROUND);

                    // Tổng tien_tt từ CtData (nếu có)
                    decimal totalTienTt = LSCt.Sum(x => x.Tien_tt);
                    decimal num5 = LSCt[0].Tien_tt;
                    // CtView[0]["tien_tt"] += d6 - totalTienTt
                    num5 += (d6 - totalTienTt);
                    LSCt[0].Tien_tt = num5;
                    // Nếu tất cả ty_gia_ht2 giống Ty_gia => cập nhật tien = CtView[0]["tien_tt"]
                    bool allSameTyGia = LSCt.All(x => IsEquals(x.Ty_gia_ht2, CurPh.Ty_gia, x.Stt_rec));
                    if (allSameTyGia)
                    {
                        LSCt[0].Tien = num5;
                    }
                    // PreSum_All();
                    UpdateTotalHT();
                }
                else
                {
                    // Trường hợp Ma_GD khác 1,2
                    int countLoai2 = LSCt.Count(x => x.Loai_hd == "2");
                    int countSpecial = LSCt.Count(x => (x.Tien_nt == 0m || ty_gia == 0m) && x.Tien != 0m && x.Loai_hd != "2");

                    if (countSpecial + countLoai2 < LSCt.Count)
                    {
                        // Tổng các giá trị cần thiết
                        sumTienNt = LSCt.Sum(x => x.Tien_nt);
                        sumTtNt = LSCt.Sum(x => x.Tt_nt);
                        sumTien = LSCt.Sum(x => x.Tien);
                        sumTienTt = LSCt.Sum(x => x.Tien_tt);

                        decimal d8 = Math.Round(ty_gia_ht * sumTienNt, M_ROUND);
                        decimal d9 = Math.Round(ty_gia * sumTienNt, M_ROUND);
                        if (CurPh.Ma_gd == "8")
                            d9 = Math.Round(ty_gia * sumTtNt, M_ROUND);

                        // Duyệt từng record trong GrdCt (ở đây dùng LSCt để cập nhật)
                        foreach (var ct in LSCt)
                        {
                            decimal tienNt = ct.Tien_nt;
                            decimal tien = ct.Tien;
                            decimal tienTt = ct.Tien_tt;
                            decimal thue = ct.Thue;

                            // nếu có giá trị và loại hd == "1" và có ngay_ct0 -> cập nhật
                            if (tienNt != 0m || tien == 0m)
                            {
                                if (!string.IsNullOrEmpty(ct.Ngay_ct0.ToString()) && ct.Loai_hd == "1")
                                {
                                    tienTt = tienTt + d9 - sumTienTt;
                                    tien = tien + d8 - sumTien;
                                    ct.Tien = tien;
                                    ct.Tien_tt = tienTt;
                                    ct.Tt = tien + thue;

                                    // update tương ứng trong CtGt nếu khớp so_ct0
                                    var gt = LSCtgt?.FirstOrDefault(g => g.So_ct0 == ct.So_ct0);
                                    if (gt != null)
                                    {
                                        gt.T_tien = tien;
                                        gt.T_tt = tien + thue;
                                    }

                                    // theo logic gốc: break after first match
                                    break;
                                }
                            }
                        }

                        decimal tThueNt0 = CurPh.T_thue_nt;
                        CurPh.T_thue_nt = tThueNt0 + d8;
                    }
                }
            }




            if (string.IsNullOrEmpty(CurPh.Ma_dvcs))
                CurPh.Ma_dvcs = Ma_dvcs;

            // Reset các tổng tạm
            sumTienNt = sumTien = sumTienTt = sumTtNt = 0m;

            // Tổng lại từ LSCt (lặp logic gốc)
            if (LSCt != null && LSCt.Any())
            {
                sumTienNt = LSCt.Sum(x => x.Tien_nt);
                sumTtNt = LSCt.Sum(x => x.Tt_nt);
                sumTien = LSCt.Sum(x => x.Tien);
                sumTienTt = LSCt.Sum(x => x.Tien_tt);
            }

            // Kiểm tra hạch toán = 0
            if (sumTienNt == 0m && sumTien == 0m)
            {
                Message = Lap["Hạch toán tiền bằng 0!"];
                myStateMN.SetNewThongbao(Message);
                StateHasChanged();
                flag = false;
                return flag;
            }
        }

        return flag;
    }
    public bool CheckExistHDVao(
         string stt_rec,
         string so_ct0,
         string so_seri0,
         string ngay_ct0,
         string ma_so_thue)
    {

        string _poststore = "[CheckExistsHDVao]";
        string format = string.Format("exec [dbo].{0} '{1}','{2}','{3}','{4}','{5}'", _poststore, stt_rec, so_ct0, so_seri0, ngay_ct0, ma_so_thue);

