        string sql = string.Format("exec Catinhtg '{0}','{1}','{2}','{3}','{4}','{5}','{6}'", CurPh.Ngay_ct.ToString("yyyyMMdd"), tk, CurPh.Ma_kh, myStateMN.GetMa_Dvcs(), CurPh.Stt_rec, null, 1);
