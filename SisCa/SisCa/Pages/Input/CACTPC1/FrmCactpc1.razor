                    {
                        Decimal result2 = new Decimal(0);
                        Decimal result3 = new Decimal(0);

                        result2 = CurrentEditModel.Thue_nt;
                        result3 = CurrentEditModel.Tien_nt;
                        CurrentEditModel.Tt_nt = result2 + result3;


