    async void AddNewCTGT()
    {

        if (GridCTGT != null)
        {
            await GridCTGT.SaveChangesAsync();
        }

        var maGd = CurPh.Ma_gd?.ToString();

        bool isMaGdValid = !string.IsNullOrEmpty(maGd) && (maGd == "3" || maGd == "8");

        if (isMaGdValid)
        {
            if (activeTabIndex == 0)
            {
                if (AllowEditMode)
                {

                    // Xóa dữ liệu thuế cũ của phiếu hiện tại

                    LSCtgt.Where(x => x.Stt_rec == CurPh.Stt_rec && x.Thue_ct == "1").ToList()
                    .ForEach(row => LSCtgt.Remove(row));
                    // Lọc các record hợp lệ
                    var validRecords = LSCt
                        .Where(x =>
                            x.Ngay_ct0 != null &&
                            !string.IsNullOrEmpty(x.Ngay_ct0.ToString()) &&
                            x.Loai_hd?.Trim() != "0")
                        .ToList();

                    // Nếu có record, xóa dữ liệu thuế tương ứng
                    if (validRecords.Any())
                    {
                        var toRemove = LSCtgt.Where(x => x.Stt_rec == CurPh.Stt_rec).ToList();
                        foreach (var item in toRemove)
                            LSCtgt.Remove(item);
                    }

                    // Tạo mới dữ liệu thuế từ chi tiết chứng từ
                    foreach (var record in validRecords)
                    {
                        Ct46gt _Ct46gt = new Ct46gt
                        {
                            Stt = record.Stt,
                            Stt_rec = CurPh.Stt_rec,
                            Thue_ct = "1",
                            Stt_rec0 = record.Stt_rec0,
                            Ngay_ct = CurPh.Ngay_ct,
                            Ma_ct = CurPh.Ma_ct,
                            Ma_ms = record.Ma_ms,
                            So_ct0 = record.So_ct0,
                            So_seri0 = record.So_seri0,
                            Ngay_ct0 = record.Ngay_ct0,
                            Ma_kh = record.Ma_kh_t,
                            Ten_kh = record.Ten_kh_t,
                            Dia_chi = record.Dia_chi_t,
                            Ma_so_thue = record.Mst_t,
                            Ten_vt = record.Ten_vt_t,
                            T_tien_nt = record.Tien_nt,
                            T_tien = record.Tien,
                            Ma_thue = record.Ma_thue_i,
                            Thue_suat = record.Thue_suat,
                            T_thue_nt = record.Thue_nt,
                            T_thue = record.Thue,
                            T_tt_nt = record.Tt_nt,
                            T_tt = record.Tt,
                            Tk_thue_no = record.Tk_thue_i,
                            Ghi_chu = record.Ghi_chu_t,
                            Ma_vv = record.Ma_vv_i,
                            Ma_phi = record.Ma_phi_i,
                            Tk_du = CurPh.Tk

                        };
                        LSCtgt.Add(_Ct46gt);
                        CurrentEditModelctgt = _Ct46gt;
                        await InvokeAsync(StateHasChanged);
                    }

                    UpdateTotalThue();
                }
            }

        }
    }
