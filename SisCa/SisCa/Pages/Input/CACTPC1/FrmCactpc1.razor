                            Decimal nValue = CurPh.Ty_gia_ht;
                            Decimal num5 = result2 * nValue;
                            if (num5 > new Decimal(0))
                            {
                                CurrentEditModel.Thue = Math.Round(num5, this.M_ROUND);
                                Decimal num6 = CurrentEditModel.Tien == 0 ? 0 : CurrentEditModel.Tien;
                                CurrentEditModel.Tt = num6 + Math.Round(num5, this.M_ROUND);


                            }
                        }
                    }

                    Decimal num3 = new Decimal(0);
                    Decimal result = new Decimal(0);
                    Decimal nValue1 = CurPh.Ty_gia;
                    Decimal nValue2 = CurPh.Ty_gia_ht;
                    result = CurrentEditModel.Tt_nt;
                    Decimal num17 = !(CurPh.Loai_cl_no.ToString() == "0") ? Math.Round(result * nValue2, this.M_ROUND) : Math.Round(result * nValue1, this.M_ROUND);
                    CurrentEditModel.Tien_tt = num17;
                    Tinh_tien_cltg(CurrentEditModel);
                    break;
                case "thue":
                    if (newvalue != 0)
                    {
                        if (CurrentEditModel.Loai_hd == "2")
                        {
                            CurrentEditModel.Thue = newvalue;
                        }

                        Decimal result5 = new Decimal(0);
