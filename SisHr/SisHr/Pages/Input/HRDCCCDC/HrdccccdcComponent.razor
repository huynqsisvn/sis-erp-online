@page "/hrdcccdc"
@page "/hrdcccdc/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,hrdcccdc")]
@using SisHr.Pages.Input.HRDCCCDC
@using DevExpress.Blazor
@using System.Data

<div class="row mt-1" tabindex="0" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true"
              Width="59vw"
              MinWidth="500px"
              MinHeight="300px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (frmPrintVisible)
{
    <DxPopup @ref="popPrint"
             CloseOnOutsideClick="false"
             CssClass="dxPopup"
             @bind-Visible="@frmPrintVisible"
             Width="80%" Height="90%"
             ShowFooter="false"
             HeaderText="@Lap["Print tool transfer"]">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData"
                                   Menu_id="@Menu_id.Replace('_', '.')"
                                   OnBack="@(() => { frmPrintVisible = false; StateHasChanged(); })" />
        </BodyTemplate>
    </DxPopup>
}

@code {
    private DxPopup popPrint;
    private bool frmPrintVisible = false;
    private List<HrdccccdcModel> LsData;

    protected override void OnInitialized()
    {
        mPage        = "hrdcccdc";
        editPage     = "";
        sqlTableName = "DMDCCCDC";
        sqlTableView = "v_DMDCCCDCDTDetails";
        SqlTableKey  = "so_ct";
        SqlItemName  = "so_ct";
        IsShowCopy   = false;
        IsShowImport = false;
        FrmType      = typeof(FrmHrdcccdc);

        if (string.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.ct.32";

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Loaddata();

            string menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New",     true,  "F4"));
                myStateMN.SetToolBar(new MyToolbar("Copy",    false));
                myStateMN.SetToolBar(new MyToolbar("Import",  false));
                myStateMN.SetToolBar(new MyToolbar("Edit",    true,  "F3"));
                myStateMN.SetToolBar(new MyToolbar("Save",    false));
                myStateMN.SetToolBar(new MyToolbar("Delete",  true,  "F8"));
                myStateMN.SetToolBar(new MyToolbar("Change",  false));
                myStateMN.SetToolBar(new MyToolbar("View",    true,  "F2"));
                myStateMN.SetToolBar(new MyToolbar("Aproval", false));
                myStateMN.SetToolBar(new MyToolbar("Print",   true,  "F7"));
                myStateMN.SetToolBar(new MyToolbar("Export",  true));
                myStateMN.SetToolBar(new MyToolbar("Search",  false, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Quit",    false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged    += OnLangguachange;

            StateHasChanged();
        }
        else
        {
            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
    }

    public override async Task PageLoad()
    {
        try
        {
            if (myCommand == null) return;
            curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
            if (curCommand != null)
            {
                fbrowse   = IsLangEn ? curCommand.Vbrowse2 : curCommand.Vbrowse1;
                string ps = myOption.GetOptionsValue("M_GRID_NROW");
                Page_size = string.IsNullOrEmpty(ps) ? 50 : int.Parse(ps.Trim());
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("PageLoad error: " + ex.Message);
        }
    }

    public override async Task Loaddata()
    {
        SelectedItem = null;

        string sql = "IF OBJECT_ID('tempdb..#tmp') IS NOT NULL DROP TABLE #tmp; "
                   + "SELECT IDENTITY(int,1,1) AS stt, * INTO #tmp FROM " + sqlTableView + "; "
                   + "SELECT * FROM #tmp;";

        DataSet ds = await myDb.LoadDataset(sql);
        TblData = ds?.Tables[0];

        if (TblData != null && TblData.DefaultView.Count > 0)
            SelectedItem = TblData.DefaultView[0];

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }

    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                myStateMN.SetCurrentActionTask(ActionTask.New);
                V_Them();
                break;
            case ActionTask.Edit:
                myStateMN.SetCurrentActionTask(ActionTask.Edit);
                V_Sua();
                break;
            case ActionTask.View:
                myStateMN.SetCurrentActionTask(ActionTask.View);
                V_Xem();
                break;
            case ActionTask.Delete:
                V_Xoa();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Print:
                DoPrint();
                StateHasChanged();
                break;
        }
    }

    public virtual void V_Them()
    {
        Par.Clear();
        Par.Add("Ma_ma",         (object)"");
        Par.Add("Menu_id",       (object)Menu_id);
        Par.Add("ShowAdd",       (object)true);
        Par.Add("curActionTask", (object)ActionTask.New);
        Par.Add("OnClose",       EventCallback.Factory.Create(this, CloseForm));
        FrmType   = typeof(FrmHrdcccdc);
        IsShowFrm = true;
        StateHasChanged();
    }

    public override void V_Sua()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null) { myStateMN.SetNewThongbao(Lap["No data row selected"]); return; }

        string key = rview["so_ct"].ToString().Trim();

        Par.Clear();
        Par.Add("Ma_ma",         (object)key);
        Par.Add("Menu_id",       (object)Menu_id);
        Par.Add("ShowAdd",       (object)true);
        Par.Add("curActionTask", (object)ActionTask.Edit);
        Par.Add("OnClose",       EventCallback.Factory.Create(this, CloseForm));
        FrmType   = typeof(FrmHrdcccdc);
        IsShowFrm = true;
        StateHasChanged();
    }

    public virtual void V_Xem()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null) { myStateMN.SetNewThongbao(Lap["No data row selected"]); return; }

        string key = rview["so_ct"].ToString().Trim();

        Par.Clear();
        Par.Add("Ma_ma",         (object)key);
        Par.Add("Menu_id",       (object)Menu_id);
        Par.Add("ShowAdd",       (object)true);
        Par.Add("curActionTask", (object)ActionTask.View);
        Par.Add("OnClose",       EventCallback.Factory.Create(this, CloseForm));
        FrmType   = typeof(FrmHrdcccdc);
        IsShowFrm = true;
        StateHasChanged();
    }

    public virtual async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null) { myStateMN.SetNewThongbao(Lap["No data row selected"]); return; }

        string so_ct = rview["so_ct"].ToString().Trim();

        var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
        {
            Text             = Lap["Are you sure want to delete"] + " [" + so_ct + "] ? " + Lap["Detail records will also be deleted"],
            Title            = Lap["Delete confirmation"],
            OkButtonText     = Lap["Yes"],
            CancelButtonText = Lap["No"],
            ShowIcon         = true,
            ShowCloseButton  = false,
            RenderStyle      = MessageBoxRenderStyle.Danger
        });

        if (!confirm) return;

        try
        {
            string safe = so_ct.Replace("'", "''");
            // Delete details first, then header (same WPF logic)
            string sqlDel = "DELETE FROM DMDCCCDCDT WHERE so_ct='" + safe + "'; "
                          + "DELETE FROM DMDCCCDC WHERE so_ct='" + safe + "'";
            await myDb.ExecuteSqlQueryAsync(sqlDel);
            await Loaddata();
            myStateMN.SetNewThongbao(Lap["Delete successful"] + ": " + so_ct);
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Delete failed"] + ": " + ex.Message);
        }
    }

    private void DoPrint()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data row selected"]);
            return;
        }

        string so_ct = rview["so_ct"].ToString().Trim();
        string safe  = so_ct.Replace("'", "''");

        string sqlPh = "SELECT * FROM v_DMDCCCDC WHERE so_ct = '" + safe + "'";
        DataTable dtPh = myDb.GetTable(sqlPh);

        string sqlDt = "IF OBJECT_ID('tempdb..#rptmp') IS NOT NULL DROP TABLE #rptmp; "
                     + "SELECT IDENTITY(int,1,1) AS stt, * INTO #rptmp FROM v_DMDCCCDCDT "
                     + "WHERE so_ct = '" + safe + "'; SELECT * FROM #rptmp;";
        DataTable dtDt = myDb.GetTable(sqlDt);

        if (dtPh == null || dtPh.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["No data to print"]);
            return;
        }

        LsData = new List<HrdccccdcModel>();
        var model = new HrdccccdcModel();

        model.So_ct     = dtPh.Rows[0]["so_ct"]?.ToString() ?? "";
        model.Dien_giai = dtPh.Columns.Contains("dien_giai") ? dtPh.Rows[0]["dien_giai"]?.ToString() ?? "" : "";
        model.Ten_loai  = dtPh.Columns.Contains("ten_loai") ? dtPh.Rows[0]["ten_loai"]?.ToString() ?? "" : "";

        if (dtPh.Rows[0]["ngay_ct"] != DBNull.Value)
        {
            model.Ngay_ct = Convert.ToDateTime(dtPh.Rows[0]["ngay_ct"]);
            model.DateString = "ngày " + model.Ngay_ct.Value.Day
                             + " tháng " + model.Ngay_ct.Value.Month
                             + " năm " + model.Ngay_ct.Value.Year;
        }

        if (dtDt != null && dtDt.Rows.Count > 0)
        {
            var lsDt = new List<HrdccccdcDtPrint>();
            int stt = 1;
            foreach (DataRow row in dtDt.Rows)
            {
                var dt = new HrdccccdcDtPrint();
                dt.Stt         = stt++;
                dt.Ma_ns_tu    = row["ma_ns_tu"]?.ToString() ?? "";
                dt.Ten_ns_tu   = row.Table.Columns.Contains("ten_ns_tu") && row["ten_ns_tu"] != DBNull.Value ? row["ten_ns_tu"].ToString() : "";
                dt.Ma_ns_sang  = row.Table.Columns.Contains("ma_ns_sang") && row["ma_ns_sang"] != DBNull.Value ? row["ma_ns_sang"].ToString() : "";
                dt.Ten_ns_sang = row.Table.Columns.Contains("ten_ns_sang") && row["ten_ns_sang"] != DBNull.Value ? row["ten_ns_sang"].ToString() : "";
                dt.Ma_bpns     = row.Table.Columns.Contains("ma_bpns") && row["ma_bpns"] != DBNull.Value ? row["ma_bpns"].ToString() : "";
                dt.Ma_chucvu   = row.Table.Columns.Contains("ma_chucvu") && row["ma_chucvu"] != DBNull.Value ? row["ma_chucvu"].ToString() : "";
                dt.Ma_cc_me    = row["ma_cc_me"]?.ToString() ?? "";
                dt.Ten_cc      = row.Table.Columns.Contains("ten_cc") && row["ten_cc"] != DBNull.Value ? row["ten_cc"].ToString() : "";
                dt.So_luong    = row["so_luong"] != DBNull.Value ? Convert.ToDecimal(row["so_luong"]) : 0;
                dt.Ngay_cap    = row["ngay_cap"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(row["ngay_cap"]) : null;
                dt.Ly_do_cap   = row.Table.Columns.Contains("ly_do_cap") && row["ly_do_cap"] != DBNull.Value ? row["ly_do_cap"].ToString() : "";
                dt.Ngay_dc     = row.Table.Columns.Contains("ngay_dc") && row["ngay_dc"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(row["ngay_dc"]) : null;
                dt.Ly_do_dc    = row.Table.Columns.Contains("ly_do_dc") && row["ly_do_dc"] != DBNull.Value ? row["ly_do_dc"].ToString() : "";
                lsDt.Add(dt);
            }
            model.LsDt = lsDt;
        }

        LsData.Add(model);
        frmPrintVisible = true;
    }

    public async void CloseForm()
    {
        IsShowFrm = false;
        await Loaddata();
        StateHasChanged();
    }

    public override async void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged    -= OnLangguachange;
    }
}
