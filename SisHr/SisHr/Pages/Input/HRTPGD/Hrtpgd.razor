@page "/hrtpgd"
@page "/hrtpgd/{Menu_id}"
@inherits ListBaseComponent
@using SisHr.Pages.Input.HRTPGD
@attribute [Authorize(Roles = "admin,hrtpgd")]

<div class="d-flex mt-1 align-items-center gap-3">
    <h6 class="mb-0">@Lap["Employee code"]</h6>
    <AutocompleteComponent Ma_dm="dmns" @bind-Value="@M_EMP_ID" Filter="status = 1" SelectChanged="EmpFilter_Changed" CssClass="w-25" />
</div>
<hr style="margin:6px;padding:0px;height:1px;" />
<div class="row mt-1" tabindex="0" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="oBrowse" TblData="@TblData" Fbrowse="@fbrowse" Page_size="@Page_size" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true"
              Width="50vw"
              MinWidth="500px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@code {
    public string preFilter = "";
    private string _EMP_ID;
    public string M_EMP_ID
    {
        get { return _EMP_ID; }
        set
        {
            if (_EMP_ID != value)
            {
                _EMP_ID = value;
                Loaddata();
            }
        }
    }
    public DotNetObjectReference<Hrtpgd> Pageobj;
    private string ActiveComponentId = "oBrowse";

    [JSInvokable]
    public async void GridFMode(string value, string Id)
    {
        if (!string.IsNullOrEmpty(Id) && Id.Equals("oBrowse"))
        {
            oBrowseHotKeyFunction(value);
        }      
    }

    void oBrowseHotKeyFunction(string value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            if (value.Equals("F2"))
            {
                V_Xem();
            }
            if (value.Equals("F3"))
            {
                V_Sua();
            }
            if (value.Equals("F4"))
            {
                V_Them();
            }
            if (value.Equals("F5"))
            {
                StateHasChanged();
            }
            else if (value.Equals("F8"))
            {
                V_Xoa();
            }
            else if (value.ToUpper().Equals("ESCAPE"))
            {
            }
        }
    }

    private async Task SetActiveComponentIdAsync(string id)
    {
        try
        {
            ActiveComponentId = id ?? ActiveComponentId;
            if (Pageobj != null)
            {
                await JavacriptS.InvokeVoidAsync("SetPageFModeObj", Pageobj, ActiveComponentId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("SetActiveComponentIdAsync error: " + ex.Message);
        }
    }

    protected override void OnInitialized()
    {
        mPage = "hrtpgd";
        editPage = "edithrtpgd";
        IsShowCopy = false;
        IsShowImport = false;
        sqlTableName = "dmtpgd";
        sqlTableView = "v_dmtpgd";
        SqlTableKey = "ma_tpgd";
        SqlItemName = "ten_tpgd";

        FrmType = typeof(EditHrtpgd);
        if (string.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.ct.03";

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));
            string Menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(Menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New", true, "F4"));
                if (IsShowCopy) myStateMN.SetToolBar(new MyToolbar("Copy", false));
                myStateMN.SetToolBar(new MyToolbar("Edit", true, "F3"));
                myStateMN.SetToolBar(new MyToolbar("Save", false));
                myStateMN.SetToolBar(new MyToolbar("Delete", true, "F8"));
                myStateMN.SetToolBar(new MyToolbar("View", true, "F2"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Quit", false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync("oBrowse");
            M_EMP_ID = "";
            await Language();
        }
    }

    public virtual void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                myStateMN.SetCurrentActionTask(ActionTask.New);
                V_Them();
                break;
            case ActionTask.Edit:
                myStateMN.SetCurrentActionTask(ActionTask.Edit);
                V_Sua();
                break;
            case ActionTask.View:
                myStateMN.SetCurrentActionTask(ActionTask.View);
                V_Xem();
                break;
            case ActionTask.Delete:
                V_Xoa();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
        }
    }

    public override async Task PageLoad()
    {
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        if (curCommand != null)
        {
            fbrowse = IsLangEn ? curCommand.Vbrowse2 : curCommand.Vbrowse1;
            Page_size = int.Parse(myOption.GetOptionsValue("M_GRID_NROW").Trim());
            editPage = "";
        }
        StateHasChanged();
    }

    public override async Task Loaddata()
    {
        try
        {
            SelectedItem = null;
            preFilter = "1=1";
            
            if (!String.IsNullOrEmpty(M_EMP_ID))
            {
                preFilter += " AND ma_ns LIKE '" + M_EMP_ID.Trim() + "%'";
            }

            string sql = "SELECT [ma_tpgd],[ma_ns],[stt],[ma_gioitinh],[ma_qhgd],[ten_tpgd],[ten_tpgd2],[ma_so_thue],[nam_sinh],[cmnd],[nghe_nghiep],[nguoi_phu_thuoc],[noi_lam_viec],[cho_o_hien_nay],[trinh_do_chinh_tri],[truoc_cach_mang],[trong_cach_mang],[sau_cach_mang],[ghi_chu],[date],[time],[user_id],[date0],[time0],[user_id0],[status] FROM " + sqlTableView + " WHERE " + preFilter;
            
            DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];

                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }

            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Loaddata error: " + ex.Message);
            myStateMN.SetNewThongbao(Lap["Error loading data"] + ": " + ex.Message);
        }
        StateHasChanged();
    }

    void EmpFilter_Changed(ExpandoObject value)
    {
        Loaddata();
    }

    public virtual void V_Them()
    {
        string strEmpId = M_EMP_ID;
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            strEmpId = rview["ma_ns"].ToString().Trim();
        }

        if (string.IsNullOrEmpty(strEmpId))
        {
            myStateMN.SetNewThongbao(Lap["Please select an employee before adding new family member!"] + "!");
            return;
        }

        Par.Clear();
        Par.Add("Ma_ma", (object)strEmpId);
        Par.Add("Menu_id", (object)Menu_id);
        Par.Add("ShowAdd", (object)true);
        Par.Add("curActionTask", (object)ActionTask.New);
        Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
        IsShowFrm = true;
        StateHasChanged();
    }

    public override void V_Sua()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string ma_tpgd = rview["ma_tpgd"].ToString().Trim();

            Par.Clear();
            Par.Add("Ma_ma", (object)ma_tpgd);
            Par.Add("Menu_id", (object)Menu_id);
            Par.Add("ShowAdd", (object)true);
            Par.Add("curActionTask", (object)ActionTask.Edit);
            Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
            IsShowFrm = true;
            StateHasChanged();
        }
        else
            myStateMN.SetNewThongbao(Lap["No row selected!"] + "!");
    }

    public virtual void V_Xem()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string ma_tpgd = rview["ma_tpgd"].ToString().Trim();

            Par.Clear();
            Par.Add("Ma_ma", (object)ma_tpgd);
            Par.Add("Menu_id", (object)Menu_id);
            Par.Add("ShowAdd", (object)true);
            Par.Add("curActionTask", (object)ActionTask.View);
            Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
            IsShowFrm = true;
            StateHasChanged();
        }
        else
            myStateMN.SetNewThongbao(Lap["No row selected!"] + "!");
    }

    public virtual async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string ma_tpgd = rview["ma_tpgd"].ToString().Trim();
            string displayValue = $"{rview["ten_tpgd"]}";

            var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
            {
                Text = String.Format(Lap["Do you want to delete :{0} ?"], displayValue),
                Title = Lap["Confirm deletion of list"],
                OkButtonText = Lap["Yes"],
                CancelButtonText = Lap["No"],
                ShowIcon = true,
                ShowCloseButton = false,
                RenderStyle = MessageBoxRenderStyle.Danger
            });

            if (confirm)
            {
                await DeleteRecord(ma_tpgd);
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No row selected!"] + "!");
    }

    private async Task DeleteRecord(string ma_tpgd)
    {
        try
        {
            string sql = $"DELETE FROM {sqlTableName} WHERE ma_tpgd = @ma_tpgd";
            var parameters = new Dictionary<string, object>
            {
                { "@ma_tpgd", ma_tpgd }
            };
            await myDb.LoadDataset(sql, parameters);

            await Loaddata();
            string ToastMessage = String.Format(Lap["Delete successfully : {0}"], ma_tpgd);
            myStateMN.SetNewThongbao(ToastMessage);
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Delete failed"] + ": " + ex.Message);
        }
    }

    public override async void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
    }
}
