@inherits FrmListBaseComponent
@using SisHr.Pages.Input.DMXNNS
@using DevExpress.Blazor
@using System.Data
@using System.Linq
@inject IJSRuntime JSRuntime
@implements IDisposable

<div style="width:auto;">
    <FormList Title="@Title" @bind-curActionTask="@curActionTask" OnSave="@SaveData" OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout ItemSizeMode="@Itemsizemode" CssClass="frm-header sis-form" onkeydown="ModifyEnterKeyPressAsTab(event)">

                <DxFormLayoutItem Caption="@Lap["Voucher date"]" ColSpanMd="6" CaptionCssClass="fw-bold">
                    <Template>
                        <DxDateEdit Id="ngay_ct_input" Enabled="@AllowEditMode" @bind-Date="@CurPh.Ngay_ct" DisplayFormat="dd/MM/yyyy" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6" />

                <DxFormLayoutItem Caption="@Lap["Sender"]" ColSpanMd="6" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <AutocompleteComponent Id="ma_ns_input" Ma_dm="dmns" @bind-Value="@CurPh.Ma_ns" IsEnable="@AllowEditMa" SelectChanged="@((ExpandoObject v) => Ma_ns_Changed(v))" IsLangEn="@IsLangEn" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Sender name"]" ColSpanMd="3">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Ten_ns_giao" Enabled="false" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Department"]" ColSpanMd="3">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Ma_bpns_giao" Enabled="false" />
                    </Template>
                </DxFormLayoutItem>

                <Separator Margin="3" />

                <DxFormLayoutItem Caption="@Lap["Receiver"]" ColSpanMd="6" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <AutocompleteComponent Id="ma_ns_nhan_input" Ma_dm="dmns" @bind-Value="@CurPh.Ma_ns_nhan" IsEnable="@AllowEditMode" SelectChanged="@((ExpandoObject v) => Ma_ns_nhan_Changed(v))" IsLangEn="@IsLangEn" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Receiver name"]" ColSpanMd="3">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Ten_ns_nhan_display" Enabled="false" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Department"]" ColSpanMd="3">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Ma_bpns_nhan" Enabled="false" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Delivery address"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Dia_chi" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Content"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Noi_dung" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurPh.Ghi_chu" Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

            </DxFormLayout>
        </div>

        <div class="row m-1 me-2 mt-2">
            <h6 class="fw-bold text-primary m-0 mb-1">@Lap["Document list"]</h6>

            <div @ref="GridWrapperCt" id="grid-wrapper-ct" @onfocusout="OnGridCtLostFocus" @onfocusin='() => LastFocusedGrid = "CT"' class="mt-2 mb-3">
                <DxGrid @ref="GridCT"
                        Data="@LsCt"
                        SizeMode="@Itemsizemode"
                        CssClass="w-100 grid-height-dynamic"
                        @onkeydown="GridCT_OnKeyDown"
                        AllowSelectRowByClick="true"
                        KeyboardNavigationEnabled="true"
                        @bind-SelectedDataItem="@SelectedCt"
                        ValidationEnabled="false"
                        EditMode="GridEditMode.EditRow"
                        RowClick="@StartEditRow"
                        SelectionMode="GridSelectionMode.Single"
                        CustomizeEditModel="Grid_CustomizeEditModel"
                        EditModelSaving="Grid_EditModelSaving"
                        DataItemDeleting="Grid_DataItemDeleting"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        EditNewRowPosition="@(AllowEditMode ? GridEditNewRowPosition.LastRow : (GridEditNewRowPosition)(-1))"
                        ShowAllRows="true"
                        TextWrapEnabled="false"
                        AllowSort="false"
                        HighlightRowOnHover="true"
                        FooterDisplayMode="GridFooterDisplayMode.Always">
                    <Columns>
                        <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                            <CellDisplayTemplate Context="ctx">
                                <div class="grid-cell-align-center">
                                    <a class="text-danger fw-bold cursor-pointer" tabindex="-1"
                                       @onclick="@(() => GridCT.ShowRowDeleteConfirmation(ctx.VisibleIndex))" title="Xóa dòng">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            </CellDisplayTemplate>
                            <CellEditTemplate Context="ctx">
                            </CellEditTemplate>
                        </DxGridCommandColumn>

                        <DxGridDataColumn FieldName="Stt" Caption="STT" Width="50px" ReadOnly="true" />

                        <DxGridDataColumn FieldName="Ten_giayto" Caption="@Lap["Document name"]" MinWidth="250">
                            <CellEditTemplate Context="ctx">
                                @{ var item = (DmxnnsDtRow)ctx.EditModel; }
                                <DxTextBox @bind-Text="@item.Ten_giayto" CssClass="w-100" />
                            </CellEditTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="Ban_chinh" Caption="@Lap["Original copy"]" Width="100" CaptionAlignment="GridTextAlignment.Center">
                            <CellEditTemplate Context="ctx">
                                @{ var item = (DmxnnsDtRow)ctx.EditModel; }
                                <DxCheckBox @bind-Checked="@item.Ban_chinh" Enabled="@AllowEditMode" CssClass="d-flex justify-content-center" />
                            </CellEditTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="Ban_sao" Caption="@Lap["Photocopy"]" Width="100" CaptionAlignment="GridTextAlignment.Center">
                            <CellEditTemplate Context="ctx">
                                @{ var item = (DmxnnsDtRow)ctx.EditModel; }
                                <DxCheckBox @bind-Checked="@item.Ban_sao" Enabled="@AllowEditMode" CssClass="d-flex justify-content-center" />
                            </CellEditTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="So_luong" Caption="@Lap["Quantity"]" Width="120" CaptionAlignment="GridTextAlignment.Center" DisplayFormat="N0">
                            <CellEditTemplate Context="ctx">
                                @{ var item = (DmxnnsDtRow)ctx.EditModel; }
                                <DxSpinEdit @bind-Value="@item.So_luong" DisplayFormat="N0" ShowSpinButtons="false" />
                            </CellEditTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="Ngay_ct" Caption="@Lap["Received date"]" DisplayFormat="dd/MM/yyyy" Width="120">
                            <EditSettings><DxDateEditSettings Format="dd/MM/yyyy" /></EditSettings>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="Ghi_chu" Caption="@Lap["Note"]" MinWidth="200">
                            <CellEditTemplate Context="ctx">
                                @{ var item = (DmxnnsDtRow)ctx.EditModel; }
                                <DxTextBox @bind-Text="@item.Ghi_chu" CssClass="w-100" />
                            </CellEditTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            </div>
        </div>
    </FormList>
</div>

<style>
    .grid-height-dynamic {
        height: 300px;
        padding: 0px;
        margin: 0px;
    }
    
    .grid-cell-align-center {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .grid-delete-btn {
        padding: 4px 8px;
    }
    
    .grid-icon {
        width: 16px;
        height: 16px;
    }
    
    .grid-icon-delete::before {
        content: "🗑️";
        font-size: 16px;
    }
</style>
