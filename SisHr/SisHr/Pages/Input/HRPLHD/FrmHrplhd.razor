@page "/HRPLHD"
@page "/HRPLHD/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,hrplhd")]
@using SisHr.Pages.Input.HRPLHD
@using DevExpress.Blazor
@using System.Data

<div class="row mt-1" tabindex="0" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@* ================================================================
   POPUP FORM ADD/EDIT/VIEW
   ================================================================ *@
@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true"
              Width="30vw"
              MinWidth="200px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@* ================================================================
   POPUP PRINT
   ================================================================ *@
@if (frmPrintVisible)
{
    <DxPopup @ref="popPrint"
             CloseOnOutsideClick="false"
             CssClass="dxPopup"
             @bind-Visible="@frmPrintVisible"
             Width="80%" Height="90%"
             ShowFooter="false"
             HeaderText="@Lap["Print contract appendix"]">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData"
                                   Menu_id="@Menu_id.Replace('_', '.')"
                                   OnBack="@(() => { frmPrintVisible = false; StateHasChanged(); })" />
        </BodyTemplate>
    </DxPopup>
}

@code {
    // ===================================================
    // LOCAL VARIABLES
    // ===================================================
    private DxPopup popPrint;
    private bool frmPrintVisible = false;
    private List<PlhdModel> LsData;

    // ===================================================
    // INITIALIZATION
    // ===================================================
    protected override void OnInitialized()
    {
        mPage        = "HRPLHD";
        editPage     = "";
        sqlTableName = "dmplhd";
        sqlTableView = "v_dmplhd";
        SqlTableKey  = "ma_plhd2";
        SqlItemName  = "ma_plhd2";
        IsShowCopy   = false;
        IsShowImport = false;
        FrmType      = typeof(EditHrplhd);

        if (string.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.ct.06";

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Loaddata();

            string menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New",     true,  "F4"));
                myStateMN.SetToolBar(new MyToolbar("Copy",    false));
                myStateMN.SetToolBar(new MyToolbar("Import",  false));
                myStateMN.SetToolBar(new MyToolbar("Edit",    true,  "F3"));
                myStateMN.SetToolBar(new MyToolbar("Save",    false));
                myStateMN.SetToolBar(new MyToolbar("Delete",  true,  "F8"));
                myStateMN.SetToolBar(new MyToolbar("Change",  false));
                myStateMN.SetToolBar(new MyToolbar("View",    true,  "F2"));
                myStateMN.SetToolBar(new MyToolbar("Aproval", false));
                myStateMN.SetToolBar(new MyToolbar("Print",   true,  "F7"));
                myStateMN.SetToolBar(new MyToolbar("Export",  true));
                myStateMN.SetToolBar(new MyToolbar("Search",  false, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Quit",    false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged    += OnLangguachange;

            StateHasChanged();
        }
        else
        {
            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
    }

    // ===================================================
    // PAGELOAD
    // ===================================================
    public override async Task PageLoad()
    {
        try
        {
            if (myCommand == null) return;
            curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
            if (curCommand != null)
            {
                fbrowse   = IsLangEn ? curCommand.Vbrowse2 : curCommand.Vbrowse1;
                string ps = myOption.GetOptionsValue("M_GRID_NROW");
                Page_size = string.IsNullOrEmpty(ps) ? 50 : int.Parse(ps.Trim());
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("PageLoad error: " + ex.Message);
        }
    }

    // ===================================================
    // LOAD DATA
    // ===================================================
    public override async Task Loaddata()
    {
        SelectedItem = null;

        string sql = $"SELECT ROW_NUMBER() OVER (ORDER BY date0, time0, ma_plhd2) AS stt, * " +
                     $"FROM {sqlTableView} " +
                     $"ORDER BY date0, time0, ma_plhd2";

        DataSet ds = await myDb.LoadDataset(sql);
        TblData = ds?.Tables[0];

        if (TblData != null && TblData.DefaultView.Count > 0)
            SelectedItem = TblData.DefaultView[0];

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }

    // ===================================================
    // HANDLE TOOLBAR ACTIONS
    // ===================================================
    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                myStateMN.SetCurrentActionTask(ActionTask.New);
                V_Them();
                break;
            case ActionTask.Edit:
                myStateMN.SetCurrentActionTask(ActionTask.Edit);
                V_Sua();
                break;
            case ActionTask.View:
                myStateMN.SetCurrentActionTask(ActionTask.View);
                V_Xem();
                break;
            case ActionTask.Delete:
                V_Xoa();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Print:
                DoPrint();
                StateHasChanged();
                break;
        }
    }

    // ===================================================
    // ADD NEW
    // ===================================================
    public virtual void V_Them()
    {
        Par.Clear();
        Par.Add("Ma_ma",         (object)"");
        Par.Add("Menu_id",       (object)Menu_id);
        Par.Add("ShowAdd",       (object)true);
        Par.Add("curActionTask", (object)ActionTask.New);
        Par.Add("OnClose",       EventCallback.Factory.Create(this, CloseForm));
        FrmType = typeof(EditHrplhd);
        IsShowFrm = true;
        StateHasChanged();
    }

    // ===================================================
    // EDIT
    // ===================================================
    public override void V_Sua()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null) { myStateMN.SetNewThongbao(Lap["No data row selected"]); return; }

        string key = rview["ma_plhd2"].ToString().Trim();

        Par.Clear();
        Par.Add("Ma_ma",         (object)key);
        Par.Add("Menu_id",       (object)Menu_id);
        Par.Add("ShowAdd",       (object)true);
        Par.Add("curActionTask", (object)ActionTask.Edit);
        Par.Add("OnClose",       EventCallback.Factory.Create(this, CloseForm));
        FrmType = typeof(EditHrplhd);
        IsShowFrm = true;
        StateHasChanged();
    }

    // ===================================================
    // VIEW
    // ===================================================
    public virtual void V_Xem()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null) { myStateMN.SetNewThongbao(Lap["No data row selected"]); return; }

        string key = rview["ma_plhd2"].ToString().Trim();

        Par.Clear();
        Par.Add("Ma_ma",         (object)key);
        Par.Add("Menu_id",       (object)Menu_id);
        Par.Add("ShowAdd",       (object)true);
        Par.Add("curActionTask", (object)ActionTask.View);
        Par.Add("OnClose",       EventCallback.Factory.Create(this, CloseForm));
        FrmType = typeof(EditHrplhd);
        IsShowFrm = true;
        StateHasChanged();
    }

    // ===================================================
    // DELETE
    // ===================================================
    public virtual async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null) { myStateMN.SetNewThongbao(Lap["No data row selected"]); return; }

        string ma_plhd2 = rview["ma_plhd2"].ToString().Trim();

        var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
        {
            Text             = $"{Lap["Are you sure want to delete"]} [{ma_plhd2}] ?",
            Title            = Lap["Delete confirmation"],
            OkButtonText     = Lap["Yes"],
            CancelButtonText = Lap["No"],
            ShowIcon         = true,
            ShowCloseButton  = false,
            RenderStyle      = MessageBoxRenderStyle.Danger
        });

        if (!confirm) return;

        try
        {
            string safe = ma_plhd2.Replace("'", "''");
            string sql = $"DELETE FROM {sqlTableName} WHERE ma_plhd2='{safe}'";
            await myDb.ExecuteSqlQueryAsync(sql);
            await Loaddata();
            myStateMN.SetNewThongbao($"{Lap["Delete successful"]}: {ma_plhd2}");
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Delete failed"]}: {ex.Message}");
        }
    }

    // ===================================================
    // PRINT
    // ===================================================
    private void DoPrint()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data row selected"]);
            return;
        }

        LsData = new List<PlhdModel>();

        DataTable dtSelected = TblData.Clone();
        dtSelected.ImportRow(rview.Row);

        var model = new PlhdModel
        {
            LsData = myDb.ConvertDataTable<PlhdDetail>(dtSelected)
        };

        if (model.LsData != null && model.LsData.Count > 0)
        {
            var detail = model.LsData[0];

            detail.Tencty    = myOption.GetOptionsValue("M_TEN_CTY")?.Trim() ?? "";
            detail.Diachicty = myOption.GetOptionsValue("M_DIA_CHI2")?.Trim() ?? "";

            if (!string.IsNullOrWhiteSpace(detail.Ma_hdld))
            {
                string safe_hdld = detail.Ma_hdld.Trim().Replace("'", "''");
                detail.Ten_hdld = myDb.GetValue($"SELECT ma_hdld FROM dmhdld WHERE ma_hdld = '{safe_hdld}'")?.ToString()?.Trim() ?? "";
            }

            // Fetch company representative info from dmhdld
            string safe_ma = detail.Ma_hdld.Trim().Replace("'", "''");
            string sql_ct = "SELECT dmns.ten_ns, dmns.ten_ns2, dmns.dien_thoai, dmcv.ten_cv, dmcv.ten_cv2, dmns.quoc_tich, dmns.quoc_tich2 " +
                           "FROM dmhdld LEFT JOIN dmns ON dmns.ma_ns = dmhdld.ma_ns_ct " +
                           "LEFT JOIN dmcv ON dmcv.ma_cv = dmhdld.ma_cv_ct " +
                           "WHERE dmhdld.ma_hdld = '" + safe_ma + "'";
            DataTable dt_ct = myDb.GetTable(sql_ct);
            if (dt_ct != null && dt_ct.Rows.Count > 0)
            {
                detail.Ten_ns_ct = dt_ct.Rows[0]["ten_ns"]?.ToString()?.Trim() ?? "";
                detail.Ten_ns_ct_2 = dt_ct.Rows[0]["ten_ns2"]?.ToString()?.Trim() ?? "";
                detail.Ten_cv_ct = dt_ct.Rows[0]["ten_cv"]?.ToString()?.Trim() ?? "";
                detail.Ten_cv_ct_2 = dt_ct.Rows[0]["ten_cv2"]?.ToString()?.Trim() ?? "";
                detail.Dien_thoai_ct = dt_ct.Rows[0]["dien_thoai"]?.ToString()?.Trim() ?? "";
                detail.Quoc_tich_ct = dt_ct.Rows[0]["quoc_tich"]?.ToString()?.Trim() ?? "Việt Nam";
            }

            // Fetch employee info
            string sql_ns = "SELECT dmns.ten_ns, dmns.ten_ns2, dmns.dien_thoai, dmcv.ten_cv, dmcv.ten_cv2, dmns.quoc_tich, dmns.quoc_tich2, dmns.ngay_sinh, dmns.dia_chi, dmns.cmnd, dmns.ngay_cmnd, dmns.nc_cmnd, dmhdld.ngay_hd " +
                           "FROM dmhdld LEFT JOIN dmns ON dmns.ma_ns = dmhdld.ma_ns " +
                           "LEFT JOIN dmcv ON dmcv.ma_cv = dmhdld.ma_cv " +
                           "WHERE dmhdld.ma_hdld = '" + safe_ma + "'";
            DataTable dt_ns = myDb.GetTable(sql_ns);
            if (dt_ns != null && dt_ns.Rows.Count > 0)
            {
                detail.Ten_ns = dt_ns.Rows[0]["ten_ns"]?.ToString()?.Trim() ?? "";
                detail.Ten_ns2 = dt_ns.Rows[0]["ten_ns2"]?.ToString()?.Trim() ?? "";
                detail.Quoc_tich = dt_ns.Rows[0]["quoc_tich"]?.ToString()?.Trim() ?? "";
                detail.Quoc_tich2 = dt_ns.Rows[0]["quoc_tich2"]?.ToString()?.Trim() ?? "";
                detail.Ngay_sinh = dt_ns.Rows[0]["ngay_sinh"]?.ToString()?.Trim() ?? "";
                detail.Dia_chi = dt_ns.Rows[0]["dia_chi"]?.ToString()?.Trim() ?? "";
                detail.Cmnd = dt_ns.Rows[0]["cmnd"]?.ToString()?.Trim() ?? "";
                detail.Ngay_cmnd = dt_ns.Rows[0]["ngay_cmnd"]?.ToString()?.Trim() ?? "";
                detail.Nc_cmnd = dt_ns.Rows[0]["nc_cmnd"]?.ToString()?.Trim() ?? "";
                
                // Fetch contract date (ngay_hd)
                if (!DBNull.Value.Equals(dt_ns.Rows[0]["ngay_hd"]))
                {
                    DateTime ngayHd = Convert.ToDateTime(dt_ns.Rows[0]["ngay_hd"]);
                    detail.Ngay_hopdong = ngayHd.ToString("dd/MM/yyyy");
                }
                else
                {
                    detail.Ngay_hopdong = "";
                }
            }
        }

        LsData.Add(model);
        frmPrintVisible = true;
    }

    public async void CloseForm()
    {
        IsShowFrm = false;
        await Loaddata();
        StateHasChanged();
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged    -= OnLangguachange;
    }
}
