@page "/hrqtbc"
@page "/hrqtbc/{Menu_id}"
@inherits ListBaseComponent
@using SisHr.Pages.Input.HRQTBC
@attribute [Authorize(Roles = "admin,hrqtbc")]

<div class="d-flex mt-1 align-items-center gap-3">
    <h6 class="mb-0">@Lap["Employee code"]</h6>
    <AutocompleteComponent Ma_dm="dmns" @bind-Value="@M_EMP_ID" Filter="status = 1" SelectChanged="EmpFilter_Changed" CssClass="w-25" />
</div>
<hr style="margin:6px;padding:0px;height:1px;" />
<div class="row mt-1" tabindex="0" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="oBrowse" TblData="@TblData" Fbrowse="@fbrowse" Page_size="@Page_size" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>

@* ================================================================
   POPUP FORM ADD/EDIT/VIEW
   ================================================================ *@
@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true"
              Width="30vw"
              MinWidth="300px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@* ================================================================
   POPUP PRINT
   ================================================================ *@
@if (frmPrintVisible)
{
    <DxPopup @ref="popPrint"
             CloseOnOutsideClick="false"
             CssClass="dxPopup"
             @bind-Visible="@frmPrintVisible"
             Width="80%" Height="90%"
             ShowFooter="false"
             HeaderText="@Lap["Print certificate history"]">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData"
                                   Menu_id="@Menu_id.Replace('_', '.')"
                                   OnBack="@(() => { frmPrintVisible = false; StateHasChanged(); })" />
        </BodyTemplate>
    </DxPopup>
}

@code {
    // ===================================================
    // LOCAL VARIABLES
    // ===================================================
    private DxPopup popPrint;
    private bool frmPrintVisible = false;
    private List<HrqtbcPrintModel> LsData;

    private string preFilter = "";
    private string _EMP_ID;

    public string M_EMP_ID
    {
        get { return _EMP_ID; }
        set
        {
            if (_EMP_ID != value)
            {
                _EMP_ID = value;
                Loaddata();
            }
        }
    }

    public DotNetObjectReference<Hrqtbc> Pageobj;
    private string ActiveComponentId = "oBrowse";

    // ===================================================
    // INITIALIZATION
    // ===================================================
    protected override void OnInitialized()
    {
        mPage = "hrqtbc";
        editPage = "edithrqtbc";
        IsShowCopy = false;
        IsShowImport = false;
        sqlTableName = "dmqtbc";
        sqlTableView = "v_dmqtbc";
        SqlTableKey = "ma_qtbc";
        SqlItemName = "ma_ns";

        FrmType = typeof(EditHrqtbc);
        if (string.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.ct.08";

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));
            string Menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(Menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New", true, "F4"));
                myStateMN.SetToolBar(new MyToolbar("Edit", true, "F3"));
                myStateMN.SetToolBar(new MyToolbar("Save", false));
                myStateMN.SetToolBar(new MyToolbar("Delete", true, "F8"));
                myStateMN.SetToolBar(new MyToolbar("View", true, "F2"));
                myStateMN.SetToolBar(new MyToolbar("Print", true, "F7"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Quit", false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync("oBrowse");
            M_EMP_ID = "";
            await Language();
        }
    }

    // ===================================================
    // PAGELOAD
    // ===================================================
    public override async Task PageLoad()
    {
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        if (curCommand != null)
        {
            fbrowse = IsLangEn ? curCommand.Vbrowse2 : curCommand.Vbrowse1;
            Page_size = int.Parse(myOption.GetOptionsValue("M_GRID_NROW").Trim());
            editPage = "";
        }
        StateHasChanged();
    }

    // ===================================================
    // LOAD DATA
    // ===================================================
    public override async Task Loaddata()
    {
        try
        {
            SelectedItem = null;
            preFilter = "1=1";

            if (!String.IsNullOrEmpty(M_EMP_ID))
            {
                preFilter += " AND ma_ns LIKE '" + M_EMP_ID.Trim() + "%'";
            }

            string sql = "SELECT * FROM " + sqlTableView + " WHERE " + preFilter;

            DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];
                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }

            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Loaddata error: " + ex.Message);
            myStateMN.SetNewThongbao(Lap["Error loading data"] + ": " + ex.Message);
        }
        StateHasChanged();
    }

    // ===================================================
    // KEYBOARD HOTKEYS
    // ===================================================
    [JSInvokable]
    public async void GridFMode(string value, string Id)
    {
        if (!string.IsNullOrEmpty(Id) && Id.Equals("oBrowse"))
            oBrowseHotKeyFunction(value);
    }

    void oBrowseHotKeyFunction(string value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            if (value.Equals("F2")) V_Xem();
            else if (value.Equals("F3")) V_Sua();
            else if (value.Equals("F4")) V_Them();
            else if (value.Equals("F5")) StateHasChanged();
            else if (value.Equals("F7")) DoPrint();
            else if (value.Equals("F8")) V_Xoa();
        }
    }

    private async Task SetActiveComponentIdAsync(string id)
    {
        try
        {
            ActiveComponentId = id ?? ActiveComponentId;
            if (Pageobj != null)
                await JavacriptS.InvokeVoidAsync("SetPageFModeObj", Pageobj, ActiveComponentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("SetActiveComponentIdAsync error: " + ex.Message);
        }
    }

    // ===================================================
    // HANDLE TOOLBAR ACTIONS
    // ===================================================
    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                myStateMN.SetCurrentActionTask(ActionTask.New);
                V_Them();
                break;
            case ActionTask.Edit:
                myStateMN.SetCurrentActionTask(ActionTask.Edit);
                V_Sua();
                break;
            case ActionTask.View:
                myStateMN.SetCurrentActionTask(ActionTask.View);
                V_Xem();
                break;
            case ActionTask.Delete:
                V_Xoa();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Print:
                DoPrint();
                StateHasChanged();
                break;
        }
    }

    // ===================================================
    // ADD NEW
    // ===================================================
    public virtual void V_Them()
    {
        string strEmpId = M_EMP_ID;
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
            strEmpId = rview["ma_ns"].ToString().Trim();

        if (string.IsNullOrEmpty(strEmpId))
        {
            myStateMN.SetNewThongbao(Lap["Please select an employee before adding new certificate history!"] + "!");
            return;
        }

        Par.Clear();
        Par.Add("Ma_ma", (object)strEmpId);
        Par.Add("Menu_id", (object)Menu_id);
        Par.Add("ShowAdd", (object)true);
        Par.Add("curActionTask", (object)ActionTask.New);
        Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
        IsShowFrm = true;
        StateHasChanged();
    }

    // ===================================================
    // EDIT
    // ===================================================
    public override void V_Sua()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string ma_qtbc = rview["ma_qtbc"].ToString().Trim();
            Par.Clear();
            Par.Add("Ma_ma", (object)ma_qtbc);
            Par.Add("Menu_id", (object)Menu_id);
            Par.Add("ShowAdd", (object)true);
            Par.Add("curActionTask", (object)ActionTask.Edit);
            Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
            IsShowFrm = true;
            StateHasChanged();
        }
        else
            myStateMN.SetNewThongbao(Lap["No row selected!"] + "!");
    }

    // ===================================================
    // VIEW
    // ===================================================
    public virtual void V_Xem()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string ma_qtbc = rview["ma_qtbc"].ToString().Trim();
            Par.Clear();
            Par.Add("Ma_ma", (object)ma_qtbc);
            Par.Add("Menu_id", (object)Menu_id);
            Par.Add("ShowAdd", (object)true);
            Par.Add("curActionTask", (object)ActionTask.View);
            Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
            IsShowFrm = true;
            StateHasChanged();
        }
        else
            myStateMN.SetNewThongbao(Lap["No row selected!"] + "!");
    }

    // ===================================================
    // DELETE
    // ===================================================
    public virtual async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string ma_qtbc = rview["ma_qtbc"].ToString().Trim();
            string displayValue = $"{rview["ma_ns"]}";

            var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
            {
                Text = String.Format(Lap["Do you want to delete :{0} ?"], displayValue),
                Title = Lap["Confirm deletion of list"],
                OkButtonText = Lap["Yes"],
                CancelButtonText = Lap["No"],
                ShowIcon = true,
                ShowCloseButton = false,
                RenderStyle = MessageBoxRenderStyle.Danger
            });

            if (confirm)
                await DeleteRecord(ma_qtbc);
        }
        else
            myStateMN.SetNewThongbao(Lap["No row selected!"] + "!");
    }

    private async Task DeleteRecord(string ma_qtbc)
    {
        try
        {
            string safe = ma_qtbc.Replace("'", "''");
            string sql = $"DELETE FROM {sqlTableName} WHERE ma_qtbc = '{safe}'";
            await myDb.ExecuteSqlQueryAsync(sql);
            await Loaddata();
            myStateMN.SetNewThongbao(String.Format(Lap["Delete successfully : {0}"], ma_qtbc));
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Delete failed"] + ": " + ex.Message);
        }
    }

    // ===================================================
    // PRINT
    // ===================================================
    private void DoPrint()
    {
        if (TblData == null || TblData.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["No data to print"]);
            return;
        }

        try
        {
            LsData = new List<HrqtbcPrintModel>();

            // Get all data rows from view for printing
            string sql = $"SELECT * FROM {sqlTableView} WHERE {preFilter}";
            DataTable dtFull = myDb.GetTable(sql);

            if (dtFull != null && dtFull.Rows.Count > 0)
            {
                // Create list of rows first
                List<HrqtbcPrintRow> lsRows = new List<HrqtbcPrintRow>();
                
                for (int i = 0; i < dtFull.Rows.Count; i++)
                {
                    DataRow dr = dtFull.Rows[i];
                    var row = new HrqtbcPrintRow
                    {
                        Stt = i + 1,  // Assign STT first: 1, 2, 3, ...
                        Ma_qtbc = dr["ma_qtbc"]?.ToString()?.Trim() ?? "",
                        Ma_ns = dr["ma_ns"]?.ToString()?.Trim() ?? "",
                        Nam_tot_nghiep = dr["nam_tot_nghiep"]?.ToString()?.Trim() ?? "",
                        Ma_cn = dr["ma_cn"]?.ToString()?.Trim() ?? "",
                        Ma_qg = dr["ma_qg"]?.ToString()?.Trim() ?? "",
                        Noi_cap = dr["noi_cap"]?.ToString()?.Trim() ?? "",
                        Ma_tdbc = dr["ma_tdbc"]?.ToString()?.Trim() ?? "",
                        Ma_htdt = dr["ma_htdt"]?.ToString()?.Trim() ?? "",
                        Xep_loai = dr["xep_loai"]?.ToString()?.Trim() ?? "",
                        Ghi_chu = dr["ghi_chu"]?.ToString()?.Trim() ?? "",
                        Ten_ns = dr["ten_ns"]?.ToString()?.Trim() ?? "",
                        Ten_cn = dr["ten_cn"]?.ToString()?.Trim() ?? "",
                        Ten_quocgia = dr["ten_quocgia"]?.ToString()?.Trim() ?? "",
                        Ten_xlbc = dr["ten_xlbc"]?.ToString()?.Trim() ?? "",
                        Ten_htdt = dr["ten_htdt"]?.ToString()?.Trim() ?? "",
                        Tencty = myOption.GetOptionsValue("M_TEN_CTY")?.Trim() ?? "",
                        Diachicty = myOption.GetOptionsValue("M_DIA_CHI2")?.Trim() ?? ""
                    };
                    lsRows.Add(row);
                }

                var model = new HrqtbcPrintModel
                {
                    LsData = lsRows
                };

                LsData.Add(model);
                frmPrintVisible = true;
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Print failed"] + ": " + ex.Message);
        }
    }

    // ===================================================
    // FILTER / CLOSE / EXPORT / DISPOSE
    // ===================================================
    void EmpFilter_Changed(ExpandoObject value) => Loaddata();

    public async void CloseForm()
    {
        IsShowFrm = false;
        await Loaddata();
        StateHasChanged();
    }

    public override async void ExportData(int type)
    {
        try
        {
            if (TblData == null || TblData.Rows.Count == 0)
            {
                myStateMN.SetNewThongbao(Lap["No data to export"] + "!");
                return;
            }

            // Call FrmBrowseComponent's ExPortGrid method to export data
            oBrowse.ExPortGrid(type);
            myStateMN.SetNewThongbao(Lap["Export successfully"] + "!");
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Export failed"] + ": " + ex.Message);
        }
    }


    public override async void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
    }
}
