@inherits FrmListBaseComponent
@using SisHr.Pages.Input.HRNVNTS

<div style="width:auto;">
    <FormList Title="@Title" @bind-curActionTask="@curActionTask" OnSave="@SaveHrnvnts" OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout ItemSizeMode="@Itemsizemode" CssClass="frm-header sis-form" onkeydown="ModifyEnterKeyPressAsTab(event)">

                @* --- EMPLOYEE CODE --- *@
                <DxFormLayoutItem Caption="@Lap["Employee code"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                    <Template>
                        <AutocompleteComponent Id="ma_ns_input" Ma_dm="dmns" Filter="status = 1"
                                               @bind-Value="@CurRow.Ma_ns"
                                               IsEnable="@AllowEditMa"
                                               SelectChanged="Ma_ns_Changed"
                                               IsLangEn="@IsLangEn" />
                    </Template>
                </DxFormLayoutItem>

                @* --- DEPARTMENT (display only) --- *@
                <DxFormLayoutItem Caption="@Lap["Department"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox Text="@maBpns" ReadOnly="true" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="6" />

                @* --- MATERNITY CODE --- *@
                <DxFormLayoutItem Caption="@Lap["Maternity code"]" ColSpanMd="12" BeginRow="true" CaptionCssClass="fw-bold">
                    <Template>
                        <DxTextBox Id="ma_ts_input"
                                   @bind-Text="@CurRow.Ma_ts"
                                   maxlength="@(tblLength.ContainsKey("ma_ts") ? tblLength["ma_ts"] : 20)"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* --- MATERNITY NAME --- *@
                <DxFormLayoutItem Caption="@Lap["Maternity name"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                    <Template>
                        <DxTextBox @bind-Text="@CurRow.Ten_ts"
                                   maxlength="@(tblLength.ContainsKey("ten_ts") ? tblLength["ten_ts"] : 200)"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* --- APPLICATION DATE --- *@
                <DxFormLayoutItem Caption="@Lap["Application date"]" ColSpanMd="12" BeginRow="true" CaptionCssClass="fw-bold">
                    <Template>
                        <DxDateEdit Id="ngay_lam_don_input" Enabled="@AllowEditMode"
                                    @bind-Date="@CurRow.Ngay_lam_don" DisplayFormat="dd/MM/yyyy" />
                    </Template>
                </DxFormLayoutItem>

                @* --- MATERNITY START DATE --- *@
                <DxFormLayoutItem Caption="@Lap["Maternity leave date"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                    <Template>
                        <DxDateEdit Id="ngay_nghi_input" Enabled="@AllowEditMode"
                                    @bind-Date="@CurRow.Ngay_nghi" DisplayFormat="dd/MM/yyyy" />
                    </Template>
                </DxFormLayoutItem>

                @* --- MATERNITY END DATE --- *@
                <DxFormLayoutItem Caption="@Lap["Maternity end date"]" ColSpanMd="12" BeginRow="true" CaptionCssClass="fw-bold">
                    <Template>
                        <DxDateEdit Id="ngay_di_lam_lai_input" Enabled="@AllowEditMode"
                                    @bind-Date="@CurRow.Ngay_di_lam_lai" DisplayFormat="dd/MM/yyyy" />
                    </Template>
                </DxFormLayoutItem>

                @* --- ALLOWANCE --- *@
                <DxFormLayoutItem Caption="@Lap["Maternity allowance"]" ColSpanMd="12">
                    <Template>
                        <div class="d-flex align-items-center gap-2">
                            <DxSpinEdit Id="tro_cap_input" Enabled="@AllowEditMode"
                                        Value="@(CurRow.Tro_cap ?? 0)"
                                        ValueChanged="@((decimal v) => { CurRow.Tro_cap = v; StateHasChanged(); })"
                                        MinValue="0" MaxValue="1" Increment="1" DisplayFormat="N0" />
                            <span class="text-muted small">@Lap["0 - No allowance, 1 - Allowance"]</span>
                        </div>
                    </Template>
                </DxFormLayoutItem>

                @* --- ALLOWANCE DECISION --- *@
                <DxFormLayoutItem Caption="@Lap["Maternity allowance decision"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurRow.Quyet_dinh_tro_cap"
                                   maxlength="@(tblLength.ContainsKey("quyet_dinh_tro_cap") ? tblLength["quyet_dinh_tro_cap"] : 200)"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* --- REASON --- *@
                <DxFormLayoutItem Caption="@Lap["Reason"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurRow.Ly_do"
                                   maxlength="@(tblLength.ContainsKey("ly_do") ? tblLength["ly_do"] : 500)"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* --- NOTE --- *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurRow.Ghi_chu"
                                   maxlength="@(tblLength.ContainsKey("ghi_chu") ? tblLength["ghi_chu"] : 500)"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* --- STATUS --- *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <div class="d-flex align-items-center gap-2">
                            <DxSpinEdit Id="status_input" Enabled="@AllowEditMode"
                                        Value="@(CurRow.Status ?? 1)"
                                        ValueChanged="@((int v) => { CurRow.Status = v; StateHasChanged(); })"
                                        MinValue="0" MaxValue="1" Increment="1" DisplayFormat="N0" />
                            <span class="text-muted small">@Lap["0 - Not in use, 1 - In use"]</span>
                        </div>
                    </Template>
                </DxFormLayoutItem>

            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Hrnvnts CurRow;
    private string tenNs = "";
    private string maBpns = "";
    private const string DefaultMenuId = "wr.ct.19";

    protected override void OnInitialized()
    {
        sqlTableName     = "dmnvnts";
        sqlTableView     = "v_dmnvnts";
        SqlTableKey      = "idts";
        CheckSqlTableKey = "idts";
        ParentPage       = string.IsNullOrEmpty(ParentPage) ? "hrnvnts" : ParentPage;
        CurRow           = new Hrnvnts();

        if (string.IsNullOrEmpty(Menu_id))
            Menu_id = DefaultMenuId;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await PageLoad();

            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewRecord(Ma_ma);
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditRecord(Ma_ma);
                    break;
                case ActionTask.New:
                    await NewRecord();
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewRecord(Ma_ma);
                    break;
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Error: " + ex.Message);
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await base.OnAfterRenderAsync(firstRender);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_ns_input')?.focus()");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    async Task ViewRecord(string key)
    {
        CurRow        = new Hrnvnts();
        AllowEditMode = false;
        AllowEditMa   = false;
        await LoadData(key);
    }

    async Task EditRecord(string key)
    {
        CurRow        = new Hrnvnts();
        AllowEditMode = true;
        AllowEditMa   = false;
        await LoadData(key);
    }

    async Task NewRecord()
    {
        CurRow                  = new Hrnvnts();
        CurRow.Idts             = Guid.NewGuid().ToString();
        CurRow.Status           = 1;
        CurRow.Tro_cap          = 0;
        CurRow.Ma_ts            = "TS";
        CurRow.Ten_ts           = "Ngh? thai s?n";
        CurRow.Ngay_lam_don     = DateTime.Now.Date;
        CurRow.Ngay_nghi        = DateTime.Now.Date;
        CurRow.Ngay_di_lam_lai  = DateTime.Now.Date;
        AllowEditMode           = true;
        AllowEditMa             = true;
        tenNs                   = "";
        maBpns                  = "";
        StateHasChanged();
    }

    async Task LoadData(string key)
    {
        try
        {
            string sql = $"SELECT * FROM {sqlTableView} WHERE {SqlTableKey} = @{SqlTableKey}";
            DataSet ds = await myDb.LoadDataset(sql, SqlTableKey, key);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                List<Hrnvnts> list = myDb.ConvertDataTable<Hrnvnts>(ds.Tables[0]);
                if (list != null && list.Count > 0)
                {
                    CurRow = list[0];
                    tenNs  = IsLangEn ? (CurRow.Ten_ns2 ?? CurRow.Ten_ns ?? "") : (CurRow.Ten_ns ?? "");
                    maBpns = CurRow.Ma_bpns ?? "";
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Data load error: " + ex.Message);
            StateHasChanged();
        }
    }

    void Ma_ns_Changed(ExpandoObject value)
    {
        tenNs  = "";
        maBpns = "";
        if (value != null)
        {
            var dict = (IDictionary<string, object>)value;
            tenNs  = IsLangEn
                ? (dict.ContainsKey("ten_ns2") ? dict["ten_ns2"]?.ToString() ?? "" : (dict.ContainsKey("ten_ns") ? dict["ten_ns"]?.ToString() ?? "" : ""))
                : (dict.ContainsKey("ten_ns") ? dict["ten_ns"]?.ToString() ?? "" : "");
            maBpns = dict.ContainsKey("ma_bpns") ? dict["ma_bpns"]?.ToString() ?? "" : "";
        }
        StateHasChanged();
    }

    async Task SaveHrnvnts()
    {
        try
        {
            if (!CheckValid())
                return;

            CurRow.Quyet_dinh_tro_cap = CurRow.Quyet_dinh_tro_cap ?? "";
            CurRow.Ly_do              = CurRow.Ly_do ?? "";
            CurRow.Ghi_chu            = CurRow.Ghi_chu ?? "";
            CurRow.Ma_ts              = CurRow.Ma_ts ?? "";
            CurRow.Ten_ts             = CurRow.Ten_ts ?? "";

            DateTime now    = DateTime.Now;
            int userId      = curUser != null ? curUser.User_id : 0;
            string userName = curUser != null ? curUser.User_name : "";

            if (curActionTask == ActionTask.New)
            {
                if (string.IsNullOrWhiteSpace(CurRow.Idts))
                    CurRow.Idts = Guid.NewGuid().ToString();

                CurRow.Date0      = now.Date;
                CurRow.Time0      = now.ToString("HH:mm:ss");
                CurRow.Date       = now.Date;
                CurRow.Time       = now.ToString("HH:mm:ss");
                CurRow.User_id0   = userId;
                CurRow.User_name0 = userName;
                CurRow.User_id    = userId;
                CurRow.User_name  = userName;

                await myDb.InsertOneRow<Hrnvnts>(CurRow, sqlTableName);
                myStateMN.SetNewThongbao($"{Lap["Successfully added new"]}: {CurRow.Ma_ns}");
            }
            else if (curActionTask == ActionTask.Edit)
            {
                CurRow.Date      = now.Date;
                CurRow.Time      = now.ToString("HH:mm:ss");
                CurRow.User_id   = userId;
                CurRow.User_name = userName;

                string safeKey     = Ma_ma.Trim().Replace("'", "''");
                string whereClause = $"{SqlTableKey} = '{safeKey}'";
                await myDb.UpdateOneRow1<Hrnvnts>(CurRow, sqlTableName, "", whereClause);
                myStateMN.SetNewThongbao($"{Lap["Edit successfully"]}: {CurRow.Ma_ns}");
            }

            if (DxWindowmodel != null)
                myModal.CloseModal(DxWindowmodel);

            if (ShowAdd == true)
                OnClose.InvokeAsync();
            else
                myNavi.NavigateTo(ParentPage);
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Save failed"]}: {ex.Message}");
            StateHasChanged();
        }
    }

    bool CheckValid()
    {
        if (string.IsNullOrWhiteSpace(CurRow.Ma_ns))
        {
            myStateMN.SetNewThongbao(Lap["Employee code is required"] + "!");
            return false;
        }

        if (string.IsNullOrWhiteSpace(CurRow.Ma_ts))
        {
            myStateMN.SetNewThongbao(Lap["Maternity code is required"] + "!");
            return false;
        }

        if (string.IsNullOrWhiteSpace(CurRow.Ten_ts))
        {
            myStateMN.SetNewThongbao(Lap["Maternity name is required"] + "!");
            return false;
        }

        return true;
    }
}
