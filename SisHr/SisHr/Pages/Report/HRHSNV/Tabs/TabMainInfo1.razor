private string DisplayMaDvcs => CurRow?.Ma_dvcs ?? "-";

public List<StatusItem> ResidenceList { get; set; } = new()
{
    new StatusItem { Value = 1, Text = "1 - Cư trú" },
    new StatusItem { Value = 2, Text = "2 - Không cư trú" }
};

public List<StatusItem> YesNoList { get; set; } = new()
{
    new StatusItem { Value = 0, Text = "0 - Không" },
    new StatusItem { Value = 1, Text = "1 - Có" }
};

public List<StatusItem> KhoiList { get; set; } = new()
{
    new StatusItem { Value = "1", Text = "1 - Khối SX trực tiếp" },
    new StatusItem { Value = "2", Text = "2 - Khối SX gián tiếp" },
    new StatusItem { Value = "3", Text = "3 - Khối HCTH" }
};

public List<StatusItem> StatusList { get; set; } = new()
{
    new StatusItem { Value = "0", Text = "0 - Không sử dụng" },
    new StatusItem { Value = "1", Text = "1 - Đang sử dụng" }
};

public class StatusItem
{
    public dynamic Value { get; set; }
    public string Text { get; set; }
}

    private async Task HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Chuyển Enter thành Tab để move tới field tiếp theo
            try
            {
                // Dispatch Tab key event
                await DispatchTabEvent();
            }
            catch
            {
                // Bỏ qua lỗi JS interop
            }
        }
    }

    private async Task<string> GetActiveElement()
    {
        try
        {
            return "focus";
        }
        catch
        {
            return null;
        }
    }

    private async Task DispatchTabEvent()
    {
        try
        {
            // Dispatch Tab event để tự động move tới field tiếp theo
            var script = @"
                const active = document.activeElement;
                if (active) {
                    // Tìm form parent
                    const form = active.closest('form') || active.form;
                    if (form) {
                        // Lấy tất cả input/select/textarea
                        const inputs = Array.from(form.querySelectorAll('input, select, textarea, [tabindex]:not([tabindex=""-1""])'));
                        const idx = inputs.indexOf(active);
                        // Focus tới element tiếp theo
                        if (idx >= 0 && idx < inputs.length - 1) {
                            inputs[idx + 1].focus();
                        } else if (idx >= inputs.length - 1) {
                            // Nếu là field cuối cùng, về đầu
                            inputs[0]?.focus();
                        }
                    }
                }
            ";
            // await JavascriptService.InvokeVoidAsync("eval", script);
        }
        catch
        {
            // Bỏ qua lỗi
        }
    }
}