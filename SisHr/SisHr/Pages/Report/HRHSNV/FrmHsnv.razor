            newItem.Stt = CurRow.ListQtct.Count + 1;
            CurRow.ListQtct.Add(newItem);
            CurRow.ListQtct.RemoveAll(x => string.IsNullOrEmpty(x.Ma_quyet_dinh) && !x.Ngay_di.HasValue && !x.Ngay_ve.HasValue && x != newItem);
            SelectedQtct = newItem;
        }
        else
        {
            var dataItem = (QtctRow)e.DataItem;
            Tab13_CopyQtctRow(edit, dataItem);
            SelectedQtct = dataItem;
        }

        int stt = 1;
        CurRow.ListQtct.ForEach(x => x.Stt = stt++);

        e.Cancel = false;

        if (GridQtct != null) ((IGrid)GridQtct).Reload();
        await InvokeAsync(StateHasChanged);
    }

    // ===== TAB 13: XÓA DÒNG =====
    void GridQtct_DataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        var itemToDelete = (QtctRow)e.DataItem;
        CurRow.ListQtct.Remove(itemToDelete);
        int stt = 1;
        foreach (var r in CurRow.ListQtct) r.Stt = stt++;
        e.Cancel = true;
        if (GridQtct != null) ((IGrid)GridQtct).Reload();
        StateHasChanged();
    }

    // ===== TAB 13: CLICK DÒNG ĐỂ SỬA =====
    async Task StartEditQtctRow(GridRowClickEventArgs e)
    {
        if (!AllowEditMode) return;
        if (GridQtct.IsEditing())
            await GridQtct.SaveChangesAsync();
        var item = GridQtct.GetDataItem(e.VisibleIndex);
        if (item != null)
            await GridQtct.StartEditDataItemAsync(item);
    }

    // ===== TAB 13: LOST FOCUS - TỰ ĐỘNG LƯU =====
    async void OnGridQtctLostFocus(FocusEventArgs e)
    {
        try
        {
            bool stillInside = await JS.InvokeAsync<bool>("focusInside", "grid-wrapper-qtct");
            if (stillInside) return;
            if (GridQtct != null && GridQtct.IsEditing())
                await GridQtct.SaveChangesAsync();
        }
        catch { }
    }

    // ===== TAB 13: KEYDOWN =====
    private async Task GridQtct_OnKeyDown(KeyboardEventArgs e)
    {
        if (!AllowEditMode) return;
        switch (e.Key)
        {
            case "Enter":
                await Tab13_HandleSaveAndMoveNext();
                break;
            case "F4":
                Tab13_AddNewQtctRow();
                break;
            case "F8":
                if (SelectedQtct != null)
                    GridQtct.ShowDataItemDeleteConfirmation(SelectedQtct);
                break;
            case "Escape":
                try { await GridQtct.CancelEditAsync(); } catch { }
                break;
        }
    }

    private async Task Tab13_HandleSaveAndMoveNext()
    {
        if (!AllowEditMode || GridQtct == null) return;

        if (GridQtct.IsEditing())
            await GridQtct.SaveChangesAsync();

        await Task.Delay(100);

        if (SelectedQtct != null)
        {
            var currentItem = (QtctRow)SelectedQtct;
            var index = CurRow.ListQtct.IndexOf(currentItem);

            if (index >= 0 && index < CurRow.ListQtct.Count - 1)
                await GridQtct.StartEditDataItemAsync(CurRow.ListQtct[index + 1]);
            else
                Tab13_AddNewQtctRow();
        }
        else
        {
            Tab13_AddNewQtctRow();
        }
    }

    public async void Tab13_AddNewQtctRow()
    {
        if (!AllowEditMode || GridQtct == null) return;

        if (GridQtct.IsEditing())
        {
            await GridQtct.SaveChangesAsync();
            await Task.Delay(100);
        }
        await GridQtct.StartEditNewRowAsync();
    }
}



