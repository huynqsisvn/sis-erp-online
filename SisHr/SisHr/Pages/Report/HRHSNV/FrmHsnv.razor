    private async Task Tab2_HandleSaveAndMoveNext()
    {
        if (!AllowEditMode || GridCtgtk == null) return;

        // Lưu dòng hiện tại trước
        if (GridCtgtk.IsEditing())
            await GridCtgtk.SaveChangesAsync();

        // Chờ 1 chút để lưới đồng bộ hoàn tất (Chuẩn Zcfats là 100ms)
        await Task.Delay(100);

        if (SelectedCtgtk != null)
        {
            var currentItem = (CtgtkRow)SelectedCtgtk;
            var index = CurRow.ListCtgtk.IndexOf(currentItem);

            // Nếu chưa phải dòng cuối -> Xuống dòng kế tiếp
            if (index >= 0 && index < CurRow.ListCtgtk.Count - 1)
            {
                await GridCtgtk.StartEditDataItemAsync(CurRow.ListCtgtk[index + 1]);
            }
            else
            {
                // Nếu đang ở dòng cuối cùng -> Thêm dòng mới
                Tab2_AddNewCtgtkRow();
            }
        }
        else
        {
            Tab2_AddNewCtgtkRow();
        }
    }

