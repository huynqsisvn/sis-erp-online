    public class Tab2StatusItem { public int Value { get; set; } public string Text { get; set; } }

    // ===== TAB 2: LOAD DỮ LIỆU =====
    private async Task Tab2_LoadDataAsync(string maNs)
    {
        if (string.IsNullOrEmpty(maNs)) return;
        string safeKey = maNs.Trim().Replace("'", "''");
        string sql = $@"SELECT ngay_hl1, ngay_hl2, MAX(luong_thang) as luong_thang, MAX(luong) as luong,
                       MAX(CASE WHEN ma_gt = 'GT01' THEN tien_gt ELSE 0 END) AS A_001,
                       MAX(CASE WHEN ma_gt = 'GT02' THEN tien_gt ELSE 0 END) AS A_002,
                       MAX(CASE WHEN ma_gt = 'GT03' THEN tien_gt ELSE 0 END) AS A_003,
                       MAX(CASE WHEN ma_gt = 'GT01' THEN tien_gt ELSE 0 END) AS Gia_canh,
                       MAX(CASE WHEN ma_gt = 'GT05' THEN tien_gt ELSE 0 END) AS Tien_gt
                FROM ctgtk WHERE ma_ns = N'{safeKey}'
                GROUP BY ngay_hl1, ngay_hl2 ORDER BY ngay_hl1";
        var ds = await myDb.LoadDataset(sql);
        CurRow.ListCtgtk = ds?.Tables.Count > 0
            ? (List<CtgtkRow>)myDb.ConvertDataTable<CtgtkRow>(ds.Tables[0]) ?? new List<CtgtkRow>()
            : new List<CtgtkRow>();
        int stt = 1;
        CurRow.ListCtgtk.ForEach(x => x.Stt = stt++);
    }

    // ===== TAB 2: COPY ROW =====
    private void Tab2_CopyCtgtkRow(CtgtkRow src, CtgtkRow dst)
    {
        dst.Ma_gt = src.Ma_gt;
        dst.Ngay_hl1 = src.Ngay_hl1;
        dst.Ngay_hl2 = src.Ngay_hl2;
        dst.Luong_thang = src.Luong_thang;
        dst.Luong = src.Luong;
        dst.Gia_canh = src.Gia_canh;
        dst.A_001 = src.A_001;
        dst.A_002 = src.A_002;
        dst.A_003 = src.A_003;
        dst.Tien_gt = src.Tien_gt;
        dst.Dien_giai = src.Dien_giai;
    }

    // ===== TAB 2: TỰ TÍNH BẢO HIỂM =====
    private void Tab2_AutoCalculateDeductions(CtgtkRow item)
    {
        if (!item.Luong.HasValue || item.Luong.Value == 0)
        {
            item.A_001 = 0; item.A_002 = 0; item.A_003 = 0;
            return;
        }
        decimal luongBH = item.Luong.Value;
        item.A_001 = Math.Round((luongBH * 1m) / 100m, 0, MidpointRounding.AwayFromZero);
        item.A_002 = Math.Round((luongBH * 1.5m) / 100m, 0, MidpointRounding.AwayFromZero);
        item.A_003 = Math.Round((luongBH * 8m) / 100m, 0, MidpointRounding.AwayFromZero);
    }

    // ===== TAB 2: CUSTOMIZE EDIT MODEL =====
        void GridCtgtk_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
        {
            if (e.IsNew)
            {
                var model = (CtgtkRow)e.EditModel;
                model.Stt = CurRow.ListCtgtk.Count > 0 ? CurRow.ListCtgtk.Max(a => a.Stt) + 1 : 1;
            }
        }

        // ===== TAB 2: LƯU DÒNG =====
        async Task GridCtgtk_EditModelSaving(GridEditModelSavingEventArgs e)
        {
            var edit = (CtgtkRow)e.EditModel;
            bool coNhapNgay = edit.Ngay_hl1.HasValue;
            bool coNhapLuong = (edit.Luong_thang ?? 0) != 0 || (edit.Luong ?? 0) != 0 || (edit.Tien_gt ?? 0) != 0;
            bool laDongTrong = !coNhapNgay && !coNhapLuong;

            if (e.IsNew && laDongTrong)
            {
                e.Cancel = false; 
                return; 
            }

            if (e.IsNew)
            {
                var newItem = new CtgtkRow();
                Tab2_CopyCtgtkRow(edit, newItem);
                Tab2_AutoCalculateDeductions(newItem); 
                newItem.Stt = CurRow.ListCtgtk.Count + 1;
                CurRow.ListCtgtk.Add(newItem);
                
                CurRow.ListCtgtk.RemoveAll(x => !x.Ngay_hl1.HasValue && x != newItem);
                SelectedCtgtk = newItem;
            }
            else
            {
                var dataItem = (CtgtkRow)e.DataItem;
                Tab2_CopyCtgtkRow(edit, dataItem);
                Tab2_AutoCalculateDeductions(dataItem);
                SelectedCtgtk = dataItem;
            }

            int stt = 1;
            CurRow.ListCtgtk.ForEach(x => x.Stt = stt++);
            
            e.Cancel = false;

            if (GridCtgtk != null) ((IGrid)GridCtgtk).Reload();
            await InvokeAsync(StateHasChanged);
        }

        // ===== TAB 2: XÓA DÒNG =====
    void GridCtgtk_DataItemDeleting(GridDataItemDeletingEventArgs e)
        {
            var itemToDelete = (CtgtkRow)e.DataItem;
            CurRow.ListCtgtk.Remove(itemToDelete);
            int stt = 1;
            foreach (var r in CurRow.ListCtgtk) r.Stt = stt++;
            e.Cancel = true;
            if (GridCtgtk != null) ((IGrid)GridCtgtk).Reload();
            StateHasChanged();
        }

