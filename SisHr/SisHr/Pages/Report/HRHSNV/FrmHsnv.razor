    // ===== TAB 13: LƯU DÒNG =====
    async Task GridQtct_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        var edit = (QtctRow)e.EditModel;
        bool laDongTrong = string.IsNullOrEmpty(edit.Ma_quyet_dinh) && !edit.Ngay_di.HasValue && !edit.Ngay_ve.HasValue;

        if (e.IsNew && laDongTrong)
