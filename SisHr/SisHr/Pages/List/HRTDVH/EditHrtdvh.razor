@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRTDVH

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmvh"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã trình độ văn hóa *@
                <DxFormLayoutItem Caption="@Lap["Education level code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_vh_input"
                                   @bind-Text="@CurDmvh.Ma_vh"
                                   maxlength="@tblLength["ma_vh"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên trình độ văn hóa *@
                <DxFormLayoutItem Caption="@Lap["Education level name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmvh.Ten_vh"
                                   maxlength="@tblLength["ten_vh"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên trình độ văn hóa 2 *@
                <DxFormLayoutItem Caption="@(Lap["Education level name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmvh.Ten_vh2"
                                   maxlength="@tblLength["ten_vh2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmvh.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Trạng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmvh.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmvh CurDmvh;
    private string menu_id = "wr.dm.05";

    protected override void OnInitialized()
    {
        sqlTableName = "dmvh";
        SqlTableKey = "ma_vh";
        CheckSqlTableKey = "ma_vh";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrtdvh" : ParentPage;
        CurDmvh = new Dmvh();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_vh_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmvh = new Dmvh();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmvh = new Dmvh();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmvh.Ma_vh);
    }

    async Task SaveDM()
    {
        CurDmvh.Ma_vh = CurDmvh.Ma_vh?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmvh.Ten_vh2 = CurDmvh.Ten_vh2 ?? "";
        CurDmvh.Ghi_chu = CurDmvh.Ghi_chu ?? "";

        SqlTableKeyValue = CurDmvh.Ma_vh.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmvh.Date = DateTime.Now.Date;
            CurDmvh.Date0 = DateTime.Now.Date;
            CurDmvh.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmvh.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmvh.User_id = curUser.User_id;
                CurDmvh.User_id0 = curUser.User_id;
                CurDmvh.User_name = curUser.User_name;
                CurDmvh.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmvh.Ma_vh.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmvh>(CurDmvh, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmvh.Date = DateTime.Now.Date;
            CurDmvh.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmvh.User_id = curUser.User_id;
                CurDmvh.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmvh>(CurDmvh, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmvh.Ma_vh))
        {
            myStateMN.SetNewThongbao(Lap["Education level code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmvh.Ten_vh))
        {
            myStateMN.SetNewThongbao(Lap["Education level name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmvh> lsdetai = myDb.ConvertDataTable<Dmvh>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmvh = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmvh.Ma_vh))
            CurDmvh.Ma_vh = CurDmvh.Ma_vh.Trim();

        if (!string.IsNullOrEmpty(CurDmvh.Status))
            CurDmvh.Status = CurDmvh.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmvh = new Dmvh();
        CurDmvh.Status = "1";
        CurDmvh.Ma_vh = GetNewSttDM();
        CurDmvh.Ten_vh2 = "";
        CurDmvh.Ghi_chu = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmvh = new Dmvh();
        await LoadData(key);
        CurDmvh.Status = "1";
        CurDmvh.Ma_vh = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<int> CheckDeleteListIdAsync(string maVh)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmvh', '{maVh}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }
}
