@page "/hrtd"
@page "/hrtd/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,hrtd")]

<div class="row mt-1" @onkeydown="OnoBrowseKeyDown" tabindex="0">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="40vw"
              MinWidth="500px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible"
                                 List_ID="@sqlTableName"
                                 Ma_ma="@SqlTableKeyValue"
                                 Title="@Lap["Change qualification code"]"
                                 Ten_item="@Ten_item"
                                 OnChangeID="@OnChangeID"
                                 OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportDM @bind-IsImportPopupVisible="@IsImportPopupVisible"
                             CurDmimex="@CurDmimex"
                             OnImportCompleted="@ImportOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {
    protected override void OnInitialized()
    {
        mPage = "hrtd";
        IsShowCopy = true;
        IsShowImport = true;
        Is_doi_ma = true;
        sqlTableName = "dmtrinhdo";
        sqlTableView = "v_dmtrinhdo";
        SqlTableKey = "ma_td";
        SqlItemName = "ten_td";
        FrmType = typeof(SisHr.Pages.List.HRTD.EditHrtd);

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.dm.31";

        base.OnInitialized();
    }

    public override async Task PageLoad()
    {
        await base.PageLoad();
        Is_doi_ma = true;
        SqlItemName = "ten_td";
        sqlTableName = "dmtrinhdo";
        sqlTableView = "v_dmtrinhdo";
        SqlTableKey = "ma_td";
    }

    public override async void ChangeOK(string newID)
    {
        await Loaddata();
        myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], newID));
        StateHasChanged();
    }

    public async Task OnChangeID(string newID)
    {
        try
        {
            string oldId = SqlTableKeyValue.Replace("'", "''");
            string newIdClean = newID.Trim().ToUpper().Replace("'", "''");
            string sql = $"UPDATE {sqlTableName} SET {SqlTableKey} = '{newIdClean}' WHERE {SqlTableKey} = '{oldId}'";
            await myDb.ExecuteSqlQueryAsync(sql);
            IDVisible = false;
            await Loaddata();
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], newID));
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(ex.Message);
            Console.WriteLine("OnChangeID error: " + ex.Message);
        }
    }

    public override async Task Loaddata()
    {
        string sql = $"SELECT * FROM {sqlTableView}";

        try
        {
            System.Data.DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];
                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Loaddata error: " + ex.Message);
        }

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }
}
