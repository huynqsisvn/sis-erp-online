@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRKTKL

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmktkl"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã khen th??ng k? lu?t *@
                <DxFormLayoutItem Caption="@Lap["Reward/discipline code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_ktkl_input"
                                   @bind-Text="@CurDmktkl.Ma_ktkl"
                                   maxlength="@tblLength["ma_ktkl"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên khen th??ng k? lu?t *@
                <DxFormLayoutItem Caption="@Lap["Reward/discipline name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmktkl.Ten_ktkl"
                                   maxlength="@tblLength["ten_ktkl"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên khen th??ng k? lu?t 2 *@
                <DxFormLayoutItem Caption="@(Lap["Reward/discipline name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmktkl.Ten_ktkl2"
                                   maxlength="@tblLength["ten_ktkl2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmktkl.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmktkl.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmktkl CurDmktkl;
    private string menu_id = "wr.dm.20";

    protected override void OnInitialized()
    {
        sqlTableName = "dmktkl";
        SqlTableKey = "ma_ktkl";
        CheckSqlTableKey = "ma_ktkl";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrktkl" : ParentPage;
        CurDmktkl = new Dmktkl();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_ktkl_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmktkl = new Dmktkl();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmktkl = new Dmktkl();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmktkl.Ma_ktkl);
    }

    async Task SaveDM()
    {
        CurDmktkl.Ma_ktkl = CurDmktkl.Ma_ktkl?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmktkl.Ten_ktkl2 = CurDmktkl.Ten_ktkl2 ?? "";
        CurDmktkl.Ghi_chu = CurDmktkl.Ghi_chu ?? "";

        SqlTableKeyValue = CurDmktkl.Ma_ktkl.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmktkl.Date = DateTime.Now.Date;
            CurDmktkl.Date0 = DateTime.Now.Date;
            CurDmktkl.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmktkl.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmktkl.User_id = curUser.User_id;
                CurDmktkl.User_id0 = curUser.User_id;
                CurDmktkl.User_name = curUser.User_name;
                CurDmktkl.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmktkl.Ma_ktkl.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmktkl>(CurDmktkl, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmktkl.Date = DateTime.Now.Date;
            CurDmktkl.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmktkl.User_id = curUser.User_id;
                CurDmktkl.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmktkl>(CurDmktkl, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmktkl.Ma_ktkl))
        {
            myStateMN.SetNewThongbao(Lap["Reward/discipline code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmktkl.Ten_ktkl))
        {
            myStateMN.SetNewThongbao(Lap["Reward/discipline name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task<int> CheckDeleteListIdAsync(string maKtkl)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmktkl', '{maKtkl}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet dsTrans = await myDb.LoadDataset(sql);
        if (dsTrans != null && dsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmktkl> lsdetai = myDb.ConvertDataTable<Dmktkl>(dsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmktkl = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmktkl.Ma_ktkl))
            CurDmktkl.Ma_ktkl = CurDmktkl.Ma_ktkl.Trim();

        if (!string.IsNullOrEmpty(CurDmktkl.Status))
            CurDmktkl.Status = CurDmktkl.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmktkl = new Dmktkl();
        CurDmktkl.Status = "1";
        CurDmktkl.Ma_ktkl = GetNewSttDM();
        CurDmktkl.Ten_ktkl2 = "";
        CurDmktkl.Ghi_chu = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmktkl = new Dmktkl();
        await LoadData(key);
        CurDmktkl.Status = "1";
        CurDmktkl.Ma_ktkl = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
