@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRncsbhxh

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmncsbhxh"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã NCSBHXH *@
                <DxFormLayoutItem Caption="@Lap["Social insurance book issuer code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_ncsbhxh_input"
                                   @bind-Text="@CurDmncsbhxh.Ma_ncsbhxh"
                                   maxlength="@tblLength["ma_ncsbhxh"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên NCSBHXH *@
                <DxFormLayoutItem Caption="@Lap["Social insurance book issuer name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmncsbhxh.Ten_ncsbhxh"
                                   maxlength="@tblLength["ten_ncsbhxh"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên NCSBHXH 2 *@
                <DxFormLayoutItem Caption="@(Lap["Social insurance book issuer name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmncsbhxh.Ten_ncsbhxh2"
                                   maxlength="@tblLength["ten_ncsbhxh2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmncsbhxh.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmncsbhxh.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmncsbhxh CurDmncsbhxh;
    private string menu_id = "wr.dm.30";

    protected override void OnInitialized()
    {
        sqlTableName = "DMNCSBHXH";
        SqlTableKey = "ma_ncsbhxh";
        CheckSqlTableKey = "ma_ncsbhxh";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrncsbhxh" : ParentPage;
        CurDmncsbhxh = new Dmncsbhxh();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_ncsbhxh_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string key)
    {
        CurDmncsbhxh = new Dmncsbhxh();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmncsbhxh = new Dmncsbhxh();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmncsbhxh.Ma_ncsbhxh);
    }

    async Task SaveDM()
    {
        CurDmncsbhxh.Ma_ncsbhxh = CurDmncsbhxh.Ma_ncsbhxh?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmncsbhxh.Ma_ncsbhxh.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmncsbhxh.Date = DateTime.Now.Date;
            CurDmncsbhxh.Date0 = DateTime.Now.Date;
            CurDmncsbhxh.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmncsbhxh.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmncsbhxh.User_id = curUser.User_id;
                CurDmncsbhxh.User_id0 = curUser.User_id;
                CurDmncsbhxh.User_name = curUser.User_name;
                CurDmncsbhxh.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmncsbhxh.Ma_ncsbhxh.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmncsbhxh>(CurDmncsbhxh, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmncsbhxh.Date = DateTime.Now.Date;
            CurDmncsbhxh.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmncsbhxh.User_id = curUser.User_id;
                CurDmncsbhxh.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmncsbhxh>(CurDmncsbhxh, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmncsbhxh.Ma_ncsbhxh))
        {
            myStateMN.SetNewThongbao(Lap["Social insurance book issuer code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmncsbhxh.Ten_ncsbhxh))
        {
            myStateMN.SetNewThongbao(Lap["Social insurance book issuer name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task<int> CheckDeleteListIdAsync(string maNcsbhxh)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'DMNCSBHXH', '{maNcsbhxh}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet dsTrans = await myDb.LoadDataset(sql);
        if (dsTrans != null && dsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmncsbhxh> lsdetai = myDb.ConvertDataTable<Dmncsbhxh>(dsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmncsbhxh = lsdetai[0];
            }
        }
    }

    async Task CreateNewDM()
    {
        CurDmncsbhxh = new Dmncsbhxh();
        CurDmncsbhxh.Status = "1";
        CurDmncsbhxh.Ma_ncsbhxh = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmncsbhxh = new Dmncsbhxh();
        await LoadData(key);
        CurDmncsbhxh.Status = "1";
        CurDmncsbhxh.Ma_ncsbhxh = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
