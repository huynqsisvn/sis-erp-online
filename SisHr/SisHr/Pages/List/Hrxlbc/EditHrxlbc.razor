@inherits FrmListBaseComponent
@using SisHr.Pages.List.Hrxlbc

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmxlbc"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã x?p lo?i b?ng c?p *@
                <DxFormLayoutItem Caption="@Lap["Certificate classification code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_xlbc_input"
                                   @bind-Text="@CurDmxlbc.Ma_xlbc"
                                   maxlength="@tblLength["ma_xlbc"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên x?p lo?i b?ng c?p *@
                <DxFormLayoutItem Caption="@Lap["Certificate classification name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmxlbc.Ten_xlbc"
                                   maxlength="@tblLength["ten_xlbc"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên x?p lo?i b?ng c?p 2 *@
                <DxFormLayoutItem Caption="@(Lap["Certificate classification name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmxlbc.Ten_xlbc2"
                                   maxlength="@tblLength["ten_xlbc2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmxlbc.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmxlbc.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmxlbc CurDmxlbc;
    private string menu_id = "wr.dm.04";

    protected override void OnInitialized()
    {
        sqlTableName = "dmxlbc";
        SqlTableKey = "ma_xlbc";
        CheckSqlTableKey = "ma_xlbc";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrxlbc" : ParentPage;
        CurDmxlbc = new Dmxlbc();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_xlbc_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmxlbc = new Dmxlbc();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmxlbc = new Dmxlbc();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmxlbc.Ma_xlbc);
    }

    async Task SaveDM()
    {
        CurDmxlbc.Ma_xlbc = CurDmxlbc.Ma_xlbc?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmxlbc.Ten_xlbc2 = CurDmxlbc.Ten_xlbc2 ?? "";
        CurDmxlbc.Ghi_chu = CurDmxlbc.Ghi_chu ?? "";

        SqlTableKeyValue = CurDmxlbc.Ma_xlbc.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmxlbc.Date = DateTime.Now.Date;
            CurDmxlbc.Date0 = DateTime.Now.Date;
            CurDmxlbc.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmxlbc.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmxlbc.User_id = curUser.User_id;
                CurDmxlbc.User_id0 = curUser.User_id;
                CurDmxlbc.User_name = curUser.User_name;
                CurDmxlbc.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmxlbc.Ma_xlbc.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmxlbc>(CurDmxlbc, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmxlbc.Date = DateTime.Now.Date;
            CurDmxlbc.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmxlbc.User_id = curUser.User_id;
                CurDmxlbc.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmxlbc>(CurDmxlbc, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmxlbc.Ma_xlbc))
        {
            myStateMN.SetNewThongbao(Lap["Certificate classification code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmxlbc.Ten_xlbc))
        {
            myStateMN.SetNewThongbao(Lap["Certificate classification name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmxlbc> lsdetai = myDb.ConvertDataTable<Dmxlbc>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmxlbc = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmxlbc.Ma_xlbc))
            CurDmxlbc.Ma_xlbc = CurDmxlbc.Ma_xlbc.Trim();

        if (!string.IsNullOrEmpty(CurDmxlbc.Status))
            CurDmxlbc.Status = CurDmxlbc.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmxlbc = new Dmxlbc();
        CurDmxlbc.Status = "1";
        CurDmxlbc.Ma_xlbc = GetNewSttDM();
        CurDmxlbc.Ten_xlbc2 = "";
        CurDmxlbc.Ghi_chu = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmxlbc = new Dmxlbc();
        await LoadData(key);
        CurDmxlbc.Status = "1";
        CurDmxlbc.Ma_xlbc = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<int> CheckDeleteListIdAsync(string maXlbc)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmxlbc', '{maXlbc}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }
}
