@page "/hrbp"
@page "/hrbp/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,hrbp")]

<div class="row mt-1" @onkeydown="OnoBrowseKeyDown" tabindex="0">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="25vw"
              MinWidth="300px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="35vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible"
                                 List_ID="@sqlTableName"
                                 Ma_ma="@SqlTableKeyValue"
                                 Title="@Lap["Change HR department code"]"
                                 Ten_item="@Ten_item"
                                 OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="35vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportDM @bind-IsImportPopupVisible="@IsImportPopupVisible"
                             CurDmimex="@CurDmimex"
                             OnImportCompleted="@ImportOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {
    string Ma_dvcs = "";

    protected override void OnInitialized()
    {
        mPage = "hrbp";
        IsShowCopy = true;
        IsShowImport = true;
        Is_doi_ma = true;
        sqlTableName = "DMBPNS";
        sqlTableView = "v_DMBPNS";
        SqlTableKey = "ma_bpns";
        SqlItemName = "ten_bpns";
        FrmType = typeof(SisHr.Pages.List.Hrbp.EditHrbp);

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.dm.01";

        base.OnInitialized();
    }

    public override async Task PageLoad()
    {
        await base.PageLoad();
        // base.PageLoad() có th? ghi ?è Is_doi_ma = false n?u dmdm ch?a c?u hình
        // doi_ma và doi_ma_table ? luôn b?t l?i sau khi base ch?y xong
        Is_doi_ma = true;
        SqlItemName = "ten_bpns";
        sqlTableName = "DMBPNS";
        sqlTableView = "v_DMBPNS";
        SqlTableKey = "ma_bpns";
    }

    public override async void ChangeOK(string newID)
    {
        await Loaddata();
        myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], newID));
        StateHasChanged();
    }

    public override async Task Loaddata()
    {
        Ma_dvcs = myStateMN.GetMa_Dvcs();

        string preFilter = "1=1";

        if (!string.IsNullOrEmpty(Ma_dvcs) && !Ma_dvcs.Equals("ALL"))
        {
            preFilter = $" ma_dvcs LIKE '{Ma_dvcs.Trim()}%'";
        }

        string sql = $"SELECT * FROM {sqlTableView} WHERE {preFilter}";

        try
        {
            System.Data.DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];
                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Loaddata error: " + ex.Message);
        }

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            myStateMN.OnDvcsChanged += OnDvcsChanged;
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async void OnDvcsChanged(string _ma_dvcs)
    {
        await Loaddata();
        StateHasChanged();
    }

    public override async void Dispose()
    {
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
        base.Dispose();
    }
}
