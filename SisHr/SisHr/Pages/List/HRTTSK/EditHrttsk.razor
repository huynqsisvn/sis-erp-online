@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRTTSK

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmttsk"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã tình tr?ng s?c kh?e *@
                <DxFormLayoutItem Caption="@Lap["Health status code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_ttsk_input"
                                   @bind-Text="@CurDmttsk.Ma_ttsk"
                                   maxlength="@tblLength["ma_ttsk"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên tình tr?ng s?c kh?e *@
                <DxFormLayoutItem Caption="@Lap["Health status name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmttsk.Ten_ttsk"
                                   maxlength="@tblLength["ten_ttsk"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên tình tr?ng s?c kh?e 2 *@
                <DxFormLayoutItem Caption="@(Lap["Health status name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmttsk.Ten_ttsk2"
                                   maxlength="@tblLength["ten_ttsk2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmttsk.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmttsk.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmttsk CurDmttsk;
    private string menu_id = "wr.dm.06";

    protected override void OnInitialized()
    {
        sqlTableName = "dmttsk";
        SqlTableKey = "ma_ttsk";
        CheckSqlTableKey = "ma_ttsk";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrttsk" : ParentPage;
        CurDmttsk = new Dmttsk();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_ttsk_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmttsk = new Dmttsk();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmttsk = new Dmttsk();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmttsk.Ma_ttsk);
    }

    async Task SaveDM()
    {
        CurDmttsk.Ma_ttsk = CurDmttsk.Ma_ttsk?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmttsk.Ten_ttsk2 = CurDmttsk.Ten_ttsk2 ?? "";
        CurDmttsk.Ghi_chu = CurDmttsk.Ghi_chu ?? "";

        SqlTableKeyValue = CurDmttsk.Ma_ttsk.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmttsk.Date = DateTime.Now.Date;
            CurDmttsk.Date0 = DateTime.Now.Date;
            CurDmttsk.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmttsk.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmttsk.User_id = curUser.User_id;
                CurDmttsk.User_id0 = curUser.User_id;
                CurDmttsk.User_name = curUser.User_name;
                CurDmttsk.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmttsk.Ma_ttsk.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmttsk>(CurDmttsk, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmttsk.Date = DateTime.Now.Date;
            CurDmttsk.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmttsk.User_id = curUser.User_id;
                CurDmttsk.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmttsk>(CurDmttsk, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmttsk.Ma_ttsk))
        {
            myStateMN.SetNewThongbao(Lap["Health status code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmttsk.Ten_ttsk))
        {
            myStateMN.SetNewThongbao(Lap["Health status name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmttsk> lsdetai = myDb.ConvertDataTable<Dmttsk>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmttsk = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmttsk.Ma_ttsk))
            CurDmttsk.Ma_ttsk = CurDmttsk.Ma_ttsk.Trim();

        if (!string.IsNullOrEmpty(CurDmttsk.Status))
            CurDmttsk.Status = CurDmttsk.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmttsk = new Dmttsk();
        CurDmttsk.Status = "1";
        CurDmttsk.Ma_ttsk = GetNewSttDM();
        CurDmttsk.Ten_ttsk2 = "";
        CurDmttsk.Ghi_chu = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmttsk = new Dmttsk();
        await LoadData(key);
        CurDmttsk.Status = "1";
        CurDmttsk.Ma_ttsk = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<int> CheckDeleteListIdAsync(string maTtsk)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmttsk', '{maTtsk}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }
}
