@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRTPXH

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmtpxh"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã thành ph?n xã h?i *@
                <DxFormLayoutItem Caption="@Lap["Social component code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_tpxh_input"
                                   @bind-Text="@CurDmtpxh.Ma_tpxh"
                                   maxlength="@tblLength["ma_tpxh"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên thành ph?n xã h?i *@
                <DxFormLayoutItem Caption="@Lap["Social component name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtpxh.Ten_tpxh"
                                   maxlength="@tblLength["ten_tpxh"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên thành ph?n xã h?i 2 *@
                <DxFormLayoutItem Caption="@(Lap["Social component name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtpxh.Ten_tpxh2"
                                   maxlength="@tblLength["ten_tpxh2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmtpxh.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmtpxh.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmtpxh CurDmtpxh;
    private string menu_id = "wr.dm.10";

    protected override void OnInitialized()
    {
        sqlTableName = "dmtpxh";
        SqlTableKey = "ma_tpxh";
        CheckSqlTableKey = "ma_tpxh";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrtpxh" : ParentPage;
        CurDmtpxh = new Dmtpxh();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_tpxh_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmtpxh = new Dmtpxh();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmtpxh = new Dmtpxh();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmtpxh.Ma_tpxh);
    }

    async Task SaveDM()
    {
        CurDmtpxh.Ma_tpxh = CurDmtpxh.Ma_tpxh?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmtpxh.Ten_tpxh2 = CurDmtpxh.Ten_tpxh2 ?? "";

        SqlTableKeyValue = CurDmtpxh.Ma_tpxh.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmtpxh.Date = DateTime.Now.Date;
            CurDmtpxh.Date0 = DateTime.Now.Date;
            CurDmtpxh.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmtpxh.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtpxh.User_id = curUser.User_id;
                CurDmtpxh.User_id0 = curUser.User_id;
                CurDmtpxh.User_name = curUser.User_name;
                CurDmtpxh.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmtpxh.Ma_tpxh.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmtpxh>(CurDmtpxh, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmtpxh.Date = DateTime.Now.Date;
            CurDmtpxh.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtpxh.User_id = curUser.User_id;
                CurDmtpxh.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmtpxh>(CurDmtpxh, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmtpxh.Ma_tpxh))
        {
            myStateMN.SetNewThongbao(Lap["Social component code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmtpxh.Ten_tpxh))
        {
            myStateMN.SetNewThongbao(Lap["Social component name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task<int> CheckDeleteListIdAsync(string maTpxh)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmtpxh', '{maTpxh}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmtpxh> lsdetai = myDb.ConvertDataTable<Dmtpxh>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmtpxh = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmtpxh.Ma_tpxh))
            CurDmtpxh.Ma_tpxh = CurDmtpxh.Ma_tpxh.Trim();

        if (!string.IsNullOrEmpty(CurDmtpxh.Status))
            CurDmtpxh.Status = CurDmtpxh.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmtpxh = new Dmtpxh();
        CurDmtpxh.Status = "1";
        CurDmtpxh.Ma_tpxh = GetNewSttDM();
        CurDmtpxh.Ten_tpxh2 = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmtpxh = new Dmtpxh();
        await LoadData(key);
        CurDmtpxh.Status = "1";
        CurDmtpxh.Ma_tpxh = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
