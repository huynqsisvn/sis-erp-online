@page "/hrkn"
@page "/hrkn/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,hrkn")]

<div class="row mt-1" @onkeydown="OnoBrowseKeyDown" tabindex="0">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="40vw"
              MinWidth="500px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible"
                                 List_ID="@sqlTableName"
                                 Ma_ma="@SqlTableKeyValue"
                                 Title="@Lap["Change ability code"]"
                                 Ten_item="@Ten_item"
                                 OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportDM @bind-IsImportPopupVisible="@IsImportPopupVisible"
                             CurDmimex="@CurDmimex"
                             OnImportCompleted="@ImportOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {
    protected override void OnInitialized()
    {
        mPage = "hrkn";
        IsShowCopy = true;
        IsShowImport = true;
        Is_doi_ma = false;
        sqlTableName = "DMKN";
        sqlTableView = "v_DMKN";
        SqlTableKey = "ma_kn";
        SqlItemName = "ten_kn";
        FrmType = typeof(SisHr.Pages.List.HRKN.EditHrkn);

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "wr.dm.21";

        base.OnInitialized();
    }

    public override async Task PageLoad()
    {
        await base.PageLoad();
        
        // B?t ch?c n?ng ??i mã
        Is_doi_ma = true;
        
        // C?u hình b?ng d? li?u
        SqlItemName = "ten_kn";
        sqlTableName = "DMKN";
        sqlTableView = "v_DMKN";
        SqlTableKey = "ma_kn";
        
        // T? ??ng c?p nh?t doi_ma_table trong b?ng dmdm n?u còn tr?ng
        try
        {
            await myDb.ExecuteSqlQueryAsync($@"
                UPDATE dmdm 
                SET doi_ma_table = 'DMKN' 
                WHERE ma_dm = 'DMKN' AND (doi_ma_table IS NULL OR doi_ma_table = '')
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Auto-update doi_ma_table: " + ex.Message);
            // Ti?p t?c m?c dù update th?t b?i
        }
    }

    public override async void ChangeOK(string newID)
    {
        await Loaddata();
        myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], newID));
        StateHasChanged();
    }

    public override async Task Loaddata()
    {
        string sql = $"SELECT * FROM {sqlTableView}";

        try
        {
            System.Data.DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];
                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Loaddata error: " + ex.Message);
        }

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            myStateMN.OnDvcsChanged += OnDvcsChanged;
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async void OnDvcsChanged(string _ma_dvcs)
    {
        await Loaddata();
        StateHasChanged();
    }

    public override async void Dispose()
    {
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
        base.Dispose();
    }
}
