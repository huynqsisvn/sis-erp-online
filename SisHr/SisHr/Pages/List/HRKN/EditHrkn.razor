@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRKN

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <DxTabs @ref="TabsRef" ActiveTabIndex="@ActiveTabIndex">
            @* TAB 1: THÔNG TIN CHÍNH *@
            <DxTabPage Text="@Lap["Main info"]">
                <div class="row m-1 me-2 rounded-1 border border-light shadow">
                    <DxFormLayout Data="@CurDmkn"
                                  ItemSizeMode="@Itemsizemode"
                                  CssClass="frm-header sis-form"
                                  onkeydown="ModifyEnterKeyPressAsTab(event);">

                        @* 1. Mã KN *@
                        <DxFormLayoutItem Caption="@Lap["Ability code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                            <Template>
                                <DxTextBox Id="ma_kn_input"
                                           @bind-Text="@CurDmkn.Ma_kn"
                                           maxlength="@tblLength["ma_kn"]"
                                           InputCssClass="uppercase"
                                           Enabled="@AllowEditMa" />
                            </Template>
                        </DxFormLayoutItem>

                        @* 2. Tên KN *@
                        <DxFormLayoutItem Caption="@Lap["Ability name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Ten_kn"
                                           maxlength="@tblLength["ten_kn"]"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        @* 3. Tên KN 2 *@
                        <DxFormLayoutItem Caption="@(Lap["Ability name"] + " 2")" ColSpanMd="12" BeginRow="true">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Ten_kn2"
                                           maxlength="@tblLength["ten_kn2"]"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        @* 4. Ghi chú *@
                        <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                            <Template>
                                <DxMemo @bind-Text="@CurDmkn.Ghi_chu"
                                        Rows="3"
                                        Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        @* 5. Tr?ng thái *@
                        <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxComboBox Enabled="@AllowEditMode"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                            Data="LSStatus"
                                            TextFieldName="Ten"
                                            ValueFieldName="Ma"
                                            @bind-Value="@CurDmkn.Status">
                                    <Columns>
                                        <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                        <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                                    </Columns>
                                </DxComboBox>
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="" ColSpanMd="6">
                            <Template>
                                <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanMd="12">
                            <Template>
                                <hr />
                            </Template>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </div>
            </DxTabPage>

            @* TAB 2: TÀI LI?U *@
            <DxTabPage Text="@Lap["Document"]">
                <div class="row m-1 me-2 rounded-1 border border-light shadow">
                    <DxFormLayout Data="@CurDmkn"
                                  ItemSizeMode="@Itemsizemode"
                                  CssClass="frm-header sis-form"
                                  onkeydown="ModifyEnterKeyPressAsTab(event);">

                        @* TÀI LI?U 1 *@
                        <DxFormLayoutItem Caption="@Lap["Document code 1"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Ma_td1"
                                           maxlength="@(tblLength.ContainsKey("ma_td1") ? tblLength["ma_td1"] : 50)"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document date 1"]" ColSpanMd="6" BeginRow="false">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmkn.Ngay_td1"
                                            Enabled="@AllowEditMode"
                                            ShowTime="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document quantity 1"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmkn.Sl_td1"
                                            Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document note 1"]" ColSpanMd="6" BeginRow="false">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Gc_td1"
                                           maxlength="@(tblLength.ContainsKey("gc_td1") ? tblLength["gc_td1"] : 500)"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanMd="12">
                            <Template>
                                <hr />
                            </Template>
                        </DxFormLayoutItem>

                        @* TÀI LI?U 2 *@
                        <DxFormLayoutItem Caption="@Lap["Document code 2"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Ma_td2"
                                           maxlength="@(tblLength.ContainsKey("ma_td2") ? tblLength["ma_td2"] : 50)"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document date 2"]" ColSpanMd="6" BeginRow="false">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmkn.Ngay_td2"
                                            Enabled="@AllowEditMode"
                                            ShowTime="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document quantity 2"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmkn.Sl_td2"
                                            Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document note 2"]" ColSpanMd="6" BeginRow="false">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Gc_td2"
                                           maxlength="@(tblLength.ContainsKey("gc_td2") ? tblLength["gc_td2"] : 500)"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanMd="12">
                            <Template>
                                <hr />
                            </Template>
                        </DxFormLayoutItem>

                        @* TÀI LI?U 3 *@
                        <DxFormLayoutItem Caption="@Lap["Document code 3"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Ma_td3"
                                           maxlength="@(tblLength.ContainsKey("ma_td3") ? tblLength["ma_td3"] : 50)"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document date 3"]" ColSpanMd="6" BeginRow="false">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmkn.Ngay_td3"
                                            Enabled="@AllowEditMode"
                                            ShowTime="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document quantity 3"]" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmkn.Sl_td3"
                                            Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Document note 3"]" ColSpanMd="6" BeginRow="false">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmkn.Gc_td3"
                                           maxlength="@(tblLength.ContainsKey("gc_td3") ? tblLength["gc_td3"] : 500)"
                                           Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanMd="12">
                            <Template>
                                <hr />
                            </Template>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </div>
            </DxTabPage>
        </DxTabs>
    </FormList>
</div>

@code {
    public Dmkn CurDmkn;
    private string menu_id = "wr.dm.21";
    private DxTabs TabsRef;
    private int ActiveTabIndex = 0;

    protected override void OnInitialized()
    {
        sqlTableName = "DMKN";
        SqlTableKey = "ma_kn";
        CheckSqlTableKey = "ma_kn";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrkn" : ParentPage;
        CurDmkn = new Dmkn();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_kn_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string key)
    {
        CurDmkn = new Dmkn();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmkn = new Dmkn();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmkn.Ma_kn);
    }

    async Task SaveDM()
    {
        CurDmkn.Ma_kn = CurDmkn.Ma_kn?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmkn.Ma_kn.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmkn.Date = DateTime.Now.Date;
            CurDmkn.Date0 = DateTime.Now.Date;
            CurDmkn.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmkn.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmkn.User_id = curUser.User_id;
                CurDmkn.User_id0 = curUser.User_id;
                CurDmkn.User_name = curUser.User_name;
                CurDmkn.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmkn.Ma_kn.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmkn>(CurDmkn, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmkn.Date = DateTime.Now.Date;
            CurDmkn.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmkn.User_id = curUser.User_id;
                CurDmkn.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmkn>(CurDmkn, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmkn.Ma_kn))
        {
            myStateMN.SetNewThongbao(Lap["Ability code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmkn.Ten_kn))
        {
            myStateMN.SetNewThongbao(Lap["Ability name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task<int> CheckDeleteListIdAsync(string maKn)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'DMKN', '{maKn}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet dsTrans = await myDb.LoadDataset(sql);
        if (dsTrans != null && dsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmkn> lsdetai = myDb.ConvertDataTable<Dmkn>(dsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmkn = lsdetai[0];
            }
        }
    }

    async Task CreateNewDM()
    {
        CurDmkn = new Dmkn();
        CurDmkn.Status = "1";
        CurDmkn.Ma_kn = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmkn = new Dmkn();
        await LoadData(key);
        CurDmkn.Status = "1";
        CurDmkn.Ma_kn = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
