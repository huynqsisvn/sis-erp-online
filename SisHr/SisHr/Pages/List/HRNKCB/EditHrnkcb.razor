@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRNKCB

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmnkcb"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã NKCB *@
                <DxFormLayoutItem Caption="@Lap["Medical facility code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_nkcb_input"
                                   @bind-Text="@CurDmnkcb.Ma_nkcb"
                                   maxlength="@tblLength["ma_nkcb"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên NKCB *@
                <DxFormLayoutItem Caption="@Lap["Medical facility name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmnkcb.Ten_nkcb"
                                   maxlength="@tblLength["ten_nkcb"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên NKCB 2 *@
                <DxFormLayoutItem Caption="@(Lap["Medical facility name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmnkcb.Ten_nkcb2"
                                   maxlength="@tblLength["ten_nkcb2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmnkcb.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmnkcb.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmnkcb CurDmnkcb;
    private string menu_id = "wr.dm.16";

    protected override void OnInitialized()
    {
        sqlTableName = "DMNKCB";
        SqlTableKey = "ma_nkcb";
        CheckSqlTableKey = "ma_nkcb";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrnkcb" : ParentPage;
        CurDmnkcb = new Dmnkcb();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_nkcb_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string key)
    {
        CurDmnkcb = new Dmnkcb();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmnkcb = new Dmnkcb();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmnkcb.Ma_nkcb);
    }

    async Task SaveDM()
    {
        CurDmnkcb.Ma_nkcb = CurDmnkcb.Ma_nkcb?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmnkcb.Ma_nkcb.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmnkcb.Date = DateTime.Now.Date;
            CurDmnkcb.Date0 = DateTime.Now.Date;
            CurDmnkcb.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmnkcb.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmnkcb.User_id = curUser.User_id;
                CurDmnkcb.User_id0 = curUser.User_id;
                CurDmnkcb.User_name = curUser.User_name;
                CurDmnkcb.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmnkcb.Ma_nkcb.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmnkcb>(CurDmnkcb, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmnkcb.Date = DateTime.Now.Date;
            CurDmnkcb.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmnkcb.User_id = curUser.User_id;
                CurDmnkcb.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmnkcb>(CurDmnkcb, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmnkcb.Ma_nkcb))
        {
            myStateMN.SetNewThongbao(Lap["Medical facility code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmnkcb.Ten_nkcb))
        {
            myStateMN.SetNewThongbao(Lap["Medical facility name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task<int> CheckDeleteListIdAsync(string maNkcb)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'DMNKCB', '{maNkcb}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet dsTrans = await myDb.LoadDataset(sql);
        if (dsTrans != null && dsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmnkcb> lsdetai = myDb.ConvertDataTable<Dmnkcb>(dsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmnkcb = lsdetai[0];
            }
        }
    }

    async Task CreateNewDM()
    {
        CurDmnkcb = new Dmnkcb();
        CurDmnkcb.Status = "1";
        CurDmnkcb.Ma_nkcb = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmnkcb = new Dmnkcb();
        await LoadData(key);
        CurDmnkcb.Status = "1";
        CurDmnkcb.Ma_nkcb = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
