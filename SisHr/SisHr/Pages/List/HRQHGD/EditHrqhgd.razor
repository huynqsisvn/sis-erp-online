@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRQHGD

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmqhgd"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã quan h? gia ?ình *@
                <DxFormLayoutItem Caption="@Lap["Family relation code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_qhgd_input"
                                   @bind-Text="@CurDmqhgd.Ma_qhgd"
                                   maxlength="@tblLength["ma_qhgd"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên quan h? gia ?ình *@
                <DxFormLayoutItem Caption="@Lap["Family relation name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmqhgd.Ten_qhgd"
                                   maxlength="@tblLength["ten_qhgd"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên quan h? gia ?ình 2 *@
                <DxFormLayoutItem Caption="@(Lap["Family relation name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmqhgd.Ten_qhgd2"
                                   maxlength="@tblLength["ten_qhgd2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmqhgd.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmqhgd.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmqhgd CurDmqhgd;
    private string menu_id = "wr.dm.13";

    protected override void OnInitialized()
    {
        sqlTableName = "dmqhgd";
        SqlTableKey = "ma_qhgd";
        CheckSqlTableKey = "ma_qhgd";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrqhgd" : ParentPage;
        CurDmqhgd = new Dmqhgd();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_qhgd_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmqhgd = new Dmqhgd();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmqhgd = new Dmqhgd();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmqhgd.Ma_qhgd);
    }

    async Task SaveDM()
    {
        CurDmqhgd.Ma_qhgd = CurDmqhgd.Ma_qhgd?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmqhgd.Ten_qhgd2 = CurDmqhgd.Ten_qhgd2 ?? "";
        CurDmqhgd.Ghi_chu = CurDmqhgd.Ghi_chu ?? "";

        SqlTableKeyValue = CurDmqhgd.Ma_qhgd.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmqhgd.Date = DateTime.Now.Date;
            CurDmqhgd.Date0 = DateTime.Now.Date;
            CurDmqhgd.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmqhgd.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmqhgd.User_id = curUser.User_id;
                CurDmqhgd.User_id0 = curUser.User_id;
                CurDmqhgd.User_name = curUser.User_name;
                CurDmqhgd.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmqhgd.Ma_qhgd.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmqhgd>(CurDmqhgd, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmqhgd.Date = DateTime.Now.Date;
            CurDmqhgd.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmqhgd.User_id = curUser.User_id;
                CurDmqhgd.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmqhgd>(CurDmqhgd, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmqhgd.Ma_qhgd))
        {
            myStateMN.SetNewThongbao(Lap["Family relation code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmqhgd.Ten_qhgd))
        {
            myStateMN.SetNewThongbao(Lap["Family relation name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmqhgd> lsdetai = myDb.ConvertDataTable<Dmqhgd>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmqhgd = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmqhgd.Ma_qhgd))
            CurDmqhgd.Ma_qhgd = CurDmqhgd.Ma_qhgd.Trim();

        if (!string.IsNullOrEmpty(CurDmqhgd.Status))
            CurDmqhgd.Status = CurDmqhgd.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmqhgd = new Dmqhgd();
        CurDmqhgd.Status = "1";
        CurDmqhgd.Ma_qhgd = GetNewSttDM();
        CurDmqhgd.Ten_qhgd2 = "";
        CurDmqhgd.Ghi_chu = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmqhgd = new Dmqhgd();
        await LoadData(key);
        CurDmqhgd.Status = "1";
        CurDmqhgd.Ma_qhgd = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<int> CheckDeleteListIdAsync(string maQhgd)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmqhgd', '{maQhgd}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }
}
