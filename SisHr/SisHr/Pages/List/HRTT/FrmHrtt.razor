@page "/frmhrtt"
@page "/frmhrtt/{menu_id}"
@page "/frmhrtt/{menu_id}/{ma_tinhthanh}"
@inject Statemanagerment myStatemanagerment
@inject NavigationManager navigation
@inject IDbManager myDb
@inject IJSRuntime JavacriptS

<DxPopup @bind-Visible="@PopVisible"
         ShowFooter="false"
         ShowHeader="false"
         CloseOnEscape="false"
         CloseOnOutsideClick="false"
         ShowCloseButton="false"
         Width="auto"
         MinWidth="600px"
         MinHeight="200px"
         MaxHeight="98vh"
         AllowResize="true"
         AllowDrag="true"
         AllowDragByHeaderOnly="true">
    <BodyTemplate>
        <div class="row">
            <EditHrtt Ma_ma="@ma_tinhthanh"
                      Menu_id="@menu_id"
                      curActionTask="@curActionTask"
                      ShowAdd="@ShowAdd"
                      OnClose="ClickHandler" />
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string menu_id { get; set; }
    [Parameter] public string ma_tinhthanh { get; set; }
    [Parameter] public ActionTask curActionTask { get; set; } = ActionTask.None;
    [Parameter] public bool ShowAdd { get; set; }

    public bool PopVisible { get; set; } = true;

    protected override void OnInitialized()
    {
        if (curActionTask == ActionTask.None)
            curActionTask = myStatemanagerment.GetCurrentActionTask();
    }

    private void ClickHandler()
    {
        PopVisible = false;
        OnClose.InvokeAsync();
    }
}
