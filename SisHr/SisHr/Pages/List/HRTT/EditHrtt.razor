@inherits FrmListBaseComponent
@using SisHr.Pages.List.HRTT

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmtinhthanh"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* 1. Mã t?nh thành *@
                <DxFormLayoutItem Caption="@Lap["Province/city code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_tinhthanh_input"
                                   @bind-Text="@CurDmtinhthanh.Ma_tinhthanh"
                                   maxlength="@tblLength["ma_tinhthanh"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                @* 2. Tên t?nh thành *@
                <DxFormLayoutItem Caption="@Lap["Province/city name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtinhthanh.Ten_tinhthanh"
                                   maxlength="@tblLength["ten_tinhthanh"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 3. Tên t?nh thành 2 *@
                <DxFormLayoutItem Caption="@(Lap["Province/city name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtinhthanh.Ten_tinhthanh2"
                                   maxlength="@tblLength["ten_tinhthanh2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 4. Ghi chú *@
                <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxMemo @bind-Text="@CurDmtinhthanh.Ghi_chu"
                                Rows="3"
                                Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                @* 5. Tr?ng thái *@
                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="6" BeginRow="true">
                    <Template>
                        <DxComboBox Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Data="LSStatus"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    @bind-Value="@CurDmtinhthanh.Status">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="" ColSpanMd="6">
                    <Template>
                        <span class="text-muted">@Lap["0 - No, 1 - Yes"]</span>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmtinhthanh CurDmtinhthanh;
    private string menu_id = "wr.dm.09";

    protected override void OnInitialized()
    {
        sqlTableName = "dmtinhthanh";
        SqlTableKey = "ma_tinhthanh";
        CheckSqlTableKey = "ma_tinhthanh";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "hrtt" : ParentPage;
        CurDmtinhthanh = new Dmtinhthanh();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_tinhthanh_input')?.focus()");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async Task ViewDM(string key)
    {
        CurDmtinhthanh = new Dmtinhthanh();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(key);
        StateHasChanged();
    }

    async Task EditDM(string key)
    {
        CurDmtinhthanh = new Dmtinhthanh();
        AllowEditMode = true;
        AllowEditMa = false;
        await LoadData(key);

        int checkResult = await CheckDeleteListIdAsync(key);
        if (checkResult <= 0)
        {
            AllowEditMa = false;
        }

        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmtinhthanh.Ma_tinhthanh);
    }

    async Task SaveDM()
    {
        CurDmtinhthanh.Ma_tinhthanh = CurDmtinhthanh.Ma_tinhthanh?.ToUpper().Trim().Replace(" ", "") ?? "";
        if (!CheckValid())
            return;

        CurDmtinhthanh.Ten_tinhthanh2 = CurDmtinhthanh.Ten_tinhthanh2 ?? "";
        CurDmtinhthanh.Ghi_chu = CurDmtinhthanh.Ghi_chu ?? "";

        SqlTableKeyValue = CurDmtinhthanh.Ma_tinhthanh.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmtinhthanh.Date = DateTime.Now.Date;
            CurDmtinhthanh.Date0 = DateTime.Now.Date;
            CurDmtinhthanh.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmtinhthanh.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtinhthanh.User_id = curUser.User_id;
                CurDmtinhthanh.User_id0 = curUser.User_id;
                CurDmtinhthanh.User_name = curUser.User_name;
                CurDmtinhthanh.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmtinhthanh.Ma_tinhthanh.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Code [{0}] already exists !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmtinhthanh>(CurDmtinhthanh, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmtinhthanh.Date = DateTime.Now.Date;
            CurDmtinhthanh.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtinhthanh.User_id = curUser.User_id;
                CurDmtinhthanh.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmtinhthanh>(CurDmtinhthanh, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmtinhthanh.Ma_tinhthanh))
        {
            myStateMN.SetNewThongbao(Lap["Province/city code is required"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmtinhthanh.Ten_tinhthanh))
        {
            myStateMN.SetNewThongbao(Lap["Province/city name is required"] + " !");
            StateHasChanged();
            return false;
        }

        return true;
    }

    async Task LoadData(string key)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + key + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmtinhthanh> lsdetai = myDb.ConvertDataTable<Dmtinhthanh>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmtinhthanh = lsdetai[0];
        }

        if (!string.IsNullOrEmpty(CurDmtinhthanh.Ma_tinhthanh))
            CurDmtinhthanh.Ma_tinhthanh = CurDmtinhthanh.Ma_tinhthanh.Trim();

        if (!string.IsNullOrEmpty(CurDmtinhthanh.Status))
            CurDmtinhthanh.Status = CurDmtinhthanh.Status.Trim();

        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmtinhthanh = new Dmtinhthanh();
        CurDmtinhthanh.Status = "1";
        CurDmtinhthanh.Ma_tinhthanh = GetNewSttDM();
        CurDmtinhthanh.Ten_tinhthanh2 = "";
        CurDmtinhthanh.Ghi_chu = "";
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string key)
    {
        CurDmtinhthanh = new Dmtinhthanh();
        await LoadData(key);
        CurDmtinhthanh.Status = "1";
        CurDmtinhthanh.Ma_tinhthanh = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<int> CheckDeleteListIdAsync(string maTinhthanh)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmtinhthanh', '{maTinhthanh}'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                result = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckDeleteListIdAsync error: " + ex.Message);
        }
        return result;
    }
}
