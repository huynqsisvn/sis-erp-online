
@page "/Poctpna"
@page "/Poctpna/{Menu_id}"
@inherits TransBaseComponent
@attribute [Authorize(Roles = "admin,poctpna")]

@if (ShowLoaddingVoucher)
{
    <DxLoadingPanel IndicatorAnimationType="WaitIndicatorAnimationType.Pulse"
                    CssClass="w-100"
                    IndicatorVisible="true"
                    IndicatorAreaVisible="true"
                    Visible="true"
                    Text="Processing..."
                    TextAlignment="LoadingPanelTextAlignment.Right">
        <div style="min-height: 250px;"></div>
    </DxLoadingPanel>
}
else if (TblPH != null)
{
    <div class="row mt-1">
        <FrmBrowseComponent @ref="@oBrowsePH" TblData="@TblPH" Page_size="@pageSize" IsPageSize="@IsPageSize" CssClass="grid-frm-height" Fbrowse="@FbrowsePH" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
    <hr style="height:1px;background-color:dimgrey;margin:1px;padding:0px;">
    <div class="row mt-1">
        <h8 class="fw-bold bg-light text-warning rounded-pill mx-3"> @Lap["Detail"] </h8>
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblCT" CssClass="grid-frmct-height" Fbrowse="@FbrowseCT" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}
<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@popFilterVisible"
         Width="500px"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 5rem; height:5rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container pt-1">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From number"]">
                        <DxTextBox CssClass="col" @bind-Text="@So_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idTu_so" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To number"]">
                        <DxTextBox CssClass="col" @bind-Text="@So_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idDen_so" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Book code"]">
                        <Template>
                            <AutocompleteComponent CssClass="col p-0" Ma_dm="dmqs" @bind-Value="@Ma_qs" Filter="@_filter_qs" IsLangEn="@IsLangEn"></AutocompleteComponent>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Customer code"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmkh_thue" @bind-Value="@Ma_kh" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Account"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmtk1" @bind-Value="@Tk_i" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Status"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmpost" Filter="@filter_status" @bind-Value="@Status" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Dvcs code"]">
                        <DxTextBox CssClass="col" @bind-Text="@Ma_dvcs" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idMa_dvcs"></DxTextBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Filter by user"]">
                        <DxTextBox CssClass="col" @bind-Text="@NSD" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idNSD" />
                    </DxFormLayoutItem>

                </DxFormLayout>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col mx-4" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnFilterOK" />
                <DxButton CssClass="col " RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnFilterCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>
@if (IsShowFrm && FrmType != null)
{
    <DxPopup @bind-Visible="@IsShowFrm" CloseOnEscape="true" Width="68vw" Height="700px" CloseOnOutsideClick="false" CssClass="small-header-popup"
             MinWidth="700px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
             MinHeight="500px" Scrollable="true"
             MaxHeight="99vh"
             AllowResize="true"
             AllowDrag="true" ShowCloseButton="false"
             AllowDragByHeaderOnly="true"
             ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxPopup>
}
@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportCT CurDmimex="@CurDmimex" Menu_id="@Menu_id" @bind-IsImportPopupVisible="@IsImportPopupVisible" OnImportCompleted="@ImportOK" ShowError="@ShowError_PNA" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

<style>
    .grid-frm-height {
        height: 55vh;
    }

    .grid-frmct-height {
        height: 30vh;
    }
</style>

@code {
    public string Ma_kh = "";
    public string Ma_qs = "";
    public string Ghi_no_co = "";
    public string Tk_i = "";
    public string Status = "";
    public string Ps_no = "";
    public string Ps_co = "";
    public string So_ct1 = "";
    public string So_ct2 = "";
    public string Ma_dvcs = "";
    public string NSD = "";

    string _filter_gd = "";

    string _filter_qs = "";
    string filter_status = "ma_ct like '%PNA%' and status = 1 ";
    protected override void OnInitialized()
    {
        Menu_id = (String.IsNullOrEmpty(Menu_id) ? "wp.ct.05" : Menu_id);
        FrmType = typeof(Input.Poctpna.FrmPoctpna);
        IsShowImport = true;
        LanguageID = "";
        _filter_qs = String.Format("ma_cts like '%{0}%'", "PNA");
        _filter_gd = String.Format("ma_ct like '%{0}%' and [status] = 1", "PNA");

        base.OnInitialized();
    }
    private async void BtnFilterOK()
    {
        ShowLoadding = true;

        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);
        string dvcs = myStateMN.GetMa_Dvcs();
        phFilter = "1=1";
        ctFilter = "1=1";

        if (!string.IsNullOrEmpty(Ma_dvcs))
        {
            phFilter = phFilter + " AND ma_dvcs LIKE ''" + Ma_dvcs.Trim() + "%''";
        }
        if (string.IsNullOrEmpty(Ma_dvcs))
        {
            if (dvcs != "ALL")
            {
                phFilter = phFilter + " AND ma_dvcs LIKE ''" + dvcs.Trim() + "%''";
            }
        }
        if (Ngay_ct1 != null)
        {
            phFilter = phFilter + " AND ngay_ct >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            phFilter = phFilter + " AND ngay_ct <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }
        if (!String.IsNullOrEmpty(So_ct1))
        {
            phFilter = phFilter + " AND so_ct >= ''" + So_ct1.ToString() + "''";
        }
        if (!String.IsNullOrEmpty(So_ct2))
        {
            phFilter = phFilter + " AND so_ct <= ''" + So_ct2.ToString() + "''";
        }

        if (!String.IsNullOrEmpty(Ma_qs))
        {
            phFilter = phFilter + " AND ma_qs LIKE ''" + Ma_qs.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Status))
        {
            phFilter = phFilter + " AND status  LIKE ''" + Status.Trim() + "%''";
        }

        if (!String.IsNullOrEmpty(Tk_i))
        {
            ctFilter = ctFilter + " AND ma_nx  LIKE ''" + Tk_i.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(NSD) && NSD.Trim().Equals("1"))
        {
            phFilter = phFilter + " AND user_id  = " + curUser.User_id + " ";
        }
        if (!String.IsNullOrEmpty(Ma_kh))
        {
            phFilter = phFilter + " AND ma_kh LIKE ''" + Ma_kh.Trim() + "%''";
        }

        await Loaddata(false);

        ShowLoadding = false;
        popFilterVisible = false;
        InvokeAsync(StateHasChanged);
    }

    public override async void V_In()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }


        DataSet DataSource = CopyVoucherToDataSet(SqlTableKeyValue);


        string tk_no = "";
        string tk_co = "";
        var uniqueTk = new HashSet<string>();

        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<PNGModel>();
            PNGModel _curModel = new PNGModel();
            _curModel.Ten_cty = myOption.GetOptionsValue("M_TEN_CTY").Trim();
            _curModel.Dia_chi_cty = myOption.GetOptionsValue("M_DIA_CHI").Trim();
            _curModel.Ma_so_thue_cty = myOption.GetOptionsValue("M_MA_THUE").Trim();
            _curModel.Dien_thoai_cty = myOption.GetOptionsValue("M_PHONE").Trim();
            _curModel.LSPh = myDb.ConvertDataTable<Ph71>(DataSource.Tables[0]);
            string strnh = myDb.GetValue("SELECT tk_nh + '#' + ten_nh FROM dmkh WHERE ma_kh = '" + _curModel.LSPh[0].Ma_kh.Trim() + "'").ToString();            

            _curModel.LSCt = myDb.ConvertDataTable<Ct71>(DataSource.Tables[1]).OrderBy(x => x.Stt_rec0).ToList();
            _curModel.LSCtgt = myDb.ConvertDataTable<Ct71gt>(DataSource.Tables[2]).OrderBy(x => x.Stt_rec0).ToList();

            for (int i = 0; i < _curModel.LSCt.Count; i++)
            {
                string ma = _curModel.LSCt[i].Tk_vt?.Trim();
                if (string.IsNullOrEmpty(ma)) continue;

                if (uniqueTk.Add(ma)) // chỉ thêm nếu chưa có
                {
                    tk_no += ma + "\n";
                }
                _curModel.LSCt[i].Ma_nx = _curModel.LSPh[0].Ma_nx;
                _curModel.LSCt[i].Stt = i + 1;
            }
            
            _curModel.TotalString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tien0, myOption, myDb, IsLangEn);
            _curModel.TotalTTString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tt, myOption, myDb, IsLangEn);
            _curModel.TotalStringNT = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt0, myOption, myDb, IsLangEn);
            _curModel.TotalTTStringNT = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tt_nt, myOption, myDb, IsLangEn);
            _curModel.Ten_lien = "Liên 1 : giao khách hàng";
            _curModel.So_lien = curDmct.So_lien;
            _curModel.Ma_kho = _curModel.LSCt.Max(x => x.Ma_kho_i);
            _curModel.Ma_kho = _curModel.Ma_kho.Trim() + " - " + myDb.GetValue("dmkho", IsLangEn?"ten_kho2": "ten_kho", "ma_kho='" +_curModel.Ma_kho.Trim()+"'").ToString().Trim();
            _curModel.NgayString = ToDateString(_curModel.LSPh[0].Ngay_ct);
            _curModel.TknoString = tk_no;
            LSData.Add(_curModel);
        }
        ShowReport(LSData, typeof(PNGModel));
    }
    public string ToDateString(DateTime date)
    {
        return $"ngày {date.Day} tháng {date.Month} năm {date.Year}";
    }
   
    private bool ShowError_PNA(DataErrArgs Args)
    {
        DataSet dsError = Args.DataErr;
        bool result = true;
        foreach (DataTable table in dsError.Tables)
        {
            if (table.Rows.Count != 0)
            {
                switch (table.Columns[0].ColumnName)
                {
                    case "ma_kh":
                        if (!IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh:H=Mã ncc", "Danh sách mã ncc không có trong danh mục ncc");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh:H=Supplier ID", "List the client code is not in the list of Suppliers");
                        }
                        result = false;
                        break;
                    case "ma_kh1":
                        if (!IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh1:H=Mã ncc;ma_dvcs:H=Mã ĐVCS", "Danh sách mã ncc không thuộc ĐVCS");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh1:H=Supplier ID;ma_dvcs:H=Unit code", "List the client code is invalid");
                        }
                        result = false;
                        break;
                    case "ma_kh_thue":
                        if (!IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh_thue:H=Mã ncc(Hđ thuế);ma_dvcs:H=Mã ĐVCS", "Danh sách mã ncc không có trong danh mục ncc hoặc không thuộc ĐVCS");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh_thue:H=Supplier ID (tax);ma_dvcs:H=Unit code", "List the client code is not in the list of Suppliers or not in Unit");
                        }
                        result = false;
                        break;
                    case "ma_nx":
                        if (!IsLangEn)
                        {
                            DisplayErrorData(table, "ma_nx:H= Mã nx(Tk có);ten_tk:H=Tên mã nx (tk có)", "Danh sách mã nx(tk có) không có trong danh mục tài khoản hoặc là tài khoản tổng hợp");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_nx:H=Dr./Cr. account (Account credit);ten_tk:H=Dr./Cr. Name", "List of import export code (account debt) is not in the list of accounts or the consolidated accounts");
                        }
                        result = false;
                        break;
                    case "ma_ms":
