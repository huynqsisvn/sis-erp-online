    string filter_status = "ma_ct like '%PN1%' and status = 1 ";
    protected override void OnInitialized()
    {
        Menu_id = (String.IsNullOrEmpty(Menu_id) ? "wp.ct.06" : Menu_id);
        FrmType = typeof(Input.Apctpn1.FrmApctpn1);
        IsShowImport = true;
        LanguageID = "";
        _filter_qs = String.Format("ma_cts like '%{0}%'", "PN1");
        _filter_gd = String.Format("ma_ct like '%{0}%' and [status] = 1", "PN1");

        base.OnInitialized();
    }
    private async void BtnFilterOK()
    {
        ShowLoadding = true;

        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);
        string dvcs = myStateMN.GetMa_Dvcs();
        phFilter = "1=1";
        ctFilter = "1=1";

        if (!string.IsNullOrEmpty(Ma_dvcs))
        {
            phFilter = phFilter + " AND ma_dvcs LIKE ''" + Ma_dvcs.Trim() + "%''";
        }
        if (string.IsNullOrEmpty(Ma_dvcs))
        {
            if (dvcs != "ALL")
            {
                phFilter = phFilter + " AND ma_dvcs LIKE ''" + dvcs.Trim() + "%''";
            }
        }
        if (Ngay_ct1 != null)
        {
            phFilter = phFilter + " AND ngay_ct >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            phFilter = phFilter + " AND ngay_ct <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }
        if (!String.IsNullOrEmpty(So_ct1))
        {
            phFilter = phFilter + " AND so_ct >= ''" + So_ct1.ToString() + "''";
        }
        if (!String.IsNullOrEmpty(So_ct2))
        {
            phFilter = phFilter + " AND so_ct <= ''" + So_ct2.ToString() + "''";
        }

        if (!String.IsNullOrEmpty(Ma_qs))
        {
            phFilter = phFilter + " AND ma_qs LIKE ''" + Ma_qs.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Status))
        {
            phFilter = phFilter + " AND status  LIKE ''" + Status.Trim() + "%''";
        }
      
        if (!String.IsNullOrEmpty(Tk_i))
        {
            ctFilter = ctFilter + " AND ma_nx  LIKE ''" + Tk_i.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(NSD) && NSD.Trim().Equals("1"))
        {
            phFilter = phFilter + " AND user_id  = " + curUser.User_id + " ";
        }
        if (!String.IsNullOrEmpty(Ma_kh))
        {
            phFilter = phFilter + " AND ma_kh LIKE ''" + Ma_kh.Trim() + "%''";
        }

        await Loaddata(false);

        ShowLoadding = false;
        popFilterVisible = false;
        InvokeAsync(StateHasChanged);
    }

    public override async void V_In()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }

        DataSet DataSource = CopyVoucherToDataSet(SqlTableKeyValue);

        if (DataSource != null && DataSource.Tables.Count > 0)
        {

            LSData = new List<PN1Model>();
            PN1Model _curModel = new PN1Model();
            _curModel.Ten_cty = myOption.GetOptionsValue("M_TEN_CTY").Trim();
            _curModel.Dia_chi_cty = myOption.GetOptionsValue("M_DIA_CHI").Trim();
            _curModel.Ma_so_thue_cty = myOption.GetOptionsValue("M_MA_THUE").Trim();
            _curModel.Dien_thoai_cty = myOption.GetOptionsValue("M_PHONE").Trim();
            _curModel.LSPh = myDb.ConvertDataTable<Ph31>(DataSource.Tables[0]);
            string strnh = myDb.GetValue("SELECT tk_nh + '#' + ten_nh FROM dmkh WHERE ma_kh = '" + _curModel.LSPh[0].Ma_kh.Trim() + "'").ToString();            

            _curModel.LSCt = myDb.ConvertDataTable<Ct31>(DataSource.Tables[1]).OrderBy(x => x.Stt_rec0).ToList();
            for (int i = 0; i < _curModel.LSCt.Count; i++)
            {
                _curModel.LSCt[i].Stt = i + 1;
            }
            
            _curModel.TotalTTString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tt, myOption, myDb, IsLangEn);            
            _curModel.So_lien = curDmct.So_lien;
            _curModel.NgayString = ToDateString(_curModel.LSPh[0].Ngay_ct);

            String sql = $"SELECT tk,dien_giai,ps_no ,ps_co FROM ct00 WHERE stt_rec = '{_curModel.LSPh[0].Stt_rec}' order by nh_dk,stt_rec0";            
            DataSet ds = myDb.LoadDataSet(sql);
            // DataTable ds = AddTbTkPs(DataSource.Tables[0].Rows[0]["stt_rec"].ToString());

            List<HachToan> lstHachToan = new List<HachToan>();
            decimal total_ps_no = 0;
            decimal total_ps_co = 0;
            if (ds != null && ds.Tables.Count > 0)
            {
                decimal t_ps_no = 0;
                decimal t_ps_co = 0;
                int stt = 0;
                foreach (DataRow dr in ds.Tables[0].Rows)
                {
                    HachToan hachToan = new HachToan();
                    hachToan.Tk = dr["tk"].ToString();
                    hachToan.Ps_no = decimal.Parse(dr["ps_no"].ToString());
                    hachToan.Ps_co = decimal.Parse(dr["ps_co"].ToString());
                    hachToan.Stt = stt;
                    hachToan.Dien_giai = dr["dien_giai"].ToString();
                    stt++;
                    total_ps_no += hachToan.Ps_no;
                    total_ps_co += hachToan.Ps_co;
                    lstHachToan.Add(hachToan);
                    t_ps_co += hachToan.Ps_co;
                    t_ps_no += hachToan.Ps_no;

                }
                _curModel.T_ps_no = total_ps_no;
                _curModel.T_ps_co = total_ps_co;
                if (lstHachToan.Count > 0)
                    _curModel.TotalString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, IsLangEn);
            }
            _curModel.LSTkPs = lstHachToan;
            LSData.Add(_curModel);
        }
        ShowReport(LSData, typeof(PN1Model));
    }

    public DataTable AddTbTkPs(string sttrec)
    {
        string str1 = "ph31";
        string str2 = "ct31";
        string str3 = "ct31gt";

        string sql = string.Format("select tk, tt, sum(tien) as tien, sum(tien_nt) as tien_nt  from( select tk_i as tk, sum(tien) as tien, sum(tien_nt) as tien_nt, 1 as tt from " + str2 + " c join " + str1 + " p ON c.stt_rec = p.stt_rec where c.stt_rec='" + sttrec + "' group by tk_i, p.ma_gd  union  select tk_thue_no as tk,sum(t_thue) as tien, sum(t_thue_nt) as tien_nt, 2 as tt from " + str3 + " where stt_rec='" + sttrec + "' group by tk_thue_no ) a group by tk, tt order by tt, tk");
        DataTable ds = myDb.LoadDataSet(sql).Tables[0].Copy();
        return ds;

    }

    public string ToDateString(DateTime date)
    {
        return $"ngày {date.Day} tháng {date.Month} năm {date.Year}";
    }
