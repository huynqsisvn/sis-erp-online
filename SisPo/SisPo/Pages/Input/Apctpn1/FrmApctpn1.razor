    private async Task GridCT_OnKeyDown(KeyboardEventArgs e)
    {
        if (!AllowEditMode)
            return;

        switch (e.Key)
        {
            case "Enter":
                if (activeTabIndex == 0)
                {
                    await GridCT.SaveChangesAsync();
                }
                else
                {
                    await GridCTGT.SaveChangesAsync();
                }
                await SaveAndMoveNextRow();
                break;

            case "F4":
                // Add new row
                if (activeTabIndex == 0)
                {
                    if (GridCT.IsEditing())
                    {
                        await GridCT.SaveChangesAsync();
                    }
                    await Task.Delay(50);
                    await AddNewCT();
                }
                else
                {
                    if (GridCTGT.IsEditing())
                    {
                        await GridCTGT.SaveChangesAsync();
                    }
                    await Task.Delay(50);
                    await AddNewCTGT();
                }
                break;

            case "F8":
                // Delete selected row (confirm)
                if (SelectedDataItemCT != null)
                {
                    // GridCT.ShowRowDeleteConfirmation(SelectedDataItemCT);
                }
                else
                {
                    Message = Lap["No data selected"];
                    StateHasChanged();
                }
                break;

            case "Escape":
                // Cancel current edit
                try
                {
                    await GridCT.CancelEditAsync();
                    // if user cancels a newly added empty row, remove it
                    if (LSCt.Count > 0 && CurrentEditModel != null && string.IsNullOrEmpty(CurrentEditModel.Tk_vt))
                        LSCt.Remove(CurrentEditModel);
                }
                catch { }
                break;


        }
    }



