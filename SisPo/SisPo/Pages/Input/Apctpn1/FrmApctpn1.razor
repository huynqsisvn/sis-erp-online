    /// <summary>
    /// Phân bổ thuế GTGT từ tổng (header hoặc bảng thuế) xuống từng dòng chi tiết
    /// Tương đương 100% hàm PhanBoThueInCT() trong Winform cũ
    /// Đảm bảo: Tổng thuế chi tiết = Tổng thuế header (cân bằng sai số làm tròn vào dòng đầu tiên)
    /// </summary>
    private void PhanBoThueInCT()
    {
        if (CurPh == null || LSCt == null || !LSCt.Any()) return;

        var chiTiet = LSCt
            .Where(x => x.Stt_rec == CurPh.Stt_rec)
            .OrderBy(x => x.Stt) // hoặc thứ tự thêm vào
            .ToList();

        if (!chiTiet.Any()) return;

        decimal tyGia = CurPh.Ty_gia;

        // === 1. Lấy tổng thuế cần phân bổ (thường từ bảng thuế riêng hoặc từ header) ===
        decimal tongThueNt = 0;  // Tổng thuế ngoại tệ cần phân bổ
        decimal tongThueVnd = 0; // Tổng thuế VND cần phân bổ

        // Cách 1: Lấy từ bảng phân bổ thuế (LSCTGT) theo ma_kh (như code cũ)
        if (LSCtgt != null && !string.IsNullOrEmpty(CurPh.Ma_kh))
        {
            tongThueNt = LSCtgt
                .Where(x => x.Stt_rec == CurPh.Stt_rec &&
                           (x.Ma_kh?.Trim() ?? "") == (CurPh.Ma_kh?.Trim() ?? ""))
                .Sum(x => x.T_thue_nt);

            tongThueVnd = LSCtgt
                .Where(x => x.Stt_rec == CurPh.Stt_rec &&
                           (x.Ma_kh?.Trim() ?? "") == (CurPh.Ma_kh?.Trim() ?? ""))
                .Sum(x => x.T_thue);
        }
        else
        {
            // Cách 2: Nếu không có bảng phân bổ → lấy thẳng từ header (trường hợp đơn giản)
            tongThueNt = CurPh.T_thue_nt;
            tongThueVnd = CurPh.T_thue;
        }

        // === 2. Tính tổng tiền hàng làm cơ sở phân bổ ===
        decimal tongTienNt = chiTiet.Sum(x => x.Tien_nt);
        decimal tongTienVnd = chiTiet.Sum(x => x.Tien);

        if (tongTienNt == 0 && tongTienVnd == 0) return;

        decimal daPhanBoNt = 0;
        decimal daPhanBoVnd = 0;

        // === 3. Phân bổ thuế cho từng dòng ===
        for (int i = 0; i < chiTiet.Count; i++)
        {
            var ct = chiTiet[i];
            decimal tienNt = ct.Tien_nt;
            decimal tienVnd = ct.Tien;

            decimal thueNtCuaDong = 0;
            decimal thueVndCuaDong = 0;

            if (CurPh.Ma_nt?.Trim() != M_ma_nt0?.Trim()) // Ngoại tệ
            {
                if (tongTienNt != 0 && tienNt != 0)
                    thueNtCuaDong = Math.Round(tienNt / tongTienNt * tongThueNt, M_ROUND_NT);

                if (tongTienVnd != 0 && tienVnd != 0)
                    thueVndCuaDong = Math.Round(tienVnd / tongTienVnd * tongThueVnd, M_ROUND);
            }
            else // VND
            {
                if (tongTienNt != 0 && tienNt != 0)
                    thueNtCuaDong = Math.Round(tienNt / tongTienNt * tongThueNt, M_ROUND_NT);

                thueVndCuaDong = thueNtCuaDong; // Vì là VND nên thue = thue_nt
            }

            ct.Thue_nt = thueNtCuaDong;
            ct.Thue = thueVndCuaDong;

            daPhanBoNt += thueNtCuaDong;
            daPhanBoVnd += thueVndCuaDong;
        }

        // === 4. Cân bằng sai số làm tròn: cộng phần lệch vào dòng đầu tiên ===
        if (chiTiet.Any())
        {
            decimal lechNt = tongThueNt - daPhanBoNt;
            decimal lechVnd = tongThueVnd - daPhanBoVnd;

            if (lechNt != 0)
                chiTiet[0].Thue_nt = (chiTiet[0].Thue_nt) + lechNt;

            if (lechVnd != 0)
                chiTiet[0].Thue = (chiTiet[0].Thue) + lechVnd;
        }

        // === 5. Cập nhật lại tổng thuế trên header (đảm bảo tuyệt đối chính xác) ===
        CurPh.T_thue_nt = tongThueNt;
        CurPh.T_thue = tongThueVnd;

        // Cập nhật tổng cộng
        // TinhLaiTatCaTong(); // hoặc UpdateTotalHT() + UpdateTotalThue()
    }




