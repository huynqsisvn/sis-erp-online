            if (DsTrans != null && DsTrans.Tables.Count > 2)
                LSCtgt = myDb.ConvertDataTable<Ct31gt>(DsTrans.Tables[2]);

            if (!String.IsNullOrWhiteSpace(CurPh.Stt_rec_pc))
            {
                string strsql = string.Format("SELECT stt_rec,ma_ct,ma_gd,ma_qs,so_ct,ma_nt,ong_ba,dien_giai FROM {0} WHERE stt_rec LIKE '{1}'", CurPh.Ma_ct_pc.Equals("PC1") ? (object)"ph46" : (object)"ph56", CurPh.Stt_rec_pc);
