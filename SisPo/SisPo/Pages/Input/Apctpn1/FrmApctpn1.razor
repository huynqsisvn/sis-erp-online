                    await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");
                }
                if (flag2 && String.IsNullOrWhiteSpace(CurPh.Stt_rec_pc) & CurPh.Tao_pc == 1)
                {
                    await LoadFormPC();
