@inherits TranBaseComponent
@using System.Data
@using DevExpress.Blazor

<div class="m-0 p-0 w-100" data-spy="scroll" style="overflow:auto;">
    @if (IsShowVoucher)
    {
        <FormTrans Title="@Pagetitle" @bind-curActionTask="@curActionTask" OnNew="@OnNew" OnCopy="@OnCopy" OnEdit="@OnEdit" OnSave="@OnSave" OnCancel="@OnCancel" OnPrint="@OnPrint" OnTemplateChanged="@OnTemplateChanged" Stt_rec="@CurPh.Stt_rec" curUser="@curUser" Ma_ct="@Ma_ct" Menu_id="@Menu_id" Phdbf="@M_Phdbf" LanguageID="@LanguageID">
            <div class="row m-1 mt-3 me-2">
                <DxFormLayout SizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
                    <DxFormLayoutGroup ColSpanMd="12" Caption="@Lap["Infomation"]" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide">
                        <DxFormLayoutGroup ColSpanMd="8" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">
                            <DxFormLayoutItem Caption="@Lap["Supplier code"]" ColSpanMd="8">
                                <Template>
                                    <AutocompleteComponent Id="ma_khach_input" TblData="@TblDmkh" Ma_dm="dmkh" @bind-Value="@CurPh.Ma_kh" SelectChanged="OnAutoCompleteKhachhangChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Address"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurPh.Dia_chi" Enabled="@AllowEditMode"></DxTextBox>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Deliverer"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurPh.Ong_ba" Enabled="@AllowEditMode"></DxTextBox>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Description"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurPh.Dien_giai" Enabled="@AllowEditMode"></DxTextBox>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Credit account"]" ColSpanMd="8">
                                <Template>
                                    <AutocompleteComponent Ma_dm="dmnx" @bind-Value="@CurPh.Ma_nx" SelectChanged="OnAutoCompleteDMNXChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>

                        </DxFormLayoutGroup>
                        <DxFormLayoutGroup Caption="@Lap["Voucher"]" ColSpanMd="4" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">
                            <DxFormLayoutItem Caption="@Lap["GL date"]" ColSpanMd="12">
                                <DxDateEdit Id="ngay_ct_input" @bind-Date="@CurPh.Ngay_ct" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["LCT date"]" ColSpanMd="12">
                                <DxDateEdit @bind-Date="@CurPh.Ngay_lct" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Book code"]" ColSpanMd="12">
                                <AutocompleteComponent Id="ma_qs_input" Ma_dm="dmqs" @bind-Value="@CurPh.Ma_qs" SelectChanged="OnAutoCompleteQuyensoChanged" Filter="@_filter_qs" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Voucher No"]" ColSpanMd="12">
                                <DxTextBox Id="so_ct_input" @bind-Text="@CurPh.So_ct" Enabled="@AllowEditMode"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Ex. rate"]" ColSpanMd="8">
                                <Template>
                                    <AutocompleteComponent Ma_dm="dmnt" @bind-Value="@CurPh.Ma_nt" SelectChanged="OnAutoCompleteMaNTChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="4">
                                <Template>
                                    <DxSpinEdit ReadOnly="@(CurPh?.Ma_nt?.Trim().Equals(M_ma_nt0) == true)" Value="@CurPh.Ty_gia" ValueExpression="@(() => CurPh.Ty_gia)" ValueChanged="@((decimal newvalue) => { OnValueTyGiaChanged(newvalue); })" DisplayFormat="@M_IP_TY_GIA" Enabled="@AllowEditMode" Id="Ty_gia"></DxSpinEdit>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="12">
                                <Template>
                                    <AutocompleteComponent CssClass="col p-0" Ma_dm="dmpost" @bind-Value="@CurPh.Status" Filter="@filter_status" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                    </DxFormLayoutGroup>
                    <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail" @bind-ActiveTabIndex="@activeTabIndex" TabClick="@OnTabChanged">
                        <DxFormLayoutTabPage Caption="@Lap["Details"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div @ref="GridWrapper" id="grid-wrapper" @onfocusout="OnGridCTLostFocus" class="mt-2 mb-3">
                                        <DxGrid @ref="GridCT" SizeMode="@Itemsizemode" CssClass="@grd_Css" @onkeydown="GridCT_OnKeyDown"
                                                AllowSelectRowByClick=true KeyboardNavigationEnabled="true"
                                                Data="@LSCt"
                                                @bind-SelectedDataItem="@SelectedDataItemCT"
                                                ValidationEnabled="false"
                                                EditMode="GridEditMode.EditRow"
                                                RowClick="@StartEditDataItemByClickCT"
                                                SelectionMode="GridSelectionMode.Single"
                                                CustomizeEditModel="Grid_CustomizeEditModelCT"
                                                EditModelSaving="Grid_EditModelSavingCT"
                                                CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                                ColumnResizeMode="GridColumnResizeMode.NextColumn"
                                                EditNewRowPosition="@NewItemRowPosition"
                                                ShowAllRows="true"
                                                TextWrapEnabled="false" AllowSort="false"
                                                HighlightRowOnHover="true">
                                            <Columns>
                                                <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                                    <CellDisplayTemplate Context="cntedit">
                                                        <div class="grid-cell-align-center">
                                                            <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                                      RenderStyle="ButtonRenderStyle.Link"
                                                                      CssClass="grid-delete-btn"
                                                                      aria-label="Delete"
                                                                      Click="@(() => OnDeleteRowCT(cntedit.VisibleIndex, 0))" />
                                                        </div>
                                                    </CellDisplayTemplate>
                                                    <CellEditTemplate Context="cntedit1">
                                                        <div class="grid-cell-align-center">
                                                            <DxButton Enabled="false"
                                                                      CssClass="grid-disabled-button"
                                                                      IconCssClass="grid-icon grid-icon-delete"
                                                                      aria-label="Delete"
                                                                      RenderStyle="ButtonRenderStyle.Link" />
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridCommandColumn>
                                                <DxGridDataColumn FieldName="Tk_vt" Caption="@Lap["Debit account"].ToString()" Width="150px" CaptionAlignment="GridTextAlignment.Center">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <div id="@($"Tk_vt_{_Ct31.Stt}")" class="autocomplete-cell-wrapper m-0 p-0">
                                                            <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@_Ct31.Tk_vt" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Tk_vt"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ten_tk" ReadOnly="true" Caption="@Lap["Account name"]" CaptionAlignment="GridTextAlignment.Center" Width="300px" />

                                                <DxGridDataColumn FieldName="Dien_giaii" Caption="@Lap["Service name"]" Width="200" >
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxTextBox @bind-Text="@_Ct31.Dien_giaii" Enabled="@AllowEditMode" Id="Dien_giaii"></DxTextBox>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>


                                                <DxGridDataColumn FieldName="Dvt" Caption="@Lap["UOM"]" CaptionAlignment="GridTextAlignment.Center" Width="150">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxTextBox @bind-Text="@_Ct31.Dvt" Enabled="@AllowEditMode" Id="Dvt"></DxTextBox>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="So_luong" Caption="@Lap["Quantity"]" CaptionAlignment="GridTextAlignment.Center" Width="150" DisplayFormat="@M_IP_SL">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct31.So_luong" ValueExpression="@(() => _Ct31.So_luong)" DisplayFormat="@M_IP_SL" Format="@M_IP_SL" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "So_luong"); })" Id="So_luong"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Gia_nt" Caption="@String.Concat(Lap["Sales price"], " ", CurPh.Ma_nt)" Width="150" DisplayFormat="@M_IP_GIA_NT">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct31.Gia_nt" ValueExpression="@(() => _Ct31.Gia_nt)" DisplayFormat="@M_IP_GIA_NT" Format="@M_IP_GIA_NT" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia_nt"); })" Id="Gia_nt2"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>


                                                <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Gia" Caption="@String.Concat(Lap["Sales price"], " ", M_ma_nt0.Trim())" Width="150" DisplayFormat="@M_IP_GIA">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="false" Value="@_Ct31.Gia" ValueExpression="@(() => _Ct31.Gia)" DisplayFormat="@M_IP_GIA" Format="@M_IP_GIA" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia"); })" Id="Gia"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Tien_nt" Caption="@String.Concat(Lap["Goods amount"], " ", CurPh.Ma_nt)" Width="150" DisplayFormat="@M_IP_TIEN_NT">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct31.Tien_nt" ValueExpression="@(() => _Ct31.Tien_nt)" DisplayFormat="@M_IP_TIEN_NT" Format="@M_IP_TIEN_NT" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien_nt"); })" Id="Tien_nt"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Tien" Caption="@String.Concat(Lap["Goods amount"], " ", M_ma_nt0.Trim())" Width="150" DisplayFormat="@M_IP_TIEN">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct31 = (Ct31)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="false" Value="@_Ct31.Tien" ValueExpression="@(() => _Ct31.Tien)" DisplayFormat="@M_IP_TIEN" Format="@M_IP_TIEN" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien"); })" Id="Tien"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>


                                                @foreach (FreeCodeInfo row in LsFreeCodeInfo)
                                                {
                                                    @if (row.Loai_dmctct == 1)
                                                    {
                                                        <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct31 = (Ct31)GrdContext.EditModel;
                                                                }
                                                                <SisLib.Ctrl.FreeCodeDm Target="_Ct31" Ma_dm="@row.Ma_dm" FieldName="@row.Field_ct" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, row.Field_ct); })"
                                                                                        IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></SisLib.Ctrl.FreeCodeDm>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                    }
                                                    else if (row.Loai_dmctct == 3)
                                                    {
                                                        <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth" DisplayFormat="@M_IP_SL">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct31 = (Ct31)GrdContext.EditModel;
                                                                }
                                                                <SisLib.Ctrl.FreeCodeSl Target="_Ct31" FieldName="@row.Field_ct" IsEnable="@AllowEditMode" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, row.Field_ct); })"></SisLib.Ctrl.FreeCodeSl>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                    }
                                                    else
                                                    {
                                                        <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct31 = (Ct31)GrdContext.EditModel;
                                                                }
                                                                <SisLib.Ctrl.FreeCodeText Target="_Ct31" FieldName="@row.Field_ct"></SisLib.Ctrl.FreeCodeText>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                    }
                                                }
                                            </Columns>
                                            <TotalSummary>
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_SL" Name="So_luong" FieldName="So_luong" />
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Tien" FieldName="Tien" />
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN_NT" Name="Tien_nt" FieldName="Tien_nt" />
                                            </TotalSummary>
                                        </DxGrid>
                                    </div>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>
                        <DxFormLayoutTabPage Caption="@Lap["Tax"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div @ref="GridGTWrapper" id="gridgt-wrapper" @onfocusout="OnGridCTGTLostFocus" class="mt-2 mb-3">
                                    <DxGrid @ref="GridCTGT" Data="@LSCtgt" CssClass="grd-detail" @onkeydown="GridCT_OnKeyDown"
                                            @bind-SelectedDataItem="@SelectedDataItemCTGT"
                                            KeyboardNavigationEnabled="true"
                                            AllowSelectRowByClick=true
                                            ValidationEnabled="false"
                                            RowClick="@StartEditDataItemByClickCTGT"
                                            CustomizeEditModel="Grid_CustomizeEditModelCTGT"
                                            EditModelSaving="Grid_EditModelSavingCTGT"
                                            CustomizeElement="Grid_CustomizeElement"
                                            CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                            EditMode="GridEditMode.EditRow"
                                            EditNewRowPosition="@NewItemRowPosition"
                                            ShowAllRows="true" SizeMode="@Itemsizemode"
                                            TextWrapEnabled="true"
                                            HighlightRowOnHover="true">
                                        <Columns>
                                            <DxGridCommandColumn MinWidth="30" Width="30px" Visible="@AllowEditMode" NewButtonVisible="false" VisibleIndex="0">
                                                <CellDisplayTemplate Context="cntedit">
                                                    <div class="grid-cell-align-center">
                                                        <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                                  RenderStyle="ButtonRenderStyle.Link"
                                                                  CssClass="grid-delete-btn"
                                                                  aria-label="Delete"
                                                                  Click="@(() => OnDeleteRowCTGT(cntedit.VisibleIndex))" />
                                                    </div>
                                                </CellDisplayTemplate>
                                                <CellEditTemplate Context="cntedit1">
                                                    <div class="grid-cell-align-center">
                                                        <DxButton Enabled="false"
                                                                  CssClass="grid-disabled-button"
                                                                  IconCssClass="grid-icon grid-icon-delete"
                                                                  aria-label="Delete"
                                                                  RenderStyle="ButtonRenderStyle.Link" />
                                                    </div>
                                                </CellEditTemplate>
                                            </DxGridCommandColumn>

                                                <DxGridDataColumn FieldName="Ma_ms" Caption="@Lap["Group invoice"].ToString()" Width="100px" VisibleIndex="@CtgtOrder.GetKey("1")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <AutocompleteComponent Ma_dm="dmms" @bind-Value="@_Ct31gt.Ma_ms" SelectChanged="@((ExpandoObject value) => { OnGridCTGT_DMDM_Changed(value, "Ma_ms"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Ngay_ct0" Caption="@Lap["Invoice date"].ToString()" DisplayFormat="dd-MM-yyyy" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("2")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxDateEdit @bind-Date="@_Ct31gt.Ngay_ct0" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode" />
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="So_ct0" Caption="@Lap["Invoice number"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("3")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct31gt.So_ct0" Enabled="@AllowEditMode"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Kh_mau_hd" Caption="@Lap["Denominator"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("4")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct31gt.Kh_mau_hd" Enabled="@AllowEditMode"></DxTextBox>

                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="So_seri0" Caption="@Lap["Symbol"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("5")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct31gt.So_seri0" Enabled="@AllowEditMode"></DxTextBox>

                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ma_kh" Caption="@Lap["Customer code"].ToString()" Width="200px" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("6")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <AutocompleteComponent Ma_dm="dmkh_thue" @bind-Value="@_Ct31gt.Ma_kh" SelectChanged="@((ExpandoObject value) => { OnGridCTGT_DMDM_Changed(value, "Ma_kh"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ten_kh" ReadOnly="true" Caption="@Lap["Customer name"]" CaptionAlignment="GridTextAlignment.Center" Width="300px" VisibleIndex="@CtOrder.GetKey("7")" />

                                            <DxGridDataColumn FieldName="Dia_chi" Caption="@Lap["Address"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="300px" VisibleIndex="@CtOrder.GetKey("8")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct31gt.Dia_chi" ReadOnly="true"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ma_so_thue" Caption="@Lap["Number tax"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("9")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxTextBox @bind-Text="@_Ct31gt.Ma_so_thue" ReadOnly="true"></DxTextBox>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>

                                            <DxGridDataColumn FieldName="T_tien_nt" Caption="@String.Concat(Lap["Price Goods"], " ", CurPh.Ma_nt)" Width="100px" DisplayFormat="@M_IP_GIA_NT" VisibleIndex="@CtOrder.GetKey("10")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct31gt.T_tien_nt" ValueExpression="@(() => _Ct31gt.T_tien_nt)" DisplayFormat="@M_IP_GIA_NT" Format="@M_IP_GIA_NT" ValueChanged="@((decimal newvalue) => { OnGridCTGT_Value_Changed(newvalue, "T_tien_nt"); })" Id="T_tien_nt"></DxSpinEdit>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            @if (NotMaNt0Voucher)
                                            {
                                                <DxGridDataColumn FieldName="T_tien" Caption="@String.Concat(Lap["Price Goods"], " ", M_ma_nt0.Trim())" Width="100px" DisplayFormat="@M_IP_GIA_NT" VisibleIndex="@CtOrder.GetKey("11")">
                                                    <CellEditTemplate Context="GrdCTGTContext">
                                                        @{
                                                            var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct31gt.T_tien" ValueExpression="@(() => _Ct31gt.T_tien)" DisplayFormat="@M_IP_GIA" Format="@M_IP_GIA" ValueChanged="@((decimal newvalue) => { OnGridCTGT_Value_Changed(newvalue, "T_tien"); })" Id="T_tien"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                            }

                                            <DxGridDataColumn FieldName="Ma_thue" Caption="@Lap["Code tax"].ToString()" Width="100px" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("12")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
                                                    }
                                                    <AutocompleteComponent Ma_dm="dmthue30" @bind-Value="@_Ct31gt.Ma_thue" SelectChanged="@((ExpandoObject value) => { OnGridCTGT_DMDM_Changed(value, "Ma_thue"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Thue_suat" ReadOnly="true" Caption="@Lap["Tax rate"]" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("13")" />

                                            <DxGridDataColumn FieldName="T_thue_nt" Caption="@String.Concat(Lap["Tax money"], " ", CurPh.Ma_nt)" Width="100px" DisplayFormat="@M_IP_TIEN_NT" VisibleIndex="@CtOrder.GetKey("14")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct31gt = (Ct31gt)GrdCTGTContext.EditModel;
