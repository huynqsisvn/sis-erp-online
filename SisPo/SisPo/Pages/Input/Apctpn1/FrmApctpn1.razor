    private async Task CalculateTyGia()
    {
        if (CurPh?.Ty_gia <= 0) return;

        decimal tyGia = CurPh.Ty_gia;
        int roundTien = M_ROUND;           // Số chữ số làm tròn tiền VND
        int roundNt = M_ROUND_NT;        // Số chữ số làm tròn ngoại tệ

        // === 1. Cập nhật tiền VND cho các dòng chi tiết (LSCt) ===
        foreach (var ct in LSCt)
        {
            if ((ct.Tien_nt) != 0)
            {

                ct.Tien = Math.Round(tyGia * ct.Tien_nt, roundTien);

            }

            // Cập nhật tổng hợp (nếu có hàm riêng)
            UpdateTotalHT();

            // === 2. Cập nhật tiền + thuế cho các dòng thuế suất (GrdCtgt → thường là bảng phân bổ thuế) ===
            if (LSCtgt != null) // Danh sách các dòng thuế (nếu có)
            {
                foreach (var thue in LSCtgt)
                {
                    decimal tienNt = thue.T_tien_nt;

                    if (tienNt != 0)
                    {
                        // Tính tiền VND
                        decimal tienVnd = Math.Round(tyGia * tienNt, roundTien);
                        thue.T_tien = tienVnd;

                        // Tính thuế
                        if (thue.Thue_suat != 0)
                        {
                            decimal thueSuat = thue.Thue_suat;

                            thue.T_thue_nt = Math.Round(tienNt * thueSuat / 100, roundNt);
                            thue.T_thue = Math.Round(tienVnd * thueSuat / 100, roundTien);
                        }
                        thue.T_tt = thue.T_tien + thue.T_thue;
                    }
                }

                // Tính lại tổng thuế nếu có hàm riêng
                UpdateTotalThue();
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateTotalHT()
    {
        if (curActionTask == ActionTask.View || LSCt == null || CurPh == null)
            return;

        decimal tTienNt = LSCt
            .Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0)
            .Sum(x => x.Tien_nt)
            + (CurrentEditModel?.Tien_nt ?? 0);
        CurPh.T_tien_nt = tTienNt;

        // CurPh.T_tien = tTienNt; // txtT_Tien và txtT_Tien_nt cùng giá trị khi hiển thị

        decimal tThueNt = CurPh.T_thue_nt;

        decimal tongCongNt = tTienNt + tThueNt;
        CurPh.T_tt_nt = tongCongNt;
        // CurPh.T_tt = tongCongNt;

        if (!string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            decimal tTienVnd = LSCt
                .Where(x => CurrentEditModel == null || x.Stt_rec0 != CurrentEditModel.Stt_rec0)
                .Sum(x => x.Tien)
                + (CurrentEditModel?.Tien ?? 0);
            decimal tThueVndQuyDoi = CurPh.T_thue; // Thuế đã quy đổi sẵn

            CurPh.T_tien = Math.Round(tTienVnd, M_ROUND);
            CurPh.T_tt = Math.Round(tTienVnd + tThueVndQuyDoi, M_ROUND);
        }
        else
        {
            // Nếu là VND → Nt0 = chính nó
            CurPh.T_tien = tTienNt;
            CurPh.T_tt = tongCongNt;
        }
        StateHasChanged();

    }

    private void UpdateTotalThue()
    {
        if (curActionTask == ActionTask.View || CurPh == null)
            return;


        decimal tThueNt = LSCtgt
            .Where(x => CurrentEditModelctgt == null || x.Stt_rec0 != CurrentEditModelctgt.Stt_rec0)
            .Sum(x => x.T_thue_nt)
            + (CurrentEditModelctgt?.T_thue_nt ?? 0);
        CurPh.T_thue_nt = tThueNt;        

        decimal tTienNt = CurPh.T_tien_nt;

        decimal tongCongNt = tTienNt + tThueNt;
        CurPh.T_tt_nt = tongCongNt;        

        if (NotMaNt0Voucher)
        {
            decimal tThueVnd = LSCtgt
                .Where(x => CurrentEditModelctgt == null || x.Stt_rec0 != CurrentEditModelctgt.Stt_rec0)
                .Sum(x => x.T_thue)
                + (CurrentEditModelctgt?.T_thue ?? 0);
            decimal tTienVnd = CurPh.T_tien;             // Tiền hàng đã quy đổi

            CurPh.T_thue = Math.Round(tThueVnd, M_ROUND);
            CurPh.T_tt = Math.Round(tTienVnd + tThueVnd, M_ROUND);
        }
        else
        {            
            CurPh.T_thue = tThueNt;
            CurPh.T_tt = tongCongNt;
        }        
        StateHasChanged();
    }
