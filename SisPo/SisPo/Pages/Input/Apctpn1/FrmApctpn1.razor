    public DataSet CheckData(int mode)
    {
        string format = "exec [dbo].{0} @status,  @stt_rec;";
        string[] Check_Valid_Store = (curDmct == null ? "" : curDmct.Check_valid_store.Trim()).Split("|");
        string sqlcmd = (Check_Valid_Store == null || Check_Valid_Store.Length <= 8) ? string.Format(format, (object)"[APCTPN1-CheckData]") : string.Format(format, (object)Check_Valid_Store[8]);
        DataSet dsResult = myDb.LoadDataSet(sqlcmd, new Dictionary<string, object>
        {
            ["@status"] = CurPh.Status,
            ["@stt_rec"] = CurPh.Stt_rec
        });
        return dsResult;
    }

    async Task<bool> CheckValid()
    {
        bool flag = true;

        if (string.IsNullOrEmpty(CurPh.Ma_kh) && flag)
        {
            Message = Lap["Chưa vào Khách hàng!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_kh_input')?.focus()");
            IsSaved = false;

            flag = false;
        }



        if (CurPh.Ngay_ct == default && flag)
        {
            Message = Lap["Chưa vào ngày hạch toán!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_ct_input')?.focus()");
            IsSaved = false;

            flag = false;
        }


        if (flag && M_ngay_lct == "1")
        {
            if (CurPh.Ngay_lct == default)
            {
                Message = Lap["Chưa vào ngày lập px!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_lct_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
        }

        if (string.IsNullOrEmpty(CurPh.Ma_qs) && flag)
        {
            Message = Lap["Chưa vào quyển chứng từ!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_lct_input')?.focus()");
            IsSaved = false;

            flag = false;
        }

        if (string.IsNullOrEmpty(CurPh.Ma_nx) && flag)
        {
            Message = Lap["Chưa vào tài khoản có!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_nx_input')?.focus()");
            IsSaved = false;

            flag = false;
        }

        if (LSCt.Count == 0 && flag)
        {
            Message = Lap["Chưa vào chi tiết vật tư, không lưu được!"];
            IsSaved = false;

            myStateMN.SetNewThongbao(Message);
            flag = false;
        }

        for (int i = 0; i < LSCt.Count && flag; i++)
        {
            var row = LSCt[i];

            if (string.IsNullOrWhiteSpace(row.Tk_vt))
            {

                Message = Lap["Chưa vào tk nợ!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('tk_vt_input')?.focus()");
                IsSaved = false;

                flag = false;
            }

        }

        if (!flag)
        {
            if (LSCtgt.Count > 0)
            {
                decimal t_tien_nt_gt = LSCtgt.Sum(a => a.T_tien_nt);
                decimal t_tien_gt = LSCtgt.Sum(a => a.T_tien);

                decimal tien_nt = LSCt.Sum(a => a.Tien_nt);
                decimal tien = LSCt.Sum(a => a.Tien);

                if (curActionTask == ActionTask.Copy && (t_tien_nt_gt != tien_nt || t_tien_gt != tien))
                {

                    if (CurPh.T_thue != 0 && CurPh.T_thue_nt != 0)
                    {
                        Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
                        myStateMN.SetNewThongbao(Message);
                        IsSaved = false;
                        flag = false;

                    }
                }
                else if (CurPh.T_thue != 0 && CurPh.T_thue_nt != 0)
                {

                    Message = Lap["Tổng tiền/ tiền ngoại tệ khác với tổng tiền/ tiền ngoại tệ trong các hóa đơn giá trị gia tăng!"];
                    myStateMN.SetNewThongbao(Message);
                    IsSaved = false;
                    flag = false;

                }
            }

        }
        return flag;
    }
    private async void OnPrint()
    {
        DataSet DataSource = CopyVoucherToDataSet(Stt_rec);

        if (DataSource != null && DataSource.Tables.Count > 0)
        {

            LSData = new List<PN1Model>();
            PN1Model _curModel = new PN1Model();
            _curModel.Ten_cty = myOption.GetOptionsValue("M_TEN_CTY").Trim();
            _curModel.Dia_chi_cty = myOption.GetOptionsValue("M_DIA_CHI").Trim();
            _curModel.Ma_so_thue_cty = myOption.GetOptionsValue("M_MA_THUE").Trim();
            _curModel.Dien_thoai_cty = myOption.GetOptionsValue("M_PHONE").Trim();
            _curModel.LSPh = myDb.ConvertDataTable<Ph31>(DataSource.Tables[0]);
            string strnh = myDb.GetValue("SELECT tk_nh + '#' + ten_nh FROM dmkh WHERE ma_kh = '" + _curModel.LSPh[0].Ma_kh.Trim() + "'").ToString();

            _curModel.LSCt = myDb.ConvertDataTable<Ct31>(DataSource.Tables[1]).OrderBy(x => x.Stt_rec0).ToList();
            for (int i = 0; i < _curModel.LSCt.Count; i++)
            {
                _curModel.LSCt[i].Stt = i + 1;
            }

            _curModel.TotalTTString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tt, myOption, myDb, IsLangEn);
            _curModel.So_lien = curDmct.So_lien;
                        _curModel.NgayString = ToDateString(_curModel.LSPh[0].Ngay_ct);

            
            String sql = $"SELECT tk,dien_giai,ps_no ,ps_co FROM ct00 WHERE stt_rec = '{_curModel.LSPh[0].Stt_rec}' order by nh_dk,stt_rec0";
            DataSet ds = myDb.LoadDataSet(sql);
            List<HachToan> lstHachToan = new List<HachToan>();
            decimal total_ps_no = 0;
            decimal total_ps_co = 0;
            if (ds != null && ds.Tables.Count > 0)
            {
                decimal t_ps_no = 0;
                decimal t_ps_co = 0;
                int stt = 0;
                foreach (DataRow dr in ds.Tables[0].Rows)
                {
                    HachToan hachToan = new HachToan();
                    hachToan.Tk = dr["tk"].ToString();
                    hachToan.Ps_no = decimal.Parse(dr["ps_no"].ToString());
                    hachToan.Ps_co = decimal.Parse(dr["ps_co"].ToString());
                    hachToan.Stt = stt;
                    hachToan.Dien_giai = dr["dien_giai"].ToString();
                    stt++;
                    total_ps_no += hachToan.Ps_no;
                    total_ps_co += hachToan.Ps_co;
                    lstHachToan.Add(hachToan);
                    t_ps_co += hachToan.Ps_co;
                    t_ps_no += hachToan.Ps_no;
                }
                _curModel.T_ps_no = total_ps_no;
                _curModel.T_ps_co = total_ps_co;
                if (lstHachToan.Count > 0)
                    _curModel.TotalString = SisFunc.DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, IsLangEn);
            }
            _curModel.LSTkPs = lstHachToan;
            LSData.Add(_curModel);
        }
        IsShowVoucher = false;
        StateHasChanged();
    }

    public DataTable AddTbTkPs(string sttrec)
    {
        string str1 = "ph31";
        string str2 = "ct31";
        string str3 = "ct31gt";

        string sql = string.Format("select tk, tt, sum(tien) as tien, sum(tien_nt) as tien_nt  from( select tk_vt as tk, sum(tien) as tien, sum(tien_nt) as tien_nt, 1 as tt from " + str2 + " c join " + str1 + " p ON c.stt_rec = p.stt_rec where c.stt_rec='" + sttrec + "' group by tk_vt, p.ma_gd  union  select tk_thue_no as tk,sum(t_thue) as tien, sum(t_thue_nt) as tien_nt, 2 as tt from " + str3 + " where stt_rec='" + sttrec + "' group by tk_thue_no ) a group by tk, tt order by tt, tk");
        DataTable ds = myDb.LoadDataSet(sql).Tables[0].Copy();
        return ds;

    }

