    private async Task UpdateTotalChkSua_tien()
    {
        if (curActionTask == ActionTask.Delete || curActionTask == ActionTask.View)
            return;

        decimal tyGia = CurPh.Ty_gia;
        decimal suaTien = CurPh.Sua_tien;

        if (tyGia == 0 || (suaTien != 0))
            return;


        UpdateTotal();


        CurPh.T_tien = LSCt.Sum(a => a.Tien);
        CurPh.T_tien_nt = LSCt.Sum(a => a.Tien_nt);
        CurPh.T_tt_nt = LSCt.Sum(a => a.Tien_nt) + LSCtgt.Sum(a => a.T_thue_nt);
        CurPh.T_tt = LSCt.Sum(a => a.Tien) + LSCtgt.Sum(a => a.T_thue);



        await InvokeAsync(StateHasChanged);
    }

    private void UpdateTotal()
    {
        decimal tyGia = CurPh.Ty_gia;
        bool isLocalCurrency = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

        foreach (var ct in LSCt)
        {

            decimal gia_nt = ct.Gia_nt;
            decimal tien_nt = gia_nt * ct.So_luong;

            ct.Tien_nt = tien_nt;

            if (isLocalCurrency)
            {

                ct.Gia = gia_nt;
                ct.Tien = tien_nt;
            }
            else
            {

                decimal gia = gia_nt * tyGia;
                decimal tien = gia * ct.So_luong;
                if (gia != 0) ct.Gia = gia;
                if (tien != 0) ct.Tien = tien;
            }

            if (CurrentEditModel != null && CurrentEditModel.Stt_rec0 == ct.Stt_rec0)
            {
                CurrentEditModel.Tien_nt = ct.Tien_nt;
                CurrentEditModel.Tien = ct.Tien;
            }



        }
    }




