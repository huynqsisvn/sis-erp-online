            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");


            if (LSCt.Count > 0)
                await myDb.InsertManyRow<Ct31>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec);
            if (LSCtgt.Count > 0)
            {
                await myDb.InsertManyRow<Ct31gt>(LSCtgt, M_Ctgtdbf, "stt_rec", CurPh.Stt_rec);
            }
        }
        else if (curActionTask == ActionTask.Edit)
