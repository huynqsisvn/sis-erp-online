                if (tblpt1.Rows.Count > 0)
                {
                    CurPh.Ma_gd_pc = tblpt1.Rows[0]["ma_gd"].ToString();
                    CurPh.Ong_ba_pc = tblpt1.Rows[0]["ong_ba"].ToString();
                    CurPh.Dien_giai_pc = tblpt1.Rows[0]["dien_giai"].ToString();
                }
            }
        }
    }


    private void CanBangTien()
    {
        if (CurPh == null || LSCt == null || !LSCt.Any())
            return;

        decimal tTienNt = CurPh.T_tien_nt;   // Tổng tiền ngoại tệ trên header
        decimal tyGia = CurPh.Ty_gia;     // Tỷ giá hiện tại
        decimal tongTienChiTiet = LSCt.Sum(x => x.Tien); // Tổng tiền VND hiện tại của các dòng chi tiết

        // Tính lại tổng tiền VND lý thuyết từ header (t_tien_nt * ty_gia)
        decimal tTienVndLyThuyet = Math.Round(tTienNt * tyGia, M_ROUND);

        // Tính chênh lệch do làm tròn
        decimal chenhLech = tTienVndLyThuyet - tongTienChiTiet;

        // Nếu không có chênh lệch → không cần làm gì
        if (chenhLech == 0m)
            return;

        // Tìm dòng chi tiết có tiền_nt lớn nhất và chưa bị khóa cân bằng (thường là dòng đầu tiên có tiền)
        var dongCanBang = LSCt
            .Where(x => (x.Tien_nt) != 0)
            .OrderByDescending(x => x.Tien_nt)
            .FirstOrDefault();

        if (dongCanBang != null)
        {
            // Cộng/giảm phần chênh lệch vào dòng này
            dongCanBang.Tien = (dongCanBang.Tien) + chenhLech;

            // Cập nhật lại tổng trên header cho chính xác tuyệt đối
            CurPh.T_tien = tTienVndLyThuyet;
        }
        else
        {
            // Trường hợp cực hiếm: không có dòng nào có tiền_nt → gán thẳng vào header
            CurPh.T_tien = tTienVndLyThuyet;
        }

        // Gọi StateHasChanged nếu cần cập nhật UI ngay
        // StateHasChanged();
    }

