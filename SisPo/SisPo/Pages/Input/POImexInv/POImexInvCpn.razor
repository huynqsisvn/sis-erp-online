    private async Task LoadDataFromDb()
    {
        if (Ngay_ct1 == null)
            Ngay_ct1 = myStateMN.GetStartDate();
        if (Ngay_ct2 == null)
            Ngay_ct2 = myStateMN.GetEndDate();

        string dvcs = myStateMN.GetMa_Dvcs();
        Filter = "1=1";
        if (dvcs != "ALL")
        {
            Filter = Filter + " AND ma_dvcs LIKE ''" + dvcs.Trim() + "%''";
        }
        if (Ngay_ct1 != null)
        {
            Filter = Filter + " AND ngay_ct0 >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            Filter = Filter + " AND ngay_ct0 <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }

        await Loaddata(true);
    }

    public async Task Loaddata(bool isInit)
    {        
        fbrowse = !IsLangEn ? curCommand.Vbrowse1.Trim() : curCommand.Ebrowse1.Trim();
        SqlTableKey = "stt_rec";
        Ma_dvcs = myStateMN.GetMa_Dvcs();
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);

        string sqlPh = $@"EXEC POImexInv_LoadData @Ngay_ct1, @Ngay_ct2, @So_ct1, @So_ct2, @Ma_dvcs";
        var parameters = new Dictionary<string, object>
        {
            { "@Ngay_ct1", Ngay_ct1.ToString("yyyyMMdd") },
            { "@Ngay_ct2", Ngay_ct2.ToString("yyyyMMdd") },
            { "@So_ct1", So_ct1 ?? "" },
            { "@So_ct2", So_ct2 ?? "" },
            { "@Ma_dvcs", Ma_dvcs ?? "" }
        };

        DataSet dsPH = await myDb.LoadDataset(sqlPh, parameters);
        if (dsPH != null && dsPH.Tables.Count > 0)
        {
            TblData = dsPH.Tables[0];            
        }
        
        InvokeAsync(StateHasChanged);
        await Task.CompletedTask;
    }

