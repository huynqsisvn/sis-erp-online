    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                V_Moi();
                break;
            case ActionTask.View:
                View();
                break;
            case ActionTask.Search:
                popFilterVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Export:
                oBrowse?.ExPortGrid(1);
                myStateMN.SetNewThongbao(Lap["Export successfully"]);
                break;
            case ActionTask.Detail:
                ShowBKCTForm();
                break;
            case ActionTask.Quit:
                myStateMN.SetCurrentActionTask(ActionTask.None);
                StateHasChanged();
                break;
        }
    }

    public virtual void OnDvcsChanged(string ma_dvcs)
    {
