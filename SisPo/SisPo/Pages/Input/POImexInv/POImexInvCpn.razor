@code {
    public string So_ct1 = "";
    public string So_ct2 = "";
    public string Ma_dvcs = "";
    private bool _isMobileLayout;
    private string searchPlaceholder = "Search...";
    private string GridSearchText = "";
    private string Filter = "";
    public string Token_TCT = "";
    public string Ma_ct = "HDV";

    public DxPopup popFilter { get; set; }
    public bool popFilterVisible { get; set; } = false;
    public DateTime Ngay_ct1 = DateTime.Now.Date;
    public DateTime Ngay_ct2 = DateTime.Now.Date;

    bool IsMobileLayout
    {
        get => _isMobileLayout;
        set
        {
            _isMobileLayout = value;
        }
    }

    protected override void OnInitialized()
    {
        Menu_id = (String.IsNullOrEmpty(Menu_id) ? "wp.ct.08" : Menu_id);
        FrmType = null;
        IsShowImport = false;
        LanguageID = "";
        Ngay_ct1 = myStateMN.GetStartDate();
        Ngay_ct2 = myStateMN.GetEndDate();
        if(Ngay_ct1 == DateTime.Now.Date)
        {
            Ngay_ct1 = SisLib.Ctrl.NgayTC.StartOfPeriod(mySysvar, SisLib.Ctrl.NgayTC.GetStartDate(mySysvar, Ngay_ct1).Year, SisLib.Ctrl.NgayTC.GetPeriodOfDate(mySysvar, Ngay_ct1));
        }
        if (Ngay_ct2 == DateTime.Now.Date)
        {
            Ngay_ct2 = SisLib.Ctrl.NgayTC.EndOfPeriod(mySysvar, SisLib.Ctrl.NgayTC.GetStartDate(mySysvar, Ngay_ct2).Year, SisLib.Ctrl.NgayTC.GetPeriodOfDate(mySysvar, Ngay_ct2));
        }
        base.OnInitialized();
    }

    private bool IsShowFrmLogin = false;
    private bool IsShowFrmGetData = false;
    private bool IsShowFrmBKCT = false;
    private bool IsShowFrmViewInvoice = false;
    private bool IsShowNotePopup = false;
    private bool IsShowSellerInfoPopup = false;
    
    private string SelectedId_hd = "";
    private string SelectedSo_ct0 = "";
    private DateTime? SelectedNgay_ct0 = null;
    private string NoteContent = "";
    
    // Seller Info Fields
    private string SellerInfo_MST = "";
    private string SellerInfo_TenDN = "";
    private string SellerInfo_DiaChi = "";
    private string SellerInfo_TrangThai = "";
    private string SellerInfo_SoDT = "";

    private void OnToolbarItemClick(ToolbarItemClickEventArgs e)
    {
        switch (e.ItemName)
        {
            case "btnSearch":
                popFilterVisible = true;
                StateHasChanged();
                break;
            case "btnRefresh":
                AddNote();
                break;
            case "btnDelete":
                DelteVc();
                break;
            case "btnView":
                View();
                break;
            case "btnExport":
                oBrowse?.ExPortGrid(1);
                myStateMN.SetNewThongbao(Lap["Export successfully"]);
                break;
            case "btnReport":
                ShowBKCTForm();
                break;
        }
    }
    private void AddNote()
    {
        if (SelectedItem == null)
        {
            myStateMN.SetNewThongbao(Lap["Please select a row to view detail"]);
            return;
        }

        var rowView = SelectedItem as DataRowView;
        if (rowView != null)
        {
            SelectedId_hd = rowView["id_hd"]?.ToString() ?? "";
            SelectedSo_ct0 = rowView["so_ct0"]?.ToString() ?? "";            

            var ngayCtValue = rowView["ngay_ct0"];
            if (ngayCtValue != null && ngayCtValue != DBNull.Value)
            {
                if (DateTime.TryParse(ngayCtValue.ToString(), out DateTime parsedDate))
                {
                    SelectedNgay_ct0 = parsedDate;
                }
                else if (ngayCtValue.ToString().Length == 8)
                {
                    if (DateTime.TryParseExact(ngayCtValue.ToString(), "yyyyMMdd", 
                        System.Globalization.CultureInfo.InvariantCulture, 
                        System.Globalization.DateTimeStyles.None, out parsedDate))
                    {
                        SelectedNgay_ct0 = parsedDate;
                    }
                }
            }

            NoteContent = myDb.GetValue($"SELECT ghi_chu_loi FROM ph92 WHERE id_hd = '{SelectedId_hd}'").ToString().Trim() ;

            if (!string.IsNullOrEmpty(SelectedId_hd))
            {
                IsShowNotePopup = true;
                StateHasChanged();
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["No data selected"]);
            }
        }
    }

    private async void SaveNote()
    {
        try
        {            
            string escapedNote = (NoteContent ?? "").Replace("'", "''");

            string sqlUpdate = $"UPDATE ph92 SET ghi_chu_loi = N'{escapedNote}' WHERE id_hd = '{SelectedId_hd}'";

            await myDb.ExecuteSqlQueryAsync(sqlUpdate);

            myStateMN.SetNewThongbao(Lap["Saved successfully"]); 
            IsShowNotePopup = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Error. can not save"]}: {ex.Message}");
        }
    }

    private void CancelNote()
    {
        IsShowNotePopup = false;
        NoteContent = "";
        SelectedId_hd = "";
        SelectedSo_ct0 = "";
        SelectedNgay_ct0 = null;
        StateHasChanged();
    }
    private void View()
    {
        if (SelectedItem == null)
        {
            myStateMN.SetNewThongbao(Lap["Please select a row to view detail"]);
            return;
        }

        var rowView = SelectedItem as DataRowView;
        if (rowView != null)
        {
            SelectedId_hd = rowView["id_hd"]?.ToString() ?? "";
            if (!string.IsNullOrEmpty(SelectedId_hd))
            {
                IsShowFrmViewInvoice = true;
                StateHasChanged();
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["No data selected"]);
            }
        }
    }
    private void OnSearchChanged(string value)
    {
        GridSearchText = value;
        StateHasChanged();
    }

    private async void DelteVc()
    {
        if (SelectedItem == null)
        {
            myStateMN.SetNewThongbao(Lap["Please select a row to view detail"]);
            return;
        }

        var rowView = SelectedItem as DataRowView;
        if (rowView == null)
            return;

        string id_hd = rowView["id_hd"]?.ToString() ?? "";
        string so_ct0 = rowView["so_ct0"]?.ToString() ?? "";
        string ma_dvcs = rowView["ma_dvcs"]?.ToString()?.Trim() ?? "";
        string current_ma_dvcs = myStateMN.GetMa_Dvcs()?.Trim() ?? "";

        if (string.IsNullOrEmpty(id_hd))
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }

        if (ma_dvcs != current_ma_dvcs)
        {
            myStateMN.SetNewThongbao(Lap["Invoice does not belong to the current unit"] + " !");
            return;
        }

        string sqlCheckHtkt = $"Exec POImexInv_IsHtkt '{id_hd}'";
        var checkResult = myDb.GetValue(sqlCheckHtkt);
        if (checkResult != null && !string.IsNullOrEmpty(checkResult.ToString().Trim()))
        {
            myStateMN.SetNewThongbao(Lap["Invoices have been recorded, cannot be deleted"] + "!");
            return;
        }

        string MessageDl = string.Format(Lap["Do you want to delete :{0} ?"].Value, so_ct0);
        bool? ResultDl = await myDlSvc.ConfirmAsync(new MessageBoxOptions()
        {
            Text = MessageDl,
            Title = Lap["Confirm deletion of voucher"].Value,
            OkButtonText = Lap["OK"].Value,
            CancelButtonText = Lap["Cancel"].Value,
            ShowIcon = true,
            ShowCloseButton = false,
            RenderStyle = MessageBoxRenderStyle.Danger,
        });

        if (ResultDl != true)
            return;

        try
        {            
            string sqlDelete = $"EXEC dbo.POImexInv_DelBulk '(''{id_hd}'')'";
            await myDb.ExecuteSqlQueryAsync(sqlDelete);

            string successMsg = Lap["Delete successfully : {0}"].Value.Replace("{0}", so_ct0);
            myStateMN.SetNewThongbao(successMsg);

            await Loaddata(false);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Error. can not save"].Value}: {ex.Message}");
        }
    }
    private async void CheckSellerinfo()
    {
        if (SelectedItem == null)
        {
            myStateMN.SetNewThongbao(Lap["Please select a row to view detail"]);
            return;
        }

        var rowView = SelectedItem as DataRowView;
        if (rowView == null)
            return;

        string mst_ban = rowView["mst_ban"]?.ToString()?.Trim() ?? "";
        
        if (string.IsNullOrEmpty(mst_ban))
        {
            myStateMN.SetNewThongbao(Lap["No seller tax code"]);
            return;
        }
        
        ClassMasothue infoMst = GetDatafromSISAPI(@"http://help.sis.vn:7785/AP/getmasothue/" + mst_ban);
        try
        {            
            if (infoMst == null || String.IsNullOrEmpty(infoMst.MaSoThue))
            {
                myStateMN.SetNewThongbao(Lap["No information found for tax code"]);
                return;
            }

            await ShowSellerInfoPopup(mst_ban, infoMst);
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["No access to the server"]}: {ex.Message}");
        }
    }
    private ClassMasothue GetDatafromSISAPI(string url)
    {
        ClassMasothue custom = null;
        try
        {
            WebRequest request = WebRequest.Create(url);            
            WebResponse response = request.GetResponse();
            string status = ((HttpWebResponse)response).StatusDescription;
            using (Stream dataStream = response.GetResponseStream())
            {
                StreamReader reader = new StreamReader(dataStream);
                string responseFromServer = reader.ReadToEnd();
                custom = JsonConvert.DeserializeObject<ClassMasothue>(responseFromServer);
            }            
            response.Close();
            return custom;
        }
        catch (Exception ex)
        {
            return custom;
        }

    }

