@page "/POImexInv"
@page "/POImexInv/{Menu_id}"
@inherits ListBaseComponent
@using System.Net
@using Newtonsoft.Json
@attribute [Authorize(Roles = "admin,poimexinv")]

<DxLayoutBreakpoint MaxWidth="1200" @bind-IsActive="@IsMobileLayout" />

<div class="form-main">
<div class="form-control form-control-sm form-toolbar" @onkeydown="KeyPress">
    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain" ItemClick="@OnToolbarItemClick" Title="">
            <TitleTemplate>
                @if (!IsMobileLayout)
                {
                    
                }
            </TitleTemplate>
            <Items>
                <DxToolbarItem Name="btnSearch" IconCssClass="tb-icon tb-icon-search" class="tb-search"
                    Tooltip="F5" Text="@Lap["Search"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                </DxToolbarItem>
                <DxToolbarItem Name="btnRefresh" IconCssClass="tb-icon tb-icon-note" class="tb-refresh"
                    Tooltip="F9" Text="@Lap["Note"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                </DxToolbarItem>
                <DxToolbarItem Name="btnDelete" IconCssClass="tb-icon tb-icon-del" class="tb-del"
                    Tooltip="Delete" Text="@Lap["Delete"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                </DxToolbarItem>
                <DxToolbarItem Name="btnView" IconCssClass="tb-icon tb-icon-view" class="tb-view"
                    Tooltip="View" Text="@Lap["View"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                </DxToolbarItem>
                <DxToolbarItem Name="btnProcess" IconCssClass="tb-icon tb-icon-process" class="tb-process"
                    Tooltip="Process" Text="@Lap["Process"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                    <Items>
                        <DxToolbarItem Name="btnProcess1" Text="@Lap["Login system"]" Click="@((ToolbarItemClickEventArgs e) => OnProcessSubClick("login"))" />
                        <DxToolbarItem Name="btnProcess2" Text="@Lap["Get data from TCT"]" Click="@((ToolbarItemClickEventArgs e) => OnProcessSubClick("getdata"))" />
                        <DxToolbarItem Name="btnProcess3" Text="@Lap["Check seller info"]" Click="@((ToolbarItemClickEventArgs e) => OnProcessSubClick("checkseller"))" />
                       @*  <DxToolbarItem Name="btnProcess4" Text="@Lap["Update version"]" Click="@((ToolbarItemClickEventArgs e) => OnProcessSubClick("updateversion"))" /> *@
                    </Items>
                </DxToolbarItem>
                <DxToolbarItem Name="btnExport" IconCssClass="tb-icon tb-icon-export" class="tb-export"
                    Tooltip="Export" Text="@Lap["Export"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                </DxToolbarItem>
                <DxToolbarItem Name="btnReport" IconCssClass="tb-icon tb-icon-report" class="tb-report"
                    Tooltip="Report" Text="@Lap["Detail report"]"
                    Alignment="ToolbarItemAlignment.Left"
                    BeginGroup="true">
                </DxToolbarItem>

                <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right">
                    <Template>
                        <SearchItem SearchData="@OnSearchChanged" Placehoder="@searchPlaceholder" />
                    </Template>
                </DxToolbarItem>
            </Items>
        </DxToolbar>
    </div>
    
    <div class="row mt-1">
        <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" Page_size="@Page_size" IsPageSize="true" CssClass="grid-frm-height" Fbrowse="@fbrowse" SelectItem="@CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
    
</div>

<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@popFilterVisible"
         Width="500px"
         ShowFooter="true"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate Context="filterBodyContext">
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 5rem; height:5rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container pt-1">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From number"]">
                        <DxTextBox CssClass="col" @bind-Text="@So_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idTu_so" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To number"]">
                        <DxTextBox CssClass="col" @bind-Text="@So_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idDen_so" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    InputId="idTu_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>                    
                </DxFormLayout>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate Context="filterFooterContext">
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col mx-4" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnFilterOK" />
                <DxButton CssClass="col " RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnFilterCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@if (IsShowFrmLogin)
{
    <DxPopup @bind-Visible="@IsShowFrmLogin" CloseOnEscape="true" Width="500px" Height="auto" CloseOnOutsideClick="false"
             MinWidth="450px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
             MinHeight="200px"
             AllowResize="false"
             AllowDrag="true" ShowCloseButton="false"
             AllowDragByHeaderOnly="true"
             ShowFooter="false" ShowHeader="false"
             HeaderText="@Lap["Login"]">
        <BodyTemplate>
            <FrmLogin OnLoginSuccess="@HandleLoginSuccess" OnLoginCancel="@HandleLoginCancel" />
        </BodyTemplate>
    </DxPopup>
}

@if (IsShowFrmGetData)
{
    <DxPopup @bind-Visible="@IsShowFrmGetData" CloseOnEscape="true" Width="90vw" Height="85vh" CloseOnOutsideClick="false"
             MinWidth="800px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
             MinHeight="600px"
             MaxHeight="99vh"
             AllowResize="true"
             AllowDrag="true" ShowCloseButton="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="false"
             HeaderText="@Lap["Get Tax Invoice Data"]">
        <BodyTemplate>
            <FrmGetData OnDataReceived="@HandleDataReceived" Ma_ct="@Ma_ct" Token_TCT="@Token_TCT" IsLangEn="@IsLangEn" />
        </BodyTemplate>
    </DxPopup>
}

@if (IsShowFrmBKCT)
{
    <DxPopup @bind-Visible="@IsShowFrmBKCT" CloseOnEscape="true" Width="95vw" Height="90vh" CloseOnOutsideClick="false"
             MinWidth="1000px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
             MinHeight="700px"
             MaxHeight="99vh"
             AllowResize="true"
             AllowDrag="true" ShowCloseButton="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="false"
             CssClass="popup-bkct"
             HeaderText="@Lap["Detailed list"]">
        <BodyTemplate>
            <FrmBKCT Ma_ct="@Ma_ct" 
                     Com_mand="@curCommand" 
                     Token_TCT="@Token_TCT" 
                     IsLangEn="@IsLangEn" 
                     Ngay_ct1="@Ngay_ct1"
                     Ngay_ct2="@Ngay_ct2"
                     So_ct1="@So_ct1"
                     So_ct2="@So_ct2"
                     Ma_dvcs="@Ma_dvcs"
                     OnDataReceived="@HandleBKCTDataReceived" />
        </BodyTemplate>
    </DxPopup>
}

@if (IsShowFrmViewInvoice)
{
    <DxPopup @bind-Visible="@IsShowFrmViewInvoice" CloseOnEscape="true" Width="80vw" Height="800px" CloseOnOutsideClick="false"
             MinWidth="900px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
             MinHeight="700px"
             MaxHeight="90vh"
             AllowResize="true"
             AllowDrag="true" ShowCloseButton="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="false"
             HeaderText="@Lap["Purchase invoice information"]">
        <BodyTemplate>
            <FrmViewInvoice Id_hd="@SelectedId_hd" IsLangEn="@IsLangEn" OnClose="@HandleViewInvoiceClose" curActionTask="ActionTask.View"/>
        </BodyTemplate>
    </DxPopup>
}

@if (IsShowNotePopup)
{
    <DxPopup @bind-Visible="@IsShowNotePopup" CloseOnEscape="true" Width="600px" Height="auto" CloseOnOutsideClick="false"
             MinWidth="500px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
             MinHeight="250px"
             AllowResize="false"
             AllowDrag="true" ShowCloseButton="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="true"
             HeaderText="@Lap["Note"]">
        <BodyTemplate Context="notePopupContext">
            <div class="container pt-3 pb-2">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Invoice number"]">
                        <DxTextBox Text="@SelectedSo_ct0" ReadOnly="true" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Invoice date"]">
                        <DxDateEdit Date="@SelectedNgay_ct0" ReadOnly="true" DisplayFormat="dd-MM-yyyy" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Note"]">
                        <DxMemo @bind-Text="@NoteContent" Rows="5" MaxLength="500" 
                                NullText="@Lap["Note"]" 
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        </BodyTemplate>
        <FooterTemplate Context="noteFooterContext">
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col mx-2" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["Save"]" Click="@SaveNote" />
                <DxButton CssClass="col mx-2" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@CancelNote" />
            </div>
        </FooterTemplate>
    </DxPopup>
}

@if (IsShowSellerInfoPopup)
{
    <DxPopup @bind-Visible="@IsShowSellerInfoPopup" 
             CloseOnEscape="true" 
             Width="600px" 
             Height="auto" 
             CloseOnOutsideClick="false"
             MinWidth="500px" 
             HorizontalAlignment="HorizontalAlignment.Center" 
             VerticalAlignment="VerticalAlignment.Center"
             MinHeight="200px"
             AllowResize="false"
             AllowDrag="true" 
             ShowCloseButton="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="true"
             HeaderText="@Lap["Seller Information"]">
        <BodyTemplate>
            <div class="container pt-3 pb-2">
                <div class="seller-info">
                    <div class="info-row">
                        <span class="info-label">@Lap["Tax Code"]:</span>
                        <span class="info-value">@SellerInfo_MST</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">@Lap["Business Name"]:</span>
                        <span class="info-value">@SellerInfo_TenDN</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">@Lap["Address"]:</span>
                        <span class="info-value">@SellerInfo_DiaChi</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label info-label-status">@Lap["Status"]:</span>
                        <span class="info-value info-label-status">@SellerInfo_TrangThai</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">@Lap["Phone"]:</span>
                        <span class="info-value">@SellerInfo_SoDT</span>
                    </div>
                </div>
            </div>
        </BodyTemplate>
        <FooterTemplate>
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col-auto" RenderStyle="ButtonRenderStyle.Primary" Text="@Lap["OK"]" Click="@CloseSellerInfoPopup" />
            </div>
        </FooterTemplate>
    </DxPopup>
}

