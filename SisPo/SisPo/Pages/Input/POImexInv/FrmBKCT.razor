                .Select(g => g.OrderBy(row => row["ngay_ct0"]).First())
                .OrderBy(row => row["ngay_ct0"])
                .ToArray();

            if (checkedRows.Length == 0)
            {
                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = Lap["Please select invoices to create"],
                    Title = Lap["Warning"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Warning
                });
                return;
            }

