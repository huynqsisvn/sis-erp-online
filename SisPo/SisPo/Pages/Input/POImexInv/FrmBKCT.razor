@code {

    [Parameter] public string Ma_ct { get; set; }
    [Parameter] public Command Com_mand { get; set; }
    [Parameter] public string Token_TCT { get; set; }
    [Parameter] public bool IsLangEn { get; set; }
    [Parameter] public DateTime Ngay_ct1 { get; set; }
    [Parameter] public DateTime Ngay_ct2 { get; set; }
    [Parameter] public string So_ct1 { get; set; }
    [Parameter] public string So_ct2 { get; set; }
    [Parameter] public string Ma_dvcs { get; set; }
    [Parameter] public EventCallback<DataSet> OnDataReceived { get; set; }

    private FrmBrowse3Component oBrowse;
    private FrmCreatePurchaseInvoiceDialog createInvoiceDialog;
    private FrmUpdateValueDialog updateValueDialog;
    private DataTable InvoiceData;
    private DataSet dataSet = new DataSet();
    private List<InvoiceItem> InvoiceList;
    private bool IsLoading = false;
    private string strBrowseBKCT = "";

    protected override void OnInitialized()
    {
        // Set browse string
        if (Com_mand != null)
        {
            if (!IsLangEn)
            {
                strBrowseBKCT = Com_mand.Vbrowse2?.Trim() ?? "";
            }
            else
            {
                strBrowseBKCT = Com_mand.Ebrowse2?.Trim() ?? "";
            }
        }

        // Load initial data with parameters from parent
        _ = LoadBKCTData(true);

        base.OnInitialized();
    }

    private async Task LoadBKCTData(bool isFirstLoad)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            string sqlCmd = "POImexInv_LoadBkhddvTCT";
            var parameters = new Dictionary<string, object>
            {
                { "@Ngay_ct1", Ngay_ct1.ToString("yyyyMMdd") },
                { "@Ngay_ct2", Ngay_ct2.ToString("yyyyMMdd") },
                { "@So_ct1", So_ct1 ?? "" },
                { "@So_ct2", So_ct2 ?? "" },
                { "@Ma_dvcs", Ma_dvcs ?? "" }
            };

            DataSet ds = await myDb.LoadDataset(sqlCmd, parameters);
            if (ds != null && ds.Tables.Count > 0)
            {
                InvoiceData = ds.Tables[0].Copy();
                InvoiceData.TableName = "tbDetail";
                InvoiceList = ConvertToInvoiceList(InvoiceData);

                dataSet = ds;

                if (InvoiceList == null || InvoiceList.Count == 0)
                {
                    myStateMN?.SetNewThongbao(Lap["No invoices found"]);
                }
                else
                {
                    myStateMN?.SetNewThongbao(string.Format(Lap["Found {0} invoices"], InvoiceList.Count));
                }
            }
        }
        catch (Exception ex)
        {
            myStateMN?.SetNewThongbao($"{Lap["Load error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void OnToolbarItemClick(ToolbarItemClickEventArgs e)
    {
        switch (e.ItemName)
        {
            case "btnRefresh":
                _ = LoadBKCTData(false);
                break;
            case "btnUpdateValue":
                UpdateValue();
                break;
            case "btnCreatePurchase":
                await CreatePurchaseInvoice();
                break;
            case "btnCreateService":
                CreateServiceInvoice();
                break;
            case "btnExport":
                oBrowse?.ExPortGrid(1);
                myStateMN.SetNewThongbao(Lap["Export successfully"]);
                break;
        }
    }

    private async void UpdateValue()
    {
        try
        {
            if (InvoiceData == null || InvoiceData.Rows.Count == 0)
            {
                myStateMN?.SetNewThongbao(Lap["No data available"]);
                return;
            }

            var checkedRows = InvoiceData.AsEnumerable()
                .Where(row => row.Table.Columns.Contains("chon") && Convert.ToBoolean(row["chon"]))
                .ToArray();

            if (checkedRows.Length == 0)
            {
                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = Lap["Please select invoices to create"],
                    Title = Lap["Warning"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Warning
                });
                return;
            }

            // Show update value dialog
            var dialogParams = new Dictionary<string, object>
            {
                { "OldValue", "" },
                { "Field", "ma_kh" },
                { "IsLangEn", IsLangEn }
            };

            var result = await updateValueDialog.ShowAsync(dialogParams);

            if (result == null || !result.ContainsKey("IsOk") || !(bool)result["IsOk"])
            {
                return;
            }

            string fieldToUpdate = result["Field"]?.ToString() ?? "";
            string newValue = result["NewValue"]?.ToString() ?? "";
            string dvt1 = result["Dvt1"]?.ToString() ?? "";
            string heSo = result["HeSo"]?.ToString() ?? "";

            if (string.IsNullOrWhiteSpace(fieldToUpdate) || string.IsNullOrWhiteSpace(newValue))
            {
                return;
            }

            bool confirmUpdate = await myDlSvc.ConfirmAsync(new MessageBoxOptions
            {
                Text = IsLangEn ? "Do you want to update the data?" : "Có muốn cập nhật số liệu không?",
                Title = Lap["Confirm"],
                OkButtonText = Lap["Yes"],
                CancelButtonText = Lap["No"],
                ShowIcon = true
            });

            if (!confirmUpdate)
            {
                return;
            }

            IsLoading = true;
            StateHasChanged();

            int successCount = 0;
            int errorCount = 0;

            foreach (var row in checkedRows)
            {
                try
                {
                    string invGuid = row["inv_guid"]?.ToString().Trim() ?? "";
                    if (string.IsNullOrEmpty(invGuid)) continue;

                    // Update in database
                    string updateSql = $"UPDATE bkhddvtct SET [{fieldToUpdate}] = @Value, dvt1 = @Dvt1 WHERE inv_guid = @InvGuid";
                    var parameters = new Dictionary<string, object>
                    {
                        { "@Value", newValue.Trim() },
                        { "@Dvt1", dvt1 },
                        { "@InvGuid", invGuid }
                    };

                    await myDb.LoadDataset(updateSql, parameters);

                    row[fieldToUpdate] = newValue.Trim();
                    if (fieldToUpdate == "ma_vt")
                    {
                        row["dvt1"] = dvt1;
                    }

                    successCount++;
                }
                catch (Exception ex)
                {
                    errorCount++;
                }
            }

            IsLoading = false;

            if (successCount > 0)
            {
                InvoiceData.AcceptChanges();
                StateHasChanged();

                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = $"{(IsLangEn ? "Successfully updated" : "Cập nhật thành công")} {successCount} {(IsLangEn ? "records" : "bản ghi")}",
                    Title = Lap["Information"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Info
                });
            }

            if (errorCount > 0)
            {
                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = $"{(IsLangEn ? "Failed to update" : "Cập nhật thất bại")} {errorCount} {(IsLangEn ? "records" : "bản ghi")}",
                    Title = Lap["Error"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Danger
                });
            }
        }
        catch (Exception ex)
        {
            IsLoading = false;
            myStateMN?.SetNewThongbao($"{Lap["Error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreatePurchaseInvoice()
    {
        try
        {
            if (InvoiceData == null || InvoiceData.Rows.Count == 0)
            {
                myStateMN?.SetNewThongbao(Lap["No data available"]);
                return;
            }

            DataView dataView = InvoiceData.DefaultView;

            var checkedRows = InvoiceData.AsEnumerable()
                .Where(row => row.Table.Columns.Contains("chon") && Convert.ToBoolean(row["chon"]))
                .GroupBy(row => row["id_hd"]?.ToString()?.Trim())
                .Select(g => g.OrderBy(row => row["ngay_ct0"]).First())
                .OrderBy(row => row["ngay_ct0"])
                .ToArray();

            if (checkedRows.Length == 0)
            {
                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = Lap["Please select invoices to create"],
                    Title = Lap["Warning"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Warning
                });
                return;
            }

            var missingCustomer = checkedRows.Where(row => string.IsNullOrWhiteSpace(row["ma_kh"]?.ToString())).ToArray();
            if (missingCustomer.Length > 0)
            {
                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = Lap["Some invoices are missing customer code on accounting software"],
                    Title = Lap["Warning"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Warning
                });
                return;
            }

            var missingProduct = checkedRows.Where(row => string.IsNullOrWhiteSpace(row["ma_vt"]?.ToString())).ToArray();
            if (missingProduct.Length > 0)
            {
                await myDlSvc.AlertAsync(new MessageBoxOptions
                {
                    Text = Lap["Some invoices are missing product code on accounting software"],
                    Title = Lap["Warning"],
                    OkButtonText = Lap["OK"],
                    ShowIcon = true,
                    RenderStyle = MessageBoxRenderStyle.Warning
                });
                return;
            }

            string list_id_hd = string.Join(",", checkedRows
                .Where(row => !string.IsNullOrWhiteSpace(row["id_hd"]?.ToString()))
                .Select(row => row["id_hd"].ToString().Trim())
                .Distinct());

            if (!string.IsNullOrEmpty(list_id_hd))
            {
                string checkExistCmd = $"select stt_rec from ph71 where id_hd in (select Items from [dbo].[Split](@list_id_hd,',')) UNION select stt_rec from ph31 where id_hd in (select Items from [dbo].[Split](@list_id_hd,','))";
                var existingVouchers = await myDb.LoadDataset(checkExistCmd, new Dictionary<string, object>
                {
                    { "@list_id_hd", list_id_hd }
                });

                if (existingVouchers?.Tables.Count > 0 && existingVouchers.Tables[0].Rows.Count > 0)
                {
                    bool confirmRecreate = await myDlSvc.ConfirmAsync(new MessageBoxOptions
                    {
                        Text = Lap["Invoices already exist. Do you want to recreate them?"],
                        Title = Lap["Confirm"],
                        OkButtonText = Lap["Yes"],
                        CancelButtonText = Lap["No"],
                        ShowIcon = true,
                        RenderStyle = MessageBoxRenderStyle.Warning
                    });

                    if (!confirmRecreate)
                    {
                        return;
                    }

                    foreach (DataRow voucherRow in existingVouchers.Tables[0].Rows)
                    {
                        string sttRec = voucherRow["stt_rec"].ToString().Trim();
                        string deleteCmd = $"EXEC [DeleteVoucher] 'PNA', '{sttRec}'";
                        await myDb.ExecuteSqlQueryAsync(deleteCmd);
                    }
                }
            }

            string ma_qs_default = "";
            string ma_qs_pc_default = "";
            string ma_kho_default = "";
            string tk_co_default = "";
            string tk_no_default = "";

            try
            {
                ma_qs_default = myStateMN.GetItem("M_HDDVTCT_MA_QS_PNA")?.ToString() ?? "";
                ma_qs_pc_default = myStateMN.GetItem("M_HDDVTCT_MA_QS_PC")?.ToString() ?? "";
                ma_kho_default = myStateMN.GetItem("M_HDDVTCT_MA_KHO_PNA")?.ToString() ?? "";
                tk_co_default = myStateMN.GetItem("M_HDDVTCT_TK_CO")?.ToString() ?? "";
                tk_no_default = myStateMN.GetItem("M_HDDVTCT_TK_NO")?.ToString() ?? "";
            }
            catch
            {
                // Use empty defaults if options are not available
            }

            string invoiceNumbers = string.Join(", ", checkedRows.Select(r => r["so_ct0"]?.ToString().Trim()).Distinct());

            var dialogParams = new Dictionary<string, object>
            {
                { "Ma_qs", ma_qs_default },
                { "Ma_qs_pc", ma_qs_pc_default },
                { "Ma_kho", ma_kho_default },
                { "Tk_co", tk_co_default },
                { "Tk_no", tk_no_default },
                { "InvoiceNumbers", invoiceNumbers },
                { "UserId", myStateMN.GetCurUser().User_id },
                { "IsLangEn", IsLangEn }
            };

            var result = await ShowCreateInvoiceDialog(dialogParams);

            if (result != null && result.ContainsKey("IsOk") && (bool)result["IsOk"])
            {
                string ma_qs = result["Ma_qs"]?.ToString().Trim() ?? "";
                string ma_qs_pc = result["Ma_qs_pc"]?.ToString().Trim() ?? "";
                string tk_no = result["Tk_no"]?.ToString().Trim() ?? "";
                string tk_co = result["Tk_co"]?.ToString().Trim() ?? "";
                string ma_kho = result["Ma_kho"]?.ToString().Trim() ?? "";
                IsLoading = true;
                StateHasChanged();

                myStateMN.SetItem("M_HDDVTCT_MA_QS_PNA", ma_qs);
                myStateMN.SetItem("M_HDDVTCT_MA_QS_PC", ma_qs_pc);
                myStateMN.SetItem("M_HDDVTCT_MA_KHO_PNA", ma_kho);
                myStateMN.SetItem("M_HDDVTCT_TK_CO", tk_co);
                myStateMN.SetItem("M_HDDVTCT_TK_NO", tk_no);

                string msg_success = "";
                string msg_error = "";
                int count_success = 0;
                int count_error = 0;
                Ma_dvcs = myStateMN.GetDvcs().Ma_dvcs;
                

                foreach (var row in checkedRows)
                {
                    try
                    {
                        string id_hd = row["id_hd"]?.ToString().Trim() ?? "";
                        string so_ct = row["so_ct0"]?.ToString().Trim() ?? "";

                        if (string.IsNullOrEmpty(id_hd)) continue;

                        var parameters = new Dictionary<string, object>
                        {
                            { "@List", id_hd },
                            { "@Ma_dvcs", Ma_dvcs },
                            { "@user_id", myStateMN.GetCurUser().User_id },
                            { "@Ma_qs", ma_qs },
                            { "@Tk_co", tk_co },
                            { "@Tk_no", tk_no },
                            { "@Ma_kho", ma_kho }
                        };

                        var resultDs = await myDb.LoadDataset("BKHDDVTCT_CREATE_PNA", parameters);

                        if (resultDs?.Tables.Count > 0 && resultDs.Tables[resultDs.Tables.Count - 1].Rows.Count > 0)
                        {
                            string yn = resultDs.Tables[resultDs.Tables.Count - 1].Rows[0]["YN"]?.ToString().Trim() ?? "0";
                            
                            if (yn == "1")
                            {
                                count_success++;
                                msg_success += (string.IsNullOrEmpty(msg_success) ? "" : "; ") + so_ct;

                                if (!string.IsNullOrEmpty(ma_qs_pc))
                                {
                                    string createPcCmd = $"EXEC [dbo].[BKHDDVTCT_PNA_TAOPC] '{id_hd}', '{ma_qs_pc}'";
                                    await myDb.ExecuteSqlQueryAsync(createPcCmd);
                                }
                            }
                            else
                            {
                                count_error++;
                                msg_error += (string.IsNullOrEmpty(msg_error) ? "" : "; ") + so_ct;
                            }
                        }
                        else
                        {
                            count_error++;
                            msg_error += (string.IsNullOrEmpty(msg_error) ? "" : "; ") + so_ct;
                        }
                    }
                    catch (Exception ex)
                    {
                        count_error++;
                        string so_ct = row["so_ct0"]?.ToString().Trim() ?? "";
                        msg_error += (string.IsNullOrEmpty(msg_error) ? "" : "; ") + so_ct;
                    }
                }

                IsLoading = false;

                if (!string.IsNullOrEmpty(msg_success))
                {
                    await myDlSvc.AlertAsync(new MessageBoxOptions
                    {
                        Text = $"{Lap["Successfully created"]} ({count_success} {Lap["invoices"]}): {msg_success}",
                        Title = Lap["Information"],
                        OkButtonText = Lap["OK"],
                        ShowIcon = true,
                        RenderStyle = MessageBoxRenderStyle.Info
                    });
                }

                if (!string.IsNullOrEmpty(msg_error))
                {
                    await myDlSvc.AlertAsync(new MessageBoxOptions
                    {
                        Text = $"{Lap["Failed to create"]} ({count_error} {Lap["invoices"]}): {msg_error}",
                        Title = Lap["Error"],
                        OkButtonText = Lap["OK"],
                        ShowIcon = true,
                        RenderStyle = MessageBoxRenderStyle.Danger
                    });
                }

                //await LoadBKCTData(false);
            }
        }
        catch (Exception ex)
        {
            IsLoading = false;
            myStateMN?.SetNewThongbao($"{Lap["Error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task<Dictionary<string, object>> ShowCreateInvoiceDialog(Dictionary<string, object> parameters)
    {
        // Parameters are already set in CreatePurchaseInvoice method
        var result = await createInvoiceDialog.ShowAsync(parameters);
        return result;
    }

