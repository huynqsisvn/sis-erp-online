@using System.Data
@using System.Data.SqlClient
@using System.Net.Http.Headers
@using System.Linq
@inject XmlStringLocalizer Lap
@inject IDbManager myDb
@inject Statemanagerment myStateMN
@inject IOptionsManager myOptions
@inject ISysVarManager mySysVars
@inject IWebHostEnvironment myHost
@inject IDialogService myDlSvc

<FrmCreatePurchaseInvoiceDialog @ref="createInvoiceDialog" />
<FrmUpdateValueDialog @ref="updateValueDialog" />

<div class="form-wrapper">
    @if (IsLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2">@Lap["Loading invoice data"]...</p>
        </div>
    }
    else if (InvoiceList != null && InvoiceList.Count > 0)
    {
        <div class="toolbar-container">
            <div class="form-toolbar">
                <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain" ItemClick="@OnToolbarItemClick">
                    <Items>
                        <DxToolbarItem Name="btnRefresh" IconCssClass="tb-icon tb-icon-refresh" class="tb-btn"
                                       Tooltip="F9" Text="@Lap["Refresh"]"
                                       Alignment="ToolbarItemAlignment.Left"
                                       BeginGroup="true">
                        </DxToolbarItem>
                        <DxToolbarItem Name="btnUpdateValue" IconCssClass="tb-icon tb-icon-update" class="tb-btn"
                                       Tooltip="F4" Text="@Lap["Update value"]"
                                       Alignment="ToolbarItemAlignment.Left"
                                       BeginGroup="true">
                        </DxToolbarItem>
                        <DxToolbarItem Name="btnCreatePurchase" IconCssClass="tb-icon tb-icon-add" class="tb-btn"
                                       Tooltip="F5" Text="@Lap["Create purchase invoice"]"
                                       Alignment="ToolbarItemAlignment.Left"
                                       BeginGroup="true">
                        </DxToolbarItem>
                        <DxToolbarItem Name="btnCreateService" IconCssClass="tb-icon tb-icon-add" class="tb-btn"
                                       Tooltip="F6" Text="@Lap["Create service invoice"]"
                                       Alignment="ToolbarItemAlignment.Left"
                                       BeginGroup="true">
                        </DxToolbarItem>
                        <DxToolbarItem Name="btnExport" IconCssClass="tb-icon tb-icon-export" class="tb-btn"
                                       Tooltip="Export" Text="@Lap["Export"]"
                                       Alignment="ToolbarItemAlignment.Left"
                                       BeginGroup="true">
                        </DxToolbarItem>
                    </Items>
                </DxToolbar>
            </div>
        </div>

        <div class="grid-container">
            <div class="grid-scroll-wrapper">
                <FrmBrowse3Component @ref="oBrowse" TblData="@InvoiceData" Page_size="15" IsPageSize="true" CssClass="invoice-grid" Fbrowse="@strBrowseBKCT" SelectCol="chon" IsLangEn="@IsLangEn" RowStyleFunc="@GetRowStyle" />
            </div>
        </div>

        <div class="button-container">            
            <DxButton CssClass="col-auto" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Close"]" Click="@OnClose" />
        </div>
    }
    else
    {
        <div class="alert alert-info m-2">
            <p>@Lap["No data"]</p>
        </div>
    }
</div>

<style>
