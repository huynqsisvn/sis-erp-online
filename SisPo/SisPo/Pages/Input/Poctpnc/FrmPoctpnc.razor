                                                                    var _Ct73 = (Ct73)GrdContext.EditModel;
                                                                }
                                                                <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct73.Cp_nt" ValueExpression="@(() => _Ct73.Cp_nt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Cp_nt"); })" Id="Cp_nt" DisplayFormat="@M_IP_TIEN_NT" Format="@M_IP_TIEN"></DxSpinEdit>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                        <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Cp" Caption="@String.Concat(Lap["Charges"], " ", M_ma_nt0.Trim())" Width="120" DisplayFormat="@M_IP_TIEN" >
