                    }

                }
                else
                    CurrentEditModel.Ton13 = 0;

                break;

            case "ma_lo":
                CurrentEditModel.Ma_lo = value.Where(a => a.Key.Equals("ma_lo")).FirstOrDefault().Value?.ToString() ?? "";
                CurrentEditModel.Han_sd_lot = DateTime.TryParse(value.Where(a => a.Key.Equals("ngay_hh")).FirstOrDefault().Value?.ToString() ?? "", out var han_sd) ? han_sd : (DateTime?)null;
