    public async void PhanBo()
    {
        var listCp = LSCt.Where(x => x.Stt_rec == CurPh.Stt_rec).ToList();
        if (!listCp.Any()) return;

        decimal t_cp = CurPh.T_cp;
        decimal t_cp_nt = CurPh.T_cp_nt;
        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);

        int loai_pb = Convert.ToInt32(CurPh.Loai_pb);
        if (loai_pb != 1 && loai_pb != 2) return;

        decimal da_phanbo = 0m;
        decimal da_phanbo_nt = 0m;

        // === 1. Phân bổ theo loại ===
        if (loai_pb == 1) // Theo tiền
        {
            decimal tong_tien0 = listCp.Sum(x => x.Tien0);
            decimal tong_tien_nt0 = listCp.Sum(x => x.Tien_nt0);

            foreach (var row in listCp)
            {
                decimal tien0 = row.Tien0;
                decimal tien_nt0 = row.Tien_nt0;

                decimal cp_nt = tong_tien_nt0 == 0m ? 0m : Math.Round(tien_nt0 / tong_tien_nt0 * t_cp_nt, M_ROUND_NT);

                decimal cp = (tien_nt0 != 0m && tong_tien_nt0 != 0m)
                    ? Math.Round(cp_nt * ty_gia, M_ROUND)
                    : (tong_tien0 == 0m ? 0m : Math.Round(tien0 / tong_tien0 * t_cp, M_ROUND));

                row.Cp_nt = cp_nt;
                row.Cp = cp;

                row.Tien_nt = tien_nt0 + cp_nt;
                row.Tien = tien0 + cp;

                da_phanbo_nt += cp_nt;
                da_phanbo += cp;
            }
        }
        else if (loai_pb == 2) // Theo số lượng
        {
            decimal tong_sl = listCp.Sum(x => x.So_luong);

            if (tong_sl == 0m) return;

            foreach (var row in listCp)
            {
                decimal sl = row.So_luong;
                decimal tien0 = row.Tien0;
                decimal tien_nt0 = row.Tien_nt0;

                decimal cp_nt = Math.Round(sl / tong_sl * t_cp_nt, M_ROUND_NT);
                decimal cp = cp_nt != 0m
                    ? Math.Round(cp_nt * ty_gia, M_ROUND)
                    : Math.Round(sl / tong_sl * t_cp, M_ROUND);

                row.Cp_nt = cp_nt;
                row.Cp = cp;

                row.Tien_nt = tien_nt0 + cp_nt;
                row.Tien = tien0 + cp;

                da_phanbo_nt += cp_nt;
                da_phanbo += cp;
            }
        }

        // === 2. Bù chênh lệch làm tròn vào dòng đầu tiên ===
        if (listCp.Count > 0)
        {
            listCp[0].Cp_nt += (t_cp_nt - da_phanbo_nt);
            listCp[0].Cp += (t_cp - da_phanbo);
            listCp[0].Tien_nt = listCp[0].Tien_nt0 + listCp[0].Cp_nt;
            listCp[0].Tien = listCp[0].Tien0 + listCp[0].Cp;
        }

        // === 3. Cập nhật lại đơn giá (giá sau khi cộng chi phí) ===
        foreach (var row in listCp)
        {
            decimal sl = row.So_luong;
            decimal gia_nt0 = row.Gia_nt0;
            decimal gia0 = row.Gia0;
            decimal cp_nt = row.Cp_nt;
            decimal cp = row.Cp;

            row.Gia_nt = sl > 0m ? gia_nt0 + Math.Round(cp_nt / sl, M_ROUND_GIA_NT) : gia_nt0;
            row.Gia = sl > 0m ? gia0 + Math.Round(cp / sl, M_ROUND_GIA) : gia0;
        }

        UpdateTotalHT();
        StateHasChanged();
    }
    public void btnChonpn_Click()
    {
        if (!AllowEditMode) return;
        // Default filter dates
        _filter_pn_ngay_ct1 = DateTime.Now.Date.AddMonths(-1);
        _filter_pn_ngay_ct2 = DateTime.Now.Date;
        _filter_pn_so_ct1 = "";
        _filter_pn_so_ct2 = "";
        _filter_pn_ma_kh = CurPh.Ma_kh ?? "";
        _filter_pn_ten_kh = "";
        _pn_filter_result = null;
        VisibleTimPN = true;
        StateHasChanged();
    }

    private string GetPhFilterExpr()
    {
        string filter = " 1=1 ";
        if (!string.IsNullOrEmpty(CurPh.Ma_dvcs))
            filter += $" and ma_dvcs like '{CurPh.Ma_dvcs.Trim()}%'";
        if (_filter_pn_ngay_ct1.HasValue)
            filter += $" and ngay_ct >= '{_filter_pn_ngay_ct1.Value:yyyyMMdd}'";
        if (_filter_pn_ngay_ct2.HasValue)
            filter += $" and ngay_ct <= '{_filter_pn_ngay_ct2.Value:yyyyMMdd}'";
        if (!string.IsNullOrWhiteSpace(_filter_pn_so_ct1))
            filter += $" and so_ct >= '{_filter_pn_so_ct1.Trim()}'";
        if (!string.IsNullOrWhiteSpace(_filter_pn_so_ct2))
            filter += $" and so_ct <= '{_filter_pn_so_ct2.Trim()}'";
        if (!string.IsNullOrWhiteSpace(_filter_pn_ma_kh))
            filter += $" and ma_kh = '{_filter_pn_ma_kh.Trim()}'";
        return filter;
    }

    private async Task btnTimPN_Search()
    {
        try
        {
            string phFilter = GetPhFilterExpr();
            DataSet ds = await myDb.LoadDataset("exec LoadVoucher#3 @PhFilter",
                new Dictionary<string, object> { ["@PhFilter"] = phFilter });
            _pn_filter_result = ds?.Tables.Count > 0 ? ds.Tables[0] : null;
            _pn_ct_result = ds?.Tables.Count > 1 ? ds.Tables[1] : null;
            _pn_selected_rows = new HashSet<string>();
            _selected_pn_stt_rec = "";
            if (_pn_ct_result != null)
                _pn_ct_result.DefaultView.RowFilter = "1=0";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Error" + ":" + ex.Message);
        }
    }

    private async Task btnTimPN_Ok()
    {
        if (_pn_filter_result == null || _pn_selected_rows == null || _pn_selected_rows.Count == 0)
        {
            VisibleTimPN = false;
            StateHasChanged();
            return;
        }
        try
        {
            // Clear existing CT rows
            LSCt.Clear();
            int stt = 0;
            string upper1 = CurPh.Ma_nt?.Trim().ToUpper() ?? "";
            decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;

            DataRow firstChecked = _pn_filter_result.Rows.Cast<DataRow>().FirstOrDefault(r => _pn_selected_rows.Contains(r["stt_rec"].ToString()));
            if (firstChecked != null)
            {
                CurPh.Stt_rec_pn = firstChecked["stt_rec"].ToString();
                CurPh.So_pn      = firstChecked["so_ct"].ToString();
                CurPh.Ngay_pn    = firstChecked["ngay_ct"] as DateTime?;
                CurPh.Ma_kh_pn   = firstChecked["ma_kh"].ToString();
                CurPh.Ten_kh_pn  = _pn_filter_result.Columns.Contains("ten_kh")
                                    ? firstChecked["ten_kh"].ToString() : "";
            }

            foreach (DataRow phRow in _pn_filter_result.Rows)
            {
                string stt_rec_pn = phRow["stt_rec"].ToString();
                if (!_pn_selected_rows.Contains(stt_rec_pn)) continue;

                string upper2 = phRow["ma_nt"].ToString().Trim().ToUpper();
                decimal ty_gia_pn = Convert.ToDecimal(phRow["ty_gia"]);

                // Load CT rows for this PN from already-fetched detail table
                if (_pn_ct_result == null) continue;
                var ctRows = _pn_ct_result.Rows.Cast<DataRow>()
                    .Where(r => r["stt_rec"].ToString() == stt_rec_pn).ToList();
                if (ctRows.Count == 0) continue;

                foreach (DataRow ctRow in ctRows)
                {
                    stt++;
                    Ct73 newCt = new Ct73();
                    newCt.Stt = stt;
                    newCt.Stt_rec0 = string.Format("{0:0000}", stt);
                    newCt.Stt_rec = CurPh.Stt_rec;
                    newCt.So_ct = CurPh.So_ct;
                    newCt.Ngay_ct = CurPh.Ngay_ct;
                    newCt.Ma_ct = CurPh.Ma_ct;
                    newCt.Ma_vt = ctRow["ma_vt"]?.ToString() ?? "";
                    newCt.Ten_vt = ctRow["ten_vt"]?.ToString() ?? "";
                    newCt.Dvt1 = ctRow["dvt1"]?.ToString() ?? "";
                    newCt.Ma_kho_i = ctRow["ma_kho_i"]?.ToString() ?? "";
                    newCt.Tk_vt = ctRow["tk_vt"]?.ToString() ?? "";
                    newCt.So_luong = Convert.ToDecimal(ctRow["so_luong"] ?? 0);

                    decimal tien_nt0_src = Convert.ToDecimal(ctRow["tien_nt0"] ?? 0);
                    decimal tien0_src = Convert.ToDecimal(ctRow["tien0"] ?? 0);
                    decimal gia_nt0_src = Convert.ToDecimal(ctRow["gia_nt0"] ?? 0);
                    decimal gia0_src = Convert.ToDecimal(ctRow["gia0"] ?? 0);

                    if (upper1 == upper2)
                    {
                        if (upper1 == M_ma_nt0?.Trim().ToUpper())
                        {
                            newCt.Tien_nt0 = tien0_src;
                            newCt.Tien0 = tien0_src;
                            newCt.Gia_nt0 = gia0_src;
                            newCt.Gia0 = gia0_src;
                        }
                        else
                        {
                            newCt.Tien_nt0 = tien_nt0_src;
                            newCt.Tien0 = tien0_src;
                            newCt.Gia_nt0 = gia_nt0_src;
                            newCt.Gia0 = gia0_src;
                        }
                    }
                    else if (upper1 == M_ma_nt0?.Trim().ToUpper())
                    {
                        newCt.Tien_nt0 = tien0_src;
                        newCt.Tien0 = tien0_src;
                        newCt.Gia_nt0 = gia0_src;
                        newCt.Gia0 = gia0_src;
                    }
                    else
                    {
                        newCt.Tien_nt0 = ty_gia > 0 ? Math.Round(tien0_src / ty_gia, M_ROUND_NT) : tien_nt0_src;
                        newCt.Tien0 = tien0_src;
                        newCt.Gia_nt0 = ty_gia > 0 ? Math.Round(gia0_src / ty_gia, M_ROUND_GIA_NT) : gia_nt0_src;
                        newCt.Gia0 = gia0_src;
                    }

                    newCt.Cp = 0;
                    newCt.Cp_nt = 0;
                    newCt.Gia = newCt.Gia0;
                    newCt.Gia_nt = newCt.Gia_nt0;
                    newCt.Tien = newCt.Tien0;
                    newCt.Tien_nt = newCt.Tien_nt0;

                    LSCt.Add(newCt);
                }
            }

            UpdateTotalHT();
            VisibleTimPN = false;
            activeTabIndex = 0;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Error" + ":" + ex.Message);
        }
    }

