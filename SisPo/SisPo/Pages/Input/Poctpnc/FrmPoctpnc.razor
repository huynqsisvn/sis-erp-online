    <DxPopup Visible="@VisibleTimPN"
             HeaderText="@Lap["Choose purchase"]"
             Width="90%"
             Height="620px"
             ShowCloseButton="true"
             CloseOnOutsideClick="false"
             Closed="@(_ => btnTimPN_Cancel())">
        <BodyContentTemplate>
            <div class="w-100 h-100 d-flex flex-column">
                <div class="m-2 p-2 border rounded">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small">@Lap["From date"]</label>
                            <DxDateEdit @bind-Date="@_filter_pn_ngay_ct1" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">@Lap["To date"]</label>
                            <DxDateEdit @bind-Date="@_filter_pn_ngay_ct2" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">@Lap["From voucher No."]</label>
                            <DxTextBox @bind-Text="@_filter_pn_so_ct1" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">@Lap["To voucher No."]</label>
                            <DxTextBox @bind-Text="@_filter_pn_so_ct2" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">@Lap["Supplier code"]</label>
                            <AutocompleteComponent TblData="@TblDmkh" Ma_dm="dmkh" @bind-Value="@_filter_pn_ma_kh"
                                                   SelectChanged="@((ExpandoObject v) => { _filter_pn_ten_kh = v?.FirstOrDefault(a => a.Key == "ten_kh").Value?.ToString() ?? ""; StateHasChanged(); })"
                                                   IsEnable="true" IsLangEn="@IsLangEn" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">&nbsp;</label>
                            <DxButton Text="@Lap["Search"]" RenderStyle="ButtonRenderStyle.Primary" Click="@btnTimPN_Search" CssClass="w-100" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">&nbsp;</label>
                            <DxButton Text="@Lap["OK"]" RenderStyle="ButtonRenderStyle.Success" Click="@btnTimPN_Ok" CssClass="w-100" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_filter_pn_ten_kh))
                    {
                        <div class="mt-1 text-muted small">@_filter_pn_ten_kh</div>
                    }
                </div>
                @if (_pn_filter_result != null)
                {
                    <div class="flex-grow-1 overflow-auto m-2" style="display:flex;flex-direction:column;gap:4px;">                        
                        <div style="flex:0 0 auto;max-height:220px;overflow-y:auto;">
                            <table class="table table-sm table-bordered table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width:40px;text-align:center">
                                            <input type="checkbox" @onchange="@(e => TimPN_ToggleAll((bool)e.Value))" />
                                        </th>
                                        <th>@Lap["GL date"]</th>
                                        <th>@Lap["Voucher No"]</th>
                                        <th>@Lap["Supplier code"]</th>
                                        <th>@Lap["Customer name"]</th>
                                        <th style="text-align:right">@String.Concat(Lap["Goods amount"], " ", CurPh.Ma_nt)</th>
                                        @if (NotMaNt0Voucher)
                                        {
                                            <th style="text-align:right">@String.Concat(Lap["Goods amount"], " ", M_ma_nt0.Trim())</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow row in _pn_filter_result.Rows)
                                    {
                                        string stt_rec_row = row["stt_rec"].ToString();
                                        bool isSelected = _pn_selected_rows.Contains(stt_rec_row);
                                        bool isActive = _selected_pn_stt_rec == stt_rec_row;
                                        <tr class="@(isSelected ? "table-primary" : isActive ? "table-warning" : "")" style="cursor:pointer"
                                            @onclick="@(() => { TimPN_ToggleRow(stt_rec_row); TimPN_SelectRow(stt_rec_row); })">
                                            <td style="text-align:center" @onclick:stopPropagation @onclick="@(() => TimPN_ToggleRow(stt_rec_row))">
                                                <input type="checkbox" checked="@isSelected" @onchange="@(_ => TimPN_ToggleRow(stt_rec_row))" />
                                            </td>
                                            <td>@(row["ngay_ct"] is DateTime d ? d.ToString("dd-MM-yyyy") : row["ngay_ct"])</td>
                                            <td>@row["so_ct"]</td>
                                            <td>@row["ma_kh"]</td>
                                            <td>@row["ten_kh"]</td>
                                            <td style="text-align:right">@Convert.ToDecimal(row["t_tien_nt0"]).ToString(M_IP_TIEN_NT)</td>
                                            @if (NotMaNt0Voucher)
                                            {
                                                <td style="text-align:right">@Convert.ToDecimal(row["t_tien0"]).ToString(M_IP_TIEN)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* === DETAIL: chi tiết vật tư của phiếu nhập đang chọn === *@
                        @if (_pn_ct_result != null && !string.IsNullOrEmpty(_selected_pn_stt_rec))
                        {
                            <div style="flex:1 1 auto;overflow-y:auto;">
                                <h6 class="fw-bold bg-light text-warning rounded-pill px-2 py-1 mb-1 small">
                                    @Lap["Detail"]
                                </h6>
                                <table class="table table-sm table-bordered mb-0">
                                    <thead class="table-secondary sticky-top">
                                        <tr>
                                            <th>@Lap["Item code"]</th>
                                            <th>@Lap["Item name"]</th>
                                            <th style="text-align:right">@Lap["Quantity"]</th>
                                            <th style="text-align:right">@String.Concat(Lap["Price"], " ", CurPh.Ma_nt)</th>
                                            <th style="text-align:right">@String.Concat(Lap["Goods amount"], " ", CurPh.Ma_nt)</th>
                                            @if (NotMaNt0Voucher)
                                            {
                                                <th style="text-align:right">@String.Concat(Lap["Price"], " ", M_ma_nt0.Trim())</th>
                                                <th style="text-align:right">@String.Concat(Lap["Goods amount"], " ", M_ma_nt0.Trim())</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (DataRowView ctRow in _pn_ct_result.DefaultView)
                                        {
                                            <tr>
                                                <td>@ctRow["ma_vt"]</td>
                                                <td>@ctRow["ten_vt"]</td>
                                                <td style="text-align:right">@Convert.ToDecimal(ctRow["so_luong"]).ToString(M_IP_SL)</td>
                                                <td style="text-align:right">@Convert.ToDecimal(ctRow["gia_nt0"]).ToString(M_IP_GIA_NT)</td>
                                                <td style="text-align:right">@Convert.ToDecimal(ctRow["tien_nt0"]).ToString(M_IP_TIEN_NT)</td>
                                                @if (NotMaNt0Voucher)
                                                {
                                                    <td style="text-align:right">@Convert.ToDecimal(ctRow["gia0"]).ToString(M_IP_GIA)</td>
                                                    <td style="text-align:right">@Convert.ToDecimal(ctRow["tien0"]).ToString(M_IP_TIEN)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        </BodyContentTemplate>
    </DxPopup>

