    void OnGridCT_Value_Changed(decimal newvalue, string name)
    {
        if (!string.IsNullOrEmpty(name))
        {
            switch (name.ToLower())
            {
                case "so_luong":
                    {                        
                        var newValue = Convert.ToDecimal(newvalue);
                        CurrentEditModel.So_luong = newValue;


                        if (newvalue == null)
                            CurrentEditModel.So_luong = 0;

                        decimal soLuong = CurrentEditModel.So_luong;



                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);

                        // === LẤY ĐƠN GIÁ ===
                        decimal gia_nt0 = CurrentEditModel.Gia_nt0;
                        decimal gia0 = CurrentEditModel.Gia0;

                        // Nếu có đơn giá ngoại tệ → quy đổi sang VND
                        if (!isVND && gia_nt0 != 0)
                        {
                            gia0 = Math.Round(gia_nt0 * ty_gia, M_ROUND_GIA);
                            CurrentEditModel.Gia0 = gia0;
                        }

                        // === TÍNH TIỀN NGUYÊN TỆ ===
                        decimal tien_nt0 = soLuong != 0 ? Math.Round(soLuong * gia_nt0, M_ROUND_NT) : 0;
                        CurrentEditModel.Tien_nt0 = tien_nt0;

                        // === TÍNH TIỀN QUY ĐỔI (VND) ===
                        decimal tien0 = Math.Round(tien_nt0 * ty_gia, M_ROUND);
                        CurrentEditModel.Tien0 = tien0;

                        // === ĐỒNG BỘ KHI DÙNG VND ===
                        if (isVND)
                        {
                            CurrentEditModel.Gia0 = gia_nt0;
                            CurrentEditModel.Tien0 = tien_nt0;
                            CurPh.T_tien0 = CurPh.T_tien_nt0;
                        }

                        // === CỘNG CHI PHÍ (nếu có) ===
                        decimal cp = CurrentEditModel.Cp;
                        decimal cp_nt = CurrentEditModel.Cp_nt;

                        CurrentEditModel.Tien = tien0 + cp;
                        CurrentEditModel.Tien_nt = tien_nt0 + cp_nt;

                        // === XỬ LÝ CHIẾT KHẤU THEO TỶ LỆ (%) ===
                        decimal tl_ck = CurrentEditModel.Tl_ck;
                        if (tl_ck > 0)
                        {
                            decimal ck = Math.Round(tien0 * tl_ck / 100, M_ROUND);
                            decimal ck_nt = Math.Round(tien_nt0 * tl_ck / 100, M_ROUND_NT);

                            CurrentEditModel.Ck = ck;
                            CurrentEditModel.Ck_nt = ck_nt;

                            // Trừ chiết khấu khỏi tổng tiền
                            CurrentEditModel.Tien = tien0 - ck + cp;
                            CurrentEditModel.Tien_nt = tien_nt0 - ck_nt + cp_nt;
                        }

                        UpdateTotalHT();                        
                        StateHasChanged();
                        break;
                    }
                case "gia_nt0":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Gia_nt0 = 0;
                        }
                        else
                        {
                            CurrentEditModel.Gia_nt0 = Convert.ToDecimal(newvalue);
                        }

                        decimal gia_nt0 = CurrentEditModel.Gia_nt0;
                        decimal so_luong = CurrentEditModel.So_luong;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);

                        // Chỉ tính tiền tự động nếu KHÔNG bật chế độ "Sửa tiền trực tiếp"
                        bool canAutoCalcTien = !(CurPh.Sua_tien == 1); // Giả sử ChkSuaTien là bool trong model chứng từ

                        if (canAutoCalcTien && so_luong != 0)
                        {
                            // === TÍNH TIỀN NGUYÊN TỆ ===
                            decimal tien_nt0 = Math.Round(so_luong * gia_nt0, M_ROUND_NT);
                            CurrentEditModel.Tien_nt0 = tien_nt0;

                            if (isVND)
                            {
                                // Trường hợp dùng VND: đồng bộ hoàn toàn
                                CurrentEditModel.Gia0 = gia_nt0;
                                CurrentEditModel.Tien0 = tien_nt0;
                            }
                            else
                            {
                                // Quy đổi sang VND
                                CurrentEditModel.Gia0 = Math.Round(gia_nt0 * ty_gia, M_ROUND_GIA);
                                CurrentEditModel.Tien0 = Math.Round(tien_nt0 * ty_gia, M_ROUND);
                            }
                        }
                        else if (isVND)
                        {
                            // Nếu là VND nhưng không tự động tính tiền → vẫn đồng bộ giá
                            CurrentEditModel.Gia0 = gia_nt0;
                        }
                        else if (!isVND)
                        {
                            // Ngoại tệ: quy đổi giá sang VND dù không tính tiền
                            CurrentEditModel.Gia0 = Math.Round(gia_nt0 * ty_gia, M_ROUND_GIA);
                        }

                        // === CỘNG CHI PHÍ VÀO TỔNG TIỀN (sau cùng) ===
                        decimal tien0 = CurrentEditModel.Tien0;
                        decimal tien_nt0_final = CurrentEditModel.Tien_nt0;
                        decimal cp = CurrentEditModel.Cp;
                        decimal cp_nt = CurrentEditModel.Cp_nt;

                        CurrentEditModel.Tien = tien0 + cp;
                        CurrentEditModel.Tien_nt = tien_nt0_final + cp_nt;

                        // === XỬ LÝ CHIẾT KHẤU TỶ LỆ (nếu có) - giữ nguyên như case so_luong ===
                        decimal tl_ck = CurrentEditModel.Tl_ck;
                        if (tl_ck > 0 && canAutoCalcTien)
                        {
                            decimal ck = Math.Round(tien0 * tl_ck / 100, M_ROUND);
                            decimal ck_nt = Math.Round(tien_nt0_final * tl_ck / 100, M_ROUND_NT);

                            CurrentEditModel.Ck = ck;
                            CurrentEditModel.Ck_nt = ck_nt;

                            CurrentEditModel.Tien = tien0 - ck + cp;
                            CurrentEditModel.Tien_nt = tien_nt0_final - ck_nt + cp_nt;
                        }

                        // Cập nhật tổng chứng từ
                        UpdateTotalHT();

                        // Refresh giao diện Blazor
                        StateHasChanged();
                        break;
                    }
                case "tien_nt0":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Tien_nt0 = 0;
                        }
                        else
                        {
                            CurrentEditModel.Tien_nt0 = Convert.ToDecimal(newvalue);
                        }

                        decimal tien_nt0 = CurrentEditModel.Tien_nt0;
                        decimal so_luong = CurrentEditModel.So_luong;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = !NotMaNt0Voucher;
                        decimal tien0 = isVND ? tien_nt0 : Math.Round(tien_nt0 * ty_gia, M_ROUND);
                        CurrentEditModel.Tien0 = tien0;
                        if (isVND)
                        {
                            CurrentEditModel.Tien0 = tien_nt0;
                        }
                        if (so_luong != 0 && tien_nt0 != 0)
                        {
                            decimal gia_nt0_moi = Math.Round(tien_nt0 / so_luong, M_ROUND_GIA_NT); // hoặc M_ROUND_GIA
                            CurrentEditModel.Gia_nt0 = gia_nt0_moi;

                            // Cập nhật luôn giá quy đổi
                            CurrentEditModel.Gia0 = isVND ? gia_nt0_moi : Math.Round(gia_nt0_moi * ty_gia, M_ROUND_GIA);
                        }
                        else if (so_luong == 0)
                        {
                            // Nếu số lượng = 0 → giá cũng phải = 0
                            CurrentEditModel.Gia_nt0 = 0;
                            CurrentEditModel.Gia0 = 0;
                        }

                        // === 4. XỬ LÝ CHIẾT KHẤU THEO TỶ LỆ (%) - nếu có thiết lập ===
                        decimal tl_ck = CurrentEditModel.Tl_ck;
                        if (tl_ck > 0)
                        {
                            decimal ck_nt = Math.Round(tien_nt0 * tl_ck / 100m, M_ROUND_NT);
                            decimal ck = Math.Round(tien0 * tl_ck / 100m, M_ROUND);

                            CurrentEditModel.Ck_nt = ck_nt;
                            CurrentEditModel.Ck = isVND ? ck_nt : ck;
                        }
                        else
                        {
                            CurrentEditModel.Ck_nt = 0;
                            CurrentEditModel.Ck = 0;
                        }

                        decimal cp = CurrentEditModel.Cp;
                        decimal cp_nt = CurrentEditModel.Cp_nt;

                        CurrentEditModel.Tien = tien0 + cp - (CurrentEditModel.Ck);
                        CurrentEditModel.Tien_nt = tien_nt0 + cp_nt - (CurrentEditModel.Ck_nt);
                        if (isVND)
                        {
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurrentEditModel.Ck = CurrentEditModel.Ck_nt;
                            CurrentEditModel.Gia0 = CurrentEditModel.Gia_nt0;
                            CurrentEditModel.Tien0 = CurrentEditModel.Tien_nt0;
                        }

                        UpdateTotalHT(); 
                        StateHasChanged();
                        break;
                    }

                case "gia0":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Gia0 = 0;
                        }
                        else
                        {
                            CurrentEditModel.Gia0 = Convert.ToDecimal(newvalue);
                        }

                        decimal gia0 = CurrentEditModel.Gia0;
                        decimal so_luong = CurrentEditModel.So_luong;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);

                        // === TRƯỜNG HỢP ĐẶC BIỆT: Người dùng sửa trực tiếp GIÁ VND ===
                        // → Chỉ tính tiền VND từ giá VND (không đụng đến tiền nguyên tệ)
                        if (so_luong != 0 && gia0 != 0)
                        {
                            decimal tien0_moi = Math.Round(gia0 * so_luong, M_ROUND);
                            CurrentEditModel.Tien0 = tien0_moi;

                            // Nếu là VND → đồng bộ ngược lại tiền_nt0 và giá_nt0
                            if (isVND)
                            {
                                CurrentEditModel.Tien_nt0 = tien0_moi;
                                CurrentEditModel.Gia_nt0 = gia0;
                            }
                            // Nếu là ngoại tệ → KHÔNG tự động sửa tiền_nt0 (giữ nguyên logic hệ thống cũ)
                            // → Chỉ cập nhật tiền0 từ giá0 (đúng như WinForm gốc)
                        }
                        else if (so_luong == 0)
                        {
                            CurrentEditModel.Tien0 = 0;
                            if (isVND) CurrentEditModel.Tien_nt0 = 0;
                        }

                        decimal tien0 = CurrentEditModel.Tien0;
                        decimal cp = CurrentEditModel.Cp;

                        decimal ck = CurrentEditModel.Ck;
                        CurrentEditModel.Tien = tien0 + cp - ck;

                        if (isVND)
                        {
                            CurrentEditModel.Tien_nt = CurrentEditModel.Tien = tien0 + cp - ck;
                            CurrentEditModel.Tien_nt0 = CurrentEditModel.Tien0;
                        }

                        UpdateTotalHT();
                        StateHasChanged();
                        break;
                    }
                case "tien0":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Cp = 0;
                        }
                        else
                        {
                            CurrentEditModel.Cp = Convert.ToDecimal(newvalue);
                        }

                        decimal tien0 = CurrentEditModel.Tien0;
                        decimal cp = CurrentEditModel.Cp;
                        decimal ck = CurrentEditModel.Ck;

                        CurrentEditModel.Tien = tien0 + cp - ck;
                        bool isVND = string.Equals(CurPh.Ma_nt?.Trim(), M_ma_nt0?.Trim(), StringComparison.OrdinalIgnoreCase);
                        if (isVND)
                        {
                            CurrentEditModel.Tien_nt = CurrentEditModel.Tien;
                        }

                        UpdateTotalHT();
                        StateHasChanged();
                        break;
                    }
                case "cp_nt":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Cp_nt = 0;
                        }
                        else
                        {
                            CurrentEditModel.Cp_nt = Convert.ToDecimal(newvalue);
                        }
                                            
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = !NotMaNt0Voucher;
                        decimal Cp = isVND ? CurrentEditModel.Cp_nt : Math.Round(CurrentEditModel.Cp_nt * ty_gia, M_ROUND);
                        CurrentEditModel.Cp = Cp;
                        if (isVND)
                        {
                            CurrentEditModel.Cp = CurrentEditModel.Cp_nt;
                        }
                        decimal cp = CurrentEditModel.Cp;
                        decimal cp_nt = CurrentEditModel.Cp_nt;

                        CurrentEditModel.Tien = CurrentEditModel.Tien0 + CurrentEditModel.Cp - (CurrentEditModel.Ck);
                        CurrentEditModel.Tien_nt = CurrentEditModel.Tien_nt0 + CurrentEditModel.Cp_nt - (CurrentEditModel.Ck_nt);
                        if (isVND)
                        {
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurrentEditModel.Ck = CurrentEditModel.Ck_nt;
                            CurrentEditModel.Gia0 = CurrentEditModel.Gia_nt0;
                            CurrentEditModel.Tien0 = CurrentEditModel.Tien_nt0;
                        }

                        UpdateTotalHT(); 
                        StateHasChanged();
                        break;
                    }
                case "cp":
                    {
                        if (newvalue == null)
                        {
                            CurrentEditModel.Cp = 0;
                        }
                        else
                        {
                            CurrentEditModel.Cp = Convert.ToDecimal(newvalue);
                        }
                        CurrentEditModel.Tien = CurrentEditModel.Tien0 + CurrentEditModel.Cp - (CurrentEditModel.Ck);
                        CurrentEditModel.Tien_nt = CurrentEditModel.Tien_nt0 + CurrentEditModel.Cp_nt - (CurrentEditModel.Ck_nt);                        

                        UpdateTotalHT(); 
                        StateHasChanged();
                        break;
                    }
            }
        }
    }


