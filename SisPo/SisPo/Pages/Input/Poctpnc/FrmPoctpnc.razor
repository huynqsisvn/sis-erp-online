    void OnValueChiPhiChanged(decimal newvalue, string name)
    {
        if (!string.IsNullOrEmpty(name))
        {
            switch (name.ToLower())
            {
                case "t_cp_nt":
                    {

                        if (newvalue == null || !decimal.TryParse(newvalue.ToString(), out decimal tong_cp_nt_new))
                        {
                            CurPh.T_cp_nt = 0m;
                        }
                        else
                        {
                            CurPh.T_cp_nt = tong_cp_nt_new;
                        }

                        decimal tong_cp_nt = CurPh.T_cp_nt;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = !NotMaNt0Voucher;                        
                        bool suaTienTrucTiep = (CurPh.Sua_tien == 1);
                        bool canAutoSyncCp = !suaTienTrucTiep;

                        if (isVND)
                        {                            
                            CurPh.T_cp = tong_cp_nt;
                        }
                        else if (tong_cp_nt * ty_gia != 0m)
                        {                            
                            CurPh.T_cp = tong_cp_nt * ty_gia;
                        }
                        UpdateTotalHT();
                        StateHasChanged();
                        break;
                    }
                case "t_cp":
                    {
                        if (newvalue == null || !decimal.TryParse(newvalue.ToString(), out decimal tong_cp_new))
                        {
                            CurPh.T_cp = 0m;
                        }
                        else
                        {
                            CurPh.T_cp = tong_cp_new;
                        }

                        decimal tong_cp = CurPh.T_cp;

                        decimal t_tien0 = CurPh.T_tien0;
                        decimal t_cp = CurPh.T_cp;
                        decimal t_thue = CurPh.T_thue;

                        CurPh.T_tt = t_tien0 + t_cp + t_thue;
                        UpdateTotalHT();
                        StateHasChanged();
                        break;

                    }
            }
        }
    }

