    private void TimPN_SelectRow(string stt_rec)
    {
        _selected_pn_stt_rec = stt_rec;
        if (_pn_ct_result != null)
            _pn_ct_result.DefaultView.RowFilter = $"stt_rec='{stt_rec}'";
        StateHasChanged();
    }

    private void TimPN_ToggleRow(string stt_rec)
    {
        if (_pn_selected_rows.Contains(stt_rec))
            _pn_selected_rows.Remove(stt_rec);
        else
            _pn_selected_rows.Add(stt_rec);
        StateHasChanged();
    }

    private void TimPN_ToggleAll(bool selectAll)
    {
        _pn_selected_rows.Clear();
        if (selectAll && _pn_filter_result != null)
        {
            foreach (DataRow row in _pn_filter_result.Rows)
                _pn_selected_rows.Add(row["stt_rec"].ToString());
        }
        StateHasChanged();
    }

