                                                                }
                                                                <DxSpinEdit Enabled="false" Value="@_Ct73.Cp" ValueExpression="@(() => _Ct73.Cp)" Id="Cp" DisplayFormat="@M_IP_TIEN" Format="@M_IP_TIEN" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Cp"); })"></DxSpinEdit>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                        <DxGridDataColumn FieldName="Gia_nt" Caption="@String.Concat(Lap["Price includes costs."], " ", CurPh.Ma_nt)" Width="120" DisplayFormat="@M_IP_GIA_NT">
