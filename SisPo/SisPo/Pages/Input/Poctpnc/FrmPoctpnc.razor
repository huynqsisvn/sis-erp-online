                                                                @{
                                                                    var _Ct73 = (Ct73)GrdContext.EditModel;
                                                                }
                                                                <DxSpinEdit Enabled="false" Value="@_Ct73.Gia0" ValueExpression="@(() => _Ct73.Gia0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia0"); })" Id="Gia0"></DxSpinEdit>
                                                            </CellEditTemplate>
