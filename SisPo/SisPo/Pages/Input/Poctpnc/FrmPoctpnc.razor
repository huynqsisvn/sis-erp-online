                                                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN_NT" Name="Cp_nt" FieldName="Cp_nt" />
                                                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Cp" FieldName="Cp" />
                                                    </TotalSummary>
