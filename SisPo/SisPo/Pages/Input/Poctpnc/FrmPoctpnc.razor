                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct73 = (Ct73)GrdContext.EditModel;
                                                                }
                                                                <DxSpinEdit Enabled="false" Value="@_Ct73.Tien0" ValueExpression="@(() => _Ct73.Tien0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien0"); })" Id="Tien"></DxSpinEdit>
