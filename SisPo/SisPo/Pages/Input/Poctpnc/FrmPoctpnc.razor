    public decimal GetSdkh13(string ma_kh, string tk)
    {
        decimal result = 0m;
        if (string.IsNullOrEmpty(ma_kh.Trim()) || string.IsNullOrEmpty(tk.Trim()))
        {
            return result;
        }
        string format = string.Format("exec GetSdkh13 '{0}','{1}'", ma_kh, tk);

        DataSet ds = myDb.LoadDataSet(format);
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            return Convert.ToDecimal(ds.Tables[0].Rows[0]["du13"]);
        }
        return result;
    }

