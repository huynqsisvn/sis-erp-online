                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>


                                                        <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Gia0" Caption="@String.Concat(Lap["Price"], " ", M_ma_nt0.Trim())" Width="120" DisplayFormat="@M_IP_GIA">
