                                                                <DxSpinEdit Enabled="false" Value="@_Ct73.Gia_nt" ValueExpression="@(() => _Ct73.Gia_nt)" Id="Gia_nt"></DxSpinEdit>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                        <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Gia" Caption="@String.Concat(Lap["Price includes costs."], " ", M_ma_nt0.Trim())" Width="120" DisplayFormat="@M_IP_GIA_NT">
