@inherits TranBaseComponent
@using System.Data
@using DevExpress.Blazor

<div class="m-0 p-0 w-100" data-spy="scroll" style="overflow:auto;">
    @if (IsShowVoucher)
    {
        <FormTrans Title="@Pagetitle" @bind-curActionTask="@curActionTask" OnNew="@OnNew" OnCopy="@OnCopy" OnEdit="@OnEdit" OnSave="@OnSave" OnCancel="@OnCancel" OnPrint="@OnPrint" OnTemplateChanged="@OnTemplateChanged" Stt_rec="@CurPh.Stt_rec" curUser="@curUser" Ma_ct="@Ma_ct" Menu_id="@Menu_id" Phdbf="@M_Phdbf" LanguageID="@LanguageID">
            <div class="row m-1 mt-3 me-2">
                <DxFormLayout SizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
                    <DxFormLayoutGroup ColSpanMd="12" Caption="@Lap["Infomation"]" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide">
                        <DxFormLayoutGroup ColSpanMd="8" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">
                            <DxFormLayoutItem Caption="@Lap["Supplier code"]" ColSpanMd="8">
                                <Template>
                                    <AutocompleteComponent Id="ma_khach_input" TblData="@TblDmkh" Ma_dm="dmkh" @bind-Value="@CurPh.Ma_kh" SelectChanged="OnAutoCompleteKhachhangChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Address"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurPh.Dia_chi" Enabled="@AllowEditMode"></DxTextBox>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Deliverer"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurPh.Ong_ba" Enabled="@AllowEditMode"></DxTextBox>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Description"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurPh.Dien_giai" Enabled="@AllowEditMode"></DxTextBox>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Credit account"]" ColSpanMd="8">
                                <Template>
                                    <AutocompleteComponent Ma_dm="dmnx" @bind-Value="@CurPh.Ma_nx" SelectChanged="OnAutoCompleteDMNXChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                        
                        <DxFormLayoutGroup Caption="@Lap["Voucher"]" ColSpanMd="4" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">
                            <DxFormLayoutItem Caption="@Lap["GL date"]" ColSpanMd="12">
                                <DxDateEdit Id="ngay_ct_input" @bind-Date="@CurPh.Ngay_ct" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["LCT date"]" ColSpanMd="12">
                                <DxDateEdit @bind-Date="@CurPh.Ngay_lct" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Book code"]" ColSpanMd="12">
                                <AutocompleteComponent Id="ma_qs_input" Ma_dm="dmqs" @bind-Value="@CurPh.Ma_qs" SelectChanged="OnAutoCompleteQuyensoChanged" Filter="@_filter_qs" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Voucher No"]" ColSpanMd="12">
                                <DxTextBox Id="so_ct_input" @bind-Text="@CurPh.So_ct" Enabled="@AllowEditMode"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Ex. rate"]" ColSpanMd="8">
                                <Template>
                                    <AutocompleteComponent Ma_dm="dmnt" @bind-Value="@CurPh.Ma_nt" SelectChanged="OnAutoCompleteMaNTChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="4">
                                <Template>
                                    <DxSpinEdit ReadOnly="@(CurPh?.Ma_nt?.Trim().Equals(M_ma_nt0) == true)" Value="@CurPh.Ty_gia" ValueExpression="@(() => CurPh.Ty_gia)" ValueChanged="@((decimal newvalue) => { OnValueTyGiaChanged(newvalue); })" DisplayFormat="@M_IP_TY_GIA" Enabled="@AllowEditMode" Id="Ty_gia"></DxSpinEdit>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Customs ex.rate"]" ColSpanMd="12">
                                <Template>
                                    <DxSpinEdit ReadOnly="@(CurPh?.Ma_nt?.Trim().Equals(M_ma_nt0) == true)" Value="@CurPh.Ty_gia_hq" ValueExpression="@(() => CurPh.Ty_gia_hq)" ValueChanged="@((decimal newvalue) => { OnValueTyGiaHQChanged(newvalue); })" DisplayFormat="@M_IP_TY_GIA" Enabled="@AllowEditMode" Id="Ty_gia_hq"></DxSpinEdit>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="12">
                                <Template>
                                    <AutocompleteComponent CssClass="col p-0" Ma_dm="dmpost" @bind-Value="@CurPh.Status" Filter="@filter_status" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                    </DxFormLayoutGroup>
                    
                    <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail" @bind-ActiveTabIndex="@activeTabIndex" TabClick="@OnTabChanged">
                        <DxFormLayoutTabPage Caption="@Lap["Details"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div @ref="GridWrapper" id="grid-wrapper" @onfocusout="OnGridCTLostFocus" class="mt-2 mb-3">
                                        <DxGrid @ref="GridCT" SizeMode="@Itemsizemode" CssClass="@grd_Css" @onkeydown="GridCT_OnKeyDown"
                                                AllowSelectRowByClick=true KeyboardNavigationEnabled="true"
                                                Data="@LSCt"
                                                @bind-SelectedDataItem="@SelectedDataItemCT"
                                                ValidationEnabled="false"
                                                EditMode="GridEditMode.EditRow"
                                                RowClick="@StartEditDataItemByClickCT"
                                                SelectionMode="GridSelectionMode.Single"
                                                CustomizeEditModel="Grid_CustomizeEditModelCT"
                                                EditModelSaving="Grid_EditModelSavingCT"
                                                CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                EditNewRowPosition="@NewItemRowPosition"
                                                ShowAllRows="true"
                                                TextWrapEnabled="false" AllowSort="false"
                                                HighlightRowOnHover="true">
                                            <Columns>
                                                <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                                    <CellDisplayTemplate Context="cntedit">
                                                        <div class="grid-cell-align-center">
                                                            <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                                      RenderStyle="ButtonRenderStyle.Link"
                                                                      CssClass="grid-delete-btn"
                                                                      aria-label="Delete"
                                                                      Click="@(() => OnDeleteRowCT(cntedit.VisibleIndex, 0))" />
                                                        </div>
                                                    </CellDisplayTemplate>
                                                    <CellEditTemplate Context="cntedit1">
                                                        <div class="grid-cell-align-center">
                                                            <DxButton Enabled="false"
                                                                      CssClass="grid-disabled-button"
                                                                      IconCssClass="grid-icon grid-icon-delete"
                                                                      aria-label="Delete"
                                                                      RenderStyle="ButtonRenderStyle.Link" />
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridCommandColumn>
                                                <DxGridDataColumn FieldName="Ma_vt" Caption="@Lap["Item code"].ToString()" Width="120" CaptionAlignment="GridTextAlignment.Center">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <div id="@($"Ma_vt_{_Ct72.Stt_rec0}")" class="autocomplete-cell-wrapper m-0 p-0">
                                                            <AutocompleteComponent Ma_dm="dmvt" @bind-Value="@_Ct72.Ma_vt" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_vt"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ten_vt" ReadOnly="true" Caption="@Lap["Item name"]" CaptionAlignment="GridTextAlignment.Center" Width="200" />

                                                <DxGridDataColumn FieldName="Dvt1" Caption="@Lap["UOM"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent Ma_dm="dmvtdvt" Filter="@(String.Format(" ma_vt = '{0}'", (_Ct72.Ma_vt?.Trim()) ?? ""))" @bind-Value="@_Ct72.Dvt1" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Dvt1"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Ma_kho_i" Caption="@Lap["Site code"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent Ma_dm="dmkho" @bind-Value="@_Ct72.Ma_kho_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_kho_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                
                                                @if (M_QL_LO_CK == "1")
                                                {
                                                    <DxGridDataColumn FieldName="Ma_lo" Caption="@Lap["Lot code"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct72 = (Ct72)GrdContext.EditModel;
                                                            }
                                                            <AutocompleteComponent Ma_dm="dmlo" @bind-Value="@_Ct72.Ma_lo" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_lo"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Han_sd_lot" ReadOnly="true" Caption="@Lap["Expiry date"]" CaptionAlignment="GridTextAlignment.Center" Width="120" />
                                                }

                                                <DxGridDataColumn FieldName="Ton13" ReadOnly="true" Caption="@Lap["Stock"]" CaptionAlignment="GridTextAlignment.Center" Width="120" DisplayFormat="@M_IP_SL" />

                                                <DxGridDataColumn FieldName="So_luong" Caption="@Lap["Quantity"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120" DisplayFormat="@M_IP_SL">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct72.So_luong" DisplayFormat="@M_IP_SL" ValueExpression="@(() => _Ct72.So_luong)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "So_luong"); })" Id="So_luong"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Gia_nt0" Caption="@String.Concat(Lap["Price"], " ", CurPh.Ma_nt)" Width="120" DisplayFormat="@M_IP_GIA_NT">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct72.Gia_nt0" DisplayFormat="@M_IP_GIA_NT" ValueExpression="@(() => _Ct72.Gia_nt0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia_nt0"); })" Id="Gia_nt0"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Gia0" Caption="@String.Concat(Lap["Price"], " ", M_ma_nt0.Trim())" Width="120">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@(CurPh.Sua_tien == 1)" Value="@_Ct72.Gia0" DisplayFormat="@M_IP_GIA" ValueExpression="@(() => _Ct72.Gia0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia0"); })" Id="Gia0"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Tien_nt0" Caption="@String.Concat(Lap["Goods amount"], " ", CurPh.Ma_nt)" Width="120" DisplayFormat="@M_IP_TIEN_NT">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@(CurPh.Sua_tien == 1)" Value="@_Ct72.Tien_nt0" DisplayFormat="@M_IP_TIEN_NT" ValueExpression="@(() => _Ct72.Tien_nt0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien_nt0"); })" Id="Tien_nt0"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Tien0" DisplayFormat="@M_IP_TIEN" Caption="@String.Concat(Lap["Goods amount"], " ", M_ma_nt0.Trim())" Width="120">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@(CurPh.Sua_tien == 1)" Value="@_Ct72.Tien0" DisplayFormat="@M_IP_TIEN" ValueExpression="@(() => _Ct72.Tien0)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien0"); })" Id="Tien"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                
                                                <DxGridDataColumn FieldName="Tk_vt" Caption="@Lap["Debit account"]" Width="120">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct72 = (Ct72)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@_Ct72.Tk_vt" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Tk_vt"); })"  IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                @foreach (FreeCodeInfo row in LsFreeCodeInfo)
                                                {
                                                    @if (row.Loai_dmctct == 1)
                                                    {
                                                        <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
                                                                }
                                                                <SisLib.Ctrl.FreeCodeDm Target="_Ct72" Ma_dm="@row.Ma_dm" FieldName="@row.Field_ct" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, row.Field_ct); })"
                                                                                        IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></SisLib.Ctrl.FreeCodeDm>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                    }
                                                    else if (row.Loai_dmctct == 3)
                                                    {
                                                        <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth" DisplayFormat="@M_IP_SL">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
                                                                }
                                                                <SisLib.Ctrl.FreeCodeSl Target="_Ct72" FieldName="@row.Field_ct" IsEnable="@AllowEditMode" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, row.Field_ct); })"></SisLib.Ctrl.FreeCodeSl>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                    }
                                                    else
                                                    {
                                                        <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
                                                                }
                                                                <SisLib.Ctrl.FreeCodeText Target="_Ct72" FieldName="@row.Field_ct"></SisLib.Ctrl.FreeCodeText>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                    }
                                                }
                                            </Columns>
                                            <TotalSummary>
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_SL" Name="So_luong" FieldName="So_luong" />
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Tien_nt0" FieldName="Tien_nt0" />
                                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN_NT" Name="Tien0" FieldName="Tien0" />
                                            </TotalSummary>
                                        </DxGrid>
                                    </div>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>
                        
                        <DxFormLayoutTabPage Caption="@Lap["Import tax"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box">
                                <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">                                    
                                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Total import tax"]">
                                        <div class="d-flex align-items-center gap-3">
                                            <DxSpinEdit Value="@CurPh.T_nk_nt" Enabled="@AllowEditMode" DisplayFormat="@M_IP_TIEN_NT" ValueExpression="@(() => CurPh.T_nk_nt)" ValueChanged="@((decimal newvalue) => { OnValueDBChanged(newvalue, "T_nk_nt"); })"></DxSpinEdit>
                                            @if (NotMaNt0Voucher)
                                            {
                                                <DxSpinEdit Id="t_nk_s" Enabled="false" CssClass="col-4 ms-2 text-end" Value="@CurPh.T_nk" DisplayFormat="@M_IP_TIEN" ValueExpression="@(() => CurPh.T_nk)" ValueChanged="@((decimal newvalue) => { OnValueDBChanged(newvalue, "T_nk"); })"></DxSpinEdit>
                                            }
                                        </div>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="3" Caption="@Lap["Import tax account"]">
                                        <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@CurPh.Tk_thue_nk" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="3">
                                        <DxButton Text="@Lap["Allocate import tax"]" RenderStyle="ButtonRenderStyle.Primary" Click="@btnPhanBoNK_Click" Enabled="@AllowEditMode" />
                                    </DxFormLayoutItem>  

                                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Total SCT tax"]" Visible="@SD_THUE_DB" BeginRow="true">
                                        <div class="d-flex align-items-center gap-3">
                                            <DxSpinEdit Value="@CurPh.T_db_nt" Enabled="@AllowEditMode" DisplayFormat="@M_IP_TIEN_NT" ValueExpression="@(() => CurPh.T_db_nt)" ValueChanged="@((decimal newvalue) => { OnValueDBChanged(newvalue, "T_db_nt"); })"></DxSpinEdit>
                                            @if (NotMaNt0Voucher)
                                            {
                                                <DxSpinEdit Id="t_db_s" Enabled="false" CssClass="col-4 ms-2 text-end" Value="@CurPh.T_db" DisplayFormat="@M_IP_TIEN" ValueExpression="@(() => CurPh.T_db)" ValueChanged="@((decimal newvalue) => { OnValueDBChanged(newvalue, "T_db"); })"></DxSpinEdit>
                                            }
                                        </div>                                        
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="3" Caption="@Lap["SCT tax account"]" Visible="@SD_THUE_DB">
                                        <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@CurPh.Tk_thue_db" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="3" Visible="@SD_THUE_DB">
                                        <DxButton Text="@Lap["Allocate SCT tax"]" RenderStyle="ButtonRenderStyle.Primary" Click="@btnPhanBoDB_Click" Enabled="@AllowEditMode" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <Template>
                                            <div @ref="GridTAXWrapper" id="gridtax-wrapper" class="mt-2 mb-3" @onfocusout="OnGridTAXLostFocus">
                                                <DxGrid @ref="GridTAX" SizeMode="@Itemsizemode" CssClass="@grd_Css"
                                                        Data="@LSCt" KeyboardNavigationEnabled="true"
                                                        @bind-SelectedDataItem="@SelectedDataItemTAX"
                                                        AllowSelectRowByClick=true
                                                        ValidationEnabled="false"
                                                        RowClick="@StartEditDataItemByClickTAX"
                                                        CustomizeEditModel="Grid_CustomizeEditModelTAX"
                                                        EditModelSaving="Grid_EditModelSavingTAX"                                                        
                                                        CustomizeElement="Grid_CustomizeElement"
                                                        CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                        EditMode="GridEditMode.EditRow"
                                                        ShowAllRows="true"
                                                        TextWrapEnabled="false" AllowSort="false"
                                                        HighlightRowOnHover="true">
                                                    <Columns>
                                                        <DxGridDataColumn FieldName="Ma_vt" ReadOnly="true" Caption="@Lap["Item code"].ToString()" Width="120" CaptionAlignment="GridTextAlignment.Center" />
                                                        <DxGridDataColumn FieldName="Ten_vt" ReadOnly="true" Caption="@Lap["Item name"]" CaptionAlignment="GridTextAlignment.Center" Width="200" />
                                                        <DxGridDataColumn FieldName="So_luong" ReadOnly="true" Caption="@Lap["Quantity"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120" DisplayFormat="@M_IP_SL"/>                                                        

                                                        <DxGridDataColumn FieldName="Gia_nt1" Caption="@String.Concat(Lap["Import price"], " ", CurPh.Ma_nt)" Width="120" DisplayFormat="@M_IP_GIA_NT">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
                                                                }
                                                                <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct72.Gia_nt1" ValueExpression="@(() => _Ct72.Gia_nt1)" DisplayFormat="@M_IP_GIA_NT" ValueChanged="@((decimal newvalue) => { OnGridTAX_Value_Changed(newvalue, "Gia_nt1"); })" Id="Gia_nt1"></DxSpinEdit>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                        <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Gia1" Caption="@String.Concat(Lap["Import price"], " ", M_ma_nt0.Trim())" Width="120" DisplayFormat="@M_IP_GIA">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
                                                                }
                                                                <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct72.Gia1" ValueExpression="@(() => _Ct72.Gia1)" DisplayFormat="@M_IP_GIA" ValueChanged="@((decimal newvalue) => { OnGridTAX_Value_Changed(newvalue, "Gia1"); })" Id="Gia1"></DxSpinEdit>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>

                                                        <DxGridDataColumn FieldName="Tien_nt1" Caption="@String.Concat(Lap["Import amount"], " ", CurPh.Ma_nt)" Width="120" DisplayFormat="@M_IP_TIEN_NT">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
                                                                }
                                                                <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct72.Tien_nt1" ValueExpression="@(() => _Ct72.Tien_nt1)" DisplayFormat="@M_IP_TIEN_NT" ValueChanged="@((decimal newvalue) => { OnGridTAX_Value_Changed(newvalue, "Tien_nt1"); })" Id="Tien_nt1"></DxSpinEdit>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>
                                                        <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Tien1" Caption="@String.Concat(Lap["Import amount"], " ", M_ma_nt0.Trim())" Width="120" DisplayFormat="@M_IP_TIEN">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct72 = (Ct72)GrdContext.EditModel;
