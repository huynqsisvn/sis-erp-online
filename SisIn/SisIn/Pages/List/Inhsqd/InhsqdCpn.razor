    public override async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {            
            string sqlcmd = $"Select Count(1) as sl from ct70 where ma_vt ='{rview["ma_vt"].ToString().Trim()}' AND dvt1 = N'{rview["dvt1"].ToString().Trim()}' AND Isnull(dvt1,'')<>''";
            DataSet resultcf = await myDb.LoadDataset(sqlcmd);
            if (resultcf.Tables.Count > 0)
            {
                int checkdel = int.Parse(resultcf.Tables[0].Rows[0][0].ToString());
                if (checkdel > 0)
                {
                    myStateMN.SetNewThongbao(Lap["Unremoved data has been generated"] + " !");
                    return;
                }
            }

            MessageDl = String.Format(Lap["Do you want to delete :{0} ?"], SqlTableKeyValue);
            ResultDl = await myDlSvc.ConfirmAsync(new MessageBoxOptions()
            {
                Text = MessageDl,
                Title = Lap["Confirm deletion of list"],
                OkButtonText = Lap["OK"],
                CancelButtonText = Lap["Cancel"],
                ShowIcon = true,
                ShowCloseButton = false,
                RenderStyle = MessageBoxRenderStyle.Danger,
            });
            if (ResultDl == true)
            {
                await Dongy_xoa(rview,true);
                StateHasChanged();
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }
    public async Task Dongy_xoa(DataRowView rview,bool status)
    {
        if (status)
        {
            string sql = "Delete " + sqlTableName + $" where ma_vt ='{rview["ma_vt"].ToString().Trim()}' AND dvt1 = N'{rview["dvt1"].ToString().Trim()}' AND Isnull(dvt1,'')<>''";
            await myDb.ExecuteSqlQueryAsync(sql);
            await Loaddata();
            string ToastMessage = String.Format(Lap["Delete successfully : {0}"], rview["ma_vt"].ToString().Trim() + "-" +rview["dvt1"].ToString().Trim());
            myStateMN.SetNewThongbao(ToastMessage);
        }
        MessageDl = "";
    }

    public void V_Sua1()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string[] strKeys = SqlTableKey.Split(";");            
            bool hasAllKeys = true;
            foreach (string key in strKeys)
            {
                if (!rview.DataView.Table.Columns.Contains(key))
                {
                    hasAllKeys = false;
                    break;
                }
            }

            if (!hasAllKeys)
                return;
            
            List<string> keyValues = new List<string>();
            foreach (string key in strKeys)
            {
                if (!String.IsNullOrEmpty(rview[key].ToString()))
                {
                    keyValues.Add(rview[key].ToString().Trim());
                }
            }

            if (keyValues.Count == strKeys.Length)
            {
                SqlTableKeyValue = String.Join(";", keyValues);

                if (editPage.ToUpper().StartsWith("FRM"))
                    myNavi.NavigateTo(editPage + "/" + Menu_id + "/" + SqlTableKeyValue);
                else
                {
                    Par.Clear();
                    Par.Add("Ma_ma", (object)SqlTableKeyValue);
                    Par.Add("Menu_id", (object)Menu_id);
                    Par.Add("ShowAdd", (object)true);
                    Par.Add("curActionTask", (object)ActionTask.Edit);
                    Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
                    IsShowFrm = true;
                    StateHasChanged();
                }
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }
    
