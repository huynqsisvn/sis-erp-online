    private async Task CopyFrom(string sourceSttRec)
    {
        await Loaddata();

        var srcHeader = CurPh;
        var srcDetail = LSCt.ToList();

        V_Moi(); // t?o m?i (stt_rec m?i)

        // copy thông tin header (tr? khóa và s?)
        CurPh.Ma_kho = srcHeader.Ma_kho;
        CurPh.Ma_khon = srcHeader.Ma_khon;
        CurPh.Ong_ba = srcHeader.Ong_ba;
        CurPh.Dien_giai = srcHeader.Dien_giai;
        CurPh.Ma_qs = srcHeader.Ma_qs;
        CurPh.Ma_nt = srcHeader.Ma_nt;
        CurPh.Ty_gia = srcHeader.Ty_gia;
        CurPh.Sua_tien = srcHeader.Sua_tien;
        CurPh.Px_gia_dd = srcHeader.Px_gia_dd;

        // copy chi ti?t
        LSCt = srcDetail.Select((x, idx) =>
        {
            var ct = x;
            ct.Stt_rec = CurPh.Stt_rec;
            ct.Stt_rec0 = string.Format("{0:0000}", idx + 1);
            ct.Ma_ct = Ma_ct;
            return ct;
        }).ToList();

        PreSum_All();
        await InvokeAsync(StateHasChanged);
    }

