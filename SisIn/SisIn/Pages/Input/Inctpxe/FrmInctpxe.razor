    async void OnGridCTLostFocus(FocusEventArgs e)
    {
        // Kiểm tra xem focus có còn trong grid không
        bool stillInside = await JavacriptS.InvokeAsync<bool>("focusInside", "grid-wrapper");
        if (stillInside)
            return;

        // Tự động lưu grid khi click ra ngoài
        if (GridCT.IsEditing() && activeTabIndex == 0 && AllowEditMode)
        {
            try
            {
                await GridCT.SaveChangesAsync();
                PreSum_All();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                // Log error nếu cần
                Console.WriteLine($"Error saving grid: {ex.Message}");
            }
        }
    }
