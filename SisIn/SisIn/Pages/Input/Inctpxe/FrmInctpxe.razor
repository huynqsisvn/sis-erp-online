    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _filter_qs = String.Format("ma_cts = '' OR ma_cts like '%{0}%'", Ma_ct);
        LoadQuyenso();
        LoadOptions();

        switch (curActionTask)
        {
            case ActionTask.View:
                Pagetitle = Lap["View"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                V_Xem();
                break;
            case ActionTask.Edit:
                Pagetitle = Lap["Edit"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                V_Sua();
                break;
            case ActionTask.New:
                Pagetitle = Lap["New"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                V_Moi();
                break;
            case ActionTask.Copy:
                Pagetitle = Lap["Copy"] + ": " + (IsLangEn ? curDmct.Ten_ct2 : curDmct.Ten_ct);
                V_Copy();
                break;
        }
    }

