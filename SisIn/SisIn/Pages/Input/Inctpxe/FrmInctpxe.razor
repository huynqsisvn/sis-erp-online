    async void OnGridCT_DMDM_Changed(ExpandoObject value, string fieldName)
    {
        if (value == null)
            return;

        switch (fieldName.ToLower())
        {
            case "ma_vt":
                {
                    CurrentEditModel.Ma_vt = value.Where(a => a.Key.Equals("ma_vt")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Ten_vt = value.Where(a => a.Key.Equals("ten_vt")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Tk_vt = value.Where(a => a.Key.Equals("tk_vt")).FirstOrDefault().Value?.ToString() ?? "";

                    if (!string.IsNullOrEmpty(CurrentEditModel.Tk_vt))
                    {
                        CurrentEditModel.Ma_nx_i = CurrentEditModel.Tk_vt;
                    }

                    object heso = myDb.GetValue("select hs_qd from v_dmvtdvt where ma_vt = '" + CurrentEditModel.Ma_vt.Trim() + "' AND dvt1=N'" + (CurrentEditModel.Dvt1?.Trim() ?? "") + "'");

                    if (heso != null && heso != DBNull.Value && decimal.TryParse(heso.ToString(), out decimal parsedHeso))
                    {
                        CurrentEditModel.He_so1 = parsedHeso;
                    }
                    else
                    {
                        CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt")).FirstOrDefault().Value?.ToString() ?? "";
                        CurrentEditModel.He_so1 = 1;
                    }

                    string loai_vt = value.Where(a => a.Key.Equals("loai_vt")).FirstOrDefault().Value?.ToString() ?? "";
                    string _vt_tk = value.Where(a => a.Key.Equals("vt_ton_kho")).FirstOrDefault().Value?.ToString() ?? "";
                    CurrentEditModel.Vt_ton_kho = string.IsNullOrEmpty(_vt_tk) ? 0 : int.Parse(_vt_tk);

                    if (CurrentEditModel.Vt_ton_kho == 0)
                    {
                        CurrentEditModel.So_luong = 0;
                        CurrentEditModel.Gia_nt = CurrentEditModel.Gia = 0;
                        CurrentEditModel.Tien_nt = CurrentEditModel.Tien = 0;
                    }

                    if (CurrentEditModel.Vt_ton_kho == 1)
                    {
                        if (M_QL_LO_CK.ToString().Trim() != "1")
                        {
                            CurrentEditModel.Ton13 = GetTon13(CurPh.Ma_kho, CurrentEditModel.Ma_vt.Trim(), "");
                        }
                        else
                        {
                            CurrentEditModel.Ton13 = GetTon13Lo(CurPh.Ma_kho, CurrentEditModel.Ma_vt.Trim(), "", CurrentEditModel.Ma_lo);
                        }
                    }
                    else
                        CurrentEditModel.Ton13 = 0;
                    break;
                }
            case "dvt1":
                CurrentEditModel.Dvt1 = value.Where(a => a.Key.Equals("dvt1")).FirstOrDefault().Value?.ToString() ?? "";
                var hs_qd = value.Where(a => a.Key.Equals("hs_qd")).FirstOrDefault().Value?.ToString() ?? "" ?? "0";
                CurrentEditModel.He_so1 = decimal.TryParse(hs_qd, out var hs) ? hs : 0m;
                StateHasChanged();
                break;

            case "ma_lo":
                CurrentEditModel.Ma_lo = value.Where(a => a.Key.Equals("ma_lo")).FirstOrDefault().Value?.ToString() ?? "";
                CurrentEditModel.Ngay_hh = DateTime.TryParse(value.Where(a => a.Key.Equals("ngay_hh")).FirstOrDefault().Value?.ToString() ?? "", out var han_sd) ? han_sd : (DateTime?)null;
                if (CurrentEditModel.Vt_ton_kho == 1)
                {
                    if (CurrentEditModel.Ma_vt != "" && CurPh.Ma_kho != "")
                    {
                        if (M_QL_LO_CK.ToString().Trim() != "1")
                        {
                            CurrentEditModel.Ton13 = GetTon13(CurPh.Ma_kho, CurrentEditModel.Ma_vt.Trim(), "");
                        }
                        else
                        {
                            CurrentEditModel.Ton13 = GetTon13Lo(CurPh.Ma_kho, CurrentEditModel.Ma_vt.Trim(), "", CurrentEditModel.Ma_lo);
                        }
                    }
                }
                else
                    CurrentEditModel.Ton13 = 0;
                break;

            case "tk_vt":
                {
                    CurrentEditModel.Tk_vt = value.Where(a => a.Key.Equals("tk")).FirstOrDefault().Value?.ToString() ?? "";
                    break;
                }

            case "ma_nx_i":
                {
                    CurrentEditModel.Ma_nx_i = value.Where(a => a.Key.Equals("tk")).FirstOrDefault().Value?.ToString() ?? "";
                    break;
                }
        }

        await InvokeAsync(StateHasChanged);
    }
    void OnGridCT_Value_Changed(decimal newvalue, string name)
    {
        if (!string.IsNullOrEmpty(name) && CurrentEditModel != null)
        {
            switch (name.ToLower())
            {
                case "so_luong":
                    {
                        CurrentEditModel.So_luong = newvalue;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        if (CurrentEditModel.So_luong == 0)
                        {
                            CurrentEditModel.Gia_nt = CurrentEditModel.Gia = 0;
                        }
                        else
                        {
                            decimal gia_nt = CurrentEditModel.Gia_nt;
                            decimal gia = Math.Round(gia_nt * ty_gia, M_ROUND_GIA);
                            if (gia != 0) CurrentEditModel.Gia = gia;
                        }

                        decimal tien_nt = Math.Round(CurrentEditModel.So_luong * CurrentEditModel.Gia_nt, M_ROUND_NT);
                        CurrentEditModel.Tien = Math.Round(tien_nt * ty_gia, M_ROUND);
                        CurrentEditModel.Tien_nt = tien_nt != 0 ? tien_nt : 0;

                        if (isVND)
                        {
                            CurrentEditModel.Gia = CurrentEditModel.Gia_nt;
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurPh.T_tien = CurPh.T_tien_nt;
                        }

                        StateHasChanged();
                        break;
                    }
                case "gia_nt":
                    {
                        CurrentEditModel.Gia_nt = newvalue;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        decimal gia2 = Math.Round(CurrentEditModel.Gia_nt * ty_gia, M_ROUND_GIA);
                        if (CurrentEditModel.So_luong != 0 && gia2 != 0)
                            CurrentEditModel.Gia = gia2;

                        if ((CurPh.Sua_tien == 1m) != true)
                        {
                            decimal tien_nt2 = Math.Round(CurrentEditModel.So_luong * CurrentEditModel.Gia_nt, M_ROUND_NT);
                            if (tien_nt2 != 0)
                            {
                                CurrentEditModel.Tien_nt = tien_nt2;
                            }
                        }

                        decimal tien2 = Math.Round(CurrentEditModel.Tien_nt * ty_gia, M_ROUND);
                        if (tien2 != 0)
                        {
                            CurrentEditModel.Tien = tien2;
                        }

                        if (isVND)
                        {
                            CurrentEditModel.Gia = CurrentEditModel.Gia_nt;
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurPh.T_tien = CurPh.T_tien_nt;
                        }

                        StateHasChanged();
                        break;
                    }
                case "tien_nt":
                    {
                        CurrentEditModel.Tien_nt = newvalue;
                        decimal ty_gia = CurPh.Ty_gia > 0 ? CurPh.Ty_gia : 1m;
                        bool isVND = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

                        if (CurrentEditModel.So_luong > 0 && CurrentEditModel.Gia_nt == 0)
                        {
                            CurrentEditModel.Gia_nt = Math.Round(CurrentEditModel.Tien_nt / CurrentEditModel.So_luong, M_ROUND_GIA);
                        }

                        CurrentEditModel.Tien = Math.Round(CurrentEditModel.Tien_nt * ty_gia, M_ROUND);

                        if (isVND)
                        {
                            CurrentEditModel.Tien = CurrentEditModel.Tien_nt;
                            CurPh.T_tien = CurPh.T_tien_nt;
                        }

                        StateHasChanged();
                        break;
                    }
                case "gia":
                    {
                        CurrentEditModel.Gia = newvalue;
                        CurrentEditModel.Tien = Math.Round(CurrentEditModel.So_luong * CurrentEditModel.Gia, M_ROUND);
                        break;
                    }
                case "tien":
                    {
                        CurrentEditModel.Tien = newvalue;
                        break;
                    }
            }
        }
        PreSum_All();
    }

