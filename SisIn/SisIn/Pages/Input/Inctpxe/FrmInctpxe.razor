    public override async Task Loaddata()
    {
        LoadVoucher();

        if (DsTrans != null && DsTrans.Tables.Count > 0)
        {
            List<Ph85> ls85 = myDb.ConvertDataTable<Ph85>(DsTrans.Tables[0]);
            if (ls85 != null && ls85.Count > 0)
            {
                CurPh = ls85[0];
                NotMaNt0Voucher = !CurPh.Ma_nt.Equals(M_ma_nt0) ? true : false;
            }

            if (DsTrans != null && DsTrans.Tables.Count > 1)
                LSCt = myDb.ConvertDataTable<Ct85>(DsTrans.Tables[1]);
        }
    }

    private void Post()
    {
        string _poststore = (Post_store == null || Post_store.Length <= 2) ? "[INCTPXE-Post]" : Post_store[2];
        string format = string.Format("exec [dbo].{0} '{1}',0", _poststore, CurPh.Stt_rec);
        myDb.ExecuteSqlQueryAsync(format);
    }

    public DataSet CheckData(int mode)
    {
        string format = "exec [dbo].{0}  " + $"@status='{CurPh.Status.Trim()}' , @stt_rec='{CurPh.Stt_rec}', @mode={(curActionTask == ActionTask.Edit ? 0 : 1)};";
        string[] Check_Valid_Store = (curDmct == null ? "" : curDmct.Check_valid_store.Trim()).Split("|");
        string sqlcmd = (Check_Valid_Store == null || Check_Valid_Store.Length <= 7) ? string.Format(format, (object)"[INCTPXE-CheckData]") : string.Format(format, (object)Check_Valid_Store[7]);
        DataSet dsResult = myDb.LoadDataSet(sqlcmd);
        return dsResult;
    }
    private async Task<bool> CheckValid()
    {
        if (string.IsNullOrWhiteSpace(CurPh.Ma_kho))
        {
            myStateMN.SetNewThongbao(Lap["No from site"]);
            return false;
        }
        if (string.IsNullOrWhiteSpace(CurPh.Ma_khon))
        {
            myStateMN.SetNewThongbao(Lap["No to site"]);
            return false;
        }
        if (CurPh.Ma_kho?.Trim() == CurPh.Ma_khon?.Trim())
        {
            myStateMN.SetNewThongbao(Lap["To site must be different from from site"]);
            return false;
        }
        if (!CurPh.Ngay_ct.HasValue)
        {
            myStateMN.SetNewThongbao(Lap["GL date invalid"] + " !");
            return false;
        }

        await GridCT.SaveChangesAsync();

        if (LSCt == null || LSCt.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["No details entered"] + " !");
            return false;
        }

        foreach (var row in LSCt)
        {
            if (string.IsNullOrWhiteSpace(row.Ma_vt))
            {
                myStateMN.SetNewThongbao(Lap["Item code is required"] + " !");
                return false;
            }
        }

        return true;
    }

    void PreSum_All()
    {
        CurPh.T_so_luong = LSCt?.Sum(x => x.So_luong) ?? 0;
        CurPh.T_tien_nt = LSCt?.Sum(x => x.Tien_nt) ?? 0;
        CurPh.T_tien = LSCt?.Sum(x => x.Tien) ?? 0;
    }

    private async Task Save()
    {
        if (!SisData.Lib.CheckValidNgayKs(mySysvar, myDb, CurPh.Ngay_ct, Ma_ct))
        {
            myStateMN.SetNewThongbao(Lap["Data is locked, cannot be edited!"]);
            return;
        }

        if (!await CheckValid())
            return;

        PreSum_All();

        CurPh.Date = DateTime.Now.Date;
        CurPh.Time = DateTime.Now.ToString("HH:mm:ss");
        CurPh.User_id = curUser?.User_id.ToString();
        CurPh.Ma_dvcs = myStateMN.GetMa_Dvcs();

        foreach (var ct in LSCt)
        {
            ct.Stt_rec = CurPh.Stt_rec;
            ct.Ma_ct = Ma_ct;
            if (ct.He_so1 != new decimal(0))
            {
                ct.So_luong1 = Converts.Round(ct.So_luong * ct.He_so1, M_IP_SL);
            }
        }

        try
        {
            if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
            {
                CurPh.Date0 = DateTime.Now.Date;
                CurPh.Time0 = DateTime.Now.ToString("HH:mm:ss");
                CurPh.User_id0 = curUser?.User_id.ToString();

                myDb.UpdateDataRowFromModel<Ph85>(DsTrans.Tables[0].Rows[0], CurPh);
                await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

                if (LSCt.Count > 0)
                {
                    int _count = 0;
                    foreach (Ct85 _ct85 in LSCt)
                    {
                        _count++;
                        DataRow _row = DsTrans.Tables[1].NewRow();
                        _row["Column1"] = _count.ToString();
                        myDb.UpdateDataRowFromModel<Ct85>(_row, _ct85);
                        DsTrans.Tables[1].Rows.Add(_row);
                    }
                    await myDb.InsertManyRow<Ct85>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec);
                }

            }
            else if (curActionTask == ActionTask.Edit)
            {
                myDb.UpdateDataRowFromModel<Ph85>(DsTrans.Tables[0].Rows[0], CurPh);
                await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");
                await myDb.ExecuteSqlQueryAsync($"Delete from {M_Ctdbf} where stt_rec = '{CurPh.Stt_rec}'");

                if (LSCt.Count > 0)
                {
                    int _count = 0;
                    foreach (Ct85 _ct85 in LSCt)
                    {
                        _count++;
                        DataRow _row = DsTrans.Tables[1].NewRow();
                        _row["Column1"] = _count.ToString();
                        myDb.UpdateDataRowFromModel<Ct85>(_row, _ct85);
                        DsTrans.Tables[1].Rows.Add(_row);
                    }
                    await myDb.InsertManyRow<Ct85>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec);
                }

            }
            //Kiểm tra dữ liệu sau khi lưu
            SaveLastPh(CurPh);
            dsCheckData = CheckData(curActionTask == ActionTask.Edit ? 0 : 1);
            bool validationFailed = false;
            if (this.dsCheckData.Tables.Count > 0)
            {
                validationFailed = false;
                string str = "";
                foreach (DataRowView dataRowView in this.dsCheckData.Tables[0].DefaultView)
                {
                    switch (dataRowView[0].ToString())
                    {
                        case "PH01":
                            var obj = myDb.GetValue("Select chkso_ct from dmqs where ma_qs = '" + CurPh.Ma_qs.Trim() + "'");
                            M_trung_so = obj?.ToString().Trim() ?? "0";

                            if (M_trung_so.Equals("1"))
                            {
                                string _message = string.Format(Lap["Có chứng từ trùng số. Số cuối cùng là: [{0}]. Có lưu chứng từ này không?"],
                                    this.GetLastSoct(this.CurPh.Ma_qs).Trim());

                                var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
                                {
                                    Text = _message,
                                    Title = Lap["Xác nhận nhập liệu"],
                                    OkButtonText = Lap["Có"],
                                    CancelButtonText = Lap["Không"],
                                    ShowIcon = true,
                                    RenderStyle = MessageBoxRenderStyle.Warning
                                });

                                if (!confirm)
                                {
                                    await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('so_ct_input')?.focus()");
                                    validationFailed = true;
                                    break;
                                }
                            }
                            else if (M_trung_so.Equals("2"))
                            {
                                await myDlSvc.ConfirmAsync(new MessageBoxOptions
                                {
                                    Text = Lap["The voucher number already exists"] + " !",
                                    Title = Lap["Notification"],
                                    OkButtonText = Lap["OK"],
                                    ShowIcon = true,
                                    RenderStyle = MessageBoxRenderStyle.Danger
                                });
                                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('so_ct_input')?.focus()");
                                validationFailed = true;
                                break;
                            }
                            break;

                        case "PH02":
                            if (!validationFailed && curActionTask != ActionTask.Edit && this.dsCheckData.Tables.Count > 1)
                            {
                                int errorCode = Convert.ToInt32(this.dsCheckData.Tables[1].Rows[0][0]);

                                switch (errorCode)
                                {
                                    case 1:
                                        await myDlSvc.ConfirmAsync(new MessageBoxOptions
                                        {
                                            Text = Lap["Invalid invoice symbol start date"] + " !",
                                            Title = Lap["Notification"],
                                            OkButtonText = Lap["OK"],
                                            ShowIcon = true,
                                            RenderStyle = MessageBoxRenderStyle.Warning
                                        });
                                        await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_ct_input')?.focus()");
                                        validationFailed = true;
                                        break;

                                    case 2:
                                        await myDlSvc.ConfirmAsync(new MessageBoxOptions
                                        {
                                            Text = Lap["Invalid invoice symbol usage permission."] + " !",
                                            Title = Lap["Notification"],
                                            OkButtonText = Lap["OK"],
                                            ShowIcon = true,
                                            RenderStyle = MessageBoxRenderStyle.Warning
                                        });
                                        await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_qs_input')?.querySelector('input')?.focus()");
                                        validationFailed = true;
                                        break;

                                    case 3:
                                        if (this.dsCheckData.Tables.Count > 4 && this.dsCheckData.Tables[4].Rows.Count > 0)
                                        {
                                            string tenTthd = this.dsCheckData.Tables[4].Rows[0]["ten_tthd"]?.ToString().Trim().ToLower() ?? "";
                                            string message = string.Format(Lap["Số hóa đơn của ký hiệu [{0}] đã [{1}]!"],
                                                CurPh.Ma_qs.Trim(), tenTthd);

                                            await myDlSvc.ConfirmAsync(new MessageBoxOptions
                                            {
                                                Text = message,
                                                Title = Lap["Notification"],
                                                OkButtonText = Lap["OK"],
                                                ShowIcon = true,
                                                RenderStyle = MessageBoxRenderStyle.Warning
                                            });

                                            // Lấy số chứng từ mới
                                            curQuyenso = GetNewSo_ct(CurPh.Ma_qs);
                                            CurPh.So_ct = string.Format(curQuyenso.Ma_qs, curQuyenso.So_ct);
                                            await InvokeAsync(StateHasChanged);
                                            validationFailed = true;
                                        }
                                        break;
                                }
                            }
                            break;

                        case "PH03":
                            await myDlSvc.ConfirmAsync(new MessageBoxOptions
                            {
                                Text = Lap["Invoice numbers are not sequential"] + " !",
                                Title = Lap["Notification"],
                                OkButtonText = Lap["OK"],
                                ShowIcon = true,
                                RenderStyle = MessageBoxRenderStyle.Warning
                            });

                            // Lấy số chứng từ mới
                            curQuyenso = GetNewSo_ct(CurPh.Ma_qs);
                            CurPh.So_ct = string.Format(curQuyenso.Ma_qs, curQuyenso.So_ct);
                            await InvokeAsync(StateHasChanged);
                            validationFailed = true;
                            break;

                        case "CT01":
                        case "CT02":
                            {
                                int rowIndex = Convert.ToInt16(dataRowView[1]);
                                string message = dataRowView[0].ToString() switch
                                {
                                    "CT01" => Lap["Tk nợ là tk tổng hợp, không lưu được!"],
                                    "CT02" => Lap["Tk có là tk tổng hợp, không lưu được!"],
                                    _ => "Tài khoản tổng hợp không lưu được!"
                                };

                                await myDlSvc.ConfirmAsync(new MessageBoxOptions
                                {
                                    Text = message,
                                    Title = Lap["Notification"],
                                    OkButtonText = Lap["OK"],
                                    ShowIcon = true,
                                    RenderStyle = MessageBoxRenderStyle.Warning
                                });

                                if (rowIndex >= 0 && rowIndex < LSCt.Count)
                                {
                                    string sttRec0 = LSCt[rowIndex].Stt_rec0;
                                    string fieldId = dataRowView[0].ToString() switch
                                    {
                                        "CT01" => $"Tk_vt_{sttRec0}",
                                        "CT02" => $"Ma_nx_i{sttRec0}",
                                        _ => $"Ma_vt_{sttRec0}"
                                    };

                                    // Focus vào cell tương ứng và mở edit mode
                                    await GridCT.StartEditDataItemAsync(LSCt[rowIndex]);
                                    await Task.Delay(100); // Đợi grid render

                                    string js = $"var el = document.getElementById('{fieldId}'); " +
                                                $"if(el){{ var input = el.querySelector('input'); if(input) input.focus(); }}";
                                    await JavacriptS.InvokeVoidAsync("eval", js);
                                }
                                validationFailed = true;
                            }
                            break;

                        case "CT03":
                            {
                                int rowIndex = Convert.ToInt16(dataRowView[1]);
                                if (rowIndex >= 0 && rowIndex < LSCt.Count)
                                {
                                    var ct = LSCt[rowIndex];
                                    if (!string.IsNullOrEmpty(CurPh.Ma_kho) && !string.IsNullOrEmpty(ct.Ma_vt))
                                    {
                                        if (M_QL_LO_CK == "1")
                                        {
                                            ct.Ton13 = GetTon13Lo(CurPh.Ma_kho, ct.Ma_vt.Trim(), ct.Ma_vv_i ?? "", ct.Ma_lo ?? "");
                                        }
                                        else
                                        {
                                            ct.Ton13 = GetTon13(CurPh.Ma_kho, ct.Ma_vt.Trim(), ct.Ma_vv_i ?? "");
                                        }
                                    }
                                    if (!str.Contains(ct.Ma_vt))
                                    {
                                        str = str + ct.Ma_vt.Trim() + ", ";
                                        break;
                                    }
                                }

                            }
                            break;
                    }
                }
                if (!string.IsNullOrEmpty(str))
                {
                    str = str.Substring(0, str.Length - 2);
                    string M_CHK_TON_VT = myOption.GetOptionsValue("M_CHK_TON_VT").Trim();
                    string message = string.Format(Lap["The following item codes have insufficient stock quantity in the warehouse: {0}"], str);
                    if (M_CHK_TON_VT == "2")
                    {
                        await myDlSvc.ConfirmAsync(new MessageBoxOptions
                        {
                            Text = message,
                            Title = Lap["Notification"] + ", " + Lap["Unable to save"].ToString().ToLower() + " !",
                            OkButtonText = Lap["OK"],
                            ShowIcon = true,
                            RenderStyle = MessageBoxRenderStyle.Warning
                        });
                        validationFailed = true;
                    }
                    else if (M_CHK_TON_VT == "2")
                    {
                        await myDlSvc.ConfirmAsync(new MessageBoxOptions
                        {
                            Text = message,
                            Title = Lap["Notification"] + " !",
                            OkButtonText = Lap["OK"],
                            ShowIcon = true,
                            RenderStyle = MessageBoxRenderStyle.Warning
                        });
                    }
                }
            }

            if (validationFailed)
            {
                IsSaved = false;
                return;
            }
            else
            {
                IsSaved = true;
            }

            Post();

            AllowEditMode = false;
            IsSaved = true;
            if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
            {
                myStateMN.SetNewThongbao(string.Format(Lap["Successfully added new : {0}"].ToString(), CurPh.So_ct));
            }
            else if (curActionTask == ActionTask.Edit)
            {
                myStateMN.SetNewThongbao(string.Format(Lap["Edit successfully : {0}"].ToString(), CurPh.So_ct));
            }
            curActionTask = ActionTask.View;
            ParentReload = true;
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Error"] + " : " + ex.Message);
        }

        StateHasChanged();
    }

