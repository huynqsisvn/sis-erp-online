@inherits TranBaseComponent
@using System.Data
@using DevExpress.Blazor

<div class="m-0 p-0 w-100 frm-inctpxe" data-spy="scroll" style="overflow:auto;">
    @if (IsShowVoucher)
    {
        <FormTrans Title="@Pagetitle" @bind-curActionTask="@curActionTask" OnNew="@OnNew" OnCopy="@OnCopy" OnEdit="@OnEdit" OnSave="@OnSave" OnCancel="@OnCancel" OnPrint="@OnPrint" OnTemplateChanged="@OnTemplateChanged" Stt_rec="@CurPh.Stt_rec" curUser="@curUser" Ma_ct="@Ma_ct" Menu_id="@Menu_id" Phdbf="@M_Phdbf" LanguageID="@LanguageID">
            <div class="row m-1 mt-3 me-2">
                <div class="frm-inctpxe-container">
                    <DxFormLayout SizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
                        <DxFormLayoutGroup ColSpanMd="12" Caption="@Lap["Infomation"]" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide">
                            <DxFormLayoutGroup ColSpanMd="8" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">

                                <DxFormLayoutItem Caption="@Lap["From site"]" ColSpanMd="6">
                                    <Template>
                                        <AutocompleteComponent Id="ma_kho_input" Ma_dm="dmkho" @bind-Value="@CurPh.Ma_kho" SelectChanged="OnAutoCompleteKhoXuatChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                    </Template>
                                </DxFormLayoutItem>

                                <DxFormLayoutItem Caption="@Lap["To site"]" ColSpanMd="6">
                                    <Template>
                                        <AutocompleteComponent Id="ma_khon_input" Ma_dm="dmkho" @bind-Value="@CurPh.Ma_khon" SelectChanged="OnAutoCompleteKhoNhapChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                    </Template>
                                </DxFormLayoutItem>

                                <DxFormLayoutItem Caption="@Lap["Deliverer"]" ColSpanMd="12">
                                    <Template>
                                        <DxTextBox @bind-Text="@CurPh.Ong_ba" Enabled="@AllowEditMode"></DxTextBox>
                                    </Template>
                                </DxFormLayoutItem>

                                <DxFormLayoutItem Caption="@Lap["Description"]" ColSpanMd="12">
                                    <Template>
                                        <DxTextBox @bind-Text="@CurPh.Dien_giai" Enabled="@AllowEditMode"></DxTextBox>
                                    </Template>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>

                            <DxFormLayoutGroup Caption="@Lap["Voucher"]" ColSpanMd="4" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">
                                <DxFormLayoutItem Caption="@Lap["GL date"]" ColSpanMd="12">
                                    <DxDateEdit Id="ngay_ct_input" @bind-Date="@CurPh.Ngay_ct" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["LCT date"]" ColSpanMd="12">
                                    <DxDateEdit @bind-Date="@CurPh.Ngay_lct" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["Book code"]" ColSpanMd="12">
                                    <AutocompleteComponent Id="ma_qs_input" Ma_dm="dmqs" @bind-Value="@CurPh.Ma_qs" SelectChanged="OnAutoCompleteQuyensoChanged" Filter="@_filter_qs" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["Voucher No"]" ColSpanMd="12">
                                    <DxTextBox Id="so_ct_input" @bind-Text="@CurPh.So_ct" Enabled="@AllowEditMode"></DxTextBox>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["Ex. rate"]" ColSpanMd="8">
                                    <Template>
                                        <AutocompleteComponent Ma_dm="dmnt" @bind-Value="@CurPh.Ma_nt" SelectChanged="OnAutoCompleteMaNTChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="4">
                                    <Template>
                                        <DxSpinEdit ReadOnly="@(CurPh?.Ma_nt?.Trim().Equals(M_ma_nt0) == true)" Value="@CurPh.Ty_gia" ValueExpression="@(() => CurPh.Ty_gia)" ValueChanged="@((decimal newvalue) => { OnValueTyGiaChanged(newvalue); })" DisplayFormat="@M_IP_TY_GIA" Enabled="@AllowEditMode" Id="Ty_gia"></DxSpinEdit>
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="12">
                                    <Template>
                                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmpost" @bind-Value="@CurPh.Status" Filter="@filter_status" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                    </Template>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>
                        </DxFormLayoutGroup>

                        <DxFormLayoutGroup ColSpanMd="12" Caption="@Lap["Transfer/Contract"]" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide" Expanded="false">
                            <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                                <DxFormLayoutItem Caption="@Lap["Contract number"]" ColSpanMd="12">
                                    <DxTextBox @bind-Text="@CurPh.So_lenhdd" Enabled="@AllowEditMode"></DxTextBox>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["Date"]" ColSpanMd="12">
                                    <DxDateEdit @bind-Date="@CurPh.Ngay_lenhdd" DisplayFormat="dd-MM-yyyy" Enabled="@AllowEditMode"></DxDateEdit>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["of"]" ColSpanMd="12">
                                    <DxTextBox @bind-Text="@CurPh.Cua_lenhdd" Enabled="@AllowEditMode"></DxTextBox>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>
                            <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                                <DxFormLayoutItem Caption="@Lap["About / with"]" ColSpanMd="12">
                                    <DxTextBox @bind-Text="@CurPh.Viec_lenhdd" Enabled="@AllowEditMode"></DxTextBox>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@Lap["Transportation"]" ColSpanMd="12">
                                    <DxTextBox @bind-Text="@CurPh.Phuong_tien_lenhdd" Enabled="@AllowEditMode"></DxTextBox>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>
                        </DxFormLayoutGroup>

                        <!-- Chi ti?t v?t t? -->
                        <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail" @bind-ActiveTabIndex="@activeTabIndex" TabClick="@OnTabChanged">
                            <DxFormLayoutTabPage Caption="@Lap["Details"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                                <DxFormLayoutItem ColSpanMd="12">
                                    <Template>
                                        <div @ref="GridWrapper" id="grid-wrapper" @onfocusout="OnGridCTLostFocus" class="mt-2 mb-3">
                                            <DxGrid @ref="GridCT" SizeMode="@Itemsizemode" CssClass="@grd_Css" @onkeydown="GridCT_OnKeyDown"
                                                    AllowSelectRowByClick=true KeyboardNavigationEnabled="true"
                                                    Data="@LSCt"
                                                    @bind-SelectedDataItem="@SelectedDataItemCT"
                                                    ValidationEnabled="false"
                                                    EditMode="GridEditMode.EditRow"
                                                    RowClick="@StartEditDataItemByClickCT"
                                                    SelectionMode="GridSelectionMode.Single"
                                                    CustomizeEditModel="Grid_CustomizeEditModelCT"
                                                    EditModelSaving="Grid_EditModelSavingCT"
                                                    DataItemDeleting="Grid_DataItemDeletingCT"
                                                    CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                                    ColumnResizeMode="GridColumnResizeMode.NextColumn"
                                                    EditNewRowPosition="@NewItemRowPosition"
                                                    ShowAllRows="true"
                                                    TextWrapEnabled="false" AllowSort="false"
                                                    HighlightRowOnHover="true">
                                                <Columns>
                                                    <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                                        <CellDisplayTemplate Context="cntedit">
                                                            <div class="grid-cell-align-center">
                                                                <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                                          RenderStyle="ButtonRenderStyle.Link"
                                                                          CssClass="grid-delete-btn"
                                                                          aria-label="Delete"
                                                                          Click="@(() => GridCT.ShowRowDeleteConfirmation(cntedit.VisibleIndex))" />
                                                            </div>
                                                        </CellDisplayTemplate>
                                                        <CellEditTemplate Context="cntedit1">
                                                            <div class="grid-cell-align-center">
                                                                <DxButton Enabled="false"
                                                                          CssClass="grid-disabled-button"
                                                                          IconCssClass="grid-icon grid-icon-delete"
                                                                          aria-label="Delete"
                                                                          RenderStyle="ButtonRenderStyle.Link" />
                                                            </div>
                                                        </CellEditTemplate>
                                                    </DxGridCommandColumn>

                                                    <DxGridDataColumn FieldName="Ma_vt" Caption="@Lap["Item code"].ToString()" Width="150" CaptionAlignment="GridTextAlignment.Center">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <div id="@($"Ma_vt_{_Ct85.Stt_rec0}")" class="autocomplete-cell-wrapper m-0 p-0">
                                                                <AutocompleteComponent Ma_dm="dmvt" @bind-Value="@_Ct85.Ma_vt" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_vt"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                            </div>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Ten_vt" ReadOnly="true" Caption="@Lap["Item name"]" CaptionAlignment="GridTextAlignment.Center" Width="200" />

                                                    <DxGridDataColumn FieldName="Dvt1" Caption="@Lap["UOM"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <AutocompleteComponent Ma_dm="dmvtdvt" Filter="@(String.Format(" ma_vt = '{0}'", (_Ct85.Ma_vt?.Trim()) ?? ""))" @bind-Value="@_Ct85.Dvt1" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Dvt1"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </CellEditTemplate>
                                                        <CellDisplayTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.DataItem;
                                                            }
                                                            <div>@(_Ct85.Dvt1)</div>
                                                        </CellDisplayTemplate>
                                                    </DxGridDataColumn>
                                                    @if (M_QL_LO_CK == "1")
                                                    {
                                                        <DxGridDataColumn FieldName="Ma_lo" Caption="@Lap["Lot code"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120" Visible="@(M_QL_LO_CK == "1")">
                                                            <CellEditTemplate Context="GrdContext">
                                                                @{
                                                                    var _Ct85 = (Ct85)GrdContext.EditModel;
                                                                }
                                                                <AutocompleteComponent Ma_dm="dmlo" @bind-Value="@_Ct85.Ma_lo" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_lo"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                            </CellEditTemplate>
                                                        </DxGridDataColumn>

                                                        <DxGridDataColumn FieldName="Han_sd_lot" ReadOnly="true" Caption="@Lap["Expiry date"]" CaptionAlignment="GridTextAlignment.Center" Width="120" Visible="@(M_QL_LO_CK == "1")" />
                                                    }

                                                    <DxGridDataColumn FieldName="Ton13" ReadOnly="true" Caption="@Lap["Stock"]" CaptionAlignment="GridTextAlignment.Center" Width="100" DisplayFormat="@M_IP_SL" />

                                                    <DxGridDataColumn FieldName="So_luong" Caption="@Lap["Quantity"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="120" DisplayFormat="@M_IP_SL">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct85.So_luong" ValueExpression="@(() => _Ct85.So_luong)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "So_luong"); })" Id="So_luong"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Gia_nt" Caption="@String.Concat(Lap["Price"], " ", CurPh.Ma_nt)" Width="120" DisplayFormat="@M_IP_GIA_NT">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="@(AllowEditMode && CurPh.Px_gia_dd == 1)" Value="@_Ct85.Gia_nt" ValueExpression="@(() => _Ct85.Gia_nt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia_nt"); })" Id="Gia_nt"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Gia" Caption="@String.Concat(Lap["Price"], " ", M_ma_nt0.Trim())" Width="120" DisplayFormat="@M_IP_GIA">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="@(AllowEditMode && CurPh.Sua_tien == 1 && CurPh.Px_gia_dd == 1)" Value="@_Ct85.Gia" ValueExpression="@(() => _Ct85.Gia)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Gia"); })" Id="Gia"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Tien_nt" Caption="@String.Concat(Lap["Amount"], " ", CurPh.Ma_nt)" Width="140" DisplayFormat="@M_IP_TIEN_NT">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="@(AllowEditMode && CurPh.Sua_tien == 1 && CurPh.Px_gia_dd == 1)" Value="@_Ct85.Tien_nt" ValueExpression="@(() => _Ct85.Tien_nt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien_nt"); })" Id="Tien_nt"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn Visible="@NotMaNt0Voucher" FieldName="Tien" Caption="@String.Concat(Lap["Amount"], " ", M_ma_nt0.Trim())" Width="140" DisplayFormat="@M_IP_TIEN">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="@(AllowEditMode && CurPh.Sua_tien == 1 && CurPh.Px_gia_dd == 1)" Value="@_Ct85.Tien" ValueExpression="@(() => _Ct85.Tien)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Tien"); })" Id="Tien"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Tk_vt" Caption="@Lap["Debit account"].ToString()" Width="120">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@_Ct85.Tk_vt" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Tk_vt"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Ma_nx_i" Caption="@Lap["Credit account"]" Width="120">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct85 = (Ct85)GrdContext.EditModel;
                                                            }
                                                            <div id="@($"Ma_nx_i{_Ct85.Stt_rec0}")" class="autocomplete-cell-wrapper m-0 p-0">
                                                                <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@_Ct85.Ma_nx_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_nx_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                            </div>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    @foreach (FreeCodeInfo row in LsFreeCodeInfo)
                                                    {
                                                        @if (row.Loai_dmctct == 1)
                                                        {
                                                            <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth">
                                                                <CellEditTemplate Context="GrdContext">
                                                                    @{
                                                                        var _Ct85 = (Ct85)GrdContext.EditModel;
                                                                    }
                                                                    <SisLib.Ctrl.FreeCodeDm Target="_Ct85" Ma_dm="@row.Ma_dm" FieldName="@row.Field_ct" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, row.Field_ct); })"
                                                                                            IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></SisLib.Ctrl.FreeCodeDm>
                                                                </CellEditTemplate>
                                                            </DxGridDataColumn>
                                                        }
                                                        else if (row.Loai_dmctct == 3)
                                                        {
                                                            <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth" DisplayFormat="@M_IP_SL">
                                                                <CellEditTemplate Context="GrdContext">
                                                                    @{
                                                                        var _Ct85 = (Ct85)GrdContext.EditModel;
                                                                    }
                                                                    <SisLib.Ctrl.FreeCodeSl Target="_Ct85" FieldName="@row.Field_ct" IsEnable="@AllowEditMode" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, row.Field_ct); })"></SisLib.Ctrl.FreeCodeSl>
                                                                </CellEditTemplate>
                                                            </DxGridDataColumn>
                                                        }
                                                        else
                                                        {
                                                            <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth">
                                                                <CellEditTemplate Context="GrdContext">
                                                                    @{
                                                                        var _Ct85 = (Ct85)GrdContext.EditModel;
                                                                    }
                                                                    <SisLib.Ctrl.FreeCodeText Target="_Ct85" FieldName="@row.Field_ct"></SisLib.Ctrl.FreeCodeText>
                                                                </CellEditTemplate>
                                                            </DxGridDataColumn>
                                                        }
                                                    }
                                                </Columns>
                                                <TotalSummary>
                                                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_SL" Name="So_luong" FieldName="So_luong" />
                                                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN" Name="Tien" FieldName="Tien" />
                                                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" ValueDisplayFormat="@M_IP_TIEN_NT" Name="Tien_nt" FieldName="Tien_nt" />
                                                </TotalSummary>
                                            </DxGrid>
                                        </div>
                                    </Template>
                                </DxFormLayoutItem>
                            </DxFormLayoutTabPage>
                        </DxFormLayoutTabPages>

                        <DxFormLayoutItem ColSpanMd="12">
                            <Template>
                                <div class="d-flex flex-nowrap align-items-center gap-3 mt-1 toolbar-check">
                                    <DxCheckBox CssClass="chk" Enabled="@AllowEditMode" Checked="@(CurPh.Sua_tien == 1)" CheckedChanged="@((bool newvalue) => ChkSua_tien_Click(newvalue))">@Lap["Edit money"]</DxCheckBox>
                                    <DxCheckBox CssClass="chk" Enabled="@AllowEditMode" Checked="@(CurPh.Px_gia_dd == 1)" CheckedChanged="@((bool newvalue) => ChkPx_gia_dd_Click(newvalue))">@Lap["Specific cost"]</DxCheckBox>
                                </div>
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutGroup Caption="@Lap["Total"]" ColSpanMd="12" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide">
                            <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Total quantity"]">
                                    <DxSpinEdit Id="t_so_luong" Enabled="false" CssClass="text-end" @bind-Value="@CurPh.T_so_luong" DisplayFormat="@M_IP_SL"></DxSpinEdit>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Total amount"]">
                                    <Template>
                                        <div class="d-flex align-items-center gap-3">
                                            <DxSpinEdit Id="t_tien_nt" Enabled="false" CssClass="col-4 text-end" @bind-Value="@CurPh.T_tien_nt" DisplayFormat="@M_IP_TIEN_NT"></DxSpinEdit>
                                            @if (NotMaNt0Voucher)
                                            {
                                                <DxSpinEdit Id="t_tien" Enabled="false" CssClass="col-4 ms-2 text-end" @bind-Value="@CurPh.T_tien" DisplayFormat="@M_IP_TIEN"></DxSpinEdit>
                                            }
                                        </div>
                                    </Template>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>
                        </DxFormLayoutGroup>

                        <DxFormLayoutItem ColSpanMd="12">
                            <Template>
                                <hr />
                            </Template>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </div>
            </div>
        </FormTrans>
    }
    else
    {
        <SisLib.Lib.ReportVcComponent LSItems="LSData" Menu_id="@Menu_id.Replace('_', '.')" M_so_lien="@curDmct.So_lien" Parent_url="@mPage" OnBack="@OnPrintBack"></SisLib.Lib.ReportVcComponent>
    }
</div>

<style>
    .frm-inctpxe-container {
        width: 100%;
        margin-left: auto;
        margin-right: auto;
        max-width: 1400px; /* desktop */
        padding-left: 8px;
        padding-right: 8px;
    }

    /* Tablet */
    <text > @@media (max-width: 1200px) {
        .frm-inctpxe-container

    {
        max-width: 1000px;
    }

    }

    </text >
    /* Mobile */
    <text > @@media (max-width: 768px) {
        .frm-inctpxe-container

    {
        max-width: 100%;
        padding-left: 4px;
        padding-right: 4px;
    }

    /* Gi?m padding tab content cho ?? tràn */
    .dxbl-fl .dxbl-fl-tab-content {
        padding: 3px !important;
    }

    .css-detail {
        height: 290px;
    }

    .grd-detail {
        height: 260px;
        padding: 0px;
        margin: 0px;
    }

    }

    </text >

    .disabled-grid {
        pointer-events: none;
        opacity: 0.7;
    }

    .css-header {
        height: auto;
    }

    .css-detail {
        height: 230px;
    }

    .grd-detail {
        height: 200px;
        padding: 0px;
        margin: 0px;
    }

    .css-detail .dxbl-formlayout-tabpage {
        height: 100% !important;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

        .css-detail .dxbl-formlayout-tabpage .dxbl-formlayout,
        .css-detail .dxbl-formlayout-tabpage .dxbl-formlayout-group {
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }

        .css-detail .dxbl-formlayout-tabpage #grid-wrapper,
        .css-detail .dxbl-formlayout-tabpage .dxbl-grid {
            flex: 1 1 auto;
            min-height: 0;
            overflow: auto;
        }

    .dxbl-fl .dxbl-fl-tab-content {
        padding: 3px 3px 3px 10px !important;
    }

    .dxbl-checkbox.dxbl-state-checked .dxbl-checkbox-check-element {
        background-color: #ccc !important;
        border-color: #ccc !important;
    }

    .text-end-custom ::deep input {
        text-align: right !important;
    }

    .toolbar-check {
        white-space: nowrap;
        overflow-x: auto;
        padding-bottom: 0px;
    }

        .toolbar-check .chk {
            margin-right: 10px;
        }
</style>

@code {
    #region Parameters & Variables
    Ph85 CurPh = new Ph85();
    List<Ct85> LSCt = new List<Ct85>();
    Ct85 CurrentEditModel;
    Ph85 LastPh = new Ph85();

    public DataTable TblDmkho { get; set; }
    private int activeTabIndex = 0;
    string _filter_qs = "";

    //string end_GridCt = "end_input_GridCt0";
    string filter_status = "ma_ct like '%PXE%' and status = 1";
    string M_QL_LO_CK = "0";
    bool isBlockingCT = false;
    private List<PXEModel> LSData;
    public string mPage { get; set; }
