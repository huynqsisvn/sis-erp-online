                            DisplayErrorData(table, "ma_bpht_i:H=Mã bpht", "Danh sách mã bpht không có trong danh mục bpht");
                        }
                        result = false;
                        break;

                    case "so_ct_khac_ngay":
                        if (IsLangEn)
