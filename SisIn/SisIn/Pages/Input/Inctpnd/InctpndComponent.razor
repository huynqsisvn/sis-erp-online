                        }
                        result = false;
                        break;

                    case "tk_thue_i":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "tk_thue_i:H=Tax account;ten_tk:H=Acct. name", "List of tax account is not in the list of accounts or the consolidated accounts");
