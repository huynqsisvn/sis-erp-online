@page "/Inctpnd"
@page "/Inctpnd/{Menu_id}"
@inherits TransBaseComponent
@attribute [Authorize(Roles = "admin,inctpnd")]

@if (ShowLoaddingVoucher)
{
    <DxLoadingPanel IndicatorAnimationType="WaitIndicatorAnimationType.Pulse"
                    CssClass="w-100"
                    IndicatorVisible="true"
                    IndicatorAreaVisible="true"
                    Visible="true"
                    Text="Processing..."
                    TextAlignment="LoadingPanelTextAlignment.Right">
        <div style="min-height: 250px;"></div>
    </DxLoadingPanel>
}
else if (TblPH != null)
{
    <div class="row m-0 p-0">
        <FrmBrowseComponent @ref="@oBrowsePH" TblData="@TblPH" Page_size="@pageSize" IsPageSize="@IsPageSize" CssClass="grid-frm-height" Fbrowse="@FbrowsePH" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
    <hr style="height:1px;background-color:dimgrey;margin:1px;padding:0px;">
    <div class="row my-1 mx-0 p-0">
        <h8 class="fw-bold bg-light text-warning rounded-pill mb-1"> @Lap["Detail"] </h8>
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblCT" CssClass="grid-frmct-height" Fbrowse="@FbrowseCT" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}

<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@popFilterVisible"
         Width="500px"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 5rem; height:5rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container pt-1">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From number"]">
                        <DxTextBox CssClass="col" @bind-Text="@So_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idTu_so" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To number"]">
                        <DxTextBox CssClass="col" @bind-Text="@So_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idDen_so" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Book code"]">
                        <Template>
                            <AutocompleteComponent CssClass="col p-0" Ma_dm="dmqs" @bind-Value="@Ma_qs" Filter="@_filter_qs" IsLangEn="@IsLangEn"></AutocompleteComponent>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Transaction code"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmmagd" @bind-Value="@Ma_gd" Filter="@_filter_gd" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Customer code"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmkh_thue" @bind-Value="@Ma_kh" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Account"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmtk1" @bind-Value="@Tk_i" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Site code"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmkho" @bind-Value="@Ma_kho" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Item code"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmvt" @bind-Value="@Ma_vt" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Status"]">
                        <AutocompleteComponent CssClass="col p-0" Ma_dm="dmpost" Filter="@filter_status" @bind-Value="@Status" IsLangEn="@IsLangEn"></AutocompleteComponent>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Dvcs code"]">
                        <DxTextBox CssClass="col" @bind-Text="@Ma_dvcs" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idMa_dvcs"></DxTextBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Filter by user"]">
                        <DxTextBox CssClass="col" @bind-Text="@NSD" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   InputId="idNSD" />
                    </DxFormLayoutItem>

                </DxFormLayout>
            </div>
        }

    </BodyTemplate>

    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col mx-4" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnFilterOK" />
                <DxButton CssClass="col " RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnFilterCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>
@if (IsShowFrm && FrmType != null)
{
    <DxPopup @bind-Visible="@IsShowFrm" CloseOnEscape="false" CloseOnOutsideClick="false"
             Width="70vw" MinWidth="700px" MinHeight="500px" Scrollable="true"
             MaxHeight="98vh"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportCT CurDmimex="@CurDmimex" Menu_id="@Menu_id" @bind-IsImportPopupVisible="@IsImportPopupVisible" OnImportCompleted="@ImportOK" ShowError="@ShowError_PND" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}
<style>
    .grid-frm-height {
        height: 55vh;
    }

    .grid-frmct-height {
        height: 30vh;
    }
</style>

@code {
    public string Ma_kh = "";
    public string Ma_qs = "";
    public string Ghi_no_co = "";
    public string Tk_i = "";
    public string Status = "";
    public string Ps_no = "";
    public string Ps_co = "";
    public string So_ct1 = "";
    public string So_ct2 = "";
    public string Ma_dvcs = "";
    public string NSD = "";
    public string Ma_kho = "";
    public string Ma_vt = "";
    public string Ma_gd = "";
    string _filter_gd = "";
    public string[] Procedures;
    string _filter_qs = "";
    string filter_status = "ma_ct like '%PND%' and status = 1 ";

    protected override void OnInitialized()
    {
        Menu_id = (String.IsNullOrEmpty(Menu_id) ? "wi.ct.01" : Menu_id);
        FrmType = typeof(Input.Inctpnd.FrmInctpnd);
        IsShowImport = true;
        LanguageID = "";
        _filter_qs = String.Format("ma_cts like '%{0}%'", "PND");
        _filter_gd = String.Format("ma_ct like '%{0}%' and [status] = 1", "PND");

        base.OnInitialized();
    }


    private async void BtnFilterOK()
    {
        ShowLoadding = true;

        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);
        string dvcs = myStateMN.GetMa_Dvcs();
        phFilter = "1=1";
        ctFilter = "1=1";

        if (!string.IsNullOrEmpty(Ma_dvcs))
        {
            phFilter = phFilter + " AND ma_dvcs LIKE ''" + Ma_dvcs.Trim() + "%''";
        }
        if (string.IsNullOrEmpty(Ma_dvcs))
        {
            if (dvcs != "ALL")
            {
                phFilter = phFilter + " AND ma_dvcs LIKE ''" + dvcs.Trim() + "%''";
            }
        }
        if (Ngay_ct1 != null)
        {
            phFilter = phFilter + " AND ngay_ct >= ''" + Ngay_ct1.ToString("yyyyMMdd") + "''";
        }
        if (Ngay_ct2 != null)
        {
            phFilter = phFilter + " AND ngay_ct <= ''" + Ngay_ct2.ToString("yyyyMMdd") + "''";
        }
        if (!String.IsNullOrEmpty(So_ct1))
        {
            phFilter = phFilter + " AND so_ct >= ''" + So_ct1.ToString() + "''";
        }
        if (!String.IsNullOrEmpty(So_ct2))
        {
            phFilter = phFilter + " AND so_ct <= ''" + So_ct2.ToString() + "''";
        }

        if (!String.IsNullOrEmpty(Ma_qs))
        {
            phFilter = phFilter + " AND ma_qs LIKE ''" + Ma_qs.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Status))
        {
            phFilter = phFilter + " AND status  LIKE ''" + Status.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Ma_gd))
        {
            phFilter = phFilter + " AND ma_gd  LIKE ''" + Ma_gd.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Tk_i))
        {
            ctFilter = ctFilter + " AND ma_nx_i  LIKE ''" + Tk_i.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(NSD) && NSD.Trim().Equals("1"))
        {
            phFilter = phFilter + " AND user_id  = " + curUser.User_id + " ";
        }
        if (!String.IsNullOrEmpty(Ma_kh))
        {
            phFilter = phFilter + " AND ma_kh LIKE ''" + Ma_kh.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Ma_kho))
        {
            ctFilter = ctFilter + " AND ma_kho_i LIKE ''" + Ma_kho.Trim() + "%''";
        }
        if (!String.IsNullOrEmpty(Ma_vt))
        {
            ctFilter = ctFilter + " AND ma_vt LIKE ''" + Ma_vt.Trim() + "%''";
        }
        await Loaddata(false);

        ShowLoadding = false;
        popFilterVisible = false;
        InvokeAsync(StateHasChanged);
    }
    public override async void V_In()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"]);
            return;
        }
        DataSet DataSource = CopyVoucherToDataSet(SqlTableKeyValue);
        DataTable ds = AddTbTkPs(DataSource.Tables[0].Rows[0]["stt_rec"].ToString());
        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<PNDModel>();
            PNDModel _curModel = new PNDModel();
            _curModel.LSPh = myDb.ConvertDataTable<Ph74>(DataSource.Tables[0]);
            _curModel.LSCt = myDb.ConvertDataTable<Ct74>(DataSource.Tables[1]);

            string tk_no = "";
            string tk_co = "";
            int i = 0;
            foreach (Ct74 ct in _curModel.LSCt)
            {
                if (!tk_no.Contains(ct.Ma_nx_i))
                    tk_no += ct.Ma_nx_i + "; ";
                if (!tk_co.Contains(ct.Tk_vt))
                    tk_co += ct.Tk_vt + "; ";
                _curModel.LSCt[i].Stt = i + 1;
                i++;

            }

            _curModel.Tk_co = tk_co;
            _curModel.Tk_no = tk_no;
            _curModel.TotalString = DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, false);
            _curModel.DateString = ToDateString(_curModel.LSPh[0].Ngay_ct);
            _curModel.Ten_lien = "Liên 1 : giao khách hàng";
            _curModel.So_lien = curDmct.So_lien;
            _curModel.TotalStringVi = DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, false, M_ma_nt0);
            _curModel.TotalStringEn = DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, true, M_ma_nt0);
            _curModel.TotalStringVi_nt = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, false, _curModel.LSPh[0].Ma_nt);
            _curModel.TotalStringEn_nt = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, true, _curModel.LSPh[0].Ma_nt);
            LSData.Add(_curModel);

        }
        ShowReport(LSData, typeof(PNDModel));

    }

    public DataTable AddTbTkPs(string sttrec)
    {
        string str = "ct41";

        string sql = string.Format("select tk_i as tk,MIN(stt_rec0) as stt_rec0, case when abs(sum(tien_tt))> 0 then sum(tien_tt) else sum(tien) end as tien, sum(tien_nt) as tien_nt from " + str + " where stt_rec='" + sttrec + "' group by tk_i order by stt_rec0");
        DataTable ds = myDb.LoadDataSet(sql).Tables[0].Copy();
        return ds;

    }
    public string ToDateString(DateTime date)
    {
        return $"ngày {date.Day} tháng {date.Month} năm {date.Year}";
    }
    private bool ShowError_PND(DataErrArgs Args)
    {
        DataSet dsError = Args.DataErr;
        bool result = true;
        foreach (DataTable table in dsError.Tables)
        {
            if (table.Rows.Count != 0)
            {
                switch (table.Columns[0].ColumnName)
                {
                    case "ma_kh":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh:H=Customer ID", "List the client code is not in the list of customers");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh:H=Mã khách hàng", "Danh sách mã khách hàng không có trong danh mục khách hàng");
                        }
                        result = false;
                        break;

                    case "ma_kh1":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh1:H=Customer ID;ma_dvcs:H=Unit code", "List the client code is invalid");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh1:H=Mã khách hàng;ma_dvcs:H=Mã ĐVCS", "Danh sách mã khách hàng không thuộc ĐVCS");
                        }
                        result = false;
                        break;

                    case "ma_kh_hddt":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh_hddt:H=Customer ID", "List the client code is not in the list of customers");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh_hddt:H=Mã khách hàng", "Danh sách mã khách hàng không có trong danh mục khách hàng hóa đơn điện tử");
                        }
                        result = false;
                        break;

                    case "ma_kh_hddt_tt":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_kh_hddt_tt:H=Customer ID", "Invoice customer status is invalid");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_kh_hddt_tt:H=Mã khách hàng", "Trạng thái khách hàng hóa đơn điện tử không hợp lệ");
                        }
                        result = false;
                        break;

                    case "sd_hddt_yn":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "sd_hddt_yn:H=Use electronic invoices", "Not declaring the use of electronic invoices");
                        }
                        else
                        {
                            DisplayErrorData(table, "sd_hddt_yn:H=Sử dụng hóa đơn điện tử", "Chưa khai báo sử dụng hóa đơn điện tử");
                        }
                        result = false;
                        break;

                    case "sd_hddt_yn_2":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "sd_hddt_yn_2:H=Use electronic invoices", "The declared value uses an invalid electronic invoice");
                        }
                        else
                        {
                            DisplayErrorData(table, "sd_hddt_yn_2:H=Sử dụng hóa đơn điện tử", "Giá trị khai báo sử dụng hóa đơn điện tử không hợp lệ");
                        }
                        result = false;
                        break;

                    case "ma_nx":
