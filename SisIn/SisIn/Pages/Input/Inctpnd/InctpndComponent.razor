                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_px_i:H=Workshop code", "List of workshops code is not in the list of workshops");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_px_i:H=Mã phân xưởng", "Danh sách mã phân xưởng không có trong danh mục phân xưởng");
                        }
                        result = false;
                        break;

                    case "ngay_ct_ks":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ngay_ct:H=Voucher date:D", "List of documents smaller day close day window");
                        }
                        else
                        {
                            DisplayErrorData(table, "ngay_ct:H=Ngày chứng từ:D", "Danh sách ngày chứng từ nhỏ hơn ngày khóa sổ");
                        }
                        result = false;
                        break;
                }
            }
        }
        return !result;
    }
}
