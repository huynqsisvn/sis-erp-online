                        else
                        {
                            DisplayErrorData(table, "tk_thue_i:H=Tk thuế;ten_tk:H=Tên tk", "Danh sách tài khoản thuế không có trong danh mục tài khoản hoặc là tài khoản tổng hợp");
                        }
                        result = false;
                        break;

                    case "ma_vv_i":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_vv_i:H=Project code", "List of project code is not in the list of projects");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_vv_i:H=Mã dự án", "Danh sách mã dự án không có trong danh mục dự án");
