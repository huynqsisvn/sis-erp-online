                        {
                            DisplayErrorData(table, "ma_nx:H=Debit account;ten_tk:H=Debit account name", "List of debit account is not in the list of accounts or the consolidated accounts");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_nx:H=Tk nợ;ten_tk:H=Tên tk nợ ", "Danh sách tk nợ không có trong danh mục tài khoản hoặc là tài khoản tổng hợp");
                        }
                        result = false;
                        break;

                    case "ma_thck":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_thck:H=Payment terms code", "List of payment terms code not in payment terms list");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_thck:H=Mã điều khoản thanh toán", "Danh sách mã điều khoản thanh toán không có trong danh mục điểu khoản thanh toán");
                        }
                        result = false;
                        break;

                    case "ma_qs":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_qs:H=Book no.", "Book list is not in the list or book vouchers of this book");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_qs:H=Quyển c.từ", "Danh sách quyển c.từ không có trong danh mục quyển c.từ hoặc chứng từ không thuộc quyển c.từ này");
                        }
                        result = false;
                        break;

                    case "so_ct":
                        if (IsLangEn)
                        {
