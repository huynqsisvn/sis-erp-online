                            DisplayErrorData(table, "tk_ck:H=Tk ck;ten_tk:H=Tên tk", "Danh sách tài khoản chiết khấu không có trong danh mục tài khoản hoặc là tài khoản tổng hợp");
                        }
                        result = false;
                        break;

                    case "ma_dvcs":
                        if (IsLangEn)
                        {
                            DisplayErrorData(table, "ma_dvcs:H=Unit code", "Unit code list is not in the list of unit code");
                        }
                        else
                        {
                            DisplayErrorData(table, "ma_dvcs:H=Mã ĐVCS", "Danh sách mã ĐVCS không có trong danh mục ĐVCS");
