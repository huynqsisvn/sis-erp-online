    private async Task TyGiaValueChanged(bool isMaNtChanged)
    {
        if (curActionTask == ActionTask.Delete || curActionTask == ActionTask.View)
            return;

        decimal tyGia = CurPh.Ty_gia;
        decimal suaTien = CurPh.Sua_tien;

        if (tyGia == 0 || (suaTien != 0 && !isMaNtChanged))
            return;


        UpdateTotal("gia", "gia_nt", true);
        UpdateTotal("tien", "tien_nt", false);


        CurPh.T_tien = LSCt.Sum(a => a.Tien);

        await InvokeAsync(StateHasChanged);
    }

    private void UpdateTotal(string column, string columnNt, bool isPrice)
    {
        decimal tyGia = CurPh.Ty_gia;
        bool isLocalCurrency = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

        foreach (var ct in LSCt)
        {

            decimal gia_nt = ct.Gia_nt;
            decimal tien_nt = ct.Tien_nt;


            if (isLocalCurrency)
            {

                ct.Gia = gia_nt;
                ct.Tien = tien_nt;
            }
            else
            {

                decimal gia = Math.Round(gia_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                decimal tien = Math.Round(tien_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                if (gia != 0) ct.Gia = gia;
                if (tien != 0) ct.Tien = tien;
            }
        }
    }




