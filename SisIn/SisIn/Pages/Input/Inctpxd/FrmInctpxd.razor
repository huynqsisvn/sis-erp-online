    private void CanBangTien()
    {
        if (CurPh == null || LSCt == null || !LSCt.Any())
            return;

        decimal tTienNt = CurPh.T_tien_nt;   // Tổng tiền ngoại tệ trên header
        decimal tyGia = CurPh.Ty_gia;     // Tỷ giá hiện tại
        decimal tongTienChiTiet = LSCt.Sum(x => x.Tien); // Tổng tiền VND hiện tại của các dòng chi tiết

        // Tính lại tổng tiền VND lý thuyết từ header (t_tien_nt * ty_gia)
        decimal tTienVndLyThuyet = Math.Round(tTienNt * tyGia, M_ROUND);

        // Tính chênh lệch do làm tròn
        decimal chenhLech = tTienVndLyThuyet - tongTienChiTiet;

        // Nếu không có chênh lệch → không cần làm gì
        if (chenhLech == 0m)
            return;

        // Tìm dòng chi tiết có tiền_nt lớn nhất và chưa bị khóa cân bằng (thường là dòng đầu tiên có tiền)
        var dongCanBang = LSCt
            .Where(x => (x.Tien_nt) != 0)
            .OrderByDescending(x => x.Tien_nt)
            .FirstOrDefault();

        if (dongCanBang != null)
        {
            // Cộng/giảm phần chênh lệch vào dòng này
            dongCanBang.Tien = (dongCanBang.Tien) + chenhLech;

            // Cập nhật lại tổng trên header cho chính xác tuyệt đối
            CurPh.T_tien = tTienVndLyThuyet;
        }
        else
        {
            // Trường hợp cực hiếm: không có dòng nào có tiền_nt → gán thẳng vào header
            CurPh.T_tien = tTienVndLyThuyet;
        }

        // Gọi StateHasChanged nếu cần cập nhật UI ngay
        // StateHasChanged();
    }

    private async Task Save()
    {
        if (!SisData.Lib.CheckValidNgayKs(mySysvar, myDb, CurPh.Ngay_ct, Ma_ct))
        {
            myStateMN.SetNewThongbao(Lap["Data is locked, cannot be edited!"]);
            return;
        }

        if (!await CheckValid())
            return;

        await GridCT.SaveChangesAsync();

        if (LSCt.Count <= 0)
        {
            Message = Lap["No details entered"] + " !";
            return;
        }
        PreSum_All();
        ParentReload = true;
        CurPh.Date = DateTime.Now.Date;
        CurPh.Time = DateTime.Now.TimeOfDay;
        if (curUser != null)
            CurPh.User_id = curUser.User_id.ToString();
        CurPh.Ma_dvcs = myStateMN.GetMa_Dvcs();
        if (String.IsNullOrEmpty(CurPh.Ma_dvcs) || CurPh.Ma_dvcs.Trim().ToUpper() == "ALL")
        {
            CurPh.Ma_dvcs = myDb.GetValue("dmkho", "ma_dvcs", "ma_kho = '" + LSCt[0].Ma_kho_i.Trim() + "'").ToString();
        }

        CanBangTien();

        foreach (Ct84 ct in LSCt)
        {
            ct.Ngay_ct = CurPh.Ngay_ct;
            ct.Ma_ct = CurPh.Ma_ct;
            ct.So_ct = CurPh.So_ct;
            if (ct.He_so1 != new decimal(0))
            {
                ct.So_luong1 = Converts.Round(ct.So_luong * ct.He_so1, M_IP_SL);
            }
        }

        if (curActionTask == ActionTask.New)
        {
            CurPh.Date0 = DateTime.Now.Date;
            CurPh.Time0 = DateTime.Now.TimeOfDay;

            if (curUser != null)
            {
                CurPh.User_id0 = curUser.User_id.ToString();
            }
            myDb.UpdateDataRowFromModel<Ph84>(DsTrans.Tables[0].Rows[0], CurPh);
            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

            if (LSCt.Count > 0)
            {
                int _count = 0;
                foreach (Ct84 _ct84 in LSCt)
                {
                    _count++;
                    DataRow _row = DsTrans.Tables[1].NewRow();
                    _row["Column1"] = _count.ToString();
                    myDb.UpdateDataRowFromModel<Ct84>(_row, _ct84);
                    DsTrans.Tables[1].Rows.Add(_row);
                }
                await myDb.InsertManyRow<Ct84>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec);
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            myDb.UpdateDataRowFromModel<Ph84>(DsTrans.Tables[0].Rows[0], CurPh);
            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

            string _saveXml = myOption.GetOptionsValue("M_SAVE_XML");
            if (LSCt.Count > 0)
            {
                int _count = 0;
                foreach (Ct84 _ct84 in LSCt)
                {
                    DataRow _row = DsTrans.Tables[1].Select("stt_rec='" + CurPh.Stt_rec + "'").FirstOrDefault();
                    if (string.IsNullOrEmpty(_row["Column1"].ToString()))
                    {
                        _count++;
                        _row["Column1"] = _count.ToString();
                    }
                    myDb.UpdateDataRowFromModel<Ct84>(_row, _ct84);
                }
                xmlpath = Path.Combine(myWebhost.WebRootPath, "upload_tmp", CurPh.Stt_rec);
                await myDb.SaveDataTable<Ct84>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec, "", xmlpath, _saveXml);
            }
        }
        SaveLastPh(CurPh);
        dsCheckData = CheckData(curActionTask == ActionTask.Edit ? 0 : 1);
        bool validationFailed = false;
        if (this.dsCheckData.Tables.Count > 0)
        {
            validationFailed = false;

            foreach (DataRowView dataRowView in this.dsCheckData.Tables[0].DefaultView)
            {

                switch (dataRowView[0].ToString())
                {
                    case "PH01":
                        var obj = myDb.GetValue("Select chkso_ct from dmqs where ma_qs = '" + CurPh.Ma_qs.Trim() + "'");
                        M_trung_so = obj?.ToString().Trim() ?? "0";

                        if (M_trung_so.Equals("1"))
                        {
                            string _message = string.Format(Lap["Có chứng từ trùng số. Số cuối cùng là: [{0}]. Có lưu chứng từ này không?"],
                                this.GetLastSoct(this.CurPh.Ma_qs).Trim());

                            var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
                            {
                                Text = _message,
                                Title = Lap["Xác nhận nhập liệu"],
                                OkButtonText = Lap["Có"],
                                CancelButtonText = Lap["Không"],
                                ShowIcon = true,
                                RenderStyle = MessageBoxRenderStyle.Warning
                            });

                            if (!confirm)
                            {
                                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('so_ct_input')?.focus()");
                                validationFailed = true;
                                break;

                            }
                        }
                        else if (M_trung_so.Equals("2"))
                        {
                            var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
                            {
                                Text = Lap["The voucher number already exists"] + " !",
                                Title = Lap["Notification"],
                                OkButtonText = Lap["Yes"],
                                ShowIcon = true,
                                RenderStyle = MessageBoxRenderStyle.Danger
                            });
                            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('so_ct_input').focus()");
                            validationFailed = true;
                            break;

                        }
                        break;


                    // Các lỗi chi tiết (CTxx) - focus vào ô grid theo Stt_rec0
                    case "CT01":
                    case "CT02":

                        {
                            int rowIndex = Convert.ToInt16(dataRowView[1]);
                            string message = dataRowView[0].ToString() switch
                            {
                                "CT01" => Lap["Tk nợ là tk tổng hợp, không lưu được!"],
                                "CT02" => Lap["Tk có là tk tổng hợp, không lưu được!"],

                                _ => "Tài khoản tổng hợp không lưu được!"
                            };

                            myStateMN.SetNewThongbao(message);

                            if (rowIndex >= 0 && rowIndex < LSCt.Count)
                            {
                                string sttRec0 = LSCt[rowIndex].Stt_rec0;
                                string field = dataRowView[0].ToString() switch
                                {
                                    "CT01" => "Tk_vt_",
                                    "CT02" => "Ma_nx_i_",     // tk kho

                                    _ => "Tk_vt_"
                                };

                                string js = $"var el = document.getElementById('{field}{sttRec0}'); " +
                                            $"if(el){{ var input = el.querySelector('input'); if(input) input.focus(); }}";

                                await JavacriptS.InvokeVoidAsync("eval", js);
                            }
                            validationFailed = true;
                        }
                        break;

                    // CT03: chỉ cập nhật tồn kho, không lỗi (giữ nguyên logic cũ nếu cần)
                    case "CT03":
                        {
                            int rowIndex = Convert.ToInt16(dataRowView[1]);
                            // Logic tính tồn kho nếu bạn vẫn muốn giữ
                            // (ở WinForms có đoạn tính ton13, bạn có thể thêm lại nếu cần)
                        }
                        break;
                }
            }

        }

        if (validationFailed)
        {
            IsSaved = false;
            return;
        }
        else
        {
            IsSaved = true;
        }
        if ((CurPh.Status.Equals("2") || CurPh.Status.Equals("1")) && !validationFailed && (curActionTask == ActionTask.New || curActionTask == ActionTask.Edit))
        {
            Post();
            UpdateTonKho();
        }
        
    }
    /// <summary>
    /// Cập nhật tồn kho thực tế (ton13) cho các dòng chi tiết có bật vt_ton_kho = 1
    /// Tương đương hoàn toàn hàm UpdateTonKho() cũ trong Winform
    /// </summary>
    private async Task UpdateTonKho()
    {
        if (LSCt == null || !LSCt.Any()) return;

        // Lấy danh sách các dòng cần cập nhật tồn kho
        var cacDongCanTon = LSCt
            .Where(x => x.Vt_ton_kho == 1 && !string.IsNullOrEmpty(x.Ma_kho_i) && !string.IsNullOrEmpty(x.Ma_vt))
            .ToList();

        if (!cacDongCanTon.Any())
        {
            // Nếu không có dòng nào cần tồn → đặt tất cả ton13 = null
            foreach (var ct in LSCt) ct.Ton13 = 0m;
            return;
        }

        // Tạo danh sách tham số để gọi stored procedure một lần (tối ưu nhất)
        var listParams = cacDongCanTon.Select(ct => new
        {
            ct.Ma_kho_i,
            ct.Ma_vt,
            Ma_vv_i = ct.Ma_vv_i ?? "",
            Ma_lo = ct.Ma_lo ?? ""
        }).Distinct().ToList();

        DataTable dtTonKho;

        if (M_QL_LO_CK == "1")
        {
            // Quản lý theo lô → gọi hàm lấy tồn có lô
            dtTonKho = GetListTon13Lo(

                string.Join(";", listParams.Select(p => p.Ma_kho_i)),
                string.Join(";", listParams.Select(p => p.Ma_vt)),
                string.Join(";", listParams.Select(p => p.Ma_vv_i)),
                string.Join(";", listParams.Select(p => p.Ma_lo))
            );
        }
        else
        {
            // Không quản lý lô
            dtTonKho = GetListTon13(
                string.Join(";", listParams.Select(p => p.Ma_kho_i)),
                string.Join(";", listParams.Select(p => p.Ma_vt)),
                string.Join(";", listParams.Select(p => p.Ma_vv_i))
            );
        }

        // Xóa ton13 cũ của tất cả các dòng
        foreach (var ct in LSCt) ct.Ton13 = 0m;

        // Gán lại tồn kho từ kết quả trả về
        if (dtTonKho != null && dtTonKho.Rows.Count > 0)
        {
            foreach (DataRow row in dtTonKho.Rows)
            {
                string maKho = row["ma_kho"].ToString().Trim();
                string maVt = row["ma_vt"].ToString().Trim();
                string maVv = row["ma_vv"]?.ToString().Trim() ?? "";
                string maLo = M_QL_LO_CK == "1" ? row["ma_lo"]?.ToString().Trim() ?? "" : "";

                decimal ton13 = Convert.ToDecimal(row["ton13"]);

                // Tìm tất cả các dòng chi tiết khớp điều kiện → gán tồn
                var dongKhop = cacDongCanTon
                    .Where(ct =>
                        ct.Ma_kho_i.Trim() == maKho &&
                        ct.Ma_vt.Trim() == maVt &&
                        (ct.Ma_vv_i ?? "").Trim() == maVv &&
                        (M_QL_LO_CK != "1" || (ct.Ma_lo ?? "").Trim() == maLo)
                    );

                foreach (var ct in dongKhop)
                {
                    ct.Ton13 = ton13;
                }
            }
        }

        // Cập nhật giao diện
        await InvokeAsync(StateHasChanged);
    }


    private void Post()
    {
        string _poststore = (Post_store == null || Post_store.Length <= 2) ? "[INCTPXD-Post]" : Post_store[2];
        string format = string.Format("exec [dbo].{0} '{1}',0", _poststore, CurPh.Stt_rec);
        myDb.ExecuteSqlQueryAsync(format);
    }

    public DataSet CheckData(int mode)
    {
        string format = "exec [dbo].{0} @status,  @stt_rec;";
        string[] Check_Valid_Store = (curDmct == null ? "" : curDmct.Check_valid_store.Trim()).Split("|");
        string sqlcmd = (Check_Valid_Store == null || Check_Valid_Store.Length <= 8) ? string.Format(format, (object)"[INCTPXD-CheckData]") : string.Format(format, (object)Check_Valid_Store[8]);
        DataSet dsResult = myDb.LoadDataSet(sqlcmd, new Dictionary<string, object>
        {
            ["@status"] = CurPh.Status,

            ["@stt_rec"] = CurPh.Stt_rec
        });
        return dsResult;
    }

    async Task<bool> CheckValid()
    {
        bool flag = true;

        // 1. Kiểm tra mã khách
        if (string.IsNullOrEmpty(CurPh.Ma_kh) && flag)
        {
            Message = Lap["Chưa vào Khách hàng!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_kh_input')?.focus()");
            IsSaved = false;

            flag = false;
        }



        if (CurPh.Ngay_ct == default && flag)
        {
            Message = Lap["Chưa vào ngày hạch toán!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_ct_input')?.focus()");
            IsSaved = false;

            flag = false;
        }


        // 4. Ngày lập chứng từ (nếu bật)
        if (flag && M_ngay_lct == "1")
        {
            if (CurPh.Ngay_lct == default)
            {
                Message = Lap["Chưa vào ngày lập px!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_lct_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
        }

        // 5. Quyển chứng từ
        if (string.IsNullOrEmpty(CurPh.Ma_qs) && flag)
        {
            Message = Lap["Chưa vào quyển chứng từ!"];
            myStateMN.SetNewThongbao(Message);
            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ngay_lct_input')?.focus()");
            IsSaved = false;

            flag = false;
        }

        // 6. Phải có ít nhất 1 dòng chi tiết
        if (LSCt.Count == 0 && flag)
        {
            Message = Lap["Chưa vào chi tiết vật tư, không lưu được!"];
            IsSaved = false;

            myStateMN.SetNewThongbao(Message);
            flag = false;
        }

        // 7. Duyệt từng dòng chi tiết kiểm tra bắt buộc
        for (int i = 0; i < LSCt.Count && flag; i++)
        {
            var row = LSCt[i];

            if (string.IsNullOrEmpty(row.Ma_vt))
            {

                Message = Lap["Chưa nhập mã vật tư!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_vt_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
            else if (string.IsNullOrEmpty(row.Ma_kho_i))
            {

                Message = Lap["Chưa nhập mã kho!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_kho_i_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
            else if (string.IsNullOrWhiteSpace(row.Tk_vt))
            {

                Message = Lap["Chưa vào tk nợ!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('tk_vt_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
            else if (string.IsNullOrWhiteSpace(row.Ma_nx_i))
            {

                Message = Lap["Chưa vào tk có!"];
                myStateMN.SetNewThongbao(Message);
                await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_nx_i_input')?.focus()");
                IsSaved = false;

                flag = false;
            }
            // else if (row.So_luong == 0 && CurPh.Ma_gd == "4" && row.Loai_vt == "51")
            // {
            //     Message = Lap["Chưa có số lượng nhập kho!"];
            //     myStateMN.SetNewThongbao(Message);
            //     await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('so_luong_input')?.focus()");
            //     IsSaved = false;
            //     flag = false;
            // }

        }



        return flag;
    }
    private async void OnPrint()
    {
        DataSet DataSource = CopyVoucherToDataSet(Stt_rec);
        string tk_no = "";
        string tk_co = "";
        int i = 0;
        foreach (Ct84 ct in LSCt)
        {
            if (!tk_no.Contains(ct.Ma_nx_i))
                tk_no += ct.Ma_nx_i + "; ";
            if (!tk_co.Contains(ct.Tk_vt))
                tk_co += ct.Tk_vt + "; ";
            LSCt[i].Stt = i + 1;
            i++;
        }


        if (DataSource != null && DataSource.Tables.Count > 0)
        {
            LSData = new List<PXEModel>();
            PXEModel _curModel = new PXEModel();
            _curModel.LSPh = myDb.ConvertDataTable<Ph84>(DataSource.Tables[0]);
            _curModel.LSCt = myDb.ConvertDataTable<Ct84>(DataSource.Tables[1]);
            _curModel.TotalString = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, false);
            _curModel.DateString = ToDateString(_curModel.LSPh[0].Ngay_ct);
            _curModel.Tk_co = tk_co;
            _curModel.Tk_no = tk_no;
            _curModel.Ten_lien = "Liên 1 : giao khách hàng";
            _curModel.So_lien = curDmct.So_lien;
            _curModel.TotalStringVi = DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, false, M_ma_nt0);
            _curModel.TotalStringEn = DocSo.Doc_so(_curModel.LSPh[0].T_tien, myOption, myDb, true, M_ma_nt0);
            _curModel.TotalStringVi_nt = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, false, _curModel.LSPh[0].Ma_nt);
            _curModel.TotalStringEn_nt = DocSo.Doc_so(_curModel.LSPh[0].T_tien_nt, myOption, myDb, true, _curModel.LSPh[0].Ma_nt);
            LSData.Add(_curModel);
        }
        IsShowVoucher = false;
        StateHasChanged();
    }



