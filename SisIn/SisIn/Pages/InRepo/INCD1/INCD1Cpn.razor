    string FormatSummaryText(GridCustomizeSummaryDisplayTextEventArgs e)
    {
        if (TblData == null || TblData.Rows.Count == 0)
            return "\u00A0";

        DataRow dataRow;

        if (CurItem is DataRowView drv)
            dataRow = drv.Row;
        else
            dataRow = TblData.Rows[0];

        decimal GetDec(string col)
        {
            return !string.IsNullOrEmpty(col)
                   && dataRow.Table.Columns.Contains(col)
                   && dataRow[col] != DBNull.Value
                ? Convert.ToDecimal(dataRow[col])
                : 0m;
        }
        string EMPTY = "\u00A0";

        switch (e.Item.Name)
        {
            case "ten_kh01": return Lap["Tồn đầu kỳ:"];
            case "ten_kh02": return Lap["Nhập trong kỳ:"];
            case "ten_kh03": return Lap["Xuất trong kỳ:"];
            case "ten_kh04": return Lap["Tồn cuối kỳ:"];

            case "sl_nhap01": return GetDec("ton_dau").ToString("N2");
            case "sl_nhap02": return GetDec("sl_nhap").ToString("N2");
            case "sl_nhap03": return EMPTY;            
            case "sl_nhap04": return GetDec("ton_cuoi").ToString("N2");


            case "sl_xuat03": return GetDec("sl_xuat").ToString("N2");


            case "tien_nt_n01": return string.Format(GetOptInt("M_IP_TIEN_NT"), GetDec("du_dau_nt"));
            case "tien_nt_n02": return string.Format(GetOptInt("M_IP_TIEN_NT"), GetDec("tien_nt_nhap"));
            case "tien_nt_n03": return EMPTY;              
            case "tien_nt_n04": return string.Format(GetOptInt("M_IP_TIEN_NT"), GetDec("du_cuoi_nt"));

            case "tien_nt_x03": return string.Format(GetOptInt("M_IP_TIEN_NT"), GetDec("tien_nt_x"));

            case "tien_nhap01": return string.Format(GetOptInt("M_IP_TIEN"), GetDec("du_dau"));
            case "tien_nhap02": return string.Format(GetOptInt("M_IP_TIEN"), GetDec("tien_nhap"));
            case "tien_nhap03": return EMPTY;            
            case "tien_nhap04": return string.Format(GetOptInt("M_IP_TIEN"), GetDec("du_cuoi"));

            case "tien_xuat03": return string.Format(GetOptInt("M_IP_TIEN"), GetDec("tien_xuat"));
        }

        return EMPTY;
    }


