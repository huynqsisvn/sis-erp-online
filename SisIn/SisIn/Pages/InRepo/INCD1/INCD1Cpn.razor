    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(Tu_ngay);
        myStateMN.SetEndDate(Den_ngay);
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;
        if (Tu_ngay == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Den_ngay == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Tu_ngay > Den_ngay)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        StateHasChanged();
        return ok;
    }
    async Task Loaddata()
    {
        try
        {
            if (curCommand != null)
            {
                sFieldArrays = !(IsLangEn == false)
                    ? (Mau_bc != 0 ? curCommand.Ebrowse2.ToString().Split("|") : curCommand.Ebrowse1.Split("|"))
                    : (Mau_bc != 0 ? curCommand.Vbrowse2.ToString().Split("|") : curCommand.Vbrowse1.Split("|"));

                Fbrowse = sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
            }

            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = MaDVCS == "ALL" ? "%" : MaDVCS;

            string MaKho = string.IsNullOrEmpty(Ma_kho) ? "%" : Ma_kho;
            string MaVT = string.IsNullOrEmpty(Ma_vt) ? "%" : Ma_vt;
            string TinhDC = Tinh_dc;   
            string VtTonKho = Vttonkho; 
            string Condition =
                $"1=1 AND ma_kho LIKE '{MaKho}' " +
                $"AND ma_vt LIKE '{MaVT}' " +
                $"AND ma_dvcs LIKE '{MaDVCS}'";


            string ConditionSD =
                $"1=1 AND ma_kho LIKE '{MaKho}' " +
                $"AND ma_vt LIKE '{MaVT}' " +
                $"AND ma_kho IN (SELECT ma_kho FROM dmkho WHERE ma_dvcs LIKE '{MaDVCS}')";

            string param_name =
                "StartDate;EndDate;Tinh_dc;Condition;vttonkho;ConditionSD";

            string param_value =
                $"{Tu_ngay:yyyyMMdd};" +
                $"{Den_ngay:yyyyMMdd};" +
                $"{TinhDC};" +
                $"{Condition};" +
                $"{VtTonKho};" +
                $"{ConditionSD}";

            string store = curCommand.Store_proc?.Split('|')[0] ?? "INCD1";

            var ds = await myDb.LoadStoreProcedure(store, param_name, param_value);

            dsGlcd = new DataSet();

            if (ds != null && ds.Tables.Count > 0)
            {
                var t1 = ds.Tables[0].Copy();
                t1.TableName = "INCD1_Main";
                dsGlcd.Tables.Add(t1);
                TblData = t1;
            }
            else
            {
                TblData = new DataTable();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }



    async void OnDvcsChanged(string ma_dvcs)
    {
        Ma_dvcs = (ma_dvcs == "ALL" ? "" : ma_dvcs);
        await Loaddata();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            Ma_dvcs = myStateMN.GetMa_Dvcs(); Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
            await PageLoad();
            await LoadTemplate();
            await Language();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.AddOrderToolBarButton("Button1", Lap["Detail"] + "-F5", 1);
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync(IsDetail ? "oBrowseCT" : "oBrowse");
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            await Loaddata();
            StateHasChanged();
        }
        else
        {
            if (IsDetail)
            {
                await oBrowseCT.FocusGridAsync();
            }
            else
            {
                await oBrowse.FocusGridAsync();
            }
        }
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }


    

    private async Task oBrowse_F5()
    {
        try
        {
            DataRowView selectedObj = !IsDetailSum ? CurItem as DataRowView : CurItemCT as DataRowView;
            if (selectedObj == null)
            {
                myStateMN.SetNewThongbao(Lap["Please select a row to view detail"] + " !");
                return;
            }
            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
            string store_detail = curCommand.Store_proc?.Split('|')[1] ?? "";
            DataSet dsDetail = null;
            string TinhDC = Tinh_dc;
            string MaVt = "";
            MaVt = selectedObj["ma_vt"].ToString().Trim();
            string Condition =
                $"ma_vt LIKE '{MaVt}' " +
                $"AND ma_dvcs LIKE '{MaDVCS}'";
            string param_name = "StartDate;EndDate;Tinh_dc;Condition";
            string param_value = $"{Tu_ngay:yyyyMMdd};{Den_ngay:yyyyMMdd};{TinhDC};{Condition}";
            dsDetail = await myDb.LoadStoreProcedure(store_detail, param_name, param_value);
            TblDataCT = dsDetail != null && dsDetail.Tables.Count > 0 ? dsDetail.Tables[0].Copy() : new DataTable();
            TblDataCT1 = dsDetail != null && dsDetail.Tables.Count > 0 ? dsDetail.Tables[1].Copy() : new DataTable();
            FbrowseCT = sFieldArrays.Length > 1 ? sFieldArrays[1] : "";

            IsDetail = true;
            IsDetailSum = !IsDetailSum ? false : true;
            IsDetailSumCT = !IsDetailSum ? false : true;

            StateHasChanged();
            if (oBrowseCT != null)
            {

                await Task.Delay(50);
                await oBrowseCT.FocusGridAsync();
            }

            ShowDetailToolBar();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            myStateMN.SetNewThongbao("Error loading detail: " + ex.Message);
        }
    }


    public override async void ExportData(int type)
    {
        if (IsDetail)
        {
            oBrowseCT.ExPortGrid(type);
        }
        else
        {
            oBrowse.ExPortGrid(type);
        }

        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }
    async Task LoadTemplate()
    {
        try
        {
            ReportTemplate.Clear();
            ReportTemplate.Add(new ReportStyle() { Label = Lap["No"], Value = -1, File_mau = "", Ma_maubc = "", Nh_bc = "", Tt_qd = "" });
            DataSet ds = await GetMauBC("INCD1");
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                int index = 0;
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ReportTemplate.Add(new ReportStyle() { Label = row["ten_maubc"].ToString(), Value = index, File_mau = row["file_maubc"].ToString().Trim(), Ma_maubc = row["ma_maubc"].ToString(), Nh_bc = row["nh_bc"].ToString().Trim(), Tt_qd = row["tt_qd"].ToString() });
                    index++;
                }
            }
            else
            {
                ReportTemplate.Add(new ReportStyle() { Label = "", Value = 0 });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    async Task<DataSet> GetMauBC(string ma_maubc)
    {
        string[] strArray = myOption.GetOptionsValue("M_MAU_TT_QD").ToString().Split(';');
        string str = "1=1";
        if (strArray.Length > 1)
            str = !(strArray[1].Trim() == "2") ? string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim()) : string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim());
        string cmdText = string.Format("SELECT file_maubc, ten_maubc, ten_maubc2, tt_qd, nh_bc, ma_maubc, [default] FROM {0} WHERE ma_maubc = '{1}' AND {2} ORDER BY [order]", (object)"dmmaubc", (object)ma_maubc, (object)str);
        DataSet ds = await myDb.LoadDataset(cmdText);
        return ds;
    }
    public string RemoveUnwantedColumns(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return input;

        // danh sách prefix cần loại bỏ
        string[] prefixes = new[]
        {
        "lk_", "ps_no1", "ps_co1", "no_dn", "co_dn", "ps_no_nt1", "ps_co_nt1"
    };

        // tách các nhóm cột theo ký tự '|'
        var groups = input.Split('|');

        for (int g = 0; g < groups.Length; g++)
        {
            var cols = groups[g].Split(';', StringSplitOptions.RemoveEmptyEntries);

            var filteredCols = cols.Where(col =>
            {
                var fieldName = col.Split(':')[0].Trim();
                return !prefixes.Any(p => fieldName.StartsWith(p, StringComparison.OrdinalIgnoreCase));
            });

            groups[g] = string.Join(";", filteredCols);
        }

        return string.Join("|", groups);
    }
    void oBrowse_CustomSummary(GridCustomSummaryEventArgs e)
    {
        switch (e.SummaryStage)
        {
            case GridCustomSummaryStage.Start:
                e.TotalValue = 0m;
                break;
            case GridCustomSummaryStage.Calculate:
                if (e.Grid.IsDataItemSelected(e.DataItem))
                    e.TotalValue = (decimal)e.TotalValue + (decimal)e.GetRowValue("ps_no");
                break;
        }
    }
    string GetOpt(string name) => myOption.GetOptionsValue(name) ?? "";
    string GetOptInt(string name)
    {
        string f = GetOpt(name).ToString();
        if (GetOpt("M_KIEU_SO_AM").ToString().Equals("2"))
            f = NormalizeOptionNegativeFormat(f);
        return "{0:" + f + "}";
    }
    string NormalizeOptionNegativeFormat(string s)
    {
        if (s == null) return s;
        var parts = s.Split(';');
        if (parts.Length > 1 && parts[1].StartsWith("-"))
        {
            parts[1] = "(" + parts[1].Substring(1).Trim() + ")";
            return string.Join(";", parts);
        }
        return s;
    }
    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("Bold") && row["Bold"].ToString().Trim() == "1")
        {
            return "bold-item";
        }
        return "";
    }
