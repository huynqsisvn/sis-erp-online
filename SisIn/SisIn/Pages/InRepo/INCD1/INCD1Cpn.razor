                break;
            case ActionTask.Button1:
                oBrowse_F5();
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
            case ActionTask.Quit:
                HideDetail();
                StateHasChanged();
                break;
        }
    }
