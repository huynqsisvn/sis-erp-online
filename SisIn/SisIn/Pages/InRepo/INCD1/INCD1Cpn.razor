    private async Task<string> LayTenKho(string Ma_kho)
    {
        if (string.IsNullOrEmpty(Ma_kho))
            return string.Empty;

        string sql = $@"
        SELECT ten_kho
        FROM dmkho
        WHERE ma_kho = '{Ma_kho}'
    ";

        var ds = await myDb.LoadDataset(sql);
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            return ds.Tables[0].Rows[0]["ten_kho"]?.ToString();
        }

        return string.Empty;
    }


    public override async void Print()
    {
        string tenKho = await LayTenKho(Ma_kho);

        LsData = new List<INCD1Model>();
        INCD1Model Data = new INCD1Model();

        Data.Startdate = (DateTime)Ngay_ct1;
        Data.Enddate = (DateTime)Ngay_ct2;
        Data.Ma_kho = Ma_kho;

        Data.Ten_kho = tenKho; // nếu model có field này

        Data.LsData = myDb.ConvertDataTable<ZCINSO1>(TblData);
        Data.LsDetail = myDb.ConvertDataTable<INCD1Detail>(TblDataCT);
        Data.LsDetail1 = myDb.ConvertDataTable<INCD1Detail1>(TblDataCT1);

        LsData.Add(Data);

        ShowReport(LsData, typeof(INCD1Model));
    }


