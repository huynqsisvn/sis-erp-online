    async Task LoadTemplate()
    {
        try
        {
            ReportTemplate.Clear();
            ReportTemplate.Add(new ReportStyle() { Label = Lap["No"], Value = -1, File_mau = "", Ma_maubc = "", Nh_bc = "", Tt_qd = "" });
            DataSet ds = await GetMauBC("INSO1");
            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                int index = 0;
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ReportTemplate.Add(new ReportStyle() { Label = row["ten_maubc"].ToString(), Value = index, File_mau = row["file_maubc"].ToString().Trim(), Ma_maubc = row["ma_maubc"].ToString(), Nh_bc = row["nh_bc"].ToString().Trim(), Tt_qd = row["tt_qd"].ToString() });
                    index++;
                }
            }
            else
            {
                ReportTemplate.Add(new ReportStyle() { Label = "", Value = 0 });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    async Task<DataSet> GetMauBC(string ma_maubc)
    {
        string[] strArray = myOption.GetOptionsValue("M_MAU_TT_QD").ToString().Split(';');
        string str = "1=1";
        if (strArray.Length > 1)
            str = !(strArray[1].Trim() == "2") ? string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim()) : string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim());
        string cmdText = string.Format("SELECT file_maubc, ten_maubc, ten_maubc2, tt_qd, nh_bc, ma_maubc, [default] FROM {0} WHERE ma_maubc = '{1}' AND {2} ORDER BY [order]", (object)"dmmaubc", (object)ma_maubc, (object)str);
        DataSet ds = await myDb.LoadDataset(cmdText);
        return ds;
    }
    public string RemoveUnwantedColumns(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return input;

        // danh sách prefix cần loại bỏ
        string[] prefixes = new[]
        {
        "lk_", "ps_no1", "ps_co1", "no_dn", "co_dn", "ps_no_nt1", "ps_co_nt1"
    };

        // tách các nhóm cột theo ký tự '|'
        var groups = input.Split('|');

        for (int g = 0; g < groups.Length; g++)
        {
            var cols = groups[g].Split(';', StringSplitOptions.RemoveEmptyEntries);

            var filteredCols = cols.Where(col =>
            {
                var fieldName = col.Split(':')[0].Trim();
                return !prefixes.Any(p => fieldName.StartsWith(p, StringComparison.OrdinalIgnoreCase));
            });

            groups[g] = string.Join(";", filteredCols);
        }

        return string.Join("|", groups);
    }
    void oBrowse_CustomSummary(GridCustomSummaryEventArgs e)
    {
        switch (e.SummaryStage)
        {
            case GridCustomSummaryStage.Start:
                e.TotalValue = 0m;
                break;
            case GridCustomSummaryStage.Calculate:
                if (e.Grid.IsDataItemSelected(e.DataItem))
                    e.TotalValue = (decimal)e.TotalValue + (decimal)e.GetRowValue("ps_no");
                break;
        }
    }
    string GetOpt(string name) => myOption.GetOptionsValue(name) ?? "";
    string GetOptInt(string name)
    {
        string f = GetOpt(name).ToString();
        if (GetOpt("M_KIEU_SO_AM").ToString().Equals("2"))
            f = NormalizeOptionNegativeFormat(f);
        return "{0:" + f + "}";
    }
    string NormalizeOptionNegativeFormat(string s)
    {
        if (s == null) return s;
        var parts = s.Split(';');
        if (parts.Length > 1 && parts[1].StartsWith("-"))
        {
            parts[1] = "(" + parts[1].Substring(1).Trim() + ")";
            return string.Join(";", parts);
        }
        return s;
    }
    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("Bold") && row["Bold"].ToString().Trim() == "1")
        {
            return "bold-item";
        }
        return "";
    }
