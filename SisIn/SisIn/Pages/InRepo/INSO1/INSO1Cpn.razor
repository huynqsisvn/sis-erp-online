    string FormatSummaryText(GridCustomizeSummaryDisplayTextEventArgs e)
    {
        if (TblData == null || TblData.Rows.Count == 0)
            return null;

        if (TblDataCT == null || TblDataCT.Rows.Count == 0)
            return null;

        DataRow sodu = TblDataCT.Rows[0];

        decimal ToDec(object v)
            => v == null || v == DBNull.Value ? 0m : Convert.ToDecimal(v);

        decimal SumColumn(DataTable tbl, string col)
        {
            object val = tbl.Compute($"SUM({col})", "");
            return val != DBNull.Value ? Convert.ToDecimal(val) : 0m;
        }

        decimal tondk = ToDec(sodu["tondk"]);
        decimal tonck = ToDec(sodu["tonck"]);
        decimal dudk = ToDec(sodu["dudk"]);
        decimal duck = ToDec(sodu["duck"]);
        decimal du_ntdk = ToDec(sodu["du_ntdk"]);
        decimal du_ntck = ToDec(sodu["du_ntck"]);

        // 🔴 CỰC KỲ QUAN TRỌNG: giữ dòng summary
        string EMPTY = "\u00A0";

        switch (e.Item.Name)
        {
            case "ten_kh01": return Lap["Tồn đầu kỳ:"];
            case "ten_kh02": return Lap["Nhập trong kỳ:"];
            case "ten_kh03": return Lap["Xuất trong kỳ:"];
            case "ten_kh04": return Lap["Tồn cuối kỳ:"];


            case "sl_nhap01": return tondk >= 0 ? string.Format(GetOptInt("M_IP_SL"), tondk) : EMPTY;
            case "sl_xuat01": return tondk < 0 ? string.Format(GetOptInt("M_IP_SL"), -tondk) : EMPTY;

            case "sl_nhap02": return string.Format(GetOptInt("M_IP_SL"), SumColumn(TblData, "sl_nhap"));
            case "sl_xuat02": return EMPTY;

            case "sl_nhap03": return EMPTY;
            case "sl_xuat03": return string.Format(GetOptInt("M_IP_SL"), SumColumn(TblData, "sl_xuat"));

            case "sl_nhap04": return tonck >= 0 ? string.Format(GetOptInt("M_IP_SL"), tonck) : EMPTY;
            case "sl_xuat04": return tonck < 0 ? string.Format(GetOptInt("M_IP_SL"), -tonck) : EMPTY;



            case "tien_nhap01": return dudk >= 0 ? string.Format(GetOptInt("M_IP_TIEN"), dudk) : EMPTY;
            case "tien_xuat01": return dudk < 0 ? string.Format(GetOptInt("M_IP_TIEN"), -dudk) : EMPTY;

            case "tien_nhap02": return string.Format(GetOptInt("M_IP_TIEN"), SumColumn(TblData, "tien_nhap"));
            case "tien_xuat02": return EMPTY;

            case "tien_nhap03": return EMPTY;
            case "tien_xuat03": return string.Format(GetOptInt("M_IP_TIEN"), SumColumn(TblData, "tien_xuat"));

            case "tien_nhap04": return duck >= 0 ? string.Format(GetOptInt("M_IP_TIEN"), duck) : EMPTY;
            case "tien_xuat04": return duck < 0 ? string.Format(GetOptInt("M_IP_TIEN"), -duck) : EMPTY;


            case "tien_nt_n01": return du_ntdk >= 0 ? string.Format(GetOptInt("M_IP_TIEN_NT"), du_ntdk) : EMPTY;
            case "tien_nt_x01": return du_ntdk < 0 ? string.Format(GetOptInt("M_IP_TIEN_NT"), -du_ntdk) : EMPTY;

            case "tien_nt_n02": return string.Format(GetOptInt("M_IP_TIEN_NT"), SumColumn(TblData, "tien_nt_n"));
            case "tien_nt_x02": return EMPTY;

            case "tien_nt_n03": return EMPTY;
            case "tien_nt_x03": return string.Format(GetOptInt("M_IP_TIEN_NT"), SumColumn(TblData, "tien_nt_x"));

            case "tien_nt_n04": return du_ntck >= 0 ? string.Format(GetOptInt("M_IP_TIEN_NT"), du_ntck) : EMPTY;
            case "tien_nt_x04": return du_ntck < 0 ? string.Format(GetOptInt("M_IP_TIEN_NT"), -du_ntck) : EMPTY;

            default:
                return null;
        }
    }




