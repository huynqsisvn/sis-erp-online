            return false;
        }      

        ShowLoadding = true;
        string maVt = Ma_vt?.Trim();
        string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
        MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
        string Condition = "1=1";
        if (!string.IsNullOrWhiteSpace(maVt))
        {
            Condition += $" AND ma_vt LIKE '{maVt}'";
        }
        if (!string.IsNullOrWhiteSpace(Ma_kho))
        {
            Condition += $" AND ma_kho LIKE '{Ma_kho}'";
        }
        if(!string.IsNullOrWhiteSpace(MaDVCS))
        {
            Condition += $" AND ma_kho IN ( SELECT ma_kho FROM dmkho where ma_dvcs like  '{MaDVCS}%')";
        }
        string Ma_ct = "";

