    private async Task<string> LayTenKho(string Ma_kho)
    {
        if (string.IsNullOrEmpty(Ma_kho))
            return string.Empty;

        string sql = $@"
        SELECT ten_kho
        FROM dmkho
        WHERE ma_kho = '{Ma_kho}'
    ";

        var ds = await myDb.LoadDataset(sql);
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            return ds.Tables[0].Rows[0]["ten_kho"]?.ToString();
        }

        return string.Empty;
    }
    private async Task<(string TenVt, string Dvt, string Tk_vt)> LayTenVatTu(string Ma_vt)
    {
        if (string.IsNullOrEmpty(Ma_vt))
            return (string.Empty, string.Empty, string.Empty);

        string sql = $@"
        SELECT ten_vt, dvt, tk_vt
        FROM dmvt
        WHERE ma_vt = '{Ma_vt}'
    ";

        var ds = await myDb.LoadDataset(sql);
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            return (
                ds.Tables[0].Rows[0]["ten_vt"]?.ToString() ?? string.Empty,
                ds.Tables[0].Rows[0]["dvt"]?.ToString() ?? string.Empty,
                ds.Tables[0].Rows[0]["tk_vt"]?.ToString() ?? string.Empty
            );
        }

        return (string.Empty, string.Empty, string.Empty);
    }


    public override async void Print()
    {

        var (tenVt, dvt,tkVt) = await LayTenVatTu(Ma_vt);


        string tenKho = await LayTenKho(Ma_kho);

        var data = new INSO1Model
        {
            Startdate = (DateTime)Ngay_ct1,
            Enddate = (DateTime)Ngay_ct2,
            Ma_kho = Ma_kho,
            Ten_Kho = tenKho,
            NgayMs = Ngay_ms,
            To_so = ToSo,
            Ten_vt = tenVt,
            Dvt = dvt,
            Tk_vt=tkVt,

            LsData = myDb.ConvertDataTable<INSO1>(TblData),
            LsDetail = myDb.ConvertDataTable<INSO1Detail>(TblDataCT)
        };

        LsData = new List<INSO1Model> { data };

        ShowReport(LsData, typeof(INSO1Model));
    }

