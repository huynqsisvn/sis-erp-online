            "@StartDate;@EndDate;@Condition;@Ma_ct";

        string param_value =
            $"{Tu_ngay:yyyyMMdd};" +
            $"{Den_ngay:yyyyMMdd};" +
            $"{Condition};" +
            $"{Ma_ct}";

