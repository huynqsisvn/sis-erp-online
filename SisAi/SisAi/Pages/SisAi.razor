    private async Task<(bool IsValid, string Message, string TenTk)> ValidateDebitAccount(string tk)
    {
        try
        {
            var sqlExact = $"SELECT ma_nx, ten_nx FROM dmnx WHERE tk = '{tk}' AND loai_tk = 1";
            var dsExact = await myDb.LoadDataset(sqlExact);
            
            if (dsExact != null && dsExact.Tables[0].Rows.Count > 0)
            {
                var tenTk = dsExact.Tables[0].Rows[0]["ten_nx"].ToString();
                return (true, "", tenTk);
            }

            var sqlClosest = $@"
                SELECT TOP 1 ma_nx, ten_nx as ten_tk, tk
                FROM dmnx 
                WHERE '{tk}' LIKE tk + '%' 
                  AND loai_tk = 1 
                ORDER BY LEN(tk) DESC";
            
            var dsClosest = await myDb.LoadDataset(sqlClosest);
            
            if (dsClosest != null && dsClosest.Tables[0].Rows.Count > 0)
            {
                var tenTk = dsClosest.Tables[0].Rows[0]["ten_tk"].ToString();
                return (true, "", tenTk);
            }

            return (false, $"Tài khoản nợ '{tk}' không tồn tại trong danh mục tiền mặt/ngân hàng (dmnx). Vui lòng chọn tài khoản hợp lệ (VD: 1111, 1121).", "");
        }
        catch (Exception ex)
        {
            return (false, $"Lỗi kiểm tra tài khoản nợ: {ex.Message}", "");
        }
    }

    private async Task CreateVoucher(VoucherCreateData data)
    {
        try
        {
            var checkTkNo = await ValidateDebitAccount(data.TkNo);
            if (!checkTkNo.IsValid)
            {
                AddBot($"❌ {checkTkNo.Message}");
                return;
            }

            string sttRec = data.SttRec;
            if (string.IsNullOrEmpty(sttRec))
            {
                string wsId = myOption.GetOptionsValue("M_WS_ID") ?? "A";
                var sql = $"EXEC dbo.GetSttRec 'PT1', '{wsId}'";
                var ds = await myDb.LoadDataset(sql);
                
                if (ds == null || ds.Tables[0].Rows.Count == 0)
                {
                    AddBot("❌ Không thể tạo stt_rec. Vui lòng thử lại.");
                    return;
                }
                
                sttRec = ds.Tables[0].Rows[0][0].ToString();
            }
            
            string soCt = await GenerateSoCt(data.MaQs ?? "PT");
            string maDvcs = data.MaDvcs ?? "001";
            string maQs = data.MaQs ?? "PT";
            string dienGiai = data.DienGiai.Replace("'", "''");
            var updatePh = $"UPDATE ph41 SET ma_ct = 'PT1', ma_dvcs = '{maDvcs}', so_ct = '{soCt}', ma_qs = '{maQs}', " +
                          $"ma_gd = '2', ngay_ct = '{data.NgayCt:yyyyMMdd}', ngay_lct = '{data.NgayCt:yyyyMMdd}', " +
                          $"ma_kh = '{data.MaKh}', dien_giai = N'{dienGiai}', ma_nt = 'VND', ty_gia = 1, ty_giaf = 1, " +
                          $"t_tien = {data.SoTien}, t_tien_nt = {data.SoTien}, status = '2', " +
                          $"date = '{DateTime.Now:yyyyMMdd}', date0 = '{DateTime.Now:yyyyMMdd}', " +
                          $"time = '{DateTime.Now:HH:mm:ss}', time0 = '{DateTime.Now:HH:mm:ss}', " +
                          $"user_id = 1, user_id0 = 1, tk = '{data.TkNo}' WHERE stt_rec = '{sttRec}'";

            var insertCt = $"INSERT INTO ct41 (stt_rec, stt_rec0, ma_ct, so_ct, ngay_ct, tk_i, ma_kh_i, " +
                          $"dien_giaii, tien, tien_nt, tien_tt, ty_gia_ht2, ma_nt_i) VALUES " +
                          $"('{sttRec}', '0001', 'PT1', '{soCt}', '{data.NgayCt:yyyyMMdd}', '{data.TkCo}', " +
                          $"'{data.MaKh}', N'{dienGiai}', {data.SoTien}, {data.SoTien}, {data.SoTien}, 1, 'VND')";

            await myDb.ExecuteSqlQueryAsync(updatePh);
            await myDb.ExecuteSqlQueryAsync(insertCt);

            AddBot($"✅ **Đã tạo phiếu thu thành công!**\n\n• Số chứng từ: **{soCt}**\n• Khách hàng: {data.MaKh}\n• TK nợ: **{data.TkNo}** - {checkTkNo.TenTk}\n• Số tiền: {data.SoTien:N0} VND\n• Trạng thái: Đã ghi sổ\n\nBạn có thể vào màn hình Phiếu thu để xem chi tiết.");
            await Task.Delay(1000);
            Navigation.NavigateTo("/Cactpt1", forceLoad: false);
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi khi tạo phiếu thu: {ex.Message}");
        }
    }

    private async Task BulkCreateVouchers(List<VoucherCreateData> vouchers)
    {
        try
        {
            await myDb.ExecuteSqlQueryAsync("DELETE FROM ImexPT1");

            int userId = 1;
            string maDvcs = "001";
            string maQs = "PT";

            foreach (var data in vouchers)
            {
                var sql = $@"
                    INSERT INTO ImexPT1 (
                        ma_gd, ma_kh, so_ct, ngay_ct, dien_giai, tk, tk_i, 
                        tien_nt, ma_qs, ma_dvcs, ma_nt, ty_gia, ty_gia_ht,
                        ngay_lct, loai_ct, ma_ct, dien_giaii, ma_kh_i
                    ) VALUES (
                        '2', '{data.MaKh}', '{data.SoCt}', '{data.NgayCt:yyyyMMdd}', N'{data.DienGiai}', 
                        '{data.TkNo}', '{data.TkCo}', {data.SoTien}, '{maQs}', '{maDvcs}', 
                        'VND', 1, 1, '{data.NgayCt:yyyyMMdd}', '1', 'PT1', N'{data.DienGiai}', '{data.MaKh}'
                    )";
                await myDb.ExecuteSqlQueryAsync(sql);
            }

            var spParams = new Dictionary<string, object>
            {
                ["@User_id"] = userId,
                ["@Ma_qs"] = maQs,
                ["@Ma_dvcs"] = maDvcs,
                ["@Xu_ly"] = "0"
            };

            var result = await myDb.LoadDataset("EXEC SmImexPT1 @User_id, @Ma_qs, @Ma_dvcs, @Xu_ly", spParams);

            if (result != null && result.Tables.Count > 0)
            {
                var errorTable = result.Tables[0];
                if (errorTable.Rows.Count > 0)
                {
                    AddBot($"⚠️ Có lỗi khi tạo hàng loạt:\n{errorTable.Rows[0][0]}");
                    return;
                }

                if (result.Tables.Count > 1)
                {
                    var voucherTable = result.Tables[1];
                    foreach (DataRow row in voucherTable.Rows)
                    {
                        string sttRec = row["stt_rec"].ToString();
                        await myDb.ExecuteSqlQueryAsync($"EXEC [SmImexPT1];10 '{sttRec}'");
                    }

                    AddBot($"✅ **Đã tạo thành công {voucherTable.Rows.Count} phiếu thu!**\n\nBạn có thể vào màn hình Phiếu thu để xem danh sách.");
                }
            }
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi khi tạo hàng loạt: {ex.Message}");
        }
    }

    private async Task<string> GenerateSoCt(string maQs)
    {
        try
        {
            string autoSoct = myOption.GetOptionsValue("M_AUTO_SOCT") ?? "0";
            int mAutoSoct = int.Parse(autoSoct);
            
            string sql;
            if (mAutoSoct == 1)
            {
                sql = $"SELECT transform, so_ct + 1 as so_ct FROM dmqs WHERE ma_qs = '{maQs.Trim()}'";
            }
            else
            {
                sql = $"EXEC [GetNewSoct] '{maQs.Trim()}'";
            }
            
            var ds = await myDb.LoadDataset(sql);
            
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                var row = ds.Tables[0].Rows[0];
                if (row[1] != null && row[1] != DBNull.Value)
                {
                    string nextNo = row[1].ToString();
                    string transform = row[0].ToString();
                    return string.Format(transform, Convert.ToDouble(nextNo));
                }
            }
            
            return "0000001";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"GenerateSoCt error: {ex.Message}");
            return DateTime.Now.ToString("yyyyMMddHHmmss");
        }
    }

