@page "/sisai"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SisCa.Model
@using SisData
@using SisData.Data
@using System.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using SisAiModule.Services
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IDbManager myDb
@inject IOptionsManager myOption
@inject Statemanagerment myStateMN
@inject ProtectedSessionStorage SessionStorage
@inject AiChatService AiChat

<div class="ai-chat-container @(isMinimized ? "ai-chat-hidden" : "")">
<div class="ai-chat-header">
    <div class="ai-chat-title">
        @if (_aiMode)
        {
            <span class="ai-mode-badge">🤖 AI</span>
        }
        Trợ lý ERP - Phiếu thu
    </div>
    <div class="ai-chat-actions">
        <button class="ai-btn-icon ai-btn-toggle @(_aiMode ? "ai-btn-toggle-on" : "")" @onclick="ToggleAiMode"
                title="@(_aiMode ? "Đang dùng AI (nhấn để tắt)" : "Bật chế độ AI")">🤖</button>
        <button class="ai-btn-icon" @onclick="ToggleMinimize" title="Đóng">✕</button>
    </div>
</div>

    <div class="ai-chat-body" id="ai-chat-body">
        @foreach (var msg in messages)
        {
            <div class="ai-chat-message @(msg.Role == "user" ? "ai-chat-user" : "ai-chat-bot")">
                <div class="ai-chat-meta">
                    <span class="ai-chat-name">@msg.Name</span>
                    <span class="ai-chat-time">@msg.Time.ToLocalTime().ToString("HH:mm")</span>
                </div>
                <div class="ai-chat-text">@RenderText(msg.Text)</div>
                @if (msg.VoucherData != null && !msg.IsEditing)
                {
                    <div class="voucher-confirm-actions">
                        <button class="btn-edit-voucher" @onclick="@(() => EnableEditMode(msg))">✏️ Sửa thông tin</button>
                        <button class="btn-confirm-voucher" @onclick="@(async () => await CreateVoucher(msg.VoucherData))">✓ Xác nhận tạo</button>
                        <button class="btn-cancel-voucher" @onclick="@(async () => await CancelVoucher(msg.VoucherData))">✗ Hủy</button>
                    </div>
                }
                @if (msg.IsEditing && msg.VoucherData != null)
                {
                    <div class="voucher-edit-form">
                        <div class="form-group">
                            <label>Mã đơn vị:</label>
                            <input type="text" @bind="msg.VoucherData.MaDvcs" class="form-input" placeholder="VD: 001" />
                        </div>
                        <div class="form-group">
                            <label>Mã khách hàng:</label>
                            <input type="text" @bind="msg.VoucherData.MaKh" class="form-input" placeholder="VD: KH001" />
                        </div>
                        <div class="form-group">
                            <label>Người nộp tiền:</label>
                            <input type="text" @bind="msg.VoucherData.OngBa" class="form-input" placeholder="VD: Nguyễn Văn A" />
                        </div>
                        <div class="form-group">
                            <label>Số tiền:</label>
                            <input type="number" @bind="msg.VoucherData.SoTien" class="form-input" placeholder="VD: 1000000" />
                        </div>
                        <div class="form-group">
                            <label>TK nợ:</label>
                            <input type="text" @bind="msg.VoucherData.TkNo" class="form-input" placeholder="VD: 111" />
                        </div>
                        <div class="form-group">
                            <label>TK có:</label>
                            <input type="text" @bind="msg.VoucherData.TkCo" class="form-input" placeholder="VD: 131" />
                        </div>
                        <div class="form-group">
                            <label>Diễn giải:</label>
                            <input type="text" @bind="msg.VoucherData.DienGiai" class="form-input" placeholder="Nhập diễn giải" />
                        </div>
                        <div class="form-group">
                            <label>Quyển sổ:</label>
                            <input type="text" @bind="msg.VoucherData.MaQs" class="form-input" placeholder="VD: PT" />
                        </div>
                        <div class="voucher-confirm-actions">
                            <button class="btn-save-edit" @onclick="@(async () => await SaveEditedVoucher(msg))">💾 Lưu chỉnh sửa</button>
                            <button class="btn-cancel-voucher" @onclick="@(() => CancelEdit(msg))">✗ Hủy sửa</button>
                        </div>
                    </div>
                }
            </div>
        }
        @if (_isAiThinking)
        {
            <div class="ai-chat-message ai-chat-bot ai-thinking">
                <div class="ai-chat-meta">
                    <span class="ai-chat-name">Trợ lý ERP</span>
                </div>
                <div class="ai-thinking-dots"><span></span><span></span><span></span></div>
            </div>
        }
        <div id="ai-chat-bottom"></div>
    </div>

    @if (_wizard != null)
    {
        <div class="wizard-step-bar">
            <span class="wizard-step-label">🎙️ @_wizard.StepLabel</span>
            <button class="wizard-cancel-btn" @onclick="CancelWizard" title="Hủy">✕ Hủy</button>
        </div>
    }
    @if (_voiceMode)
    {
        <div class="voice-mode-bar">
            <span class="voice-mode-label">@(isListening ? "🔴 Đang nghe..." : "⏳ Đang xử lý...")</span>
            <button class="voice-mode-stop" @onclick="StopVoiceMode">⏹ Dừng</button>
        </div>
    }
    <div class="ai-pdf-dropzone @(_isDragging ? "pdf-drop-active" : "")" id="ai-pdf-dropzone"
         title="Kéo thả file PDF phiếu thu vào đây"
         @ondragenter="@(() => { _isDragging = true; StateHasChanged(); })"
         @ondragover:preventDefault
         @ondragleave="@(() => { _isDragging = false; StateHasChanged(); })">
        @if (_isPdfProcessing)
        {
            <span class="pdf-drop-label">⏳ Đang đọc PDF...</span>
        }
        else if (_isDragging)
        {
            <span class="pdf-drop-label">📥 Thả file PDF tại đây...</span>
        }
        else
        {
            <span class="pdf-drop-label">📄 Kéo thả file PDF hoặc <button class="pdf-pick-btn" @onclick="PickPdfFile">chọn file</button></span>
        }
    </div>
    <input type="file" id="ai-pdf-input" accept=".pdf" style="display:none" />
    <div class="ai-chat-input">
        <input class="ai-input" placeholder="@GetInputPlaceholder()" value="@userInput" @oninput="@(e => userInput = e.Value?.ToString())" @onkeydown="OnKeyDown" />
        <button class="ai-btn-mic @(isListening ? "ai-btn-mic-active" : (_voiceMode ? "ai-btn-mic-voice" : ""))" @onclick="ToggleVoiceInput"
                title="@_micTitle">
            @if (isListening)
            {
                <span class="mic-pulse">🔴</span>
            }            
            else
            {
                <span>🎤</span>
            }
        </button>
        <button class="ai-btn-send" @onclick="Send">Gửi</button>
    </div>
</div>

<style>
    .ai-chat-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 380px;
        max-width: 90vw;
        height: 650px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        display: flex;
        flex-direction: column;
        z-index: 9999;
        overflow: hidden;
    }
    .ai-chat-hidden { display: none; }

    .ai-chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 600;
    }

    .ai-chat-title { font-size: 0.95rem; }

    .ai-chat-actions { display: flex; gap: 6px; }

    .ai-btn-icon {
        border: none;
        background: rgba(255,255,255,0.2);
        color: #fff;
        width: 28px;
        height: 24px;
        border-radius: 6px;
        cursor: pointer;
    }

    .ai-chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
        background: #f5f6fb;
    }

    .ai-chat-message { margin-bottom: 10px; padding: 8px 10px; border-radius: 10px; }
    .ai-chat-user { background: #e8f0ff; margin-left: 30px; }
    .ai-chat-bot { background: #fff; margin-right: 30px; border: 1px solid #ececec; }
    .ai-chat-meta { font-size: 0.75rem; color: #666; display: flex; justify-content: space-between; margin-bottom: 4px; }
    .ai-chat-text { font-size: 0.9rem; color: #2b2b2b; }

    .ai-chat-input { display: flex; padding: 10px; gap: 8px; border-top: 1px solid #eee; align-items: center; }
    .ai-input { flex: 1; padding: 8px 10px; border-radius: 8px; border: 1px solid #dcdcdc; }
    .ai-btn-send { background: #667eea; color: #fff; border: none; border-radius: 8px; padding: 0 14px; cursor: pointer; height: 36px; }
    .ai-btn-send:hover { background: #5a6ed6; }

    .ai-btn-mic {
        background: #f0f0f0;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: background 0.2s;
    }
    .ai-btn-mic:hover { background: #e0e0e0; }
    .ai-btn-mic-active {
        background: #ffe5e5;
        border-color: #ff4444;
    }
    .ai-btn-mic-active:hover { background: #ffd0d0; }

    @@keyframes micPulse {
        0%   { opacity: 1; }
        50%  { opacity: 0.3; }
        100% { opacity: 1; }
    }
    .mic-pulse { animation: micPulse 1s infinite; }

    .ai-chat-quick { display: flex; gap: 8px; padding: 8px 10px; flex-wrap: wrap; background: #f8f9fc; border-top: 1px solid #eee; }
    .ai-btn { background: #edf0ff; border: 1px solid #dbe0ff; border-radius: 8px; padding: 6px 10px; cursor: pointer; font-size: 0.85rem; }
    .ai-btn:hover { background: #dbe0ff; }

    .ai-chat-fab {
        position: fixed;
        bottom: 18px;
        right: 18px;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 10px 24px rgba(0,0,0,0.2);
        cursor: pointer;
        z-index: 9999;
    }

    .voucher-confirm-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #eee;
    }

    .btn-confirm-voucher, .btn-cancel-voucher {
        flex: 1;
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-confirm-voucher {
        background: #28a745;
        color: white;
    }

    .btn-confirm-voucher:hover {
        background: #218838;
    }

    .btn-cancel-voucher {
        background: #dc3545;
        color: white;
    }

    .btn-cancel-voucher:hover {
        background: #c82333;
    }

    .btn-edit-voucher {
        flex: 1;
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        background: #007bff;
        color: white;
    }

    .btn-edit-voucher:hover {
        background: #0056b3;
    }

    .btn-save-edit {
        flex: 1;
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        background: #17a2b8;
        color: white;
    }

    .btn-save-edit:hover {
        background: #138496;
    }

    .voucher-edit-form {
        margin-top: 12px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .form-group {
        margin-bottom: 10px;
    }

    .form-group label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 4px;
    }

    .form-input {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .form-input:focus {
        outline: none;
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
    }

    .wizard-step-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        background: linear-gradient(90deg, #667eea22, #764ba222);
        border-top: 1px solid #667eea44;
        font-size: 0.82rem;
        gap: 8px;
    }
    .wizard-step-label {
        color: #4a3f8f;
        font-weight: 600;
        flex: 1;
    }
    .wizard-cancel-btn {
        border: none;
        background: #dc354522;
        color: #dc3545;
        border-radius: 6px;
        padding: 2px 8px;
        font-size: 0.78rem;
        cursor: pointer;
    }
    .wizard-cancel-btn:hover { background: #dc354544; }

    .voice-mode-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 5px 12px;
        background: linear-gradient(90deg, #ff444411, #ff444422);
        border-top: 1px solid #ff444444;
        font-size: 0.82rem;
        gap: 8px;
        animation: voiceModePulse 1.5s infinite;
    }
    @@keyframes voiceModePulse {
        0%   { background: linear-gradient(90deg, #ff444411, #ff444422); }
        50%  { background: linear-gradient(90deg, #ff444422, #ff444433); }
        100% { background: linear-gradient(90deg, #ff444411, #ff444422); }
    }
    .voice-mode-label {
        color: #c0392b;
        font-weight: 600;
        flex: 1;
        font-size: 0.8rem;
    }
    .voice-mode-stop {
        border: none;
        background: #c0392b22;
        color: #c0392b;
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 0.78rem;
        cursor: pointer;
        font-weight: 600;
    }
    .voice-mode-stop:hover { background: #c0392b44; }
    .ai-btn-mic-voice {
        background: #ffe5e5;
        border-color: #ff9999;
        animation: micVoiceIdle 2s infinite;
    }
    @@keyframes micVoiceIdle {
        0%   { box-shadow: 0 0 0 0 #ff444433; }
        50%  { box-shadow: 0 0 0 5px #ff444400; }
        100% { box-shadow: 0 0 0 0 #ff444400; }
    }

    @@media (max-width: 768px) {
        .ai-chat-container { width: 100vw; height: 80vh; right: 0; left: 0; bottom: 0; border-radius: 0; }
    }

    /* ── PDF Drop Zone ─────────────────────────────────────────────── */
    .ai-pdf-dropzone {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        padding: 6px 12px;
        margin: 0 10px 4px;
        border: 1.5px dashed #b0b8e0;
        border-radius: 8px;
        background: #f8f9ff;
        color: #667eea;
        font-size: 0.82rem;
        cursor: default;
        transition: all 0.2s;
        gap: 6px;
    }
    .ai-pdf-dropzone.pdf-drop-active {
        border-color: #667eea;
        background: #eef0ff;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.18);
    }
    .pdf-drop-label { display: flex; align-items: center; gap: 6px; }
    .pdf-pick-btn {
        background: none;
        border: none;
        color: #667eea;
        font-size: 0.82rem;
        text-decoration: underline;
        cursor: pointer;
        padding: 0;
    }
    .pdf-pick-btn:hover { color: #764ba2; }

    /* ── AI Mode ───────────────────────────────────────────────────── */
    .ai-mode-badge {
        display: inline-block;
        background: rgba(255,255,255,0.25);
        border-radius: 4px;
        padding: 1px 5px;
        font-size: 0.72rem;
        margin-right: 4px;
        vertical-align: middle;
    }
    .ai-btn-toggle { font-size: 14px; }
    .ai-btn-toggle-on {
        background: rgba(255,220,0,0.35) !important;
        box-shadow: 0 0 0 2px rgba(255,220,0,0.6);
    }
    .ai-api-settings {
        padding: 8px 12px;
        background: #f0f4ff;
        border-bottom: 1px solid #dde3ff;
        font-size: 0.8rem;
    }
    .ai-api-label { font-weight: 600; color: #4a3f8f; margin-bottom: 4px; }
    .ai-api-row { display: flex; gap: 6px; margin-bottom: 4px; align-items: center; }
    .ai-api-input {
        flex: 1;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 0.8rem;
    }
    .ai-api-select {
        flex: 1;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 0.8rem;
        background: #fff;
    }
    .ai-api-save {
        padding: 4px 10px;
        background: #667eea;
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 0.8rem;
        cursor: pointer;
        white-space: nowrap;
    }
    .ai-api-save:hover { background: #5a6ed6; }
    .ai-api-msg { color: #28a745; font-size: 0.75rem; }

    /* ── AI Thinking dots ──────────────────────────────────────────── */
    .ai-thinking { opacity: 0.85; }
    .ai-thinking-dots { display: flex; gap: 4px; padding: 4px 2px; }
    .ai-thinking-dots span {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #667eea;
        display: inline-block;
        animation: thinkingBounce 1.2s infinite;
    }
    .ai-thinking-dots span:nth-child(2) { animation-delay: 0.2s; }
    .ai-thinking-dots span:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes thinkingBounce {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40%            { transform: scale(1.0); opacity: 1.0; }
    }
</style>

@code
{
    [Parameter]
    public EventCallback<bool> CloseWindow { get; set; }

    private string userInput = string.Empty;
    private bool isMinimized;
    private bool isListening;
    private bool _voiceMode;
    private bool _isProcessingVoice;
    private bool _isDragging;
    private bool _isPdfProcessing;
    private string _micTitle => isListening ? "Dừng ghi âm" : (_voiceMode ? "Voice Mode (đang bật)" : "Nhập bằng giọng nói");
    private List<ChatMessage> messages = new();
    private VoiceWizardState _wizard = null;

    // ── AI Chat mode ─────────────────────────────────────────────────────────
    private bool _aiMode = false;
    private bool _isAiThinking = false;
    private List<AiMessage> _aiHistory = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var dotNetRef = DotNetObjectReference.Create(this);
                await Js.InvokeVoidAsync("SisAiPdf.registerDropZone", "ai-pdf-dropzone", dotNetRef);
                await Js.InvokeVoidAsync("SisAiPdf.handleFileInputChange", "ai-pdf-input", dotNetRef);
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var savedMessages = await SessionStorage.GetAsync<List<ChatMessage>>("sisai_chat_history");
            if (savedMessages.Success && savedMessages.Value != null && savedMessages.Value.Count > 0)
                messages = savedMessages.Value;
            else
                AddWelcomeMessage();
        }
        catch
        {
            AddWelcomeMessage();
        }
    }

    private async Task PickPdfFile()
    {
        try { await Js.InvokeVoidAsync("SisAiPdf.triggerFilePicker", "ai-pdf-input"); } catch { }
    }

    [JSInvokable]
    public void OnPdfDropStart(string fileName)
    {
        _isPdfProcessing = true;
        _isDragging = false;
        AddBot($"📄 Đang đọc file **{fileName}**...");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPdfDropError(string errorMsg)
    {
        _isPdfProcessing = false;
        _isDragging = false;
        AddBot($"❌ {errorMsg}");
        StateHasChanged();
    }

    [JSInvokable]
    public async void OnPdfTextExtracted(string fileName, string pdfText)
    {
        _isPdfProcessing = false;
        _isDragging = false;
        StateHasChanged();

        try
        {
            var extracted = ParsePdfVoucherFields(pdfText);

            if (extracted == null)
            {
                AddBot($"⚠️ Không nhận diện được thông tin phiếu thu từ **{fileName}**.\n\n" +
                       "Vui lòng nhập tay theo cú pháp:\n" +
                       "'Tạo phiếu thu: Khách KH001, Tiền 1000000, TK có 131'");
                return;
            }

            // Fill in defaults
            if (string.IsNullOrEmpty(extracted.TkNo)) extracted.TkNo = "111";
            if (extracted.NgayCt == default) extracted.NgayCt = DateTime.Now.Date;
            if (string.IsNullOrEmpty(extracted.MaDvcs))
                extracted.MaDvcs = await GetCurrentMaDvcs();

            if (string.IsNullOrEmpty(extracted.MaKh) && !string.IsNullOrEmpty(extracted.TenKh))
            {
                var customers = await SearchCustomerByName(RemoveDiacritics(extracted.TenKh).ToLowerInvariant());
                if (customers.Count == 1)
                {
                    extracted.MaKh  = customers[0].MaKh;
                    extracted.TenKh = customers[0].TenKh;
                    if (string.IsNullOrEmpty(extracted.DiaChi)) extracted.DiaChi = customers[0].DiaChi;
                }
                else if (customers.Count > 1)
                {
                    var exactMatch = customers.FirstOrDefault(c =>
                        RemoveDiacritics(c.TenKh).Equals(RemoveDiacritics(extracted.TenKh), StringComparison.OrdinalIgnoreCase));
                    if (exactMatch != default)
                    {
                        extracted.MaKh  = exactMatch.MaKh;
                        extracted.TenKh = exactMatch.TenKh;
                        if (string.IsNullOrEmpty(extracted.DiaChi)) extracted.DiaChi = exactMatch.DiaChi;
                    }
                }
            }

            if (string.IsNullOrEmpty(extracted.MaKh) && !string.IsNullOrEmpty(extracted.MaSoThue))
            {
                try
                {
                    var safeMst = extracted.MaSoThue.Replace("'", "''");
                    var mstSql = $"SELECT TOP 1 ma_kh, ten_kh, dia_chi, doi_tac FROM dmkh WHERE ma_so_thue = N'{safeMst}'";
                    var dsMst = await myDb.LoadDataset(mstSql);
                    if (dsMst != null && dsMst.Tables[0].Rows.Count > 0)
                    {
                        extracted.MaKh  = dsMst.Tables[0].Rows[0]["ma_kh"]?.ToString()?.Trim();
                        extracted.TenKh = dsMst.Tables[0].Rows[0]["ten_kh"]?.ToString()?.Trim();
                        if (string.IsNullOrEmpty(extracted.DiaChi))
                            extracted.DiaChi = dsMst.Tables[0].Rows[0]["dia_chi"]?.ToString()?.Trim();
                    }
                }
                catch { }
            }

            if (string.IsNullOrEmpty(extracted.DienGiai))
            {
                if (!string.IsNullOrEmpty(extracted.MaKh))
                    extracted.DienGiai = $"Thu tiền khách hàng {extracted.MaKh}";
                else if (!string.IsNullOrEmpty(extracted.TenKh))
                    extracted.DienGiai = $"Thu tiền khách hàng {extracted.TenKh}";
            }

            // Build preview summary
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"📄 **Nhận diện từ file: {fileName}**\n");
            sb.AppendLine("📋 **Thông tin nhận diện được:**");
            if (!string.IsNullOrEmpty(extracted.SoCt))    sb.AppendLine($"• Số chứng từ: **{extracted.SoCt}**");
            if (!string.IsNullOrEmpty(extracted.MaKh))    sb.AppendLine($"• Khách hàng: **{extracted.MaKh}**{(!string.IsNullOrEmpty(extracted.TenKh) ? " - " + extracted.TenKh : "")}");
            else if (!string.IsNullOrEmpty(extracted.TenKh)) sb.AppendLine($"• Đơn vị (KH): **{extracted.TenKh}** (chưa xác định mã KH)");
            if (!string.IsNullOrEmpty(extracted.MaSoThue)) sb.AppendLine($"• Mã số thuế: {extracted.MaSoThue}");
            if (!string.IsNullOrEmpty(extracted.OngBa))   sb.AppendLine($"• Người nộp tiền: {extracted.OngBa}");
            if (!string.IsNullOrEmpty(extracted.DiaChi))  sb.AppendLine($"• Địa chỉ: {extracted.DiaChi}");
            if (extracted.SoTien > 0)                     sb.AppendLine($"• Số tiền: **{extracted.SoTien:N0} VND**");
            if (!string.IsNullOrEmpty(extracted.TkNo))    sb.AppendLine($"• TK nợ: **{extracted.TkNo}**");
            if (!string.IsNullOrEmpty(extracted.TkCo))    sb.AppendLine($"• TK có: **{extracted.TkCo}**");
            if (!string.IsNullOrEmpty(extracted.DienGiai))sb.AppendLine($"• Diễn giải: {extracted.DienGiai}");
            if (extracted.NgayCt != default)              sb.AppendLine($"• Ngày: {extracted.NgayCt:dd/MM/yyyy}");
            if (!string.IsNullOrEmpty(extracted.MaDvcs))  sb.AppendLine($"• Đơn vị CS: {extracted.MaDvcs}");

            bool hasEnoughData = !string.IsNullOrEmpty(extracted.MaKh) && extracted.SoTien > 0;

            if (!hasEnoughData)
            {
                sb.AppendLine();
                if (string.IsNullOrEmpty(extracted.MaKh) && !string.IsNullOrEmpty(extracted.TenKh))
                    sb.AppendLine("⚠️ Nhận diện được đơn vị (khách hàng) nhưng chưa xác định được mã KH. Vui lòng **Sửa thông tin** để nhập mã KH.");
                else
                    sb.AppendLine("⚠️ Thiếu thông tin. Vui lòng **Sửa thông tin** để bổ sung.");
            }
            else
            {
                sb.AppendLine();
                sb.AppendLine("✅ Nhấn **Xác nhận tạo** để tạo phiếu thu, **Sửa thông tin** để chỉnh sửa.");
            }

            var confirmMsg = new ChatMessage
            {
                Name = "Trợ lý ERP",
                Role = "bot",
                Time = DateTime.Now,
                Text = sb.ToString().TrimEnd(),
                VoucherData = extracted,
                IsEditing = !hasEnoughData
            };
            messages.Add(confirmMsg);
            StateHasChanged();
            await SaveChatHistory();
            await ScrollBottom();
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi khi phân tích PDF: {ex.Message}");
        }
    }

    private static Dictionary<string, string> ParsePdfLabelValuePairs(string text)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(text)) return result;

        // Normalise: collapse runs of whitespace/newlines to single space
        var flat = Regex.Replace(text, @"\s+", " ").Trim();

        var ms = Regex.Matches(flat,
            @"([A-ZÀ-Ỹa-zà-ỹ][A-ZÀ-Ỹa-zà-ỹ0-9 /\-]{0,60}?)\s*:",
            RegexOptions.None);

        for (int i = 0; i < ms.Count; i++)
        {
            string lbl = ms[i].Groups[1].Value.Trim();
            if (string.IsNullOrWhiteSpace(lbl)) continue;

            int vStart = ms[i].Index + ms[i].Length;
            int vEnd   = (i + 1 < ms.Count) ? ms[i + 1].Index : flat.Length;
            if (vEnd <= vStart) continue;

            string val = flat.Substring(vStart, vEnd - vStart).Trim();
            // Remove trailing parenthetical remarks
            val = Regex.Replace(val, @"\s*\([^)]{0,80}\)\s*$", "").Trim();
            var gapM = Regex.Match(val, @"\s{2,}");
            if (gapM.Success)
                val = val.Substring(0, gapM.Index).Trim();

            if (!string.IsNullOrWhiteSpace(lbl) && !string.IsNullOrWhiteSpace(val))
                result[lbl] = val;
        }
        return result;
    }

    private VoucherCreateData ParsePdfVoucherFields(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;

        var data = new VoucherCreateData();

        // ── Chuẩn hoá: collapse tất cả whitespace thành 1 dấu cách ─────────
        var norm = Regex.Replace(text, @"\s+", " ").Trim();

        static string After(string src, string labelPattern)
        {
            var m = Regex.Match(src,
                labelPattern + @"\s*:\s*(.+?)(?=\s{2,}|[A-ZÀ-Ỹa-zà-ỹ][A-ZÀ-Ỹa-zà-ỹ0-9 /\-]{1,50}\s*:|$)",
                RegexOptions.IgnoreCase | RegexOptions.Singleline);
            return m.Success ? m.Groups[1].Value.Trim() : null;
        }

        static string AfterShort(string src, string labelPattern)
        {
            var val = After(src, labelPattern);
            if (val == null) return null;
            var gap = Regex.Match(val, @"\s{2,}");
            return gap.Success ? val.Substring(0, gap.Index).Trim() : val;
        }

        data.SoCt = AfterShort(norm,
            @"(?:Số\s*phiếu|Số\s*CT|So\s*phieu|So\s*CT|Số\s*chứng\s*từ|Number)");

        var ngayFormal = Regex.Match(norm,
            @"[Nn]g[àa][ỳy]?\s+(\d{1,2})\s+[Tt]h[áa]ng\s+(\d{1,2})\s+[Nn][ăa]m\s+(\d{4})",
            RegexOptions.IgnoreCase);
        if (!ngayFormal.Success)
            ngayFormal = Regex.Match(norm,
                @"NGA[Y]?\s+(\d{1,2})\s+THANG\s+(\d{1,2})\s+NAM\s+(\d{4})",
                RegexOptions.IgnoreCase);
        if (ngayFormal.Success)
        {
            int dd = int.Parse(ngayFormal.Groups[1].Value);
            int mm = int.Parse(ngayFormal.Groups[2].Value);
            int yy = int.Parse(ngayFormal.Groups[3].Value);
            if (dd >= 1 && dd <= 31 && mm >= 1 && mm <= 12 && yy >= 2000)
                data.NgayCt = new DateTime(yy, mm, dd);
        }
        if (data.NgayCt == default)
        {
            var dm = Regex.Match(norm, @"\b(\d{1,2}[/\-]\d{1,2}[/\-]\d{4})\b");
            if (dm.Success)
            {
                var ds2 = dm.Groups[1].Value.Replace('-', '/');
                if (DateTime.TryParseExact(ds2, new[] { "d/M/yyyy", "dd/MM/yyyy" },
                        System.Globalization.CultureInfo.InvariantCulture,
                        System.Globalization.DateTimeStyles.None, out DateTime dt))
                    data.NgayCt = dt;
            }
        }
        if (data.NgayCt == default) data.NgayCt = DateTime.Now.Date;

        var mstVal = AfterShort(norm,
            @"(?:Mã\s*số\s*thuế|Ma\s*so\s*thue|MST)");
        if (!string.IsNullOrEmpty(mstVal) && Regex.IsMatch(mstVal, @"^\d[\d\-]{8,}"))
            data.MaSoThue = mstVal;
        if (string.IsNullOrEmpty(data.MaSoThue))
        {
            var mstM = Regex.Match(norm,
                @"(?:MST|Mã\s*số\s*thuế|Ma\s*so\s*thue)\s*:?\s*(\d[\d\-]{8,})",
                RegexOptions.IgnoreCase);
            if (mstM.Success) data.MaSoThue = mstM.Groups[1].Value.Trim();
        }

        var donViM = Regex.Match(norm,
            @"(?<!\S)(?:Đơn\s*vị|Don\s*vi)\s*:\s*(.+?)(?=\s{2,}|(?:Địa\s*chỉ|Dia\s*chi|Mã\s*số|Ma\s*so|Người\s*nộp|Nguoi\s*nop|Số\s*tiền|So\s*tien|TK|Lý\s*do|Ly\s*do|Diễn|Dien|$))",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);
        if (donViM.Success)
        {
            var donViVal = donViM.Groups[1].Value.Trim();
            var dashM = Regex.Match(donViVal, @"^([A-Za-z0-9]{2,20})\s*[\-–]\s*(.+)$");
            if (dashM.Success && Regex.IsMatch(dashM.Groups[1].Value, @"[A-Za-z]"))
            {
                data.MaKh  = dashM.Groups[1].Value.Trim();
                data.TenKh = dashM.Groups[2].Value.Trim();
            }
            else
            {
                var afterDash = Regex.Match(donViVal, @"^[0-9\s\-–]*[\-–]\s*(.+)$");
                data.TenKh = afterDash.Success ? afterDash.Groups[1].Value.Trim() : donViVal;
            }
        }

        var diaChiVal = After(norm,
            @"(?:Địa\s*chỉ|Dia\s*chi|Address)");
        if (!string.IsNullOrEmpty(diaChiVal) && diaChiVal.Length < 300)
            data.DiaChi = diaChiVal;

        var ongBaVal = AfterShort(norm,
            @"(?:Người\s*nộp\s*tiền|Nguoi\s*nop\s*tien|Họ\s*tên\s*người\s*nộp|Ho\s*ten\s*nguoi\s*nop|Full\s*[Nn]ame)");
        if (!string.IsNullOrEmpty(ongBaVal) && ongBaVal.Length >= 2
            && !Regex.IsMatch(ongBaVal, @"^\d{5,}"))
            data.OngBa = ongBaVal;

        data.DienGiai = After(norm,
            @"(?:Lý\s*do\s*nộp\s*tiền|Ly\s*do\s*nop\s*tien|Lý\s*do\s*nộp|Ly\s*do\s*nop|Lý\s*do|Ly\s*do|Diễn\s*giải|Dien\s*giai|Nội\s*dung|Noi\s*dung)");

        var soTienRaw = AfterShort(norm,
            @"(?:Số\s*tiền|So\s*tien|Tổng\s*cộng|Tong\s*cong|Total)");
        if (!string.IsNullOrEmpty(soTienRaw))
        {
            var stM = Regex.Match(soTienRaw, @"([\d.,]+)");
            if (stM.Success)
            {
                var numStr = NormalizeAmountString(stM.Groups[1].Value);
                decimal.TryParse(numStr, out decimal amt);
                data.SoTien = amt;
            }
        }
        if (data.SoTien == 0)
        {
            decimal best = 0;
            foreach (System.Text.RegularExpressions.Match fm in
                Regex.Matches(norm, @"(\d{1,3}(?:[.,]\d{3})+)"))
            {
                var numStr = NormalizeAmountString(fm.Groups[1].Value);
                if (decimal.TryParse(numStr, out decimal amt) && amt > best) best = amt;
            }
            data.SoTien = best;
        }

        var noRaw = AfterShort(norm,
            @"(?:TK\s*nợ|TK\s*Nợ|TK\s*no|Tài\s*khoản\s*nợ|Tai\s*khoan\s*no|Nợ|No)");
        if (!string.IsNullOrEmpty(noRaw))
        {
            var nm = Regex.Match(noRaw, @"(\d{3,4})");
            if (nm.Success) data.TkNo = nm.Groups[1].Value;
        }

        var coRaw = AfterShort(norm,
            @"(?:TK\s*có|TK\s*Có|TK\s*co|Tài\s*khoản\s*có|Tai\s*khoan\s*co|Có|Co)");
        if (!string.IsNullOrEmpty(coRaw))
        {
            var cm = Regex.Match(coRaw, @"(\d{3,4})");
            if (cm.Success) data.TkCo = cm.Groups[1].Value;
        }

        data.MaQs = AfterShort(norm,
            @"(?:Quyển\s*sổ|Quyen\s*so|Quy[eê]n\s*s[oố])") ?? "PT";

        var dvcsRaw = AfterShort(norm,
            @"(?:Đơn\s*vị\s*cơ\s*sở|Don\s*vi\s*co\s*so|DVCS|Chi\s*nhánh|Chi\s*nhanh)");
        if (!string.IsNullOrEmpty(dvcsRaw))
        {
            var dm2 = Regex.Match(dvcsRaw, @"^([A-Za-z0-9]{1,10})");
            if (dm2.Success) data.MaDvcs = dm2.Groups[1].Value.Trim().ToUpper();
        }

        // ── Trả về ────────────────────────────────────────────────────────────
        bool hasMinData = !string.IsNullOrEmpty(data.MaKh)     ||
                          !string.IsNullOrEmpty(data.TenKh)    ||
                          !string.IsNullOrEmpty(data.MaSoThue) ||
                          data.SoTien > 0                      ||
                          !string.IsNullOrEmpty(data.TkCo)     ||
                          !string.IsNullOrEmpty(data.SoCt);
        return hasMinData ? data : null;
    }

    private static string NormalizeAmountString(string numStr)
    {
        if (string.IsNullOrEmpty(numStr)) return numStr;
        numStr = numStr.Trim();
        if (numStr.Contains(".") && numStr.Contains(","))
            numStr = numStr.Replace(".", "").Replace(",", "");
        else if (numStr.Count(c => c == '.') > 1)
            numStr = numStr.Replace(".", "");
        else if (numStr.Count(c => c == ',') > 1)
            numStr = numStr.Replace(",", "");
        else
            numStr = numStr.Replace(",", "").Replace(".", "");
        return numStr;
    }

