    private async Task SaveEditedVoucher(ChatMessage msg)
    {
        try
        {
            var data = msg.VoucherData;
            if (string.IsNullOrWhiteSpace(data.MaDvcs) || data.MaDvcs.Equals("ALL", StringComparison.OrdinalIgnoreCase))
            {
                AddBot("⚠️ Vui lòng nhập **Mã đơn vị** hợp lệ (không được để trống hoặc 'ALL')");
                return;
            }

            if (string.IsNullOrWhiteSpace(data.MaKh))
            {
                AddBot("⚠️ Vui lòng nhập **Mã khách hàng**");
                return;
            }

            if (data.SoTien <= 0)
            {
                AddBot("⚠️ **Số tiền** phải lớn hơn 0");
                return;
            }

            if (string.IsNullOrWhiteSpace(data.TkCo))
            {
                AddBot("⚠️ Vui lòng nhập **TK có**");
                return;
            }

            if (string.IsNullOrWhiteSpace(data.TkNo))
            {
                data.TkNo = "111";
            }

            var checkDvcs = await ValidateDvcs(data.MaDvcs);
            if (!checkDvcs.IsValid)
            {
                AddBot($"❌ {checkDvcs.Message}");
                return;
            }

            var checkKh = await ValidateCustomer(data.MaKh);
            if (!checkKh.IsValid)
            {
                AddBot($"❌ {checkKh.Message}");
                return;
            }
            
            if (string.IsNullOrEmpty(data.DiaChi)) data.DiaChi = checkKh.DiaChi;
            if (string.IsNullOrEmpty(data.OngBa)) data.OngBa = checkKh.OngBa;

            var checkTkCo = await ValidateAccount(data.TkCo);
            if (!checkTkCo.IsValid)
            {
                AddBot($"❌ {checkTkCo.Message}");
                return;
            }

            var checkTkNo = await ValidateDebitAccount(data.TkNo);
            if (!checkTkNo.IsValid)
            {
                AddBot($"❌ {checkTkNo.Message}");
                return;
            }

            data.TenDvcs = checkDvcs.TenDvcs;
            data.TenKh = checkKh.TenKh;
            data.TenTkCo = checkTkCo.TenTk;
            data.TenTkNo = checkTkNo.TenTk;

            if (string.IsNullOrEmpty(data.SttRec))
            {
                string wsId = myOption.GetOptionsValue("M_WS_ID") ?? "A";
                var sttRecSql = $"EXEC dbo.GetSttRec 'PT1', '{wsId}'";
                var dsSttRec = await myDb.LoadDataset(sttRecSql);
                
                if (dsSttRec != null && dsSttRec.Tables[0].Rows.Count > 0)
                {
                    string sttRec = dsSttRec.Tables[0].Rows[0][0].ToString();
                    data.SttRec = sttRec;
                }
            }

            msg.IsEditing = false;
            msg.Text = $"✅ **Xác nhận thông tin phiếu thu (đã chỉnh sửa):**\n\n" +
                       $"📋 **Thông tin chung:**\n" +
                       $"• Đơn vị: **{data.MaDvcs}** - {data.TenDvcs}\n" +
                       $"• Khách hàng: **{data.TenKh}** ({data.MaKh})\n" +
                       (!string.IsNullOrEmpty(data.OngBa) ? $"• Ông/Bà: {data.OngBa}\n" : "") +
                       (!string.IsNullOrEmpty(data.DiaChi) ? $"• Địa chỉ: {data.DiaChi}\n" : "") +
                       $"• Số tiền: **{data.SoTien:N0} VND**\n\n" +
                       $"💰 **Hạch toán:**\n" +
                       $"• TK nợ: **{data.TkNo}** - {data.TenTkNo}\n" +
                       $"• TK có: **{data.TkCo}** - {data.TenTkCo}\n" +
                       $"• Diễn giải: {data.DienGiai}\n\n" +
                       $"📝 **Lưu ý:**\n" +
                       $"• Đã lưu thông tin tạm thời\n" +
                       $"• Nhấn **Xác nhận tạo** để hoàn tất phiếu thu\n" +
                       $"• Nhấn **Hủy** để hủy bỏ";
            
            StateHasChanged();
            await ScrollBottom();
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi khi lưu chỉnh sửa: {ex.Message}");
        }
    }

