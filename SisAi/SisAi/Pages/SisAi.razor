    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        var text = userInput.Trim();
        var userMsg = new ChatMessage
        {
            Name = "Bạn",
            Role = "user",
            Time = DateTime.Now,
            Text = text
        };
        messages.Add(userMsg);
        userInput = string.Empty;

        if (_aiMode)
            await ProcessAi(text);
        else
            Process(text);

        await SaveChatHistory();
        await ScrollBottom();
    }

    private async Task ProcessAi(string userText)
    {
        if (string.IsNullOrWhiteSpace(AiChatConfig.OpenAI_ApiKey))
        {
            AddBot("⚠️ Chưa cấu hình API Key. Vui lòng khai báo trong file **AiChatConfig.cs** → thuộc tính **OpenAI_ApiKey**.");
            return;
        }

        _isAiThinking = true;
        StateHasChanged();
        await ScrollBottom();

        try
        {
            var result = await AiChat.SendAsync(_aiHistory, userText);

            if (result.Success)
            {
                // Add to rolling history
                _aiHistory.Add(new AiMessage { Role = "user", Content = userText });
                _aiHistory.Add(new AiMessage { Role = "assistant", Content = result.Text });
                // Keep last 40 messages (20 turns) to avoid token overflow
                if (_aiHistory.Count > 40)
                    _aiHistory.RemoveRange(0, _aiHistory.Count - 40);

                messages.Add(new ChatMessage
                {
                    Name = "Trợ lý ERP (AI)",
                    Role = "bot",
                    Time = DateTime.Now,
                    Text = result.Text
                });
            }
            else
            {
                messages.Add(new ChatMessage
                {
                    Name = "Trợ lý ERP (AI)",
                    Role = "bot",
                    Time = DateTime.Now,
                    Text = $"❌ {result.ErrorMessage}"
                });
            }
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage
            {
                Name = "Trợ lý ERP (AI)",
                Role = "bot",
                Time = DateTime.Now,
                Text = $"❌ Lỗi không xác định: {ex.Message}"
            });
        }
        finally
        {
            _isAiThinking = false;
            StateHasChanged();
            await ScrollBottom();
        }
    }

    private void Process(string originalInput)
