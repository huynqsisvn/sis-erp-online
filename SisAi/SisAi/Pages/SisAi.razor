    private static string CollapseSpacedDigits(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;

        // Collapse sequences of single-char alphanumeric tokens separated by spaces
        // e.g. "K H 0 0 1" → "KH001",  "0 1 0 1" → "0101"
        return System.Text.RegularExpressions.Regex.Replace(
            text,
            @"(?<![\w])([A-Za-z0-9])(?:\s+([A-Za-z0-9]))+(?![\w])",
            m => System.Text.RegularExpressions.Regex.Replace(m.Value, @"\s+", ""));
    }

    private static string FixPhoneticMisrecognition(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;

        var s = RemoveDiacritics(text).ToLowerInvariant();

        s = System.Text.RegularExpressions.Regex.Replace(
            s,
            @"\b(ca\s*hat|ke\s*a|ke\s*hat|kha(?=\s*\d)|\bka(?=\s*\d))\b",
            "KH",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(
            s,
            @"\b(pe\s*te|p\s*t(?=\s*\d))\b",
            "PT",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(
            s,
            @"\b(pe\s*xe|p\s*c(?=\s*\d))\b",
            "PC",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(
            s,
            @"\b(khong)\s+(khong)\s+(mot)\b",
            "001",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s = System.Text.RegularExpressions.Regex.Replace(
            s,
            @"\b(khong)\s+(mot)\b",
            "01",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(
            s,
            @"\b(kh|pt|pc|pn|xk|nk)(\d+)\b",
            m => m.Groups[1].Value.ToUpper() + m.Groups[2].Value,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return s;
    }

    private static string ConvertVietnameseWordsToDigits(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;

        // Normalize diacritics for matching, keep original for non-number parts
        var norm = RemoveDiacritics(text).ToLowerInvariant();

        var units = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase)
        {
            ["khong"]   = 0,  ["zero"]  = 0,
            ["mot"]     = 1,  ["one"]   = 1,  ["nhat"] = 1,
            ["hai"]     = 2,  ["two"]   = 2,
            ["ba"]      = 3,  ["three"] = 3,
            ["bon"]     = 4,  ["four"]  = 4,  ["tu"]   = 4,
            ["nam"]     = 5,  ["five"]  = 5,
            ["sau"]     = 6,  ["six"]   = 6,
            ["bay"]     = 7,  ["seven"] = 7,  ["bay"]  = 7,
            ["tam"]     = 8,  ["eight"] = 8,
            ["chin"]    = 9,  ["nine"]  = 9,
            ["muoi"]    = 10, ["ten"]   = 10, ["chuc"] = 10,
            ["muoi mot"] = 11, ["eleven"]   = 11,
            ["muoi hai"] = 12, ["twelve"]   = 12,
            ["muoi ba"]  = 13, ["thirteen"] = 13,
            ["muoi bon"] = 14, ["fourteen"] = 14,
            ["muoi nam"] = 15, ["fifteen"]  = 15,
            ["muoi sau"] = 16, ["sixteen"]  = 16,
            ["muoi bay"] = 17, ["seventeen"]= 17,
            ["muoi tam"] = 18, ["eighteen"] = 18,
            ["muoi chin"]= 19, ["nineteen"] = 19,
            ["muoi mot"] = 11, ["muoi tu"]  = 14,
            ["mot muoi"] = 10, // alt form
            ["linh mot"] = 1, ["le mot"] = 1,  // e.g. "hai muoi linh mot" = 21
            ["linh hai"] = 2, ["le hai"] = 2,
            ["linh ba"]  = 3, ["le ba"]  = 3,
            ["linh bon"] = 4, ["le bon"] = 4,
            ["linh nam"] = 5, ["le nam"] = 5,
            ["linh sau"] = 6, ["le sau"] = 6,
            ["linh bay"] = 7, ["le bay"] = 7,
            ["linh tam"] = 8, ["le tam"] = 8,
            ["linh chin"]= 9, ["le chin"]= 9,
        };
        var tens = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase)
        {
            ["muoi"]      = 10, ["hai muoi"]  = 20, ["ba muoi"]   = 30,
            ["bon muoi"]  = 40, ["nam muoi"]  = 50, ["sau muoi"]  = 60,
            ["bay muoi"]  = 70, ["tam muoi"]  = 80, ["chin muoi"] = 90,
            ["hai chuc"]  = 20, ["ba chuc"]   = 30, ["bon chuc"]  = 40,
            ["nam chuc"]  = 50, ["sau chuc"]  = 60, ["bay chuc"]  = 70,
            ["tam chuc"]  = 80, ["chin chuc"] = 90,
        };
        var scaleWords = new (string Word, long Value)[]
        {
            ("ty",     1_000_000_000L),
            ("trieu",  1_000_000L),
            ("nghin",  1_000L),
            ("ngan",   1_000L),
            ("ngàn",   1_000L),
            ("tram",   100L),
            ("muoi",   10L),
        };
        var words = System.Text.RegularExpressions.Regex
            .Split(norm, @"(\s+)")
            .ToList();

        // We'll process left-to-right, consuming number-word runs
        var result = new System.Text.StringBuilder();
        int wi = 0;
        var origWords = System.Text.RegularExpressions.Regex
            .Split(text, @"(\s+)")
            .ToList();

        while (wi < words.Count)
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(words[wi], @"^\s+$"))
            {
                result.Append(origWords[wi]);
                wi++;
                continue;
            }

            // Try to parse a number starting at wi
            var (numValue, consumed) = TryParseVietnameseNumber(words, wi, units, tens, scaleWords);
            if (consumed > 0)
            {
                result.Append(numValue.ToString());
                wi += consumed;
            }
            else
            {
                result.Append(origWords[wi]);
                wi++;
            }
        }

        return result.ToString();
    }

    private static (long Value, int Consumed) TryParseVietnameseNumber(
        List<string> words, int start,
        Dictionary<string, long> units,
        Dictionary<string, long> tens,
        (string Word, long Value)[] scaleWords)
    {
        var tokens = new List<(string Norm, int OrigIdx)>();
        tokens.Clear();
        int idx = start;
        while (idx < words.Count)
        {
            var w = words[idx];
            if (System.Text.RegularExpressions.Regex.IsMatch(w, @"^\s+$"))
            {
                idx++;
                continue; // skip whitespace for matching, but count it in consumed
            }
            tokens.Add((w, idx));
            idx++;
            if (tokens.Count >= 10) break; // max look-ahead
        }

        if (tokens.Count == 0) return (0, 0);

        for (int len = Math.Min(tokens.Count, 8); len >= 1; len--)
        {
            var span = string.Join(" ", tokens.Take(len).Select(t => t.Norm));

            // Check multi-word units/tens directly
            if (units.TryGetValue(span, out long uVal))
            {
                int consumed = tokens[len - 1].OrigIdx - start + 1;
                return (uVal, consumed);
            }
            if (tens.TryGetValue(span, out long tVal))
            {
                int consumed = tokens[len - 1].OrigIdx - start + 1;
                if (len < tokens.Count)
                {
                    var nextToken = tokens[len].Norm;
                    if (units.TryGetValue(nextToken, out long uUnit) && uUnit < 10)
                    {
                        int c2 = tokens[len].OrigIdx - start + 1;
                        return (tVal + uUnit, c2);
                    }
                    if ((nextToken == "linh" || nextToken == "le") && len + 1 < tokens.Count)
                    {
                        var afterLinh = tokens[len + 1].Norm;
                        if (units.TryGetValue(afterLinh, out long uLinh) && uLinh < 10)
                        {
                            int c3 = tokens[len + 1].OrigIdx - start + 1;
                            return (tVal + uLinh, c3);
                        }
                    }
                }
                return (tVal, consumed);
            }
        }

        if (tokens.Count >= 1 && units.TryGetValue(tokens[0].Norm, out long leadUnit))
        {
            if (tokens.Count >= 2)
            {
                foreach (var scale in scaleWords)
                {
                    if (tokens[1].Norm == scale.Word)
                    {
                        long baseVal = leadUnit * scale.Value;
                        int consumedBase = tokens[1].OrigIdx - start + 1;
                        int nextStart = tokens[1].OrigIdx + 1;
                        while (nextStart < words.Count && System.Text.RegularExpressions.Regex.IsMatch(words[nextStart], @"^\s+$"))
                            nextStart++;
                        if (nextStart < words.Count)
                        {
                            var (remVal, remConsumed) = TryParseVietnameseNumber(
                                words, nextStart, units, tens, scaleWords);
                            if (remConsumed > 0 && remVal < scale.Value)
                            {
                                return (baseVal + remVal, nextStart + remConsumed - start);
                            }
                        }
                        return (baseVal, consumedBase);
                    }
                }
            }
        }

        return (0, 0);
    }

    private async void ProcessWizardInput(string input)
    {
        // Apply phonetic correction pipeline for all input (typed or voice)
        var fixed1 = FixPhoneticMisrecognition(input);
        var fixed2 = CollapseSpacedDigits(fixed1);
        input = ConvertVietnameseWordsToDigits(fixed2);

        var norm = RemoveDiacritics(input).ToLowerInvariant().Trim();

        if (norm == "huy" || norm == "cancel" || norm == "thoat" || norm == "exit")
        {
            _wizard = null;
            AddBot("❌ Đã hủy tạo phiếu thu.");
            StateHasChanged();
            return;
        }

        switch (_wizard.Step)
        {
            case VoiceWizardStep.Customer:
            {
                string rawKh = input.Trim();
                rawKh = System.Text.RegularExpressions.Regex.Replace(
                    rawKh, @"^(khách hàng|khach hang|khách|khach|mã|ma)\s+",
                    "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();

                string normKh = RemoveDiacritics(rawKh).ToLowerInvariant();
                bool looksLikeCode = normKh.Length <= 15 && !normKh.Contains(" ");

                if (looksLikeCode)
                {
                    _wizard.Data.MaKh = normKh.ToUpper();
                    _wizard.Step = VoiceWizardStep.Amount;
                    AddBot($"✅ Khách hàng: **{_wizard.Data.MaKh}**\n\n" +
                           "💰 **Bước 2/5 — Số tiền**\n" +
                           "Nói số tiền. Ví dụ: *2 triệu*, *500 nghìn*, *1500000*");
                }
                else
                {
                    var found = await SearchCustomerByName(normKh);
                    if (found.Count == 1)
                    {
                        _wizard.Data.MaKh  = found[0].MaKh;
                        _wizard.Data.TenKh = found[0].TenKh;
                        _wizard.Step = VoiceWizardStep.Amount;
                        AddBot($"✅ Khách hàng: **{found[0].TenKh}** ({found[0].MaKh})\n\n" +
                               "💰 **Bước 2/5 — Số tiền**\n" +
                               "Nói số tiền. Ví dụ: *2 triệu*, *500 nghìn*, *1500000*");
                    }
                    else if (found.Count > 1)
                    {
                        var list = string.Join("\n", found.Select((c, i) => $"  {i + 1}. **{c.MaKh}** - {c.TenKh}"));
                        AddBot($"🔍 Tìm thấy {found.Count} khách hàng:\n{list}\n\n" +
                               "💡 Vui lòng nói **mã khách hàng** cụ thể (VD: KH001)");
                    }
                    else
                    {
                        AddBot($"❌ Không tìm thấy khách hàng: *{rawKh}*\n\n" +
                               "💡 Thử nói **mã khách hàng** (VD: KH001) hoặc kiểm tra lại tên.");
                    }
                }
                break;
            }

            case VoiceWizardStep.Amount:
            {
                string rawTien = input.Trim();
                rawTien = System.Text.RegularExpressions.Regex.Replace(
                    rawTien, @"^(số tiền|so tien|tiền|tien|là|la)\s+",
                    "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();

                decimal soTien = ParseSpokenAmount(RemoveDiacritics(rawTien).ToLowerInvariant());
                if (soTien <= 0)
                {
                    var numOnly = System.Text.RegularExpressions.Regex.Replace(rawTien, @"[^\d]", "");
                    decimal.TryParse(numOnly, out soTien);
                }

                if (soTien <= 0)
                {
                    AddBot($"⚠️ Không nhận được số tiền hợp lệ từ: *{rawTien}*\n\n" +
                           "💡 Thử lại: *2 triệu*, *500 nghìn*, *1500000*");
                }
                else
                {
                    _wizard.Data.SoTien = soTien;
                    _wizard.Step = VoiceWizardStep.TkCo;
                    AddBot($"✅ Số tiền: **{soTien:N0} VND**\n\n" +
                           "🏦 **Bước 3/5 — Tài khoản có (TK có)**\n" +
                           "Nói mã tài khoản có. Ví dụ: *131*, *511*, *1111*");
                }
                break;
            }

            case VoiceWizardStep.TkCo:
            {
                var tkCoRaw = System.Text.RegularExpressions.Regex.Match(
                    RemoveDiacritics(input), @"(\d+)");
                if (!tkCoRaw.Success)
                {
                    AddBot("⚠️ Vui lòng nói **số tài khoản có**. Ví dụ: *131*, *511*");
                    break;
                }
                string tkCo = tkCoRaw.Groups[1].Value.Trim();
                var checkTk = await ValidateAccount(tkCo);
                if (!checkTk.IsValid)
                {
                    AddBot($"❌ {checkTk.Message}\n\n💡 Thử lại với mã TK khác (VD: 131, 511, 711)");
                    break;
                }
                _wizard.Data.TkCo = tkCo;
                _wizard.Step = VoiceWizardStep.TkNo;
                AddBot($"✅ TK có: **{tkCo}** - {checkTk.TenTk}\n\n" +
                       "🏦 **Bước 4/5 — Tài khoản nợ (TK nợ)**\n" +
                       "Nói mã tài khoản nợ. Ví dụ: *111*, *1121*\n" +
                       "Hoặc nói **bỏ qua** để dùng mặc định (111 - Tiền mặt)");
                break;
            }

            case VoiceWizardStep.TkNo:
            {
                bool skip = norm.Contains("bo qua") || norm.Contains("mac dinh") ||
                            norm.Contains("skip") || norm == "khong";
                string tkNo = "111";

                if (!skip)
                {
                    var tkNoRaw = System.Text.RegularExpressions.Regex.Match(
                        RemoveDiacritics(input), @"(\d+)");
                    if (tkNoRaw.Success)
                        tkNo = tkNoRaw.Groups[1].Value.Trim();
                }

                var checkTkNo = await ValidateDebitAccount(tkNo);
                if (!checkTkNo.IsValid)
                {
                    AddBot($"❌ {checkTkNo.Message}\n\n💡 Thử lại (VD: 111, 1121) hoặc nói **bỏ qua** để dùng 111");
                    break;
                }
                _wizard.Data.TkNo = tkNo;
                _wizard.Step = VoiceWizardStep.DienGiai;
                AddBot($"✅ TK nợ: **{tkNo}** - {checkTkNo.TenTk}\n\n" +
                       "📝 **Bước 5/5 — Diễn giải**\n" +
                       "Nói nội dung diễn giải. Ví dụ: *Thu tiền hàng tháng 6*\n" +
                       "Hoặc nói **bỏ qua** để dùng diễn giải mặc định.");
                break;
            }

            case VoiceWizardStep.DienGiai:
            {
                bool skip = norm.Contains("bo qua") || norm.Contains("mac dinh") ||
                            norm.Contains("skip") || norm == "khong";

                _wizard.Data.DienGiai = skip
                    ? $"Thu tiền khách hàng {_wizard.Data.MaKh}"
                    : input.Trim();

                // Get ma_dvcs
                _wizard.Data.MaDvcs = await GetCurrentMaDvcs();
                _wizard.Data.NgayCt = DateTime.Now.Date;

                var d = _wizard.Data;
                _wizard.Step = VoiceWizardStep.Confirm;
                var confirmMsg = new ChatMessage
                {
                    Name = "Trợ lý ERP",
                    Role = "bot",
                    Time = DateTime.Now,
                    Text = $"✅ **Xác nhận thông tin phiếu thu:**\n\n" +
                           $"👤 Khách hàng: **{(string.IsNullOrEmpty(d.TenKh) ? d.MaKh : d.TenKh + " (" + d.MaKh + ")")}**\n" +
                           $"💰 Số tiền: **{d.SoTien:N0} VND**\n" +
                           $"🏦 TK nợ: **{d.TkNo}** | TK có: **{d.TkCo}**\n" +
                           $"📝 Diễn giải: {d.DienGiai}\n" +
                           $"📅 Ngày: {d.NgayCt:dd/MM/yyyy}\n\n" +
                           "Nhấn **Xác nhận tạo** để lưu phiếu, **Sửa thông tin** để chỉnh sửa, hoặc **Hủy** để bỏ.",
                    VoucherData = d,
                    IsEditing = false
                };
                messages.Add(confirmMsg);
                _wizard = null;
                StateHasChanged();
                await SaveChatHistory();
                await ScrollBottom();
                break;
            }
        }
        StateHasChanged();
    }

    private static string NormalizeVoiceInput(string transcript)
    {
        if (string.IsNullOrWhiteSpace(transcript)) return transcript;

        var norm = RemoveDiacritics(transcript).ToLowerInvariant().Trim();

        bool isCreate = norm.Contains("tao") && (norm.Contains("phieu") || norm.Contains("thu"));
        if (!isCreate) return transcript;

        string khValue = null;
        var khMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:khach hang|khach|cho khach)\s+(.+?)\s+(?:so tien|tien|tk|tai khoan|$)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (khMatch.Success)
            khValue = khMatch.Groups[1].Value.Trim();

        decimal soTien = 0;
        var tienMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:so tien|tien)\s+(.+?)(?=\s+(?:tk|tai khoan|dien giai|don vi|quyen|$))|([\d,\.]+(?:\s*(?:trieu|nghin|ngàn|ngan|ty|ti))(?:\s*(?:ruoi|hon))?(?:\s*[\d,\.]+(?:\s*(?:nghin|ngan))?)?)(?=\s|$)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (tienMatch.Success)
        {
            string rawAmount = tienMatch.Groups[1].Success && !string.IsNullOrWhiteSpace(tienMatch.Groups[1].Value)
                ? tienMatch.Groups[1].Value.Trim()
                : tienMatch.Groups[2].Value.Trim();
            soTien = ParseSpokenAmount(rawAmount);
        }

        string tkCo = null;
        var tkCoMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:tk co|tai khoan co|tk c[o0])\s+([\d]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (tkCoMatch.Success)
            tkCo = tkCoMatch.Groups[1].Value.Trim();

        string tkNo = null;
        var tkNoMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:tk no|tai khoan no)\s+([\d]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (tkNoMatch.Success)
            tkNo = tkNoMatch.Groups[1].Value.Trim();

        string dienGiai = null;
        var dgMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:dien giai|noi dung)\s+(.+?)(?=\s+(?:tk|tai khoan|don vi|quyen|$))",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (dgMatch.Success)
            dienGiai = dgMatch.Groups[1].Value.Trim();

        string dvcs = null;
        var dvcsMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:don vi|dvcs)\s+([A-Za-z0-9]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (dvcsMatch.Success)
            dvcs = dvcsMatch.Groups[1].Value.Trim().ToUpper();

        string maQs = null;
        var qsMatch = System.Text.RegularExpressions.Regex.Match(
            norm,
            @"(?:quyen so|quyen|qs)\s+([A-Za-z0-9]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (qsMatch.Success)
            maQs = qsMatch.Groups[1].Value.Trim().ToUpper();

        if (khValue == null && soTien == 0 && tkCo == null)
            return transcript;

        var sb = new System.Text.StringBuilder("Tạo phiếu thu: ");
        if (khValue != null)
            sb.Append($"Khách {khValue}, ");
        if (soTien > 0)
            sb.Append($"Tiền {soTien:0}, ");
        if (tkCo != null)
            sb.Append($"TK có {tkCo}, ");
        if (tkNo != null)
            sb.Append($"TK nợ {tkNo}, ");
        if (dienGiai != null)
            sb.Append($"Diễn giải {dienGiai}, ");
        if (dvcs != null)
            sb.Append($"Đơn vị {dvcs}, ");
        if (maQs != null)
            sb.Append($"Quyển {maQs}, ");

        return sb.ToString().TrimEnd().TrimEnd(',');
    }

    private static decimal ParseSpokenAmount(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return 0;
        var s = RemoveDiacritics(raw).ToLowerInvariant().Trim();

        decimal result = 0;
        decimal multiplier = 1;

        if (s.Contains("ty") || s.Contains("ti"))          multiplier = 1_000_000_000m;
        else if (s.Contains("trieu"))                        multiplier = 1_000_000m;
        else if (s.Contains("nghin") || s.Contains("ngan") || s.EndsWith("k")) multiplier = 1_000m;

        s = System.Text.RegularExpressions.Regex.Replace(s, @"(ty|ti|trieu|nghin|ngan|dong|k\b)", " ").Trim();

        bool hasRuoi = s.Contains("ruoi");
        s = s.Replace("ruoi", "").Trim();

        var numMatch = System.Text.RegularExpressions.Regex.Match(s, @"([\d][\d\s,\.]*)");
        if (numMatch.Success)
        {
            var numStr = numMatch.Value.Replace(" ", "").Replace(",", ".");
            numStr = numStr.TrimEnd('.');
            if (decimal.TryParse(numStr, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out decimal num))
                result = num;
        }

        if (hasRuoi) result += 0.5m;
        if (multiplier > 1) result *= multiplier;

        if (multiplier == 1 && result > 0) return result;

        return result;
    }

    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrEmpty(text)) return text;
        var normalized = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(normalized.Length);
        foreach (var c in normalized)
        {
            var cat = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (cat != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString()
                 .Normalize(System.Text.NormalizationForm.FormC)
                 .Replace('đ', 'd').Replace('Đ', 'D');
    }

    private static string ExtractAfterKeyword(string original, string normalizedKeyword)
    {
        if (string.IsNullOrEmpty(original)) return string.Empty;

        var normOrig = RemoveDiacritics(original).ToLowerInvariant();
        int kwIdx = normOrig.IndexOf(normalizedKeyword, StringComparison.Ordinal);
        if (kwIdx < 0) return string.Empty;

        int afterIdx = kwIdx + normalizedKeyword.Length;
        if (afterIdx >= normOrig.Length) return string.Empty;

        return normOrig.Substring(afterIdx).TrimStart().TrimStart(':').Trim();
    }

    private async Task<VoucherCreateData> ParseVoucherInputAsync(string input)
    {
        var data = new VoucherCreateData();

        var normInput = RemoveDiacritics(input).ToLowerInvariant();

        var segments    = input.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
        var normSegs    = normInput.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

        string khSegment   = null;
        string tienSegment = null;
        string tkCoSegment = null;
        string tkNoSegment = null;
        string dgSegment   = null;
        string dvcsSegment = null;
        string qsSegment   = null;

        for (int i = 0; i < segments.Length; i++)
        {
            var ns = i < normSegs.Length ? normSegs[i].Trim() : RemoveDiacritics(segments[i]).ToLowerInvariant().Trim();

            if (ns.Contains("khach") || System.Text.RegularExpressions.Regex.IsMatch(ns, @"\bkh\b"))
                khSegment = segments[i];
            else if (ns.Contains("tien"))
                tienSegment = segments[i];
            else if (ns.Contains("tk") && ns.Contains("co"))
                tkCoSegment = segments[i];
            else if (ns.Contains("tk") && ns.Contains("no"))
                tkNoSegment = segments[i];
            else if (ns.Contains("dien giai") || ns.Contains("note"))
                dgSegment = segments[i];
            else if (ns.Contains("dvcs") || ns.Contains("don vi"))
                dvcsSegment = segments[i];
            else if (ns.Contains("quyen") || ns.Contains("qs"))
                qsSegment = segments[i];
        }

        if (khSegment != null)
        {
            // ExtractAfterKeyword returns normalized (no-diacritic, lowercase) value
            string normKhValue = ExtractAfterKeyword(khSegment, "khach hang");
            if (string.IsNullOrWhiteSpace(normKhValue))
                normKhValue = ExtractAfterKeyword(khSegment, "khach");
            if (string.IsNullOrWhiteSpace(normKhValue))
                normKhValue = ExtractAfterKeyword(khSegment, "kh");

            if (!string.IsNullOrWhiteSpace(normKhValue))
            {
                normKhValue = normKhValue.Trim();
                bool looksLikeCode = normKhValue.Length <= 15 && !normKhValue.Contains(" ");
                if (looksLikeCode)
                {
                    data.MaKh = normKhValue.ToUpper();
                }
                else
                {
                    // For name search use the normalized value (no diacritics) - DB LIKE search handles it
                    var customers = await SearchCustomerByName(normKhValue);
                    if (customers.Count == 1)
                    {
                        data.MaKh   = customers[0].MaKh;
                        data.TenKh  = customers[0].TenKh;
                        data.DiaChi = customers[0].DiaChi;
                        data.OngBa  = customers[0].OngBa;
                    }
                    else if (customers.Count > 1)
                    {
                        data.MaKh  = "MULTIPLE_FOUND";
                        data.TenKh = $"Tìm thấy {customers.Count} khách hàng:\n" +
                                     string.Join("\n", customers.Select((c, i2) => $"{i2 + 1}. {c.MaKh} - {c.TenKh}"));
                    }
                    else
                    {
                        data.MaKh  = "NOT_FOUND";
                        data.TenKh = $"Không tìm thấy khách hàng: '{normKhValue}'";
                    }
                }
            }
        }

        if (tienSegment != null)
        {
            var numMatch = System.Text.RegularExpressions.Regex.Match(tienSegment, @"([0-9][0-9\.,]*)");
            if (numMatch.Success)
            {
                var tienStr = numMatch.Groups[1].Value.Replace(",", "").Replace(".", "");
                if (decimal.TryParse(tienStr, out decimal tempTien))
                    data.SoTien = tempTien;
            }
        }

        if (tkCoSegment != null)
        {
            var numMatch = System.Text.RegularExpressions.Regex.Match(tkCoSegment, @"([0-9]+)");
            if (numMatch.Success)
                data.TkCo = numMatch.Groups[1].Value.Trim();
        }

        if (tkNoSegment != null)
        {
            var numMatch = System.Text.RegularExpressions.Regex.Match(tkNoSegment, @"([0-9]+)");
            if (numMatch.Success)
                data.TkNo = numMatch.Groups[1].Value.Trim();
        }
        if (string.IsNullOrEmpty(data.TkNo))
            data.TkNo = "111";

        if (dgSegment != null)
        {
            string dgValue = ExtractAfterKeyword(dgSegment, "dien giai");
            if (string.IsNullOrEmpty(dgValue))
                dgValue = ExtractAfterKeyword(dgSegment, "note");
            data.DienGiai = string.IsNullOrEmpty(dgValue) ? dgSegment.Trim() : dgValue;
        }
        if (string.IsNullOrEmpty(data.DienGiai))
            data.DienGiai = $"Thu tiền khách hàng {data.MaKh}";

        if (qsSegment != null)
        {
            var alphaMatch = System.Text.RegularExpressions.Regex.Match(qsSegment, @"([A-Za-z0-9]+)\s*$");
            if (alphaMatch.Success)
                data.MaQs = alphaMatch.Groups[1].Value.Trim().ToUpper();
        }

        if (dvcsSegment != null)
        {
            var alphaMatch = System.Text.RegularExpressions.Regex.Match(dvcsSegment, @"([A-Za-z0-9]+)\s*$");
            if (alphaMatch.Success)
                data.MaDvcs = alphaMatch.Groups[1].Value.Trim().ToUpper();
        }
        if (string.IsNullOrEmpty(data.MaDvcs))
            data.MaDvcs = await GetCurrentMaDvcs();

        data.NgayCt = DateTime.Now.Date;
        return data;
    }

    private async Task<(bool IsValid, string Message, string TenKh, string DiaChi, string OngBa)> ValidateCustomer(string maKh)
    {
        try
        {
            var sql = $"SELECT ma_kh, ten_kh, dia_chi, doi_tac FROM dmkh WHERE ma_kh = '{maKh}'";
            var ds = await myDb.LoadDataset(sql);
            
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                var row = ds.Tables[0].Rows[0];
                var tenKh  = row["ten_kh"]?.ToString() ?? "";
                var diaChi = row["dia_chi"]?.ToString() ?? "";
                var ongBa  = row["doi_tac"]?.ToString() ?? "";
                return (true, "", tenKh, diaChi, ongBa);
            }
            
            return (false, $"Không tìm thấy khách hàng có mã '{maKh}'", "", "", "");
        }
        catch (Exception ex)
        {
            return (false, $"Lỗi kiểm tra khách hàng: {ex.Message}", "", "", "");
        }
    }

    private async Task<List<(string MaKh, string TenKh, string DiaChi, string OngBa)>> SearchCustomerByName(string tenKh)
    {
        try
        {
            var result = new List<(string, string, string, string)>();
            var safeVal = tenKh.Replace("'", "''");
            var sql = $@"SELECT TOP 5 ma_kh, ten_kh, dia_chi, doi_tac
                        FROM dmkh
                        WHERE ten_kh  LIKE N'%{safeVal}%'
                           OR ten_kh2 LIKE N'%{safeVal}%'
                           OR ma_kh   LIKE N'%{safeVal}%'
                        ORDER BY ma_kh";
            var ds = await myDb.LoadDataset(sql);
            
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    result.Add((
                        row["ma_kh"]?.ToString() ?? "",
                        row["ten_kh"]?.ToString() ?? "",
                        row["dia_chi"]?.ToString() ?? "",
                        row["doi_tac"]?.ToString() ?? ""
                    ));
                }
            }
            
            return result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SearchCustomerByName error: {ex.Message}");
            return new List<(string, string, string, string)>();
        }
    }

    private async Task<(bool IsValid, string Message, string TenTk)> ValidateAccount(string tk)
    {
        try
        {
            var sql = $"SELECT tk, ten_tk FROM dmtk WHERE tk = '{tk}'";
            var ds = await myDb.LoadDataset(sql);
            
            if (ds == null || ds.Tables[0].Rows.Count == 0)
