    private async Task ToggleVoiceInput()
    {
        // If already listening → stop current session and exit voice mode
        if (isListening)
        {
            try { await Js.InvokeVoidAsync("SisAiVoice.stop"); } catch { }
            isListening = false;
            _voiceMode = false;
            StateHasChanged();
            return;
        }

        // If voice mode active but not currently listening → restart
        // If not in voice mode → enter voice mode
        bool isDefined = await Js.InvokeAsync<bool>("eval", "typeof window.SisAiVoice !== 'undefined'");
        if (!isDefined)
        {
            AddBot("⚠️ Không thể khởi tạo tính năng giọng nói. Vui lòng tải lại trang và thử lại.");
            return;
        }

        bool supported = await Js.InvokeAsync<bool>("SisAiVoice.isSupported");
        if (!supported)
        {
            AddBot("⚠️ Trình duyệt của bạn không hỗ trợ nhập liệu bằng giọng nói.\n\nVui lòng dùng **Chrome** hoặc **Edge** để sử dụng tính năng này.");
            return;
        }
        _voiceMode = true;
        isListening = true;
        StateHasChanged();
        await Js.InvokeVoidAsync("SisAiVoice.start", DotNetObjectReference.Create(this));
    }

    private async Task StopVoiceMode()
    {
        if (isListening)
        {
            try { await Js.InvokeVoidAsync("SisAiVoice.stop"); } catch { }
            isListening = false;
        }
        _voiceMode = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async void OnVoiceResult(string transcript)
    {
        if (_isProcessingVoice) return;
        _isProcessingVoice = true;
        isListening = false;
        StateHasChanged();
        try
        {            
            if (_wizard != null)
            {
                var fixed1w = FixPhoneticMisrecognition(transcript);
                var fixed2w = CollapseSpacedDigits(fixed1w);
                userInput   = ConvertVietnameseWordsToDigits(fixed2w);
                StateHasChanged();
                await Task.Delay(300);
                await Send();
                return;
            }            
            var fixed1 = FixPhoneticMisrecognition(transcript);
            var fixed2 = CollapseSpacedDigits(fixed1);
            var converted = ConvertVietnameseWordsToDigits(fixed2);
            userInput = NormalizeVoiceInput(converted);
            StateHasChanged();
            await Task.Delay(300);
            await Send();
        }
        finally
        {
            isListening = false;
            _voiceMode = false;
            _isProcessingVoice = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnVoiceError(string error)
    {
        // Ignore if we are processing a voice result
        if (_isProcessingVoice) return;

        isListening = false;
        StateHasChanged();

        if (!_voiceMode) return;

        // Retryable: browser timeout while waiting for speech
        // Hard errors: stop voice mode entirely
        bool retryable = error == "no-speech" || error == "ended" || error == "network";
        if (!retryable)
        {
            _voiceMode = false;
            StateHasChanged();
            return;
        }

        // Restart mic to keep waiting
        await Task.Delay(200);
        if (!_voiceMode || _isProcessingVoice) return;
        try
        {
            isListening = true;
            StateHasChanged();
            await Js.InvokeVoidAsync("SisAiVoice.start", DotNetObjectReference.Create(this));
        }
        catch
        {
            isListening = false;
            _voiceMode = false;
            StateHasChanged();
        }
    }

