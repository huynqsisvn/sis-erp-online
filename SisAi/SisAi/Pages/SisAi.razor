            input.Contains("tinh nang") || input.Contains("chuc nang") ||
            input.Contains("ho tro gi") || input.Contains("gioi thieu") ||
            input.Contains("ban la gi") || input.Contains("ban la ai") ||
            input.Contains("tro ly") && (input.Contains("gi") || input.Contains("nao") || input.Contains("co")) ||
            input.Contains("huong dan") && !input.Contains("phieu") ||
            input.Contains("help") || input.Contains("menu"))
        {
            AddBot("🤖 **Trợ lý SIS ERP** — Tôi có thể giúp bạn những việc sau:\n\n" +
