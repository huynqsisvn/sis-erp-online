            var tenTk = ds.Tables[0].Rows[0]["ten_tk"].ToString();
            return (true, "", tenTk);
        }
        catch (Exception ex)
        {
            return (false, $"Lỗi kiểm tra tài khoản: {ex.Message}", "");
