                   "• Tìm theo **mã số thuế**: *'Tìm khách mst 0123456789'*\n" +
                   "• Tìm theo **số điện thoại**: *'Tìm khách sdt 0909123456'*\n" +
                   "• Tìm theo **địa chỉ**: *'Tìm khách địa chỉ Hà Nội'*\n\n" +
                   "━━━━━━━━━━━━━━━━━━━━\n" +
                   "🎤 **GIỌNG NÓI**\n" +
                   "• Nhấn 🎤 để nhập lệnh bằng giọng nói (Chrome/Edge)\n" +
                   "• Hỗ trợ nhận dạng số tiếng Việt: *hai triệu*, *500 nghìn*\n" +
                   "• Chế độ voice liên tục: giữ 🎤 hoạt động sau mỗi lệnh\n\n" +
                   "━━━━━━━━━━━━━━━━━━━━\n" +
                   "💡 **MẸO SỬ DỤNG**\n" +
                   "• Gõ *'hướng dẫn'* hoặc *'help'* để xem lại menu này\n" +
                   "• Gõ *'lọc phiếu'* để xem cách lọc danh sách\n" +
                   "• Gõ *'in phiếu'* để xem hướng dẫn in");
            return;
        }

        if (input.Contains("mo") && input.Contains("phieu thu"))
        {
            NavigateToVoucher();
            AddBot("Đang mở màn hình Phiếu thu. Nếu không tự mở, hãy bấm nút **Mở phiếu thu**.");
            return;
        }

        if ((input.Contains("tim") || input.Contains("xem") || input.Contains("tra cuu")) &&
            (input.Contains("khach") || input.Contains("kh")))
        {
            ProcessSearchCustomer(originalInput);
            return;
        }

        if ((input.Contains("phieu")) &&
            (input.Contains("cua") || input.Contains("khach")) &&
            !input.Contains("tao") && !input.Contains("them"))
        {
            ProcessSearchVoucherByCustomer(originalInput);
            return;
        }

        if ((input.Contains("tim") || input.Contains("xem") || input.Contains("tra cuu")) && 
            (input.Contains("phieu") || input.Contains("so")))
        {
            ProcessSearchVoucher(originalInput);
            return;
        }

        if (input.Contains("tao") || input.Contains("them"))
        {
            if (input.Contains("import") || input.Contains("nhieu") || input.Contains("hang loat"))
            {
                AddBot("🔄 **Tạo hàng loạt phiếu thu:**\n\n**Cách 1: Import từ Excel/CSV**\n• Chuẩn bị file Excel với các cột:\n  - Mã khách hàng, Số chứng từ, Ngày chứng từ\n  - Tài khoản nợ, Tài khoản có\n  - Số tiền, Diễn giải, Quyển sổ\n• Import dữ liệu vào hệ thống\n• Hệ thống sẽ tự động xử lý và tạo phiếu thu\n\n**Cách 2: Tạo nhanh qua AI (đang phát triển)**\n• Nhập nhiều dòng theo format:\n  'KH001|1000000|131|Thu tiền'\n  'KH002|2000000|131|Thu tiền'");
                return;
            }
            
            // Match both comma-delimited typed input AND free-form voice input
            if (input.Contains("khach") || input.Contains("tien") || input.Contains("tk")
                || input.Contains("tai khoan") || input.Contains("so tien"))
            {
                ProcessCreateVoucher(originalInput);
                return;
            }

            // Plain "tạo phiếu thu" with no parameters → start step-by-step wizard
            StartVoiceWizard();
            return;
        }

        if (input.Contains("sua") || input.Contains("edit"))
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(input, @"\d+"))
            {
                ProcessEditVoucher(originalInput);
                return;
            }
            
            AddBot("**Sửa phiếu thu:**\n\n**Cách 1: Sửa theo số chứng từ**\n• Gõ: 'Sửa phiếu PT001'\n• Gõ: 'Sửa số 00001'\n\n**Cách 2: Sửa thủ công**\n1) Mở danh sách Phiếu thu\n2) Chọn phiếu cần sửa → nhấn **Sửa**\n3) Chỉnh thông tin cần thiết\n4) Nhấn **Ghi sổ**\n\n⚠️ **Lưu ý:** Phiếu đã khóa sổ sẽ không sửa được.");
            return;
        }

        if (input.Contains("xoa") || input.Contains("delete") || input.Contains("huy"))
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(input, @"\d+"))
            {
                ProcessDeleteVoucher(originalInput);
                return;
            }
            
            AddBot("**Xóa phiếu thu:**\n\n**Cách 1: Xóa theo số chứng từ**\n• Gõ: 'Xóa phiếu PT001'\n• Gõ: 'Xóa số 00001'\n\n**Cách 2: Xóa thủ công**\n1) Mở danh sách Phiếu thu\n2) Chọn phiếu cần xóa\n3) Nhấn **Xóa** và xác nhận\n\n⚠️ **Lưu ý:**\n• Phiếu đã ghi sổ (status = 2) không thể xóa\n• Phải hủy ghi sổ trước khi xóa\n• Hãy cẩn thận khi xóa dữ liệu!");
            return;
        }

        if (input.Contains("loc") || input.Contains("filter"))
        {
            AddBot("Lọc danh sách phiếu thu:\n- Bộ lọc: Quyển số, Số chứng từ, Ngày chứng từ từ/đến, Tài khoản, Khách hàng, Trạng thái.\n- Vào popup **Filter** trong danh sách phiếu thu để áp dụng.");
            return;
        }

        if (input.Contains("in") || input.Contains("print"))
        {
            AddBot("In phiếu thu:\n1) Mở phiếu thu cần in.\n2) Nhấn **In** trên thanh chức năng.\n3) Chọn mẫu in (nếu có) và xuất PDF/Excel.\n4) Đảm bảo phiếu đã ghi sổ để số chứng từ ổn định.");
            return;
        }

        if (input.Contains("store") || input.Contains("procedure") || input.Contains("sp"))
        {
            AddBot("📚 **Quy trình tạo hàng loạt phiếu thu:**\n\n**Các bước thực hiện:**\n1. Chuẩn bị dữ liệu import\n2. Hệ thống kiểm tra và điều chỉnh dữ liệu\n3. Validate thông tin (khách hàng, tài khoản, số tiền)\n4. Tạo và ghi sổ các phiếu thu\n\n**Lưu ý:**\n• Dữ liệu phải đầy đủ và hợp lệ\n• Hệ thống sẽ báo lỗi nếu có vấn đề\n• Có thể chọn ghi đè hoặc bỏ qua phiếu trùng");
            return;
        }

        AddBot("Tôi chưa hiểu yêu cầu. Bạn có thể thử:\n\n**Tìm kiếm:**\n• 'Tìm phiếu PT001'\n• 'Xem số 00001'\n\n**Tìm phiếu theo khách hàng:**\n• 'Phiếu của KH001'\n• 'Phiếu của Nguyễn Văn A'\n• 'Phiếu KH001 tháng 6'\n• 'Phiếu KH001 từ 01/06 đến 30/06'\n\n**Tìm khách hàng:**\n• 'Tìm khách KH001'\n• 'Tìm khách Nguyễn Văn A'\n• 'Tìm khách mst 0123456789'\n• 'Tìm khách sdt 0909123456'\n\n**Thao tác:**\n• 'Tạo phiếu thu: Khách KH001, Tiền 1000000, TK có 131'\n• 'Sửa phiếu PT001'\n• 'Xóa phiếu PT001'\n\n**Khác:**\n• 'Mở phiếu thu'\n• 'Lọc phiếu'\n• 'In phiếu'");
    }

