    private async Task<string> GetCurrentMaDvcs()
    {
        try
        {
            var dvcs = myStateMN?.GetDvcs()?.Ma_dvcs?.Trim();
            if (!string.IsNullOrEmpty(dvcs) && !dvcs.Equals("ALL", StringComparison.OrdinalIgnoreCase))
            {
                return dvcs;
            }

            var sql = "SELECT TOP 1 ma_dvcs FROM dmdvcs WHERE ma_dvcs <> 'ALL' ORDER BY ma_dvcs";
            var ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                return ds.Tables[0].Rows[0]["ma_dvcs"].ToString().Trim();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"GetCurrentMaDvcs error: {ex.Message}");
        }

        return null;
    }

    private async void ProcessCreateVoucher(string input)
    {
        try
        {
            var voucherData = await ParseVoucherInputAsync(input);
            if (voucherData.MaKh == "MULTIPLE_FOUND")
            {
                AddBot($"🔍 **Tìm thấy nhiều khách hàng:**\n\n{voucherData.TenKh}\n\n💡 **Vui lòng:**\n• Nhập lại với mã khách hàng cụ thể\n• Ví dụ: 'Tạo phiếu thu: Khách KH001, Tiền 1000000, TK có 131'");
                return;
            }
            
            if (voucherData.MaKh == "NOT_FOUND")
            {
                AddBot($"❌ {voucherData.TenKh}\n\n💡 **Gợi ý:**\n• Kiểm tra lại tên hoặc mã khách hàng\n• Thử tìm với từ khóa ngắn gọn hơn\n• Hoặc sử dụng mã khách hàng trực tiếp");
                return;
            }
            
            if (string.IsNullOrEmpty(voucherData.MaKh))
            {
                AddBot("⚠️ Thiếu **Mã khách hàng**. Vui lòng nhập theo cú pháp:\n'Tạo phiếu thu: Khách KH001, Tiền 1000000, TK có 131'\n\nHoặc nhập tên khách hàng:\n'Tạo phiếu thu: Khách Nguyễn Văn A, Tiền 1000000, TK có 131'");
                return;
            }
            
            if (voucherData.SoTien <= 0)
            {
                AddBot("⚠️ Thiếu **Số tiền** hoặc số tiền không hợp lệ. Vui lòng nhập lại.");
                return;
            }
            
            if (string.IsNullOrEmpty(voucherData.TkCo))
            {
                AddBot("⚠️ Thiếu **Tài khoản có**. Vui lòng nhập TK có (VD: 131, 1111).");
                return;
            }

            if (string.IsNullOrEmpty(voucherData.MaDvcs) || voucherData.MaDvcs.Equals("ALL", StringComparison.OrdinalIgnoreCase))
            {
                var promptMsg = new ChatMessage
                {
                    Name = "Trợ lý ERP",
                    Role = "bot",
                    Time = DateTime.Now,
                    Text = $"⚠️ **Chưa có Mã đơn vị hoặc Mã đơn vị không hợp lệ.**\n\n" +
                           $"📋 **Thông tin hiện tại:**\n" +
                           $"• Khách hàng: {voucherData.MaKh}\n" +
                           $"• Số tiền: {voucherData.SoTien:N0} VND\n" +
                           $"• TK nợ: {voucherData.TkNo}\n" +
                           $"• TK có: {voucherData.TkCo}\n" +
                           $"• Diễn giải: {voucherData.DienGiai}\n\n" +
                           $"✏️ Vui lòng nhấn **Sửa thông tin** để nhập mã đơn vị và kiểm tra lại thông tin.",
                    VoucherData = voucherData,
                    IsEditing = false
                };
                messages.Add(promptMsg);
                StateHasChanged();
                await ScrollBottom();
                return;
            }

            var checkDvcs = await ValidateDvcs(voucherData.MaDvcs);
            if (!checkDvcs.IsValid)
            {
                AddBot($"❌ {checkDvcs.Message}");
                return;
            }

            var checkKh = await ValidateCustomer(voucherData.MaKh);
            if (!checkKh.IsValid)
            {
                AddBot($"❌ {checkKh.Message}\n\n💡 **Bạn có thể:**\n• Nhập lại mã khách hàng khác\n• Kiểm tra danh sách khách hàng trong hệ thống");
                return;
            }
            
            voucherData.DiaChi = checkKh.DiaChi;
            voucherData.OngBa = checkKh.OngBa;

            var checkTk = await ValidateAccount(voucherData.TkCo);
            if (!checkTk.IsValid)
            {
                AddBot($"❌ {checkTk.Message}\n\n💡 **Bạn có thể:**\n• Nhập lại TK có khác (VD: 131, 511, 711)\n• Kiểm tra danh mục tài khoản");
                return;
            }

            var checkTkNo = await ValidateDebitAccount(voucherData.TkNo);
            if (!checkTkNo.IsValid)
            {
                AddBot($"❌ {checkTkNo.Message}\n\n💡 **Bạn có thể:**\n• Nhập lại TK nợ (VD: 111, 1111, 1121)\n• Bỏ trống để dùng mặc định 111");
                return;
            }

            string wsId = myOption.GetOptionsValue("M_WS_ID") ?? "A";
            var sttRecSql = $"EXEC dbo.GetSttRec 'PT1', '{wsId}'";
            var dsSttRec = await myDb.LoadDataset(sttRecSql);
            
            if (dsSttRec != null && dsSttRec.Tables[0].Rows.Count > 0)
            {
                string sttRec = dsSttRec.Tables[0].Rows[0][0].ToString();
                voucherData.SttRec = sttRec;
            }

            var confirmMsg = new ChatMessage
            {
                Name = "Trợ lý ERP",
                Role = "bot",
                Time = DateTime.Now,
                Text = $"✅ **Xác nhận thông tin phiếu thu:**\n\n" +
                       $"📋 **Thông tin chung:**\n" +
                       $"• Đơn vị: **{voucherData.MaDvcs}** - {checkDvcs.TenDvcs}\n" +
                       $"• Khách hàng: **{checkKh.TenKh}** ({voucherData.MaKh})\n" +
                       (!string.IsNullOrEmpty(checkKh.OngBa) ? $"• Ông/Bà: {checkKh.OngBa}\n" : "") +
                       (!string.IsNullOrEmpty(checkKh.DiaChi) ? $"• Địa chỉ: {checkKh.DiaChi}\n" : "") +
                       $"• Số tiền: **{voucherData.SoTien:N0} VND**\n\n" +
                       $"💰 **Hạch toán:**\n" +
                       $"• TK nợ: **{voucherData.TkNo}** - {checkTkNo.TenTk}\n" +
                       $"• TK có: **{voucherData.TkCo}** - {checkTk.TenTk}\n" +
                       $"• Diễn giải: {voucherData.DienGiai}\n\n" +
                       $"📝 **Lưu ý:**\n" +
                       $"• Đã lưu thông tin tạm thời\n" +
                       $"• Nhấn **Xác nhận tạo** để hoàn tất phiếu thu\n" +
                       $"• Nhấn **Hủy** để hủy bỏ"
            };
            confirmMsg.VoucherData = voucherData;
            confirmMsg.VoucherData.TenKh = checkKh.TenKh;
            confirmMsg.VoucherData.TenDvcs = checkDvcs.TenDvcs;
            confirmMsg.VoucherData.TenTkNo = checkTkNo.TenTk;
            confirmMsg.VoucherData.TenTkCo = checkTk.TenTk;
            messages.Add(confirmMsg);
            StateHasChanged();
            await ScrollBottom();
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi: {ex.Message}");
        }
    }

    private async void ProcessSearchCustomer(string input)
    {
        try
        {
            var keyword = System.Text.RegularExpressions.Regex.Replace(
                input,
                @"(tìm|tim|xem|tra cứu|tra cuu|khách|khach|\bkh\b)",
                " ",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
            keyword = System.Text.RegularExpressions.Regex.Replace(keyword, @"\s+", " ").Trim();

            if (string.IsNullOrWhiteSpace(keyword))
            {
                AddBot("⚠️ **Vui lòng nhập từ khóa tìm kiếm khách hàng.**\n\n💡 **Ví dụ:**\n• 'Tìm khách KH001'\n• 'Tìm khách Nguyễn Văn A'\n• 'Tìm khách mst 0123456789'\n• 'Tìm khách sdt 0909123456'\n• 'Tìm khách địa chỉ Hà Nội'");
                return;
            }

            string searchField = "all";
            string searchValue = keyword;

            var mstMatch = System.Text.RegularExpressions.Regex.Match(keyword, @"(?:mst|ma so thue|mã số thuế)\s+([\w\-]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            var sdtMatch = System.Text.RegularExpressions.Regex.Match(keyword, @"(?:sdt|điện thoại|dien thoai|phone|tel)\s+([\d\s\-\.]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            var diaChiMatch = System.Text.RegularExpressions.Regex.Match(keyword, @"(?:địa chỉ|dia chi|address)\s+(.+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            if (mstMatch.Success)
            {
                searchField = "ma_so_thue";
                searchValue = mstMatch.Groups[1].Value.Trim();
            }
            else if (sdtMatch.Success)
            {
                searchField = "dien_thoai";
                searchValue = sdtMatch.Groups[1].Value.Trim().Replace(" ", "");
            }
            else if (diaChiMatch.Success)
            {
                searchField = "dia_chi";
                searchValue = diaChiMatch.Groups[1].Value.Trim();
            }

            string whereClause;
            string safeValue = searchValue.Replace("'", "''");

            if (searchField == "ma_so_thue")
            {
                whereClause = $"ma_so_thue LIKE N'%{safeValue}%'";
            }
            else if (searchField == "dien_thoai")
            {
                whereClause = $"dien_thoai LIKE N'%{safeValue}%'";
            }
            else if (searchField == "dia_chi")
            {
                whereClause = $"dia_chi LIKE N'%{safeValue}%'";
            }
            else
            {
                whereClause = $@"(
                    ma_kh LIKE N'%{safeValue}%'
                    OR ten_kh LIKE N'%{safeValue}%'
                    OR ten_kh2 LIKE N'%{safeValue}%'
                    OR ten_kh3 LIKE N'%{safeValue}%'
                    OR dia_chi LIKE N'%{safeValue}%'
                    OR ma_so_thue LIKE N'%{safeValue}%'
                    OR dien_thoai LIKE N'%{safeValue}%'
                    OR ong_ba LIKE N'%{safeValue}%'
                    OR doi_tac LIKE N'%{safeValue}%'
                )";
            }

            var sql = $@"
                SELECT TOP 10
                    ma_kh, ten_kh, ten_kh2, ten_kh3, dia_chi, ma_so_thue,
                    dien_thoai, fax, e_mail, ong_ba, doi_tac,
                    ten_nh, ghi_chu, tinh_thanh
                FROM dmkh
                WHERE {whereClause}
                ORDER BY ma_kh";

            var ds = await myDb.LoadDataset(sql);

            if (ds == null || ds.Tables[0].Rows.Count == 0)
            {
                AddBot($"❌ **Không tìm thấy khách hàng với từ khóa: '{searchValue}'**\n\n💡 **Gợi ý:**\n• Thử tìm với từ khóa ngắn hơn\n• Kiểm tra chính tả\n• Tìm theo mã: 'Tìm khách KH001'\n• Tìm theo MST: 'Tìm khách mst 0123456789'");
                return;
            }

            int total = ds.Tables[0].Rows.Count;
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"🔍 **Tìm thấy {total} khách hàng{(total == 10 ? " (hiển thị tối đa 10)" : "")}:**");

            foreach (DataRow row in ds.Tables[0].Rows)
            {
                string maKh      = row["ma_kh"]?.ToString()?.Trim() ?? "";
                string tenKh     = row["ten_kh"]?.ToString()?.Trim() ?? "";
                string tenKh2    = row["ten_kh2"]?.ToString()?.Trim() ?? "";
                string tenKh3    = row["ten_kh3"]?.ToString()?.Trim() ?? "";
                string diaChi    = row["dia_chi"]?.ToString()?.Trim() ?? "";
                string maSoThue  = row["ma_so_thue"]?.ToString()?.Trim() ?? "";
                string dienThoai = row["dien_thoai"]?.ToString()?.Trim() ?? "";
                string fax       = row["fax"]?.ToString()?.Trim() ?? "";
                string eMail     = row["e_mail"]?.ToString()?.Trim() ?? "";
                string ongBa     = row["ong_ba"]?.ToString()?.Trim() ?? "";
                string doiTac    = row["doi_tac"]?.ToString()?.Trim() ?? "";
                string tenNh     = row["ten_nh"]?.ToString()?.Trim() ?? "";
                string tinhThanh = row["tinh_thanh"]?.ToString()?.Trim() ?? "";
                string ghiChu    = row["ghi_chu"]?.ToString()?.Trim() ?? "";

                sb.AppendLine();
                sb.AppendLine($"👤 **{maKh}** - {tenKh}");
                if (!string.IsNullOrEmpty(tenKh2))
                    sb.AppendLine($"  • Tên KH2: {tenKh2}");
                if (!string.IsNullOrEmpty(tenKh3))
                    sb.AppendLine($"  • Tên KH3: {tenKh3}");
                if (!string.IsNullOrEmpty(ongBa))
                    sb.AppendLine($"  • Ông/Bà: {ongBa}");
                if (!string.IsNullOrEmpty(doiTac))
                    sb.AppendLine($"  • Đối tác: {doiTac}");
                if (!string.IsNullOrEmpty(diaChi))
                    sb.AppendLine($"  • Địa chỉ: {diaChi}{(!string.IsNullOrEmpty(tinhThanh) ? " - " + tinhThanh : "")}");
                if (!string.IsNullOrEmpty(maSoThue))
                    sb.AppendLine($"  • Mã số thuế: {maSoThue}");
                if (!string.IsNullOrEmpty(dienThoai))
                    sb.AppendLine($"  • Điện thoại: {dienThoai}");
                if (!string.IsNullOrEmpty(fax))
                    sb.AppendLine($"  • Fax: {fax}");
                if (!string.IsNullOrEmpty(eMail))
                    sb.AppendLine($"  • Email: {eMail}");
                if (!string.IsNullOrEmpty(tenNh))
                    sb.AppendLine($"  • Ngân hàng: {tenNh}");
                if (!string.IsNullOrEmpty(ghiChu))
                    sb.AppendLine($"  • Ghi chú: {ghiChu}");
            }

            sb.AppendLine();
            sb.AppendLine($"💡 **Tạo phiếu thu nhanh:**");
            sb.AppendLine($"• 'Tạo phiếu thu: Khách [mã KH], Tiền [số tiền], TK có 131'");

            AddBot(sb.ToString().TrimEnd());
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi khi tìm kiếm khách hàng: {ex.Message}");
        }
    }

    private async void ProcessSearchVoucherByCustomer(string input)
    {
        try
        {
            var khMatch = System.Text.RegularExpressions.Regex.Match(
                input,
                @"(?:phiếu|phieu)\s*(?:của|cua|khách|khach)?\s*:?\s*(.+?)(?=\s+tháng|\s+thang|\s+từ\s|\s+tu\s|$)",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            string khKeyword = khMatch.Success ? khMatch.Groups[1].Value.Trim() : string.Empty;
            khKeyword = System.Text.RegularExpressions.Regex.Replace(
                khKeyword, @"\b(của|cua|khách|khach)\b", "",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();

            if (string.IsNullOrWhiteSpace(khKeyword))
            {
                AddBot("⚠️ **Vui lòng nhập mã hoặc tên khách hàng.**\n\n💡 **Ví dụ:**\n• 'Phiếu của KH001'\n• 'Phiếu của Nguyễn Văn A'\n• 'Phiếu KH001 tháng 6'\n• 'Phiếu KH001 từ 01/06 đến 30/06'");
                return;
            }

            string maKhFilter;
            string tenKhDisplay;
            string safeKh = khKeyword.Replace("'", "''");

            if (khKeyword.Length <= 15 && !khKeyword.Contains(" "))
            {
                maKhFilter = $"ph.ma_kh = N'{safeKh}'";
                tenKhDisplay = khKeyword.ToUpper();
            }
            else
            {
                var sqlKh = $@"SELECT TOP 10 ma_kh, ten_kh FROM dmkh
                               WHERE ten_kh LIKE N'%{safeKh}%' OR ten_kh2 LIKE N'%{safeKh}%'
                               ORDER BY ma_kh";
                var dsKh = await myDb.LoadDataset(sqlKh);

                if (dsKh == null || dsKh.Tables[0].Rows.Count == 0)
                {
                    AddBot($"❌ **Không tìm thấy khách hàng: '{khKeyword}'**\n\n💡 Thử dùng mã KH trực tiếp hoặc kiểm tra lại tên.");
                    return;
                }

                var maKhList = dsKh.Tables[0].Rows
                    .Cast<DataRow>()
                    .Select(r => "'" + (r["ma_kh"]?.ToString()?.Replace("'", "''") ?? "") + "'")
                    .ToList();
                maKhFilter = $"ph.ma_kh IN ({string.Join(",", maKhList)})";
                tenKhDisplay = dsKh.Tables[0].Rows.Count == 1
                    ? $"{dsKh.Tables[0].Rows[0]["ma_kh"]} - {dsKh.Tables[0].Rows[0]["ten_kh"]}"
                    : $"{dsKh.Tables[0].Rows.Count} khách hàng khớp '{khKeyword}'";
            }

            DateTime? fromDate = null;
            DateTime? toDate   = null;

            var thangMatch = System.Text.RegularExpressions.Regex.Match(
                input, @"tháng\s+(\d{1,2})(?:\s+năm\s+(\d{4}))?",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (thangMatch.Success)
            {
                int month = int.Parse(thangMatch.Groups[1].Value);
                int year  = thangMatch.Groups[2].Success
                    ? int.Parse(thangMatch.Groups[2].Value)
                    : DateTime.Now.Year;
                if (month >= 1 && month <= 12)
                {
                    fromDate = new DateTime(year, month, 1);
                    toDate   = fromDate.Value.AddMonths(1).AddDays(-1);
                }
            }
            else
            {
                var rangeMatch = System.Text.RegularExpressions.Regex.Match(
                    input,
                    @"từ\s+(\d{1,2}[/\-]\d{1,2}(?:[/\-]\d{2,4})?)\s+đến\s+(\d{1,2}[/\-]\d{1,2}(?:[/\-]\d{2,4})?)",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (rangeMatch.Success)
                {
                    var formats = new[] { "d/M/yyyy", "d/M/yy", "d/M", "d-M-yyyy", "d-M" };
                    string fromStr = rangeMatch.Groups[1].Value;
                    string toStr   = rangeMatch.Groups[2].Value;

                    if (System.Text.RegularExpressions.Regex.IsMatch(fromStr, @"^\d{1,2}[/\-]\d{1,2}$"))
                        fromStr += "/" + DateTime.Now.Year;
                    if (System.Text.RegularExpressions.Regex.IsMatch(toStr, @"^\d{1,2}[/\-]\d{1,2}$"))
                        toStr += "/" + DateTime.Now.Year;

                    if (DateTime.TryParseExact(fromStr, formats,
                            System.Globalization.CultureInfo.InvariantCulture,
                            System.Globalization.DateTimeStyles.None, out DateTime fd))
                        fromDate = fd;
                    if (DateTime.TryParseExact(toStr, formats,
                            System.Globalization.CultureInfo.InvariantCulture,
                            System.Globalization.DateTimeStyles.None, out DateTime td))
                        toDate = td;
                }
            }

            string dateClause = string.Empty;
            if (fromDate.HasValue)
                dateClause += $" AND ph.ngay_ct >= '{fromDate.Value:yyyyMMdd}'";
            if (toDate.HasValue)
                dateClause += $" AND ph.ngay_ct <= '{toDate.Value:yyyyMMdd}'";

            var sql = $@"
                SELECT TOP 20
                    ph.so_ct, ph.ngay_ct, ph.ma_kh, kh.ten_kh,
                    ph.t_tien, ph.ma_nt, ph.dien_giai, ph.status,
                    ph.tk, ph.ma_dvcs
                FROM ph41 ph
                LEFT JOIN dmkh kh ON ph.ma_kh = kh.ma_kh
                WHERE ph.ma_ct = 'PT1'
                  AND {maKhFilter}
                  {dateClause}
                ORDER BY ph.ngay_ct DESC, ph.so_ct DESC";

            var ds = await myDb.LoadDataset(sql);

            if (ds == null || ds.Tables[0].Rows.Count == 0)
            {
                string dateInfo = fromDate.HasValue
                    ? $" trong khoảng {fromDate.Value:dd/MM/yyyy} – {(toDate.HasValue ? toDate.Value.ToString("dd/MM/yyyy") : "nay")}"
                    : string.Empty;
                AddBot($"❌ **Không tìm thấy phiếu thu nào của {tenKhDisplay}{dateInfo}.**\n\n💡 Thử bỏ bộ lọc ngày hoặc kiểm tra lại mã khách hàng.");
                return;
            }

            int total = ds.Tables[0].Rows.Count;
            decimal tongTien = 0;
            int soGhiSo = 0;
            var sb = new System.Text.StringBuilder();

            string dateRangeLabel = string.Empty;
            if (fromDate.HasValue || toDate.HasValue)
                dateRangeLabel = $" ({(fromDate.HasValue ? fromDate.Value.ToString("dd/MM/yyyy") : "...")}" +
                                 $" – {(toDate.HasValue ? toDate.Value.ToString("dd/MM/yyyy") : "nay")})";

            sb.AppendLine($"📋 **Phiếu thu của {tenKhDisplay}{dateRangeLabel}** – {total} phiếu{(total == 20 ? " (tối đa 20)" : "")}:");

            foreach (DataRow row in ds.Tables[0].Rows)
            {
                string soCt     = row["so_ct"]?.ToString()?.Trim() ?? "";
                DateTime ngayCt = row["ngay_ct"] != DBNull.Value ? Convert.ToDateTime(row["ngay_ct"]) : DateTime.MinValue;
                string maKhRow  = row["ma_kh"]?.ToString()?.Trim() ?? "";
                string tenKhRow = row["ten_kh"]?.ToString()?.Trim() ?? "";
                decimal tTien   = row["t_tien"] != DBNull.Value ? Convert.ToDecimal(row["t_tien"]) : 0;
                string maNt     = row["ma_nt"]?.ToString()?.Trim() ?? "VND";
                string dienGiai = row["dien_giai"]?.ToString()?.Trim() ?? "";
                string status   = row["status"]?.ToString()?.Trim() ?? "";
                string tk       = row["tk"]?.ToString()?.Trim() ?? "";
                string maDvcs   = row["ma_dvcs"]?.ToString()?.Trim() ?? "";

                string statusIcon = status == "2" ? "✅" : "⏳";
                tongTien += tTien;
                if (status == "2") soGhiSo++;

                sb.AppendLine();
                sb.AppendLine($"{statusIcon} **{soCt}** | {ngayCt:dd/MM/yyyy} | {tTien:N0} {maNt}");
                if (!string.IsNullOrEmpty(tenKhRow) && maKhList_IsMultiple(maKhFilter))
                    sb.AppendLine($"  👤 {maKhRow} - {tenKhRow}");
                if (!string.IsNullOrEmpty(tk))
                    sb.AppendLine($"  TK nợ: {tk} | Đơn vị: {maDvcs}");
                if (!string.IsNullOrEmpty(dienGiai))
                    sb.AppendLine($"  📝 {dienGiai}");
            }

            sb.AppendLine();
            sb.AppendLine($"━━━━━━━━━━━━━━━━━━━━");
            sb.AppendLine($"💰 **Tổng tiền: {tongTien:N0} VND**");
            sb.AppendLine($"✅ Đã ghi sổ: {soGhiSo}/{total} phiếu");
            sb.AppendLine();
            sb.AppendLine($"💡 Gõ 'Tìm phiếu [số CT]' để xem chi tiết từng phiếu.");

            AddBot(sb.ToString().TrimEnd());
        }
        catch (Exception ex)
        {
            AddBot($"❌ Lỗi khi tìm phiếu theo khách hàng: {ex.Message}");
        }

        static bool maKhList_IsMultiple(string filter) => filter.StartsWith("ph.ma_kh IN");
    }

    private async void ProcessSearchVoucher(string input)
    {
        try
        {
            var soctMatch = System.Text.RegularExpressions.Regex.Match(input, @"([A-Z0-9]+\d+|\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (!soctMatch.Success)
            {
                AddBot("⚠️ **Không tìm thấy số chứng từ.**\n\n💡 **Cú pháp:**\n• 'Tìm phiếu PT001'\n• 'Xem số 00001'\n• 'Tra cứu PT-001'");
                return;
            }

            string soCt = soctMatch.Groups[1].Value.Trim();
            var sql = $@"
                SELECT TOP 1 
                    ph.stt_rec, ph.so_ct, ph.ngay_ct, ph.ma_kh, ph.ma_dvcs, ph.dien_giai,
                    ph.t_tien, ph.t_tien_nt, ph.ma_nt, ph.status, ph.tk,
                    kh.ten_kh, kh.dia_chi, kh.doi_tac as ong_ba,
                    dv.ten_dvcs
                FROM ph41 ph
                LEFT JOIN dmkh kh ON ph.ma_kh = kh.ma_kh
                LEFT JOIN dmdvcs dv ON ph.ma_dvcs = dv.ma_dvcs
                WHERE ph.ma_ct = 'PT1' AND ph.so_ct LIKE '%{soCt}%'
                ORDER BY ph.ngay_ct DESC, ph.so_ct DESC";

            var ds = await myDb.LoadDataset(sql);
            
            if (ds == null || ds.Tables[0].Rows.Count == 0)
            {
                AddBot($"❌ **Không tìm thấy phiếu thu có số: {soCt}**\n\n💡 **Gợi ý:**\n• Kiểm tra lại số chứng từ\n• Thử tìm với số khác\n• Vào màn hình Phiếu thu để xem danh sách");
                return;
            }

            var row = ds.Tables[0].Rows[0];
            string sttRec = row["stt_rec"].ToString();
            string foundSoCt = row["so_ct"].ToString();
            DateTime ngayCt = Convert.ToDateTime(row["ngay_ct"]);
            string maKh = row["ma_kh"]?.ToString() ?? "";
            string tenKh = row["ten_kh"]?.ToString() ?? "";
            string maDvcs = row["ma_dvcs"]?.ToString() ?? "";
            string tenDvcs = row["ten_dvcs"]?.ToString() ?? "";
            string dienGiai = row["dien_giai"]?.ToString() ?? "";
            decimal tTien = row["t_tien"] != DBNull.Value ? Convert.ToDecimal(row["t_tien"]) : 0;
            string maNt = row["ma_nt"]?.ToString() ?? "VND";
            string status = row["status"]?.ToString() ?? "";
            string tk = row["tk"]?.ToString() ?? "";

            var sqlCt = $@"
                SELECT ct.tk_i, ct.ma_kh_i, ct.tien, ct.tien_nt, ct.dien_giaii,
                       dmtk.ten_tk
                FROM ct41 ct
                LEFT JOIN dmtk ON ct.tk_i = dmtk.tk
                WHERE ct.stt_rec = '{sttRec}'
                ORDER BY ct.stt_rec0";
            
            var dsCt = await myDb.LoadDataset(sqlCt);
            
            string ctInfo = "";
            if (dsCt != null && dsCt.Tables[0].Rows.Count > 0)
            {
                ctInfo = "\n\n💰 **Chi tiết hạch toán:**\n";
                foreach (DataRow ctRow in dsCt.Tables[0].Rows)
                {
                    string tkI = ctRow["tk_i"]?.ToString() ?? "";
                    string tenTk = ctRow["ten_tk"]?.ToString() ?? "";
                    decimal tien = ctRow["tien"] != DBNull.Value ? Convert.ToDecimal(ctRow["tien"]) : 0;
                    string dgCt = ctRow["dien_giaii"]?.ToString() ?? "";
                    
                    ctInfo += $"• TK có: **{tkI}** - {tenTk}\n";
                    ctInfo += $"  Số tiền: {tien:N0} {maNt}\n";
                    if (!string.IsNullOrEmpty(dgCt))
                        ctInfo += $"  Diễn giải: {dgCt}\n";
                }
            }

            string statusText = status == "2" ? "✅ Đã ghi sổ" : "⏳ Chưa ghi sổ";

            var searchResult = $"🔍 **Tìm thấy phiếu thu:**\n\n" +
                              $"📋 **Thông tin chứng từ:**\n" +
                              $"• Số chứng từ: **{foundSoCt}**\n" +
                              $"• Ngày chứng từ: {ngayCt:dd/MM/yyyy}\n" +
                              $"• Trạng thái: {statusText}\n\n" +
                              $"👤 **Khách hàng:**\n" +
                              $"• Mã KH: {maKh}\n" +
                              $"• Tên KH: {tenKh}\n\n" +
                              $"🏢 **Đơn vị:**\n" +
                              $"• Mã đơn vị: {maDvcs}\n" +
                              $"• Tên đơn vị: {tenDvcs}\n\n" +
                              $"💵 **Tài chính:**\n" +
                              $"• TK nợ: **{tk}**\n" +
                              $"• Tổng tiền: **{tTien:N0} {maNt}**\n" +
                              $"• Diễn giải: {dienGiai}" +
                              ctInfo +
                              $"\n\n✏️ **Thao tác:**\n" +
