@page "/fabpts"
@page "/fabpts/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,fabpts")]

<div class="row mt-1">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="30vw"
              MinWidth="300px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible"
                                 List_ID="@sqlTableName"
                                 Ma_ma="@SqlTableKeyValue"
                                 Title="@Lap["Change department code"]"
                                 Ten_item="@Ten_item"
                                 OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportDM @bind-IsImportPopupVisible="@IsImportPopupVisible"
                             CurDmimex="@CurDmimex"
                             OnImportCompleted="@ImportOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {
    string Ma_dvcs = "";
    protected override void OnInitialized()
    {
        mPage = "fabpts";
        IsShowCopy = true;
        IsShowImport = true;
        sqlTableName = "dmbpts";
        sqlTableView = "v_dmbpts";
        SqlTableKey = "ma_bpts";
        FrmType = typeof(SisFa.Pages.List.FABPTS.EditFabpts);

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "wf.dm.01";

        base.OnInitialized();
    }
    public override async Task Loaddata()
    {
        // 1. Lấy mã đơn vị từ hệ thống
        Ma_dvcs = myStateMN.GetMa_Dvcs();

        string preFilter = "1=1";

        // 2. Nếu có chọn ĐVCS cụ thể (khác ALL), thì thêm điều kiện lọc
        if (!string.IsNullOrEmpty(Ma_dvcs) && !Ma_dvcs.Equals("ALL"))
        {
            preFilter = $" ma_dvcs LIKE '{Ma_dvcs.Trim()}%'";
        }

        // 3. Tạo câu lệnh SQL (Dùng sqlTableView là v_dmbpts đã khai báo ở OnInitialized)
        string sql = $"SELECT * FROM {sqlTableView} WHERE {preFilter}";

        try
        {
            System.Data.DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];
                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi LoadData: " + ex.Message);
        }

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Đăng ký sự kiện lắng nghe khi ĐVCS thay đổi
            myStateMN.OnDvcsChanged += OnDvcsChanged;

            // Có thể cần gọi LoadData lần đầu ở đây nếu Base component không tự gọi
            // await Loaddata();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async void OnDvcsChanged(string _ma_dvcs)
    {
        // Tải lại dữ liệu khi người dùng đổi ĐVCS
        await Loaddata();
        StateHasChanged();
    }

    public override async void Dispose()
    {
        // Hủy đăng ký sự kiện khi đóng form để tránh lỗi tràn bộ nhớ (memory leak)
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
        base.Dispose();
    }
}
