@inherits FrmListBaseComponent
@using SisFa.Pages.List.FANV

<div class="popup-body-container w-100" style="overflow:auto;max-width:1200px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmnv"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                <DxFormLayoutItem Caption="@Lap["Capital source code"]" ColSpanMd="6" CaptionCssClass="fw-bold">
                    <Template>
                        <DxTextBox Id="ma_nv_input"
                                   @bind-Text="@CurDmnv.Ma_nv"
                                   maxlength="@tblLength["ma_nv"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Capital source name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmnv.Ten_nv"
                                   maxlength="@tblLength["ten_nv"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@(Lap["Capital source name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmnv.Ten_nv2"
                                   maxlength="@tblLength["ten_nv2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmnv CurDmnv;
    private string menu_id = "wf.dm.03";

    protected override void OnInitialized()
    {
        sqlTableName = "dmnv";
        SqlTableKey = "ma_nv";
        CheckSqlTableKey = "ma_nv";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "fanv" : ParentPage;
        CurDmnv = new Dmnv();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_nv_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string SqlTableKeyValue)
    {
        CurDmnv = new Dmnv();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(SqlTableKeyValue);
        StateHasChanged();
    }

    async Task EditDM(string SqlTableKeyValue)
    {
        CurDmnv = new Dmnv();
        AllowEditMode = true;
        AllowEditMa = true;
        await LoadData(SqlTableKeyValue);
        if (CheckDeleteListId(curCommand.Store_proc.Trim(), SqlTableKeyValue) == 0)
        {
            AllowEditMa = false;
        }
        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmnv.Ma_nv);
    }

    async Task SaveDM()
    {
        CurDmnv.Ma_nv = CurDmnv.Ma_nv.ToUpper().Trim().Replace(" ", "");
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmnv.Ma_nv.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            CurDmnv.Date = DateTime.Now.Date;
            CurDmnv.Date0 = DateTime.Now.Date;
            CurDmnv.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmnv.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmnv.User_id = curUser.User_id;
                CurDmnv.User_id0 = curUser.User_id;
                CurDmnv.User_name = curUser.User_name;
                CurDmnv.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmnv.Ma_nv.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Mã [{0} ] đã tồn tại!"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmnv>(CurDmnv, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Thêm mới thành công : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmnv.Date = DateTime.Now.Date;
            CurDmnv.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmnv.User_id = curUser.User_id;
                CurDmnv.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmnv>(CurDmnv, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Cập nhật thành công : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmnv.Ma_nv))
        {
            myStateMN.SetNewThongbao(Lap["Mã NV trống"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmnv.Ten_nv))
        {
            myStateMN.SetNewThongbao(Lap["Tên NV không được để trống"]);
            StateHasChanged();
            return false;
        }
        return true;
    }

    async Task LoadData(string SqlTableKeyValue)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + SqlTableKeyValue + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmnv> lsdetai = myDb.ConvertDataTable<Dmnv>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmnv = lsdetai[0];
            }
        }
    }

    async Task CreateNewDM()
    {
        CurDmnv = new Dmnv();
        CurDmnv.Status = "1";
        CurDmnv.Ma_nv = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string SqlTableKeyValue)
    {
        CurDmnv = new Dmnv();
        await LoadData(SqlTableKeyValue);
        CurDmnv.Status = "1";
        CurDmnv.Ma_nv = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
