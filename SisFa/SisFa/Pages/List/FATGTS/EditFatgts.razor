@inherits FrmListBaseComponent
@using SisFa.Pages.List.FATGTS
@using System.Dynamic

<div class="popup-body-container w-100" style="overflow:auto;max-width:800px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmtgts"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                <DxFormLayoutItem Caption="@Lap["Increase/Decrease type"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                    <Template>
                        <DxComboBox Id="loai_tg_ts_input"
                                    Enabled="@AllowEditMode"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    Data="LSLoaiTgts"
                                    TextFieldName="Ten"
                                    ValueFieldName="Ma"
                                    NullText="1 - Tăng, 2 - Giảm"
                                    FilteringMode="DataGridFilteringMode.Contains"
                                    @bind-Value="@CurDmtgts.Loai_tg_ts">
                            <Columns>
                                <DxListEditorColumn FieldName="Ma" Caption="@Lap["ID"]" Width="50px" />
                                <DxListEditorColumn FieldName="Ten" Caption="@Lap["Name"]" />
                            </Columns>
                        </DxComboBox>
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Reason code"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox Id="ma_tg_ts_input"
                                   @bind-Text="@CurDmtgts.Ma_tg_ts"
                                   maxlength="@tblLength["ma_tg_ts"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Reason name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtgts.Ten_tg_ts"
                                   maxlength="@tblLength["ten_tg_ts"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@(Lap["Name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmtgts.Ten_tg_ts2"
                                   maxlength="@tblLength["ten_tg_ts2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmtgts CurDmtgts;
    private string menu_id = "wf.dm.02";

    private List<Dmtk> LSLoaiTgts = new List<Dmtk>()
    {
        new Dmtk { Ma = "1", Ten = "1 - Tăng" },
        new Dmtk { Ma = "2", Ten = "2 - Giảm" }
    };

    string GetLoaiTgTsHint()
    {
        return CurDmtgts.Loai_tg_ts switch
        {
            "1" => "Tăng",
            "2" => "Giảm",
            _ => ""
        };
    }

    protected override void OnInitialized()
    {
        sqlTableName = "dmtgts";
        SqlTableKey = "ma_tg_ts";
        CheckSqlTableKey = "ma_tg_ts";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "fatgts" : ParentPage;
        CurDmtgts = new Dmtgts();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('loai_tg_ts_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string SqlTableKeyValue)
    {
        CurDmtgts = new Dmtgts();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(SqlTableKeyValue);
        StateHasChanged();
    }

    async Task EditDM(string SqlTableKeyValue)
    {
        CurDmtgts = new Dmtgts();
        AllowEditMode = true;
        AllowEditMa = true;
        await LoadData(SqlTableKeyValue);
        if (curCommand != null && !string.IsNullOrEmpty(curCommand.Store_proc))
        {
            if (CheckDeleteListId(curCommand.Store_proc.Trim(), SqlTableKeyValue) == 0)
            {
                AllowEditMa = false;
            }
        }
        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmtgts.Ma_tg_ts);
    }

    async Task SaveDM()
    {
        CurDmtgts.Ma_tg_ts = CurDmtgts.Ma_tg_ts.ToUpper().Trim().Replace(" ", "");
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmtgts.Ma_tg_ts.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (curCommand != null)
        {
            if (!CheckValidCode())
                return;
        }
        else
        {
            if (curActionTask == ActionTask.Edit && SqlTableKeyValue != SqlTableKeyValueOld)
            {
                string chk = "Select " + SqlTableKey + " from " + sqlTableName + " where " + SqlTableKey + " = '" + SqlTableKeyValue + "'";
                DataSet dsChk = await myDb.LoadDataset(chk);
                if (dsChk != null && dsChk.Tables[0].Rows.Count > 0)
                {
                    myStateMN.SetNewThongbao(String.Format(Lap["Mã [{0} ] đã tồn tại !"], SqlTableKeyValue));
                    StateHasChanged();
                    return;
                }
            }
        }

        if (curActionTask == ActionTask.New)
        {
            CurDmtgts.Date = DateTime.Now.Date;
            CurDmtgts.Date0 = DateTime.Now.Date;
            CurDmtgts.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmtgts.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtgts.User_id = curUser.User_id;
                CurDmtgts.User_id0 = curUser.User_id;
                CurDmtgts.User_name = curUser.User_name;
                CurDmtgts.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmtgts.Ma_tg_ts.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Mã [{0} ] đã tồn tại !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmtgts>(CurDmtgts, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Thêm mới thành công: {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmtgts.Date = DateTime.Now.Date;
            CurDmtgts.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmtgts.User_id = curUser.User_id;
                CurDmtgts.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmtgts>(CurDmtgts, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Cập nhật thành công : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmtgts.Loai_tg_ts) || (CurDmtgts.Loai_tg_ts != "1" && CurDmtgts.Loai_tg_ts != "2"))
        {
            myStateMN.SetNewThongbao(Lap["Mã tăng/giảm phải là 1 hoặc 2"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmtgts.Ma_tg_ts))
        {
            myStateMN.SetNewThongbao(Lap["Mã tăng/giảm trống"] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmtgts.Ten_tg_ts))
        {
            myStateMN.SetNewThongbao(Lap["Lý do tăng/giảm trống"]);
            StateHasChanged();
            return false;
        }
        return true;
    }

    async Task LoadData(string SqlTableKeyValue)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + SqlTableKeyValue + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmtgts> lsdetai = myDb.ConvertDataTable<Dmtgts>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmtgts = lsdetai[0];
            }
        }
    }

    async Task CreateNewDM()
    {
        CurDmtgts = new Dmtgts();
        CurDmtgts.Status = "1";
        CurDmtgts.Ma_tg_ts = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string SqlTableKeyValue)
    {
        CurDmtgts = new Dmtgts();
        await LoadData(SqlTableKeyValue);
        CurDmtgts.Status = "1";
        CurDmtgts.Ma_tg_ts = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }
}
