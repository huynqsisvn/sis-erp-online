@inherits FrmListBaseComponent
@using SisFa.Pages.List.FAPLTS

<div class="popup-body-container w-100" style="overflow:auto;max-width:800px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <div class="row m-1 me-2 rounded-1 border border-light shadow">
            <DxFormLayout Data="@CurDmplts"
                          ItemSizeMode="@Itemsizemode"
                          CssClass="frm-header sis-form"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                <DxFormLayoutItem Caption="@Lap["Asset type code"]" ColSpanMd="6" CaptionCssClass="fw-bold">
                    <Template>
                        <DxTextBox Id="ma_loai_input"
                                   @bind-Text="@CurDmplts.Ma_loai"
                                   maxlength="@tblLength["ma_loai"]"
                                   InputCssClass="uppercase"
                                   Enabled="@AllowEditMa" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Asset type name"]" ColSpanMd="12" CaptionCssClass="fw-bold" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmplts.Ten_loai"
                                   maxlength="@tblLength["ten_loai"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@(Lap["Name"] + " 2")" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@CurDmplts.Ten_loai2"
                                   maxlength="@tblLength["ten_loai2"]"
                                   Enabled="@AllowEditMode" />
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12">
                    <Template>
                        <hr />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </FormList>
</div>

@code {
    public Dmplts CurDmplts;
    private string menu_id = "wf.dm.04";

    protected override void OnInitialized()
    {
        sqlTableName = "dmplts";
        SqlTableKey = "ma_loai";
        CheckSqlTableKey = "ma_loai";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "faplts" : ParentPage;
        CurDmplts = new Dmplts();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    myStateMN.SetToolBar(new MyToolbar("save", false));
                    break;
                case ActionTask.Edit:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await EditDM(Ma_ma);
                    break;
                case ActionTask.New:
                    await CreateNewDM();
                    break;
                case ActionTask.Copy:
                    await CreateCopyDM(Ma_ma);
                    break;
                default:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await ViewDM(Ma_ma);
                    break;
            }

            await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('ma_loai_input')?.focus()");
            StateHasChanged();
        }
    }

    async Task ViewDM(string SqlTableKeyValue)
    {
        CurDmplts = new Dmplts();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(SqlTableKeyValue);
        StateHasChanged();
    }

    async Task EditDM(string SqlTableKeyValue)
    {
        CurDmplts = new Dmplts();
        AllowEditMode = true;
        AllowEditMa = true;
        await LoadData(SqlTableKeyValue);
        if (curCommand != null && !string.IsNullOrEmpty(curCommand.Store_proc))
        {
            if (CheckDeleteListId(curCommand.Store_proc.Trim(), SqlTableKeyValue) == 0)
            {
                AllowEditMa = false;
            }
        }
        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmplts.Ma_loai);
    }

    async Task SaveDM()
    {
        CurDmplts.Ma_loai = CurDmplts.Ma_loai.ToUpper().Trim().Replace(" ", "");
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmplts.Ma_loai.ToUpper().Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (curCommand != null)
        {
            if (!CheckValidCode())
                return;
        }
        else
        {
            if (curActionTask == ActionTask.Edit && SqlTableKeyValue != SqlTableKeyValueOld)
            {
                string chk = "Select " + SqlTableKey + " from " + sqlTableName + " where " + SqlTableKey + " = '" + SqlTableKeyValue + "'";
                DataSet dsChk = await myDb.LoadDataset(chk);
                if (dsChk != null && dsChk.Tables[0].Rows.Count > 0)
                {
                    myStateMN.SetNewThongbao(String.Format(Lap["Mã [{0} ] đã tồn tại !"], SqlTableKeyValue));
                    StateHasChanged();
                    return;
                }
            }
        }

        if (curActionTask == ActionTask.New)
        {
            CurDmplts.Date = DateTime.Now.Date;
            CurDmplts.Date0 = DateTime.Now.Date;
            CurDmplts.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmplts.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmplts.User_id = curUser.User_id;
                CurDmplts.User_id0 = curUser.User_id;
                CurDmplts.User_name = curUser.User_name;
                CurDmplts.User_name0 = curUser.User_name;
            }

            CheckSqlTableKeyValue = CurDmplts.Ma_loai.Trim();
            string check = "Select " + SqlTableKey + " from " + sqlTableName + " where " + CheckSqlTableKey + " = '" + CheckSqlTableKeyValue + "'";
            DataSet ds = await myDb.LoadDataset(check);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Mã [{0} ] đã tồn tại  !"], SqlTableKeyValue));
                StateHasChanged();
                return;
            }
            else
            {
                await myDb.InsertOneRow<Dmplts>(CurDmplts, sqlTableName);
                myStateMN.SetNewThongbao(String.Format(Lap["Thêm mới thành công : {0}"], SqlTableKeyValue));
            }
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmplts.Date = DateTime.Now.Date;
            CurDmplts.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmplts.User_id = curUser.User_id;
                CurDmplts.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmplts>(CurDmplts, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Cập nhật thành công : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmplts.Ma_loai))
        {
            myStateMN.SetNewThongbao(Lap["Mã Loại ts trống "] + " !");
            StateHasChanged();
            return false;
        }

        if (string.IsNullOrEmpty(CurDmplts.Ten_loai))
        {
            myStateMN.SetNewThongbao(Lap["Tên Loại ts trống"]);
            StateHasChanged();
            return false;
        }
        return true;
    }

    async Task LoadData(string SqlTableKeyValue)
    {
        string sql = "Select * from " + sqlTableName + " where " + SqlTableKey + " = '" + SqlTableKeyValue + "'";
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmplts> lsdetai = myDb.ConvertDataTable<Dmplts>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
            {
                CurDmplts = lsdetai[0];
            }
        }
    }

    async Task CreateNewDM()
    {
        CurDmplts = new Dmplts();
        CurDmplts.Status = "1";
        CurDmplts.Ma_loai = GetNewSttDM();
        if (string.IsNullOrEmpty(CurDmplts.Ma_loai))
            CurDmplts.Ma_loai = await GetNextMaLoai();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string SqlTableKeyValue)
    {
        CurDmplts = new Dmplts();
        await LoadData(SqlTableKeyValue);
        CurDmplts.Status = "1";
        CurDmplts.Ma_loai = GetNewSttDM();
        if (string.IsNullOrEmpty(CurDmplts.Ma_loai))
            CurDmplts.Ma_loai = await GetNextMaLoai();
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<string> GetNextMaLoai()
    {
        try
        {
            string sql = @"SELECT TOP 1 ma_loai FROM dmplts ORDER BY ma_loai DESC";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                string lastCode = ds.Tables[0].Rows[0][0].ToString().Trim();
                string prefix = "";
                string numPart = "";
                for (int i = 0; i < lastCode.Length; i++)
                {
                    if (char.IsDigit(lastCode[i]))
                    {
                        prefix = lastCode.Substring(0, i);
                        numPart = lastCode.Substring(i);
                        break;
                    }
                }
                if (!string.IsNullOrEmpty(numPart) && int.TryParse(numPart, out int num))
                {
                    return prefix + (num + 1).ToString().PadLeft(numPart.Length, '0');
                }
            }
        }
        catch { }
        return "";
    }
}
