@inherits FrmListBaseComponent
@using SisFa.Pages.List.FANHTS

<div class="popup-body-container w-100" style="overflow:auto;max-width:800px;">
    <FormList Title="@Title"
              @bind-curActionTask="@curActionTask"
              OnSave="@SaveDM"
              OnEdit="@OnEdit"
              OnCopy="@OnCopy"
              OnCancel="@HideVoucher">
        <EditForm Model="@CurDmnhts" onkeydown="ModifyEnterKeyPressAsTab(event);" class="row m-1 me-2 rounded-1 border border-light shadow">
            <DataAnnotationsValidator></DataAnnotationsValidator>
            <div class="row">
                <div class="row pb-2">
                    <label class="col-4" for="Ma_nh">@Lap["Group ID"] (*): </label>
                    <DxTextBox CssClass="col" Id="Ma_nh" @bind-Text="@CurDmnhts.Ma_nh" InputCssClass="uppercase font-bold" maxlength="@tblLength["ma_nh"]" Enabled="@AllowEditMa" />
                </div>

                <div class="row pb-2">
                    <label class="col-4" for="Ten_nh">@Lap["Group name"] (*): </label>
                    <DxTextBox CssClass="col" Id="Ten_nh" @bind-Text="@CurDmnhts.Ten_nh" maxlength="@tblLength["ten_nh"]" Enabled="@AllowEditMode" />
                </div>

                <div class="row pb-2">
                    <label class="col-4" for="Ten_nh2">@Lap["Group name 2"] : </label>
                    <DxTextBox CssClass="col" Id="Ten_nh2" @bind-Text="@CurDmnhts.Ten_nh2" maxlength="@tblLength["ten_nh2"]" Enabled="@AllowEditMode" />
                </div>

                <hr class="col-12 m-2" />
            </div>
        </EditForm>
    </FormList>
</div>

@code {
    [Parameter] public int FilterLoaiNh { get; set; } = 1;

    public Dmnhts CurDmnhts { get; set; }
    private string menu_id = "wf.dm.06";

    protected override void OnInitialized()
    {
        sqlTableName = "dmnhts";
        SqlTableKey = "loai_nh;ma_nh";
        CheckSqlTableKey = "loai_nh;ma_nh";
        ParentPage = String.IsNullOrEmpty(ParentPage) ? "fanhts" : ParentPage;
        CurDmnhts = new Dmnhts();

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = menu_id;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await PageLoad();
        myStateMN.OnLangguaChanged += OnLangguachange;

        if (curActionTask == ActionTask.None)
            curActionTask = myStateMN.GetCurrentActionTask();

        curUser = myStateMN.GetCurUser();

        switch (curActionTask)
        {
            case ActionTask.View:
                if (!string.IsNullOrEmpty(Ma_ma))
                    await ViewDM(Ma_ma);
                myStateMN.SetToolBar(new MyToolbar("save", false));
                break;
            case ActionTask.Edit:
                if (!string.IsNullOrEmpty(Ma_ma))
                    await EditDM(Ma_ma);
                break;
            case ActionTask.New:
                await CreateNewDM();
                break;
            case ActionTask.Copy:
                await CreateCopyDM(Ma_ma);
                break;
            default:
                if (!string.IsNullOrEmpty(Ma_ma))
                    await ViewDM(Ma_ma);
                break;
        }
    }

    async Task ViewDM(string SqlTableKeyValue)
    {
        CurDmnhts = new Dmnhts();
        AllowEditMode = false;
        AllowEditMa = false;
        await LoadData(SqlTableKeyValue);
        StateHasChanged();
    }

    async Task EditDM(string SqlTableKeyValue)
    {
        CurDmnhts = new Dmnhts();
        AllowEditMode = true;
        AllowEditMa = true;
        SqlTableKeyValueOld = SqlTableKeyValue;
        await LoadData(SqlTableKeyValue);

        if (await CheckExistsMaNhTs(CurDmnhts.Loai_nh, CurDmnhts.Ma_nh))
        {
            AllowEditMa = false;
        }
        StateHasChanged();
    }

    async Task OnEdit()
    {
        AllowEditMode = true;
        curActionTask = ActionTask.Edit;
        StateHasChanged();
    }

    async Task OnCopy()
    {
        await CreateCopyDM(CurDmnhts.Loai_nh.ToString() + ";" + CurDmnhts.Ma_nh);
    }

    async Task SaveDM()
    {
        CurDmnhts.Ma_nh = CurDmnhts.Ma_nh.ToUpper().Trim().Replace(" ", "");
        if (!CheckValid())
            return;

        SqlTableKeyValue = CurDmnhts.Loai_nh.ToString().Trim() + ";" + CurDmnhts.Ma_nh.Trim();
        SqlTableKeyValueOld = (curActionTask == ActionTask.New ? "" : Ma_ma);
        if (!CheckValidCode())
            return;

        if (curActionTask == ActionTask.New)
        {
            string strsql = "Select top 1 ma_nh from " + sqlTableName + " where loai_nh = " + CurDmnhts.Loai_nh.ToString().Trim() + " AND ma_nh = '" + CurDmnhts.Ma_nh.Trim() + "'";
            DataSet ds = await myDb.LoadDataset(strsql);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                myStateMN.SetNewThongbao(String.Format(Lap["Mã [{0} ] đã tồn tại !"], CurDmnhts.Ma_nh.Trim()));
                return;
            }

            CurDmnhts.Date = DateTime.Now.Date;
            CurDmnhts.Date0 = DateTime.Now.Date;
            CurDmnhts.Time = DateTime.Now.ToString("HH:mm:ss");
            CurDmnhts.Time0 = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmnhts.User_id = curUser.User_id;
                CurDmnhts.User_id0 = curUser.User_id;
                CurDmnhts.User_name = curUser.User_name;
                CurDmnhts.User_name0 = curUser.User_name;
            }
            await myDb.InsertOneRow<Dmnhts>(CurDmnhts, sqlTableName);
            myStateMN.SetNewThongbao(String.Format(Lap["Thêm mới thành công : {0}"], SqlTableKeyValue));
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmnhts.Date = DateTime.Now.Date;
            CurDmnhts.Time = DateTime.Now.ToString("HH:mm:ss");
            if (curUser != null)
            {
                CurDmnhts.User_id = curUser.User_id;
                CurDmnhts.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmnhts>(CurDmnhts, sqlTableName, SqlTableKey, SqlTableKeyValueOld, true);
            myStateMN.SetNewThongbao(String.Format(Lap["Cập nhật thành công : {0}"], SqlTableKeyValue));
        }

        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo("/" + ParentPage);
    }

    bool CheckValid()
    {
        if (string.IsNullOrEmpty(CurDmnhts.Ma_nh))
        {
            myStateMN.SetNewThongbao(Lap["Mã nhóm trống"] + " !");
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrEmpty(CurDmnhts.Ten_nh))
        {
            myStateMN.SetNewThongbao(Lap["Tên nhóm trống"]);
            StateHasChanged();
            return false;
        }
        if (CurDmnhts.Ma_nh.Trim().Contains(";"))
        {
            myStateMN.SetNewThongbao(Lap["The code cannot contain characters"] + " [;] !");
            return false;
        }
        return true;
    }

    async Task LoadData(string SqlTableKeyValue)
    {
        string sql = BuildSql(sqlTableName, SqlTableKey, SqlTableKeyValue);
        DataSet DsTrans = await myDb.LoadDataset(sql);
        if (DsTrans != null && DsTrans.Tables[0].Rows.Count > 0)
        {
            List<Dmnhts> lsdetai = myDb.ConvertDataTable<Dmnhts>(DsTrans.Tables[0]);
            if (lsdetai != null && lsdetai.Count > 0)
                CurDmnhts = lsdetai[0];
        }
        StateHasChanged();
    }

    async Task CreateNewDM()
    {
        CurDmnhts = new Dmnhts();
        CurDmnhts.Status = "1";
        CurDmnhts.Loai_nh = FilterLoaiNh;
        CurDmnhts.Ma_nh = GetNewSttDM();
        AllowEditMode = true;
        AllowEditMa = true;
        StateHasChanged();
    }

    public async Task CreateCopyDM(string SqlTableKeyValue)
    {
        CurDmnhts = new Dmnhts();
        await LoadData(SqlTableKeyValue);
        CurDmnhts.Ma_nh = GetNewSttDM();
        CurDmnhts.Status = "1";
        AllowEditMode = true;
        AllowEditMa = true;
        curActionTask = ActionTask.New;
        StateHasChanged();
    }

    async Task<bool> CheckExistsMaNhTs(int loai_nh, string ma_nh)
    {
        try
        {
            string colName = loai_nh switch
            {
                1 => "nh_ts1",
                2 => "nh_ts2",
                _ => "nh_ts3"
            };
            string sql = "Select count(so_the_ts) as cnt From dmts Where " + colName + " = '" + (ma_nh ?? "").Replace("'", "''") + "'";
            DataSet ds = await myDb.LoadDataset(sql);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                return Convert.ToInt32(ds.Tables[0].Rows[0]["cnt"]) > 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CheckExistsMaNhTs error: " + ex.Message);
        }
        return false;
    }
}
