    // --- C. HÀM TÍNH TOÁN LẠI TOÀN BỘ LƯỚI ---
    void RecalculateAllGrid()
    {
        if (LstChiTietGiaTri != null)
        {
            foreach (var item in LstChiTietGiaTri)
            {
                CalculateRowDepreciation(item);
            }
        }
    }

    // HÀM TÍNH TOÁN (Đã điều chỉnh theo Winform của bạn)
    void CalculateRowDepreciation(CtDmts item)
    {
        if (item == null) return;
        decimal nguyenGia = item.Nguyen_gia ?? 0;
        decimal daKh = item.Gt_da_kh ?? 0;
        decimal soKy = CurDmts.So_ky_kh ?? 0;

        // 1. Luôn tính lại Giá trị còn lại
        item.Gt_cl = nguyenGia - daKh;

        // 2. Tính Gt k.hao 1 kỳ (CHỈ TÍNH NẾU LÀ ĐƯỜNG THẲNG)
        if (CurDmts.Kieu_kh == "1" && soKy > 0)
        {
            decimal ketQua = (nguyenGia - daKh) / soKy;
            item.Gt_kh_ky = Math.Round(ketQua, 0, MidpointRounding.AwayFromZero);
        }
        else
        {
            item.Gt_kh_ky = 0; // Nếu là Sản lượng (Kieu_kh = 2) thì Gt_kh_ky phải = 0
        }

        // 3. Cập nhật tổng cộng
        UpdateMasterTotals();
    }

