@code {
// --- 1. KHAI BÁO BIẾN & MODEL ---
private int ActiveTabIndex = 0; // Tab index cho DxFormLayoutTabPages
DxGrid GridChiTiet { get; set; } // Đổi IGrid -> DxGrid
DxGrid GridPhuTung { get; set; } // Đổi IGrid -> DxGrid
object SelectedDataItemPhuTung;
object SelectedDataItemChiTiet;
public Dmts CurDmts { get; set; } = new Dmts();
public List<CtCtTs> LstPhuTung { get; set; } = new List<CtCtTs>();
public List<CtDmts> LstChiTietGiaTri { get; set; } = new List<CtDmts>();
private List<listItem> LsNguonVon;
    List<object> ListKieuKH = new List<object>() {
        new { Value = "1", Text = "1. Đường thẳng" },
        new { Value = "2", Text = "2. Sản lượng" }
    };

    protected override void OnInitialized()
    {
        sqlTableName = "dmts";
        SqlTableKey = "so_the_ts";
        // Kích thước vừa phải, dễ nhìn
        Itemsizemode = SizeMode.Medium;
        objRef = DotNetObjectReference.Create(this); 
        base.OnInitialized();
    }
    DxTextBox txtMaTaiSan;
    
    bool hasFocusedMa = false;
    DxTextBox txtMaPhu; 
    // --- 3. LOGIC THÊM MỚI (NEW) ---
    void CreateNewDM()
    {
        string ma_dvcs = myStateMN.GetMa_Dvcs();

        if (string.IsNullOrWhiteSpace(ma_dvcs) || ma_dvcs.Trim().ToUpper() == "ALL")
        {
            myStateMN.SetNewThongbao("Vui lòng chọn ĐVCS cụ thể!");
            return;
        }
        CurDmts = new Dmts();      
        // Gán giá trị mặc định
        CurDmts.Status = "1";
        CurDmts.Ma_dvcs = ma_dvcs;
        CurDmts.Ngay_mua = DateTime.Now;
        CurDmts.Ngay_kh0 = DateTime.Now;
        CurDmts.Kieu_kh = "1"; // Mặc định đường thẳng
        CurDmts.So_ky_kh = 0;

        // Khởi tạo lưới rỗng + 1 dòng trắng để nhập ngay
        LstChiTietGiaTri = new List<CtDmts>();
        AddRowChiTiet();

        LstPhuTung = new List<CtCtTs>();

        // Cho phép nhập Mã
        AllowEditMode = true;
        AllowEditMa = true;
    }

    // --- 4. LOGIC SỬA (EDIT) ---
    async Task LoadData(string id)
    {
        // Load Master
        string sql = $"SELECT * FROM {sqlTableName} WHERE {SqlTableKey} = '{id}'";
        DataSet ds = await myDb.LoadDataset(sql);

        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            var list = myDb.ConvertDataTable<Dmts>(ds.Tables[0]);
            CurDmts = list[0];

            // Load Detail 1 (Chi tiết giá trị)
            string sqlCt = $"SELECT * FROM ctdmts WHERE so_the_ts = '{id}' ORDER BY ngay_ct, so_ct";
            var dsCt = await myDb.LoadDataset(sqlCt);
            if (dsCt != null && dsCt.Tables.Count > 0)
            {
                LstChiTietGiaTri = myDb.ConvertDataTable<CtDmts>(dsCt.Tables[0]);
                // Đánh số STT
                int stt = 1; LstChiTietGiaTri.ForEach(x => x.Stt = stt++);
            }

            // Load Detail 2 (Phụ tùng)
            string sqlPt = $"SELECT * FROM ctctts WHERE so_the_ts = '{id}'";
            var dsPt = await myDb.LoadDataset(sqlPt);
            if (dsPt != null && dsPt.Tables.Count > 0)
            {
                LstPhuTung = myDb.ConvertDataTable<CtCtTs>(dsPt.Tables[0]);
                // Đánh số STT
                int stt = 1; LstPhuTung.ForEach(x => x.Stt = stt++);
            }
        }

        // Chế độ Sửa: Không cho sửa Mã
        if (curActionTask == ActionTask.Edit)
        {
            AllowEditMa = false;
        }
        AllowEditMode = (curActionTask != ActionTask.View);
    }

    // --- 5. LOGIC COPY (SAO CHÉP) ---
    async Task CopyDM(string id)
    {
        // Bước 1: Load dữ liệu cũ lên giống hệt Edit
        await LoadData(id);

        // Bước 2: Xóa khóa chính để thành bản ghi mới
        CurDmts.So_the_ts = "";

        // Bước 3: Reset các thông tin ngày tháng về hiện tại (Tùy logic nghiệp vụ)
        CurDmts.Ngay_mua = DateTime.Now;
        CurDmts.Ngay_kh0 = DateTime.Now;
        CurDmts.Ngay_kt_kh = null; // Tính lại sau

        // Bước 4: Reset các giá trị lũy kế (Vì là tài sản mới copy nên chưa khấu hao)
        CurDmts.Gt_da_kh = 0;
        CurDmts.Gt_cl = CurDmts.Nguyen_gia; // Giá trị còn lại về ban đầu

        // Bước 5: Cho phép sửa Mã
        AllowEditMa = true;
        AllowEditMode = true;

        // Bước 6: Xóa ID của các dòng chi tiết để khi lưu nó thành dòng mới
        // (Trong trường hợp này model detail không có ID tự tăng nên không cần reset ID, chỉ cần biết là list mới)
    }

    // --- 6. LOGIC LƯU (SAVE) ---
    // --- 1. HÀM LƯU (SỬA LẠI GỌN GÀNG & GỌI CHECKVALID) ---
    async Task SaveDM()
{
    // 1. Format dữ liệu chuẩn
    CurDmts.So_the_ts = CurDmts.So_the_ts?.ToUpper().Trim();
    CurDmts.Ten_ts = CurDmts.Ten_ts?.Trim();
    if (CurDmts.Ngay_mua.HasValue) CurDmts.Ngay_mua = CurDmts.Ngay_mua.Value.Date;
    if (CurDmts.Ngay_kh0.HasValue) CurDmts.Ngay_kh0 = CurDmts.Ngay_kh0.Value.Date;
    if (CurDmts.Ngay_kt_kh.HasValue) CurDmts.Ngay_kt_kh = CurDmts.Ngay_kt_kh.Value.Date;
    if (CurDmts.Ngay_dc.HasValue) CurDmts.Ngay_dc = CurDmts.Ngay_dc.Value.Date;
    if (CurDmts.Ngay_dvsd.HasValue) CurDmts.Ngay_dvsd = CurDmts.Ngay_dvsd.Value.Date;
    CurDmts.Nam_sx = CurDmts.Nam_sx ?? 0;
    CurDmts.Tien_cl = CurDmts.Tien_cl ?? 0;
    CurDmts.So_ky_kh = CurDmts.So_ky_kh ?? 0;
    CurDmts.Tong_sl = CurDmts.Tong_sl ?? 0;
    CurDmts.Tl_kh_nhanh = CurDmts.Tl_kh_nhanh ?? 0;
    CurDmts.Nguyen_gia = CurDmts.Nguyen_gia ?? 0;
    CurDmts.Gt_da_kh = CurDmts.Gt_da_kh ?? 0;
    CurDmts.Gt_kh_ky = CurDmts.Gt_kh_ky ?? 0;
    CurDmts.Gt_cl = CurDmts.Gt_cl ?? 0;
    CurDmts.Ty_le_kh = CurDmts.Ty_le_kh ?? 0;
    CurDmts.So_luong = CurDmts.So_luong ?? 0;
    CurDmts.Gt_da_kh0 = CurDmts.Gt_da_kh0 ?? 0;

    // 3. Ép các trường Ký tự (String) từ NULL về Chuỗi rỗng ""
    CurDmts.So_hieu_ts = CurDmts.So_hieu_ts ?? "";
    CurDmts.Ten_ts2 = CurDmts.Ten_ts2 ?? "";
    CurDmts.Dvt = CurDmts.Dvt ?? "";
    CurDmts.Nuoc_sx = CurDmts.Nuoc_sx ?? "";
    CurDmts.Nh_ts1 = CurDmts.Nh_ts1 ?? "";
    CurDmts.Nh_ts2 = CurDmts.Nh_ts2 ?? "";
    CurDmts.Nh_ts3 = CurDmts.Nh_ts3 ?? "";
    CurDmts.Ma_bpht = CurDmts.Ma_bpht ?? "";
    CurDmts.Tk_ts = CurDmts.Tk_ts ?? "";
    CurDmts.Ts_kt = CurDmts.Ts_kt ?? "";
    CurDmts.Ghi_chu = CurDmts.Ghi_chu ?? "";
    CurDmts.Search = CurDmts.Search ?? (CurDmts.Ten_ts + " " + CurDmts.So_the_ts);
    if (string.IsNullOrEmpty(CurDmts.Status)) CurDmts.Status = "1";

    // 2. Lưu các lưới chi tiết (để tránh mất dữ liệu đang nhập dở trên giao diện)
    if (GridPhuTung != null) await GridPhuTung.SaveChangesAsync();
    if (GridChiTiet != null) await GridChiTiet.SaveChangesAsync();

    // 3. Validate dữ liệu
    if (!await CheckValid()) return;

    try
    {
        // 4. Tính toán tổng hợp từ lưới Chi tiết giá trị
        if (LstChiTietGiaTri != null && LstChiTietGiaTri.Count > 0)
        {
            // Vẫn tính tổng bình thường
            CurDmts.Nguyen_gia = LstChiTietGiaTri.Sum(x => x.Nguyen_gia ?? 0);
            CurDmts.Gt_da_kh = LstChiTietGiaTri.Sum(x => x.Gt_da_kh ?? 0);
            CurDmts.Gt_cl = LstChiTietGiaTri.Sum(x => x.Gt_cl ?? 0);
            CurDmts.Gt_kh_ky = LstChiTietGiaTri.Sum(x => x.Gt_kh_ky ?? 0);
        }
        if ((CurDmts.Kieu_kh == "1" && CurDmts.So_ky_kh > 0) || (CurDmts.Kieu_kh == "2" && CurDmts.Tong_sl > 0))
        {
            CurDmts.Tinh_kh = 1;
        }
        else
        {
            CurDmts.Tinh_kh = 0;
        }

        // 2. Chốt số liệu triệt để chống rác dữ liệu DB
        if (CurDmts.Kieu_kh == "1") // 1. Đường thẳng
        {
            CurDmts.Tong_sl = 0;
            CurDmts.Tl_kh_nhanh = 0; // <--- Ép về 0 để DB không bị lỗi Null
        }
        else if (CurDmts.Kieu_kh == "2") // 2. Sản lượng
        {
            CurDmts.So_ky_kh = 0;
            CurDmts.Tl_kh_nhanh = 0; // <--- Ép về 0 để DB không bị lỗi Null
        }

        // ==========================================================
        // 5. GÁN THÔNG TIN QUẢN TRỊ (SYSTEM INFO) & LƯU MASTER
        // ==========================================================
        DateTime now = DateTime.Now;
        string currentTime = now.ToString("HH:mm:ss");

        if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
        {
            CurDmts.Date0 = now.Date;
            CurDmts.Time0 = currentTime;
            if (curUser != null)
            {
                CurDmts.User_id0 = curUser.User_id;
                CurDmts.User_name0 = curUser.User_name;
            }
            CurDmts.Date = now.Date;
            CurDmts.Time = currentTime;
            CurDmts.User_id = CurDmts.User_id0;
            CurDmts.User_name = CurDmts.User_name0;

            await myDb.InsertOneRow<Dmts>(CurDmts, sqlTableName);
            myStateMN.SetNewThongbao($"Thêm mới thành công: {CurDmts.So_the_ts}");
        }
        else if (curActionTask == ActionTask.Edit)
        {
            CurDmts.Date = now.Date;
            CurDmts.Time = currentTime;
            if (curUser != null)
            {
                CurDmts.User_id = curUser.User_id;
                CurDmts.User_name = curUser.User_name;
            }
            await myDb.UpdateOneRow<Dmts>(CurDmts, sqlTableName, SqlTableKey, Ma_ma, true);
            myStateMN.SetNewThongbao($"Cập nhật thành công: {CurDmts.So_the_ts}");
        }

        // ==========================================================
        // 6. LƯU CHI TIẾT CON (Xóa cũ -> Insert mới)
        // ==========================================================
        string idToDelete = (curActionTask == ActionTask.Edit) ? Ma_ma : CurDmts.So_the_ts;

        string sqlDel = $"DELETE FROM ctdmts WHERE so_the_ts = '{idToDelete}'; ";
        sqlDel += $"DELETE FROM ctctts WHERE so_the_ts = '{idToDelete}';";
        await myDb.ExecuteSqlQueryAsync(sqlDel);

        // A. Insert Chi tiết giá trị (ctdmts)
        if (LstChiTietGiaTri != null)
        {
            foreach (var item in LstChiTietGiaTri)
            {
                if (!item.Ngay_ct.HasValue) continue;
                
                string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
                string sNgayCt = CurDmts.Ngay_kh0.HasValue ? $"'{CurDmts.Ngay_kh0.Value:yyyy-MM-dd}'" : "NULL";
                string sSoCt = item.So_ct?.Replace("'", "''") ?? "";
                string sDienGiai = item.Dien_giai?.Replace("'", "''") ?? "";
                string sMaNv = item.Ma_nv?.Replace("'", "''") ?? "";
                
                // Format số chuẩn quốc tế
                string sNG = (item.Nguyen_gia ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                string sKH = (item.Gt_da_kh ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                string sCL = (item.Gt_cl ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                string sGtKhKy = (item.Gt_kh_ky ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                string sGtDaKh0 = (item.Gt_da_kh0 ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);

                // --- CÁC BIẾN BỔ SUNG ĐỂ TRÁNH LỖI SỐ ÂM VÀ THIẾU DỮ LIỆU ---
                string sNgayMua = CurDmts.Ngay_mua.HasValue ? $"'{CurDmts.Ngay_mua.Value:yyyy-MM-dd}'" : "NULL";
                string sMaTg = CurDmts.Ma_tg_ts?.Replace("'", "''") ?? "";
        
                // Đổi tên biến ở đây để không bị trùng với phần C bên dưới:
                string sNam_ct = CurDmts.Ngay_mua.HasValue ? CurDmts.Ngay_mua.Value.Year.ToString() : "NULL";
                string sKy_ct = CurDmts.Ngay_mua.HasValue ? CurDmts.Ngay_mua.Value.Month.ToString() : "NULL";

                // [ĐÃ SỬA]: Bổ sung tang_giam = '1' và các trường liên quan (ngay_tg, ma_tg_ts, nam, ky)
                string sqlInsert = $@"
                     INSERT INTO ctdmts(
                         so_the_ts, ngay_ct, so_ct, dien_giai, nguyen_gia, gt_da_kh, gt_cl, gt_kh_ky, gt_da_kh0, ma_nv, ts0,
                         tang_giam, ngay_tg, ma_tg_ts, nam, ky
                     )
                     VALUES (
                         N'{sSoThe}', {sNgayCt}, N'{sSoCt}', N'{sDienGiai}', {sNG}, {sKH}, {sCL}, {sGtKhKy}, {sGtDaKh0}, N'{sMaNv}', '1',
                         '1', {sNgayMua}, N'{sMaTg}', {sNam_ct}, {sKy_ct}
                     )
                ";
                await myDb.ExecuteSqlQueryAsync(sqlInsert);
            }
        }

        // B. Insert Phụ tùng (ctctts)
        if (LstPhuTung != null)
        {
            foreach (var item in LstPhuTung)
            {
                 if (string.IsNullOrEmpty(item.Ten_ptkt)) continue;
                 
                 string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
                 string sTenPt = item.Ten_ptkt?.Replace("'", "''") ?? "";
                 string sDvt = item.Dvt?.Replace("'", "''") ?? "";

                 string sSoLuong = (item.So_luong ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                 string sGiaTri = (item.Gia_tri ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);

                 // [ĐÃ SỬA]: Bổ sung thêm cột ts0 và gán giá trị '1'
                 string sqlInsertPT = $@"INSERT INTO ctctts(so_the_ts, ten_ptkt, dvt, so_luong, gia_tri, ts0)
                                         VALUES (N'{sSoThe}', N'{sTenPt}', N'{sDvt}', {sSoLuong}, {sGiaTri}, '1')";
                 await myDb.ExecuteSqlQueryAsync(sqlInsertPT);
            }
        }

        // C. TẠO DÒNG ĐIỀU CHUYỂN GỐC (ctbpts) - BỔ SUNG MỚI
        string sSoTheGoc = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
        string sMaBp = CurDmts.Ma_bpts?.Replace("'", "''") ?? "";
        string sNgayKh0 = CurDmts.Ngay_kh0.HasValue ? $"'{CurDmts.Ngay_kh0.Value:yyyy-MM-dd}'" : "NULL";
        
        // 1. Lấy đủ 2 tài khoản quan trọng
        string sTkKh = CurDmts.Tk_kh?.Replace("'", "''") ?? "";
        string sTkCp = CurDmts.Tk_cp?.Replace("'", "''") ?? "";
        
        string sMaBpht = CurDmts.Ma_bpht?.Replace("'", "''") ?? "";
        string sMaVv = CurDmts.Ma_vv?.Replace("'", "''") ?? "";

        // 2. Trích xuất Năm và Kỳ từ Ngày mua (Giống hàm NgayTC.GetYearOfDate của Winform)
        string sNam = CurDmts.Ngay_mua.HasValue ? CurDmts.Ngay_mua.Value.Year.ToString() : "NULL";
        string sKy = CurDmts.Ngay_mua.HasValue ? CurDmts.Ngay_mua.Value.Month.ToString() : "NULL";

        if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
        {
            // Bổ sung nam, ky, tk_kh vào SQL (Cố tình bỏ qua tk_ts cho dòng gốc theo đúng chuẩn Winform)
            string sqlInsertBP = $@"
                INSERT INTO ctbpts(so_the_ts, ma_bpts, ngay_kh, tk_kh, tk_cp, ma_bpht, ma_vv, ts0, nam, ky, 
                                   date0, time0, user_id0, date, time, user_id)
                VALUES (N'{sSoTheGoc}', N'{sMaBp}', {sNgayKh0}, N'{sTkKh}', N'{sTkCp}', N'{sMaBpht}', N'{sMaVv}', '1', {sNam}, {sKy}, 
                        '{now:yyyy-MM-dd}', '{currentTime}', {curUser?.User_id ?? 0}, '{now:yyyy-MM-dd}', '{currentTime}', {curUser?.User_id ?? 0})";
            await myDb.ExecuteSqlQueryAsync(sqlInsertBP);
        }
        else if (curActionTask == ActionTask.Edit)
        {
            // Sửa thì cập nhật lại luôn cả tài khoản khấu hao
            string sqlUpdateBP = $@"
                UPDATE ctbpts 
                SET ma_bpts = N'{sMaBp}', ngay_kh = {sNgayKh0}, 
                    tk_kh = N'{sTkKh}', tk_cp = N'{sTkCp}', 
                    ma_bpht = N'{sMaBpht}', ma_vv = N'{sMaVv}',
                    date = '{now:yyyy-MM-dd}', time = '{currentTime}', user_id = {curUser?.User_id ?? 0}
                WHERE so_the_ts = N'{sSoTheGoc}' AND ts0 = '1'";
            await myDb.ExecuteSqlQueryAsync(sqlUpdateBP);
        }
        // 7. Đóng form
        CloseForm();
    }
    catch (Exception ex)
    {
        myStateMN.SetNewThongbao("Lỗi khi lưu: " + ex.Message);
    }
}

    async Task<bool> CheckValid()
    {
        // ========================================================================
        // 1. KIỂM TRA THÔNG TIN MASTER (DMTS)
        // ========================================================================

        // [WinForm ID: 1180] Kiểm tra Mã rỗng
        if (string.IsNullOrEmpty(CurDmts.So_the_ts))
        {
            myStateMN.SetNewThongbao("Chưa vào mã tài sản!");
            return false;
        }

        // [WinForm ID: 1185] Kiểm tra Mã chứa khoảng trắng
        if (CurDmts.So_the_ts.Contains(" "))
        {
            myStateMN.SetNewThongbao("Mã tài sản không được chứa khoảng trắng!");
            return false;
        }

        // [WinForm ID: 1190 & 11900] Kiểm tra Trùng mã (Chỉ check khi Thêm mới/Copy)
        // Logic WinForm có check "Mã lồng nhau", ở đây ta check trùng tuyệt đối trước
        if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
        {
            // Kiểm tra trong DB
            string sqlCheck = $"SELECT COUNT(*) FROM {sqlTableName} WHERE {SqlTableKey} = '{CurDmts.So_the_ts}'";
            var ds = await myDb.LoadDataset(sqlCheck);
            if (ds != null && ds.Tables[0].Rows.Count > 0 && Convert.ToInt32(ds.Tables[0].Rows[0][0]) > 0)
            {
                myStateMN.SetNewThongbao("Mã tài sản đã có!");
                return false;
            }
        }

        // [WinForm ID: 1195] Kiểm tra Tên rỗng
        if (string.IsNullOrEmpty(CurDmts.Ten_ts))
        {
            myStateMN.SetNewThongbao("Chưa vào tên tài sản!");
            return false;
        }

        // [WinForm ID: 1200] Kiểm tra Loại tài sản (DM_LOAI_TS / DM_PL_TS)
        if (string.IsNullOrEmpty(CurDmts.Loai_ts))
        {
            myStateMN.SetNewThongbao("Chưa vào loại tài sản!");
            return false;
        }
        // Kiểm tra tồn tại trong danh mục
        if (!await CheckExistInTable("dmplts", "ma_loai", CurDmts.Loai_ts, "Loại tài sản")) return false;


        // [WinForm ID: 1205] Kiểm tra Lý do tăng (DM_TG_TS)
        if (string.IsNullOrEmpty(CurDmts.Ma_tg_ts))
        {
            myStateMN.SetNewThongbao("Chưa vào lý do tăng tài sản!");
            return false;
        }
        if (!await CheckExistInTable("dmtgts", "ma_tg_ts", CurDmts.Ma_tg_ts, "Lý do tăng")) return false;


        // [WinForm ID: 1210] Kiểm tra Ngày mua (Ngày tăng)
        if (!CurDmts.Ngay_mua.HasValue)
        {
            myStateMN.SetNewThongbao("Chưa vào ngày tăng tài sản!");
            return false;
        }

        // [WinForm ID: 1215] Kiểm tra Ngày bắt đầu tính Khấu hao
        if (!CurDmts.Ngay_kh0.HasValue)
        {
            myStateMN.SetNewThongbao("Chưa vào ngày tính khấu hao!");
            return false;
        }


        // [WinForm ID: 1220] Logic: Tháng tính KH không được nhỏ hơn Tháng tăng
        // Logic gốc: (Month + Year*13) > (Month + Year*13).
        // Ở đây ta so sánh ngày đầu tháng cho đơn giản và chính xác.
        DateTime dateMua = new DateTime(CurDmts.Ngay_mua.Value.Year, CurDmts.Ngay_mua.Value.Month, 1);
        DateTime dateKH = new DateTime(CurDmts.Ngay_kh0.Value.Year, CurDmts.Ngay_kh0.Value.Month, 1);

        if (dateKH < dateMua)
        {
            myStateMN.SetNewThongbao("Tháng tính khấu hao không được nhỏ hơn tháng tăng tài sản!");
            return false;
        }

        // [WinForm ID: 1225] Kiểm tra Bộ phận sử dụng (DM_BPTS)
        if (string.IsNullOrEmpty(CurDmts.Ma_bpts))
        {
            myStateMN.SetNewThongbao("Chưa vào bộ phận sử dụng tài sản!");
            return false;
        }
        if (!await CheckExistInTable("dmbpts", "ma_bp", CurDmts.Ma_bpts, "Bộ phận sử dụng")) return false;


        // [WinForm ID: 1235] Kiểm tra TK Khấu hao (DMTK)
        if (string.IsNullOrEmpty(CurDmts.Tk_kh))
        {
            myStateMN.SetNewThongbao("Chưa vào tài khoản khấu hao!");
            return false;
        }
        if (!await CheckExistInTable("dmtk", "tk", CurDmts.Tk_kh, "TK khấu hao")) return false;


        // [WinForm ID: 1240] Kiểm tra TK Chi phí (DMTK)
        if (string.IsNullOrEmpty(CurDmts.Tk_cp))
        {
            myStateMN.SetNewThongbao("Chưa vào tài khoản chi phí!");
            return false;
        }
        if (!await CheckExistInTable("dmtk", "tk", CurDmts.Tk_cp, "TK chi phí")) return false;

        // Kiểm tra Nhóm tài sản (nếu có nhập)
        if (!string.IsNullOrEmpty(CurDmts.Nh_ts))
        {
            if (!await CheckExistInTable("dmnhomts", "ma_nhom", CurDmts.Nh_ts, "Nhóm tài sản")) return false;
        }
        // Logic Winform: Tự động xóa dòng nếu tên phụ tùng trống
        if (LstPhuTung != null && LstPhuTung.Count > 0)
        {
            // RemoveAll tương đương với vòng lặp Remove trong mẫu bạn gửi
            LstPhuTung.RemoveAll(x => string.IsNullOrEmpty(x.Ten_ptkt?.Trim()));
        }
        if (LstChiTietGiaTri == null || LstChiTietGiaTri.Count == 0)
        {
            myStateMN.SetNewThongbao("Chưa nhập chi tiết nguồn vốn!");
            return false;
        }

        // DUYỆT TỪNG DÒNG ĐỂ KIỂM TRA
        foreach (var item in LstChiTietGiaTri)
        {
            // 1. Kiểm tra Ngày chứng từ (BẮT BUỘC)
            if (!item.Ngay_ct.HasValue)
            {
                // Báo lỗi chỉ đích danh dòng nào
                myStateMN.SetNewThongbao($"Dòng số {item.Stt}: Vui lòng nhập [Ngày chứng từ]!");
            
                // (Tùy chọn) Focus lại vào lưới để người dùng biết
                // await GridChiTiet.SetFocusedDataItemAsync(item); 
            
                return false; // Chặn lưu ngay lập tức
            }

            // 2. Kiểm tra Nguyên giá (Nếu bạn muốn bắt buộc nhập > 0)
            // Nếu logic của bạn cho phép nhập = 0 thì bỏ đoạn này đi
            /*
            if ((item.Nguyen_gia ?? 0) == 0)
            {
                myStateMN.SetNewThongbao($"Dòng số {item.Stt}: Chưa nhập [Nguyên giá]!");
                return false;
            }
            */
        }
        return true;
    }

    // --- 3. HÀM HỖ TRỢ CHECK TỒN TẠI (Giữ nguyên từ bài trước) ---
    async Task<bool> CheckExistInTable(string tableName, string fieldName, string value, string label)
    {
        if (string.IsNullOrEmpty(value)) return true;

        string sql = $"SELECT COUNT(*) FROM {tableName} WHERE {fieldName} = '{value.Trim()}'";
        try
        {
            var ds = await myDb.LoadDataset(sql);
            if (ds == null || ds.Tables.Count == 0 || Convert.ToInt32(ds.Tables[0].Rows[0][0]) == 0)
            {
                myStateMN.SetNewThongbao($"{label} [{value}] không tồn tại trong danh mục!");
                return false;
            }
        }
        catch
        {
            return true;
        }
        return true;
    }
    
