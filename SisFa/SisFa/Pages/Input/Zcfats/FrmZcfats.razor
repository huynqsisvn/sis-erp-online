@inherits FrmListBaseComponent
@using SisFa.Pages.Input.Zcfats
@using DevExpress.Blazor
@using System.Data
@using System.Linq
@inject IJSRuntime JSRuntime
@implements IDisposable
<FormList Title="@Title"
          @bind-curActionTask="@curActionTask"
          OnSave="@SaveDM"
          OnCancel="@CloseForm">

    <div class="row m-1 me-2" style="min-height: 290px; align-content: flex-start;">
        <DxFormLayout ItemSizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
            <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail" @bind-ActiveTabIndex="@ActiveTabIndex">
                <DxFormLayoutTabPage Caption="Thông tin chính" CaptionCssClass="fw-bold">
                    <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="mt-3">

                        @* --- DÒNG 1: MÃ TÀI SẢN (Chia 2 cột) --- *@
                        <DxFormLayoutItem Caption="Mã tài sản (số thẻ):" ColSpanMd="6" CaptionCssClass="fw-bold">
                            <Template>
                                <DxTextBox @ref="txtMaTaiSan" @bind-Text="@CurDmts.So_the_ts" CharacterCasing="CharacterCasing.Upper" Enabled="@AllowEditMa" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã phụ:" ColSpanMd="6">
                            <Template>
                                <DxTextBox @ref="txtMaPhu" @bind-Text="@CurDmts.Ma_tra_cuu" Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        @* --- DÒNG 2: TÊN TÀI SẢN (Trải dài full 100%) --- *@
                        <DxFormLayoutItem Caption="Tên tài sản:" ColSpanMd="12" CaptionCssClass="fw-bold">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmts.Ten_ts" Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>

                        @* ==========================================================
           TỪ ĐÂY TRỞ XUỐNG: CHIA 3 CỘT (ColSpanMd="4") ĐỂ RÚT NGẮN FORM
           ========================================================== *@

                        <DxFormLayoutItem Caption="Nhóm tài sản:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhomts" @bind-Value="@CurDmts.Nh_ts" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Loại tài sản:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmplts" @bind-Value="@CurDmts.Loai_ts" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Lý do tăng:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmtgts" @bind-Value="@CurDmts.Ma_tg_ts" Filter="loai_tg_ts = 1" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Ngày tăng:" ColSpanMd="4">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmts.Ngay_mua" Format="dd/MM/yyyy" Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã bpsd:" ColSpanMd="4">
                            <Template>
                                @* Hiển thị toàn bộ BPSD (không lọc theo ĐVCS) *@
                                <AutocompleteComponent Ma_dm="dmbpts" Filter="1=1" @bind-Value="@CurDmts.Ma_bpts" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Kiểu k.hao:" ColSpanMd="4">
                            <Template>
                                <DxComboBox Data="@ListKieuKH"
                                            Value="@CurDmts.Kieu_kh"
                                            ValueFieldName="Value"
                                            TextFieldName="Text"
                                            Enabled="@AllowEditMode"
                                            ValueChanged="@((string v) => OnKieuKhChanged(v))" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Số kỳ k.hao:" ColSpanMd="4" Visible="@(CurDmts.Kieu_kh == "1")">
                            <Template>
                                <DxSpinEdit Value="@CurDmts.So_ky_kh"
                                            DisplayFormat="N0"
                                            Enabled="@AllowEditMode"
                                            ValueChanged="@((decimal? v) => OnSoKyChanged(v))" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tổng sản lượng:" ColSpanMd="4" Visible="@(CurDmts.Kieu_kh == "2")">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmts.Tong_sl" DisplayFormat="N2" Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Ngày bắt đầu tính KH:" ColSpanMd="4">
                            <Template>
                                <DxDateEdit Date="@CurDmts.Ngay_kh0" Format="dd/MM/yyyy" Enabled="@AllowEditMode" DateChanged="@((DateTime? d) => { CurDmts.Ngay_kh0 = d; CalculateEndDate(); })" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="GTCL tính KH <= :" ColSpanMd="4">
                            @* Rút gọn caption một xíu cho đỡ chật *@
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmts.Tien_cl" DisplayFormat="N0" Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Ngày kết thúc k.hao:" ColSpanMd="4">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmts.Ngay_kt_kh" Format="dd/MM/yyyy" Enabled="@AllowEditMode" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tk khấu hao:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmtk" @bind-Value="@CurDmts.Tk_kh" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Tk chi phí:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmtk" @bind-Value="@CurDmts.Tk_cp" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã phí:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmphi" @bind-Value="@CurDmts.Ma_phi" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã bpht:" ColSpanMd="4">
                            <Template>
                                @* Hiển thị toàn bộ BPHT (không lọc theo ĐVCS) *@
                                <AutocompleteComponent Ma_dm="dmbpht" Filter="1=1" @bind-Value="@CurDmts.Ma_bpht" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Mã phân xưởng(cđ):" ColSpanMd="4">
                            <Template>
                                @* Hiển thị toàn bộ phân xưởng (không lọc theo ĐVCS) *@
                                <AutocompleteComponent Ma_dm="dmpx" Filter="1=1" @bind-Value="@CurDmts.Ma_px" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã dự án:" ColSpanMd="4">
                            <Template>
                                @* Hiển thị toàn bộ dự án (không lọc theo ĐVCS) *@
                                <AutocompleteComponent Ma_dm="dmvv" Filter="1=1" @bind-Value="@CurDmts.Ma_vv" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Phân nhóm 1:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhts1" @bind-Value="@CurDmts.Nh_ts1" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Phân nhóm 2:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhts2" @bind-Value="@CurDmts.Nh_ts2" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Phân nhóm 3:" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhts3" @bind-Value="@CurDmts.Nh_ts3" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã ĐVCS:" ColSpanMd="4">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmts.Ma_dvcs" ReadOnly="true" />
                            </Template>
                        </DxFormLayoutItem>

                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage>
                <DxFormLayoutTabPage Caption="Thông tin phụ" CaptionCssClass="fw-bold">
                        <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="mt-3">
                            <DxFormLayoutItem Caption="Biên bản giao nhận số:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.So_bbbg" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Ngày:" ColSpanMd="6">
                                <Template>
                                    <DxDateEdit Date="@CurDmts.Ngay_bbbg" Format="dd/MM/yyyy" Enabled="@AllowEditMode" DateChanged="@((DateTime? d) => CurDmts.Ngay_bbbg = d)" />
                                </Template>
                            </DxFormLayoutItem>

                            @* --- HÀNG 2: SỐ LƯỢNG & ĐVT --- *@
                            <DxFormLayoutItem Caption="Số lượng:" ColSpanMd="6">
                                <Template>
                                    <DxSpinEdit Value="@CurDmts.So_luong" DisplayFormat="N2" Enabled="@AllowEditMode" ValueChanged="@((decimal? v) => CurDmts.So_luong = v)" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Đvt:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.Dvt" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>

                            @* --- HÀNG 3: SỐ HIỆU & NƯỚC SX --- *@
                            <DxFormLayoutItem Caption="Số hiệu tài sản:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.So_hieu_ts" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Nước sản xuất:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.Nuoc_sx" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>

                            @* --- HÀNG 4: NĂM SX & THÔNG SỐ KT --- *@
                            <DxFormLayoutItem Caption="Năm sản xuất:" ColSpanMd="6">
                                <Template>
                                    <DxSpinEdit Value="@CurDmts.Nam_sx" DisplayFormat="####" Enabled="@AllowEditMode" ValueChanged="@((decimal? v) => CurDmts.Nam_sx = v)" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Thông số kỹ thuật:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.Ts_kt" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>

                            @* --- HÀNG 5: NGÀY SỬ DỤNG & NGÀY ĐÌNH CHỈ --- *@
                            <DxFormLayoutItem Caption="Ngày đưa vào SD:" ColSpanMd="6">
                                <Template>
                                    <DxDateEdit Date="@CurDmts.Ngay_dvsd" Format="dd/MM/yyyy" Enabled="@AllowEditMode" DateChanged="@((DateTime? d) => CurDmts.Ngay_dvsd = d)" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Ngày đình chỉ SD:" ColSpanMd="6">
                                <Template>
                                    <DxDateEdit Date="@CurDmts.Ngay_dc" Format="dd/MM/yyyy" Enabled="@AllowEditMode" DateChanged="@((DateTime? d) => CurDmts.Ngay_dc = d)" />
                                </Template>
                            </DxFormLayoutItem>

                            @* --- HÀNG 6: LÝ DO ĐÌNH CHỈ & TÊN 2 --- *@
                            <DxFormLayoutItem Caption="Lý do đình chỉ:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.Ly_do_dc" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Tên 2:" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.Ten_ts2" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>

                            @* --- HÀNG 7: GHI CHÚ (Full dòng) --- *@
                            <DxFormLayoutItem Caption="Ghi chú" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@CurDmts.Ghi_chu" Enabled="@AllowEditMode" />
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                    </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Phụ tùng kèm theo" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            @* 1. BỌC LƯỚI TRONG WRAPPER VÀ BẮT SỰ KIỆN LOST FOCUS *@
                            <div id="grid-wrapper-pt" @onfocusout="OnGridPhuTungLostFocus" class="mt-2 mb-3">
                                <DxGrid @ref="GridPhuTung"
                                        Data="@LstPhuTung"
                                        SizeMode="@Itemsizemode"
                                        CssClass="w-100 grid-height-dynamic"
                                        @onkeydown="GridPhuTung_OnKeyDown"
                                        AllowSelectRowByClick="true"
                                        KeyboardNavigationEnabled="true"
                                        @bind-SelectedDataItem="@SelectedDataItemPhuTung"
                                        ValidationEnabled="false"
                                        EditMode="GridEditMode.EditRow"
                                        RowClick="@StartEditDataItemByClickPT"
                                        SelectionMode="GridSelectionMode.Single"
                                        CustomizeEditModel="OnCustomizeEditModelPT"
                                        EditModelSaving="OnGridSavingPT"
                                        DataItemDeleting="OnGridDeletingPT"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        EditNewRowPosition="@(AllowEditMode ? GridEditNewRowPosition.LastRow : (GridEditNewRowPosition)(-1))"
                                        ShowAllRows="true"
                                        TextWrapEnabled="false"
                                        AllowSort="false"
                                        HighlightRowOnHover="true"
                                        FooterDisplayMode="GridFooterDisplayMode.Always">

                                    <Columns>
                                        @* 3. CỘT LỆNH: CHỐNG LỖI FOCUS BẰNG CÁCH ĐỂ TRỐNG EditTemplate *@
                                        <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                            <CellDisplayTemplate Context="gridCtx">
                                                <div class="grid-cell-align-center">
                                                    <a class="text-danger fw-bold cursor-pointer" tabindex="-1" @onclick="@(() => GridPhuTung.ShowRowDeleteConfirmation(gridCtx.VisibleIndex))" title="Xóa dòng">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </CellDisplayTemplate>
                                            <CellEditTemplate Context="gridCtx">
                                                @* ĐỂ TRỐNG ĐỂ DEVEXPRESS TỰ NHẢY SANG CỘT TÊN PHỤ TÙNG *@
                                            </CellEditTemplate>
                                        </DxGridCommandColumn>

                                        <DxGridDataColumn FieldName="Stt" Caption="Stt" Width="50px" ReadOnly="true" />

                                        <DxGridDataColumn FieldName="Ten_ptkt" Caption="Tên phụ tùng" MinWidth="200">
                                            <CellEditTemplate Context="gridCtx">
                                                @{
                                                    var item = (CtCtTs)gridCtx.EditModel;
                                                }
                                                <DxTextBox @bind-Text="@item.Ten_ptkt" NullText="Nhập tên phụ tùng..." CssClass="w-100" />
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        <DxGridDataColumn FieldName="Dvt" Caption="ĐVT" Width="100px">
                                            <CellEditTemplate Context="gridCtx">
                                                @{
                                                    var item = (CtCtTs)gridCtx.EditModel;
                                                }
                                                <DxTextBox @bind-Text="@item.Dvt" CssClass="w-100" />
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        <DxGridDataColumn FieldName="So_luong" Caption="Số lượng" Width="120px">
                                            <CellEditTemplate Context="gridCtx">
                                                @{
                                                    var item = (CtCtTs)gridCtx.EditModel;
                                                }
                                                <DxSpinEdit @bind-Value="@item.So_luong" DisplayFormat="N0" ShowSpinButtons="false" />
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        <DxGridDataColumn FieldName="Gia_tri" Caption="Giá trị" Width="150px">
                                            <CellEditTemplate Context="gridCtx">
                                                @{
                                                    var item = (CtCtTs)gridCtx.EditModel;
                                                }
                                                <DxSpinEdit @bind-Value="@item.Gia_tri" DisplayFormat="N0" ShowSpinButtons="false" />
                                            </CellEditTemplate>
                                        </DxGridDataColumn>
                                    </Columns>

                                </DxGrid>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>
            </DxFormLayoutTabPages>
        </DxFormLayout>
    </div>

    <div id="grid-detail" class="mt-2 m-1 me-2 border rounded p-2" >
                    <h6 class="fw-bold text-primary m-0 mb-1">Chi tiết giá trị Tài sản</h6>

                    @* ĐÃ XÓA THẺ DxFormLayoutItem VÀ Template GÂY LỖI, CHỈ GIỮ LẠI WRAPPER CỦA SOCTHDA *@
                    <div @ref="GridWrapperChiTiet" id="grid-wrapper" @onfocusout="OnGridChiTietLostFocus" class="mt-2 mb-3">

                        <DxGrid @ref="GridChiTiet"
                                Data="@LstChiTietGiaTri"
                                SizeMode="@Itemsizemode"
                                CssClass="w-100 grid-height-dynamic"
                                @onkeydown="GridChiTiet_OnKeyDown"
                                AllowSelectRowByClick="true"
                                KeyboardNavigationEnabled="true"
                                @bind-SelectedDataItem="@SelectedDataItemChiTiet"
                                ValidationEnabled="false"
                                EditMode="GridEditMode.EditRow"
                                RowClick="@StartEditDataItemByClickChiTiet"
                                SelectionMode="GridSelectionMode.Single"
                                CustomizeEditModel="Grid_CustomizeEditModelChiTiet"
                                EditModelSaving="Grid_EditModelSavingChiTiet"
                                DataItemDeleting="Grid_DataItemDeletingChiTiet"
                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                EditNewRowPosition="@(AllowEditMode ? GridEditNewRowPosition.LastRow : (GridEditNewRowPosition)(-1))"
                                ShowFilterRow="false"
                                ShowAllRows="true"
                                TextWrapEnabled="false"
                                AllowSort="false"
                                HighlightRowOnHover="true"
                                FooterDisplayMode="GridFooterDisplayMode.Always">

                            <Columns>
                                <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                    <CellDisplayTemplate Context="cntedit">
                                        <div class="grid-cell-align-center">
                                            <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      CssClass="grid-delete-btn"
                                                      aria-label="Delete"
                                                      Click="@(() => GridChiTiet.ShowRowDeleteConfirmation(cntedit.VisibleIndex))" />
                                        </div>
                                    </CellDisplayTemplate>
                                    <CellEditTemplate Context="cntedit1">
                                        <div class="grid-cell-align-center">
                                            <DxButton Enabled="false"
                                                      CssClass="grid-disabled-button"
                                                      IconCssClass="grid-icon grid-icon-delete"
                                                      aria-label="Delete"
                                                      RenderStyle="ButtonRenderStyle.Link" />
                                        </div>
                                    </CellEditTemplate>
                                </DxGridCommandColumn>
                                <DxGridDataColumn FieldName="Ngay_ct" Caption="Ngày c.từ" DisplayFormat="dd/MM/yyyy" Width="120px">
                                    <EditSettings><DxDateEditSettings Format="dd/MM/yyyy" /></EditSettings>
                                </DxGridDataColumn>

                                <DxGridDataColumn FieldName="So_ct" Caption="Số c.từ" Width="100px" />
                                <DxGridDataColumn FieldName="Dien_giai" Caption="Diễn giải" />

                                <DxGridDataColumn FieldName="Nguyen_gia" Caption="Nguyên giá" Width="130px">
                                    <CellEditTemplate Context="cellContext">
                                        @{
                                            var item = (CtDmts)cellContext.EditModel;
                                        }
                                        <DxSpinEdit Value="@item.Nguyen_gia" ShowSpinButtons="false" ValueChanged="@((decimal? v) => OnNguyenGiaChanged(v, item))" />
                                    </CellEditTemplate>
                                </DxGridDataColumn>

                                <DxGridDataColumn FieldName="Gt_da_kh" Caption="Gt đã k.hao" Width="130px">
                                    <CellEditTemplate Context="cellContext">
                                        @{
                                            var item = (CtDmts)cellContext.EditModel;
                                        }
                                        <DxSpinEdit Value="@item.Gt_da_kh" ShowSpinButtons="false" ValueChanged="@((decimal? v) => OnGtDaKhChanged(v, item))" />
                                    </CellEditTemplate>
                                </DxGridDataColumn>

                                <DxGridDataColumn FieldName="Gt_cl" Caption="Gt còn lại" DisplayFormat="N0" Width="130px">
                                    <CellEditTemplate Context="cellContext">
                                        @{
                                            var item = (CtDmts)cellContext.EditModel;
                                        }
                                        <DxSpinEdit Value="@item.Gt_cl" DisplayFormat="N0" ShowSpinButtons="false" ReadOnly="true" Enabled="false" />
                                    </CellEditTemplate>
                                </DxGridDataColumn>

                                <DxGridDataColumn FieldName="Gt_kh_ky" Caption="Gt k.hao 1 kỳ" DisplayFormat="N0" Width="130px" Visible="@(CurDmts.Kieu_kh == "1")">
                                    <CellEditTemplate Context="cellContext">
                                        @{
                                            var item = (CtDmts)cellContext.EditModel;
                                        }
                                        <DxSpinEdit Value="@item.Gt_kh_ky" DisplayFormat="N0" ShowSpinButtons="false" ReadOnly="true" Enabled="false" />
                                    </CellEditTemplate>
                                </DxGridDataColumn>

                                <DxGridDataColumn FieldName="Gt_da_kh0" Caption="Gt k.hao đến đk" DisplayFormat="N0" Width="130px" Visible="@(CurDmts.Kieu_kh == "2" && curActionTask == ActionTask.View)">
                                    <CellEditTemplate Context="cellContext">
                                        @{
                                            var item = (CtDmts)cellContext.EditModel;
                                        }
                                        <DxSpinEdit Value="@item.Gt_da_kh0" DisplayFormat="N0" ShowSpinButtons="false" ValueChanged="@((decimal? v) => OnGtDaKh0Changed(v, item))" />
                                    </CellEditTemplate>
                                </DxGridDataColumn>

                                <DxGridDataColumn FieldName="Ma_nv" Caption="Mã nguồn vốn" Width="200px">
                                    <CellEditTemplate Context="cellContext">
                                        @{
                                            var item = (CtDmts)cellContext.EditModel;
                                        }
                                        <DxComboBox Data="@LsNguonVon" @bind-Value="@item.Ma_nv" ValueFieldName="ma_item" TextFieldName="ten_item" FilteringMode="DataGridFilteringMode.Contains" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" NullText="Chọn nguồn vốn..." CssClass="w-100">
                                            <Columns>
                                                <DxListEditorColumn FieldName="ma_item" Caption="Mã" Width="50px" />
                                                <DxListEditorColumn FieldName="@(IsLangEn ? "ten_item2" : "ten_item")" Caption="Tên nguồn vốn" />
                                            </Columns>
                                        </DxComboBox>
                                    </CellEditTemplate>
                                </DxGridDataColumn>
                            </Columns>

                            <TotalSummary>
                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="Stt" />
                            </TotalSummary>
                        </DxGrid>
                    </div>
        
        </div> 
</FormList>

<style>
    .css-detail {
        /* Xóa height: auto; Thay bằng min-height */
        /* Bạn có thể tăng giảm 380px này sao cho vừa khít với Tab Thông tin chính của bạn */
