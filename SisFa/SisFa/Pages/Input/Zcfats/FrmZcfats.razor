    async Task HandleGridKeyDown<T>(KeyboardEventArgs e, DxGrid grid, List<T> list, object selectedItem, 
                                    Func<Task> onEnterAction, Action onAddAction)
    {
        if (!AllowEditMode) return;

        switch (e.Key)
        {
            case "Enter":
                await onEnterAction(); // Gọi hàm Save & Next riêng của từng lưới
                break;
            case "F4":
                onAddAction();
                break;
            case "F8":
                if (selectedItem != null)
                {
                    // Dùng ShowDataItemDeleteConfirmation tiện hơn ShowRowDeleteConfirmation
                    grid.ShowDataItemDeleteConfirmation(selectedItem);
                }
                break;
            case "Escape":
                try 
                { 
                    await grid.CancelEditAsync();
                    // Logic xóa dòng rác nếu hủy dòng mới thêm (Generic)
                    if (list.Count > 0 && selectedItem is T item)
                    {
                        // Kiểm tra logic dòng rác: ở đây ta check tạm nếu property đầu tiên null hoặc = 0
                        // Hoặc bạn có thể truyền thêm Func<T, bool> để check điều kiện xóa
                        grid.ClearSelection(); 
                    }
                } catch { }
                break;
        }
    }

    // 2. Xử lý Logic Save & Move Next chung
    async Task HandleSaveAndMoveNext<T>(DxGrid grid, List<T> list, object selectedItem, Action onAddAction)
    {
        if (grid != null && grid.IsEditing())
            await grid.SaveChangesAsync();

        // Chờ 1 chút để lưới đồng bộ hoàn tất (Quan trọng)
        await Task.Delay(100);

        if (selectedItem != null && selectedItem is T currentItem)
        {
            var index = list.IndexOf(currentItem);
            // Nếu chưa phải dòng cuối -> Xuống dòng kế tiếp
            if (index >= 0 && index < list.Count - 1)
            {
                await grid.StartEditDataItemAsync(list[index + 1]);
            }
            else
            {
                // Dòng cuối -> Thêm dòng mới
                onAddAction();
            }
        }
        else
        {
            onAddAction();
        }
    }

    // 3. Xử lý Click dòng để sửa chung
    void HandleStartEditByClick(GridRowClickEventArgs e, DxGrid grid)
    {
        if (AllowEditMode)
        {
            var item = grid.GetDataItem(e.VisibleIndex);
            if (item != null) grid.StartEditDataItemAsync(item);
        }
    }
