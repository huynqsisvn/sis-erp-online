    // =========================================================================
    // 2. ONAFTERRENDERASYNC: ĐĂNG KÝ PHÍM TẮT QUA JAVASCRIPT
    // =========================================================================
    private DotNetObjectReference<FrmZcfats> Pageobj;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // --- Logic cũ của bạn ---
            switch (curActionTask)
            {
                case ActionTask.New: CreateNewDM(); break;
                case ActionTask.Edit:
                case ActionTask.View: if (!string.IsNullOrEmpty(Ma_ma)) await LoadData(Ma_ma); break;
                case ActionTask.Copy: if (!string.IsNullOrEmpty(Ma_ma)) await CopyDM(Ma_ma); break;
            }
            StateHasChanged();

            // --- Lời sếp dặn: Đăng ký JS Interop ---
            Pageobj = DotNetObjectReference.Create(this);
            await JavacriptS.InvokeVoidAsync("SetPageObj", Pageobj);
            await JavacriptS.InvokeVoidAsync("AttachEnterAsTab");
            await Task.Delay(200);

            if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
            {
                // Nếu là Thêm mới hoặc Sao chép -> Nháy vào ô Mã tài sản
                if (txtMaTaiSan != null)
                {
                    await txtMaTaiSan.FocusAsync();
                }
            }
            else if (curActionTask == ActionTask.Edit)
            {
                // Nếu là Sửa -> Nháy vào ô Mã phụ (vì mã chính bị khóa)
                if (txtMaPhu != null)
                {
                    await txtMaPhu.FocusAsync();
                }
            }
            // (Tùy chọn: Focus vào ô đầu tiên của bạn, ví dụ ô nhập Mã tài sản)
            // await JavacriptS.InvokeVoidAsync("eval", "document.getElementById('txtMaTaiSan')?.focus()");
        }

        // Lời sếp dặn: Đặt lệnh đổi chữ ở ngoài if (firstRender)
        if (AllowEditMode)
        {
            try
            {
                await JavacriptS.InvokeVoidAsync("changeTextNewRowButton", "Click vào đây để thêm dòng mới");
            }
            catch { }
        }
    }

    // 3. Hàm sếp nhắc nhở: JSInvokable để Javascript gọi lại C# khi click vào chữ
    [JSInvokable]
    public void CallGridEditMode(string value)
    {
        if (AllowEditMode)
        {
            // ActiveTabIndex == 2 là tab "Phụ tùng kèm theo"
            if (ActiveTabIndex == 2) 
                AddNewPhuTung();
            else 
                AddNewChiTiet();
                
            StateHasChanged();
        }
    }
    // =========================================================================
    // 3. CÁC HÀM XỬ LÝ FOCUS VÀ PHÍM TẮT (GIỐNG Y HỆT SOCTHDA)
    // =========================================================================
    async void OnGridChiTietLostFocus(FocusEventArgs e)
    {
        try
        {
            // ID "grid-wrapper" ở đây phải khớp 100% với HTML ở trên
            // Nếu chuột vẫn ở trong grid-wrapper (đang click vào ô nhập liệu) -> Không làm gì cả
            bool stillInside = await JavacriptS.InvokeAsync<bool>("focusInside", "grid-wrapper");
            if (stillInside)
                return;

            // Nếu click ra ngoài hẳn -> Tự động lưu dòng
            if (GridChiTiet != null && GridChiTiet.IsEditing())
                await GridChiTiet.SaveChangesAsync();
        }
        catch { }
    }
    async void OnGridPhuTungLostFocus(FocusEventArgs e)
    {
        try
        {
            // Nhớ truyền đúng ID lưới phụ tùng
            bool stillInside = await JavacriptS.InvokeAsync<bool>("focusInside", "grid-wrapper-pt");
            if (stillInside)
                return;

            if (GridPhuTung != null && GridPhuTung.IsEditing())
                await GridPhuTung.SaveChangesAsync();
        }
        catch { }
    }

    // 2. HÀM XỬ LÝ NHẢY DÒNG / THÊM DÒNG KHI ẤN ENTER
    [JSInvokable]
    public async Task SaveAndMoveNextRow()
    {
        if (!AllowEditMode || GridChiTiet == null) return;

        // Lưu dòng hiện tại trước
        if (GridChiTiet.IsEditing())
            await GridChiTiet.SaveChangesAsync();

        // Chờ 1 chút để lưới đồng bộ hoàn tất
        await Task.Delay(100);

        if (SelectedDataItemChiTiet != null)
        {
            var currentItem = (CtDmts)SelectedDataItemChiTiet;
            var index = LstChiTietGiaTri.IndexOf(currentItem);

            // Nếu chưa phải dòng cuối -> Xuống dòng kế tiếp
            if (index >= 0 && index < LstChiTietGiaTri.Count - 1)
            {
                await GridChiTiet.StartEditDataItemAsync(LstChiTietGiaTri[index + 1]);
            }
            else
            {
                // Nếu đang ở dòng cuối cùng -> Thêm dòng mới
                AddNewChiTiet();
            }
        }
        else
        {
            AddNewChiTiet();
        }
    }

    // 3. BẮT SỰ KIỆN PHÍM ENTER TRÊN LƯỚI
    private async Task GridChiTiet_OnKeyDown(KeyboardEventArgs e)
    {
        if (!AllowEditMode) return;
        switch (e.Key)
        {
            case "Enter":
                // Giao việc nhảy/thêm dòng cho hàm chuyên dụng
                await SaveAndMoveNextRow();
                break;
            case "F4":
                AddNewChiTiet();
                break;
            case "F8":
                if (SelectedDataItemChiTiet != null)
                    GridChiTiet.ShowDataItemDeleteConfirmation(SelectedDataItemChiTiet);
                break;
            case "Escape":
                try { await GridChiTiet.CancelEditAsync(); } catch { }
                break;
        }
    }

    // =========================================================================
    // 4. CÁC HÀM [JSINVOKABLE] ĐỂ JAVASCRIPT GỌI NGƯỢC LẠI C#
    // =========================================================================
    
    // =========================================================================
    // 5. CÁC HÀM CLICK CHUỘT VÀ CRUD LƯỚI
    // =========================================================================
    async Task StartEditDataItemByClickChiTiet(GridRowClickEventArgs e)
    {
        if (!AllowEditMode) return;

        // 1. Lưu dòng cũ đang sửa dở (nếu có)
        if (GridChiTiet.IsEditing())
            await GridChiTiet.SaveChangesAsync();

        // 2. Tìm dữ liệu của dòng vừa click thông qua vị trí VisibleIndex
        var item = GridChiTiet.GetDataItem(e.VisibleIndex);

        // 3. Mở chế độ nhập liệu cho dòng đó
        if (item != null)
            await GridChiTiet.StartEditDataItemAsync(item);
    }
