@page "/zcfats2"
@page "/zcfats2/{Menu_id}"
@inherits ListBaseComponent
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using System.Data.OleDb
@using System.Diagnostics;
@using System.Data.SqlClient;
@using SisLib.List
@using Microsoft.Extensions.Localization
@using DevExpress.Blazor
@attribute [Authorize(Roles = "admin,zcfats2")]

<div class="row mt-1">
    @* bảng danh sách dữ liệu *@
    <FrmBrowseComponent @ref="oBrowse" TblData="@TblData" Fbrowse="@fbrowse" Page_size="@Page_size" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>
@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="60vw"
              MinWidth="600px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}
@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible" List_ID="@sqlTableName" Ma_ma="@SqlTableKeyValue" Title="@Lap["Change Item code"]" Ten_item="@Ten_item" OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {
    string Ma_dvcs = "";

    protected override void OnInitialized()
    {
        mPage = "zcfats2";
        sqlTableName = "dmts";
        sqlTableView = "v_dmts"; // Bạn có thể để v_dmts hoặc dmts tùy ý, miễn là logic Loaddata dùng dmts
        SqlTableKey = "so_the_ts";
        SqlItemName = "so_the_ts";
        IsShowCopy = true;
        FrmType = typeof(Input.Zcfats2.FrmZcfats2);

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "wf.ct.02";

        myStateMN.OnActionTaskChanged += OnActionTaskchanged;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", curCommand.Ma_phan_he.Trim().ToLower(), UserLang.Trim()));

            string Menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(Menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("View", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged; // <--- Đăng ký sự kiện

            // Load lần đầu
            await Loaddata();
            StateHasChanged();
        }
    }

    public async void CloseForm()
    {
        IsShowFrm = false;
        await Loaddata();
        StateHasChanged();
    }

    public override async Task PageLoad()
    {
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        if (curCommand != null)
        {
            fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
            // Đảm bảo lấy Page_size an toàn
            string pSize = myOption.GetOptionsValue("M_GRID_NROW");
            Page_size = string.IsNullOrEmpty(pSize) ? 50 : int.Parse(pSize.Trim());
        }
        StateHasChanged();
    }

    // --- HÀM LOAD DATA ĐÃ CHUẨN ---
    public override async Task Loaddata()
    {
        // 1. Lấy mã đơn vị từ hệ thống
        Ma_dvcs = myStateMN.GetMa_Dvcs();

        // 2. Xử lý bộ lọc
        string preFilter = "1=1"; // Mặc định lấy hết

        // Chỉ lọc khi có mã và KHÁC "ALL"
        if (!string.IsNullOrEmpty(Ma_dvcs) && !Ma_dvcs.Equals("ALL"))
        {
            preFilter = $" ma_dvcs LIKE '{Ma_dvcs.Trim()}%'";
        }

        // 3. Câu lệnh SQL: Lấy từ bảng dmts, sắp xếp mới nhất lên đầu
        string sql = $"SELECT * FROM {sqlTableName} WHERE {preFilter} ORDER BY so_the_ts DESC";

        try
        {
            DataSet dsList = await myDb.LoadDataset(sql);
            if (dsList != null && dsList.Tables.Count > 0)
            {
                TblData = dsList.Tables[0];
                if (TblData.DefaultView.Count > 0)
                    SelectedItem = TblData.DefaultView[0];
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi LoadData: " + ex.Message);
        }

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }

    // --- HÀM SỬA LẠI: ON DVCS CHANGED ---
    private async void OnDvcsChanged(string _ma_dvcs)
    {
        // SỬA: Luôn gọi Loaddata bất kể là mã gì hay là ALL
        // Vì trong Loaddata đã có logic xử lý "ALL" -> "1=1" rồi.
        await Loaddata();
        StateHasChanged();
    }

    public override async void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
        base.Dispose();
    }

}

