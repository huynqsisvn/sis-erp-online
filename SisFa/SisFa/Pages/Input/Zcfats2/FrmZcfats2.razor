    }

    async Task SaveGiamCustom_DC()
    {
        // 1. Validate dựa trên Winform nhánh "GIAM"
        if (string.IsNullOrEmpty(editItemGiam_DC.Ma_tg_ts)) { myStateMN.SetNewThongbao("Chưa vào mã lý do giảm!"); return; }
        if (!editItemGiam_DC.Ngay_tg.HasValue) { myStateMN.SetNewThongbao("Chưa vào ngày giảm!"); return; }
        if (!editItemGiam_DC.Ngay_thoi_kh.HasValue) { myStateMN.SetNewThongbao("Chưa vào ngày thôi khấu hao!"); return; }
        if (CurDmts.Ngay_mua.HasValue && editItemGiam_DC.Ngay_tg.Value.Date < CurDmts.Ngay_mua.Value.Date) { myStateMN.SetNewThongbao("Ngày giảm phải sau ngày mua!"); return; }

        string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
        string sMaTg = editItemGiam_DC.Ma_tg_ts?.Replace("'", "''") ?? "";
        string sNgayTg = editItemGiam_DC.Ngay_tg.HasValue ? $"'{editItemGiam_DC.Ngay_tg.Value:yyyy-MM-dd}'" : "NULL";
        string sNgayCt = editItemGiam_DC.Ngay_ct.HasValue ? $"'{editItemGiam_DC.Ngay_ct.Value:yyyy-MM-dd}'" : "NULL";
        string sNgayThoiKh = editItemGiam_DC.Ngay_thoi_kh.HasValue ? $"'{editItemGiam_DC.Ngay_thoi_kh.Value:yyyy-MM-dd}'" : "NULL";

        // Map Ngày KH = Ngày thôi KH giống hệt logic Winform
        string sNgayKh = sNgayThoiKh;

        string sSoCt = editItemGiam_DC.So_ct?.Replace("'", "''") ?? "";
        string sDienGiai = editItemGiam_DC.Dien_giai?.Replace("'", "''") ?? "";
        string sMaNv = editItemGiam_DC.Ma_nv?.Replace("'", "''") ?? "";
        string sNG = (editItemGiam_DC.Nguyen_gia ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sDKH = (editItemGiam_DC.Gt_da_kh ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sCL = (editItemGiam_DC.Gt_cl ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sSoKy = (editItemGiam_DC.So_ky ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sKHKy = (editItemGiam_DC.Gt_kh_ky ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);

        string sDate = $"'{DateTime.Now:yyyy-MM-dd}'";
        string sTime = $"'{DateTime.Now:HH:mm:ss}'";
        string sUserId = (curUser?.User_id ?? 0).ToString();

        if (isNewGiam_DC)
        {
            // LƯU Ý: Giảm thì dùng Audit _giam0 và _giam
            string sqlInsert = $@"
                INSERT INTO ctdmts (so_the_ts, tang_giam, ma_tg_ts, ngay_tg, ngay_ct, so_ct, dien_giai,
                                    nguyen_gia, gt_da_kh, gt_cl, so_ky, gt_kh_ky, ngay_kh, ngay_thoi_kh, ma_nv, ts0,
                                    date_giam0, time_giam0, user_id_giam0, date_giam, time_giam, user_id_giam)
                VALUES (N'{sSoThe}', '2', N'{sMaTg}', {sNgayTg}, {sNgayCt}, N'{sSoCt}', N'{sDienGiai}',
                        {sNG}, {sDKH}, {sCL}, {sSoKy}, {sKHKy}, {sNgayKh}, {sNgayThoiKh}, N'{sMaNv}', '0',
                        {sDate}, {sTime}, {sUserId}, {sDate}, {sTime}, {sUserId})";
            await myDb.ExecuteSqlQueryAsync(sqlInsert);
        }
        else
        {
            string sqlUpdate = $@"
                UPDATE ctdmts SET
                    ma_tg_ts = N'{sMaTg}', ngay_tg = {sNgayTg}, ngay_ct = {sNgayCt}, so_ct = N'{sSoCt}',
                    dien_giai = N'{sDienGiai}', nguyen_gia = {sNG}, gt_da_kh = {sDKH}, gt_cl = {sCL},
                    so_ky = {sSoKy}, gt_kh_ky = {sKHKy}, ngay_kh = {sNgayKh}, ngay_thoi_kh = {sNgayThoiKh}, ma_nv = N'{sMaNv}',
                    date_giam = {sDate}, time_giam = {sTime}, user_id_giam = {sUserId}
                WHERE id = {editItemGiam_DC.Id}";
            await myDb.ExecuteSqlQueryAsync(sqlUpdate);
        }

        // Cập nhật Master Data (Tổng)
        await UpdateMasterTotalValue(CurDmts.So_the_ts);

        isShowPopupGiam_DC = false;
        await LoadData(CurDmts.So_the_ts);
        myStateMN.SetNewThongbao("Đã lưu Điều chỉnh giảm thành công!");
    }

    CtDcTs itemToDeleteGiam_DC = null;
    void ConfirmXoaGiam_DC(CtDcTs item)
    {
        itemToDeleteGiam_DC = item;
        PopupConfirmMessage = "Bạn có chắc chắn muốn xóa dòng Điều chỉnh giảm này không?";
