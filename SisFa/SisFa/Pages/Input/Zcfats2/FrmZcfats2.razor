    async Task SaveGiamPopup()
    {
        bool hasMaGiam = !string.IsNullOrWhiteSpace(editGiamTs.Ma_giam_ts);
        bool hasNgayGiam = editGiamTs.Ngay_giam.HasValue;

        if (hasMaGiam && !hasNgayGiam) { myStateMN.SetNewThongbao("Vui lòng nhập Ngày giảm!"); return; }
        if (!hasMaGiam && hasNgayGiam) { myStateMN.SetNewThongbao("Vui lòng chọn Mã giảm!"); return; }
