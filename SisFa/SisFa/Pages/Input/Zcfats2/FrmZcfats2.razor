    async Task XoaThongTinGiam_DC()
    {
        if (itemToDeleteGiam_DC != null)
        {
            await myDb.ExecuteSqlQueryAsync($"DELETE FROM ctdmts WHERE id = {itemToDeleteGiam_DC.Id}");
            await UpdateMasterTotalValue(CurDmts.So_the_ts); // Xóa xong phải tính lại tổng
            await LoadData(CurDmts.So_the_ts);
            myStateMN.SetNewThongbao("Đã xóa Điều chỉnh giảm thành công!");
        }
    }
    void CalculateGiam()
    {
        decimal nGia = editItemGiam_DC.Nguyen_gia ?? 0;
        decimal daKh = editItemGiam_DC.Gt_da_kh ?? 0;
        decimal soKy = editItemGiam_DC.So_ky ?? 0;

        // 1. Tính giá trị còn lại
        editItemGiam_DC.Gt_cl = nGia - daKh;

        // 2. CHỈ TÍNH KHẤU HAO KỲ NẾU LÀ ĐƯỜNG THẲNG
        if (CurDmts.Kieu_kh == "1" && soKy > 0)
        {
            editItemGiam_DC.Gt_kh_ky = Math.Round((editItemGiam_DC.Gt_cl ?? 0) / soKy, 0, MidpointRounding.AwayFromZero);
        }
        else
        {
            editItemGiam_DC.Gt_kh_ky = 0; // Sản lượng thì luôn bằng 0
        }
    }

    void OnNguyenGiaGiamChanged(decimal? v) { editItemGiam_DC.Nguyen_gia = v; CalculateGiam(); }
    void OnDaKhGiamChanged(decimal? v) { editItemGiam_DC.Gt_da_kh = v; CalculateGiam(); }
    void OnSoKyGiamChanged(decimal? v) { editItemGiam_DC.So_ky = v; CalculateGiam(); }
