    public List<CtDcTs> LstDieuChinhGiam { get; set; } = new List<CtDcTs>();
    public List<CtTsThoiKc> LstTamDung { get; set; } = new List<CtTsThoiKc>();
    public List<CtBpts> LstDieuChuyen { get; set; } = new List<CtBpts>();

    // Danh sách từ điển dùng cho combobox
    private List<listItem> LsBpts; // dmbpts
    private List<listItem> LsTk;   // dmtk
    private List<listItem> LsBpht; // dmbpht
    private List<listItem> LsVv;   // dmvv
    private List<listItem> LsMaGiam;
    private List<listItem> LsMaTang;
    public Dmts CurDmts { get; set; } = new Dmts();
    public List<CtCtTs> LstPhuTung { get; set; } = new List<CtCtTs>();
    public List<CtDmts> LstChiTietGiaTri { get; set; } = new List<CtDmts>();
    private List<listItem> LsNguonVon;
    List<object> ListKieuKH = new List<object>() {
        new { Value = "1", Text = "1. Đường thẳng" },
        new { Value = "2", Text = "2. Sản lượng" }
    };

    protected override void OnInitialized()
    {
        sqlTableName = "dmts";
        SqlTableKey = "so_the_ts";
        // Kích thước vừa phải, dễ nhìn
        Itemsizemode = SizeMode.Medium;
        base.OnInitialized();
    }

    async Task LoadData(string id)
    {
        // 1. GỌI STORE PROCEDURE "LoadFATS" 1 LẦN DUY NHẤT
        // SP này trả về nhiều Table, ta sẽ lấy dữ liệu từ đây map vào các lưới
        string sqlLoad = $"exec LoadFATS @so_the_ts = '{id}'";
        DataSet dsFats = await myDb.LoadDataset(sqlLoad);

        if (dsFats != null && dsFats.Tables.Count > 0)
        {
            // --- TABLE 0: THÔNG TIN CHÍNH (MASTER) ---
            if (dsFats.Tables[0].Rows.Count > 0)
            {
                var list = myDb.ConvertDataTable<Dmts>(dsFats.Tables[0]);
                CurDmts = list[0];
            }

            // --- TABLE 1: CHI TIẾT GIÁ TRỊ (Cũ + Mới) ---
            if (dsFats.Tables.Count > 1)
            {
                var allRows = myDb.ConvertDataTable<CtDmts>(dsFats.Tables[1]);
                // Lọc chỉ lấy dòng giá trị ban đầu (ts0 = '1') giống Winform
                LstChiTietGiaTri = allRows.Where(x => x.Ts0 == "1").ToList();
                // Đánh STT
                int stt = 1; LstChiTietGiaTri.ForEach(x => x.Stt = stt++);
            }

            // --- TABLE 2: PHỤ TÙNG KÈM THEO ---
            if (dsFats.Tables.Count > 2)
            {
                LstPhuTung = myDb.ConvertDataTable<CtCtTs>(dsFats.Tables[2]);
                int stt = 1; LstPhuTung.ForEach(x => x.Stt = stt++);
            }

            // --- TABLE 4: TẠM DỪNG KHẤU HAO (Thay vì query dmtsthoikc thủ công) ---
            if (dsFats.Tables.Count > 4)
            {
                LstTamDung = myDb.ConvertDataTable<CtTsThoiKc>(dsFats.Tables[4]);
                int stt = 1; LstTamDung.ForEach(x => x.Stt = stt++);
            }

            // --- TABLE 6: ĐIỀU CHUYỂN BỘ PHẬN ---
            if (dsFats.Tables.Count > 6)
            {
                LstDieuChuyen = myDb.ConvertDataTable<CtBpts>(dsFats.Tables[6]);
                int stt = 1; LstDieuChuyen.ForEach(x => x.Stt = stt++);
            }

            // --- TABLE 7: ĐIỀU CHỈNH TĂNG ---
            if (dsFats.Tables.Count > 7)
            {
                LstDieuChinhTang = myDb.ConvertDataTable<CtDcTs>(dsFats.Tables[7]);
                // Map dữ liệu nếu cần (ví dụ user_name -> User_name_tang) 
                // nhưng thường ConvertDataTable đã tự map nếu tên cột trùng tên thuộc tính
                int stt = 1; LstDieuChinhTang.ForEach(x => x.Stt = stt++);
            }

            // --- TABLE 8: ĐIỀU CHỈNH GIẢM ---
            if (dsFats.Tables.Count > 8)
            {
                LstDieuChinhGiam = myDb.ConvertDataTable<CtDcTs>(dsFats.Tables[8]);
                int stt = 1; LstDieuChinhGiam.ForEach(x => x.Stt = stt++);
            }
        }

        // 2. XỬ LÝ TRẠNG THÁI FORM (Giữ nguyên)
        if (curActionTask == ActionTask.Edit)
        {
            AllowEditMa = false;
        }
        AllowEditMode = (curActionTask != ActionTask.View);
    }

    //Hàm phụ trợ copy dữ liệu
    public static class Copier
    {
        public static void CopyPropertiesTo<T>(T source, T dest)
        {
            var props = typeof(T).GetProperties();
            foreach (var prop in props)
            {
                if (prop.CanRead && prop.CanWrite)
                    prop.SetValue(dest, prop.GetValue(source));
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        switch (curActionTask)
        {
            case ActionTask.View:
                if (!string.IsNullOrEmpty(Ma_ma)) await LoadData(Ma_ma);
                break;
        }
        string sqlNV = @"
            SELECT
                RTRIM(ma_nv) AS ma_item,
                ISNULL(ten_nv, '') AS ten_item,
                ISNULL(ten_nv2, '') AS ten_item2
            FROM dmnv
            ORDER BY ma_nv"; // Sắp xếp cho dễ tìm

        try
        {
            // Load dữ liệu vào biến
            LsNguonVon = await mySqldb.Loaddata<listItem, dynamic>(sqlNV, new { });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi load Nguồn vốn: " + ex.Message);
        }
        try 
        {
             // Load Bộ phận (dmbpts)
             LsBpts = await mySqldb.Loaddata<listItem, dynamic>("SELECT ma_bpts AS ma_item, ten_bpts AS ten_item FROM dmbpts", new { });             // Load Tài khoản (dmtk)
             LsTk = await mySqldb.Loaddata<listItem, dynamic>("SELECT tk AS ma_item, ten_tk AS ten_item FROM dmtk", new { });
             // Load Bộ phận hạch toán (dmbpht)
             LsBpht = await mySqldb.Loaddata<listItem, dynamic>("SELECT ma_bpht AS ma_item, ten_bpht AS ten_item FROM dmbpht", new { });
             // Load Vụ việc (dmvv)
             LsVv = await mySqldb.Loaddata<listItem, dynamic>("SELECT ma_vv AS ma_item, ten_vv AS ten_item FROM dmvv", new { });
             LsMaGiam = await mySqldb.Loaddata<listItem, dynamic>("SELECT ma_tg_ts AS ma_item, ten_tg_ts AS ten_item FROM dmtgts WHERE loai_tg_ts = 2", new { });
            LsMaTang = await mySqldb.Loaddata<listItem, dynamic>("SELECT ma_tg_ts AS ma_item, ten_tg_ts AS ten_item FROM dmtgts WHERE loai_tg_ts = 1", new { });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi load danh mục: " + ex.Message);
        }
    }
    // =========================================================================
    // LOGIC CỦA Xác nhận xóa
    // =========================================================================

    bool PopupConfirmVisible { get; set; } = false;
    string PopupConfirmMessage { get; set; } = "";
    Func<Task> OnConfirmAction { get; set; } // Biến lưu "Hành động sắp làm"

    // 1. NÚT XÓA GIẢM TÀI SẢN (Gắn vào nút Xóa ở tab Giảm)
    void ConfirmXoaGiam()
    {
        if (string.IsNullOrEmpty(CurDmts.Ma_giam_ts) && !CurDmts.Ngay_giam.HasValue) return;
        PopupConfirmMessage = "Bạn có chắc chắn muốn xóa thông tin Giảm tài sản này không?";
        OnConfirmAction = XoaThongTinGiam;
