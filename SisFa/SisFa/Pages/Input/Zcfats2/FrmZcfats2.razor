                                            @if (item != null && item.Ts0 != "1")
                                            {
                                                <a class="text-primary fw-bold cursor-pointer" @onclick="@(() => OpenEditTang(item))" title="Sửa"><i class="fa fa-edit"></i></a>
                                                <a class="text-danger fw-bold cursor-pointer" @onclick="@(() => ConfirmXoaTang(item))" title="Xóa dòng"><i class="fa fa-trash"></i></a>
