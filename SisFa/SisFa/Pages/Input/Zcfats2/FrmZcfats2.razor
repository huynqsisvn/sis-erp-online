        // Chuẩn bị dữ liệu SQL
        string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
        string sMaGiam = editGiamTs.Ma_giam_ts?.Replace("'", "''") ?? "";
        string sNgayGiam = editGiamTs.Ngay_giam.HasValue ? $"'{editGiamTs.Ngay_giam.Value:yyyy-MM-dd}'" : "NULL";
        string sNgayKh1 = editGiamTs.Ngay_kh1.HasValue ? $"'{editGiamTs.Ngay_kh1.Value:yyyy-MM-dd}'" : "NULL";
        string sSoCt = editGiamTs.So_ct?.Replace("'", "''") ?? "";
        string sLyDo = editGiamTs.Ly_do_giam?.Replace("'", "''") ?? "";
        
        string sDate = $"'{DateTime.Now:yyyy-MM-dd}'";
        string sTime = $"'{DateTime.Now:HH:mm:ss}'";
        string sUserId = (curUser?.User_id ?? 0).ToString();
        string sUserName = (curUser?.User_name ?? "").Replace("'", "''");

        // Câu lệnh SQL: Dùng ISNULL/CASE WHEN để bảo toàn thông tin Người tạo (0) giống Winform
        string sqlUpdate = $@"
            UPDATE dmts SET 
                ma_giam_ts = N'{sMaGiam}', ngay_giam = {sNgayGiam}, ngay_kh1 = {sNgayKh1},
                so_ct = N'{sSoCt}', ly_do_giam = N'{sLyDo}',
                date_giam0 = ISNULL(date_giam0, {sDate}), 
                time_giam0 = CASE WHEN ISNULL(time_giam0, '') = '' THEN {sTime} ELSE time_giam0 END, 
                user_id_giam0 = CASE WHEN ISNULL(user_id_giam0, 0) = 0 THEN {sUserId} ELSE user_id_giam0 END,
                date_giam = {sDate}, time_giam = {sTime}, 
                user_id_giam = {sUserId}
            WHERE so_the_ts = N'{sSoThe}'";

        await myDb.ExecuteSqlQueryAsync(sqlUpdate);
        await LoadData(CurDmts.So_the_ts); 
        
        isShowPopupGiam = false;
        myStateMN.SetNewThongbao("Đã cập nhật thông tin Giảm tài sản!");
    }

