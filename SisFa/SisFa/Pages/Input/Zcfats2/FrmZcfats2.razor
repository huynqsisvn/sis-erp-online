@inherits FrmListBaseComponent
@using SisFa.Pages.Input.Zcfats2
@using DevExpress.Blazor
@using System.Data
@using System.Linq
@inject IJSRuntime JSRuntime
<FormList Title="@Title"
          @bind-curActionTask="@curActionTask"
          OnCancel="@CloseForm">

    <div class="row m-1 me-2" style="min-height: 290px; align-content: flex-start;">
        <DxFormLayout ItemSizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
            <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail" @bind-ActiveTabIndex="@ActiveTabIndex">

                <DxFormLayoutTabPage Caption="Thông tin chính" CaptionCssClass="fw-bold">
                    <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="mt-3">
                        <DxFormLayoutItem Caption="Mã tài sản (số thẻ):" ColSpanMd="6" CaptionCssClass="fw-bold">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmts.So_the_ts" CharacterCasing="CharacterCasing.Upper" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã phụ:" ColSpanMd="6">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmts.Ma_tra_cuu" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        @* --- DÒNG 2: TÊN TÀI SẢN (Trải dài full 100%) --- *@
                        <DxFormLayoutItem Caption="Tên tài sản:" ColSpanMd="12" CaptionCssClass="fw-bold">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmts.Ten_ts" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        @* --- CHIA 3 CỘT ĐỂ RÚT NGẮN CHIỀU CAO FORM --- *@
                        <DxFormLayoutItem Caption="Nhóm tài sản:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmnhomts" @bind-Value="@CurDmts.Nh_ts" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Loại tài sản:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmplts" @bind-Value="@CurDmts.Loai_ts" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Lý do tăng:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmtgts" @bind-Value="@CurDmts.Ma_tg_ts" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Ngày tăng:" ColSpanMd="4">
                            <Template><DxDateEdit @bind-Date="@CurDmts.Ngay_mua" Format="dd/MM/yyyy" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã bpsd:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmbpts" @bind-Value="@CurDmts.Ma_bpts" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Kiểu k.hao:" ColSpanMd="4">
                            <Template><DxComboBox Data="@ListKieuKH" Value="@CurDmts.Kieu_kh" ValueFieldName="Value" TextFieldName="Text" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Số kỳ k.hao:" ColSpanMd="4" Visible="@(CurDmts.Kieu_kh == "1")">
                            <Template><DxSpinEdit Value="@CurDmts.So_ky_kh" DisplayFormat="N0" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tổng sản lượng:" ColSpanMd="4" Visible="@(CurDmts.Kieu_kh == "2")">
                            <Template><DxSpinEdit @bind-Value="@CurDmts.Tong_sl" DisplayFormat="N2" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Ngày bắt đầu tính KH:" ColSpanMd="4">
                            <Template><DxDateEdit Date="@CurDmts.Ngay_kh0" Format="dd/MM/yyyy" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="GTCL tính KH <= :" ColSpanMd="4">
                            <Template><DxSpinEdit @bind-Value="@CurDmts.Tien_cl" DisplayFormat="N0" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Ngày kết thúc k.hao:" ColSpanMd="4">
                            <Template><DxDateEdit @bind-Date="@CurDmts.Ngay_kt_kh" Format="dd/MM/yyyy" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tk khấu hao:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmtk" @bind-Value="@CurDmts.Tk_kh" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Tk chi phí:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmtk" @bind-Value="@CurDmts.Tk_cp" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã phí:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmphi" @bind-Value="@CurDmts.Ma_phi" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã bpht:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmbpht" @bind-Value="@CurDmts.Ma_bpht" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Mã phân xưởng(cđ):" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmpx" @bind-Value="@CurDmts.Ma_px" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã dự án:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmvv" @bind-Value="@CurDmts.Ma_vv" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Phân nhóm 1:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmnhts1" @bind-Value="@CurDmts.Nh_ts1" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Phân nhóm 2:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmnhts2" @bind-Value="@CurDmts.Nh_ts2" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Phân nhóm 3:" ColSpanMd="4">
                            <Template><AutocompleteComponent Ma_dm="dmnhts3" @bind-Value="@CurDmts.Nh_ts3" IsEnable="false" IsLangEn="@IsLangEn" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mã ĐVCS:" ColSpanMd="4">
                            <Template><DxTextBox @bind-Text="@CurDmts.Ma_dvcs" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage>
                <DxFormLayoutTabPage Caption="Thông tin phụ" CaptionCssClass="fw-bold">
                    <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="mt-3">
                        <DxFormLayoutItem Caption="Biên bản giao nhận số:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.So_bbbg" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Ngày:" ColSpanMd="6">
                            <Template><DxDateEdit Date="@CurDmts.Ngay_bbbg" Format="dd/MM/yyyy" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Số lượng:" ColSpanMd="6">
                            <Template><DxSpinEdit Value="@CurDmts.So_luong" DisplayFormat="N2" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Đvt:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.Dvt" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Số hiệu tài sản:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.So_hieu_ts" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Nước sản xuất:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.Nuoc_sx" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Năm sản xuất:" ColSpanMd="6">
                            <Template><DxSpinEdit Value="@CurDmts.Nam_sx" DisplayFormat="####" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Thông số kỹ thuật:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.Ts_kt" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Ngày đưa vào SD:" ColSpanMd="6">
                            <Template><DxDateEdit Date="@CurDmts.Ngay_dvsd" Format="dd/MM/yyyy" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Ngày đình chỉ SD:" ColSpanMd="6">
                            <Template><DxDateEdit Date="@CurDmts.Ngay_dc" Format="dd/MM/yyyy" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Lý do đình chỉ:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.Ly_do_dc" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tên 2:" ColSpanMd="6">
                            <Template><DxTextBox @bind-Text="@CurDmts.Ten_ts2" Enabled="false" /></Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Ghi chú" ColSpanMd="12">
                            <Template><DxTextBox @bind-Text="@CurDmts.Ghi_chu" Enabled="false" /></Template>
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage>
                <DxFormLayoutTabPage Caption="Phụ tùng kèm theo" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div id="grid-wrapper-pt" class="mt-2 mb-3">
                                <DxGrid Data="@LstPhuTung"
                                        ShowGroupPanel="false"
                                        ShowFilterRow="false"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        FooterDisplayMode="GridFooterDisplayMode.Always">
                                    <Columns>
                                        <DxGridDataColumn FieldName="Stt" Caption="Stt" Width="50px" />
                                        <DxGridDataColumn FieldName="Ten_ptkt" Caption="Tên phụ tùng" MinWidth="200" />
                                        <DxGridDataColumn FieldName="Dvt" Caption="ĐVT" Width="100px" />
                                        <DxGridDataColumn FieldName="So_luong" Caption="Số lượng" Width="120px" DisplayFormat="N0" />
                                        <DxGridDataColumn FieldName="Gia_tri" Caption="Giá trị" Width="150px" DisplayFormat="N0" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>
                <DxFormLayoutTabPage Caption="Điều chuyển ts" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div id="grid-wrapper-pt" class="mt-2 mb-3">
                                <DxGrid @ref="GridDieuChuyen" Data="@LstDieuChuyen" SizeMode="@Itemsizemode"
                                        CssClass="w-100 grid-height-dynamic hide-default-footer"
                                        EditMode="GridEditMode.PopupEditForm"
                                        PopupEditFormHeaderText="Điều chuyển tài sản"
                                        PopupEditFormCssClass="custom-popup-dc"
                                        ShowGroupPanel="false" ValidationEnabled="false"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        DataItemDeleting="OnGridDeletingDC"
                                        HighlightRowOnHover="true">

                                    <Columns>
                                        @* CHÚ Ý: Bắt buộc phải có NewButtonVisible="true" để hiện nút + *@
                                        <DxGridCommandColumn Width="100px" Caption="" Visible="true" EditButtonVisible="false" NewButtonVisible="false" DeleteButtonVisible="false">
                                            <CellDisplayTemplate Context="gridCtx">
                                                @{
                                                    var item = (CtBpts)gridCtx.DataItem;
                                                }
                                                <div class="d-flex justify-content-around">
                                                    <a class="text-success fw-bold cursor-pointer" @onclick="@(() => OpenViewDC(item))" title="Xem"><i class="fa fa-eye"></i></a>                                                    @if (item != null && item.Ts0 != "1")
                                                    {
                                                        <a class="text-primary fw-bold cursor-pointer" @onclick="@(() => OpenEditDC(item))" title="Sửa"><i class="fa fa-edit"></i></a>
                                                        <a class="text-danger fw-bold cursor-pointer" @onclick="@(() => GridDieuChuyen.ShowRowDeleteConfirmation(gridCtx.VisibleIndex))" title="Xóa dòng"><i class="fa fa-trash"></i></a>
                                                    }
                                                </div>
                                            </CellDisplayTemplate>
                                        </DxGridCommandColumn>

                                        <DxGridDataColumn FieldName="Stt" Caption="Stt" Width="50px" ReadOnly="true" />
                                        <DxGridDataColumn FieldName="Ma_bpts" Caption="Mã bpsd" Width="100px" />
                                        <DxGridDataColumn FieldName="Ngay_kh" Caption="Ngày tính k.hao" Width="120px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Tk_cp" Caption="Tk chi phí" Width="80px" />
                                        <DxGridDataColumn FieldName="Ma_bpht" Caption="Mã bpht" Width="80px" />
                                        <DxGridDataColumn FieldName="Ma_vv" Caption="Mã dự án" Width="90px" />
                                        <DxGridDataColumn FieldName="Ghi_chu" Caption="Ghi chú" Width="200px" />
                                        <DxGridDataColumn FieldName="Date0" Caption="Ngày tạo" Width="100px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Time0" Caption="Giờ tạo" Width="80px" />
                                        <DxGridDataColumn FieldName="User_name0" Caption="Người tạo" Width="90px" />
                                        <DxGridDataColumn FieldName="Date" Caption="Ngày sửa" Width="100px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Time" Caption="Giờ sửa" Width="80px" />
                                        <DxGridDataColumn FieldName="User_name" Caption="Người sửa" Width="90px" />
                                    </Columns>
                                </DxGrid>
                                <div class="custom-add-row-bar" @onclick="AddNewDieuChuyen">
                                    <i class="fa fa-plus"></i>
                                    <span class="ms-2" style="color:black; font-size: 11px;">Click vào đây để thêm dòng mới</span>
                                </div>
                                <DxPopup @bind-Visible="@isShowPopupDC"
                                         HeaderText="Điều chuyển tài sản"
                                         Width="600px"
                                         ShowFooter="true"
                                         CloseOnOutsideClick="false"
                                         Shown="OnPopupShownDC">
                                    <BodyContentTemplate Context="popupContext">
                                        @* Đổi tên context của Popup *@
                                        @{
                                            bool isLocked = (editItemDC.Ts0 == "1") || isViewingDC;
                                        }
                                        <DxFormLayout CssClass="w-100 p-2">
                                            <DxFormLayoutItem Caption="Mã bpsd:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    @* Đặt tên ctx để không trùng *@
                                                    <DxComboBox @ref="cbMaBpts" Data="@LsBpts" @bind-Value="@editItemDC.Ma_bpts" ValueFieldName="ma_item" TextFieldName="ma_item" EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains" Enabled="@(!isLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="ma_item" Caption="Mã" Width="60px" />
                                                            <DxListEditorColumn FieldName="ten_item" Caption="Tên bộ phận" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Ngày tính k.hao:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxDateEdit @bind-Date="@editItemDC.Ngay_kh" Format="dd-MM-yyyy" Enabled="@(!isLocked)" />
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Tk chi phí:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxComboBox Data="@LsTk" @bind-Value="@editItemDC.Tk_cp" ValueFieldName="ma_item" TextFieldName="ma_item" EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains" Enabled="@(!isLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="ma_item" Caption="TK" Width="60px" />
                                                            <DxListEditorColumn FieldName="ten_item" Caption="Tên tài khoản" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Mã bpht:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxComboBox Data="@LsBpht" @bind-Value="@editItemDC.Ma_bpht" ValueFieldName="ma_item" TextFieldName="ma_item" EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains" Enabled="@(!isLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="ma_item" Caption="Mã" Width="60px" />
                                                            <DxListEditorColumn FieldName="ten_item" Caption="Tên bộ phận HT" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Mã dự án:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxComboBox Data="@LsVv" @bind-Value="@editItemDC.Ma_vv" ValueFieldName="ma_item" TextFieldName="ma_item" EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains" Enabled="@(!isLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="ma_item" Caption="Mã" Width="60px" />
                                                            <DxListEditorColumn FieldName="ten_item" Caption="Tên dự án" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Ghi chú:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxTextBox @bind-Text="@editItemDC.Ghi_chu" Enabled="@(!isLocked)" />
                                                </Template>
                                            </DxFormLayoutItem>
                                        </DxFormLayout>
                                    </BodyContentTemplate>
                                    <FooterContentTemplate Context="footerContext">
                                        <div class="w-100 d-flex justify-content-end">
                                            @if (!isViewingDC)
                                            {
                                                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Nhận" Click="SaveDCCustom" CssClass="me-2 fw-bold" />
                                            }
                                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text='@(isViewingDC ? "Đóng" : "Hủy bỏ")' Click="@(() => isShowPopupDC = false)" />
                                        </div>
                                    </FooterContentTemplate>
                                </DxPopup>

                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>
                <DxFormLayoutTabPage Caption="Tạm dừng khấu hao" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template Context="tabCtx">
                            <div id="grid-wrapper-td" class="mt-2 mb-3">
                                @* 1. LƯỚI GRID TẠM DỪNG *@
                                <DxGrid @ref="GridTamDung" Data="@LstTamDung" SizeMode="@Itemsizemode"
                                        CssClass="w-100 grid-height-dynamic hide-default-footer"
                                        EditMode="GridEditMode.PopupEditForm"
                                        PopupEditFormHeaderText="Tạm dừng khấu hao"
                                        PopupEditFormCssClass="custom-popup-td"
                                        ShowGroupPanel="false" ValidationEnabled="false"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        DataItemDeleting="OnGridDeletingTD"
                                        HighlightRowOnHover="true">

                                    <Columns>
                                        <DxGridCommandColumn Width="100px" Caption="" Visible="true" EditButtonVisible="false" NewButtonVisible="false" DeleteButtonVisible="false">
                                            <CellDisplayTemplate Context="gridCtx">
                                                @{
                                                    var item = (CtTsThoiKc)gridCtx.DataItem;
                                                }
                                                <div class="d-flex justify-content-around">
                                                    <a class="text-success fw-bold cursor-pointer" @onclick="@(() => OpenViewTD(item))" title="Xem"><i class="fa fa-eye"></i></a>
                                                    <a class="text-primary fw-bold cursor-pointer" @onclick="@(() => OpenEditTD(item))" title="Sửa"><i class="fa fa-edit"></i></a>
                                                    <a class="text-danger fw-bold cursor-pointer" @onclick="@(() => GridTamDung.ShowRowDeleteConfirmation(gridCtx.VisibleIndex))" title="Xóa dòng"><i class="fa fa-trash"></i></a>
                                                </div>
                                            </CellDisplayTemplate>
                                        </DxGridCommandColumn>

                                        <DxGridDataColumn FieldName="Stt" Caption="Stt" Width="50px" ReadOnly="true" />
                                        <DxGridDataColumn FieldName="Ngay_thoi_kh1" Caption="Từ ngày" Width="120px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Ngay_thoi_kh2" Caption="Đến hết ngày" Width="120px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Ly_do_thoi" Caption="Ghi chú" MinWidth="200" />
                                        <DxGridDataColumn FieldName="Date0" Caption="Ngày tạo" Width="100px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Time0" Caption="Giờ tạo" Width="80px" />
                                        <DxGridDataColumn FieldName="User_name0" Caption="Người tạo" Width="90px" />
                                        <DxGridDataColumn FieldName="Date" Caption="Ngày sửa" Width="100px" DisplayFormat="dd/MM/yyyy" />
                                        <DxGridDataColumn FieldName="Time" Caption="Giờ sửa" Width="80px" />
                                        <DxGridDataColumn FieldName="User_name" Caption="Người sửa" Width="90px" />
                                    </Columns>
                                </DxGrid>

                                @* 2. NÚT THÊM DÒNG TỰ XÂY *@
                                <div class="custom-add-row-bar" @onclick="AddNewTamDung">
                                    <i class="fa fa-plus"></i>
                                    <span class="ms-2" style="color:black; font-size: 11px;">Click vào đây để thêm dòng mới</span>
                                </div>

                                @* 3. POPUP FORM NHẬP LIỆU *@
                                <DxPopup @bind-Visible="@isShowPopupTD"
                                         HeaderText="Tạm dừng khấu hao"
                                         Width="500px"
                                         ShowFooter="true"
                                         CloseOnOutsideClick="false"
                                         Shown="OnPopupShownTD">
                                    <BodyContentTemplate Context="popupContext">
                                        @{
                                            bool isLocked = isViewingTD;
                                        }
                                        <DxFormLayout CssClass="w-100 p-2">
                                            <DxFormLayoutItem Caption="Từ ngày:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxDateEdit @ref="deNgay1" @bind-Date="@editItemTD.Ngay_thoi_kh1" Format="dd/MM/yyyy" Enabled="@(!isLocked)" />
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Đến hết ngày:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxDateEdit @bind-Date="@editItemTD.Ngay_thoi_kh2" Format="dd/MM/yyyy" Enabled="@(!isLocked)" />
                                                </Template>
                                            </DxFormLayoutItem>

                                            <DxFormLayoutItem Caption="Ghi chú:" ColSpanMd="12">
                                                <Template Context="ctx">
                                                    <DxTextBox @bind-Text="@editItemTD.Ly_do_thoi" Enabled="@(!isLocked)" />
                                                </Template>
                                            </DxFormLayoutItem>
                                        </DxFormLayout>
                                    </BodyContentTemplate>
                                    <FooterContentTemplate Context="footerContext">
                                        <div class="w-100 d-flex justify-content-end">
                                            @if (!isViewingTD)
                                            {
                                                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Nhận" Click="SaveTDCustom" CssClass="me-2 fw-bold" />
                                            }
