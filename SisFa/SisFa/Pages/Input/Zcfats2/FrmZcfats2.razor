    [JSInvokable]
    public void CallGridEditMode(string value)
    {
        if (!AllowEditMode) return;
        // Tab Điều chuyển là số 3, Tạm dừng là số 4
        if (ActiveTabIndex == 3) AddNewDieuChuyen();
        else if (ActiveTabIndex == 4) AddNewTamDung();

        StateHasChanged();
    }
    // ===========================================================
    // LƯU & XÓA ĐIỀU CHUYỂN TÀI SẢN (LƯU TRỰC TIẾP DB)
    // ===========================================================
    bool isShowPopupDC = false;
    bool isViewingDC = false;
    bool isNewDC = false;
    CtBpts editItemDC = new CtBpts(); // Biến tạm chứa dữ liệu đang nhập

    void AddNewDieuChuyen()
    {
        isViewingDC = false;
        isNewDC = true;
        editItemDC = new CtBpts();
        editItemDC.Stt = LstDieuChuyen.Count + 1;
        editItemDC.Ngay_kh = DateTime.Now;
        editItemDC.Ts0 = "0";
        isShowPopupDC = true;
    }

    void OpenEditDC(CtBpts item)
    {
        if (item.Ts0 == "1")
        {
            myStateMN.SetNewThongbao("Không thể sửa dòng thông tin gốc!");
            return;
        }
        isViewingDC = false;
        isNewDC = false;
        editItemDC = new CtBpts();
        Copier.CopyPropertiesTo(item, editItemDC); // Copy ra biến tạm để sửa
        isShowPopupDC = true;
    }

    void OpenViewDC(CtBpts item)
    {
        isViewingDC = true;
        isNewDC = false;
        editItemDC = new CtBpts();
        Copier.CopyPropertiesTo(item, editItemDC);
        isShowPopupDC = true;
    }

    async Task SaveDCCustom()
    {
        // 1. Validate
        if (string.IsNullOrEmpty(editItemDC.Ma_bpts))
        {
            myStateMN.SetNewThongbao("Chưa nhập mã bộ phận!"); return;
        }
        if (!editItemDC.Ngay_kh.HasValue)
        {
            myStateMN.SetNewThongbao("Chưa nhập ngày tính khấu hao!"); return;
        }
        if (CurDmts.Ngay_mua.HasValue && editItemDC.Ngay_kh.Value.Date < CurDmts.Ngay_mua.Value.Date)
        {
            myStateMN.SetNewThongbao("Ngày tính phân bổ (điều chuyển) phải sau ngày mua!");
            return;
        }

        // 2. Chuẩn bị dữ liệu an toàn
        string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
        string sNgayKh = $"'{editItemDC.Ngay_kh.Value:yyyy-MM-dd}'";
        string sMaBp = editItemDC.Ma_bpts?.Replace("'", "''") ?? "";
        string sTkCp = editItemDC.Tk_cp?.Replace("'", "''") ?? "";
        string sMaBpht = editItemDC.Ma_bpht?.Replace("'", "''") ?? "";
        string sMaVv = editItemDC.Ma_vv?.Replace("'", "''") ?? "";
        string sGhiChu = editItemDC.Ghi_chu?.Replace("'", "''") ?? "";

        string sDateNow = $"'{DateTime.Now:yyyy-MM-dd}'";
        string sTimeNow = $"'{DateTime.Now:HH:mm:ss}'";
        string sUserIdNow = (curUser?.User_id ?? 0).ToString();

        // 3. Thực thi SQL
        if (isNewDC)
        {
            string sqlInsert = $@"
                INSERT INTO ctbpts(so_the_ts, ma_bpts, ngay_kh, tk_cp, ma_bpht, ma_vv, ghi_chu, ts0,
                                   date0, time0, user_id0, date, time, user_id)
                VALUES (N'{sSoThe}', N'{sMaBp}', {sNgayKh}, N'{sTkCp}', N'{sMaBpht}', N'{sMaVv}', N'{sGhiChu}', '0',
                        {sDateNow}, {sTimeNow}, {sUserIdNow}, {sDateNow}, {sTimeNow}, {sUserIdNow})";
            await myDb.ExecuteSqlQueryAsync(sqlInsert);
        }
        else
        {
            string sqlUpdate = $@"
                UPDATE ctbpts
                SET ma_bpts = N'{sMaBp}', ngay_kh = {sNgayKh}, tk_cp = N'{sTkCp}',
                    ma_bpht = N'{sMaBpht}', ma_vv = N'{sMaVv}', ghi_chu = N'{sGhiChu}',
                    date = {sDateNow}, time = {sTimeNow}, user_id = {sUserIdNow}
                WHERE id = {editItemDC.Id}";
            await myDb.ExecuteSqlQueryAsync(sqlUpdate);
        }

        // 4. Đóng popup & Tải lại lưới
        isShowPopupDC = false;
        await LoadData(CurDmts.So_the_ts);
        myStateMN.SetNewThongbao("Đã lưu Điều chuyển tài sản thành công!");
    }

    // Hàm xóa vẫn giữ nguyên vì đã nối thẳng với GridDieuChuyen
    async Task OnGridDeletingDC(GridDataItemDeletingEventArgs e)
    {
        var item = (CtBpts)e.DataItem;
        if (item.Ts0 == "1")
        {
            myStateMN.SetNewThongbao("Không thể xóa dòng thông tin gốc!");
            return;
        }

        string sqlDel = $"DELETE FROM ctbpts WHERE id = {item.Id}";
        await myDb.ExecuteSqlQueryAsync(sqlDel);

        await LoadData(CurDmts.So_the_ts);
        myStateMN.SetNewThongbao("Đã xóa Điều chuyển tài sản thành công!");
