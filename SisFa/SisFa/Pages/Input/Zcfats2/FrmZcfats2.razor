    async Task SaveTangCustom()
    {
        // 1. VALIDATE THEO CHUẨN WINFORM
        if (string.IsNullOrEmpty(editItemTang.Ma_tg_ts)) { myStateMN.SetNewThongbao("Chưa vào mã lý do tăng!"); return; }
        if (!editItemTang.Ngay_tg.HasValue) { myStateMN.SetNewThongbao("Chưa vào ngày tăng!"); return; }

        // Bổ sung Validate thiếu từ Winform
        if (!editItemTang.Ngay_kh.HasValue) { myStateMN.SetNewThongbao("Chưa vào ngày bắt đầu tính khấu hao!"); return; }

        // Bổ sung logic an toàn: Ngày tăng phải sau Ngày mua
        if (CurDmts.Ngay_mua.HasValue && editItemTang.Ngay_tg.Value.Date < CurDmts.Ngay_mua.Value.Date)
        {
            myStateMN.SetNewThongbao("Ngày tăng phải sau ngày mua tài sản gốc!");
            return;
        }

        string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
        string sMaTg = editItemTang.Ma_tg_ts?.Replace("'", "''") ?? "";
        string sNgayTg = editItemTang.Ngay_tg.HasValue ? $"'{editItemTang.Ngay_tg.Value:yyyy-MM-dd}'" : "NULL";
        string sNgayCt = editItemTang.Ngay_ct.HasValue ? $"'{editItemTang.Ngay_ct.Value:yyyy-MM-dd}'" : "NULL";
        string sNgayKh = editItemTang.Ngay_kh.HasValue ? $"'{editItemTang.Ngay_kh.Value:yyyy-MM-dd}'" : "NULL";
        string sSoCt = editItemTang.So_ct?.Replace("'", "''") ?? "";
        string sDienGiai = editItemTang.Dien_giai?.Replace("'", "''") ?? "";
        string sMaNv = editItemTang.Ma_nv?.Replace("'", "''") ?? "";

        string sNG = (editItemTang.Nguyen_gia ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sDKH = (editItemTang.Gt_da_kh ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sCL = (editItemTang.Gt_cl ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sSoKy = (editItemTang.So_ky ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        string sKHKy = (editItemTang.Gt_kh_ky ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);

        string sDate = $"'{DateTime.Now:yyyy-MM-dd}'";
        string sTime = $"'{DateTime.Now:HH:mm:ss}'";
        string sUserId = (curUser?.User_id ?? 0).ToString();

        // 2. LƯU VÀO BẢNG CHI TIẾT (ctdmts)
        if (isNewTang)
        {
            string sqlInsert = $@"
                INSERT INTO ctdmts (so_the_ts, tang_giam, ma_tg_ts, ngay_tg, ngay_ct, so_ct, dien_giai,
                                    nguyen_gia, gt_da_kh, gt_cl, so_ky, gt_kh_ky, ngay_kh, ma_nv, ts0,
                                    date_tang0, time_tang0, user_id_tang0, date_tang, time_tang, user_id_tang)
                VALUES (N'{sSoThe}', '1', N'{sMaTg}', {sNgayTg}, {sNgayCt}, N'{sSoCt}', N'{sDienGiai}',
                        {sNG}, {sDKH}, {sCL}, {sSoKy}, {sKHKy}, {sNgayKh}, N'{sMaNv}', '0',
                        {sDate}, {sTime}, {sUserId}, {sDate}, {sTime}, {sUserId})";
            await myDb.ExecuteSqlQueryAsync(sqlInsert);
        }
        else
        {
            string sqlUpdate = $@"
                UPDATE ctdmts SET
                    ma_tg_ts = N'{sMaTg}', ngay_tg = {sNgayTg}, ngay_ct = {sNgayCt}, so_ct = N'{sSoCt}',
                    dien_giai = N'{sDienGiai}', nguyen_gia = {sNG}, gt_da_kh = {sDKH}, gt_cl = {sCL},
                    so_ky = {sSoKy}, gt_kh_ky = {sKHKy}, ngay_kh = {sNgayKh}, ma_nv = N'{sMaNv}',
                    date_tang = {sDate}, time_tang = {sTime}, user_id_tang = {sUserId}
                WHERE id = {editItemTang.Id}";
            await myDb.ExecuteSqlQueryAsync(sqlUpdate);
        }

        // 3. (QUAN TRỌNG NHẤT) CẬP NHẬT TỔNG GIÁ TRỊ LÊN BẢNG MASTER (dmts) GIỐNG HỆT HÀM UpdateThongtints CỦA WINFORM
        string sqlUpdateMaster = $@"
            UPDATE dmts
            SET nguyen_gia = (SELECT ISNULL(SUM(nguyen_gia), 0) FROM ctdmts WHERE so_the_ts = N'{sSoThe}'),
                gt_da_kh   = (SELECT ISNULL(SUM(gt_da_kh), 0)   FROM ctdmts WHERE so_the_ts = N'{sSoThe}'),
                gt_cl      = (SELECT ISNULL(SUM(gt_cl), 0)      FROM ctdmts WHERE so_the_ts = N'{sSoThe}'),
                gt_kh_ky   = (SELECT ISNULL(SUM(gt_kh_ky), 0)   FROM ctdmts WHERE so_the_ts = N'{sSoThe}')
            WHERE so_the_ts = N'{sSoThe}'";
        await myDb.ExecuteSqlQueryAsync(sqlUpdateMaster);

        isShowPopupTang = false;
        await LoadData(CurDmts.So_the_ts);
        myStateMN.SetNewThongbao("Đã lưu Điều chỉnh tăng thành công!");
    }

