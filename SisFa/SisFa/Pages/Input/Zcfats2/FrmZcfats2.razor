    // --- LOGIC LƯU TRỰC TIẾP DB ---
    async Task SaveTDCustom()
    {
        // 1. Kiểm tra Từ ngày
        if (!editItemTD.Ngay_thoi_kh1.HasValue)
        {
            myStateMN.SetNewThongbao("Chưa vào từ ngày!");
            if (deNgay1 != null) await deNgay1.FocusAsync();
            return;
        }

        // 2. Kiểm tra Đến ngày
        if (!editItemTD.Ngay_thoi_kh2.HasValue)
        {
            myStateMN.SetNewThongbao("Chưa vào đến ngày!");
            return;
        }

        // 3. Kiểm tra logic khoảng thời gian
        if (editItemTD.Ngay_thoi_kh1.Value > editItemTD.Ngay_thoi_kh2.Value)
        {
            myStateMN.SetNewThongbao("Từ ngày đến ngày không hợp lệ!");
            return;
        }

        // 4. KIỂM TRA TRÙNG CHÉO VỚI CÁC DÒNG KHÁC (Giống Winform)
        if (LstTamDung != null && LstTamDung.Count > 0)
        {
            // Lấy danh sách các dòng KHÁC dòng đang sửa (Dựa vào ID)
            var otherItems = isNewTD ? LstTamDung : LstTamDung.Where(x => x.Id != editItemTD.Id).ToList();

            // Logic Winform: Có dòng nào mà Ngay_thoi_kh2 >= Ngay_thoi_kh1 đang nhập không?
            bool isConflict = otherItems.Any(x => x.Ngay_thoi_kh2.HasValue &&
                                                  x.Ngay_thoi_kh2.Value >= editItemTD.Ngay_thoi_kh1.Value);

            if (isConflict)
            {
                myStateMN.SetNewThongbao("Từ ngày đến ngày không hợp lệ!");
                if (deNgay1 != null) await deNgay1.FocusAsync();
                return;
            }
        }

        // --- NẾU QUA HẾT VALIDATE THÌ LƯU VÀO DB ---
        string sSoThe = CurDmts.So_the_ts?.Replace("'", "''") ?? "";
        string sNgay1 = $"'{editItemTD.Ngay_thoi_kh1.Value:yyyy-MM-dd}'";
        string sNgay2 = $"'{editItemTD.Ngay_thoi_kh2.Value:yyyy-MM-dd}'";
        string sLyDo = editItemTD.Ly_do_thoi?.Replace("'", "''") ?? "";

        string sDateNow = $"'{DateTime.Now:yyyy-MM-dd}'";
        string sTimeNow = $"'{DateTime.Now:HH:mm:ss}'";
        string sUserIdNow = (curUser?.User_id ?? 0).ToString();
        string sUserNameNow = (curUser?.User_name ?? "").Replace("'", "''");

        if (isNewTD)
        {
            string sqlInsert = $@"
                INSERT INTO dmtsthoikc(so_the_ts, ngay_thoi_kh1, ngay_thoi_kh2, ly_do_thoi, loai_thoi_kh,
                                       date0, time0, user_id0, user_name0, date, time, user_id, user_name)
                VALUES (N'{sSoThe}', {sNgay1}, {sNgay2}, N'{sLyDo}', '1',
                        {sDateNow}, {sTimeNow}, {sUserIdNow}, N'{sUserNameNow}', {sDateNow}, {sTimeNow}, {sUserIdNow}, N'{sUserNameNow}')";
            await myDb.ExecuteSqlQueryAsync(sqlInsert);
        }
        else
        {
            string sqlUpdate = $@"
                UPDATE dmtsthoikc
                SET ngay_thoi_kh1 = {sNgay1}, ngay_thoi_kh2 = {sNgay2}, ly_do_thoi = N'{sLyDo}',
                    date = {sDateNow}, time = {sTimeNow}, user_id = {sUserIdNow}, user_name = N'{sUserNameNow}'
                WHERE id = {editItemTD.Id}";
            await myDb.ExecuteSqlQueryAsync(sqlUpdate);
        }

        isShowPopupTD = false;
        await LoadData(CurDmts.So_the_ts);
        myStateMN.SetNewThongbao("Đã lưu Tạm dừng khấu hao thành công!");
    }

