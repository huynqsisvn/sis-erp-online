    void CalculateTang()
    {
        decimal nGia = editItemTang.Nguyen_gia ?? 0;
        decimal daKh = editItemTang.Gt_da_kh ?? 0;
        decimal soKy = editItemTang.So_ky ?? 0;

        // 1. Tính giá trị còn lại
        editItemTang.Gt_cl = nGia - daKh;

        // 2. CHỈ TÍNH KHẤU HAO KỲ NẾU LÀ ĐƯỜNG THẲNG
        if (CurDmts.Kieu_kh == "1" && soKy > 0)
        {
            editItemTang.Gt_kh_ky = Math.Round((editItemTang.Gt_cl ?? 0) / soKy, 0, MidpointRounding.AwayFromZero);
        }
        else
        {
            editItemTang.Gt_kh_ky = 0; // Sản lượng thì luôn bằng 0
        }
    }

    void OnNguyenGiaTangChanged(decimal? v) { editItemTang.Nguyen_gia = v; CalculateTang(); }
    void OnDaKhTangChanged(decimal? v) { editItemTang.Gt_da_kh = v; CalculateTang(); }
    void OnSoKyTangChanged(decimal? v) { editItemTang.So_ky = v; CalculateTang(); }
    
    async Task UpdateMasterTotalValue(string soTheTs)
    {
        string sqlUpdateMaster = $@"
            UPDATE dmts
            SET nguyen_gia = (SELECT ISNULL(SUM(CASE WHEN tang_giam = '2' THEN -nguyen_gia ELSE nguyen_gia END), 0) FROM ctdmts WHERE so_the_ts = N'{soTheTs}'),
                gt_da_kh   = (SELECT ISNULL(SUM(CASE WHEN tang_giam = '2' THEN -gt_da_kh ELSE gt_da_kh END), 0)   FROM ctdmts WHERE so_the_ts = N'{soTheTs}'),
                gt_cl      = (SELECT ISNULL(SUM(CASE WHEN tang_giam = '2' THEN -gt_cl ELSE gt_cl END), 0)      FROM ctdmts WHERE so_the_ts = N'{soTheTs}'),
                gt_kh_ky   = (SELECT ISNULL(SUM(CASE WHEN tang_giam = '2' THEN -gt_kh_ky ELSE gt_kh_ky END), 0)   FROM ctdmts WHERE so_the_ts = N'{soTheTs}')
            WHERE so_the_ts = N'{soTheTs}'";
        await myDb.ExecuteSqlQueryAsync(sqlUpdateMaster);
    }
