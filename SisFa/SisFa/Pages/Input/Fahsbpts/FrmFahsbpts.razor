        // WinForm l?y tk_cp t? dmts l�m tk_khao
        CurPh.Tk_khao = value.FirstOrDefault(a => a.Key == "tk_cp").Value?.ToString()
                        ?? value.FirstOrDefault(a => a.Key == "tk_khao").Value?.ToString() ?? "";
