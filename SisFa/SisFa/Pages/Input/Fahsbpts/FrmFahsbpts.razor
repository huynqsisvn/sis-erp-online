    void Grid_CustomizeEditModelCT(GridCustomizeEditModelEventArgs e)
    {
        CurrentEditModel = (CtBpts)e.EditModel;
        if (e.IsNew)
        {
            CurrentEditModel.Stt       = LSCt.Count + 1;
            CurrentEditModel.So_the_ts = CurPh.So_the_ts;
            CurrentEditModel.Ma_bpts   = CurPh.Ma_bpts;
            CurrentEditModel.Ma_dvcs   = CurPh.Ma_dvcs ?? myStateMN.GetMa_Dvcs()?.Trim() ?? "";
        }
    }

    async Task Grid_EditModelSavingCT(GridEditModelSavingEventArgs e)
    {
        var em = (CtBpts)e.EditModel;
        CurrentEditModel = em;

        if (e.IsNew)
        {
            var newRow = new CtBpts
            {
                Stt       = LSCt.Count + 1,
                So_the_ts = string.IsNullOrEmpty(em.So_the_ts) ? CurPh.So_the_ts : em.So_the_ts,
                Ma_bpts   = string.IsNullOrEmpty(em.Ma_bpts)   ? CurPh.Ma_bpts   : em.Ma_bpts,
                Ma_dvcs   = string.IsNullOrEmpty(em.Ma_dvcs)   ? (CurPh.Ma_dvcs ?? myStateMN.GetMa_Dvcs()?.Trim() ?? "") : em.Ma_dvcs,
                Tk_cp     = em.Tk_cp,
                Ma_bpht   = em.Ma_bpht,
                Ma_px     = em.Ma_px,
                Ma_vv     = em.Ma_vv,
                So_lsx    = em.So_lsx,
                Ma_sp     = em.Ma_sp,
                Ngay_hl1  = em.Ngay_hl1,
                Ngay_hl2  = em.Ngay_hl2,
                He_so     = em.He_so
            };
            LSCt.Add(newRow);
        }
        else
        {
            var dataItem = (CtBpts)e.DataItem;
            var cts = LSCt.FirstOrDefault(a => ReferenceEquals(a, dataItem));
            if (cts == null)
                cts = LSCt.FirstOrDefault(a =>
                    a.So_the_ts == dataItem.So_the_ts &&
                    a.Ma_bpts   == dataItem.Ma_bpts   &&
                    a.Tk_cp     == dataItem.Tk_cp     &&
                    a.Ngay_hl1  == dataItem.Ngay_hl1);

            if (cts != null)
            {
                cts.Ma_dvcs   = string.IsNullOrEmpty(em.Ma_dvcs) ? cts.Ma_dvcs : em.Ma_dvcs;
                cts.Tk_cp     = em.Tk_cp;
                cts.Ma_bpht   = em.Ma_bpht;
                cts.Ma_px     = em.Ma_px;
                cts.Ma_vv     = em.Ma_vv;
                cts.So_lsx    = em.So_lsx;
                cts.Ma_sp     = em.Ma_sp;
                cts.Ngay_hl1  = em.Ngay_hl1;
                cts.Ngay_hl2  = em.Ngay_hl2;
                cts.He_so     = em.He_so;
            }
        }
    }

    async Task Grid_DataItemDeletingCT(GridDataItemDeletingEventArgs e)
    {
        LSCt.Remove((CtBpts)e.DataItem);
        // Đánh lại số thứ tự
        int stt = 1;
        foreach (var r in LSCt) r.Stt = stt++;
    }

    async void OnGridCT_DMDM_Changed(ExpandoObject value, string fieldName)
    {
        if (value == null || CurrentEditModel == null) return;

        switch (fieldName.ToLower())
        {
            case "tk_cp":
                CurrentEditModel.Tk_cp    = value.FirstOrDefault(a => a.Key == "tk").Value?.ToString() ?? "";
                break;
            case "ma_bpht":
                CurrentEditModel.Ma_bpht  = value.FirstOrDefault(a => a.Key == "ma_bpht").Value?.ToString() ?? "";
                break;
            case "ma_px":
                CurrentEditModel.Ma_px    = value.FirstOrDefault(a => a.Key == "ma_px").Value?.ToString() ?? "";
                break;
            case "ma_vv":
                CurrentEditModel.Ma_vv    = value.FirstOrDefault(a => a.Key == "ma_vv").Value?.ToString() ?? "";
                break;
            case "so_lsx":
                CurrentEditModel.So_lsx   = value.FirstOrDefault(a => a.Key == "so_lsx").Value?.ToString() ?? "";
                break;
            case "ma_sp":
                CurrentEditModel.Ma_sp    = value.FirstOrDefault(a => a.Key == "ma_sp").Value?.ToString() ?? "";
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    void OnGridCT_Value_Changed(decimal newvalue, string name)
    {
        if (string.IsNullOrEmpty(name) || CurrentEditModel == null) return;

        if (name.ToLower() == "he_so")
            CurrentEditModel.He_so = newvalue;
    }
