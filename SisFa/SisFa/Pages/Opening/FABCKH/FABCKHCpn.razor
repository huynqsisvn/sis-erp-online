@page "/fabckh"
@page "/fabckh/{Menu_id}"
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,fabckh")]
@using SisFa.Pages.Opening.FABCKH

<div class="row" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="@oBrowse"
                        TblData="@TblData"
                        Fbrowse="@Fbrowse"
                        SelectItem="@SelectedItem"
                        RowStyleFunc="@GetRowStyle"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@* ================================================================
   BỘ LỌC BÁO CÁO: BẢNG TÍNH KHẤU HAO TSCĐ (MẪU 06-TSCĐ)
   ================================================================ *@
<DxPopup @ref="popFilter"
         CloseOnOutsideClick="false"
         CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="560px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="d-flex justify-content-center align-items-center p-4">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">Đang lọc dữ liệu...</span>
                </div>
                <span class="ms-3 fs-6 text-primary">Đang tải dữ liệu, vui lòng chờ...</span>
            </div>
        }
        else
        {
            <div class="container pt-1 pb-2">
                <DxFormLayout CssClass="w-100" onkeydown="ModifyEnterKeyPressAsTab(event);">

                    @* --- NĂM --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Năm"]" CaptionCssClass="fw-bold">
                        <DxSpinEdit @bind-Value="@FilterNam" DisplayFormat="####" MinValue="1900" MaxValue="2079"/>
                    </DxFormLayoutItem>

                    @* --- TỪ KỲ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Từ kỳ (1-12)"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy1" MinValue="1" MaxValue="12" 
                                                ValueChanged="@((int v) => { FilterKy1 = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy1 >= 1 && FilterKy1 <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy1, 1).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- ĐẾN KỲ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Đến kỳ (1-12)"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy2" MinValue="1" MaxValue="12" 
                                                ValueChanged="@((int v) => { FilterKy2 = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy2 >= 1 && FilterKy2 <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy2, 1).AddMonths(1).AddDays(-1).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- LOẠI TÀI SẢN --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Loại tài sản"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmplts" @bind-Value="@FilterLoaiTs" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    @* --- MÃ TÀI SẢN --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mã tài sản"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmts" @bind-Value="@FilterSoTheTs" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    @* --- MẪU BÁO CÁO --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mẫu VND/ngoại tệ"]" CaptionCssClass="fw-bold">
                        <DxComboBox Data="@LstMauBC" @bind-Value="@Mau_bc" ValueFieldName="Value" TextFieldName="Text"  />
                    </DxFormLayoutItem>

                    @* --- TÀI KHOẢN --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["TK tài sản"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmtk" @bind-Value="@FilterTkTs" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["TK khấu hao"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmtk" @bind-Value="@FilterTkKh" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["TK chi phí"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmtk" @bind-Value="@FilterTkCp" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    @* --- NHÓM TÀI SẢN --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm tài sản"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhomts" @bind-Value="@FilterNhTs" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm ts 1"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhts1" @bind-Value="@FilterNhTs1" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm ts 2"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhts2" @bind-Value="@FilterNhTs2" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm ts 3"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhts3" @bind-Value="@FilterNhTs3" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    @* --- CHECKBOX TÙY CHỌN BÁO CÁO --- *@
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div class="d-flex flex-wrap gap-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkThoiKh"
                                           checked="@FilterThoiKhCk"
                                           @onchange="@((ChangeEventArgs e) => { FilterThoiKhCk = e.Value is bool b && b; StateHasChanged(); })" />
                                    <label class="form-check-label" for="chkThoiKh">
                                        @Lap["Lên ts đã thôi k.hao"]
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkHetKh"
                                           checked="@FilterHetKhCk"
                                           @onchange="@((ChangeEventArgs e) => { FilterHetKhCk = e.Value is bool b && b; StateHasChanged(); })" />
                                    <label class="form-check-label" for="chkHetKh">
                                        @Lap["Lên ts đã k.hao hết"]
                                    </label>
                                </div>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                </DxFormLayout>

                @* --- HIỂN THỊ LỖI --- *@
                @if (Errors.Any())
                {
                    <div class="alert alert-danger mt-3 p-2 mb-0">
                        <ul class="mb-0 ps-3">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="d-flex justify-content-end gap-2 m-2">
                <DxButton RenderStyle="ButtonRenderStyle.Success"
                          Text="@Lap["OK"]"
                          IconCssClass="fa fa-check"
                          Click="@ConfirmGridView_OnOk" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="@Lap["Cancel"]"
                          IconCssClass="fa fa-times"
                          Click="@BtnCancel" TabIndex="-1" />
            </div>
        }
    </FooterTemplate>
</DxPopup>
@if (ShowPrint)
{
    <DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup" @bind-Visible="@ShowPrint"
             Width="80%" Height="90%" ShowFooter="false" Context="windowContext" HeaderText="@Lap["Printer"]">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData" Menu_id="@Menu_id.Replace('_', '.')"
                                   OnBack="@(() => { ShowPrint = false; StateHasChanged(); })">
            </ReportOptionComponent>
        </BodyTemplate>
    </DxPopup>
}

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 20px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@code {
    // ===== Filter fields =====
    private int FilterNam = DateTime.Now.Year;
    private int FilterKy1 = 1;
    private int FilterKy2 = 12;
    private string FilterMaDvcs = "";
    private string FilterLoaiTs = "";
    private string FilterSoTheTs = "";
    private string FilterTkTs = "";
    private string FilterTkKh = "";
    private string FilterTkCp = "";
    private string FilterNhTs = "";
    private string FilterNhTs1 = "";
    private string FilterNhTs2 = "";
    private string FilterNhTs3 = "";
    private bool FilterThoiKhCk = false;
    private bool FilterHetKhCk = false;

    private List<string> Errors { get; set; } = new();
    private List<FABCKHModel> LsData;

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wf.bc.01";
        base.OnInitialized();

        FilterNam = myStateMN.GetStartDate().Year;
        FilterKy1 = myStateMN.GetStartDate().Month;
        FilterKy2 = myStateMN.GetEndDate().Month;
    }

    [JSInvokable]
    public async void GridFMode(string value, string Id)
    {
        if (!string.IsNullOrEmpty(value))
        {
            if (value.Equals("F7"))
            {
                Print();
                StateHasChanged();
            }
        }
    }

    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;

            if (curCommand != null)
                Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void OnDvcsChanged(string ma_dvcs)
    {
        FilterMaDvcs = (ma_dvcs == "ALL" ? "" : ma_dvcs);
        await Loaddata();
        StateHasChanged();
    }

    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(new DateTime(FilterNam, FilterKy1, 1));
        myStateMN.SetEndDate(new DateTime(FilterNam, FilterKy2, DateTime.DaysInMonth(FilterNam, FilterKy2)));
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;
        if (FilterNam < 1900 || FilterNam > 2079)
        {
            Errors.Add("Năm không hợp lệ!");
            ok = false;
        }
        if (FilterKy1 < 1 || FilterKy1 > 12)
        {
            Errors.Add("Từ kỳ phải từ 1 đến 12!");
            ok = false;
        }
        if (FilterKy2 < 1 || FilterKy2 > 12)
        {
            Errors.Add("Đến kỳ phải từ 1 đến 12!");
            ok = false;
        }
        if (FilterKy1 > FilterKy2)
        {
            Errors.Add("Từ kỳ phải nhỏ hơn hoặc bằng đến kỳ!");
            ok = false;
        }
        StateHasChanged();
        return ok;
    }

    async Task Loaddata()
    {
        try
        {
            ShowLoadding = true;
            StateHasChanged();

            if (curCommand != null)
            {
                string[] sFieldArrays = IsLangEn
                    ? (Mau_bc != 0 ? curCommand.Ebrowse2?.Split("|") : curCommand.Ebrowse1?.Split("|"))
                    : (Mau_bc != 0 ? curCommand.Vbrowse2?.Split("|") : curCommand.Vbrowse1?.Split("|"));

                Fbrowse = sFieldArrays != null && sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
            }

            string maDvcs = string.IsNullOrEmpty(FilterMaDvcs) ? "%" : FilterMaDvcs + "%";
            string thoiKhCk = FilterThoiKhCk ? "1" : "0";
            string hetKhCk = FilterHetKhCk ? "1" : "0";

            string condition = BuildCondition();

            string paramName = "nam;ky1;ky2;Thoi_kh_ck;Het_kh_ck;advance";
            string paramValue = $"{FilterNam};{FilterKy1};{FilterKy2};{thoiKhCk};{hetKhCk};{condition}";

            string store = curCommand?.Store_proc?.Split('|')[0] ?? "FABCKH";

            var ds = await myDb.LoadStoreProcedure(store, paramName, paramValue);

            if (ds != null && ds.Tables.Count > 0)
            {
                TblData = ds.Tables[0].Copy();
                TblData.TableName = "tbDetail";
            }
            else
            {
                TblData = new DataTable();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            myStateMN.SetNewThongbao("Lỗi tải dữ liệu: " + ex.Message);
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    private static string Esc(string s) => s?.Trim().Replace("'", "''") ?? "";

    private string BuildCondition()
    {
        var parts = new List<string> { "1=1" };

        if (!string.IsNullOrWhiteSpace(FilterLoaiTs))
            parts.Add($"loai_ts LIKE '{Esc(FilterLoaiTs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterSoTheTs))
            parts.Add($"so_the_ts LIKE '{Esc(FilterSoTheTs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterMaDvcs))
            parts.Add($"ma_dvcs LIKE '{Esc(FilterMaDvcs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkTs))
            parts.Add($"tk_ts LIKE '{Esc(FilterTkTs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkKh))
            parts.Add($"tk_kh LIKE '{Esc(FilterTkKh)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkCp))
            parts.Add($"tk_cp LIKE '{Esc(FilterTkCp)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs))
            parts.Add($"nh_ts LIKE '{Esc(FilterNhTs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs1))
            parts.Add($"nh_ts1 LIKE '{Esc(FilterNhTs1)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs2))
            parts.Add($"nh_ts2 LIKE '{Esc(FilterNhTs2)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs3))
            parts.Add($"nh_ts3 LIKE '{Esc(FilterNhTs3)}%'");

        return string.Join(" AND ", parts);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            FilterMaDvcs = myStateMN.GetMa_Dvcs();
            FilterMaDvcs = (FilterMaDvcs == "ALL" ? "" : FilterMaDvcs);

            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync(
                string.Format("{0}-{1}",
                    string.IsNullOrEmpty(LanguageID) ? curCommand?.Ma_phan_he?.Trim().ToLower() ?? "fabckh" : LanguageID,
                    UserLang?.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;

            // Show filter popup on first open instead of auto-loading data
            PopupVisible = true;
            StateHasChanged();
        }
        else
        {
            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("Bold") && row["Bold"]?.ToString()?.Trim() == "1")
            return "bold-item";
        return "";
    }

    public override async void ExportData(int type)
    {
        oBrowse?.ExPortGrid(type);
        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }

    public override async void Print()
    {
        if (TblData == null || TblData.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["Không có dữ liệu để in!"]);
            return;
        }

        LsData = new List<FABCKHModel>();
        var rows = myDb.ConvertDataTable<FABCKHRow>(TblData);

        // Tự tính lại tổng với điều kiện Stt == 0
        decimal tNguyenGia = rows?.Where(r => r.Stt == 0).Sum(r => r.Nguyen_gia) ?? 0m;
        decimal tGtKhKy = rows?.Where(r => r.Stt == 0).Sum(r => r.Gt_kh_ky) ?? 0m;
        decimal tGtKhTrongKy = rows?.Where(r => r.Stt == 0).Sum(r => r.Gt_kh_trong_ky) ?? 0m;
        decimal tGtDaKh = rows?.Where(r => r.Stt == 0).Sum(r => r.Gt_da_kh) ?? 0m;
        decimal tGtCl = rows?.Where(r => r.Stt == 0).Sum(r => r.Gt_cl) ?? 0m;

        var data = new FABCKHModel
        {
            Nam = FilterNam,
            Ky1 = FilterKy1,
            Ky2 = FilterKy2,
            Ma_dvcs = FilterMaDvcs,
            LoaiBC = Mau_bc.ToString(),

            // Gán giá trị vào các biến tổng T_
            T_nguyen_gia = tNguyenGia,
            T_gt_kh_ky = tGtKhKy,
            T_gt_kh_trong_ky = tGtKhTrongKy,
            T_gt_da_kh = tGtDaKh,
            T_gt_cl = tGtCl,

            LsData = rows
        };

        // Gán cục tổng vừa tính vào list Tong đề phòng mẫu in dùng Table Tong
        data.Tong = new System.Collections.Generic.List<lTC>
        {
            new lTC {
                nguyen_gia = tNguyenGia,
                gt_kh_ky = tGtKhKy,
                gt_kh_trong_ky = tGtKhTrongKy,
                gt_da_kh = tGtDaKh,
                gt_cl = tGtCl
            }
        };

        LsData.Add(data);
        ShowReport(LsData, typeof(FABCKHModel));
    }

    void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
}
