@page "/fabctgth1"
@page "/fabctgth1/{Menu_id}"
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,fabctgth1")]
@using System.Data
@using SisFa.Pages.Opening.FABCTGTH1

<div class="row" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @key="@gridKey"
                        @ref="@oBrowse"
                        TblData="@TblData"
                        Fbrowse="@Fbrowse"
                        SelectItem="@SelectedItem"
                        RowStyleFunc="@GetRowStyle"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

<DxPopup @ref="popFilter"
         CloseOnOutsideClick="false"
         CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="560px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="d-flex justify-content-center align-items-center p-4">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">Đang lọc dữ liệu...</span>
                </div>
                <span class="ms-3 fs-6 text-primary">Đang tải dữ liệu, vui lòng chờ...</span>
            </div>
        }
        else
        {
            <div class="container pt-1 pb-2">
                <DxFormLayout CssClass="w-100" onkeydown="ModifyEnterKeyPressAsTab(event);">

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Năm"]" CaptionCssClass="fw-bold">
                        <DxSpinEdit Id="nam_input" @bind-Value="@FilterNam" DisplayFormat="####" MinValue="1900" MaxValue="2079" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Từ kỳ (1-12)"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy1" MinValue="1" MaxValue="12"
                                                ValueChanged="@((int v) => { FilterKy1 = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy1 >= 1 && FilterKy1 <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy1, 1).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Đến kỳ (1-12)"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy2" MinValue="1" MaxValue="12"
                                                ValueChanged="@((int v) => { FilterKy2 = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy2 >= 1 && FilterKy2 <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy2, DateTime.DaysInMonth(FilterNam, FilterKy2)).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm tài sản"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhomts" @bind-Value="@FilterNhTs" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mẫu VND/ngoại tệ"]" CaptionCssClass="fw-bold">
                        <DxComboBox Data="@LstMauBC" @bind-Value="@Mau_bc" ValueFieldName="Value" TextFieldName="Text" IsEnabled="false" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mã bộ phận sử dụng"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmbpts" @bind-Value="@FilterMaBpsd" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Loại tài sản"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmplts" @bind-Value="@FilterLoaiTs" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["TK chi phí"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmtk" @bind-Value="@FilterTkCp" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm ts 1"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhts1" @bind-Value="@FilterNhTs1" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm ts 2"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhts2" @bind-Value="@FilterNhTs2" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm ts 3"]" CaptionCssClass="fw-bold">
                        <AutocompleteComponent Ma_dm="dmnhts3" @bind-Value="@FilterNhTs3" IsEnable="true" IsLangEn="@IsLangEn" />
                    </DxFormLayoutItem>

                </DxFormLayout>

                @if (Errors.Any())
                {
                    <div class="alert alert-danger mt-3 p-2 mb-0">
                        <ul class="mb-0 ps-3">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>

    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="d-flex justify-content-end gap-2 m-2">
                <DxButton RenderStyle="ButtonRenderStyle.Success"
                          Text="OK"
                          Click="@ConfirmGridView_OnOk" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="Cancel"
                          Click="@BtnCancel" TabIndex="-1" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@* --- COMPONENT GỌI BẢN IN DEVEXPRESS --- *@
@if (ShowPrint)
{
    <DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup" @bind-Visible="@ShowPrint"
             Width="80%" Height="90%" ShowFooter="false" Context="windowContext" HeaderText="Printer">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData" Menu_id="@Menu_id.Replace('_', '.')"
                                   OnBack="@(() => { ShowPrint = false; StateHasChanged(); })">
            </ReportOptionComponent>
        </BodyTemplate>
    </DxPopup>
}

@code {
    // ===== Filters =====
    private string FilterMaDvcs = "";
    private int FilterNam = DateTime.Now.Year;
    private int FilterKy1 = 1;
    private int FilterKy2 = 12;
    private string FilterNhTs = ""; // Bắt buộc
    private string FilterLoaiTs = "";
    private string FilterMaBpsd = "";
    private string FilterTkCp = "";
    private string FilterNhTs1 = "";
    private string FilterNhTs2 = "";
    private string FilterNhTs3 = "";

    private string gridKey = Guid.NewGuid().ToString();
    private List<string> Errors { get; set; } = new();
    private DataSet dsPrint;

    private bool ShowPrint = false;
    private List<FABCTGTH1Model> LsData;
    private System.Data.DataSet LastDs;
    private DxPopup popPrint;

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wf.bc.20";
        base.OnInitialized();

        FilterNam = myStateMN.GetStartDate().Year;
        FilterKy1 = myStateMN.GetStartDate().Month;
        FilterKy2 = myStateMN.GetEndDate().Month;
        Mau_bc = 0; // Cố định VND
    }

    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
        }
    }

    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(new DateTime(FilterNam, FilterKy1, 1));
        myStateMN.SetEndDate(new DateTime(FilterNam, FilterKy2, DateTime.DaysInMonth(FilterNam, FilterKy2)));
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;

        if (FilterKy1 > FilterKy2)
        {
            Errors.Add("Từ kỳ phải nhỏ hơn hoặc bằng đến kỳ!");
            ok = false;
        }

        // Ràng buộc bắt buộc nhập nhóm tài sản theo chuẩn hệ thống cũ
        if (string.IsNullOrWhiteSpace(FilterNhTs))
        {
            myStateMN.SetNewThongbao(Lap["Chưa vào nhóm tài sản!"]);
            ok = false;
        }
        StateHasChanged();
        return ok;
    }

    async Task Loaddata()
    {
        try
        {
            ShowLoadding = true;
            StateHasChanged();

            string condition = BuildCondition();
            string paramName = "Nam;tuKy;denKy;ma_bpts;nh_ts;condition";
            string paramValue = $"{FilterNam};{FilterKy1};{FilterKy2};{FilterMaBpsd};{FilterNhTs};{condition}";

            string store = curCommand?.Store_proc?.Split('|')[0] ?? "FABCTGTH1";

            var ds = await myDb.LoadStoreProcedure(store, paramName, paramValue);
            LastDs = ds;
            if (ds != null && ds.Tables.Count > 1)
            {
                dsPrint = ds.Copy();
                DataTable dtConfig = ds.Tables[0];
                if (dtConfig.Rows.Count > 0)
                {
                    string rawBrowse = IsLangEn
                        ? dtConfig.Rows[0]["ebrowse"].ToString()
                        : dtConfig.Rows[0]["vbrowse"].ToString();

                    // 1. CẮT SẠCH CÁC THẺ GÂY LỖI PARSER CỦA WEB
                    // Đưa chuỗi L_L01:130:N0:I0:h=Nhà cửa VỀ CHUẨN L_L01:130:h=Nhà cửa
                    Fbrowse = rawBrowse.Replace(":N0:I0:", ":")
                                       .Replace(":N0:I1:", ":")
                                       .Replace(":fl:", ":");
                }

                DataTable dtRaw = ds.Tables[1].Copy();
                dtRaw.TableName = "tbDetail";

                // Xóa khoảng trắng thừa trong tên cột (SQL Pivot sinh ra)
                foreach (DataColumn col in dtRaw.Columns)
                {
                    col.ColumnName = col.ColumnName.Trim();
                }

                // =======================================================
                // 2. GIẢI PHÁP ĐỊNH DẠNG SỐ "BẤT BẠI" (ÉP KIỂU BẰNG C#)
                // =======================================================
                DataTable dtFormatted = dtRaw.Clone();

                // Chuyển tất cả cột số (Decimal/Double) sang kiểu String để giữ được dấu phẩy
                foreach (DataColumn col in dtFormatted.Columns)
                {
                    if (col.DataType == typeof(decimal) || col.DataType == typeof(double))
                    {
                        col.DataType = typeof(string);
                    }
                }

                // Đổ dữ liệu và tự động format số liệu
                foreach (DataRow row in dtRaw.Rows)
                {
                    DataRow newRow = dtFormatted.NewRow();
                    foreach (DataColumn col in dtRaw.Columns)
                    {
                        if (col.DataType == typeof(decimal) || col.DataType == typeof(double))
                        {
                            if (row[col] != DBNull.Value && Convert.ToDecimal(row[col]) != 0m)
                            {
                                // C# tự format số ngay tại đây: 35000000 -> 35,000,000
                                newRow[col.ColumnName] = Convert.ToDecimal(row[col]).ToString("N0");
                            }
                            else
                            {
                                newRow[col.ColumnName] = null; // Ẩn số 0 thành ô trống
                            }
                        }
                        else
                        {
                            newRow[col.ColumnName] = row[col];
                        }
                    }
                    dtFormatted.Rows.Add(newRow);
                }

                // Gán bảng đã được xử lý hoàn hảo cho Grid
                TblData = dtFormatted;

                // Đổi KEY để ép lưới render lại cột và dữ liệu mới
                gridKey = Guid.NewGuid().ToString();
            }
            else
            {
                TblData = new DataTable();
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi tải dữ liệu: " + ex.Message);
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    private static string Esc(string s) => s?.Trim().Replace("'", "''") ?? "";

    private string BuildCondition()
    {
        var parts = new List<string> { "1=1" };

        // Điều kiện nâng cao (Không có ma_dvcs vì báo cáo TSCĐ dùng chung công ty hoặc tuỳ biến cấu hình của bạn)
        if (!string.IsNullOrWhiteSpace(FilterMaDvcs))
            parts.Add($"ma_dvcs LIKE '{Esc(FilterMaDvcs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterLoaiTs))
            parts.Add($"loai_ts LIKE '{Esc(FilterLoaiTs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkCp))
            parts.Add($"tk_cp LIKE '{Esc(FilterTkCp)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs1))
            parts.Add($"nh_ts1 LIKE '{Esc(FilterNhTs1)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs2))
            parts.Add($"nh_ts2 LIKE '{Esc(FilterNhTs2)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhTs3))
            parts.Add($"nh_ts3 LIKE '{Esc(FilterNhTs3)}%'");

        return string.Join(" AND ", parts);
    }

    // --- XỬ LÝ ROW STYLE THEO TRƯỜNG BOLD ---
    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("bold") && row["bold"]?.ToString()?.Trim() == "1")
            return "bold-item";
        return "";
    }

    public override async void ExportData(int type)
    {
        oBrowse?.ExPortGrid(type);

        // Tách ra biến riêng để Razor Compiler không bị nhầm lẫn ngoặc vuông [] thành Attribute
        var successMsg = Lap["Export successfully"]?.ToString();
        myStateMN.SetNewThongbao(successMsg);

        StateHasChanged();
    }

    public override async void Print()
    {
        // 1. Kiểm tra dữ liệu trước khi in
        if (LastDs == null || LastDs.Tables.Count < 2 || TblData == null || TblData.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao("Không có dữ liệu để in!");
            return;
        }

        try
        {
            LsData = new List<FABCTGTH1Model>();

            // 2. Map dữ liệu Detail vào Model
            var rows = myDb.ConvertDataTable<FABCTGTH1Row>(TblData);

            // 3. Lấy nguyên bản chuỗi cấu hình cột từ Database
            string title_report1 = LastDs.Tables[0].Rows[0]["v_title_report"].ToString();
            string title_report2 = LastDs.Tables[0].Rows[0]["e_title_report"].ToString();
            string title_report3 = LastDs.Tables[0].Rows[0]["value_detail_report"].ToString();
            string v_tuKydenKy = LastDs.Tables[0].Rows[0]["v_tuKydenKy"]?.ToString();
            string e_tuKydenKy = LastDs.Tables[0].Rows[0]["e_tuKydenKy"]?.ToString();

            // 4. Gom TẤT CẢ vào duy nhất MỘT biến data (Tuyệt đối không dùng vòng lặp for)
            var data = new FABCTGTH1Model
            {
                v_title_report = title_report1,
                e_title_report = title_report2,
                value_detail_report = title_report3,
                v_tuKydenKy = v_tuKydenKy,
                e_tuKydenKy = e_tuKydenKy,
                tbDetail = rows
            };

            LsData.Add(data);

            // 5. Cú chốt: Gọi đúng 1 lệnh ShowReport y hệt form facdpsts (Không gán ShowPrint = true)
            ShowReport(LsData, typeof(FABCTGTH1Model));
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi khi tạo bản in: " + ex.Message);
        }
    }

    // Boilerplate Code (OnAfterRenderAsync, Dispose, Lang, Cancel) giữ nguyên tương tự FABCPBKH...
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            FilterMaDvcs = myStateMN.GetMa_Dvcs();
            FilterMaDvcs = (FilterMaDvcs == "ALL" ? "" : FilterMaDvcs);
            await PageLoad();
            await Lap.LoadLocalizationAsync($"fabctgth1-{UserLang?.Trim()}");

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Print", true)); // Thêm nút In
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            PopupVisible = true;
            StateHasChanged();
        }
    }
    private async void OnDvcsChanged(string ma_dvcs)
    {
        // Sử dụng InvokeAsync để đảm bảo giao diện được render lại an toàn từ thread khác
        await InvokeAsync(async () =>
        {
            FilterMaDvcs = (ma_dvcs == "ALL" ? "" : ma_dvcs);
            await Loaddata();
            StateHasChanged();
        });
    }
    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
}