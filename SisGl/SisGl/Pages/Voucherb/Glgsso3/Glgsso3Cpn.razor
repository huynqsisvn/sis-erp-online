@page "/glgsso3"
@page "/glgsso3/{Menu_id}"
@inherits RepoBaseComponent

@attribute [Authorize(Roles = "admin,glgsso3")]

<div class="row" onkeydown="_handleFunctionKeys(event);">
@if (!IsDetail)
{
        <FrmBrowse3Component @ref="@oBrowse1" TblData="@TblData"
                              Fbrowse="@Fbrowse" IsLangEn="@IsLangEn"
                              SelectItem="@OnRowClick"
                              SelectCol="tag">
        </FrmBrowse3Component>
    }
    else if (!IsDetail2)
    {
        <div class="row mx-1 mb-1">
            <span style="color:dodgerblue;font-weight:600;">@DetailTitle</span>
            <hr class="my-1" />
        </div>
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblDataCT" Fbrowse="@FbrowseCT"
                            SelectItem="@OnRowCTClick"
                            IsLangEn="@IsLangEn"/>
    }
    else
    {
        <div class="row mx-1 mb-1">
            <span style="color:dodgerblue;font-weight:600;">@DetailTitle2</span>
            <hr class="my-1" />
        </div>
        <FrmBrowseComponent @ref="@oBrowseCT2" TblData="@TblDataCT2" Fbrowse="@FbrowseCT2"
                            IsLangEn="@IsLangEn"/>
    }
</div>

<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="50%"
         Height="Auto"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-3">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["From date"]">
                        <DxDateEdit @bind-Date="Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["To date"]">
                        <DxDateEdit @bind-Date="Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Journal voucher from number"]">
                        <DxTextBox @bind-Text="SoCt1" NullText="" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Journal voucher to number"]">
                        <DxTextBox @bind-Text="SoCt2" NullText="" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Report template"]">
                        <DxComboBox Data="@_mauBcList" @bind-Value="@Loai_bc" TextFieldName="Label" ValueFieldName="Value" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                    </DxFormLayoutItem>                   
                </DxFormLayout>

                @if (FilterErrors.Any())
                {
                    <div class="mt-2 alert alert-danger p-2">
                        <ul class="mb-0">
                            @foreach (var err in FilterErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end align-content-end">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success"
                          Text="@Lap["OK"]" Click="@BtnFilterOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger"
                          Text="@Lap["Cancel"]" Click="@BtnFilterCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 10px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@code {
    private FrmBrowse3Component oBrowse1;
    private List<Glgsso3Model> LsData;

    // Filter
    private string SoCt1 { get; set; } = "";
    private string SoCt2 { get; set; } = "";
    private string Loai_bc { get; set; } = "0";
    private List<string> FilterErrors { get; set; } = new();

    private List<object> _mauBcList = new()
    {
        new { Label = "VND",     Value = "0" },
        new { Label = "Ngoại tệ", Value = "1" },
    };

    private bool IsDetail { get; set; } = false;
    private bool IsDetail2 { get; set; } = false;
    private FrmBrowseComponent oBrowseCT;
    private FrmBrowseComponent oBrowseCT2;
    private DataTable TblDataCT;
    private DataTable TblDataCT2;
    private string FbrowseCT = "";
    private string FbrowseCT2 = "";
    private string DetailTitle = "";
    private string DetailTitle2 = "";
    private object CurItemCT;
    private string[] _sFieldArrays = Array.Empty<string>();

    private DataSet _dsGlgsso3;
    public DotNetObjectReference<Glgsso3Cpn> Pageobj;
    private string ActiveComponentId = "oBrowse1";

    private void OnRowClick(object item)
    {
        if (item != null)
            CurItem = item;
    }

    private void OnRowCTClick(object item)
    {
        if (item != null)
            CurItemCT = item;
    }

    [JSInvokable]
    public void GridFMode(string value, string id)
    {
        if (!string.IsNullOrEmpty(id) && id.Equals("oBrowse1"))
            oBrowse1HotKeyFunction(value);
        else if (!string.IsNullOrEmpty(id) && id.Equals("oBrowseCT"))
            oBrowseCTHotKeyFunction(value);
        else if (!string.IsNullOrEmpty(id) && id.Equals("oBrowseCT2"))
            oBrowseCT2HotKeyFunction(value);
    }

    private void oBrowse1HotKeyFunction(string value)
    {
        if (string.IsNullOrEmpty(value)) return;
        if (value.Equals("F5"))
        {
            ShowDetail();
            StateHasChanged();
        }
        else if (value.Equals("F7"))
        {
            Print();
            StateHasChanged();
        }
    }

    private void oBrowseCTHotKeyFunction(string value)
    {
        if (string.IsNullOrEmpty(value)) return;
        if (value.Equals("F5"))
        {
            ShowDetail2();
            StateHasChanged();
        }
        else if (value.ToUpper().Equals("ESCAPE"))
        {
            HideDetail();
            StateHasChanged();
        }
    }

    private void oBrowseCT2HotKeyFunction(string value)
    {
        if (string.IsNullOrEmpty(value)) return;
        if (value.ToUpper().Equals("ESCAPE"))
        {
            HideDetail();
            StateHasChanged();
        }
    }

    private async Task SetActiveComponentIdAsync(string id)
    {
        try
        {
            ActiveComponentId = id ?? ActiveComponentId;
            if (Pageobj != null)
                await JavacriptS.InvokeVoidAsync("SetPageFModeObj", Pageobj, ActiveComponentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("SetActiveComponentIdAsync error: " + ex.Message);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wg.vb.08";
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        var today = DateTime.Today;
        Ngay_ct1 = myStateMN.GetStartDate();
        Ngay_ct2 = myStateMN.GetEndDate();
        if (Ngay_ct1.Date == today)
            Ngay_ct1 = new DateTime(today.Year, today.Month, 1);
        if (Ngay_ct2.Date == today)
            Ngay_ct2 = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));

        if (curCommand != null)
        {
            Store_proc = curCommand.Store_proc?.Split('|')[0] ?? "";
            _sFieldArrays = IsLangEn
                ? curCommand.Ebrowse1.Split('|')
                : curCommand.Vbrowse1.Split('|');
            Fbrowse = _sFieldArrays.Length > 0 ? _sFieldArrays[0] : "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            Ma_dvcs = myStateMN.GetMa_Dvcs();
            Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}",
                String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID,
                UserLang.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Print", true, "F7"));
                myStateMN.AddOrderToolBarButton("button1", Lap["Detail"] + " - F5", 1);
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync("oBrowse1");
            await Loaddata();
            StateHasChanged();
        }
        else
        {
            if (IsDetail2 && oBrowseCT2 != null)
            {
                await oBrowseCT2.FocusGridAsync();
                await SetActiveComponentIdAsync("oBrowseCT2");
            }
            else if (IsDetail && oBrowseCT != null)
            {
                await oBrowseCT.FocusGridAsync();
                await SetActiveComponentIdAsync("oBrowseCT");
            }
            else
            {
                await SetActiveComponentIdAsync("oBrowse1");
            }
        }
    }

    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                ShowLoadding = false;
                myStateMN.SetCurrentActionTask(ActionTask.Search);
                StateHasChanged();
                break;
            case ActionTask.Button1:
                if (IsDetail && !IsDetail2)
                    ShowDetail2();
                else
                    ShowDetail();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Quit:
                HideDetail();
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    public new async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;
            if (curCommand != null)
            {
                _sFieldArrays = IsLangEn
                    ? curCommand.Ebrowse1.Split('|')
                    : curCommand.Vbrowse1.Split('|');
                Fbrowse = _sFieldArrays.Length > 0 ? _sFieldArrays[0] : "";
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void OnDvcsChanged(string ma_dvcs)
    {
        Ma_dvcs = ma_dvcs;
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
        await Loaddata();
        StateHasChanged();
    }

    private async void ShowDetail()
    {
        if (CurItem == null && TblData != null)
        {
            var tagged = TblData.DefaultView.Cast<DataRowView>()
                .FirstOrDefault(r => r["tag"]?.ToString() == "1" || r["tag"]?.ToString()?.ToUpper() == "TRUE");
            if (tagged != null)
                CurItem = tagged;
        }

        if (CurItem == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            return;
        }

        var row = (CurItem as DataRowView)?.Row;
        if (row == null) return;

        string sttCtgs = row["stt_ctgs"]?.ToString()?.Trim() ?? "";
        string soLo    = row["so_lo"]?.ToString()?.Trim() ?? "";

        if (string.IsNullOrEmpty(sttCtgs))
        {
            myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            return;
        }
        var storeArrays = curCommand.Store_proc?.Split('|') ?? Array.Empty<string>();
        if (storeArrays.Length < 2)
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            return;
        }

        ShowLoadding = true;
        StateHasChanged();

        try
        {
            var para = new Dictionary<string, object>
            {
                { "@store",   storeArrays[1] },
                { "@Entries", sttCtgs }
            };
            var ds = await myDb.LoadDataset("EXEC @store @Entries", para);

            if (ds?.Tables?.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                TblDataCT = ds.Tables[0];

                int num = 1;
                foreach (DataRow r in TblDataCT.Rows)
                {
                    if (TblDataCT.Columns.Contains("stt"))
                        r["stt"] = num++;
                }
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["No data available"] + " !");
                return;
            }
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }

        FbrowseCT = _sFieldArrays.Length > 1 ? _sFieldArrays[1] : "";

        DetailTitle = IsLangEn
            ? $"{Lap["Detail"]}: {Lap["Journal entry no."]} {soLo}"
            : $"{Lap["Detail"]}: {Lap["Journal entry no."]} {soLo}";

        IsDetail = true;
        ShowDetail1ToolBar();
        _ = SetActiveComponentIdAsync("oBrowseCT");
        StateHasChanged();
    }

    private void HideDetail()
    {
        if (IsDetail2)
        {
            IsDetail2 = false;
            TblDataCT2 = null;
            ShowDetail1ToolBar();
            _ = SetActiveComponentIdAsync("oBrowseCT");
        }
        else
        {
            IsDetail = false;
            IsDetail2 = false;
            CurItemCT = null;
            ShowMainToolBar();
            _ = SetActiveComponentIdAsync("oBrowse1");
        }
        StateHasChanged();
    }

    private async void ShowDetail2()
    {
        if (CurItemCT == null)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            return;
        }

        var row = (CurItemCT as DataRowView)?.Row;
        if (row == null) return;

        string sttCtgs = row["stt_ctgs"]?.ToString()?.Trim() ?? "";
        string tkNo    = row["tk_no"]?.ToString()?.Trim() ?? "";
        string tkCo    = row["tk_co"]?.ToString()?.Trim() ?? "";
        string soLo    = row["so_lo"]?.ToString()?.Trim() ?? "";

        if (string.IsNullOrEmpty(sttCtgs))
        {
            myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            return;
        }

        var storeArrays = curCommand.Store_proc?.Split('|') ?? Array.Empty<string>();
        if (storeArrays.Length < 3)
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            return;
        }

        ShowLoadding = true;
        StateHasChanged();

        try
        {
            var para = new Dictionary<string, object>
            {
                { "@store",   storeArrays[2] },
                { "@Entries", sttCtgs },
                { "@Tk_no",   tkNo },
                { "@Tk_co",   tkCo }
            };
            var ds = await myDb.LoadDataset("EXEC @store @Entries, @Tk_no, @Tk_co", para);

            if (ds?.Tables?.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                TblDataCT2 = ds.Tables[0];
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["No data available"] + " !");
                return;
            }
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }

        FbrowseCT2 = _sFieldArrays.Length > 2 ? _sFieldArrays[2] : "";
        DetailTitle2 = IsLangEn
            ? $"{Lap["Detail"]}: {Lap["Journal entry no."]} {soLo} | {tkNo}/{tkCo}"
            : $"{Lap["Detail"]}: {Lap["Journal entry no."]} {soLo} | {tkNo}/{tkCo}";

        IsDetail2 = true;
        ShowDetail2ToolBar();
        _ = SetActiveComponentIdAsync("oBrowseCT2");
        StateHasChanged();
    }

    private void ShowDetail1ToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.AddOrderToolBarButton("button1", Lap["Detail"] + " - F5", 1);
        myStateMN.SetToolBar(new MyToolbar("Quit", true, "Esc"));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }

    private void ShowDetail2ToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Quit", true, "Esc"));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }

    private void ShowMainToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
        myStateMN.SetToolBar(new MyToolbar("Print", true, "F7"));
        myStateMN.AddOrderToolBarButton("button1", Lap["Detail"] + " - F5", 1);
    }

    private async void BtnFilterOk()
    {
        FilterErrors.Clear();
        if (!ValidateFilter()) return;

        ShowLoadding = true;
        myStateMN.SetStartDate(Ngay_ct1);
        myStateMN.SetEndDate(Ngay_ct2);

        await Loaddata();

        ShowLoadding = false;
        PopupVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void BtnFilterCancel()
    {
        PopupVisible = false;
        FilterErrors.Clear();
        StateHasChanged();
    }

    private bool ValidateFilter()
    {
        if (Ngay_ct1 == default)
        {
            FilterErrors.Add(Lap["Voucher date invalid"]);
            StateHasChanged();
            return false;
        }
        if (Ngay_ct2 == default)
        {
            FilterErrors.Add(Lap["Voucher date invalid"]);
            StateHasChanged();
            return false;
        }
        if (Ngay_ct1 > Ngay_ct2)
        {
            FilterErrors.Add(Lap["From date greater than to date"]);
            StateHasChanged();
            return false;
        }
        return true;
    }

    public override async Task Loaddata()
    {
        try
        {
            ShowLoadding = true;
            StateHasChanged();

            string dvcs = Ma_dvcs == "ALL" ? "" : Ma_dvcs?.Trim() ?? "";

            string sql = $"EXEC @store @ngay_ct1, @ngay_ct2, @so_ct1, @so_ct2, @ct_goc, @ma_dvcs";
            var para = new Dictionary<string, object>
            {
                { "@store",    Store_proc.Split('|')[0] },
                { "@ngay_ct1", Ngay_ct1 },
                { "@ngay_ct2", Ngay_ct2 },
                { "@so_ct1",   SoCt1?.Trim() ?? "" },
                { "@so_ct2",   SoCt2?.Trim() ?? "" },
                { "@ct_goc",   Loai_bc },
                { "@ma_dvcs",  dvcs + "%" },
            };
            _dsGlgsso3 = await myDb.LoadDataset(sql, para);

            if (_dsGlgsso3?.Tables?.Count > 0)
                TblData = _dsGlgsso3.Tables[0].Copy();
            else
            {
                TblData = new DataTable();
                myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            }
        }
        catch (Exception ex)
        {            
            TblData = new DataTable();
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    private async void Print()
    {
        if (TblData == null || TblData.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            return;
        }

        var taggedRows = TblData.AsEnumerable()
            .Where(r => TblData.Columns.Contains("tag") &&
                        r["tag"] != DBNull.Value &&
                        (r["tag"] is bool b ? b : r["tag"]?.ToString()?.Trim().ToUpper() is "TRUE" or "1"))
            .ToArray();

        if (taggedRows.Length == 0)
        {
            myStateMN.SetNewThongbao(Lap["Must mark before printing"] + " !");
            return;
        }

        var storeArrays = curCommand?.Store_proc?.Split('|') ?? Array.Empty<string>();
        if (storeArrays.Length < 2)
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            return;
        }

        ShowLoadding = true;
        StateHasChanged();

        try
        {
            var entries = string.Join(",", taggedRows.Select(r => r["stt_ctgs"].ToString()));
            var para = new Dictionary<string, object>
            {
                { "@store",   storeArrays[1] },
                { "@Entries", entries }
            };
            var ds = await myDb.LoadDataset("EXEC @store @Entries", para);

            if (ds?.Tables?.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                ds.Tables[0].TableName = "Table1";
                var aty = typeof(ReportOptionComponent<>).MakeGenericType(typeof(Glgsso3Model));
                int printed = 0;

                foreach (var taggedRow in taggedRows)
                {
                    string sttCtgs = taggedRow["stt_ctgs"]?.ToString()?.Trim() ?? "";
                    string soLo    = taggedRow["so_lo"]?.ToString()?.Trim() ?? "";
                    if (string.IsNullOrEmpty(sttCtgs)) continue;

                    var detailRows = ds.Tables[0].AsEnumerable()
                        .Where(r => r["stt_ctgs"]?.ToString()?.Trim() == sttCtgs)
                        .ToList();

                    if (detailRows.Count == 0) continue;

                    DataTable dtFiltered = ds.Tables[0].Clone();
                    dtFiltered.TableName = "Table1";
                    foreach (var r in detailRows)
                        dtFiltered.ImportRow(r);

                    var lsConverted = myDb.ConvertDataTable<Glgsso3>(dtFiltered);
                    var reportModel = new Glgsso3Model
                    {
                        So_lo     = soLo,
                        Startdate = Ngay_ct1,
                        Enddate   = Ngay_ct2,
                        Ma_dvcs   = Ma_dvcs ?? "",
                        Ngay_lo   = lsConverted.FirstOrDefault()?.Ngay_lo ?? DateTime.Today,
                        LsData    = lsConverted
                    };

                    var lsItems = new List<Glgsso3Model> { reportModel };
                    var par = new Dictionary<string, object>
                    {
                        { "LSItems", (object)lsItems },
                        { "Menu_id", (object)Menu_id }
                    };
                    var windowModel = new DxWindowModel(aty, par, true, $"BC{printed.ToString().Trim()}");
                    windowModel.nWitdh = "80vw";
                    par.Add("DxWindowmodel", windowModel);
                    await Modal.Show(windowModel);
                    printed++;
                }

                if (printed == 0)
                    myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            }
            else
            {
                myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Print error: " + ex.Message);
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }
   
    public override async void ExportData(int type)
    {
        if (IsDetail2)
            oBrowseCT2?.ExPortGrid(type);
        else if (IsDetail)
            oBrowseCT?.ExPortGrid(type);
        else
            oBrowse1?.ExPortGrid(type);
        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }
}
