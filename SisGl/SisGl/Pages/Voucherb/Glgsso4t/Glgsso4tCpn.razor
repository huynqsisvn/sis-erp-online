    private string FormatDetailSummaryText(GridCustomizeSummaryDisplayTextEventArgs e)
    {
        if (_dsDetail?.Tables?.Count < 1 || _dsDetail.Tables[0].Rows.Count == 0)
            return "0";

        var summaryRow = _dsDetail.Tables[0].Rows[0];

        Func<string, decimal> getVal = (col) =>
            summaryRow.Table.Columns.Contains(col) && summaryRow[col] != DBNull.Value
                ? Convert.ToDecimal(summaryRow[col])
                : 0m;

        string noCo1 = summaryRow.Table.Columns.Contains("no_co1") ? summaryRow["no_co1"]?.ToString() ?? "" : "";
        string noCo2 = summaryRow.Table.Columns.Contains("no_co2") ? summaryRow["no_co2"]?.ToString() ?? "" : "";

        switch (e.Item.Name)
        {
            case "ten_tk_du01":
            case "ten_tk_du201":
            case "dien_giai01":
                return CalcBalanceLabel("#", IsLangEn, true);
            case "ten_tk_du02":
            case "ten_tk_du202":
            case "dien_giai02":
                return Lap["Total arising amount:"];
            case "ten_tk_du03":
            case "ten_tk_du203":
            case "dien_giai03":
                return CalcBalanceLabel("#", IsLangEn, false);

            case "ps_no01":   
                var row = (CurItem as DataRowView)?.Row;
                return FormatDetailMoney("M_IP_TIEN",(decimal)(row["du_no"]));
                break;
            case "ps_no02":   return FormatDetailMoney("M_IP_TIEN",    getVal("ps_no"));
            case "ps_no03":   
                var row1 = (CurItem as DataRowView)?.Row;
                return FormatDetailMoney("M_IP_TIEN", (decimal)(row1["du_ck_no"]));
                break;
            case "ps_co01":   
                var row2 = (CurItem as DataRowView)?.Row;
                return FormatDetailMoney("M_IP_TIEN", (decimal)(row2["du_co"]));
                break;
            case "ps_co02":   return FormatDetailMoney("M_IP_TIEN",    getVal("ps_co"));
            case "ps_co03":   
                var row4 = (CurItem as DataRowView)?.Row;
                return FormatDetailMoney("M_IP_TIEN", (decimal)(row4["du_ck_co"]));
                break;
            case "ps_no_nt01": return FormatDetailMoney("M_IP_TIEN_NT", getVal("no_dk_nt"));
            case "ps_no_nt02": return FormatDetailMoney("M_IP_TIEN_NT", getVal("ps_no_nt"));
            case "ps_no_nt03": return FormatDetailMoney("M_IP_TIEN_NT", getVal("no_ck_nt"));
            case "ps_co_nt01": return FormatDetailMoney("M_IP_TIEN_NT", getVal("co_dk_nt"));
            case "ps_co_nt02": return FormatDetailMoney("M_IP_TIEN_NT", getVal("ps_co_nt"));
            case "ps_co_nt03": return FormatDetailMoney("M_IP_TIEN_NT", getVal("co_ck_nt"));
        }
        return "0";
    }

    private string CalcBalanceLabel(string noCo, bool isEnglish, bool isOpening)
    {
        switch (noCo)
        {
            case "N":
            case "Dr":
                return isOpening ? Lap["Opening debit balance:"] : Lap["Closing debit balance:"];
            case "C":
            case "Cr":
                return isOpening ? Lap["Opening credit balance:"] : Lap["Closing credit balance:"];
            default:
                return isOpening ? Lap["Opening balance:"] : Lap["Closing balance:"];
        }
    }

    private decimal GetVal(DataRow row, string col)
    {
        if (!row.Table.Columns.Contains(col) || row[col] == DBNull.Value) return 0m;
        return Convert.ToDecimal(row[col]);
    }

    private string GetOpt(string name) => myOption.GetOptionsValue(name) ?? "";

    private string GetOptInt(string name)
    {
        string f = GetOpt(name);
        if (string.IsNullOrWhiteSpace(f)) f = "N0";
        if (GetOpt("M_KIEU_SO_AM").Equals("2"))
            f = NormalizeNegativeFormat(f);
        return "{0:" + f + "}";
    }

    private string NormalizeNegativeFormat(string s)
    {
        if (s == null) return s;
        var parts = s.Split(';');
        if (parts.Length > 1 && parts[1].StartsWith("-"))
        {
            parts[1] = "(" + parts[1].Substring(1).Trim() + ")";
            return string.Join(";", parts);
        }
        return s;
    }

    private string FormatDetailMoney(string optionName, decimal value)
        => string.Format(GetOptInt(optionName), value);

