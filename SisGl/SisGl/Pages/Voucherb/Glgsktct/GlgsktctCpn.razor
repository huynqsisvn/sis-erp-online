@page "/glgsktct"
@page "/glgsktct/{Menu_id}"
@inherits RepoBaseComponent

@attribute [Authorize(Roles = "admin,glgsktct")]

<div class="row">
    <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@Fbrowse" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>

<!-- Filter Popup -->
<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="600px"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-2">
                <div class="rounded border border-secondary-subtle shadow-sm p-2 mb-2">  
                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["From date"]</label>
                        <div class="col-sm-8">
                            <DxDateEdit @bind-Date="Ngay_ct1" NullText="" Format="dd-MM-yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["To date"]</label>
                        <div class="col-sm-8">
                            <DxDateEdit @bind-Date="Ngay_ct2" NullText="" Format="dd-MM-yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Voucher code list"]</label>
                        <div class="col-sm-5">
                            <DxTextBox @bind-Text="MaCtGs" NullText="" />
                        </div>
                        <div class="col-sm-3">
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="@Lap["Select ..."]"
                                      Click="@OpenDsCtPopup" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Account"]</label>
                        <div class="col-sm-8">
                            <DxTextBox @bind-Text="Tk" NullText="" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Debit credit"]</label>
                        <div class="col-sm-4">
                            <DxTextBox @bind-Text="GhiNoCo" NullText="3" />
                        </div>
                        <div class="col-sm-4 text-muted small">@Lap["Debit credit hint"]</div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Reference account"]</label>
                        <div class="col-sm-8">
                            <DxTextBox @bind-Text="TkDu" NullText="" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Department code"]</label>
                        <div class="col-sm-8">
                            <DxTextBox @bind-Text="MaBpht" NullText="" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Project code"]</label>
                        <div class="col-sm-8">
                            <DxTextBox @bind-Text="MaVv" NullText="" />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label">@Lap["Base unit code"]</label>
                        <div class="col-sm-5">
                            <DxTextBox @bind-Text="FilterMaDvcs" NullText="" />
                        </div>
                        <div class="col-sm-3 text-muted small">@TenDvcs</div>
                    </div>

                    <div class="row align-items-center">
                        <div class="col-sm-4"></div>
                        <div class="col-sm-8">
                            <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                <input type="checkbox" @bind="ChuaDanhSoCtgs" />
                                <span>@Lap["Vouchers not yet numbered CTGS"]</span>
                            </label>
                        </div>
                    </div>
                </div>

                @if (FilterErrors.Any())
                {
                    <div class="alert alert-danger p-2 mt-1">
                        <ul class="mb-0">
                            @foreach (var err in FilterErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end mt-2 me-1">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnFilterOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnFilterCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@if (ShowDsCt)
{
    <div style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.45);z-index:1050;"
         @onclick="CloseDsCt">
    </div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                width:620px;max-width:96vw;max-height:80vh;
                display:flex;flex-direction:column;
                background:#fff;border-radius:6px;box-shadow:0 4px 24px rgba(0,0,0,0.25);z-index:1051;"
         @onclick:stopPropagation>
        <div class="modal-header bg-info" style="border-radius:6px 6px 0 0;flex-shrink:0;">
            <h5 class="modal-title text-white">@Lap["Voucher list"]</h5>
        </div>
        <div style="flex:1;overflow-y:auto;padding:8px;">
            <MultiChooseGridComponent Page_size="@_dsCtPagesize" EnableCheck="@_dsCtEnableCheck"
                                      SelectCol="@_dsCtCheckCol"
                                      CheckChangedCallBack="@OnCheckMaCtChanged"
                                      TblData="@TblDsCt"
                                      Fbrowse="@FbrowseDsCt" />
        </div>
        <div class="modal-footer" style="flex-shrink:0;border-radius:0 0 6px 6px;">
            <DxButton CssClass="btn btn-danger text-white" Click="@CloseDsCt"
                      Text="@Lap["Close"]" />
        </div>
    </div>
}

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 10px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@code {
    // Filter fields
    private string MaCtGs { get; set; } = "";
    private string Tk { get; set; } = "";
    private string GhiNoCo { get; set; } = "3";
    private string TkDu { get; set; } = "";
    private string MaBpht { get; set; } = "";
    private string MaVv { get; set; } = "";
    private string FilterMaDvcs { get; set; } = "";
    private string TenDvcs { get; set; } = "";
    private bool ChuaDanhSoCtgs { get; set; } = false;
    private List<string> FilterErrors { get; set; } = new();

    // Ds c.từ overlay
    private bool ShowDsCt { get; set; } = false;
    private DataTable TblDsCt { get; set; }
    private string FbrowseDsCt => IsLangEn
        ? "ma_ct:100:h=Voucher code;ten_ct2:300:h=Voucher name"
        : "ma_ct:100:h=Mã c.từ;ten_ct:300:h=Tên chứng từ";
    private string _dsCtCheckCol = "checkcol";
    private bool _dsCtEnableCheck = true;
    private int _dsCtPagesize = 20;

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wg.vb.03";
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        Ngay_ct1 = myStateMN.GetStartDate();
        Ngay_ct2 = myStateMN.GetEndDate();

        if (curCommand != null)
        {
            Store_proc = curCommand.Store_proc?.Split('|')[0] ?? "";
            Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            Ma_dvcs = myStateMN.GetMa_Dvcs();
            Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
            FilterMaDvcs = Ma_dvcs;

            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}",
                String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID,
                UserLang.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Print", false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            await Loaddata();
            StateHasChanged();
        }
        else
        {
            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
    }

    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                ShowLoadding = false;
                myStateMN.SetCurrentActionTask(ActionTask.Search);
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    public new async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;
            if (curCommand != null)
                Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void OnDvcsChanged(string ma_dvcs)
    {
        Ma_dvcs = ma_dvcs;
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
        FilterMaDvcs = Ma_dvcs;
        await Loaddata();
        StateHasChanged();
    }

    private void OpenDsCtPopup()
    {
        if (TblDsCt == null)
        {
            try
            {
                string sql = IsLangEn
                    ? "SELECT '0' AS checkcol, ma_ct, ten_ct2 FROM dmct WHERE ISNULL(ma_ct,'') <> '' ORDER BY stt"
                    : "SELECT '0' AS checkcol, ma_ct, ten_ct  FROM dmct WHERE ISNULL(ma_ct,'') <> '' ORDER BY stt";
                DataSet ds = myDb.LoadDataSet(sql);
                if (ds?.Tables?.Count > 0)
                    TblDsCt = myDb.SetNoneReadOnlyDataTable(ds.Tables[0]);
            }
            catch (Exception ex)
            {
                myStateMN.SetNewThongbao($"{Lap["Download failed: {ex.Message}"]}: {ex.Message}");
                return;
            }
        }

        // Reset check state
        if (TblDsCt != null)
        {
            foreach (DataRow row in TblDsCt.Rows)
                row[_dsCtCheckCol] = (object)"0";

            if (!string.IsNullOrEmpty(MaCtGs))
            {
                foreach (string maCt in MaCtGs.Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    DataRow found = TblDsCt.Select("ma_ct = '" + maCt.Trim() + "'").FirstOrDefault();
                    if (found != null)
                        found[_dsCtCheckCol] = (object)"1";
                }
            }
        }

        ShowDsCt = true;
        StateHasChanged();
    }

    private void OnCheckMaCtChanged(bool changed)
    {
        SyncMaCtGsFromTable();
        StateHasChanged();
    }

    private void SyncMaCtGsFromTable()
    {
        if (TblDsCt == null) return;
        DataRow[] rows = TblDsCt.Select(_dsCtCheckCol + "=1");
        MaCtGs = rows?.Length > 0
            ? string.Join(",", rows.Select(r => r["ma_ct"].ToString().Trim()))
            : "";
    }

    private void CloseDsCt()
    {
        SyncMaCtGsFromTable();
        ShowDsCt = false;
        StateHasChanged();
    }

    private async void BtnFilterOk()
    {
        FilterErrors.Clear();
        if (!ValidateFilter()) return;

        ShowLoadding = true;
        myStateMN.SetStartDate(Ngay_ct1);
        myStateMN.SetEndDate(Ngay_ct2);

        await Loaddata();

        ShowLoadding = false;
        PopupVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void BtnFilterCancel()
    {
        PopupVisible = false;
        FilterErrors.Clear();
        StateHasChanged();
    }

    private bool ValidateFilter()
    {
        if (Ngay_ct1 == default)
        {
            FilterErrors.Add(Lap["Voucher date invalid"]);
            StateHasChanged();
            return false;
        }
        if (Ngay_ct2 == default)
        {
            FilterErrors.Add(Lap["Voucher date invalid"]);
            StateHasChanged();
            return false;
        }
        if (Ngay_ct1 > Ngay_ct2)
        {
            FilterErrors.Add(Lap["From date greater than to date"]);
            StateHasChanged();
            return false;
        }
        return true;
    }

    private string BuildCondition()
    {
        var sb = new System.Text.StringBuilder();

        if (!string.IsNullOrWhiteSpace(MaCtGs))
        {
            var parts = MaCtGs.Split(',', StringSplitOptions.RemoveEmptyEntries)
                               .Select(p => p.Trim())
                               .Where(p => !string.IsNullOrEmpty(p));
            string inList = string.Join("','", parts);
            sb.Append($" AND a.ma_ct IN ('{inList}')");
        }

        if (!string.IsNullOrWhiteSpace(Tk))
            sb.Append($" AND a.tk LIKE '{Tk.Trim()}%'");

        if (!string.IsNullOrWhiteSpace(GhiNoCo) && GhiNoCo.Trim() != "3")
        {
            if (GhiNoCo.Trim() == "1")
                sb.Append(" AND (a.ps_no <> 0)");
            else if (GhiNoCo.Trim() == "2")
                sb.Append(" AND (a.ps_co <> 0)");
        }

        if (!string.IsNullOrWhiteSpace(TkDu))
            sb.Append($" AND a.tk_du LIKE '{TkDu.Trim()}%'");

        if (!string.IsNullOrWhiteSpace(MaBpht))
            sb.Append($" AND a.ma_bpht LIKE '{MaBpht.Trim()}%'");

        if (!string.IsNullOrWhiteSpace(MaVv))
            sb.Append($" AND a.ma_vv LIKE '{MaVv.Trim()}%'");

        string dvcs = string.IsNullOrWhiteSpace(FilterMaDvcs) ? Ma_dvcs : FilterMaDvcs.Trim();
        if (!string.IsNullOrWhiteSpace(dvcs))
            sb.Append($" AND a.ma_dvcs LIKE '{dvcs}%'");

        return sb.ToString();
    }

    public override async Task Loaddata()
    {
        try
        {
            ShowLoadding = true;
            StateHasChanged();

            string ngay_ct1 = Ngay_ct1.ToString("yyyyMMdd");
            string ngay_ct2 = Ngay_ct2.ToString("yyyyMMdd");
            string dvcs = string.IsNullOrWhiteSpace(FilterMaDvcs) ? Ma_dvcs : FilterMaDvcs.Trim();
            int isNoCTGS = ChuaDanhSoCtgs ? 1 : 0;
            string condition = BuildCondition().Replace("'", "''");

            string sql = $"exec {Store_proc} '{ngay_ct1}', '{ngay_ct2}', '{dvcs}', {isNoCTGS}, '{condition}'";
            DataSet ds = await myDb.LoadDataset(sql);

            if (ds?.Tables?.Count > 0)
                TblData = ds.Tables[0].Copy();
            else
            {
                TblData = new DataTable();
                myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Download failed: {ex.Message}"]}: {ex.Message}");
            TblData = new DataTable();
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    public override async void ExportData(int type)
    {
        oBrowse?.ExPortGrid(type);
        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }
}
