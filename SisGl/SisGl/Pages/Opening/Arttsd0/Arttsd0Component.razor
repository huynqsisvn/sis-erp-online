@page "/arttsd0"
@page "/arttsd0/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,arttsd0")]

<div class="d-flex mt-1 align-items-center gap-3">
    <h6 class="mb-0">@Lap["Customer"]</h6>
    <AutocompleteComponent Ma_dm="dmkh" @bind-Value="@M_KH" CssClass="w-25"/>
    <h6 class="mb-0">@Lap["Date"]:</h6>
    <span class="badge bg-secondary">@M_ngay_bd</span>    
</div>
<hr style="margin:6px;padding:0px;height:1px;" />
<div class="row mt-1" @onkeydown="OnKeyDown" @onkeydown:preventDefault="true">
    <FrmBrowseComponent @ref="oBrowse" TblData="@TblData" Fbrowse="@fbrowse" Page_size="@Page_size" SelectItem="CurItem" OnRowDbClick="@OnRDBClick" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxPopup @bind-Visible="@IsShowFrm"
             CloseOnEscape="true"
             Width="60vw"
             MinWidth="700px"
             Scrollable="true"
             MaxHeight="98vh"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true"
             ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxPopup>
}

@code {
public string preFilter = "";
string Ma_dvcs = "";
string Nam = "2024";
string M_ngay_bd = "01-01-2024";
string M_TK_TK_VT = "";

    private string _KH;
    public string M_KH
    {
        get { return _KH; }
        set
        {
            if (_KH != value)
            {
                _KH = value;
                Loaddata();
            }
        }
    }

    protected override void OnInitialized()
    {
        mPage = "arttsd0";
        editPage = "editarttsd0";
        IsShowCopy = false;
        IsShowImport = false;
        sqlTableName = "CTTT20";
        sqlTableView = "CTTT20";
        SqlTableKey = "stt_rec";
        SqlItemName = "ma_kh";
        M_TK_TK_VT = myOption.GetOptionsValue("M_TK_TK_VT");

        FrmType = typeof(Opening.Arttsd0.EditArttsd0);
        if (string.IsNullOrEmpty(Menu_id))
            Menu_id = "wg.sd.03";

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));
            string Menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(Menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New", true, "F4"));
                if (IsShowCopy) myStateMN.SetToolBar(new MyToolbar("Copy", false));
                if (IsShowImport) myStateMN.SetToolBar(new MyToolbar("Import", false));
                myStateMN.SetToolBar(new MyToolbar("Edit", true, "F3"));
                myStateMN.SetToolBar(new MyToolbar("Save", false));
                myStateMN.SetToolBar(new MyToolbar("Delete", true, "F8"));
                myStateMN.SetToolBar(new MyToolbar("Change", false));
                myStateMN.SetToolBar(new MyToolbar("View", true, "F2"));
                myStateMN.SetToolBar(new MyToolbar("Aproval", false));
                myStateMN.SetToolBar(new MyToolbar("Print", false));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Search", false));
                myStateMN.SetToolBar(new MyToolbar("Quit", false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            M_KH = "";
            await Language();

            Ma_dvcs = myStateMN.GetMa_Dvcs();
            if (string.IsNullOrEmpty(Ma_dvcs) || Ma_dvcs.Equals("ALL"))
                Ma_dvcs = "";
        }
    }

    public virtual void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.New:
                myStateMN.SetCurrentActionTask(ActionTask.New);
                V_Them();
                break;
            case ActionTask.Edit:
                myStateMN.SetCurrentActionTask(ActionTask.Edit);
                V_Sua();
                break;
            case ActionTask.View:
                myStateMN.SetCurrentActionTask(ActionTask.View);
                V_Xem();
                break;
            case ActionTask.Delete:
                V_Xoa();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
        }
    }

    public override async Task PageLoad()
    {
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        if (curCommand != null)
        {
            // Determine table based on Parameter
            string param = curCommand.Parameter?.Trim() ?? "B";
            if (param.Equals("M"))
            {
                sqlTableName = "CTTT30";
                sqlTableView = "CTTT30";
            }
            else
            {
                sqlTableName = "CTTT20";
                sqlTableView = "CTTT20";
            }

            fbrowse = IsLangEn ? curCommand.Vbrowse2 : curCommand.Vbrowse1;
            Page_size = int.Parse(myOption.GetOptionsValue("M_GRID_NROW").Trim());
            editPage = "";
        }
        StateHasChanged();
    }

    public override async Task Loaddata()
    {
        SelectedItem = null;
        Ma_dvcs = myStateMN.GetMa_Dvcs();
        if (string.IsNullOrEmpty(Ma_dvcs) || Ma_dvcs.Equals("ALL"))
            Ma_dvcs = "";

        DateTime dateTime = Convert.ToDateTime(mySysvar.GetSysVar("M_NGAY_KY1"));
        M_ngay_bd = dateTime.ToString("dd-MM-yyyy");
        Nam = dateTime.Year.ToString().Trim();

        string param = curCommand?.Parameter?.Trim() ?? "B";
        string ma_ct = param.Equals("M") ? "PN0" : "HD0";

        var parameters = new Dictionary<string, object>
        {
            { "@mua_ban", param },
            { "@ma_ct",   ma_ct },
            { "@ngay_ct_1", dateTime },
            { "@ngay_ct_2", dateTime },
            { "@ma_kh",   M_KH?.Trim() ?? "" },
            { "@ma_dvcs", Ma_dvcs.Trim() },
            { "@m_tk_tk_vt", M_TK_TK_VT?.Trim() ?? "" }
        };

        DataSet dsList = await myDb.LoadDataset("EXEC ARSD0_HD0 @mua_ban, @ma_ct, @ngay_ct_1, @ngay_ct_2, @ma_kh, @ma_dvcs, @m_tk_tk_vt", parameters);
        TblData = dsList.Tables[0];

        if (TblData.DefaultView.Count > 0)
            SelectedItem = TblData.DefaultView[0];

        if (oBrowse != null)
            await oBrowse.FocusGridAsync();

        StateHasChanged();
    }

    private bool CheckDataEntryLock()
    {
        DateTime M_NGAY_KS = Convert.ToDateTime(mySysvar.GetSysVar("M_NGAY_KS"));
        DateTime M_NGAY_KY1 = Convert.ToDateTime(mySysvar.GetSysVar("M_NGAY_KY1"));

        if (M_NGAY_KS >= M_NGAY_KY1)
        {
            myStateMN.SetNewThongbao(String.Format(Lap["Data entry locked until"] + " [{0}]!", M_NGAY_KS.ToString("dd-MM-yyyy")));
            return true;
        }
        return false;
    }

    public virtual void V_Them()
    {
        if (CheckDataEntryLock())
            return;

        Ma_dvcs = myStateMN.GetMa_Dvcs();
        if (string.IsNullOrEmpty(Ma_dvcs) || Ma_dvcs.Equals("ALL"))
        {
            myStateMN.SetNewThongbao(Lap["Please, select Unit code"] + "!");
            return;
        }

        string strKH = M_KH;
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null && rview.DataView.Table.Columns.Contains("ma_kh"))
        {
            strKH = rview["ma_kh"].ToString().Trim();
        }

        Par.Clear();
        Par.Add("Ma_ma", (object)(strKH + ";" + Nam.ToString().Trim()));
        Par.Add("Menu_id", (object)Menu_id);
        Par.Add("ShowAdd", (object)true);
        Par.Add("curActionTask", (object)ActionTask.New);
        Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
        IsShowFrm = true;
        StateHasChanged();
    }

    public override void V_Sua()
    {
        if (CheckDataEntryLock())
            return;

        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string stt_rec = rview["stt_rec"].ToString().Trim();

            Par.Clear();
            Par.Add("Ma_ma", (object)stt_rec);
            Par.Add("Menu_id", (object)Menu_id);
            Par.Add("ShowAdd", (object)true);
            Par.Add("curActionTask", (object)ActionTask.Edit);
            Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
            IsShowFrm = true;
            StateHasChanged();
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }

    public virtual void V_Xem()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string stt_rec = rview["stt_rec"].ToString().Trim();

            Par.Clear();
            Par.Add("Ma_ma", (object)stt_rec);
            Par.Add("Menu_id", (object)Menu_id);
            Par.Add("ShowAdd", (object)true);
            Par.Add("curActionTask", (object)ActionTask.View);
            Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
            IsShowFrm = true;
            StateHasChanged();
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }

    public virtual async void V_Xoa()
    {
        if (CheckDataEntryLock())
            return;

        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string stt_rec = rview["stt_rec"].ToString().Trim();
            string ma_kh_val = rview["ma_kh"].ToString().Trim();
            string so_ct_val = rview.DataView.Table.Columns.Contains("so_ct") ? rview["so_ct"].ToString().Trim() : stt_rec;

            string displayValue = $"{so_ct_val}/{ma_kh_val}";

            var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
            {
                Text = String.Format(Lap["Do you want to delete :{0} ?"], displayValue),
                Title = Lap["Confirm deletion of list"],
                OkButtonText = Lap["Yes"],
                CancelButtonText = Lap["No"],
                ShowIcon = true,
                ShowCloseButton = false,
                RenderStyle = MessageBoxRenderStyle.Danger
            });

            if (confirm)
            {
                await DeleteRecord(stt_rec);
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }

    private async Task DeleteRecord(string stt_rec)
    {
        try
        {
            string sql = $"DELETE FROM {sqlTableName} WHERE stt_rec = @stt_rec";
            var parameters = new Dictionary<string, object>
            {
                { "@stt_rec", stt_rec }
            };
            await myDb.LoadDataset(sql, parameters);
            await Loaddata();
            myStateMN.SetNewThongbao(String.Format(Lap["Delete successfully : {0}"], stt_rec));
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Delete failed"] + ": " + ex.Message);
        }
    }

    private async void OnDvcsChanged(string _ma_dvcs)
    {
        if (!string.IsNullOrEmpty(_ma_dvcs) && !_ma_dvcs.Equals("ALL"))
        {
            await Loaddata();
            StateHasChanged();
        }
        else
        {
            myStateMN.SetNewThongbao(Lap["Unit code is empty"] + "!");
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e is null) return;
        if (string.Equals(e.Key, "F2", StringComparison.OrdinalIgnoreCase))
        {
            try { V_Xem(); } catch (Exception ex) { Console.WriteLine(ex.Message); }
        }
        else if (string.Equals(e.Key, "F3", StringComparison.OrdinalIgnoreCase))
        {
            try { V_Sua(); } catch (Exception ex) { Console.WriteLine(ex.Message); }
        }
        else if (string.Equals(e.Key, "F4", StringComparison.OrdinalIgnoreCase))
        {
            try { V_Them(); } catch (Exception ex) { Console.WriteLine(ex.Message); }
        }
    }

    public override async void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }
}
