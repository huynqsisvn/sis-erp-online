    bool DsTkDuVisible { get; set; } = false;
    bool DsTkEditingCo { get; set; } = false;
    bool DsTkDuEditingCo { get; set; } = false;
    private string Ma_nkc { get; set; } = "NKT";
    private bool AllowEditMode = true;
    private string columnName = nameof(columnName);
    DataTable TblDataTk { get; set; }
    DataTable TblDmtkdusnkbh { get; set; }
    private string TkTien { get; set; } = "111,112,1132,1211,131";
    private string TkNoCols { get; set; } = "156,152";

    private DateTime? NgayMs { get; set; }
    private string TkNo { get; set; } = "";
    private string TkCo { get; set; } = "";
    private int Mau_bc;
    bool DsTkEditingCols { get; set; } = false;
    private bool isMauNT = false;
    private string Condition = "";
    private List<GLSNKMHModel> LsData;

    private List<string> Errors { get; set; } = new();

    string CheckCol = "checkcol";
    private string fbrowseTk = "tk:120:h=Tk;ten_tk:350:h=Tên tk";
    private string fbrowseTkDu = "stt:120:h=stt;tk:120:h=Tk đ.ứng;ten_tk:350:h=Tên in;ten_tk2:350:h=Tên 2";
    private bool EnableCheck = true;
    int _pagesize = 20;

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wg.gb.06";
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        Ngay_ct1 = myStateMN.GetStartDate();
        Ngay_ct2 = myStateMN.GetEndDate();
        NgayMs = DateTime.Now.Date;

        if (curCommand != null)
        {
            Store_proc = curCommand.Store_proc?.Split('|')[0] ?? "";
            Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
        }
        fbrowseTk = IsLangEn ? "tk:120:h=Account;ten_tk:350:h=Account Name" : "tk:120:h=Tài khoản;ten_tk:350:h=Tên tài khoản";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            Ma_dvcs = myStateMN.GetMa_Dvcs(); Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
