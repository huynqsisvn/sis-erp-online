    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    private void Btndstk_tien_Click()
    {
        DsTkEditingCols = false;
        ChonTkTien();
    }

    private void ChonTkTien()
    {
        EnsureTkTablesLoaded();
        if (TblDataTk != null)
        {
            foreach (DataRow r in TblDataTk.Rows)
                r[CheckCol] = (object)"0";
            if (!string.IsNullOrEmpty(TkTien))
            {
                var parts = TkTien.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim());
                foreach (var p in parts)
                {
                    DataRow r = TblDataTk.Select($"tk = '{p}'").FirstOrDefault();
                    if (r != null) r[CheckCol] = (object)"1";
                }
            }
        }
        DsTkVisible = true;
    }
    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Quit:
                myStateMN.SetCurrentActionTask(ActionTask.None);
                ShowPrint = false;
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }

    async void ExportData(int type)
    {
        oBrowse?.ExPortGrid(type);
        myStateMN.SetNewThongbao("Export successfully");
    }


    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void ConfirmGridView_OnOk()
    {
        // if (!CheckValid()) return;

        if (NgayMs.HasValue && NgayMs.Value > Ngay_ct1)
            NgayMs = Ngay_ct1;

        ShowLoadding = true;
        myStateMN.SetStartDate(Ngay_ct1);
        myStateMN.SetEndDate(Ngay_ct2);

        await Loaddata();

        ShowLoadding = false;
        PopupVisible = false;
        InvokeAsync(StateHasChanged);
    }

    public string GetCondition()
    {   
        string cond = " and (tk like ''%'') and (tk_du like ''%'')";

        if (!string.IsNullOrWhiteSpace(TkTien))
        {
            var listTk = TkTien
                .Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrEmpty(x))
                .ToList();

            string condTk = string.Join(" or ", listTk.Select(x => $"(tk like ''{x}%'' )"));
            cond = $"  and (tk_du like ''%'') and ({condTk})";
        }

        return cond;
    }

    public string GetCondition2()
    {
        string cond = " and (tk like ''%'') and (tk_du like ''%'')";

        if (!string.IsNullOrWhiteSpace(TkTien))
        {
            var listTkDu = TkTien
                .Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrEmpty(x))
                .ToList();

            string condTkDu = string.Join(" or ", listTkDu.Select(x => $"(tk_du like ''{x}%'' )"));
            cond = $"and ({condTkDu}) and (tk like ''%'')";
        }

        return cond;
    }

    private string ConditionTk(string strtk, string typetk)
    {
        if (string.IsNullOrWhiteSpace(strtk)) return "";
        var parts = strtk.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToArray();
        if (parts.Length == 0) return "";
        var sb = new System.Text.StringBuilder();
        sb.Append(" and (");
        for (int i = 0; i < parts.Length; i++)
        {
            if (i > 0) sb.Append(" or ");
            sb.Append($"{typetk} like '{parts[i]}%'");
        }
        sb.Append(")");
        return sb.ToString();
    }

    private void Btndstk_no_Click()
    {
        DsTkEditingCo = false;
        ChonTkNo();
    }

    private void ChonTkNo()
    {
        EnsureTkTablesLoaded();
        if (TblDataTk != null)
        {
            foreach (DataRow r in TblDataTk.Rows)
                r[CheckCol] = (object)"0";
            if (!string.IsNullOrEmpty(TkNo))
            {
                var parts = TkNo.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim());
                foreach (var p in parts)
                {
                    DataRow r = TblDataTk.Select($"tk = '{p}'").FirstOrDefault();
                    if (r != null) r[CheckCol] = (object)"1";
                }
            }
        }
        DsTkVisible = true;
    }

    private void EnsureTkTablesLoaded()
    {
        if (TblDataTk != null) return;

        try
        {
            string sql = "Select '0' as checkcol ,RTRIM(tk) as tk, ten_tk,ten_tk2 from dmtk where status = '1' order by tk";
            DataSet ds = myDb.LoadDataSet(sql);
            if (ds != null && ds.Tables.Count > 0)
            {
                var dt = ds.Tables[0];
                TblDataTk = myDb.SetNoneReadOnlyDataTable(dt.Copy());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }


    void OnCheckTkChanged(bool changed)
    {
        if (DsTkEditingCo)
        {
            string _tk = "";
            DataRow[] rows = TblDataTk.Select("checkcol=1");
            if (rows != null && rows.Length > 0)
            {
                foreach (DataRow row in rows)
                {
                    _tk += row["tk"].ToString().Trim() + ",";
                }
                if (!string.IsNullOrEmpty(_tk))
                    TkCo = _tk.Substring(0, _tk.Length - 1);
                else
                    TkCo = "";
            }
            else
                TkCo = "";
        }
        else
        {
            string _tk = "";
            DataRow[] rows = TblDataTk.Select("checkcol=1");
            if (rows != null && rows.Length > 0)
            {
                foreach (DataRow row in rows)
                {
                    _tk += row["tk"].ToString().Trim() + ",";
                }
                if (!string.IsNullOrEmpty(_tk))
                    TkNo = _tk.Substring(0, _tk.Length - 1);
                else
                    TkNo = "";
            }
            else
                TkNo = "";
        }
        StateHasChanged();
    }

    private void CloseDsTk()
    {
        DsTkVisible = false;

        string selectedTks = string.Join(",",
            TblDataTk.Select("checkcol='1'")
                     .Select(r => r["tk"].ToString().Trim())
                     .ToArray());

        if (DsTkEditingCo)
        {
            TkCo = selectedTks;
        }
        else if (DsTkEditingCols)
        {
            TkNoCols = selectedTks;
        }
        else
        {
            TkTien = selectedTks;
        }

        StateHasChanged();
    }


    private void CancelDsTk()
    {
        DsTkVisible = false;
    }

    private void DsTkConfirm()
    {
        DsTkVisible = false;
        StateHasChanged();
    }

    private void DsTkCancel()
    {
        DsTkVisible = false;
    }

    private void TxtNgayCt1_LostFocus()
    {
        if (!NgayMs.HasValue || NgayMs.Value == default)
            NgayMs = Ngay_ct1;
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool flag = true;
        if (flag && Ngay_ct1 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            flag = false;
        }
        if (flag && Ngay_ct2 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            flag = false;
        }
        if (flag && Ngay_ct1 > Ngay_ct2)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            flag = false;
        }
        if (flag && NgayMs.HasValue && NgayMs != default && NgayMs.Value > Ngay_ct1)
        {
            Errors.Add("Ngày mở sổ không hợp lệ!");
            flag = false;
        }
        StateHasChanged();
        return flag;
    }

    void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
    async void OnDvcsChanged(string ma_dvcs)
    {
        Ma_dvcs = ma_dvcs;
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
        await Loaddata();
        StateHasChanged();
    }
    
    
    async Task Loaddata()
    {
        try
        {
            if (Ngay_ct1 == null || Ngay_ct2 == null)
            {
                myStateMN.SetNewThongbao("Chưa khai báo ngày chứng từ!");
                return;
            }

            ShowLoadding = true;
            string store = Store_proc; 
            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;

            string Condition = GetCondition();
            string Condition2 = GetCondition2();

            string Ngay1 = Ngay_ct1.ToString("yyyyMMdd") ?? "";
            string Ngay2 = Ngay_ct2.ToString("yyyyMMdd") ?? "";


            string strsql =
                $"EXEC {store} '{Ngay1}', '{Ngay2}', '{Condition}', '{Condition2}', '{MaDVCS}'";

            DataSet ds = await myDb.LoadDataset(strsql);

            if (ds != null && ds.Tables.Count > 0)
            {
                TblData = ds.Tables[0].Copy();


                if (!TblData.Columns.Contains("stt1"))
                    TblData.Columns.Add("stt1", typeof(int));

                int num = 1;
                foreach (DataRow row in TblData.Rows)
                {
                    if (TblData.Columns.Contains("ngay") && row["ngay"] != DBNull.Value)
                        row["stt1"] = num++;
                }
            }
            else
            {
                TblData = new DataTable();
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"Lỗi tải dữ liệu: {ex.Message}");
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    public override void Print()
    {
        LsData = new List<GLSNKMHModel>();
        GLSNKMHModel Data = new GLSNKMHModel();
        string modelstr = SisFunc.Converts.DataTable2Model(TblData, "GLSNKMH");
        if (TblData != null)
        {
            List<GLSNKMH> listObj = myDb.ConvertDataTable<GLSNKMH>(TblData);
            Data.LsData = listObj;
        }
        string MaDVCS = myStateMN.GetDvcs().Ma_dvcs;
        MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
        Data.Ngay_ct1 = Ngay_ct1;
        Data.Ngay_ct2 = Ngay_ct2;
        Data.Condition = Condition;
        Data.MaDVCS = MaDVCS;
        Data.Mau_bc = Mau_bc;
        Data.ngay_ms = NgayMs.HasValue ? NgayMs.Value.ToString("dd-MM-yyyy") : string.Empty;
        LsData.Add(Data);

        //ShowPrint = true;
        ShowReport(LsData, typeof(GLSNKMHModel));
    }
