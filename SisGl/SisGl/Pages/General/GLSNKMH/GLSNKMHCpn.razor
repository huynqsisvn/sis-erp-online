@page "/glsnkmh"
@page "/glsnkmh/{Menu_id}"
@inherits RepoBaseComponent

@attribute [Authorize(Roles = "admin,glsnkmh")]

<div class="row">
    <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@Fbrowse" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>

<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="870px"
         Height="300px"
         ShowFooter="true" Context="windowContext"
         HeaderText='@Lap["Filter"]'>
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-3">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["From date"]">
                        <DxDateEdit @bind-Date="Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ValueChanged="@((DateTime d) => TxtNgayCt1_LostFocus())" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["To date"]">
                        <DxDateEdit @bind-Date="Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["The accounts have"]">
                        <div class="d-flex">
                            <DxTextBox CssClass="flex-grow-1 me-2" @bind-Text="TkTien" ReadOnly="true" />
                            <DxButton RenderStyle="ButtonRenderStyle.Success" Text="..." Click="@Btndstk_tien_Click" />
                        </div>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Debit account columns"]">
                        <div class="d-flex">
                            <DxTextBox CssClass="flex-grow-1 me-2" @bind-Text="TkNoCols" ReadOnly="true" />
                        </div>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Book opening date"]">
                        <DxDateEdit @bind-Date="NgayMs" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12">
                        <hr />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        }
    </BodyTemplate>

    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end mt-2">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

<DxPopup @bind-Visible="DsTkVisible" Width="800px" Height="500px" CloseOnOutsideClick="false" ShowFooter="true" HeaderText="@Lap["Chọn tài khoản"]">
    <BodyTemplate>
        <div class="p-3">
            <MultiChooseGridComponent Page_size="@_pagesize" EnableCheck="@EnableCheck" SelectCol="@CheckCol" CheckChangedCallBack="@OnCheckTkChanged" TblData="@TblDataTk" Fbrowse="@fbrowseTk"></MultiChooseGridComponent>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex justify-content-end">
            <DxButton RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@CloseDsTk" CssClass="me-2" />
            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@CancelDsTk" />
        </div>
    </FooterTemplate>
</DxPopup>
@if (ShowPrint)
{
    <DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup"
             @bind-Visible="@ShowPrint"
             Width="80%" Height="90%"
             ShowFooter="false" Context="windowContext"
             HeaderText="Printer">
        <BodyTemplate>
            <ReportOptionComponent LSItems="LsData" Menu_id="@Menu_id.Replace('_', '.')" OnBack="@(() => { ShowPrint = false; })"></ReportOptionComponent>
        </BodyTemplate>
    </DxPopup>
}

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 20px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@code {
