    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            Ma_dvcs = myStateMN.GetMa_Dvcs(); Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync(IsDetail ? "oBrowseCT" : "oBrowse");
            await Loaddata();
            StateHasChanged();
        }
        else
        {
            if (IsDetail)
            {
                await oBrowse.FocusGridAsync();
            }
            else
            {
                await oBrowseCT.FocusGridAsync();
            }
        }
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    public override async Task Loaddata()
    {
        if (Ngay_ct1 == null || Ngay_ct2 == null || Ngay_ct1 > Ngay_ct2)
        {
            myStateMN.SetNewThongbao(Lap["Incorrect date declaration"] + " !");
            return;
        }

        ShowLoadding = true;

        string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
        MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
        string tkParam = string.IsNullOrWhiteSpace(Tk) ? " " : Tk.Trim();
        string maKhParam = string.IsNullOrWhiteSpace(Ma_kh) ? " " : Ma_kh.Trim();
        string gopTk = LoaiBC;   // 1 = Có gộp, 0 = Không gộp

        // Danh sách tham số đúng theo store ARSO5
        string param_name =
            "@tk;@ma_kh;@ngay_ct1;@ngay_ct2;@gop_tk;@ma_dvcs";

        string param_value =
            $"{tkParam};" +
            $"{maKhParam};" +
            $"{Ngay_ct1:yyyyMMdd};" +
            $"{Ngay_ct2:yyyyMMdd};" +
            $"{gopTk};" +
            $"{MaDVCS}";

        DataSet ds = await myDb.LoadStoreProcedure("ARSO5", param_name, param_value);

        if (ds?.Tables?.Count > 0)
        {
            TblDataCT = ds.Tables[0].Copy();

            TblData = ds.Tables[0].Copy();

            if (ds.Tables.Count > 1)
                TblDataCT1 = ds.Tables[1].Copy();
            else
                TblDataCT1 = new DataTable();
        }
        else
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            TblDataCT = new DataTable();
            TblData = new DataTable();
            TblDataCT1 = new DataTable();
        }

        ShowLoadding = false;
        StateHasChanged();
    }



    public override void Print()
    {
        LsData = new List<ARSO5Model>();
        ARSO5Model Data = new ARSO5Model();
        Data.Startdate = (DateTime)Ngay_ct1;
        Data.Enddate = (DateTime)Ngay_ct2;
        Data.Title_tk = string.Format("Tài khoản: {0} - {1}", Tk.Trim(), Ten_tk);
        Data.Title_kh = string.Format("Khách hàng: {0} - {1}", string.IsNullOrEmpty(Ma_kh) ? "" : Ma_kh.Trim(), Ten_kh);
        Data.Title_ma_nt = $"Loại tiền: {Ma_nt}";
        Data.LsData = myDb.ConvertDataTable<ARSO5>(TblData);
        Data.LsDataCT = myDb.ConvertDataTable<ARSO5>(TblDataCT);
        Data.LsDataCT1 = myDb.ConvertDataTable<ARSO5>(TblDataCT1);

        LsData.Add(Data);

        ShowReport(LsData, typeof(ARSO5Model));
    }
