@page "/arso5"
@page "/arso5/{menu_id}"
@inherits RepoBaseComponent

@attribute [Authorize(Roles = "admin,arso5")]
<div class="row" onkeydown="_handleFunctionKeys(event);">
    @if (!IsDetail)
    {
        if (Ma_nt == "VND")
        {
            <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblDataCT" SelectItem="@SelectedItem" Fbrowse="@FbrowseCT" IsLangEn="@IsLangEn" CustomSummaryTextFormatter="@FormatSummaryText"></FrmBrowseComponent>
        }
        else
        {
            <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@FbrowsePH" IsLangEn="@IsLangEn" CustomSummaryTextFormatter="@FormatSummaryText" />
        }
    }
    else
    {
        <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@FbrowsePH" IsLangEn="@IsLangEn" CustomSummaryTextFormatter="@FormatSummaryText"></FrmBrowseComponent>
    }
</div>
<!-- Popup Filter -->
<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="500px"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 5rem; height:5rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container pt-1">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Account"]">
                        <Template>
                            <div class="col p-0">
                                <AutocompleteComponent TblData="@TblDmtk" Ma_dm="dmtk" @bind-Value="@Tk" IsEnable="@AllowEditMode" SelectChanged="@OnAutoCompleteTKChanged" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Customer code"]">
                        <Template>
                            <div class="col p-0">
                                <AutocompleteComponent TblData="@TblDmkh" Ma_dm="dmkh" @bind-Value="@Ma_kh" IsEnable="@AllowEditMode" SelectChanged="@OnAutoCompleteKHChanged" IsLangEn="@IsLangEn"></AutocompleteComponent>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_Ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Merge by account"]">
                        <DxComboBox Data="@StatusList"
                                    @bind-Value="@LoaiBC"
                                    ValueField="Value"
                                    TextField="Text"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="1- Có gộp" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report template"]">
                        <DxComboBox Data="@StatusList1"
                                    @bind-Value="@Ma_nt"
                                    ValueField="Value"
                                    TextField="Text"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="VND" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Book opening date"]">
                        <DxDateEdit @bind-Date="NgayMs" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col mx-4" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnSave" />
                <DxButton CssClass="col" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@if (ShowPrint)
{
    <DxPopup @ref="popPrint"
             CloseOnOutsideClick="false"
             CssClass="dxPopup"
             @bind-Visible="@ShowPrint"
             Width="80%" Height="90%"
             ShowFooter="false"
             HeaderText="@Lap["Printer"]">
        <BodyTemplate Context="popupCtx2">
            <ReportOptionComponent LSItems="@LsData" Menu_id="@Menu_id.Replace('_', '.')" OnBack="() => { ShowPrint = false; }" />
        </BodyTemplate>
    </DxPopup>
}

<style>
    .grid-wrapper {
        display: grid;
        grid-template-rows: 1fr; /* Chỉ một hàng cho lưới */
        height: 100vh; /* Khớp viewport */
        gap: 0;
    }

    .grid-container {
        position: relative;
        overflow-x: auto; /* Cuộn ngang cho lưới */
        width: 100%;
    }

    .grid-item.detail {
        overflow-y: auto; /* Cuộn dọc cho lưới */
    }

    .grid0-frm-height {
        height: 86vh; /* Tăng chiều cao để chiếm gần hết viewport */
    }

    /* Style cho dòng tóm tắt trong lưới */
    .summary-row {
        font-weight: bold;
        background-color: #edf2fa;
    }
</style>

