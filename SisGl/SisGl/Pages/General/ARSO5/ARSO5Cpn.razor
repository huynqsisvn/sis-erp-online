    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang))
            {
                if (UserLang.Equals("En"))
                {
                    IsLangEn = true;
                }
            }
            if (curCommand != null)
            {
                FbrowseCT = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    string NormalizeOptionNegativeFormat(string s)
    {
        if (s == null) return s;
        var parts = s.Split(';');
        if (parts.Length > 1 && parts[1].StartsWith("-"))
        {
            parts[1] = "(" + parts[1].Substring(1).Trim() + ")";
            return string.Join(";", parts);
        }
        return s;
    }
    string GetOpt(string name) => myOption.GetOptionsValue(name) ?? "";
    string GetOptInt(string name)
    {
        string f = GetOpt(name).ToString();
        if (GetOpt("M_KIEU_SO_AM").ToString().Equals("2"))
            f = NormalizeOptionNegativeFormat(f);
        return "{0:" + f + "}";
    }
    string FormatSummaryText(GridCustomizeSummaryDisplayTextEventArgs e)
    {
        if (TblDataCT1 == null || TblDataCT1.Rows.Count == 0)
            return null;

        var totalRow = TblDataCT1.Rows[0];

        switch (e.Item.Name)
        {
            case "dien_giai01":
                return Lap["Beginning balance"];
            case "dien_giai02":
                return Lap["Total arising during the period"];
            case "dien_giai03":
                return Lap["Ending balance"];
            case "ps_no01":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["no_dk"]);
            case "ps_no02":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["ps_no"]);
            case "ps_no03":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["no_ck"]);

            case "ps_no_nt01":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["no_dk_nt"]);
            case "ps_no_nt02":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["ps_no_nt"]);
            case "ps_no_nt03":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["no_ck_nt"]);

            case "ps_co_nt01":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["co_dk_nt"]);
            case "ps_co_nt02":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["ps_co_nt"]);
            case "ps_co_nt03":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["co_ck_nt"]);

            case "ps_co01":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["co_dk"]);
            case "ps_co02":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["ps_co"]);
            case "ps_co03":
                return string.Format(GetOptInt("M_IP_TIEN"), totalRow["co_ck"]);
        }

        return null;
    }
