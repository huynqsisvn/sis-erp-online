            {

            }
        }
    }
    private async Task SetActiveComponentIdAsync(string id)
    {
        try
        {
            ActiveComponentId = id ?? ActiveComponentId;
            if (Pageobj != null)
            {
                await JavacriptS.InvokeVoidAsync("SetPageFModeObj", Pageobj, ActiveComponentId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("SetActiveComponentIdAsync error: " + ex.Message);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "ws_bh_11";
        curCommand = await Commands.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        Tu_ngay = myStatemanagerment.GetStartDate();
        Den_ngay = myStatemanagerment.GetEndDate();

        if (curCommand != null)
        {
            _store_proc = curCommand.Store_proc.Split('|')[0];
            fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
        }

    }
    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Button1:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Quit:
                myStatemanagerment.SetCurrentActionTask(ActionTask.None);
                ShowPrint = false;
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }
    async void ExportData(int type)
    {
        _FrmBrowse.ExPortGrid(type);
        myStatemanagerment.SetNewThongbao(Lap["Export successfully"].ToString());
    }
    public void Dispose()
    {
        myStatemanagerment.OnActionTaskChanged -= OnActionTaskchanged;
        myStatemanagerment.OnLangguaChanged -= OnLangguachange;
    }

    private string UserLang { get; set; } = "";
    private bool IsLangEn = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStatemanagerment.GetCurUser();            
            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStatemanagerment.SetToolBar(new MyToolbar("toolbar", true));
                myStatemanagerment.SetToolBar(new MyToolbar("Search", true));
                myStatemanagerment.SetToolBar(new MyToolbar("Print", true));
                //myStatemanagerment.AddToolBarButton("Button1", @Lap["Filter"]);
                myStatemanagerment.SetToolBar(new MyToolbar("Export", true));              
            }
            else
            {
                myStatemanagerment.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStatemanagerment.OnActionTaskChanged += OnActionTaskchanged;
            myStatemanagerment.OnLangguaChanged += OnLangguachange;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync("oBrowse");
            await Language();
            await Loaddata();
        }
    }
    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
        {
            await Language();
        }
    }
    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await Localstore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang))
            {
                if (UserLang.Equals("En"))
                {
                    IsLangEn = true;
                }
            }
            if (curCommand != null)
            {
                fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    #region "Tim kiem"
    private DateTime Tu_ngay = DateTime.Now.Date;
    private DateTime Den_ngay = DateTime.Now.Date;

    private string Ma_kh = "";   

    async void BtnSave()
    {
        ShowLoadding = true;
        myStatemanagerment.SetStartDate((DateTime)Tu_ngay);
        myStatemanagerment.SetEndDate((DateTime)Den_ngay);
        await Loaddata();
        ShowLoadding = false;
        PopupVisible = false;
        InvokeAsync(StateHasChanged);
    }
    void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
    async Task Loaddata()
    {   
        string Ma_dvcs = myStateMN.GetDvcs().Ma_dvcs.Trim();
        string parram_name = "StartDate;EndDate;LoaiBC;bo_nkcd;Ma_dvcs";
        string parram_value = "";
        if (Tu_ngay != null)
        {
            parram_value = ((DateTime)Tu_ngay).ToString("yyyyMMdd");
        }
        if (Den_ngay != null)
        {
            parram_value += ";" + ((DateTime)Den_ngay).ToString("yyyyMMdd");
        }
        else
        {
            parram_value += ";";
        } 
        parram_value += ";1;0;";
        DataSet ds = await myDb.LoadStoreProcedure(_store_proc, parram_name, parram_value);

        TblData = ds.Tables[0].Copy();
        //string modelstr = SisFunc.Converts.DataTable2Model(TblData, "Glso2");
        StateHasChanged();
    }

    void Print()
    {
        LsData = new List<Glso2Model>();
        Glso2Model _curModel = new Glso2Model();
        List<Glso2> lst = myDb.ConvertDataTable<Glso2>(TblData);
        _curModel.LsData = lst;
        _curModel.Tu_ngay = this.Tu_ngay;
        _curModel.Den_ngay = this.Den_ngay;
        LsData.Add(_curModel);

        ShowPrint = true;        
    }
    #endregion
}