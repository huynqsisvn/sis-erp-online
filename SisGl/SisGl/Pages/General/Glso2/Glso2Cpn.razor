@page "/glso2"
@page "/glso2/{Menu_id}"

@inject IDbManager myDb
@inject NavigationManager navigation
@inject Statemanagerment myStatemanagerment
@inject ILocalStorageService Localstore
@inject ICommandManager Commands
@implements IDisposable
@inject IJSRuntime JavacriptS
@inject IOptionsManager options
@inherits RepoBaseComponent

@attribute [Authorize(Roles = "admin,glso2")]

<div class="row" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="@_FrmBrowse" TblData="@TblData" SelectItem="@SelectItems" Fbrowse="@fbrowse" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>

<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="500px"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 5rem; height:5rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container pt-1">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Tu_ngay" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Den_ngay" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>
                    
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["ID"]">
                        <DxTextBox CssClass="col" @bind-Text="@Ma_kh" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idMa_kh" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        }
        
    </BodyTemplate>

    <FooterTemplate>
        @if (!ShowLoadding)
        {            
             <div class="row justify-content-end align-content-end mt-2">
                <DxButton Context="another_name6" CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnSave" />
                <DxButton Context="another_name7" CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>            
        }
    </FooterTemplate>
</DxPopup>
@if(ShowPrint)
{
<DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@ShowPrint"
         Width="80%" Height="90%"
         ShowFooter="false" Context="windowContext"
         HeaderText="@Lap["Printer"]">
    <BodyTemplate>
            <ReportOptionComponent LSItems="LsData" Menu_id="@Menu_id.Replace('_','.')" OnBack="@(()=>{ShowPrint=false;})"></ReportOptionComponent>
    </BodyTemplate>    
</DxPopup>
}
<style>
    .popup-button-footer {
        width: 100px; 
        margin-right: 20px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>
@code {   
   
    bool ShowLoadding { get; set; } = false;
    bool PopupVisible { get; set; } = false;
    bool ShowPrint { get; set; } = false;

    DxPopup popFilter { get; set; }
    DxPopup popPrint { get; set; }
    
    public Users CurUser;
    private string fbrowse = "";
    private Command curCommand = new Command();
    string _store_proc = "";

    private DataTable TblData { get; set; }    
    private string mPage = "Glso2";
    FrmBrowseComponent _FrmBrowse{ get; set; }
    private List<Glso2Model> LsData;

    object SelectedDataItem { get; set; }
    void SelectItems(object item)
    {
        SelectedDataItem = item;
    }
    public DotNetObjectReference<Glso2Cpn> Pageobj;
    private string ActiveComponentId = "oBrowse";
    [JSInvokable]
    public async void GridFMode(string value, string Id)
    {
        if (!string.IsNullOrEmpty(Id) && Id.Equals("oBrowse"))
        {
            oBrowseHotKeyFunction(value);
        }
    }
