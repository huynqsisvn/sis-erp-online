@using System.Text
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject ILocalStorageService Localstore

<DxPopup @bind-Visible="Visible" Width="870px" Height="600px" CloseOnOutsideClick="false" ShowFooter="true" HeaderText="@Title">
    <BodyTemplate>
        <div class="p-3">
            <div class="mb-3 row">
                <label class="col-sm-2 col-form-label">C.từ từ ngày</label>
                <div class="col-sm-4">
                    <DxDateEdit @bind-Date="NgayCt1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ValueChanged="OnNgayCt1Changed" />
                </div>

                <label class="col-sm-2 col-form-label text-end">Đến ngày</label>
                <div class="col-sm-4">
                    <DxDateEdit @bind-Date="NgayCt2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-2 col-form-label">Các tk nợ</label>
                <div class="col-sm-7">
                    <DxTextBox @bind-Text="TkNo" ReadOnly="true" />
                </div>
                <div class="col-sm-3">
                    <DxButton Context="another1" RenderStyle="ButtonRenderStyle.Secondary" Click="@OpenDsTkNo">Ds các tk nợ</DxButton>
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-2 col-form-label">Các cột tk ghi có</label>
                <div class="col-sm-7">
                    <DxTextBox @bind-Text="TkCo" ReadOnly="true" />
                </div>
                <div class="col-sm-3">
                    <DxButton Context="another2" RenderStyle="ButtonRenderStyle.Secondary" Click="@OpenDsTkCo">Ds các cột tk ghi có</DxButton>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-2 col-form-label">Ngày mở sổ</label>
                <div class="col-sm-4">
                    <DxDateEdit @bind-Date="NgayMs" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>

                <label class="col-sm-2 col-form-label text-end">Mã ĐVCS</label>
                <div class="col-sm-4">
                    <DxTextBox @bind-Text="MaDVCS" NullText="" />
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-2 col-form-label">Mẫu báo cáo</label>
                <div class="col-sm-4">
                    <DxComboBox Data="@ReportStyles" TextField="Label" ValueField="Value" @bind-Value="MauBc" />
                </div>
            </div>

            <div class="mt-2">
                @if (Errors.Any())
                {
                    <div class="alert alert-danger p-2">
                        <ul class="mb-0">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="mt-3">
                <!-- Placeholder for GridSearch / ControlDetailFilter3 replacement -->
                @if (ShowGridSearchPlaceholder)
                {
                    <div class="border rounded p-2 text-muted">GridSearch (filter control) placeholder - integrate your browse/filter component here</div>
                }
            </div>
        </div>
    </BodyTemplate>

    <FooterTemplate>
        <div class="d-flex justify-content-end">
            <DxButton Context="another_name3" RenderStyle="ButtonRenderStyle.Success" Text="OK" Click="OnOkClicked" CssClass="me-2" />
            <DxButton Context="another_name4" RenderStyle="ButtonRenderStyle.Danger" Text="Cancel" Click="Close" />
        </div>
    </FooterTemplate>
</DxPopup>

<!-- DsTk simple modal reused for both tk_no and tk_co editing -->
<DxPopup @bind-Visible="DsTkVisible" Width="600px" Height="350px" CloseOnOutsideClick="false" ShowFooter="true" HeaderText="Edit accounts">
    <BodyTemplate>
        <div class="p-3">
            <label>Enter comma separated account prefixes (e.g. 111,112):</label>
            <DxTextBox @bind-Text="DsTkBuffer" TextMode="TextArea" Height="200px" />
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex justify-content-end">
            <DxButton Context="another_name1" RenderStyle="ButtonRenderStyle.Success" Text="OK" Click="ConfirmDsTk" CssClass="me-2" />
            <DxButton Context="another_name2" RenderStyle="ButtonRenderStyle.Danger" Text="Cancel" Click="CancelDsTk" />
        </div>
    </FooterTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<FilterApplyArgs> OnApply { get; set; }

    // Form fields (initial values can be set by parent)
    [Parameter] public DateTime NgayCt1 { get; set; } = DateTime.Now.Date;
    [Parameter] public DateTime NgayCt2 { get; set; } = DateTime.Now.Date;
    [Parameter] public DateTime? NgayMs { get; set; }
    [Parameter] public string TkNo { get; set; } = "";
    [Parameter] public string TkCo { get; set; } = "";
    [Parameter] public string MaDVCS { get; set; } = "";
    [Parameter] public int MauBc { get; set; } = 0;

    // UI state
    private bool DsTkVisible { get; set; } = false;
    private bool EditingTkCo { get; set; } = false;
    private string DsTkBuffer { get; set; } = "";
    private List<string> Errors { get; set; } = new();
    private bool ShowGridSearchPlaceholder { get; set; } = true;

    [Parameter] public string Title { get; set; } = "Lọc sổ nhật mua hàng";

    private List<ReportStyle> ReportStyles { get; } = new()
    {
        new ReportStyle(){ Label = "VND", Value = 0 },
        new ReportStyle(){ Label = "Ngoại tệ", Value = 1 }
    };

    void OpenDsTkNo()
    {
        EditingTkCo = false;
        DsTkBuffer = TkNo;
        DsTkVisible = true;
    }

    void OpenDsTkCo()
    {
        EditingTkCo = true;
        DsTkBuffer = TkCo;
        DsTkVisible = true;
    }

    void ConfirmDsTk()
    {
        if (EditingTkCo)
        {
            TkCo = DsTkBuffer ?? "";
        }
        else
        {
            TkNo = DsTkBuffer ?? "";
        }
        // Persist back to parent via two-way binding if parent uses bind-...
        DsTkVisible = false;
    }

    void CancelDsTk()
    {
        DsTkVisible = false;
    }

    async Task OnOkClicked()
    {
        Errors.Clear();
        if (!Validate()) return;

        // Ensure NgayMs not after NgayCt1
        if (NgayMs.HasValue && NgayMs.Value > NgayCt1)
        {
            NgayMs = NgayCt1;
        }

        var args = new FilterApplyArgs
        {
            NgayCt1 = NgayCt1,
            NgayCt2 = NgayCt2,
            NgayMs = NgayMs,
            TkNo = TkNo,
            TkCo = TkCo,
            MaDVCS = MaDVCS,
            MauBc = MauBc,
            Condition = GetCondition()
        };

        // Close popup and notify parent
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
        if (OnApply.HasDelegate)
            await OnApply.InvokeAsync(args);
    }

    void Close()
    {
        Visible = false;
        VisibleChanged.InvokeAsync(Visible);
    }

    bool Validate()
    {
        if (NgayCt1 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            return false;
        }
        if (NgayCt2 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            return false;
        }
        if (NgayCt1 > NgayCt2)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ! (Từ ngày > Đến ngày)");
            return false;
        }
        if (NgayMs.HasValue && NgayMs.Value != default && NgayMs.Value > NgayCt1)
        {
            Errors.Add("Ngày mở sổ không hợp lệ!");
            return false;
        }
        return true;
    }

    public string GetCondition()
    {
        var sb = new StringBuilder();
        var tkCond = ConditionTk(TkNo, "tk");
        if (!string.IsNullOrEmpty(tkCond)) sb.Append(tkCond);
        if (!string.IsNullOrWhiteSpace(MaDVCS))
        {
            if (sb.Length > 0) sb.Append(" and ");
            sb.Append($"ma_dvcs like '{MaDVCS.Trim()}%'");
        }
        return sb.ToString();
    }

    public string GetCondition2()
    {
        var sb = new StringBuilder();
        var tkCond = ConditionTk(TkNo, "tk_du");
        if (!string.IsNullOrEmpty(tkCond)) sb.Append(tkCond);
        if (!string.IsNullOrWhiteSpace(MaDVCS))
        {
            if (sb.Length > 0) sb.Append(" and ");
            sb.Append($"ma_dvcs like '{MaDVCS.Trim()}%'");
        }
        return sb.ToString();
    }

    private string ConditionTk(string strtk, string typetk)
    {
        if (string.IsNullOrWhiteSpace(strtk)) return "";
        var parts = strtk.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToArray();
        if (parts.Length == 0) return "";
        var sb = new StringBuilder();
        sb.Append(" and (");
        for (int i = 0; i < parts.Length; i++)
        {
            if (i > 0) sb.Append(" or ");
            sb.Append($"{typetk} like '{parts[i]}%'");
        }
        sb.Append(")");
        return sb.ToString();
    }

    void OnNgayCt1Changed(DateTime newValue)
    {
        // Mirror WPF behavior: txtngay_ms.dValue = txtngay_ct1.dValue when NgayCt1 changes
        if (!NgayMs.HasValue || NgayMs.Value == default)
        {
            NgayMs = newValue;
        }
    }

    public class FilterApplyArgs
    {
        public DateTime NgayCt1 { get; set; }
        public DateTime NgayCt2 { get; set; }
        public DateTime? NgayMs { get; set; }
        public string TkNo { get; set; }
        public string TkCo { get; set; }
        public string MaDVCS { get; set; }
        public int MauBc { get; set; }
        public string Condition { get; set; }
    }

    class ReportStyle { public string Label { get; set; } = ""; public int Value { get; set; } }
}