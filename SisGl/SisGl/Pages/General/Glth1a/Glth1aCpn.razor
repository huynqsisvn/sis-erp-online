            Console.WriteLine(ex.Message);
        }
    }

    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(Tu_ngay);
        myStateMN.SetEndDate(Den_ngay);
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;
        if (Tu_ngay == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Den_ngay == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        if (Tu_ngay > Den_ngay)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            ok = false;
        }
        StateHasChanged();
        return ok;
    }
    async Task Loaddata()
    {
        try
        {
            if (curCommand != null)
            {
                sFieldArrays = !(IsLangEn == false)
                    ? (Mau_bc != 0 ? curCommand.Ebrowse2.ToString().Split("|") : curCommand.Ebrowse1.Split("|"))
                    : (Mau_bc != 0 ? curCommand.Vbrowse2.ToString().Split("|") : curCommand.Vbrowse1.Split("|"));
                Fbrowse = sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
            }
            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
            string param_name = "Tk;StartDate;EndDate;Ma_dvcs";
            string param_value = $"{Tk};{Tu_ngay:yyyyMMdd};{Den_ngay:yyyyMMdd};{MaDVCS}";

            string store_glth1 = curCommand.Store_proc?.Split('|')[0] ?? "";
            var ds1 = await myDb.LoadStoreProcedure(store_glth1, param_name, param_value);

            string store_sodu = curCommand.Store_proc?.Split('|')[1] ?? "";
            var ds2 = await myDb.LoadStoreProcedure(store_sodu, param_name, param_value);

            dsGlcd = new DataSet();

            if (ds1 != null && ds1.Tables.Count > 0)
            {
                var t1 = ds1.Tables[0].Copy();
                var t2 = ds1.Tables[1].Copy();
                t1.TableName = "GLTH1_Main";
                t2.TableName = "GLTH1_Main2";
                dsGlcd.Tables.Add(t1);
                dsGlcd.Tables.Add(t2);
                TblData = t1; 
                TblData2 = t2;
            }
            else
            {
                TblData = new DataTable();
                TblData2 = new DataTable();
            }

            if (ds2 != null && ds2.Tables.Count > 0)
            {
                var t3 = ds2.Tables[0].Copy();
                var t4 = ds2.Tables[1].Copy();
                t3.TableName = "GLTH1_SoDu";
                t4.TableName = "GLTH1_SoDu2";
                dsGlcd.Tables.Add(t3);
                dsGlcd.Tables.Add(t4);
                TblDataSoDu = t3;
                TblDataSoDu2 = t4;
            }
            else
            {
                TblDataSoDu = new DataTable();
                TblDataSoDu2 = new DataTable();
            }

            // TÍNH TỔNG PHÁT SINH TRONG KỲ – CHÍNH LÀ 4 GIÁ TRỊ BẠN MUỐN IN BÁO CÁO
            if (TblData != null && TblData.Rows.Count > 0)
            {
                TongPsNo = TblData.Compute("SUM(ps_no)", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute("SUM(ps_no)", ""));
                TongPsCo = TblData.Compute("SUM(ps_co)", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute("SUM(ps_co)", ""));
                TongPsNoNt = TblData.Compute("SUM(ps_no_nt)", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute("SUM(ps_no_nt)", ""));
                TongPsCoNt = TblData.Compute("SUM(ps_co_nt)", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute("SUM(ps_co_nt)", ""));
            }
            else
            {
                TongPsNo = TongPsCo = TongPsNoNt = TongPsCoNt = 0m;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }


