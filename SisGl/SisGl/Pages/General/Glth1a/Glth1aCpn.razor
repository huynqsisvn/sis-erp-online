    private async Task oBrowse_F5()
    {
        try
        {
            DataRowView selectedObj = !IsDetailSum ? CurItem as DataRowView : CurItemCT as DataRowView;
            if (selectedObj == null)
            {
                myStateMN.SetNewThongbao(Lap["Please select a row to view detail"] + " !");
                return;
            }
            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
            string store_detail = curCommand.Store_proc?.Split('|')[2] ?? "";
            DataSet dsDetail = null;

            if (!IsDetailSum)
            {
                Tk_du = selectedObj["tk_du"].ToString().Trim();
                string param_name = "Tk;Tk_du;StartDate;EndDate;Ma_dvcs";
                string param_value = $"{Tk};{Tk_du};{Tu_ngay:yyyyMMdd};{Den_ngay:yyyyMMdd};{MaDVCS}";
                dsDetail = await myDb.LoadStoreProcedure(store_detail, param_name, param_value);
            }
            else
            {
                Tk = selectedObj["tk"].ToString().Trim();
                string param_name = "Tk;StartDate;EndDate;Ma_dvcs";
                string param_value = $"{Tk};{Tu_ngay:yyyyMMdd};{Den_ngay:yyyyMMdd};{MaDVCS}";
                dsDetail = await myDb.LoadStoreProcedure(store_detail, param_name, param_value);
            }

            TblDataCT = dsDetail != null && dsDetail.Tables.Count > 0 ? dsDetail.Tables[0].Copy() : new DataTable();
            FbrowseCT = sFieldArrays.Length > 1 ? sFieldArrays[1] : "";

            IsDetail = true;
            IsDetailSum = !IsDetailSum ? false : true;
            IsDetailSumCT = !IsDetailSum ? false : true;

            StateHasChanged();
            if (oBrowseCT != null)
            {

                await Task.Delay(50);
                await oBrowseCT.FocusGridAsync();
            }

            ShowDetailToolBar();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            myStateMN.SetNewThongbao("Error loading detail: " + ex.Message);
        }
    }


    public override async void ExportData(int type)
    {
        if (IsDetail)
        {
            oBrowseCT.ExPortGrid(type);
        }
        else
        {
            oBrowse.ExPortGrid(type);
        }

        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
