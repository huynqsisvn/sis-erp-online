        string MaDVCS = myStateMN.GetDvcs().Ma_dvcs;
        MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
        if (!string.IsNullOrEmpty(MaDVCS))
            cond = (string.IsNullOrEmpty(cond) ? "" : cond + " and ") + $"ma_dvcs like '{MaDVCS.Trim()}%'";
        return cond;
    }

    private string ConditionTk(string strtk, string typetk)
    {
        if (string.IsNullOrWhiteSpace(strtk)) return "";
        var parts = strtk.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToArray();
        if (parts.Length == 0) return "";
        var sb = new System.Text.StringBuilder();
        sb.Append(" and (");
        for (int i = 0; i < parts.Length; i++)
        {
            if (i > 0) sb.Append(" or ");
            sb.Append($"{typetk} like '{parts[i]}%'");
        }
        sb.Append(")");
        return sb.ToString();
    }

