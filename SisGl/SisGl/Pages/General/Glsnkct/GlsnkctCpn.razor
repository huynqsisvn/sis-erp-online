    public string GetCondition()
    {
        string cond = "";

        if (!string.IsNullOrWhiteSpace(TkTien))
        {
            var listTk = TkTien
                .Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrEmpty(x))
                .ToList();

            if (listTk.Count > 0)
            {
                var listCond = listTk.Select(x => $"tk like ''{x}%''");

                cond = "AND (" + string.Join(" or ", listCond) + ")";
            }
        }

        return cond;
    }
