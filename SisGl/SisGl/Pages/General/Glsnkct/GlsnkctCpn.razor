    private string GetTableShow(int mau_bc)
    {
        string str = string.Empty;
        switch (IsLangEn)
        {
            case false:
                switch (mau_bc)
                {
                    case 0:
                        str = string.Format(curCommand.Vbrowse1.ToString().Replace("{0}:0", "{0}"), (object)GetStringBrowseTks_du().Rows[0]["vbrowse1"].ToString());
                        break;
                    case 1:
                        str = string.Format(curCommand.Vbrowse2.ToString().Replace("{0}:0", "{0}"), (object)GetStringBrowseTks_du().Rows[0]["vbrowse2"].ToString());
                        break;
                }
                break;
            default:
                switch (mau_bc)
                {
                    case 0:
                        str = string.Format(curCommand.Ebrowse1.ToString().Replace("{0}:0", "{0}"), (object)GetStringBrowseTks_du().Rows[0]["vbrowse1"].ToString());
                        break;
                    case 1:
                        str = string.Format(curCommand.Ebrowse2.ToString().Replace("{0}:0", "{0}"), (object)GetStringBrowseTks_du().Rows[0]["vbrowse2"].ToString());
                        break;
                }
                break;
        }
        return str;
    }
    private DataTable GetStringBrowseTks_du()
    {
        DataTable dataTable = new DataTable();
        DataColumn column1 = new DataColumn("vbrowse1");
        DataColumn column2 = new DataColumn("vbrowse2");
        string str1 = "";
        string str2 = "";
        string str3 = ":130:h=:N0:S";
        string str4 = ":130:h=:N1:S";

        try
        {
            // choose source table based on Ma_nkc
            string table = (Ma_nkc == "NKT") ? "dmtkdusnkc" : "dmtkdusnkt";
            DataSet ds = myDb.LoadDataSet($"select * from {table}");
            DataTable dt = (ds != null && ds.Tables.Count > 0) ? ds.Tables[0] : null;

            if (dt != null && dt.Rows.Count > 0)
            {
                bool isVn = !IsLangEn;
                string colName = columnName ?? "col";

                // first item
                str1 = colName + "1" + str3.Replace("h=", "h=" + (isVn ? "Ghi có tk " : "Credit account ") + dt.Rows[0]["ten_in"].ToString().Trim());
                str2 = colName + "1_nt" + str4.Replace("h=", "h=" + (isVn ? "Ghi có n.tệ tk " : "FC credit account ") + dt.Rows[0]["ten_in"].ToString().Trim());

                // remaining items
                for (int index = 1; index < dt.Rows.Count; ++index)
                {
                    int num = index + 1;
                    string tenIn = dt.Rows[index]["ten_in"].ToString().Trim();

                    str1 += ";" + colName + num.ToString() + str3.Replace("h=", "h=" + (isVn ? "Ghi có tk " : "Credit account ") + tenIn);
                    str2 += ";" + colName + num.ToString() + "_nt" + str4.Replace("h=", "h=" + (isVn ? "Ghi có n.tệ tk " : "FC credit account ") + tenIn);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        column1.DefaultValue = (object)str1;
        column2.DefaultValue = (object)str2;
        dataTable.Columns.Add(column1);
        dataTable.Columns.Add(column2);
        DataRow row = dataTable.NewRow();
        dataTable.Rows.Add(row);
        return dataTable;
    }
    
    async Task Loaddata()
    {
        try
        {
            string parram_name = "ngay_ct1;ngay_ct2;condition;ma_dvcs;amount_debit";
            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;

            Condition = GetCondition();


            // 🔹 Gọi store
            string strsql = $"exec {Store_proc} '{(Ngay_ct1 != null ? Ngay_ct1.ToString("yyyyMMdd") : "")}'," +
                            $"'{(Ngay_ct2 != null ? Ngay_ct2.ToString("yyyyMMdd") : "")}'," +
                            $"'{Condition}','{MaDVCS}','ps_co'";

            DataSet ds = await myDb.LoadDataset(strsql);

            if (ds != null && ds.Tables.Count > 0)
            {
                TblData = ds.Tables[0].Copy();

                if (!TblData.Columns.Contains("stt1"))
                    TblData.Columns.Add("stt1", typeof(int));

                int num = 1;
                foreach (DataRow row in TblData.Rows)
                {
                    if (TblData.Columns.Contains("ngay") && row["ngay"] != DBNull.Value)
                        row["stt1"] = num++;
                    else
                        row["stt1"] = DBNull.Value; // hoặc để trống nếu cần
                }
            }
            else
            {
                TblData = new DataTable();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }



    public override void Print()
    {
        LsData = new List<GlsnkctModel>();
        GlsnkctModel model = GetStringRptTks_du();
        string modelstr = SisFunc.Converts.DataTable2Model(TblData, "Glsnkct");
        if (TblData != null)
        {
            List<Glsnkct> listObj = myDb.ConvertDataTable<Glsnkct>(TblData);
            model.LsData = listObj;
        }
        string MaDVCS = myStateMN.GetDvcs().Ma_dvcs;
        MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
        model.Ngay_ct1 = Ngay_ct1;
        model.Ngay_ct2 = Ngay_ct2;
        model.Condition = Condition;
        model.MaDVCS = MaDVCS;
        model.Mau_bc = Mau_bc;
        model.ngay_ms = NgayMs.HasValue ? NgayMs.Value.ToString("dd-MM-yyyy") : string.Empty;
        LsData.Add(model);

        ShowPrint = true;
    }
    private GlsnkctModel GetStringRptTks_du()
    {
        GlsnkctModel model = new GlsnkctModel();
        try
        {
            string table = (Ma_nkc == "NKT") ? "dmtkdusnkt" : "dmtkdusnkc";
            DataSet ds = myDb.LoadDataSet($"select * from {table}");
            DataTable dt = (ds != null && ds.Tables.Count > 0) ? ds.Tables[0] : null;

            if (dt != null && dt.Rows.Count > 0)
            {
                model.col_header1 = dt.Select("stt=1").Count() > 0 ? dt.Select("stt=1").First()["ten_in"].ToString().Trim() : "";
                model.col_header2 = dt.Select("stt=2").Count() > 0 ? dt.Select("stt=2").First()["ten_in"].ToString().Trim() : "";
                model.col_header3 = dt.Select("stt=3").Count() > 0 ? dt.Select("stt=3").First()["ten_in"].ToString().Trim() : "";
                model.col_header4 = dt.Select("stt=4").Count() > 0 ? dt.Select("stt=4").First()["ten_in"].ToString().Trim() : "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        return model;
    }
