    private bool CheckValid()
    {
        Errors.Clear();
        bool flag = true;
        if (flag && Ngay_ct1 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            flag = false;
        }
        if (flag && Ngay_ct2 == default)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            flag = false;
        }
        if (flag && Ngay_ct1 > Ngay_ct2)
        {
            Errors.Add("Ngày lọc chứng từ không hợp lệ!");
            flag = false;
        }
        if (flag && NgayMs.HasValue && NgayMs != default && NgayMs.Value > Ngay_ct1)
        {
            Errors.Add("Ngày mở sổ không hợp lệ!");
            flag = false;
        }
        StateHasChanged();
        return flag;
    }

