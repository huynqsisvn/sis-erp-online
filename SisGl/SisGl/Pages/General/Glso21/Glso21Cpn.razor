@page "/glso21"
@page "/glso21/{menu_id}"
@inject IDbManager myDb
@inject NavigationManager navigation
@inject Statemanagerment myStatemanagerment
@inject ILocalStorageService Localstore
@inject ICommandManager Commands
@implements IDisposable
@inject IJSRuntime JavacriptS
@inject IOptionsManager options
@inherits RepoBaseComponent

@attribute [Authorize(Roles = "admin,glso21")]


@if (!IsDetail)
{
    if (Ma_nt == "VND")
    {
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblDataCT" SelectItem="@SelectedItem" Fbrowse="@FbrowseCT" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    }
    else
    {
        <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@FbrowsePH" IsLangEn="@IsLangEn" />
    }
}   
else
{
    <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@FbrowsePH" IsLangEn="@IsLangEn"></FrmBrowseComponent>
}


<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="500px"
         ShowFooter="true" Context="windowContext"
         HeaderText="@Lap["Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 5rem; height:5rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container pt-1">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idTu_Ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                        <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    InputId="idDen_ngay" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Merge by account"]">
                        <DxComboBox Data="@StatusList"
                                    @bind-Value="@LoaiBC"
                                    ValueField="Value"
                                    TextField="Text"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="1- Có gộp" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report template"]">
                        <DxComboBox Data="@StatusList1"
                                    @bind-Value="@Ma_nt"
                                    ValueField="Value"
                                    TextField="Text"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="1- Có gộp" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Remove documents from the transfer journal"]">
                        <DxCheckBox @bind-Checked="@Bo_nkcdChecked" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row justify-content-end align-content-end m-2">
                <DxButton CssClass="col mx-4" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@BtnSave" />
                <DxButton CssClass="col" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@if (ShowPrint)
{
    <DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup"
             @bind-Visible="@ShowPrint"
             Width="80%" Height="90%"
             ShowFooter="false"
             HeaderText="@Lap["Printer"]">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData" Menu_id="@Menu_id.Replace('_','.')" OnBack="()=>{ShowPrint=false;}" />
        </BodyTemplate>
    </DxPopup>
}

<style>
    .gridph-frm-height {
        height: 45vh;
    }
    .gridct-frm-height {
        height: 45vh;
    }
</style>

@code {
    public FrmBrowseComponent oBrowse;
    public FrmBrowseComponent oBrowseCT;
    public bool IsDetail { get; set; } = false;
    public List<Glso21> LstData;
    public List<Glso21Model> LsData;
    public DataTable TblData;
    public DataTable TblDataCT;
    string _store_proc = "";
    private string Ma_nt = "VND";
    private string LoaiBC = "1";
    private bool Bo_nkcdChecked = false;
    private string Ma_dvcs = "CTY";
    public string FbrowsePH = "stt:45:h=Stt:F=0:N0:FL;ngay_ct:80:h=Ngày ghi sổ:FL:D;so_ct:85:h=Số c.từ:FL:HR:LINKCT;ngay_lct:80:h=Ngày c.từ:FL:D:HR;ma_kh:100:h=Mã khách:LINKDM;ten_kh:250:h=Tên khách;dien_giai:250:h=Diễn giải;tk:80:h=Tk:LINKDMDMTK;ps_no_nt:130:h=Ps nợ n.tệ:N0:I0;ps_co_nt:130:h=Ps có n.tệ:N0:I0;ma_nt:130:h=Mã n.tệ:N0:I0;ty_gia:130:h=Tỷ giá:N:IV;ps_no:130:h=Ps nợ:N0:Q:S:I0;ps_co:130:h=Ps có:N0:Q:S:I0;ma_vv:100:h=Mã dự án:LINKDM;ten_tk:250:h=Tên tk;ma_qs:100:h=Quyển c.từ:LINKDMDMQS;ma_ct:80:h=Mã c.từ:LINKDMDMCT;ma_dvcs:100:h=Mã ĐVCS";
    public string FbrowseCT = "stt:45:h=Stt:F=0:N0:FL;ngay_ct:80:h=Ngày ghi sổ:FL:D;so_ct:85:h=Số c.từ:FL:HR:LINKCT;ngay_lct:80:h=Ngày c.từ:FL:D:HR;ma_kh:100:h=Mã khách:LINKDM;ten_kh:250:h=Tên khách;dien_giai:250:h=Diễn giải;tk:80:h=Tk:LINKDMDMTK;ps_no:130:h=Ps nợ:N0:Q:S:I0;ps_co:130:h=Ps có:N0:Q:S:I0;ma_vv:100:h=Mã dự án:LINKDM;ten_tk:250:h=Tên tk;ma_qs:100:h=Quyển c.từ:LINKDMDMQS;ma_ct:80:h=Mã c.từ:LINKDMDMCT;ma_dvcs:100:h=Mã ĐVCS";
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
    private List<object> StatusList = new()
    {
        new { Value = "0", Text = "0- Không gộp" },
        new { Value = "1", Text = "1- Có gộp" },

    };
    private List<object> StatusList1 = new()
    {
        new { Value = "VND", Text = "Mẫu VND" },
        new { Value = "NT", Text = "Ngoại Tệ" },

    };
    
    public override async Task ShowToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Search", true));
        myStateMN.SetToolBar(new MyToolbar("Print", true));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }

    public async Task ShowDetailToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Quit", true));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }

    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {

            case ActionTask.Quit:
                IsDetail = false;
                ShowToolBar();
                StateHasChanged();
                break;
        }
        base.OnActionTaskchanged(ac);
    }


    public override async void ExportData(int type)
    {
        if (IsDetail)
        {
            oBrowse.ExPortGrid(type);
        }
        else
        {
            oBrowseCT.ExPortGrid(type);
        }
        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }

    #region "Tim kiem"
    private async void BtnSave()
    {
        ShowLoadding = true;
        myStateMN.SetStartDate((DateTime)Ngay_ct1);
        myStateMN.SetEndDate((DateTime)Ngay_ct2);

        await Loaddata();

        ShowLoadding = false;
        PopupVisible = false;
        InvokeAsync(StateHasChanged);
    }

    private void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wg_gb_01";
        curCommand = await Commands.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        Ngay_ct1 = myStatemanagerment.GetStartDate();
        Ngay_ct2 = myStatemanagerment.GetEndDate();

        if (curCommand != null)
        {
            _store_proc = curCommand.Store_proc.Split('|')[0];
            FbrowseCT = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
        }

    }
    private string UserLang { get; set; } = "";
    private bool IsLangEn = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            Ma_dvcs = myStateMN.GetMa_Dvcs(); Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            await Loaddata();
            StateHasChanged();
        }
        else
        {
            if (IsDetail)
            {
                await oBrowse.FocusGridAsync();
            }
            else
            {
                await oBrowseCT.FocusGridAsync();
            }
        }
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
        {
            await Language();
        }
    }
    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await Localstore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang))
            {
                if (UserLang.Equals("En"))
                {
                    IsLangEn = true;
                }
            }
            if (curCommand != null)
            {
                FbrowseCT = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    async void OnDvcsChanged(string ma_dvcs)
    {
        Ma_dvcs = ma_dvcs;
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
        await Loaddata();
        StateHasChanged();
    }
    public override async Task Loaddata()
    {
        if (Ngay_ct1 == null || Ngay_ct2 == null || Ngay_ct1 > Ngay_ct2)
        {
            myStateMN.SetNewThongbao(Lap["Incorrect date declaration"] + " !");
            return;
        }

        ShowLoadding = true;
        string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
        MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS;
        string parram_name = "StartDate;EndDate;LoaiBC;bo_nkcd;ma_dvcs";
        string parram_value =
            (Ngay_ct1.ToString("yyyyMMdd") ?? "") + ";" +
            (Ngay_ct2.ToString("yyyyMMdd") ?? "") + ";" +
            (LoaiBC ?? "1") + ";" +                    // Lấy giá trị chọn từ ComboBox
            (Bo_nkcdChecked ? "1;" : "0;") +           // Checkbox
            (MaDVCS ?? "CTY");


        DataSet ds = await myDb.LoadStoreProcedure("GLSO2", parram_name, parram_value);

        if (ds?.Tables?.Count > 0)
        {
            TblDataCT = ds.Tables[0].Copy();
            TblData = ds.Tables[0].Copy(); // thêm dòng này để bảng chính cũng có dữ liệu
        }

        else
        {
            myStateMN.SetNewThongbao(Lap["No data available"] + " !");
            TblDataCT = new DataTable();
        }

        ShowLoadding = false;
        StateHasChanged();
    }



    public override void Print()
    {
        LsData = new List<Glso21Model>();
        Glso21Model Data = new Glso21Model();
        Data.Startdate = (DateTime)Ngay_ct1;
        Data.Enddate = (DateTime)Ngay_ct2;
        LstData = myDb.ConvertDataTable<Glso21>(TblData);
        Data.LsData = LstData;
        LsData.Add(Data);
        ShowReport(LsData, typeof(Glso21Model));
    }
    #endregion
} 
