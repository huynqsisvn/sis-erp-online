@page "/frmdmtd"
@page "/frmdmtd/{menu_id}"
@page "/frmdmtd/{menu_id}/{ma_td}"
@inject Statemanagerment myStatemanagerment
@inject NavigationManager navigation
@inject IDbManager myDb
@inject IJSRuntime JavacriptS
@inject IStringLocalizer<SisGl.Pages.App> Lap
@inject IStringLocalizer<DmtdComponent> Lat

<DxPopup @bind-Visible="@PopVisible"
         ShowFooter="false"
         ShowHeader="false"
         CloseOnEscape="false"
         CloseOnOutsideClick="false"
         ShowCloseButton="false"
         Width="auto"
         MinWidth="650px"
         MinHeight="200px"
         MaxHeight="98vh"
         AllowResize="true"
         AllowDrag="true"
         AllowDragByHeaderOnly="true">
    <BodyTemplate>
        <div class="row">
            <EditDmtd Ma_ma="@ma_td"
                      Menu_id="@menu_id"
                      curActionTask="@curActionTask"
                      ShowAdd="@ShowAdd"
                      OnClose="ClickHandler" />
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string menu_id { get; set; }
    [Parameter] public string ma_td { get; set; }
    [Parameter] public ActionTask curActionTask { get; set; } = ActionTask.None;
    [Parameter] public bool ShowAdd { get; set; }

    public bool PopVisible { get; set; } = true;
    private string Pagetitle = "Danh m?c t? do";

    protected override void OnInitialized()
    {
        if (curActionTask == ActionTask.None)
        {
            curActionTask = myStatemanagerment.GetCurrentActionTask();
        }

        switch (curActionTask)
        {
            case ActionTask.View:
                Pagetitle = Lat["Xem thông tin danh m?c t? do"];
                break;
            case ActionTask.Edit:
                Pagetitle = Lat["S?a thông tin danh m?c t? do"];
                break;
            case ActionTask.New:
                Pagetitle = Lat["Thêm danh m?c t? do m?i"];
                break;
            default:
                Pagetitle = Lat["Xem thông tin danh m?c t? do"];
                break;
        }
    }

    private void ClickHandler()
    {
        PopVisible = false;
        OnClose.InvokeAsync();
    }
}
