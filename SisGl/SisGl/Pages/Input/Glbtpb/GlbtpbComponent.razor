@page "/glbtpb"
@page "/glbtpb/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,glbtpb")]
@if (!ShowLoading)
{
    <div class="row my-1 py-1">
        <div class="col-auto d-flex align-items-center">
            <label class="me-2 fw-bold">@Lap["Year"]</label>
            <DxComboBox Data="@Years" @bind-Value="@Year" CssClass="p-0 m-0"></DxComboBox>
        </div>
        <div class="col-auto d-flex align-items-center">
            <label class="me-2">@Lap["From month"]</label>
            <DxComboBox Data="@Months" @bind-Value="@Month1" CssClass="p-0 m-0"></DxComboBox>
        </div>
        <div class="col-auto d-flex align-items-center">
            <label class="me-2">@Lap["To month"]</label>
            <DxComboBox Data="@Months" @bind-Value="@Month2" CssClass="p-0 m-0"></DxComboBox>
        </div>
        <div class="col-auto d-flex align-items-center">
            <label class="me-2">@Lap["Copy from the previous period"]</label>
            <DxCheckBox @bind-Checked="@IsCopy" CssClass="p-0 m-0"></DxCheckBox>
        </div> 
    </div>

    <div class="row mt-1">   
        <FrmBrowse3Component @ref="oBrowsePH"
                            TblData="@TblPH"
                            Page_size="@PageSize"
                            IsPageSize="true"
                            CssClass="grid-frm-height"
                            Fbrowse="@FbrowsePH"
                            SelectItem="CurItem"
                            SelectCol="tag"
                            IsLangEn="@IsLangEn">
        </FrmBrowse3Component>

    </div>
    <hr style="height:1px;background-color:dimgrey;margin:1px;padding:0px;">
    <div class="row my-1 mx-0 p-0">
    <h8 class="fw-bold bg-light text-warning rounded-pill mb-1">@Lap["Detail"]</h8>
    <FrmBrowseComponent @ref="oBrowseCT" TblData="@TblCT" CssClass="grid-frmct-height" Fbrowse="@FbrowseCT" IsLangEn="@IsLangEn"></FrmBrowseComponent>
</div>
}
else
{
    <DxLoadingPanel IndicatorAnimationType="WaitIndicatorAnimationType.Pulse"
                CssClass="w-100"
                IndicatorVisible="@ShowLoading"
                IndicatorAreaVisible="@ShowLoading"
                Visible="@ShowLoading"
                Text="@Lap["Processing..."]"
                TextAlignment="LoadingPanelTextAlignment.Right">
        <div style="min-height: 250px;"></div>
    </DxLoadingPanel>
}
@if (IsShowFrm && FrmType != null)
{
    <DxPopup @bind-Visible="@IsShowFrm" ShowCloseButton="false" CloseOnOutsideClick="false"
              Width="60vw"
              MinWidth="700px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxPopup>
}

<style>
    .grid-frm-height {
        height: 45vh;
    }

    .grid-frmct-height {
        height: 35vh;
    }

    .tb-icon-btntoolbar1 {
        width: 24px;
        height: 24px;
        background-image: url('.\\Images\\Icon_them_moi.svg');
    }

    .tb-icon-btntoolbar2 {
        width: 24px;
        height: 24px;
        background-image: url('.\\Images\\Icon_xoa.svg');
    }

    .tb-icon-btntoolbar3 {
        width: 24px;
        height: 24px;
        background-image: url('.\\Images\\Icon_print.svg');
    }
</style>

@code {
    FrmBrowseComponent oBrowseCT; FrmBrowse3Component oBrowsePH;
    public List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 20, 30).OrderByDescending(y => y).ToList();
    public List<int> Months { get; set; } = Enumerable.Range(1, 12).ToList();    
    public int _month1 { get; set; } = DateTime.Now.Month;
    public int _month2 { get; set; } = DateTime.Now.Month;
    private int _year = DateTime.Now.Year;
    public string Ma_ct { get; set; } = "PK4";
    public Dmct curDmct = new Dmct();
    public string Ma_dvcs { get; set; } = "";

    public DataTable TblPH { get; set; }
    public DataTable TblCT { get; set; }
    public int PageSize { get; set; } = 20;    
    public List<object> SelectedMasterRows { get; set; } = new();

    public string FbrowsePH { get; set; }
    public string FbrowseCT { get; set; }
    public string[] Procedures;
    public bool _iscopy = false;

    public bool ShowLoading { get; set; } = false;

    public int Year
    {
        get => _year;
        set
        {
            if (_year == value) return;
            _year = value;
            _ = OnYearChangedAsync();
        }
    }
    public int Month1
    {
        get => _month1;
        set
        {
            if (_month1 == value) return;
            _month1 = value;
            _ = OnYearChangedAsync();
        }
    }
    public int Month2
    {
        get => _month2;
        set
        {
            if (_month2 == value) return;
            _month2 = value;
            _ = OnYearChangedAsync();
        }
    }
    public bool IsCopy
    {
        get => _iscopy;
        set
        {
            if (_iscopy == value) return;
            _iscopy = value;
            _ = OnYearChangedAsync();
        }
    }

    public override void CurItem(object obj)
    {
        if (obj != null)
        {
            SelectedItem = obj;
            DataRowView rview = (DataRowView)SelectedItem;
            SqlTableKeyValue = rview[SqlTableKey].ToString().Trim();
            if (TblCT != null)
                TblCT.DefaultView.RowFilter = SqlTableKey + "='" + rview[SqlTableKey].ToString() + "'";
        }
        else
        {
            if (TblCT != null) TblCT.DefaultView.RowFilter = SqlTableKey + "=''";            
        }
    }
    protected override async Task OnInitializedAsync()
    {
        mPage = "glbtpb";
        SqlTableKey = "Stt_rec";
        IsShowCopy = true;
        IsShowImport = false;
        FrmType = typeof(Input.Glbtpb.EditGlbtpb);
        Ma_dvcs = myStateMN.GetDvcs().Ma_dvcs.Trim();
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            Ma_ct = String.IsNullOrEmpty(curCommand.Parameter) ? curCommand.Ma_ct.Trim() : curCommand.Parameter.Trim();
            Procedures = curCommand.Store_proc.ToString().Split('|');

            SqlTableKey = "stt_rec";
            UpdateBrowseStrings();            
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, UserLang.Trim()));
            string Menuid = Menu_id.Replace("_", ".");
            if (curUser.Is_admin == 1 || curUser.CheckRight(Menuid, "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New", true));
                myStateMN.SetToolBar(new MyToolbar("Edit", true));
                myStateMN.SetToolBar(new MyToolbar("Save", false));
                myStateMN.SetToolBar(new MyToolbar("Delete", true));
                myStateMN.SetToolBar(new MyToolbar("View", true));
                myStateMN.AddOrderToolBarButton("Button1", Lap["Excute"] + " " + Lap["allocation"], 8);
                myStateMN.AddOrderToolBarButton("Button2", Lap["Delete"] + " " + Lap["allocation"], 9);
                myStateMN.AddOrderToolBarButton("Button3", Lap["Print"], 10);
                myStateMN.SetToolBar(new MyToolbar("Aproval", false));
                myStateMN.SetToolBar(new MyToolbar("Print", false));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Search", false));
                myStateMN.SetToolBar(new MyToolbar("Quit", false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            await LoadDataAsync();
            await Language();
        }
    }
    public override void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Button1:
                myStateMN.SetCurrentActionTask(ActionTask.Button1);
                btnTaobt_Click();
                break;           
            case ActionTask.Button2:
                myStateMN.SetCurrentActionTask(ActionTask.Button2);
                btnXoabt_Click();
                break;
            case ActionTask.Button3:
                myStateMN.SetCurrentActionTask(ActionTask.Button3);
                btnInbt_Click();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
            default:
                base.OnActionTaskchanged(ac);
                break;
        }
    }
    private async Task LoadDataAsync()
    {
        ShowLoading = true;
        StateHasChanged();
        string userId = curUser == null ? "" : curUser.User_id.ToString();
        DataSet ds = await myDb.LoadDataset($"EXEC {Procedures[0]} @Ky = {Month1},@Ky2 = {Month2},@Nam = {Year},@Ma_dvcs = '{Ma_dvcs}',@IsCopy = {(IsCopy?1:0)},@User_id={userId}");
        TblPH = ds.Tables.Count > 0 ? ds.Tables[0] : null;
        TblCT = ds.Tables.Count > 1 ? ds.Tables[1] : null;

        if (TblPH != null && TblPH.Rows.Count > 0)
        {
            SelectedItem = TblPH.DefaultView[0];            
        }
        else
        {
            TblCT = null;
        }
        if (TblCT != null)
        {
            TblCT.DefaultView.Sort = "stt asc";
            if (TblPH.DefaultView.Count > 0)
                TblCT.DefaultView.RowFilter = "stt_rec='" + TblPH.DefaultView[0]["stt_rec"].ToString().Trim() + "'";
        }

        ShowLoading = false;
        StateHasChanged();
    }   

    private async void OnMasterRowDbClick(object item)
    {

    }
    private async void OnPHRowClick(GridRowClickEventArgs e)
    {
        string edb = e.Column.Name;
    }

    private void UpdateBrowseStrings()
    {
        string[] browseArr = IsLangEn
            ? curCommand.Ebrowse1.Split('|')
            : curCommand.Vbrowse1.Split('|');

        FbrowsePH = browseArr.Length > 0 ? browseArr[0] : "";
        FbrowseCT = browseArr.Length > 1 ? browseArr[1] : "";
    }      

    private async void DeleteVoucherAsync()
    {
        DataRow[] rows = TblPH.Select("tag='true'");
        if (rows == null || rows.Length == 0)
        {
            myStateMN.SetNewThongbao(Lap["No entries selected for deletion"]);
            return;
        }

        var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
            {
                Text = Lap["Are you sure you want to delete?"],
                Title = Lap["Confirm"],
                OkButtonText = Lap["OK"],
                CancelButtonText = Lap["Cancel"],
                ShowIcon = true,
                RenderStyle = MessageBoxRenderStyle.Danger
            });

        if (!confirm)
            return;

        var selectedList = rows
            .OfType<DataRow>()
            .Select(r => r["stt_kc"].ToString())
            .ToList();

        string numList = string.Join(",", selectedList);

        ShowLoading = true;
        StateHasChanged();

        var startPeriod = SisLib.Ctrl.NgayTC.StartOfPeriod(mySysvar,Year,Month1);
        if (!SisLib.Ctrl.NgayTC.CheckValidNgayKs(mySysvar, myDb, startPeriod, Ma_ct))
        {
            myStateMN.SetNewThongbao(Lap["Data is locked, cannot delete"]);
            ShowLoading = false;
            StateHasChanged();
            return;
        }

        await myDb.LoadDataset("dbo.Glctkc", new Dictionary<string, object>
            {
                ["@Year"] = Year,
                ["@Period1"] = Month1,
                ["@Period2"] = Month2,
                ["@NumList"] = numList,
                ["@Ma_qs"] = GetMaQS(SelectedMasterRows.FirstOrDefault()),
                ["@Ma_dvcs"] = Ma_dvcs,
                ["@Type"] = "DEL"
            });

        await LoadDataAsync();
        myStateMN.SetNewThongbao(Lap["Operation completed"] + " !");
        ShowLoading = false;
        StateHasChanged();
    }

    public override async void ExportData(int type)
    {
        oBrowsePH.ExPortGrid(type);
        string ToastMessage = Lap["Export successfully"];
        myStateMN.SetNewThongbao(ToastMessage);
        StateHasChanged();
    }
    private string GetMaQS(object row)
    {
        if (row is DataRowView drv && drv.DataView.Table.Columns.Contains("ma_qs"))
            return drv["ma_qs"].ToString();
        return "";
    }
    private async Task OnYearChangedAsync()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private async void btnTaobt_Click()
    {
        DateTime Ngay_ct1 = SisLib.Ctrl.NgayTC.StartOfPeriod(mySysvar,Year, Month1);
        if (Ngay_ct1 < Convert.ToDateTime(mySysvar.GetSysVar("M_NGAY_DONG_SO")))
        {
            myStateMN.SetNewThongbao(Lap["Data is locked, cannot be edited!"]);
        }
        else
        {
            DataRowView[] array = (TblPH.DefaultView).Cast<DataRowView>().Where<DataRowView>((Func<DataRowView, bool>)(x => (bool)x["tag"])).ToArray<DataRowView>();
            if (array.Length == 0)
            {
                myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            }
            else
            {
                if (((IEnumerable<DataRowView>)array).Any<DataRowView>((Func<DataRowView, bool>)(x => x["stt_pb"].ToString().Trim() != "")))
                {
                    var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
                    {
                        Text = Lap["Entry had to delete and recreate"] + " ?",
                        Title = Lap["Confirm deletion"],
                        OkButtonText = Lap["Yes"],
                        CancelButtonText = Lap["No"],
                        ShowIcon = true,
                        RenderStyle = MessageBoxRenderStyle.Warning
                    });
                    if (!confirm)
                    {
                        return;
                    }                    
                }
                foreach (DataRowView dataRowView in array)
                    await Tinh_Taobt(dataRowView);
                await LoadDataAsync();
                myStateMN.SetNewThongbao(Lap["Operation completed"] + " !");
                StateHasChanged();
            }
        }
    }
    private async Task Tinh_Taobt(DataRowView item)
    {
        string str = item["stt_rec"].ToString();
        await myDb.LoadDataset(Procedures[1], new Dictionary<string, object>
        {
            ["@stt_rec"] = (object)str,
            ["@User_id"] = (object)myStateMN.GetCurUser().User_id
        });
    }
    private async void btnXoabt_Click()
    {
        DateTime Ngay_ct1 = SisLib.Ctrl.NgayTC.StartOfPeriod(mySysvar, Year, Month1);
        if (Ngay_ct1 < Convert.ToDateTime(mySysvar.GetSysVar("M_NGAY_DONG_SO")))
        {
            myStateMN.SetNewThongbao(Lap["Data is locked, cannot be edited!"]);
            return;
        }
        else
        {
            DataRowView[] array = (TblPH.DefaultView).Cast<DataRowView>().Where<DataRowView>((Func<DataRowView, bool>)(x => (bool)x["tag"])).ToArray<DataRowView>();
            if (array.Length == 0)
            {
                myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
                return;
            }
            else
            {
                if (((IEnumerable<DataRowView>)array).Any<DataRowView>((Func<DataRowView, bool>)(x => x["stt_pb"].ToString().Trim() != "")))
                {
                    var confirm = await myDlSvc.ConfirmAsync(new MessageBoxOptions
                    {
                        Text = Lap["Do you want to delete"] + " ?",
                        Title = Lap["Confirm"],
                        OkButtonText = Lap["Yes"],
                        CancelButtonText = Lap["No"],
                        ShowIcon = true,
                        RenderStyle = MessageBoxRenderStyle.Warning
                    });
                    if (!confirm)
                    {
                        return;
                    }
                }
                foreach (DataRowView dataRowView in array)
                    Tinh_Xoabt(dataRowView);
                await LoadDataAsync();
                myStateMN.SetNewThongbao(Lap["Operation completed"] + " !");
                StateHasChanged();
            }
        }        
    }
    private async void Tinh_Xoabt(DataRowView item)
    {
        string str = item["stt_rec"].ToString();
        await myDb.LoadDataset(Procedures[3], new Dictionary<string, object>
        {
            ["@stt_rec"] = (object)str            
        });
    }
    private async void btnInbt_Click()
    {
        DataRowView[] array1 = (TblPH.DefaultView).Cast<DataRowView>().Where<DataRowView>((Func<DataRowView, bool>)(x => (bool)x["tag"])).ToArray<DataRowView>();
        if (array1.Length == 0)
        {
            myStateMN.SetNewThongbao(Lap["No data selected"] + " !");
            return;
        }
        else if (!((IEnumerable<DataRowView>)array1).Any<DataRowView>((Func<DataRowView, bool>)(x => x["stt_pb"].ToString().Trim() != "")))
        {
            myStateMN.SetNewThongbao(Lap["No data to print"] + " !");
            return;
        }
        else
        {
            string strsql = "Select * from dmct where ma_ct = '" + Ma_ct + "'";
            DataSet dsdmct = myDb.LoadDataSet(strsql);
            if (dsdmct.Tables.Count > 0)
            {
                curDmct = myDb.ConvertDataRow<Dmct>(dsdmct.Tables[0].Rows[0]);
            }
            foreach (DataRowView dataRowView in array1)
            {
                DataSet dataSet = await GetData_Inbt(dataRowView);
                List<Inbtpb> inbtpbList = new List<Inbtpb>();

                inbtpbList = myDb.ConvertDataTable<Inbtpb>(dataSet.Tables[0]);
                List<PK4Model> LSData = new List<PK4Model>();
                PK4Model _curModel = new PK4Model();
                _curModel.LSCt = inbtpbList;
                LSData.Add(_curModel);
                await ShowReport(LSData, typeof(PK4Model));
            }
        }
    }
    public async Task ShowReport(List<PK4Model> LSItems, Type Itype)
    {
        int _so_lien = (curDmct.So_lien == null || curDmct.So_lien <= 0? 1 : curDmct.So_lien);
        Dictionary<string, object> Par = new Dictionary<string, object>();
        Par.Add("LSItems", (object)LSItems);
        Par.Add("Menu_id", (object)Menu_id);
        Par.Add("M_so_lien", (object)_so_lien);
        var aty = typeof(ReportVcComponent<>).MakeGenericType(new[] { Itype });
        DxWindowModel model = new DxWindowModel(aty, Par, true, "BC");
        Par.Add("DxWindowmodel", model);
        await myModal.Show(model);
    }
    public async Task<DataSet> GetData_Inbt(DataRowView item)
    {
        string str = "";
        if (item != null)
            str = item["stt_rec"].ToString();
        DataSet dataSet = await myDb.LoadDataset(Procedures[2], new Dictionary<string, object>
        {
            ["@stt_rec"] = (object)str
        });        
        return dataSet;
    }
    #region CRUD
    public override void V_Moi()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string strkey = SqlTableKey.Split(";").LastOrDefault();
            if (!rview.DataView.Table.Columns.Contains(strkey))
                return;
            if (!String.IsNullOrEmpty(rview[strkey].ToString()))
            {
                if (editPage.ToUpper().StartsWith("FRM"))
                    myNavi.NavigateTo(editPage + "/" + Menu_id + "/" + rview[strkey].ToString());
                else
                {
                    Par.Clear();
                    Par.Add("Ma_ct", (object)Ma_ct);
                    Par.Add("Nam", (object)Year);
                    Par.Add("Ky", (object)Month1);
                    Par.Add("Ky2", (object)Month2);
                    Par.Add("Ma_ma", (object)rview[strkey].ToString());
                    Par.Add("Menu_id", (object)Menu_id);
                    Par.Add("ShowAdd", (object)true);
                    Par.Add("curActionTask", (object)ActionTask.New);
                    Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
                    IsShowFrm = true;
                    StateHasChanged();
                }
            }
        }
        else
        {
            if (editPage.ToUpper().StartsWith("FRM"))
                myNavi.NavigateTo(editPage + "/" + Menu_id + "/");
            else
            {
                Par.Clear();
                Par.Add("Ma_ct", (object)Ma_ct);
                Par.Add("Nam", (object)Year);
                Par.Add("Ky", (object)Month1);
                Par.Add("Ky2", (object)Month2);
                Par.Add("Ma_ma", (object)"");
                Par.Add("Menu_id", (object)Menu_id);
                Par.Add("ShowAdd", (object)true);
                Par.Add("curActionTask", (object)ActionTask.New);
                Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
                IsShowFrm = true;
                StateHasChanged();
            }
        }
    }
    public override void V_Sua()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            string strkey = SqlTableKey.Split(";").LastOrDefault();
            if (!rview.DataView.Table.Columns.Contains(strkey))
                return;
            if (!String.IsNullOrEmpty(rview[strkey].ToString()))
            {
                if (editPage.ToUpper().StartsWith("FRM"))
                    myNavi.NavigateTo(editPage + "/" + Menu_id + "/" + rview[strkey].ToString());
                else
                {
                    Par.Clear();
                    Par.Add("Ma_ct", (object)Ma_ct);
                    Par.Add("Nam", (object)Year);
                    Par.Add("Ky", (object)Month1);
                    Par.Add("Ky2", (object)Month2);
                    Par.Add("Ma_ma", (object)rview[strkey].ToString());
                    Par.Add("Menu_id", (object)Menu_id);
                    Par.Add("ShowAdd", (object)true);
                    Par.Add("curActionTask", (object)ActionTask.Edit);
                    Par.Add("OnClose", EventCallback.Factory.Create(this, CloseForm));
                    IsShowFrm = true;
                    StateHasChanged();
                }
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }
    public override async void V_Xoa()
    {
        DataRowView rview = (DataRowView)SelectedItem;
        if (rview != null)
        {
            if (!rview.DataView.Table.Columns.Contains(SqlTableKey.Split(";").LastOrDefault()))
                return;
            if (!string.IsNullOrEmpty(rview[SqlTableKey.Split(";").LastOrDefault()].ToString()))
                SqlTableKeyValue = rview[SqlTableKey.Split(";").LastOrDefault()].ToString().Trim();

            if (rview["stt_pb"].ToString().Trim() != "")
            {
                myStateMN.SetNewThongbao(Lap["Delete the previously created journal entry"] + " !");               
            }
            else
            {
                MessageDl = String.Format(Lap["Do you want to delete :{0} ?"], SqlTableKeyValue);
                ResultDl = await myDlSvc.ConfirmAsync(new MessageBoxOptions()
                    {
                        Text = MessageDl,
                        Title = Lap["Confirm deletion of list"],
                        OkButtonText = Lap["OK"],
                        CancelButtonText = Lap["Cancel"],
                        ShowIcon = true,
                        ShowCloseButton = false,
                        RenderStyle = MessageBoxRenderStyle.Danger,
                    });
                if (ResultDl == true)
                {
                    Dongyxoa(true);
                    StateHasChanged();
                }
            }
        }
        else
            myStateMN.SetNewThongbao(Lap["No data selected"]);
    }
    public override async Task Dongyxoa(bool status)
    {
        if (status)
        {
            string sql = $"Delete dmpbph where stt_rec = '{SqlTableKeyValue}';Delete dmpbct where stt_rec = '{SqlTableKeyValue}'";
            await myDb.ExecuteSqlQueryAsync(sql);
            await LoadDataAsync();
            string ToastMessage = String.Format(Lap["Delete successfully : {0}"], SqlTableKeyValue);
            myStateMN.SetNewThongbao(ToastMessage);
        }
        MessageDl = "";
        StateHasChanged();
    }
    #endregion
    async void OnDvcsChanged(string ma_dvcs)
    {
        Ma_dvcs = ma_dvcs;
        Ma_dvcs = (Ma_dvcs == "ALL" ? "" : Ma_dvcs);
        await LoadDataAsync();
        StateHasChanged();
    }
    public override async void CloseForm()
    {
        await LoadDataAsync();
        IsShowFrm = false;
        StateHasChanged();
    }
    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }
}
