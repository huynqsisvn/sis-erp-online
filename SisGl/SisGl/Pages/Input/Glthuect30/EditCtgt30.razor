@inherits FrmListBaseComponent
@using System.Data
@using DevExpress.Blazor

<FormList Title="@Title" @bind-curActionTask="@curActionTask" OnNew="@OnNew" OnCopy="@OnCopy" OnEdit="@OnEdit" OnSave="@OnSave" OnCancel="@OnCancel">
    <div class="row m-1 me-2 rounded-1 border border-light shadow">
        <DxFormLayout Data="@CurItem" ItemSizeMode="@Itemsizemode" CssClass="frm-header sis-form" onkeydown="ModifyEnterKeyPressAsTab(event);">
            
            <DxFormLayoutItem Caption="@Lap["Year"]" ColSpanMd="3" CaptionCssClass="fw-bold">
                <Template>
                    <DxSpinEdit @bind-Value="CurItem.Nam" DisplayFormat="0" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Month"]" ColSpanMd="3" CaptionCssClass="fw-bold">
                <Template>
                    <DxSpinEdit @bind-Value="CurItem.Thang" DisplayFormat="0" Min="1" Max="12" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@Lap["Invoice date"]" ColSpanMd="3">
                <Template>
                    <DxDateEdit @bind-Date="CurItem.Ngay_ct0" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Group ID"]" ColSpanMd="3" BeginRow="true">
                <Template>                    
                    <AutocompleteComponent Ma_dm="dmms" @bind-Value="CurItem.Ma_ms" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Voucher No"]" ColSpanMd="3" CaptionCssClass="fw-bold">
                <Template>
                    <DxTextBox @bind-Text="CurItem.So_ct0" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>          

            <DxFormLayoutItem Caption="@Lap["Symbol"]" ColSpanMd="3">
                <Template>
                    <DxTextBox @bind-Text="CurItem.Kh_mau_hd" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Denominator"]" ColSpanMd="3">
                <Template>
                    <DxTextBox @bind-Text="CurItem.Mau_so" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Supplier code"]" ColSpanMd="6">
                <Template>
                    <AutocompleteComponent Ma_dm="dmkh" @bind-Value="CurItem.Ma_kh" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" SelectChanged="MaKh_Changed" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Supplier name"]" ColSpanMd="6">
                <Template>
                    <DxTextBox @bind-Text="CurItem.Ten_kh" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Address"]" ColSpanMd="12">
                <Template>
                    <DxTextBox @bind-Text="CurItem.Dia_chi" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Tax code"]" ColSpanMd="6">
                <Template>
                    <DxTextBox @bind-Text="CurItem.Ma_so_thue" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Item/Service"]" ColSpanMd="12">
                <Template>
                    <DxTextBox @bind-Text="CurItem.Ten_vt" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Quantity"]" ColSpanMd="4">
                <Template>
                    <DxSpinEdit Value="@CurItem.So_luong" DisplayFormat="@M_IP_SL" Enabled="@AllowEditMode" ValueChanged="@((decimal val) => { CurItem.So_luong = val; CalculateTotal(); })" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Price"]" ColSpanMd="4">
                <Template>
                    <DxSpinEdit Value="@CurItem.Gia" DisplayFormat="@M_IP_GIA" Enabled="@AllowEditMode" ValueChanged="@((decimal val) => { CurItem.Gia = val; CalculateTotal(); })" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@(Lap["Amount"] + " " + M_MA_NT0)"  ColSpanMd="4">
                <Template>
                    <DxSpinEdit @bind-Value="CurItem.T_tien" DisplayFormat="@M_IP_TIEN" Enabled="false" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Tax code"]" ColSpanMd="4">
                <Template>
                    <AutocompleteComponent Ma_dm="dmthue" @bind-Value="CurItem.Ma_thue" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" SelectChanged="MaThue_Changed" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Tax rate"]" ColSpanMd="4">
                <Template>
                    <DxSpinEdit Value="@CurItem.Thue_suat" DisplayFormat="@M_IP_SL" Enabled="@AllowEditMode" ValueChanged="@((decimal val) => { CurItem.Thue_suat = val; CalculateTax(); })" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@(Lap["Tax amount"] + " " +M_MA_NT0)" ColSpanMd="6">
                <Template>
                    <DxSpinEdit @bind-Value="CurItem.T_thue" DisplayFormat="@M_IP_TIEN" Enabled="false" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Total money"]" ColSpanMd="6">
                <Template>
                    <DxSpinEdit Value="@(CurItem.T_tien + CurItem.T_thue)" DisplayFormat="@M_IP_TIEN_NT" Enabled="false" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Note"]" ColSpanMd="12">
                <Template>
                    <DxMemo @bind-Text="CurItem.Ghi_chu" Enabled="@AllowEditMode" Rows="2" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["VAT account"]" ColSpanMd="6">
                <Template>
                    <AutocompleteComponent Ma_dm="dmtk" @bind-Value="CurItem.Tk_thue_no" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Payable account"]" ColSpanMd="6">
                <Template>
                    <AutocompleteComponent Ma_dm="dmtk" @bind-Value="CurItem.Tk_du" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Project"]" ColSpanMd="6">
                <Template>
                    <AutocompleteComponent Ma_dm="dmvv" @bind-Value="CurItem.Ma_vv" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Purchase orders"]" ColSpanMd="6">
                <Template>
                    <DxTextBox @bind-Text="CurItem.So_dh" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Purchase orders"]" ColSpanMd="6">
                <Template>
                    <DxTextBox @bind-Text="CurItem.So_ct0" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Orders date"]" ColSpanMd="6">
                <Template>
                    <DxDateEdit @bind-Date="CurItem.Ngay_ct0" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode" />
                </Template>
            </DxFormLayoutItem>

        </DxFormLayout>
    </div>
</FormList>

@code {
[Parameter] public string Ma_ct { get; set; } = "T03";
    
Ctgt30 CurItem = new Ctgt30();
public string Stt_rec { get; set; } = "";
public string M_WS_ID = "Z";
public string M_MA_NT0 = "VND";
public string M_IP_SL = "N2";
public string M_IP_GIA = "N0";
public string M_IP_TIEN = "N0";
public string M_IP_TIEN_NT = "N0";

    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Stt_rec = Ma_ma?.Trim();
        PageLoad();
        LoadOptions();

        CurItem = new Ctgt30();

        switch (curActionTask)
        {
            case ActionTask.View:
                Title = Lap["View"] + ": " + Lap["VAT Input Invoice"];
                V_Xem();
                break;
            case ActionTask.Edit:
                Title = Lap["Edit"] + ": " + Lap["VAT Input Invoice"];
                V_Sua();
                break;
            case ActionTask.New:
                Title = Lap["New"] + ": " + Lap["VAT Input Invoice"];
                V_Moi();
                break;
            default:
                V_Xem();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
            StateHasChanged();
        }
    }

    async Task OnNew() { V_Moi(); curActionTask = ActionTask.New; StateHasChanged(); }
    async Task OnCopy() { V_Copy(); curActionTask = ActionTask.New; StateHasChanged(); }
    async Task OnEdit() { V_Sua(); }

    async void V_Moi()
    {
        CurItem = new Ctgt30();
        CurItem.Stt_rec = GetStt_rec();
        CurItem.Ma_ct = Ma_ct;
        CurItem.Ngay_ct = DateTime.Now.Date;
        CurItem.Ngay_lct = DateTime.Now.Date;
        CurItem.Ma_dvcs = myStateMN.GetMa_Dvcs();
        CurItem.Ma_nt = "VND";
        CurItem.Ty_gia = 1;
        CurItem.Thue_suat = 10;
        CurItem.Nam = DateTime.Now.Year;
        CurItem.Thang = DateTime.Now.Month;
        CurItem.Date0 = DateTime.Now;
        CurItem.Time0 = DateTime.Now.ToString("HH:mm:ss");
        CurItem.User_id0 = curUser?.User_id.ToString() ?? "0";
        CurItem.Status = "1";
        AllowEditMode = true;
        StateHasChanged();
    }

    async void V_Copy()
    {
        if (!string.IsNullOrEmpty(Stt_rec))
        {
            await LoadData(Stt_rec);
            CurItem.Stt_rec = GetStt_rec();
            CurItem.Stt_rec0 = "";
            CurItem.So_ct0 = "";
            AllowEditMode = true;
            curActionTask = ActionTask.New;
            StateHasChanged();
        }
    }

    async void V_Xem()
    {
        AllowEditMode = false;
        if (!string.IsNullOrEmpty(Stt_rec))
        {
            await LoadData(Stt_rec);
            StateHasChanged();
        }
    }

    async void V_Sua()
    {
        if (!string.IsNullOrEmpty(Stt_rec))
        {
            await LoadData(Stt_rec);
            AllowEditMode = true;
            curActionTask = ActionTask.Edit;
            StateHasChanged();
        }
    }

    async Task LoadData(string sttRec)
    {
        try
        {
            string sql = $"SELECT * FROM ctgt30 WHERE stt_rec = @sttRec";
            var ds = await myDb.LoadDataset(sql, "sttRec", sttRec);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                var list = myDb.ConvertDataTable<Ctgt30>(ds.Tables[0]);
                CurItem = list.First();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Error loading data"]}: {ex.Message}");
            StateHasChanged();
        }
    }

    async Task OnSave()
    {
        if (curActionTask == ActionTask.New || curActionTask == ActionTask.Edit)
            await Save();
    }

    private async Task Save()
    {
        if (!CheckValid()) return;

        try
        {
            CurItem.Date = DateTime.Now;
            CurItem.Time = DateTime.Now.ToString("HH:mm:ss");
            CurItem.User_id = curUser?.User_id.ToString() ?? "0";
            CurItem.Ma_dvcs = myStateMN.GetMa_Dvcs();
            CurItem.Ma_ct = Ma_ct;

            if (curActionTask == ActionTask.New)
            {
                CurItem.Date0 = DateTime.Now;
                CurItem.Time0 = DateTime.Now.ToString("HH:mm:ss");
                CurItem.User_id0 = curUser?.User_id.ToString() ?? "0";
                
                await myDb.InsertOneRow<Ctgt30>(CurItem, "ctgt30");
                curActionTask = ActionTask.View;
                myStateMN.SetNewThongbao(String.Format(Lap["Successfully added new : {0}"], CurItem.So_ct0));
            }
            else if (curActionTask == ActionTask.Edit)
            {
                await myDb.UpdateOneRow<Ctgt30>(CurItem, "ctgt30", "stt_rec", Stt_rec);
                curActionTask = ActionTask.View;
                myStateMN.SetNewThongbao(String.Format(Lap["Edit successfully : {0}"], CurItem.So_ct0));
            }

            StateHasChanged();
            AllowEditMode = false;
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao($"{Lap["Save failed"]}: {ex.Message}");
            StateHasChanged();
        }
    }

    bool CheckValid()
    {
        if (!CurItem.Nam.HasValue || CurItem.Nam <= 0)
        {
            myStateMN.SetNewThongbao(Lap["Year is required"] + "!");
            StateHasChanged();
            return false;
        }
        if (!CurItem.Thang.HasValue || CurItem.Thang <= 0)
        {
            myStateMN.SetNewThongbao(Lap["Month is required"] + "!");
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrWhiteSpace(CurItem.So_ct0))
        {
            myStateMN.SetNewThongbao(Lap["Invoice number is required"] + "!");
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrWhiteSpace(CurItem.Ma_kh))
        {
            myStateMN.SetNewThongbao(Lap["Supplier code is required"] + "!");
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrWhiteSpace(CurItem.Tk_thue_no))
        {
            myStateMN.SetNewThongbao(Lap["VAT account is required"] + "!");
            StateHasChanged();
            return false;
        }
        if (string.IsNullOrWhiteSpace(CurItem.Tk_du))
        {
            myStateMN.SetNewThongbao(Lap["Payable account is required"] + "!");
            StateHasChanged();
            return false;
        }
        return true;
    }

    async void MaKh_Changed(ExpandoObject value)
    {
        if (!string.IsNullOrEmpty(CurItem.Ma_kh))
        {
            try
            {
                string sql = "SELECT ten_kh, dia_chi, ma_so_thue FROM dmkh WHERE ma_kh = @makhs";
                var ds = await myDb.LoadDataset(sql, "makhs", CurItem.Ma_kh);
                if (ds != null && ds.Tables[0].Rows.Count > 0)
                {
                    var row = ds.Tables[0].Rows[0];
                    CurItem.Ten_kh = row["ten_kh"]?.ToString() ?? "";
                    CurItem.Dia_chi = row["dia_chi"]?.ToString() ?? "";
                    CurItem.Ma_so_thue = row["ma_so_thue"]?.ToString() ?? "";
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    async void MaThue_Changed(ExpandoObject value)
    {
        if (!string.IsNullOrEmpty(CurItem.Ma_thue))
        {
            try
            {
                string sql = "SELECT thue_suat, tk_no FROM dmthue WHERE ma_thue = @mathue";
                var ds = await myDb.LoadDataset(sql, "mathue", CurItem.Ma_thue);
                if (ds != null && ds.Tables[0].Rows.Count > 0)
                {
                    var row = ds.Tables[0].Rows[0];
                    CurItem.Thue_suat = Convert.ToDecimal(row["thue_suat"] ?? 10);
                    CurItem.Tk_thue_no = row["tk_no"]?.ToString() ?? "";
                    CalculateTax();
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    void CalculateTotal()
    {
        CurItem.T_tien = CurItem.So_luong * CurItem.Gia;
        CalculateTax();
    }

    void CalculateTax()
    {
        CurItem.T_thue = CurItem.T_tien * CurItem.Thue_suat / 100;
        StateHasChanged();
    }

    public string GetStt_rec()
    {
        int result = 0;
        object obj = myDb.GetValue($"SELECT MAX(stt_rec) FROM ctgt30 WHERE stt_rec LIKE '{M_WS_ID}{Ma_ct}%'");
        if (obj == null || obj == DBNull.Value)
            return string.Format("{0}{1}{2:0000000}", M_WS_ID, Ma_ct, result + 1);
        
        string maxValue = obj.ToString();
        if (maxValue.Length > 4 + Ma_ct.Length)
        {
            int.TryParse(maxValue.Substring(1 + Ma_ct.Length), out result);
        }
        return string.Format("{0}{1}{2:0000000}", M_WS_ID, Ma_ct, result + 1);
    }

    public virtual void LoadOptions()
    {
        M_WS_ID = myOption.GetOptionsValue("M_WS_ID").Trim().ToUpper();
        M_MA_NT0 = myOption.GetOptionsValue("M_MA_NT0");
        M_IP_SL = myOption.GetOptionsValue("M_IP_SL");
        M_IP_GIA = myOption.GetOptionsValue("M_IP_GIA");
        M_IP_TIEN = myOption.GetOptionsValue("M_IP_TIEN");
        M_IP_TIEN_NT = myOption.GetOptionsValue("M_IP_TIEN_NT");
    }

    public virtual void OnCancel()
    {
        if (DxWindowmodel != null)
        {
            myModal.CloseModal(DxWindowmodel);
        }

        if (ShowAdd == true)
        {
            OnClose.InvokeAsync();
        }
        else
            myNavi.NavigateTo(ParentPage);
    }
}
