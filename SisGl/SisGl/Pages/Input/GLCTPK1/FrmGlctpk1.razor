                                                    <DxTextBox @bind-Text="@_Ct11gt.Kh_mau_hd" Enabled="@AllowEditMode"></DxTextBox>

                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="So_seri0" Caption="@Lap["Symbol"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("5")">
                                                <CellEditTemplate Context="GrdCTGTContext">
