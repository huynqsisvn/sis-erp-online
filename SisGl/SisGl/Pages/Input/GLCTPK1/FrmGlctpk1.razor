                                                    <AutocompleteComponent Ma_dm="dmkh_thue" @bind-Value="@_Ct11gt.Ma_kh" SelectChanged="@((ExpandoObject value) => { OnGridCTGT_DMDM_Changed(value, "Ma_kh"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ten_kh" ReadOnly="true" Caption="@Lap["Customer name"]" CaptionAlignment="GridTextAlignment.Center" Width="300px" VisibleIndex="@CtOrder.GetKey("7")" />

                                            <DxGridDataColumn FieldName="Dia_chi" Caption="@Lap["Address"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="300px" VisibleIndex="@CtOrder.GetKey("8")">
                                                <CellEditTemplate Context="GrdCTGTContext">
