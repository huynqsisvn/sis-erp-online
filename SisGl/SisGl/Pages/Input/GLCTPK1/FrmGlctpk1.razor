                                                @bind-SelectedDataItem="@SelectedDataItemCT"
                                                ValidationEnabled="false"
                                                EditMode="GridEditMode.EditRow"
                                                RowClick="@StartEditDataItemByClickCT"
                                                SelectionMode="GridSelectionMode.Single"
                                                CustomizeEditModel="Grid_CustomizeEditModelCT"
                                                EditModelSaving="Grid_EditModelSavingCT"
                                                DataItemDeleting="Grid_DataItemDeletingCT"
                                                CustomizeSummaryDisplayText="Grid_CustomizeSummaryDisplayText"
                                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                EditNewRowPosition="@NewItemRowPosition"
                                                ShowAllRows="true"
                                                TextWrapEnabled="false" AllowSort="false"
                                                HighlightRowOnHover="true">
                                            <Columns>
                                                <DxGridCommandColumn Width="3%" NewButtonVisible="false" Visible="@AllowEditMode" VisibleIndex="0">
                                                    <CellDisplayTemplate Context="cntedit">
                                                        <div class="grid-cell-align-center">
                                                            <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                                      RenderStyle="ButtonRenderStyle.Link"
                                                                      CssClass="grid-delete-btn"
                                                                      aria-label="Delete"
                                                                      Click="@(() => GridCT.ShowRowDeleteConfirmation(cntedit.VisibleIndex))" />
                                                        </div>
                                                    </CellDisplayTemplate>
                                                    <CellEditTemplate Context="cntedit1">
                                                        <div class="grid-cell-align-center">
                                                            <DxButton Enabled="false"
                                                                      CssClass="grid-disabled-button"
                                                                      IconCssClass="grid-icon grid-icon-delete"
                                                                      aria-label="Delete"
                                                                      RenderStyle="ButtonRenderStyle.Link" />
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridCommandColumn>
                                                <DxGridDataColumn FieldName="Tk_i" Caption="@Lap["Account"].ToString()" Width="150px" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("1")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <div id="@($"Tk_i_{_Ct11.Stt}")" class="autocomplete-cell-wrapper m-0 p-0">
                                                            <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@_Ct11.Tk_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Tk_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                        </div>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ten_tk" ReadOnly="true" Caption="@Lap["Account name"]" CaptionAlignment="GridTextAlignment.Center" Width="300px" VisibleIndex="@CtOrder.GetKey("2")" />

                                                <DxGridDataColumn FieldName="Ma_kh_i" Caption="@Lap["Customer"].ToString()" Width="150px" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("3")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent Ma_dm="dmkh" @bind-Value="@_Ct11.Ma_kh_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_kh_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ten_kh" ReadOnly="true" Caption="@Lap["Customer name"]" CaptionAlignment="GridTextAlignment.Center" Width="300px" VisibleIndex="@CtOrder.GetKey("4")" />


                                                <DxGridDataColumn FieldName="Ps_no_nt" Caption="@String.Concat(Lap["Debt"], " ", CurPh.Ma_nt)" Width="100px" DisplayFormat="@M_IP_TIEN_NT" VisibleIndex="@CtOrder.GetKey("5")">
