                                                    <AutocompleteComponent Ma_dm="dmms" @bind-Value="@_Ct11gt.Ma_ms" SelectChanged="@((ExpandoObject value) => { OnGridCTGT_DMDM_Changed(value, "Ma_ms"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                </CellEditTemplate>
