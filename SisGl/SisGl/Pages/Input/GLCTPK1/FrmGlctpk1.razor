                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="So_ct0" Caption="@Lap["Contract number"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("3")">
                                                <CellEditTemplate Context="GrdCTGTContext">
