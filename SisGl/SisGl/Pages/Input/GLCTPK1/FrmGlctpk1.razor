    private async Task TyGiaValueChanged(bool isMaNtChanged)
    {
        if (curActionTask == ActionTask.Delete || curActionTask == ActionTask.View)
            return;

        decimal tyGia = CurPh.Ty_gia;
        decimal suaTien = CurPh.Sua_tien;

        if (tyGia == 0 || (suaTien != 0 && !isMaNtChanged))
            return;


        UpdateTotal("ps_no", "ps_no_nt", true);
        UpdateTotal("ps_co", "ps_co_nt", false);


        CurPh.T_tien = LSCt.Sum(a => a.Ps_co);

        await InvokeAsync(StateHasChanged);
    }

    private void UpdateTotal(string column, string columnNt, bool isPrice)
    {
        decimal tyGia = CurPh.Ty_gia;
        bool isLocalCurrency = CurPh.Ma_nt.Trim() == M_ma_nt0.Trim();

        foreach (var ct in LSCt)
        {

            decimal ps_co_nt = ct.Ps_co_nt;
            decimal ps_no_nt = ct.Ps_no_nt;



            if (isLocalCurrency)
            {

                ct.Ps_co = ps_co_nt;
                ct.Ps_no = ps_no_nt;
            }
            else
            {

                decimal ps_co = Math.Round(ps_co_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                decimal ps_no = Math.Round(ps_no_nt * tyGia, isPrice ? M_ROUND_GIA : M_ROUND);
                if (ps_co != 0) ct.Ps_co = ps_co;
                if (ps_no != 0) ct.Ps_no = ps_no;
            }
        }
    }

