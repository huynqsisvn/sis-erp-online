        await InsertCTHHD(CurPh.Stt_rec, CurPh.Ma_qs, CurPh.Ma_ct, curQuyenso.So_ct);

        foreach (Ct11 ct in LSCt)
        {
            ct.Stt_rec = CurPh.Stt_rec;
            ct.So_ct = CurPh.So_ct;
            ct.Ngay_ct = CurPh.Ngay_ct;
        }
        StateHasChanged();
    }
