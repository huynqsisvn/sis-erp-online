                                            <DxGridDataColumn FieldName="Ngay_ct0" Caption="@Lap["Contract date"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("2")">
                                                <CellEditTemplate Context="GrdCTGTContext">
                                                    @{
                                                        var _Ct11gt = (Ct11gt)GrdCTGTContext.EditModel;
