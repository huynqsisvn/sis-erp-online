                                                </CellEditTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Ma_kh" Caption="@Lap["Customer code"].ToString()" Width="200px" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="@CtOrder.GetKey("6")">
                                                <CellEditTemplate Context="GrdCTGTContext">
