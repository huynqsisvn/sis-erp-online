        CurPh.Ma_dvcs = Ma_dvcs;
        CurPh.Ma_ct = Ma_ct;
        CurPh.Ma_qs = Ma_qs;
        CurPh.T_tien = 0;
        CurPh.T_tien_nt = 0;
        CurPh.T_ck = 0;
        CurPh.Dien_giai = "";
        CurPh.Sua_tien = 0;
        CurPh.Status = "2";

