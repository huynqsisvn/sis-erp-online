                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Ps_co_nt" Caption="@String.Concat(Lap["Credit"], " ", CurPh.Ma_nt)" Width="100px" DisplayFormat="@M_IP_TIEN_NT" VisibleIndex="@CtOrder.GetKey("6")">
