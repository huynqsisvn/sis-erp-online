                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct11 = (Ct11)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="false" Value="@_Ct11.Ps_no" ValueExpression="@(() => _Ct11.Ps_no)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Ps_no"); })" Id="Ps_no"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>

                                                    <DxGridDataColumn FieldName="Ps_co" Caption="@String.Concat(Lap["Credit"], " ", M_ma_nt0.Trim())" Width="100px" DisplayFormat="@M_IP_TIEN" VisibleIndex="@CtOrder.GetKey("8")">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct11 = (Ct11)GrdContext.EditModel;
                                                            }
                                                            <DxSpinEdit Enabled="false" Value="@_Ct11.Ps_co" ValueExpression="@(() => _Ct11.Ps_co)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Ps_co"); })" Id="Ps_co"></DxSpinEdit>
                                                        </CellEditTemplate>
                                                    </DxGridDataColumn>
                                                }
                                                <DxGridDataColumn FieldName="Ma_bpht_i" Caption="@Lap["Mã bpht"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("9")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent Ma_dm="dmbp" @bind-Value="@_Ct11.Ma_bpht_i" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_bpht_i"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Dien_giaii" Caption="@Lap["Interpretation"].ToString()" Width="200px" VisibleIndex="@CtOrder.GetKey("10")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <DxTextBox Enabled="@AllowEditMode"
                                                                   @bind-Text="@_Ct11.Dien_giaii">
                                                        </DxTextBox>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ngay_ct0" Caption="@Lap["Contract date"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("11")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <DxDateEdit @bind-Date="@_Ct11.Ngay_ct0" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" Enabled="@AllowEditMode" />
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="So_ct0" Caption="@Lap["Contract number"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("12")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <DxTextBox @bind-Text="@_Ct11.So_ct0" Enabled="@AllowEditMode"></DxTextBox>

                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Ma_thck" Caption="@Lap["Thck code"].ToString()" CaptionAlignment="GridTextAlignment.Center" Width="100px" VisibleIndex="@CtOrder.GetKey("13")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <AutocompleteComponent Ma_dm="dmthck" @bind-Value="@_Ct11.Ma_thck" SelectChanged="@((ExpandoObject value) => { OnGridCT_DMDM_Changed(value, "Ma_thck"); })" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="Han_tt" Caption="@Lap["Payment deadline"].ToString()" Width="100px" VisibleIndex="@CtOrder.GetKey("14")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <DxSpinEdit Enabled="@AllowEditMode" Value="@_Ct11.Han_tt" ValueExpression="@(() => _Ct11.Han_tt)" ValueChanged="@((decimal newvalue) => { OnGridCT_Value_Changed(newvalue, "Han_tt"); })" Id="Han_tt"></DxSpinEdit>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                <DxGridDataColumn FieldName="Nh_dk" Caption="@Lap["Group provisions"]" Width="100px" VisibleIndex="@CtOrder.GetKey("15")">
                                                    <CellEditTemplate Context="GrdContext">
                                                        @{
                                                            var _Ct11 = (Ct11)GrdContext.EditModel;
                                                        }
                                                        <DxTextBox Enabled="@AllowEditMode"
                                                                   @bind-Text="@_Ct11.Nh_dk">
                                                        </DxTextBox>
                                                    </CellEditTemplate>
                                                </DxGridDataColumn>

                                                @*  @foreach (FreeCodeInfo row in LsFreeCodeInfo)
                                            {
                                                @if (row.Loai_dmctct == 1)
                                                {
                                                    <DxGridDataColumn FieldName="@row.Field_ct" Caption="@row.Caption" Width="@row.sWidth" VisibleIndex="@row.Order">
                                                        <CellEditTemplate Context="GrdContext">
                                                            @{
                                                                var _Ct11 = (Ct11)GrdContext.EditModel;
                                                            }
