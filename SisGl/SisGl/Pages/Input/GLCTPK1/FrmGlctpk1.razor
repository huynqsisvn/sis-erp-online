@inherits TranBaseComponent
@using System.Data
@using DevExpress.Blazor
@using DevExpress.Blazor.Legacy.Internal

<div class="m-0 p-0 w-100" data-spy="scroll">
    @if (IsShowVoucher)
    {
        <FormTrans Title="@Pagetitle" @bind-curActionTask="@curActionTask" OnNew="@OnNew" OnCopy="@OnCopy" OnEdit="@OnEdit" OnSave="@OnSave" OnCancel="@OnCancel" OnPrint="@OnPrint" OnTemplateChanged="@OnTemplateChanged" Stt_rec="@CurPh.Stt_rec" curUser="@curUser" Ma_ct="@Ma_ct" Menu_id="@Menu_id" Phdbf="@M_Phdbf" LanguageID="@LanguageID">
            <div class="row m-1 mt-3 me-2">
                <DxFormLayout SizeMode="@Itemsizemode" CssClass="frm-header" onkeydown="ModifyEnterKeyPressAsTab(event);">
                    <DxFormLayoutGroup ColSpanMd="12" Caption="@Lap["Infomation"]" Decoration="FormLayoutGroupDecoration.Card" CssClass="dx-total-box" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start" AnimationType="LayoutAnimationType.Slide">
                        <DxFormLayoutGroup ColSpanMd="9" Decoration="FormLayoutGroupDecoration.None" SizeMode="@Itemsizemode" CssClass="mt-3">
                            <!-- Cột trái: GL date, LCT date, Status -->
                            <DxFormLayoutItem Caption="@Lap["GL date"]" ColSpanMd="4">
                                <Template>
                                    <DxDateEdit CssClass="w-100"
                                                @bind-Date="@CurPh.Ngay_ct"
                                                DisplayFormat="dd-MM-yyyy"
                                                Format="dd-MM-yyyy"
                                                Enabled="@AllowEditMode">
                                    </DxDateEdit>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["LCT date"]" ColSpanMd="5">
                                <Template>
                                    <DxDateEdit CssClass="w-100"
                                                @bind-Date="@CurPh.Ngay_lct"
                                                DisplayFormat="dd-MM-yyyy"
                                                Format="dd-MM-yyyy"
                                                Enabled="@AllowEditMode">
                                    </DxDateEdit>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Status"]" ColSpanMd="4">
                                <Template>
                                    <AutocompleteComponent CssClass="w-100 p-0"
                                                           Ma_dm="dmpost"
                                                           @bind-Value="@CurPh.Status"
                                                           Filter="@filter_status"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn">
                                    </AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>

                            <!-- Cột phải: Book code, Voucher No, Currency + Tỷ giá -->
                            <DxFormLayoutItem Caption="@Lap["Book code"]" ColSpanMd="5">
                                <Template>
                                    <AutocompleteComponent CssClass="w-100 p-0"
                                                           Ma_dm="dmqs"
                                                           @bind-Value="@CurPh.Ma_qs"
                                                           SelectChanged="OnAutoCompleteQuyensoChanged"
                                                           Filter="@_filter_qs"
                                                           IsEnable="@AllowEditMode"
                                                           IsLangEn="@IsLangEn"
                                                           Id="ma_qs_input">
                                    </AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="@Lap["Voucher No"]" ColSpanMd="4">
                                <Template>
                                    <DxTextBox CssClass="w-100"
                                               @bind-Text="@CurPh.So_ct"
                                               Enabled="@AllowEditMode">
                                    </DxTextBox>
                                </Template>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem Caption="@Lap["Ex. rate"]" ColSpanMd="3">
                                <Template>
                                    <AutocompleteComponent Ma_dm="dmnt" @bind-Value="@CurPh.Ma_nt" SelectChanged="OnAutoCompleteMaNTChanged" IsEnable="@AllowEditMode" IsLangEn="@IsLangEn"></AutocompleteComponent>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CssClass="no-caption" Caption="" ColSpanMd="2">
                                <Template>
                                    <DxSpinEdit ReadOnly="@(CurPh?.Ma_nt?.Trim().Equals(M_ma_nt0) == true)" Value="@CurPh.Ty_gia" ValueExpression="@(() => CurPh.Ty_gia)" ValueChanged="@((decimal newvalue) => { OnValueTyGiaChanged(newvalue); })" DisplayFormat="@M_IP_TY_GIA" Enabled="@AllowEditMode" Id="Ty_gia"></DxSpinEdit>
                                </Template>
                            </DxFormLayoutItem>
                            <!-- Dòng đầy đủ: Diễn giải -->
                            <DxFormLayoutItem Caption="@Lap["Interpretation"]" ColSpanMd="12">
                                <Template>
                                    <DxTextBox CssClass="w-100"
                                               @bind-Text="@CurPh.Dien_giai"
                                               Enabled="@AllowEditMode">
                                    </DxTextBox>
                                </Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                    </DxFormLayoutGroup>
                    <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-detail" @bind-ActiveTabIndex="@activeTabIndex" TabClick="@OnTabChanged">
                        <DxFormLayoutTabPage Caption="@Lap["Details"]" CaptionCssClass="fw-bold" HeaderCssClass="rounded-pill">
                            <DxFormLayoutItem ColSpanMd="12">
                                <Template>
                                    <div @ref="GridWrapper" id="grid-wrapper" @onfocusout="OnGridCTLostFocus" class="mt-2 mb-3">
