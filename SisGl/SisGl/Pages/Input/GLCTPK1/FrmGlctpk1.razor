    async void V_Sua()
    {
        if (!string.IsNullOrEmpty(Stt_rec))
        {
            await Loaddata();
            if (!SisData.Lib.CheckValidNgayKs(mySysvar, myDb, CurPh.Ngay_ct, Ma_ct))
            {
                AllowEditMode = false;
                curActionTask = ActionTask.View;
                myStateMN.SetNewThongbao(Lap["Data is locked, cannot be edited!"]);
                return;
            }
            CurPh.Stt_rec_pt ??= "";
            if ((!(Ma_ct == "PK1") || !(CurPh.Stt_rec.ToString().Trim() != "")))
            {
                AllowEditMode = false;
                curActionTask = ActionTask.View;
                myStateMN.SetNewThongbao(Lap["Do not edit paid invoices!"]);
                return;
            }
            AllowEditMode = true;
            curActionTask = ActionTask.Edit;
            StateHasChanged();
        }
    }
    public override async Task Loaddata()
    {
        LoadVoucher();

        if (DsTrans != null && DsTrans.Tables.Count > 0)
        {
            List<Ph11> ls81 = myDb.ConvertDataTable<Ph11>(DsTrans.Tables[0]);
            if (ls81 != null && ls81.Count > 0)
            {
                CurPh = ls81[0];
                NotMaNt0Voucher = !CurPh.Ma_nt.Equals(M_ma_nt0) ? true : false;
            }

            if (DsTrans != null && DsTrans.Tables.Count > 1)
                LSCt = myDb.ConvertDataTable<Ct11>(DsTrans.Tables[1]);
            if (DsTrans != null && DsTrans.Tables.Count > 2)
                LSCtgt = myDb.ConvertDataTable<Ct11gt>(DsTrans.Tables[2]);
        }
    }
    private async Task Save()
    {
        if (!SisData.Lib.CheckValidNgayKs(mySysvar, myDb, CurPh.Ngay_ct, Ma_ct))
        {
            myStateMN.SetNewThongbao(Lap["Data is locked, cannot be edited!"]);
            return;
        }

        if (!CheckValid())
            return;

        await GridCT.SaveChangesAsync();

        if (LSCt.Count <= 0)
        {
            Message = Lap["No details entered"] + " !";
            return;
        }

        ParentReload = true;
        CurPh.Date = DateTime.Now.Date;
        CurPh.Time = DateTime.Now.ToString("HH:mm:ss");
        if (curUser != null)
            CurPh.User_id = curUser.User_id;
        CurPh.Ma_dvcs = myStateMN.GetMa_Dvcs();

        if (curActionTask == ActionTask.New)
        {
            CurPh.Date0 = DateTime.Now.Date;
            CurPh.Time0 = DateTime.Now.ToString("HH:mm:ss");

            if (curUser != null)
            {
                CurPh.User_id0 = curUser.User_id;
            }
            myDb.UpdateDataRowFromModel<Ph11>(DsTrans.Tables[0].Rows[0], CurPh);
            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

            // if (LSCt.Count > 0)
            // {
            //     for (int x = 0; x < LSCt.Count; x++)
            //     {
            //             LSCt.Remove(LSCt[x]);
            //     }
            // }
            if (LSCt.Count > 0)
                await myDb.InsertManyRow<Ct11>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec);
            if (LSCtgt.Count > 0)
            {
                await myDb.InsertManyRow<Ct11gt>(LSCtgt, M_Ctgtdbf, "stt_rec", CurPh.Stt_rec);
            }
            curActionTask = ActionTask.View;
            Message = String.Format(Lap["Successfully added new : {0}"], CurPh.So_ct);
        }
        else if (curActionTask == ActionTask.Edit)
        {
            myDb.UpdateDataRowFromModel<Ph11>(DsTrans.Tables[0].Rows[0], CurPh);
            await myDb.UpdateRow(M_Phdbf, DsTrans.Tables[0].Rows[0], "stt_rec='" + CurPh.Stt_rec + "'", "stt_rec,row_id");

            // if (LSCt.Count > 0)
            // {
            //     for (int x = 0; x < LSCt.Count; x++)
            //     {
            //             LSCt.Remove(LSCt[x]);
            //     }
            // }
            // if (LSCtgt.Count > 0)
            // {
            //     for (int x = 0; x < LSCtgt.Count; x++)
            //     {
            //             LSCtgt.Remove(LSCtgt[x]);
            //     }
            // }
            string _saveXml = myOption.GetOptionsValue("M_SAVE_XML");
            if (LSCt.Count > 0)
            {
                xmlpath = Path.Combine(myWebhost.WebRootPath, "upload_tmp", CurPh.Stt_rec);
                await myDb.SaveDataTable<Ct11>(LSCt, M_Ctdbf, "stt_rec", CurPh.Stt_rec, "", xmlpath, _saveXml);

            }

            if (LSCtgt.Count > 0)
            {
                xmlpath = Path.Combine(myWebhost.WebRootPath, "upload_tmp", CurPh.Stt_rec + "CT");
                await myDb.SaveDataTable<Ct11gt>(LSCtgt, M_Ctgtdbf, "stt_rec", CurPh.Stt_rec, "", xmlpath, _saveXml);
            }
            curActionTask = ActionTask.View;
            Message = String.Format(Lap["Edit successfully : {0}"], CurPh.So_ct);
        }
        SaveLastPh(CurPh);
        if (CurPh.Status.Equals("2"))
        {
            string format = "EXEC SetSoct '" + CurPh.Ma_qs.Trim() + "', '" + CurPh.So_ct.Trim() + "'";
            await myDb.DeleteAsync(format);
            string newstt_recPt1 = "";
            DataTable dt = new DataTable();
            dt.Columns.Add("ma_ct", typeof(string));
            dt.Columns.Add("stt_rec", typeof(string));
            dt.Columns.Add("stt_recPT", typeof(string));
            dt.Columns.Add("ma_qs", typeof(string));
            dt.Columns.Add("so_ct", typeof(string));
            dt.Columns.Add("ma_nt", typeof(string));
            dt.Columns.Add("ty_gia", typeof(Decimal));
            dt.Columns.Add("ty_giaf", typeof(Decimal));
            dt.Columns.Add("nguoinop", typeof(string));
            dt.Columns.Add("lydonop", typeof(string));
            dt.Columns.Add("ma_gd", typeof(string));
            bool flag2 = false;
            bool _createPK1 = false;
            if (!flag2)
            {
                if (curActionTask == ActionTask.New)
                {
                    _createPK1 = true;
                }
                Post(_createPK1 ? 1 : 0);

            }




        }
        myStateMN.SetNewThongbao(Message);
        curActionTask = ActionTask.View;
        AllowEditMode = false;
    }

    private void Post(int ispostck)
    {
        string _poststore = (Post_store == null || Post_store.Length <= 2) ? "[GLCTPK1-Post]" : Post_store[2];
        string format = string.Format("exec [dbo].{0} '{1}'", _poststore, CurPh.Stt_rec);
        myDb.ExecuteSqlQueryAsync(format);
    }

    bool CheckValid()
    {
        bool flag = true;

        string stt_rec = CurPh.Stt_rec.ToString().Trim();
        decimal num = CurPh.Ty_gia;
        int num2 = 0;
        int.TryParse(CurPh.Sua_tien.ToString(), out num2);
        if (string.IsNullOrEmpty(CurPh.Ngay_ct.ToString()) && flag)
        {
            Message = Lap["Chưa vào ngày hạch toán!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;
        }
        if (string.IsNullOrEmpty(CurPh.Ma_qs) && flag)
        {
            Message = Lap["Chưa vào quyển số!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;

        }
        if (string.IsNullOrEmpty(CurPh.So_ct) && flag)
        {
            Message = Lap["Chưa vào Số c.từ!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;

        }
        if (LSCt.Count == 0 && flag)
        {
            Message = Lap["Chưa vào chi tiết!"];
            myStateMN.SetNewThongbao(Message);
            StateHasChanged();
            flag = false;
            return flag;

        }
        if (LSCtgt.Count > 0 && flag)
        {
            foreach (Ct11gt ctgt in LSCtgt)
            {
                // if (string.IsNullOrEmpty(ctgt.Tk_du?.Trim()))
                // {
                //     {
                //         LSCtgt.Remove(ctgt);
                //     }
                // }
                if (LSCtgt.Count == 0 || string.IsNullOrEmpty(ctgt.Tk_du?.Trim()))
                {
                    Message = Lap["Chưa vào tk đối ứng!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;

                }
            }

        }
        if (LSCt.Count > 0 && flag)
        {
            foreach (Ct11 ct in LSCt)
            {
                if (string.IsNullOrEmpty(ct.Tk_i?.Trim()))
                {
                    {
                        LSCt.Remove(ct);
                    }
                }
                if (LSCt.Count == 0)
                {
                    Message = Lap["Chưa vào chi tiết!"];
                    myStateMN.SetNewThongbao(Message);
                    StateHasChanged();
                    flag = false;
                    return flag;

                }

            }

        }
        if (flag)
        {
            var source = from tb_ct in LSCt
                         where tb_ct.Stt_rec.ToString() == stt_rec
                         select new
                         {
                             nh_dk = (tb_ct.Nh_dk ?? "").TrimEnd(),
                             ps_no_nt = ((tb_ct.Ps_no_nt == null) ? 0 : tb_ct.Ps_no_nt),
                             ps_co_nt = ((tb_ct.Ps_co_nt == null) ? 0 : tb_ct.Ps_co_nt),
                             ps_no = ((tb_ct.Ps_no == null) ? 0 : tb_ct.Ps_no),
                             ps_co = ((tb_ct.Ps_co == null) ? 0 : tb_ct.Ps_co),
                             n_c = ((((tb_ct.Ps_no_nt == null) ? 0m : Convert.ToDecimal(tb_ct.Ps_no_nt)) != 0m || ((tb_ct.Ps_no == null) ? 0m : Convert.ToDecimal(tb_ct.Ps_no)) != 0m) ? "n" : "c")
                         };
            var source2 = from table in source
                          group table by new
                          {
                              table.nh_dk,
                              table.n_c
                          } into gbtable
                          select new
                          {
                              nh_dk = gbtable.Key.nh_dk,
                              n_c = gbtable.Key.n_c,
                              sbg = gbtable.Count(),
                              t_ps_no_nt = gbtable.Sum(p => (decimal)p.ps_no_nt),
                              t_ps_co_nt = gbtable.Sum(p => (decimal)p.ps_co_nt),
                              t_ps_no = gbtable.Sum(p => (decimal)p.ps_no),
                              t_ps_co = gbtable.Sum(p => (decimal)p.ps_co)
                          };
            var enumerable = from nn_nc in source2
                             where nn_nc.sbg > 1
                             group nn_nc by nn_nc.nh_dk into gb
                             select new
                             {
                                 nh_dk = gb.Key,
                                 sbg1 = gb.Count()
                             } into p
                             where p.sbg1 > 1
                             select p;
            if (enumerable.Count() > 0)
            {
                string text = string.Empty;
                foreach (var data in enumerable)
                {
                    text = text + data.nh_dk.ToString().Trim() + ", ";
                }
                Message = Lap["Có hạch toán nhiều nợ, nhiều có trong (các) nhóm định khoản"];
                myStateMN.SetNewThongbao(Message);
                flag = false;
            }
            if (flag)
            {
                var enumerable2 = from tk in source2
                                  group tk by tk.nh_dk into gb
                                  select new
                                  {
                                      nh_dk = gb.Key,
                                      sbg1 = gb.Count()
                                  } into p
                                  where p.sbg1 <= 1
                                  select p;
                if (enumerable2.Count() > 0)
                {
                    string text = string.Empty;
                    foreach (var data2 in enumerable2)
                    {
                        text = text + data2.nh_dk.ToString().Trim() + ", ";
                    }
                    Message = Lap["Chưa nhập đủ tk nợ, có trong (các) nhóm định khoản "];
                    myStateMN.SetNewThongbao(Message);
                    flag = false;
                }
            }
            if (flag)
            {
                var enumerable3 = from ps_nt in source2
                                  group ps_nt by ps_nt.nh_dk into gbps_nt
                                  select new
                                  {
                                      nh_dk = gbps_nt.Key,
                                      ps_nt = gbps_nt.Sum(p => p.t_ps_no_nt - p.t_ps_co_nt)
                                  } into p
                                  where p.ps_nt != 0m
                                  select p;
                if (enumerable3.Count() > 0)
                {
                    string text = string.Empty;
                    foreach (var data3 in enumerable3)
                    {
                        text = text + data3.nh_dk.ToString().Trim() + ", ";
                    }
                    Message = Lap["Phát sinh nợ khác phát sinh có trong (các) nhóm định khoản"];
                    myStateMN.SetNewThongbao(Message);
                    flag = false;
                }
            }
            if (flag)
            {
                var enumerable4 = from ps in source2
                                  group ps by ps.nh_dk into gbps
                                  select new
                                  {
                                      nh_dk = gbps.Key,
                                      ps = gbps.Sum(p => p.t_ps_no - p.t_ps_co)
                                  } into p
                                  where p.ps != 0m
                                  select p;
                if (enumerable4.Count() > 0)
                {
                    if (flag)
                    {
                        foreach (var kt2 in enumerable4)
                        {
                            var kt = kt2;
                            int num3 = (from tb in source2
                                        where tb.nh_dk.ToString() == kt.nh_dk.ToString() && tb.n_c == "n"
                                        select tb.sbg).First<int>();
                            bool flag2 = false;
                            if (num3 == 1)
                            {
                                int num4 = 0;
                                while (num4 < LSCt.Count && !flag2)
                                {
                                    decimal d = LSCt[num4].Ps_co;
                                    if (LSCt[num4].Nh_dk.ToString().TrimEnd(new char[0]) == kt.nh_dk.ToString())
                                    {
                                        if (CurPh.Ty_gia != 1)
                                        {
                                            if (LSCt[num4].Ps_co_nt != 0m)
                                            {
                                                LSCt[num4].Ps_co = d + kt.ps;
                                                flag2 = true;
                                            }
                                        }
                                        else
                                        {
                                            LSCt[num4].Ps_co = d + kt.ps;
                                            flag2 = true;
                                        }
                                    }
                                    num4++;
                                }
                            }
                            else
                            {
                                int num4 = 0;
                                while (num4 < LSCt.Count && !flag2)
                                {
                                    decimal d2 = LSCt[num4].Ps_no;

                                    if (LSCt[num4].Nh_dk.ToString().TrimEnd(new char[0]) == kt.nh_dk.ToString())
                                    {
                                        if (CurPh.Ty_gia != 1)
                                        {
                                            if (LSCt[num4].Ps_no_nt != 0m)
                                            {
                                                LSCt[num4].Ps_no = d2 + kt.ps;
                                                flag2 = true;
                                            }
                                        }
                                        else
                                        {
                                            LSCt[num4].Ps_no = d2 + kt.ps;
                                            flag2 = true;
                                        }
                                    }
                                    num4++;
                                }
                            }
                        }
                    }
                }
            }
            if (LSCtgt.Count > 0 && flag)
            {
                int num5 = 0;
                bool flag3 = false;
                foreach (Ct11gt ct11gt in LSCtgt)
                {

                    if (string.IsNullOrEmpty(ct11gt.Ma_ms.ToString().Trim()))
                    {
                        LSCtgt.Remove(ct11gt);
                    }
                    else
                    {
                        ct11gt.Ma_ct = CurPh.Ma_ct;
                        ct11gt.Ngay_ct = CurPh.Ngay_ct;
                        ct11gt.Ma_nt = CurPh.Ma_nt;
                        ct11gt.Ty_gia = CurPh.Ty_gia;
                        ct11gt.Ty_giaf = CurPh.Ty_giaf;
                        ct11gt.Status = CurPh.Status;
                        ct11gt.Ma_gd = CurPh.Ma_gd;
                        ct11gt.So_ct = CurPh.So_ct;
                        if (string.IsNullOrEmpty(ct11gt.Ma_ms.ToString().Trim()) && flag)
                        {
                            Message = Lap["Chưa vào nhóm"];
                            myStateMN.SetNewThongbao(Message);
                        }

                    }
                }
            }
            if (flag)
            {
                var source3 = from tb_ct in LSCt
                              where tb_ct.Stt_rec.ToString() == stt_rec && ((tb_ct.Ps_no == null) ? 0m : Convert.ToDecimal(tb_ct.Ps_no.ToString())) != 0m
                              select new
                              {
                                  tk = tb_ct.Tk_i.ToString().Trim(),
                                  ps_no = ((tb_ct.Ps_no == null) ? 0 : tb_ct.Ps_no)
                              };

                var GroupByCtRows = from ct in source3
                                    group ct by ct.tk into gbct
                                    select new
                                    {
                                        tk = gbct.Key.ToString().Trim(),
                                        t_ps_no = gbct.Sum(p => (decimal?)p.ps_no)
                                    };
                var CtgtRows = from tb_ctgt in LSCtgt
                               where tb_ctgt.Stt_rec.ToString() == stt_rec && !string.IsNullOrEmpty(tb_ctgt.Tk_thue_no?.Trim()) && tb_ctgt.Ma_thue?.Trim() != "KT"
                               // && ((tb_ctgt.T_thue == null) ? 0m : Convert.ToDecimal(tb_ctgt.T_thue.ToString())) != 0m
                               group tb_ctgt by tb_ctgt.Tk_thue_no.ToString().Trim() into gbctgt
                               select new
                               {
                                   tk_thue = gbctgt.Key.ToString().Trim(),
                                   t_thue = gbctgt.Sum(p => p.T_thue)

                               };

                // Kiểm tra nếu có thuế trong bảng kê nhưng không có trong chứng từ
                var source4 = from rowct in GroupByCtRows
                              from rowctgt in CtgtRows
                              where rowct.tk.Trim() == rowctgt.tk_thue.Trim() && rowct.t_ps_no != rowctgt.t_thue
                              select new
                              {
                                  rowct.tk,
                                  rowct.t_ps_no
                              };

                // Kiểm tra nếu có tài khoản thuế trong bảng kê nhưng không có trong chứng từ
                var missingTaxAccounts = CtgtRows.Where(x => !GroupByCtRows.Any(y => y.tk == x.tk_thue));

                // // Kiểm tra nếu có tài khoản trong chứng từ nhưng không có trong bảng kê thuế
                // var missingInTaxTable = GroupByCtRows.Where(x => !CtgtRows.Any(y => y.tk_thue == x.tk));

                // if (source4.Count() > 0 || missingTaxAccounts.Any())
                // {
                //     Message = Lap["Thuế bảng kê khác thuế trong chứng từ, không lưu được!"];
                //     myStateMN.SetNewThongbao(Message);
                //     flag = false;
                // }
                if (source4.Count() > 0)
                {
                    Message = Lap["Thuế bảng kê khác thuế trong chứng từ, không lưu được!"];
                    myStateMN.SetNewThongbao(Message);
                    flag = false;
                }
            }
        }
        return flag;

    }

    private async void OnPrint()
    {
        LSData = new List<PK1Model>();
        PK1Model _curModel = new PK1Model();
        _curModel.LSPh = new List<Ph11>();
        _curModel.LSPh.Add(CurPh);
        _curModel.LSCt = LSCt;
        foreach (var item in _curModel.LSCt)
        {
            item.Stt = Convert.ToInt32(item.Stt_rec0);
        }
        _curModel.LSCtgt = LSCtgt;      
        _curModel.TotalStringVi = DocSo.Doc_so(_curModel.LSCt.Sum(a => a.Ps_no), myOption, myDb, false, M_ma_nt0);
        _curModel.TotalStringEn = DocSo.Doc_so(_curModel.LSCt.Sum(a => a.Ps_no), myOption, myDb, true, M_ma_nt0);
        _curModel.TotalStringVi_nt = DocSo.Doc_so(_curModel.LSCt.Sum(a => a.Ps_no_nt), myOption, myDb, false, _curModel.LSPh[0].Ma_nt);
        _curModel.TotalStringEn_nt = DocSo.Doc_so(_curModel.LSCt.Sum(a => a.Ps_no_nt), myOption, myDb, true, _curModel.LSPh[0].Ma_nt);

        LSData.Add(_curModel);
        IsShowVoucher = false;
        StateHasChanged();
    }
    private async void OnPrintBack()
    {
        IsShowVoucher = true;
