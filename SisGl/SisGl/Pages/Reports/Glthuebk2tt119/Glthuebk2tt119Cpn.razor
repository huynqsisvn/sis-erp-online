    async Task Loaddata()
    {
        try
        {
            if (curCommand != null)
            {
                sFieldArrays = !IsLangEn
                    ? (Mau_bc != 0 ? curCommand.Vbrowse2 : curCommand.Vbrowse1)
                    : (Mau_bc != 0 ? curCommand.Ebrowse2 : curCommand.Ebrowse1);

                if (sFieldArrays != null && sFieldArrays.Length > 0)
                    Fbrowse = sFieldArrays;
            }
            string maDvcs = myStateMN.GetDvcs().Ma_dvcs?.Trim();
            maDvcs = (string.IsNullOrEmpty(maDvcs) || maDvcs == "ALL") ? "" : maDvcs;

            string maThueSql = string.Join(",",
                Ma_thue.Split(',', StringSplitOptions.RemoveEmptyEntries)
                       .Select(x => $"'{x.Trim()}'"));
            string condition =
                $" and 1=1 " +
                $"and ma_dvcs like '{maDvcs}%' " +
                $"and ma_thue in ({maThueSql})";
            string paramName = "@StartDate;@EndDate;@Nhom_ct;@Condition";

            string paramValue =
                $"{Ngay_ct1:yyyyMMdd};" +
                $"{Ngay_ct2:yyyyMMdd};" +
                $"{Nhom_ct};" +
                $"{condition}";

            string store = curCommand.Store_proc;

            var ds = await myDb.LoadStoreProcedure(store, paramName, paramValue);

            dsGlcd = new DataSet();

            if (ds != null && ds.Tables.Count > 0)
            {
                DataTable tbDetail = ds.Tables[0].Copy();
                tbDetail.TableName = "tbDetail";

                DataView dv = tbDetail.DefaultView;
                dv.RowFilter = "thong_tu LIKE '%119%'";

                TblData = dv.ToTable();
                dsGlcd.Tables.Add(TblData);
            }
            else
            {
                TblData = new DataTable();
            }
            if (TblData.Rows.Count > 0)
            {
                string colNo = TblData.Columns.Contains("ps_no") ? "ps_no"
                             : TblData.Columns.Contains("ds") ? "ds" : "";

                string colCo = TblData.Columns.Contains("ps_co") ? "ps_co"
                             : TblData.Columns.Contains("thue") ? "thue" : "";

                if (!string.IsNullOrEmpty(colNo))
                    TongPsNo = TblData.Compute($"SUM({colNo})", "") is DBNull
                                ? 0m : Convert.ToDecimal(TblData.Compute($"SUM({colNo})", ""));

                if (!string.IsNullOrEmpty(colCo))
                    TongPsCo = TblData.Compute($"SUM({colCo})", "") is DBNull
                                ? 0m : Convert.ToDecimal(TblData.Compute($"SUM({colCo})", ""));
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error Loaddata GLTHUEBK2TT119: " + ex);
        }
    }



