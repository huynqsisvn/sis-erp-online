    private async Task oBrowse_F5()
    {
        if (TblData == null || TblData.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao("Không có dữ liệu để xuất Excel HTKK.");
            return;
        }

        try
        {
            string templateFileName = "GLTHUEBK2TT119.xlsx";
            string relativePath = $"EX_mau/{templateFileName}";
            Uri fullUri = Navigation.ToAbsoluteUri(relativePath);
            var templateBytes = await Http.GetByteArrayAsync(fullUri.ToString());

            using var memoryStream = new MemoryStream(templateBytes);
            using var workbook = new ClosedXML.Excel.XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheet(1);

            worksheet.Column(3).Hide(); // C
            worksheet.Column(4).Hide(); // D
            worksheet.Column(9).Hide(); // I (ten_vt)

            int rowIndex = 17; 

            decimal tongTienNhom = 0m;
            decimal tongThueNhom = 0m;

            bool daGhiTieuDe1 = false, daGhiTong1 = false;
            bool daGhiTieuDe2 = false, daGhiTong2 = false;
            bool daGhiTieuDe3 = false, daGhiTong3 = false;
            bool daGhiTieuDe4 = false, daGhiTong4 = false;
            bool daGhiTieuDe5 = false;

            var dataRows = TblData.AsEnumerable()
                .Where(r => r["bold"] == DBNull.Value || r["bold"].ToString().Trim() != "1")
                .ToList();

            var existingGroups = dataRows
                .Select(r => r["ma_nh"]?.ToString()?.Trim())
                .Where(m => !string.IsNullOrEmpty(m))
                .Select(int.Parse)
                .Where(g => g >= 1 && g <= 5)
                .ToHashSet();

            for (int grp = 1; grp <= 4; grp++)
            {
                if (!existingGroups.Contains(grp))
                {
                    DataRow fakeRow = TblData.NewRow();
                    fakeRow["stt"] = 1;
                    fakeRow["kh_mau_hd"] = "";
                    fakeRow["so_seri"] = "";
                    fakeRow["so_ct0"] = "";
                    fakeRow["ngay_ct0"] = DBNull.Value; // sẽ hiển thị "  /  /    "
                    fakeRow["ten_kh"] = "";
                    fakeRow["ma_so_thue"] = "";
                    fakeRow["ten_vt"] = "";
                    fakeRow["t_tien2"] = 0m;
                    fakeRow["t_thue"] = 0m;
                    fakeRow["ghi_chu"] = "";
                    fakeRow["ma_nh"] = grp.ToString();
                    dataRows.Add(fakeRow);
                }
            }

            dataRows = dataRows.OrderBy(r => int.Parse(r["ma_nh"]?.ToString()?.Trim() ?? "0")).ToList();

            foreach (DataRow r in dataRows)
            {
                string maNhStr = r["ma_nh"]?.ToString()?.Trim() ?? "";
                if (!int.TryParse(maNhStr, out int maNh) || maNh < 1 || maNh > 5)
                    continue;

                string tieuDeNhom = maNh switch
                {
                    1 => "Hàng hóa, dịch vụ không chịu thuế giá trị gia tăng (GTGT)",
                    2 => "Hàng hóa, dịch vụ chịu thuế suất thuế GTGT 0%",
                    3 => "Hàng hóa, dịch vụ chịu thuế suất thuế GTGT 5%",
                    4 => "Hàng hóa, dịch vụ chịu thuế suất thuế GTGT 10%",
                    5 => "Hàng hóa, dịch vụ không phải tổng hợp trên tờ khai 01/GTGT",
                    _ => ""
                };

                if (maNh == 1)
                {
                    if (!daGhiTieuDe1)
                    {
                        worksheet.Cell(rowIndex, 2).Value = $"1. {tieuDeNhom}:";
                        rowIndex++;
                        daGhiTieuDe1 = true;
                    }
                    GhiDongChiTiet(worksheet, rowIndex, r);
                    CongTong(r, ref tongTienNhom, ref tongThueNhom);
                    rowIndex++;
                }
                else if (maNh == 2)
                {
                    if (!daGhiTong1)
                    {
                        GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom);
                        tongTienNhom = tongThueNhom = 0m;
                        rowIndex++;
                        daGhiTong1 = true;
                    }
                    if (!daGhiTieuDe2)
                    {
                        worksheet.Cell(rowIndex, 2).Value = $"2. {tieuDeNhom}:";
                        rowIndex++;
                        daGhiTieuDe2 = true;
                    }
                    GhiDongChiTiet(worksheet, rowIndex, r);
                    CongTong(r, ref tongTienNhom, ref tongThueNhom);
                    rowIndex++;
                }
                else if (maNh == 3)
                {
                    if (!daGhiTong2)
                    {
                        GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom);
                        tongTienNhom = tongThueNhom = 0m;
                        rowIndex++;
                        daGhiTong2 = true;
                    }
                    if (!daGhiTieuDe3)
                    {
                        worksheet.Cell(rowIndex, 2).Value = $"3. {tieuDeNhom}:";
                        rowIndex++;
                        daGhiTieuDe3 = true;
                    }
                    GhiDongChiTiet(worksheet, rowIndex, r);
                    CongTong(r, ref tongTienNhom, ref tongThueNhom);
                    rowIndex++;
                }
                else if (maNh == 4)
                {
                    if (!daGhiTong3)
                    {
                        GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom);
                        tongTienNhom = tongThueNhom = 0m;
                        rowIndex++;
                        daGhiTong3 = true;
                    }
                    if (!daGhiTieuDe4)
                    {
                        worksheet.Cell(rowIndex, 2).Value = $"4. {tieuDeNhom}:";
                        rowIndex++;
                        daGhiTieuDe4 = true;
                    }
                    GhiDongChiTiet(worksheet, rowIndex, r);
                    CongTong(r, ref tongTienNhom, ref tongThueNhom);
                    rowIndex++;
                }
                else if (maNh == 5)
                {
                    if (!daGhiTong4)
                    {
                        GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom);
                        tongTienNhom = tongThueNhom = 0m;
                        rowIndex++;
                        daGhiTong4 = true;
                    }
                    if (!daGhiTieuDe5)
                    {
                        worksheet.Cell(rowIndex, 2).Value = "5. Hàng hóa, dịch vụ không phải tổng hợp trên tờ khai 01/GTGT:";
                        worksheet.Row(rowIndex).Hide();
                        rowIndex++;
                        daGhiTieuDe5 = true;
                    }
                    GhiDongChiTiet(worksheet, rowIndex, r);
                    worksheet.Row(rowIndex).Hide();
                    CongTong(r, ref tongTienNhom, ref tongThueNhom);
                    rowIndex++;
                }
            }

            if (daGhiTieuDe1 && !daGhiTong1) { GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom); rowIndex++; }
            else if (daGhiTieuDe2 && !daGhiTong2) { GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom); rowIndex++; }
            else if (daGhiTieuDe3 && !daGhiTong3) { GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom); rowIndex++; }
            else if (daGhiTieuDe4 && !daGhiTong4) { GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom); rowIndex++; }

            // Tổng chung cuối cùng
            GhiDongTong(worksheet, rowIndex, tongTienNhom, tongThueNhom);
            rowIndex++;

            if (!daGhiTieuDe5)
            {
                worksheet.Cell(rowIndex, 2).Value = "5. Hàng hóa, dịch vụ không phải tổng hợp trên tờ khai 01/GTGT:";
                worksheet.Row(rowIndex).Hide();
                rowIndex++;

                worksheet.Cell(rowIndex, 2).Value = "Tổng";
                worksheet.Cell(rowIndex, 10).Value = 0m;
                worksheet.Cell(rowIndex, 11).Value = 0m;
                worksheet.Row(rowIndex).Hide();
                worksheet.Cell(rowIndex, 10).Style.NumberFormat.Format = "#,##0";
                worksheet.Cell(rowIndex, 11).Style.NumberFormat.Format = "#,##0";
            }

            // Lưu và download
            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            string base64 = Convert.ToBase64String(stream.ToArray());
            string fileName = $"BangKe_GTGT_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
            myStateMN.SetNewThongbao("Xuất Excel HTKK thành công! Giống hệt bản WinForms.");
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi xuất Excel HTKK: " + ex.Message);
        }
    }

    private void GhiDongChiTiet(ClosedXML.Excel.IXLWorksheet ws, int row, DataRow r)
    {
        object[] values = new object[]
        {
        r["stt"] ?? "",
        r["kh_mau_hd"] ?? "",
        r["so_seri"] ?? "",
        r["so_ct0"] ?? "",
        r["ngay_ct0"] is DateTime dt ? dt.ToString("dd/MM/yyyy") : "  /  /    ",
        r["ten_kh"] ?? "",
        r["ma_so_thue"] ?? "",
        r["ten_vt"] ?? "",
        r["t_tien2"] ?? 0m,
        r["t_thue"] ?? 0m,
        r["ghi_chu"] ?? ""
        };

        for (int i = 0; i < values.Length; i++)
        {
            var cell = ws.Cell(row, i + 2); 
            if (values[i] is decimal || values[i] is double || values[i] is int || values[i] is long)
            {
                cell.Value = Convert.ToDecimal(values[i]);
                cell.Style.NumberFormat.Format = "#,##0";
            }
            else
            {
                cell.Value = values[i]?.ToString() ?? "";
            }
        }
    }

    private void GhiDongTong(ClosedXML.Excel.IXLWorksheet ws, int row, decimal tien, decimal thue)
    {
        ws.Cell(row, 2).Value = "Tổng";
        ws.Cell(row, 10).Value = tien;
        ws.Cell(row, 11).Value = thue;
        ws.Cell(row, 10).Style.NumberFormat.Format = "#,##0";
        ws.Cell(row, 11).Style.NumberFormat.Format = "#,##0";
    }

    private void CongTong(DataRow r, ref decimal tongTien, ref decimal tongThue)
    {
        if (r["t_tien2"] != DBNull.Value) tongTien += Convert.ToDecimal(r["t_tien2"]);
        if (r["t_thue"] != DBNull.Value) tongThue += Convert.ToDecimal(r["t_thue"]);
    }

