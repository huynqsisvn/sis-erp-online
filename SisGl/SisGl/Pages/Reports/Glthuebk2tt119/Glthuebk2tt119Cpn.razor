<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="500px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <DxFormLayout CssClass="w-100 p-3">
                <DxFormLayoutItem Caption="@Lap["Năm"]" ColSpanMd="12">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="Nam"
                                @onblur="HandleYearLostFocus"
                                Min="1900"
                                Max="2078"  
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Từ tháng"]">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="ThangTu"
                                @bind-Value:after="OnThangTuChanged"
                                Min="1" Max="12"
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Đến tháng"]">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="ThangDen"
                                @bind-Value:after="OnThangDenChanged"
                                Min="1" Max="12"
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                    <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                InputId="idTu_Ngay" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                    <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                InputId="idDen_ngay" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mã thuế suất (F11)"]">
                    <DxTextBox @bind-Text="Ma_thue" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Nhóm số liệu"]">
                    <DxComboBox Data="@StatusList1" @bind-Value="Nhom_ct" ValueFieldName="Value" TextFieldName="Text" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report template"]">
                    <DxComboBox Data="@LstMauBC" @bind-Value="Mau_bc" ValueFieldName="Value" TextFieldName="Text" />
                </DxFormLayoutItem>
            </DxFormLayout>

            @if (Errors.Any())
            {
                <div class="mt-2 alert alert-danger p-2 mx-3">
                    <ul class="mb-0">
                        @foreach (var err in Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }
    </BodyTemplate>

    <FooterTemplate Context="footerContext">
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end p-2">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>
