    private class HtkkRow
    {
        public string loai_hd_thue { get; set; } = "";
        public string kh_mau_hd { get; set; } = "";
        public string so_seri { get; set; } = "";
        public string so_ct { get; set; } = "";
        public object ngay_lct { get; set; }
        public string ten_kh { get; set; } = "";
        public string ma_so_thue { get; set; } = "";
        public string ten_vt { get; set; } = "";
        public object t_tien2 { get; set; }
        public object t_thue { get; set; }
        public string ghi_chu { get; set; } = "";
    }
    private string GenerateBangKeXml(DataTable data)
    {
        var lines = new List<string>();
        lines.Add("<!-- edited with XML Spy v4.1 U[](http://www.xmlspy.com) by CMCSoft-->");
        lines.Add("<!DOCTYPE Sections SYSTEM \"..\\..\\InterfaceTemplates\\Schema.dtd\">");
        lines.Add("<Sections Version=\"321\">");

        int stt = 7;

        // Lấy danh sách stt_in duy nhất (giống WinForms)
        var rowStt_in = data.AsEnumerable()
            .Where(r => r["stt_in"] != DBNull.Value && !string.IsNullOrEmpty(r["stt_in"].ToString().Trim()))
            .GroupBy(r => r["stt_in"])
            .Select(g => g.Key)
            .ToList();

        // Duyệt từng nhóm stt_in
        for (int i = 0; i < rowStt_in.Count; i++)
        {
            if (i != 0)
                stt += 4; // cách 4 dòng giữa các section (giống WinForms)

            var list = data.AsEnumerable()
                .Where(r => ParseInt(r["stt_in"]) == ParseInt(rowStt_in[i]) &&
                            (r["bold"] == DBNull.Value || r["bold"].ToString().Trim() != "1"))
                .Select(r => new HtkkRow
                {
                    loai_hd_thue = r["loai_hd_thue"]?.ToString() ?? "",
                    kh_mau_hd = r["kh_mau_hd"]?.ToString() ?? "",
                    so_seri = r["so_seri"]?.ToString() ?? "",
                    so_ct = r["so_ct0"]?.ToString() ?? "",
                    ngay_lct = r["ngay_ct0"],
                    ten_kh = r["ten_kh"]?.ToString() ?? "",
                    ma_so_thue = r["ma_so_thue"]?.ToString() ?? "",
                    ten_vt = r["ten_vt"]?.ToString() ?? "",
                    t_tien2 = r["t_tien2"],
                    t_thue = r["t_thue"],
                    ghi_chu = r["ghi_chu"]?.ToString() ?? ""
                })
                .ToList();

            if (list.Count == 0)
            {
                WriteEmptySectionRow(ref stt, lines, "#");
            }
            else
            {
                bool isFirst = true;
                lines.Add("<Section Dynamic=\"1\" MaxRows=\"0\">");

                foreach (var item in list)
                {
                    lines.Add("<Cells>");
                    stt++;

                    string firstAttr = isFirst ? " FirstCell=\"0\"" : " FirstCell=\"1\"";
                    isFirst = false;

                    lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" Encode=\"0\" Receive=\"1\" Value=\"{EscapeXml(item.loai_hd_thue)}\" StatusID=\"0001\"{firstAttr}/>");
                    lines.Add(GetValue(stt, item.kh_mau_hd, 0, "", "D", "C"));
                    lines.Add(GetValue(stt, item.so_seri, 0, "", "E", "E"));
                    lines.Add(GetValue(stt, item.so_ct, 0, "", "F", "G"));
                    lines.Add(GetValue(stt, item.ngay_lct, 3, "", "G", "M"));
                    lines.Add(GetValue(stt, item.ten_kh, 0, "", "H", "R"));
                    lines.Add(GetValue(stt, item.ma_so_thue, 0, "", "I", "X"));
                    lines.Add(GetValue(stt, item.ten_vt, 0, "", "J", "AB"));
                    lines.Add(GetValue(stt, item.t_tien2, 1, "#", "K", "AF"));
                    lines.Add(GetValue(stt, item.t_thue, 1, "#", "M", "AN"));
                    lines.Add(GetValue(stt, item.ghi_chu, 0, "", "N", "AR"));

                    lines.Add("</Cells>");
                }

                lines.Add("</Section>");
            }
        }

        int emptyStt = stt + 4;
        WriteEmptySectionRow(ref emptyStt, lines, "#");

        lines.Add("<Section Dynamic=\"0\" MaxRows=\"0\">");
        lines.Add("<Cells>");

        int sumRow = emptyStt + 5; 

        decimal tongTien2 = SumFunction(data, 1);
        decimal tongThue = SumFunction(data, 3);

        string strTien2 = tongTien2 == 0 ? "0" : tongTien2.ToString("#");
        string strThue = tongThue == 0 ? "0" : tongThue.ToString("#");

        lines.Add($"<Cell CellID=\"H_{sumRow}\" CellID2=\"V_{sumRow + 10}\" Encode=\"1\" Value=\"0\"/>");
        lines.Add($"<Cell CellID=\"H_{sumRow + 1}\" CellID2=\"V_{sumRow + 12}\" Encode=\"1\" Value=\"{strTien2}\"/>");
        lines.Add($"<Cell CellID=\"H_{sumRow + 2}\" CellID2=\"V_{sumRow + 14}\" Encode=\"1\" Value=\"{strThue}\"/>");

        lines.Add("</Cells>");
        lines.Add("</Section>");

        lines.Add("</Sections>");

        return string.Join("\r\n", lines);
    }

    private int ParseInt(object value)
    {
        if (value == null || value is DBNull || string.IsNullOrEmpty(value.ToString()))
            return 0;
        return Convert.ToInt32(value);
    }

    private decimal SumFunction(DataTable datatable, int loai)
    {
        decimal sum = 0;
        foreach (DataRow row in datatable.Rows)
        {
            string ma_thue = row["ma_thue"]?.ToString().Trim() ?? "";
            if ((ma_thue == "00" || ma_thue == "05" || ma_thue == "10" || ma_thue == "KT"))
            {
                if (loai == 1 || loai == 2) 
                {
                    if (row["t_tien2"] != DBNull.Value && !string.IsNullOrEmpty(row["t_tien2"].ToString().Trim()))
                        sum += Convert.ToDecimal(row["t_tien2"]);
                }
                if (loai == 3) 
                {
                    if (row["t_thue"] != DBNull.Value && !string.IsNullOrEmpty(row["t_thue"].ToString().Trim()))
                        sum += Convert.ToDecimal(row["t_thue"]);
                }
            }
        }
        return sum;
    }
    private string GetValue(int stt, object value, int type, string formatTien, string cell, string cell2)
    {
        string baseStart = $"<Cell CellID=\"{cell}_{stt}\" CellID2=\"{cell2}_{stt + 10}\" Encode=\"1\" Receive=\"1\" Value=\"";
        string baseEnd = "\" StatusID=\"0001\"/>";

        string val = "";

        switch (type)
        {
            case 0: 
                val = EscapeXml(value?.ToString().Trim() ?? "");
                break;
            case 1: 
                if (value == null || value is DBNull || string.IsNullOrEmpty(value.ToString()))
                {
                    val = "0";
                }
                else
                {
                    decimal num = Convert.ToDecimal(value);
                    val = num == 0 ? "0" : num.ToString(formatTien);
                }
                break;
            case 3: 
                if (value is DateTime dt)
                {
                    val = dt.ToString("dd/MM/yyyy");
                }
                else
                {
                    val = "";
                }
                break;
            default:
                val = "";
                break;
        }

        return baseStart + val + baseEnd;
    }

    private string EscapeXml(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\"", "&quot;")
            .Replace("'", "&apos;");
    }
    private void WriteEmptySectionRow(ref int stt, List<string> lines, string formatTien = "#")
    {
        lines.Add("<Section Dynamic=\"1\" MaxRows=\"0\">");
        lines.Add("<Cells>");
        stt++; 

        lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" FirstCell=\"0\" Encode=\"0\" Receive=\"1\" Value=\"\" StatusID=\"0001\"/>");
        lines.Add(GetValue(stt, "", 0, formatTien, "D", "C"));
        lines.Add(GetValue(stt, "", 0, formatTien, "E", "E"));
        lines.Add(GetValue(stt, "", 0, formatTien, "F", "G"));
        lines.Add(GetValue(stt, "", 3, formatTien, "G", "M"));
        lines.Add(GetValue(stt, "", 0, formatTien, "H", "R"));
        lines.Add(GetValue(stt, "", 0, formatTien, "I", "X"));
        lines.Add(GetValue(stt, "", 0, formatTien, "J", "AB"));
        lines.Add(GetValue(stt, 0, 1, formatTien, "K", "AF"));
        lines.Add(GetValue(stt, 0, 1, formatTien, "M", "AN"));
        lines.Add(GetValue(stt, "", 0, formatTien, "N", "AR"));

        lines.Add("</Cells>");
        lines.Add("</Section>");
    }

    private void WriteEmptySectionRow(ref int stt, List<string> lines)
    {
        lines.Add("<Cells>");
        stt++;

        lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" FirstCell=\"0\" Encode=\"0\" Receive=\"1\" Value=\"\" StatusID=\"0001\"/>");
        lines.Add(GetCell(stt, "", 0, "D", "C"));
        lines.Add(GetCell(stt, "", 0, "E", "E"));
        lines.Add(GetCell(stt, "", 0, "F", "G"));
        lines.Add(GetCell(stt, "", 3, "G", "M"));
        lines.Add(GetCell(stt, "", 0, "H", "R"));
        lines.Add(GetCell(stt, "", 0, "I", "X"));
        lines.Add(GetCell(stt, "", 0, "J", "AB"));
        lines.Add(GetCell(stt, 0, 1, "K", "AF"));
        lines.Add(GetCell(stt, 0, 1, "M", "AN"));
        lines.Add(GetCell(stt, "", 0, "N", "AR"));

        lines.Add("</Cells>");
    }

    private string GetCell(int stt, object value, int type, string col1, string col2)
    {
        string val = "";
        switch (type)
        {
            case 0: // text
                val = EscapeXml(value?.ToString().Trim() ?? "");
                break;
            case 1: // số
                if (value == null || value == DBNull.Value || string.IsNullOrEmpty(value.ToString()))
                    val = "0";
                else
                    val = Math.Round(Convert.ToDecimal(value), 0).ToString("0");
                break;
            case 3: // ngày
                if (value is DateTime dt)
                    val = dt.ToString("dd/MM/yyyy");
                else
                    val = "";
                break;
        }

        return $"<Cell CellID=\"{col1}_{stt}\" CellID2=\"{col2}_{stt + 10}\" Encode=\"1\" Receive=\"1\" Value=\"{val}\" StatusID=\"0001\"/>";
    }


