<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="500px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <DxFormLayout CssClass="w-100 p-3">
                <DxFormLayoutItem Caption="@Lap["Năm"]" ColSpanMd="12">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="Nam"
                                @onblur="HandleYearLostFocus"
                                Min="1900"
                                Max="2078"  
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Từ tháng"]">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="ThangTu"
                                @bind-Value:after="OnThangTuChanged"
                                Min="1" Max="12"
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Đến tháng"]">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="ThangDen"
                                @bind-Value:after="OnThangDenChanged"
                                Min="1" Max="12"
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From date"]">
                    <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                InputId="idTu_Ngay" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To date"]">
                    <DxDateEdit CssClass="col" @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                InputId="idDen_ngay" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mã nhóm hđ TT119 (F11)"]">
                    <DxTextBox @bind-Text="Ma_tc" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sắp xếp số liệu"]">
                    <DxComboBox Data="@StatusList1" @bind-Value="Nhom_ct" ValueFieldName="Value" TextFieldName="Text" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Mẫu báo cáo"]">
                    <DxComboBox Data="@LstMauBC" @bind-Value="Mau_bc" ValueFieldName="Value" TextFieldName="Text" />
                </DxFormLayoutItem>
            </DxFormLayout>

            @if (Errors.Any())
            {
                <div class="mt-2 alert alert-danger p-2 mx-3">
                    <ul class="mb-0">
                        @foreach (var err in Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }
    </BodyTemplate>

    <FooterTemplate Context="footerContext">
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end p-2">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>
<DxPopup @bind-Visible="@ShowXmlPopup"
         HeaderText="Xuất XML"
         Width="600px"
         Height="200px"
         ShowFooter="true"
         CloseOnOutsideClick="false">
    <BodyTemplate>
        <div class="p-3">
            <div class="row mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="fw-bold">Tên file gợi ý:</label>
                </div>
                <div class="col-8">
                    <DxTextBox Text="@DisplayFileName" ReadOnly="true" />
                </div>
            </div> 
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex justify-content-end p-2 gap-2">
            <DxButton Text="Xuất XML"
                      RenderStyle="ButtonRenderStyle.Success"
                      Click="@ExecuteExportXml" />
            <DxButton Text="Hủy"
                      RenderStyle="ButtonRenderStyle.Danger"
                      Click="@(() => ShowXmlPopup = false)" />
        </div>
    </FooterTemplate>
</DxPopup>

<DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup" @bind-Visible="@ShowPrint" Width="80%" Height="90%" ShowFooter="false" Context="windowContext" HeaderText="@Lap["Printer"]">
