            <ReportOptionComponent LSItems="@LsData" Menu_id="@Menu_id.Replace('_', '.')" OnBack="@(() => { ShowPrint = false; StateHasChanged(); })"></ReportOptionComponent>
        </BodyTemplate>
</DxPopup>

<script>
    window.downloadFile = (fileName, base64Content) => {
        const link = document.createElement('a');
        link.href = 'data:application/octet-stream;base64,' + base64Content;
        link.download = fileName;
        link.click();
    };

    document.addEventListener('keydown', function(e) {
        if (e.key === 'F5' || e.code === 'F5') {
            DotNet.invokeMethodAsync('YourProjectName', 'TriggerF5')
                .then(() => {
                    e.preventDefault();
                });
        }
    });
</script>
