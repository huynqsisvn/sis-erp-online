    private static void SetCellValue(IXLCell cell, object value)
    {
        if (value == null || value == DBNull.Value)
        {
            cell.Clear();
            return;
        }

        if (value is decimal dec)
        {
            cell.SetValue(dec);
            cell.Style.NumberFormat.Format = "#,##0";
        }
        else if (value is double dbl)
        {
            cell.SetValue(dbl);
            cell.Style.NumberFormat.Format = "#,##0";
        }
        else if (value is int i)
        {
            cell.SetValue(i);
        }
        else if (value is DateTime dt)
        {
            cell.SetValue(dt);
            cell.Style.DateFormat.Format = "dd/MM/yyyy";
        }
        else
        {
            cell.SetValue(value.ToString().Trim());
        }
    }

    private async Task oBrowse_F5()
    {
        if (TblData == null || TblData.Rows.Count == 0)
        {
            myStateMN.SetNewThongbao("Không có dữ liệu để xuất Excel HTKK.");
            return;
        }

        try
        {
            string templateFileName = "Glthuebk3tt119.xlsx";
            Uri uri = Navigation.ToAbsoluteUri($"EX_mau/{templateFileName}");
            byte[] templateBytes = await Http.GetByteArrayAsync(uri.ToString());

            using var ms = new MemoryStream(templateBytes);
            using var workbook = new ClosedXML.Excel.XLWorkbook(ms);
            var ws = workbook.Worksheet(1);
            ws.Column(3).Hide();
            ws.Column(4).Hide();
            ws.Column(9).Hide();
            ws.Column(11).Hide();

            int startRow = 17;

            for (int i = 0; i < TblData.Rows.Count; i++)
            {
                DataRow row = TblData.Rows[i];
                int excelRow = startRow + i;

                SetCellValue(ws.Cell(excelRow, 2), row[0]);
                SetCellValue(ws.Cell(excelRow, 3), row[1]);
                SetCellValue(ws.Cell(excelRow, 4), row[2]);
                SetCellValue(ws.Cell(excelRow, 5), row[3]);
                SetCellValue(ws.Cell(excelRow, 6), row[4]);
                SetCellValue(ws.Cell(excelRow, 7), row[5]);
                SetCellValue(ws.Cell(excelRow, 8), row[6]);
                SetCellValue(ws.Cell(excelRow, 9), row[7]);
                SetCellValue(ws.Cell(excelRow, 10), row[8]);
                SetCellValue(ws.Cell(excelRow, 11), row[9]);
                SetCellValue(ws.Cell(excelRow, 12), row[10]);
                SetCellValue(ws.Cell(excelRow, 13), row[11]);

                if (row.Table.Columns.Count > 16 &&
                    row[16]?.ToString()?.Trim() == "1")
                {
                    ws.Row(excelRow).Hide();
                }
            }

            using var outStream = new MemoryStream();
            workbook.SaveAs(outStream);

            string base64 = Convert.ToBase64String(outStream.ToArray());
            string fileName = $"GLTHUEBK3TT119_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
            myStateMN.SetNewThongbao("Xuất Excel HTKK thành công (chuẩn WinForms).");
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi xuất Excel HTKK: " + ex.Message);
        }
    }



    private void GhiDongChiTiet(ClosedXML.Excel.IXLWorksheet ws, int row, DataRow r)
