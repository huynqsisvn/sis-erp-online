    async Task<DataSet> GetMauBC(string ma_maubc)
    {
        string[] strArray = myOption.GetOptionsValue("M_MAU_TT_QD").ToString().Split(';');
        string str = "1=1";
        if (strArray.Length > 1)
            str = !(strArray[1].Trim() == "2") ? string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim()) : string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim());
        string cmdText = string.Format("SELECT file_maubc, ten_maubc, ten_maubc2, tt_qd, nh_bc, ma_maubc, [default] FROM {0} WHERE ma_maubc = '{1}' AND {2} ORDER BY [order]", (object)"dmmaubc", (object)ma_maubc, (object)str);
        DataSet ds = await myDb.LoadDataset(cmdText);
        return ds;
    }
    public string RemoveUnwantedColumns(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return input;

        // danh sách prefix cần loại bỏ
        string[] prefixes = new[]
        {
        "lk_", "ps_no1", "ps_co1", "no_dn", "co_dn", "ps_no_nt1", "ps_co_nt1"
    };

        // tách các nhóm cột theo ký tự '|'
        var groups = input.Split('|');

        for (int g = 0; g < groups.Length; g++)
        {
            var cols = groups[g].Split(';', StringSplitOptions.RemoveEmptyEntries);

            var filteredCols = cols.Where(col =>
            {
                var fieldName = col.Split(':')[0].Trim();
                return !prefixes.Any(p => fieldName.StartsWith(p, StringComparison.OrdinalIgnoreCase));
            });

            groups[g] = string.Join(";", filteredCols);
        }

        return string.Join("|", groups);
    }
