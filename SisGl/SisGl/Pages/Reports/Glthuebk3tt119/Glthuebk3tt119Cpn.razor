    private class HtkkRow
    {
        public string ma_so_hd { get; set; } = "";
        public string kh_mau_hd { get; set; } = "";
        public string so_seri0 { get; set; } = "";
        public string so_ct0 { get; set; } = "";
        public object ngay_ct0 { get; set; }
        public string ten_kh { get; set; } = "";
        public string ma_so_thue { get; set; } = "";
        public string ten_vt { get; set; } = "";
        public object t_tien { get; set; }
        public object thue_suat { get; set; }
        public object t_thue { get; set; }
        public string ghi_chu { get; set; } = "";
    }

    private string GenerateBangKeXml(DataTable data)
    {
        var lines = new List<string>();
        lines.Add("<!-- edited with XML Spy v4.1 U[](http://www.xmlspy.com) by CMCSoft-->");
        lines.Add("<!DOCTYPE Sections SYSTEM \"..\\..\\InterfaceTemplates\\Schema.dtd\">");
        lines.Add("<Sections Version=\"321\">");

        int stt = 7;
        string M_IP_TIEN = "#"; // Format tiền giống WinForms
        string[] groups = { "1", "3", "2", "4", "5" }; // Thứ tự cố định giống WinForms

        foreach (string ma_ms in groups)
        {
            if (lines.Count > 3) 
                stt += 4;

            var list = data.AsEnumerable()
                .Where(r => r["ma_ms"]?.ToString().Trim() == ma_ms &&
                            (r["bold"] == DBNull.Value || r["bold"].ToString().Trim() == "0"))
                .Select(r => new HtkkRow
                {
                    ma_so_hd = r["loai_hd_thue"]?.ToString() ?? "",
                    kh_mau_hd = r["kh_mau_hd"]?.ToString() ?? "",
                    so_seri0 = r["so_seri0"]?.ToString() ?? "",
                    so_ct0 = r["so_ct0"]?.ToString() ?? "",
                    ngay_ct0 = r["ngay_ct0"],
                    ten_kh = r["ten_kh"]?.ToString() ?? "",
                    ma_so_thue = r["ma_so_thue"]?.ToString() ?? "",
                    ten_vt = r["ten_vt"]?.ToString() ?? "",
                    t_tien = r["t_tien"],
                    thue_suat = r["thue_suat"],
                    t_thue = r["t_thue"],
                    ghi_chu = r["ghi_chu"]?.ToString() ?? ""
                })
                .ToList();

            // Logic giống hệt WinForms
            if (ma_ms == "1" || ma_ms == "2")
            {
                if (list.Count == 0)
                {
                    WriteEmptySection(ref stt, lines, M_IP_TIEN);
                }
                else
                {
                    WriteDataSection(ref stt, lines, list, M_IP_TIEN);
                }
            }
            else
            {
                if (list.Count == 0)
                {
                    WriteEmptySection(ref stt, lines, M_IP_TIEN);
                }
                else
                {
                    WriteDataSection(ref stt, lines, list, M_IP_TIEN);
                }
            }
        }

 
        decimal tongTien = SumColumn(data, "t_tien");
        decimal tongThue = SumColumn(data, "t_thue");

        string strTongTien = tongTien == 0 ? "0" : tongTien.ToString(M_IP_TIEN);
        string strTongThue = tongThue == 0 ? "0" : tongThue.ToString(M_IP_TIEN);

        int sumRow = stt + 13;

        lines.Add("<Section Dynamic=\"0\" MaxRows=\"0\">");
        lines.Add("<Cells>");
        lines.Add($"<Cell CellID=\"K_{sumRow}\" CellID2=\"AF_{sumRow + 6}\" Encode=\"1\" Value=\"{strTongTien}\"/>");
        lines.Add($"<Cell CellID=\"K_{sumRow + 1}\" CellID2=\"AF_{sumRow + 8}\" Encode=\"1\" Value=\"{strTongThue}\"/>");
        lines.Add("</Cells>");
        lines.Add("</Section>");

        lines.Add("</Sections>");

        return string.Join("\r\n", lines);
    }

    private void WriteDataSection(ref int stt, List<string> lines, List<HtkkRow> list, string M_IP_TIEN)
    {
        lines.Add("<Section Dynamic=\"1\" MaxRows=\"0\">");
        bool isFirst = true;

        foreach (var item in list)
        {
            lines.Add("<Cells>");
            stt++;

            string firstAttr = isFirst ? " FirstCell=\"0\"" : " FirstCell=\"1\"";
            isFirst = false;

            lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" Encode=\"0\" Receive=\"1\" Value=\"{EscapeXml(item.ma_so_hd)}\" StatusID=\"0001\"{firstAttr}/>");

            lines.Add(GetValue(stt, item.kh_mau_hd, 0, "", "D", "C"));
            lines.Add(GetValue(stt, item.so_seri0, 0, "", "E", "E"));
            lines.Add(GetValue(stt, item.so_ct0, 0, "", "F", "G"));
            lines.Add(GetValue(stt, item.ngay_ct0, 3, "", "G", "M"));
            lines.Add(GetValue(stt, item.ten_kh, 0, "", "H", "R"));
            lines.Add(GetValue(stt, item.ma_so_thue, 0, "", "I", "X"));
            lines.Add(GetValue(stt, item.ten_vt, 0, "", "J", "AB"));
            lines.Add(GetValue(stt, item.t_tien, 1, M_IP_TIEN, "K", "AF"));
            lines.Add(GetValue(stt, item.thue_suat, 2, M_IP_TIEN, "L", "AJ")); // Thuế suất
            lines.Add(GetValue(stt, item.t_thue, 1, M_IP_TIEN, "M", "AN"));
            lines.Add(GetValue(stt, item.ghi_chu, 0, "", "N", "AR"));

            lines.Add("</Cells>");
        }

        lines.Add("</Section>");
    }

    private void WriteEmptySection(ref int stt, List<string> lines, string M_IP_TIEN)
    {
        lines.Add("<Section Dynamic=\"1\" MaxRows=\"0\">");
        lines.Add("<Cells>");
        stt++;

        lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" FirstCell=\"0\" Encode=\"0\" Receive=\"1\" Value=\"\" StatusID=\"0001\"/>");

        lines.Add(GetValue(stt, "", 0, "", "D", "C"));
        lines.Add(GetValue(stt, "", 0, "", "E", "E"));
        lines.Add(GetValue(stt, "", 0, "", "F", "G"));
        lines.Add(GetValue(stt, "", 3, "", "G", "M")); // ngày trống
        lines.Add(GetValue(stt, "", 0, "", "H", "R"));
        lines.Add(GetValue(stt, "", 0, "", "I", "X"));
        lines.Add(GetValue(stt, "", 0, "", "J", "AB"));
        lines.Add(GetValue(stt, 0, 1, M_IP_TIEN, "K", "AF"));
        lines.Add(GetValue(stt, 0, 2, M_IP_TIEN, "L", "AJ")); // thuế suất = 0
        lines.Add(GetValue(stt, 0, 1, M_IP_TIEN, "M", "AN"));
        lines.Add(GetValue(stt, "", 0, "", "N", "AR"));

        lines.Add("</Cells>");
        lines.Add("</Section>");
    }

    private string GetValue(int stt, object value, int type, string M_IP_TIEN, string cell, string cell2)
    {
        string baseStart = $"<Cell CellID=\"{cell}_{stt}\" CellID2=\"{cell2}_{stt + 10}\" Encode=\"1\" Receive=\"1\" Value=\"";
        string baseEnd = "\" StatusID=\"0001\"/>";
        string val = "";

        switch (type)
        {
            case 0: // 
                val = EscapeXml(value?.ToString().Trim() ?? "");
                break;
            case 1: // số tiền
            case 2: // thuế suất
                if (value == null || value is DBNull || string.IsNullOrEmpty(value.ToString()))
                    val = "0";
                else
                {
                    decimal num = Convert.ToDecimal(value);
                    val = num == 0 ? "0" : num.ToString(M_IP_TIEN);
                }
                break;
            case 3: // ngày
                if (value is DateTime dt)
                    val = dt.ToString("dd/MM/yyyy");
                else
                    val = "";
                break;
        }

        return baseStart + val + baseEnd;
    }

    private decimal SumColumn(DataTable data, string columnName)
    {
        return data.AsEnumerable()
            .Sum(r => r.Field<decimal?>(columnName) ?? 0m);
    }

    private string EscapeXml(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\"", "&quot;")
            .Replace("'", "&apos;");
    }
    private void WriteEmptySectionRow(ref int stt, List<string> lines, string formatTien = "#")
    {
        lines.Add("<Section Dynamic=\"1\" MaxRows=\"0\">");
        lines.Add("<Cells>");
        stt++; 

        lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" FirstCell=\"0\" Encode=\"0\" Receive=\"1\" Value=\"\" StatusID=\"0001\"/>");
        lines.Add(GetValue(stt, "", 0, formatTien, "D", "C"));
        lines.Add(GetValue(stt, "", 0, formatTien, "E", "E"));
        lines.Add(GetValue(stt, "", 0, formatTien, "F", "G"));
        lines.Add(GetValue(stt, "", 3, formatTien, "G", "M"));
        lines.Add(GetValue(stt, "", 0, formatTien, "H", "R"));
        lines.Add(GetValue(stt, "", 0, formatTien, "I", "X"));
        lines.Add(GetValue(stt, "", 0, formatTien, "J", "AB"));
        lines.Add(GetValue(stt, 0, 1, formatTien, "K", "AF"));
        lines.Add(GetValue(stt, 0, 1, formatTien, "M", "AN"));
        lines.Add(GetValue(stt, "", 0, formatTien, "N", "AR"));

        lines.Add("</Cells>");
        lines.Add("</Section>");
    }

    private void WriteEmptySectionRow(ref int stt, List<string> lines)
    {
        lines.Add("<Cells>");
        stt++;

        lines.Add($"<Cell CellID=\"C_{stt}\" CellID2=\"AU_{stt + 10}\" FirstCell=\"0\" Encode=\"0\" Receive=\"1\" Value=\"\" StatusID=\"0001\"/>");
        lines.Add(GetCell(stt, "", 0, "D", "C"));
        lines.Add(GetCell(stt, "", 0, "E", "E"));
        lines.Add(GetCell(stt, "", 0, "F", "G"));
        lines.Add(GetCell(stt, "", 3, "G", "M"));
        lines.Add(GetCell(stt, "", 0, "H", "R"));
        lines.Add(GetCell(stt, "", 0, "I", "X"));
        lines.Add(GetCell(stt, "", 0, "J", "AB"));
        lines.Add(GetCell(stt, 0, 1, "K", "AF"));
        lines.Add(GetCell(stt, 0, 1, "M", "AN"));
        lines.Add(GetCell(stt, "", 0, "N", "AR"));

        lines.Add("</Cells>");
    }

    private string GetCell(int stt, object value, int type, string col1, string col2)
    {
        string val = "";
        switch (type)
        {
            case 0: // text
                val = EscapeXml(value?.ToString().Trim() ?? "");
                break;
            case 1: // số
                if (value == null || value == DBNull.Value || string.IsNullOrEmpty(value.ToString()))
                    val = "0";
                else
                    val = Math.Round(Convert.ToDecimal(value), 0).ToString("0");
                break;
            case 3: // ngày
                if (value is DateTime dt)
                    val = dt.ToString("dd/MM/yyyy");
                else
                    val = "";
                break;
        }

