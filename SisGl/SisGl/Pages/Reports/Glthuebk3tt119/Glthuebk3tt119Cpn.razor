    async Task Loaddata()
    {
        try
        {
            if (curCommand != null)
            {
                sFieldArrays = !IsLangEn
                    ? (Mau_bc != 0 ? curCommand.Vbrowse2 : curCommand.Vbrowse1)
                    : (Mau_bc != 0 ? curCommand.Ebrowse2 : curCommand.Ebrowse1);

                if (!string.IsNullOrEmpty(sFieldArrays))
                    Fbrowse = sFieldArrays;
            }

            string maDvcs = myStateMN.GetDvcs().Ma_dvcs?.Trim();
            maDvcs = (string.IsNullOrEmpty(maDvcs) || maDvcs == "ALL") ? "" : maDvcs;

            string condition = " and 1=1 ";
            if (!string.IsNullOrEmpty(maDvcs))
                condition += $" and ma_dvcs like '{maDvcs}%'";

            string paramName =
                "@StartDate;@EndDate;@Nhom_ct;@Ma_tc;@Condition;@Order";

            string paramValue =
                $"{Ngay_ct1:yyyyMMdd};" +
                $"{Ngay_ct2:yyyyMMdd};" +
                $"{Nhom_ct};" +
                $"{Ma_tc?.Trim()};" +
                $"{condition};" +
                $"{Nhom_ct}";

            var ds = await myDb.LoadStoreProcedure(
                curCommand.Store_proc,
                paramName,
                paramValue
            );

            dsGlcd = new DataSet();

            if (ds != null && ds.Tables.Count > 0)
            {
                ds.Tables[0].TableName = "tbTongCong";
                ds.Tables[1].TableName = "tbDetail";
                ds.Tables[2].TableName = "tbHTKK";

                TblData = ds.Tables["tbDetail"];
                dsGlcd = ds;
            }
            else
            {
                TblData = new DataTable();
            }

            if (TblData.Rows.Count > 0)
            {
                TongPsNo = TblData.Columns.Contains("t_tien")
                    ? Convert.ToDecimal(TblData.Compute("SUM(t_tien)", ""))
                    : 0m;

                TongPsCo = TblData.Columns.Contains("t_thue")
                    ? Convert.ToDecimal(TblData.Compute("SUM(t_thue)", ""))
                    : 0m;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error Loaddata Glthuebk3TT119: " + ex);
        }
    }




