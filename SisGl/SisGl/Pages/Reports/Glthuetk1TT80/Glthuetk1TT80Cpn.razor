    private string GetXmlValue(object value, object type)
    {
        if (type == null || type == DBNull.Value || type.ToString().Trim() != "1")
            return "";
        if (value == null || value == DBNull.Value || string.IsNullOrEmpty(value.ToString().Trim()))
            return "0";
        return Math.Round(Convert.ToDecimal(value), 0).ToString("0");
    }
