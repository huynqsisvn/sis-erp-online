    async Task Loaddata()
    {
        try
        {

            if (curCommand != null)
            {
                sFieldArrays = !(IsLangEn == false)
                    ? (Mau_bc != 0 ? curCommand.Ebrowse2.ToString().Split("|") : curCommand.Ebrowse1.Split("|"))
                    : (Mau_bc != 0 ? curCommand.Vbrowse2.ToString().Split("|") : curCommand.Vbrowse1.Split("|"));
                Fbrowse = sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
            }

            int Ky1, Ky2, Nam1, Nam2;
            Nam1 = Nam2 = Nam ?? DateTime.Now.Year;

            if (LoaiToKhai == "Q") 
            {
                Ky1 = ((Quy ?? 1) - 1) * 3 + 1;
                Ky2 = (Quy ?? 1) * 3;
            }
            else 
            {
                Ky1 = Thang;
                Ky2 = Thang;   
            }

            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = (MaDVCS == "ALL" || string.IsNullOrEmpty(MaDVCS)) ? "" : MaDVCS;

            string param_name = "Period1;Year1;Period2;Year2;Ma_dvcs;Advance;ReCall";
            string param_value = $"{Ky1};{Nam1};{Ky2};{Nam2};{MaDVCS};1=1;*";

            string store = curCommand.Store_proc;
            var ds1 = await myDb.LoadStoreProcedure(store, param_name, param_value);

            dsGlcd = new DataSet();

            if (ds1 != null && ds1.Tables.Count > 0)
            {
                DataTable t1 = ds1.Tables[0].Copy();
                t1.TableName = "Lsdata";
                if (t1.Columns.Contains("in_ck"))
                {
                    DataView dv = new DataView(t1);
                    dv.RowFilter = "in_ck = 1";
                    TblData = dv.ToTable();
                }
                else
                {
                    TblData = t1;
                }

                dsGlcd.Tables.Add(TblData);
            }
            else
            {
                TblData = new DataTable();
            }

            if (TblData != null && TblData.Rows.Count > 0)
            {
                string colNo = TblData.Columns.Contains("ps_no") ? "ps_no" : (TblData.Columns.Contains("ds") ? "ds" : "");
                string colCo = TblData.Columns.Contains("ps_co") ? "ps_co" : (TblData.Columns.Contains("thue") ? "thue" : "");

                if (!string.IsNullOrEmpty(colNo))
                    TongPsNo = TblData.Compute($"SUM({colNo})", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute($"SUM({colNo})", ""));

                if (!string.IsNullOrEmpty(colCo))
                    TongPsCo = TblData.Compute($"SUM({colCo})", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute($"SUM({colCo})", ""));
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error in Loaddata: " + ex.Message);
        }
    }


