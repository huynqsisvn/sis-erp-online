<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="500px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <DxFormLayout CssClass="w-100 p-3">
                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Loại tờ khai"]">
                    <DxComboBox TData="object"
                                TValue="string"
                                Data="@LoaiToKhaiData"
                                @bind-Value="@LoaiToKhai"
                                ValueField="Value"
                                TextField="Text"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@Lap["Năm"]" ColSpanMd="12">
                    <DxSpinEdit TValue="int?"
                                @bind-Value="Nam"
                                @onblur="HandleYearLostFocus"
                                Min="1900"
                                Max="2078"  
                                ShowSpinButtons="false" />
                </DxFormLayoutItem>
                @if (LoaiToKhai == "Q")
                {
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Quý"]">
                        <DxComboBox TData="object"
                                    TValue="int?"
                                    Data="@DanhSachQuy"
                                    ValueFieldName="Value"
                                    TextFieldName="Text"
                                    Value="Quy"
                                    ValueChanged="OnQuyChanged" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Từ tháng"]">
                        <DxSpinEdit TValue="int?"
                                    @bind-Value="ThangTu"
                                    Min="1" Max="12"
                                    ShowSpinButtons="false"
                                    ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Đến tháng"]">
                        <DxSpinEdit TValue="int?"
                                    @bind-Value="ThangDen"
                                    Min="1" Max="12"
                                    ShowSpinButtons="false"
                                    ReadOnly="true" />
                    </DxFormLayoutItem>
                }

                @if (LoaiToKhai == "T")
                {
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tháng"]">
                        <DxSpinEdit TValue="int?" @bind-Value="Thang" Min="1" Max="12" ShowSpinButtons="false" />
                    </DxFormLayoutItem>
                }

                <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report template"]">
                    <DxComboBox Data="@LstMauBC" @bind-Value="Mau_bc" ValueFieldName="Value" TextFieldName="Text" />
                </DxFormLayoutItem>
            </DxFormLayout>

            @if (Errors.Any())
            {
                <div class="mt-2 alert alert-danger p-2 mx-3">
                    <ul class="mb-0">
                        @foreach (var err in Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }
    </BodyTemplate>

    <FooterTemplate Context="footerContext">
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end p-2">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>
<DxPopup @bind-Visible="ShowEditForm"
         Width="420px"
         ShowFooter="true"
         Height="Auto"
         CloseOnOutsideClick="false"
         HeaderText="@Lap["Chỉnh sửa giá trị và thuế"]">

    <BodyTemplate Context="context1">
        <DxFormLayout CssClass="p-3">

            <DxFormLayoutItem Caption="@Lap["Chỉ tiêu"]" ColSpanMd="12">
                <DxTextBox @bind-Text="EditModel.chi_tieu" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Giá trị chưa thuế"]" ColSpanMd="12">
                <DxTextBox @bind-Text="EditModel.dsText"
                           Mask="n0"
                           MaskMode="MaskMode.Numeric"
                           InputCssClass="text-end"
                           CssClass="text-end" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="@Lap["Thuế GTGT"]" ColSpanMd="12">
                <DxTextBox @bind-Text="EditModel.thueText"
                           Mask="n0"
                           MaskMode="MaskMode.Numeric"
                           InputCssClass="text-end"
                           CssClass="text-end" />
            </DxFormLayoutItem>



        </DxFormLayout>
    </BodyTemplate>

    <FooterTemplate>
        <div class="row m-0 justify-content-end p-2">
            <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@SaveEdit" />
            <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@(() => ShowEditForm = false)" />
        </div>
    </FooterTemplate>

</DxPopup>
<DxPopup @bind-Visible="@ShowXmlPopup"
         HeaderText="Tờ khai thuế 01/GTGT TT80"
         Width="800px"
         Height="170px"
         ShowFooter="true"
         CloseOnOutsideClick="false">
    <BodyTemplate>
        <div class="p-3">
            <div class="row mb-2">
                <div class="col-3 d-flex align-items-center">
                    <label class="fw-bold">Phát sinh mua, bán trong kỳ</label>
                </div>
                <div class="col-1">
                    <DxTextBox @bind-Text="@TxtPs"
                               CssClass="text-center"
                               MaxLength="1"
                               Mask="0-1"
                               MaskMode="MaskMode.RegEx" />
                </div>
                <div class="col-8 d-flex align-items-center">
                    <span class="text-muted ms-3">0 - Không, 1 - Có</span>
                </div>
            </div>

            <div class="row">
                <div class="col-3 d-flex align-items-center">
                    <label class="fw-bold">Tập tin XML</label>
                </div>
                <div class="col-9">
                    <div class="d-flex">
                        <DxTextBox Text="@DisplayFileName"
                                   ReadOnly="true"
                                   CssClass="flex-grow-1" />
                        <DxButton Text="..."
                                  CssClass="ms-2"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@OpenFileNameEdit" />
                    </div>
                </div>
            </div>
        </div>
    </BodyTemplate>

    <FooterTemplate>
        <div class="d-flex justify-content-end p-2 gap-3">
            <DxButton Text="Nhận"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Click="@ExecuteExportXml" />
            <DxButton Text="Hủy bỏ"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => ShowXmlPopup = false)" />
        </div>
    </FooterTemplate>
</DxPopup>

<DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup" @bind-Visible="@ShowPrint" Width="80%" Height="90%" ShowFooter="false" Context="windowContext" HeaderText="@Lap["Printer"]">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@LsData" Menu_id="@Menu_id.Replace('_', '.')" OnBack="@(() => { ShowPrint = false; StateHasChanged(); })"></ReportOptionComponent>
