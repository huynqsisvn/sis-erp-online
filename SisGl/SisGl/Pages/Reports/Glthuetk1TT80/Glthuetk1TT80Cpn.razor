    async Task SaveEdit()
    {
        try
        {
            string cmdText = string.Format(@"
                UPDATE ctthuetk1tt80
                SET ds   = {0},
                    thue = {1}
                WHERE ma_so = '{2}'
                  AND stt   = {3}",
                EditModel.ds.ToString().Replace(",", "."),
                EditModel.thue.ToString().Replace(",", "."),
                EditModel.ma_so,
                EditModel.stt
            );


            await myDb.LoadDataset(cmdText);

            if (_editingRow != null)
            {
                _editingRow["ds"] = EditModel.ds;
                _editingRow["thue"] = EditModel.thue;
            }

            ShowEditForm = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi cập nhật dữ liệu: " + ex.Message);
        }
    }

    public void SelectedItem(object obj)
    {
        CurItem = obj;

        if (obj is DataRowView row &&
            row.Row.Table.Columns.Contains("in_ck"))
        {
            int cur = row["tag"] == DBNull.Value ? 0 : Convert.ToInt32(row["tag"]);
            row["tag"] = cur == 1 ? 0 : 1;
        }

        StateHasChanged();
    }


    private async Task OpenExportXmlPopup()
    {
        try
        {
            K_XML = myOption.GetOptionsValue("K_XML")?.ToString().Trim() ?? "";
            MST = myOption.GetOptionsValue("M_MA_THUE")?.ToString().Trim() ?? "";


            int nam2 = Nam ?? DateTime.Now.Year;
            string qui = LoaiToKhai == "Q" ? $"Q{(Quy ?? 1):00}" : $"{Thang:00}";

            pl101 = nam2 >= 2023;
            if (nam2 == 2023)
            {
                int ky = LoaiToKhai == "Q" ? (Quy ?? 1) : Thang;
                pl101 = (LoaiToKhai == "T" && ky >= 7) || (LoaiToKhai == "Q" && ky >= 3);
            }

            pl142 = false;
            if (nam2 >= 2024)
            {
                int ky = LoaiToKhai == "Q" ? (Quy ?? 1) : Thang;
                pl142 = (LoaiToKhai == "T" && (nam2 * 12 + ky) >= 2024 * 12 + 7) ||
                        (LoaiToKhai == "Q" && (nam2 * 4 + ky) >= 2024 * 4 + 3);
            }

            string basePath = string.IsNullOrEmpty(K_XML) ? "" : (K_XML.EndsWith("\\") ? K_XML : K_XML + "\\");
            string mstFolder = string.IsNullOrEmpty(MST) ? "" : MST + "\\";

            string commonPart = $"01_GTGT_TT80_CQTQL_00_{qui}{nam2}_283.xml";
            MainXmlFileName = basePath + mstFolder + commonPart;

            // Tên phụ lục
            if (pl142)
                PlXmlFileName = basePath + mstFolder + $"01_10_MGT_GTGT_TT80_CQTQL_00_{qui}{nam2}_283.xml";
            else if (pl101)
                PlXmlFileName = basePath + mstFolder + $"01_9_MGT_GTGT_TT80_CQTQL_00_{qui}{nam2}_283.xml";
            else
                PlXmlFileName = basePath + mstFolder + $"01_8_MGT_GTGT_TT80_CQTQL_00_{qui}{nam2}_283.xml";

            TxtPs = "1";
            ShowXmlPopup = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi tạo tên file: " + ex.Message);
        }
    }
    private async Task OpenFileNameEdit()
    {
        string suggestedName = System.IO.Path.GetFileName(MainXmlFileName) ?? "01_GTGT_TT80.xml";

        string input = await JS.InvokeAsync<string>(
            "prompt",
            "Nhập tên file XML để lưu (không cần đường dẫn đầy đủ):",
            suggestedName);

        if (!string.IsNullOrWhiteSpace(input))
        {
            string newName = input.Trim();
            if (!newName.EndsWith(".xml", StringComparison.OrdinalIgnoreCase))
                newName += ".xml";

            MainXmlFileName = System.IO.Path.Combine(
                System.IO.Path.GetDirectoryName(MainXmlFileName) ?? "",
                newName);

            StateHasChanged();
        }
    }
    private async Task ExecuteExportXml()
    {
        try
        {
            ShowXmlPopup = false;
            bool ps_tk_ck = TxtPs.Trim() == "1";

            string mainXml = GenerateMainXml(TblData, ps_tk_ck);
            string plXml = GeneratePhuLucXml();

            string fileNameMain = System.IO.Path.GetFileName(MainXmlFileName);
            if (string.IsNullOrEmpty(fileNameMain)) fileNameMain = "01_GTGT_TT80.xml";

            await JS.InvokeVoidAsync("downloadFile", fileNameMain, Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(mainXml)));

            string fileNamePl = "";
            if (!string.IsNullOrEmpty(plXml))
            {
                fileNamePl = System.IO.Path.GetFileName(PlXmlFileName);
                await JS.InvokeVoidAsync("downloadFile", fileNamePl, Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(plXml)));
            }

            // Thông báo rõ ràng
            string message = "Chương trình đã thực hiện xong!\n\n";

            myStateMN.SetNewThongbao(message);
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi xuất XML: " + ex.Message);
        }
    }
