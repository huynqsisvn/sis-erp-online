    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e is null) return;
        if (string.Equals(e.Key, "F3", StringComparison.OrdinalIgnoreCase))
        {
            await HandleEdit();
        }
        if (string.Equals(e.Key, "F5", StringComparison.OrdinalIgnoreCase) || string.Equals(e.Code, "F5", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                oBrowse_F5();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        if (string.Equals(e.Key, "F5", StringComparison.OrdinalIgnoreCase) && e.CtrlKey)
        {
            try
            {
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        if (string.Equals(e.Key, "F", StringComparison.OrdinalIgnoreCase) && e.CtrlKey)
        {
            try
            {
                PopupVisible = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
    }
    private async Task OnKeyDownCT(KeyboardEventArgs e)
    {
        if (e is null) return;
        if (string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase) ||
