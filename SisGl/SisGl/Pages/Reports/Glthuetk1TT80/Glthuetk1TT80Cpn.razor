        <FrmBrowseComponent @ref="@oBrowse"
                            TblData="@TblData"
                            Fbrowse="@Fbrowse"
                            SelectItem="@SelectedItem"
                            RowStyleFunc="@GetRowStyle"
                            CustomSummaryTextFormatter="@FormatSummaryText"
                            IsLangEn="@IsLangEn">
        </FrmBrowseComponent>
    </div>
}

else if (IsDetail && !ShowPL43Popup && !ShowPL142Popup)
{
<div class="row mt-1" @onkeydown="OnKeyDownCT" @onkeydown:preventDefault="true" tabindex="0">
    <FrmBrowseComponent @ref="@oBrowseCT"
                        TblData="@TblDataCT"
                        SelectItem="@SelectItemCT"
                        Fbrowse="@FbrowseCT"
                        RowStyleFunc="@GetRowStyle"
                        CustomSummaryTextFormatter="@FormatSummaryText"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>
}

else if (ShowPL43Popup)
{
<div class="row mt-1" @onkeydown="OnKeyDownCT" @onkeydown:preventDefault="true" tabindex="0">
    <div class="col-12 d-flex justify-content-between align-items-center mb-2">
        <h5 class="m-0 text-primary">@Lap["Phụ lục 43/101 - Giảm thuế GTGT theo Nghị định 101/2024"]</h5>
    </div>
    <FrmBrowseComponent @ref="@oBrowseCT"
