    private async Task oBrowse_F5()
    {
        try
        {
            if (TblData == null || TblData.Rows.Count == 0)
            {
                myStateMN.SetNewThongbao("Không có dữ liệu để tính lại.");
                return;
            }
            DataRow[] selectedRows = TblData.Select("tag = true OR tag = 1"); 

            if (selectedRows.Length == 0)
            {
                myStateMN.SetNewThongbao("Không có chỉ tiêu nào được chọn để tính lại (F5).");
                return;
            }

            string recnoList = string.Join(",", selectedRows.Select(row =>
            {
                if (row["recno"] == DBNull.Value) return "000";
                long recno = Convert.ToInt64(row["recno"]);
                return recno.ToString("000");
            }));
            int Ky1, Ky2, Nam1, Nam2;
            Nam1 = Nam2 = Nam ?? DateTime.Now.Year;

            if (LoaiToKhai == "Q")
            {
                Ky1 = ((Quy ?? 1) - 1) * 3 + 1;
                Ky2 = (Quy ?? 1) * 3;
            }
            else
            {
                Ky1 = Thang;
                Ky2 = Thang;
            }

            string MaDVCS = myStateMN.GetDvcs().Ma_dvcs.Trim();
            MaDVCS = (MaDVCS == "ALL" || string.IsNullOrEmpty(MaDVCS)) ? "" : MaDVCS;

            string param_name = "Period1;Year1;Period2;Year2;Ma_dvcs;Advance;ReCall";
            string param_value = $"{Ky1};{Nam1};{Ky2};{Nam2};{MaDVCS};1=1;{recnoList}";

            string store = curCommand.Store_proc;

            var dsResult = await myDb.LoadStoreProcedure(store, param_name, param_value);

            if (dsResult == null || dsResult.Tables.Count == 0 || dsResult.Tables[0].Rows.Count == 0)
            {
                myStateMN.SetNewThongbao("Không nhận được dữ liệu sau khi tính lại.");
                return;
            }

            DataTable newTable = dsResult.Tables[0].Copy();

            if (newTable.Columns.Contains("in_ck"))
            {
                DataView dv = new DataView(newTable);
                dv.RowFilter = "in_ck = 1";
                TblData = dv.ToTable();
            }
            else
            {
                TblData = newTable;
            }

            if (TblData.Rows.Count > 0)
            {
                string colNo = TblData.Columns.Contains("ps_no") ? "ps_no" : (TblData.Columns.Contains("ds") ? "ds" : "");
                string colCo = TblData.Columns.Contains("ps_co") ? "ps_co" : (TblData.Columns.Contains("thue") ? "thue" : "");

                if (!string.IsNullOrEmpty(colNo))
                    TongPsNo = TblData.Compute($"SUM({colNo})", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute($"SUM({colNo})", ""));
                if (!string.IsNullOrEmpty(colCo))
                    TongPsCo = TblData.Compute($"SUM({colCo})", "") is DBNull ? 0m : Convert.ToDecimal(TblData.Compute($"SUM({colCo})", ""));
            }
            myStateMN.SetNewThongbao($"Đã tính lại thành công {selectedRows.Length} chỉ tiêu.");

            StateHasChanged();

            if (!IsDetail)
            {
                await oBrowse?.FocusGridAsync();
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao("Lỗi khi tính lại (F5): " + ex.Message);
            Console.WriteLine("F5 Error: " + ex.ToString());
        }
    }



