@page "/gltcb200"
@page "/gltcb200/{Menu_id}"
@using SisGl.Pages.Reports
@inject IOptionsManager OptionsManager
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,gltcb200")]
<div class="row" onkeydown="_handleFunctionKeys(event);">
    @if (!IsDetail)
    {
        <div class="row">
            <FrmBrowseComponent @ref="@_FrmBrowse" TblData="@TblData" SelectItem="@SelectItems" RowStyleFunc="@GetRowStyle" CustomSummaryTextFormatter="@FormatSummaryText" Fbrowse="@fbrowse" IsLangEn="@IsLangEn"></FrmBrowseComponent>
        </div>
        <DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup"
                 @bind-Visible="@PopupVisible"
                 Width="60%"
                 Height="auto"
                 ShowFooter="true" Context="windowContext"
                 HeaderText="@Title">
            <BodyTemplate>
                @if (ShowLoadding)
                {
                    <div class="row m-0 p-0 justify-content-center">
                        <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                            <span class="sr-only">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-3">
                        <DxFormLayout CssClass="w-100">

                            <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Ngày báo cáo"]">
                                <DxDateEdit @bind-Date="Den_ngay" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Unit"]">
                                <DxTextBox @bind-Text="MaDVCS" NullText="" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Mẫu VND/Ngoại tệ"]">
                                <DxComboBox Data="@ReportStyles" @bind-Value="@Mau_bc" TextFieldName="Label" ValueFieldName="Value" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem ColSpanMd="12">
                                <hr />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Mẫu báo cáo"]">
                                <DxComboBox Data="@ReportTemplate" @bind-Value="@Report_index" TextFieldName="Label" ValueFieldName="Value" />
                            </DxFormLayoutItem>

                        </DxFormLayout>

                        @if (Errors.Any())
                        {
                            <div class="mt-2 alert alert-danger p-2">
                                <ul class="mb-0">
                                    @foreach (var err in Errors)
                                    {
                                        <li>@err</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </BodyTemplate>

            <FooterTemplate>
                @if (!ShowLoadding)
                {
                    <div class="row m-0 justify-content-end align-content-end">
                        <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                        <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
                    </div>
                }
            </FooterTemplate>
        </DxPopup>
    }
    else if (IsDetail)
    {
        <div class="row">
            <div class="row mx-1">
                <h7 style="color:dodgerblue">@TitleDetails</h7>
                <hr />
            </div>
            @if (ShowLoadding)
            {
                <div class="row m-0 p-0 justify-content-center">
                    <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <FrmBrowseComponent @ref="@_FrmBrowseDetails" TblData="@TblDataDetails" Fbrowse="@fbrowsedetails" CustomSummaryTextFormatter="@FormatSummaryText" IsLangEn="@IsLangEn"></FrmBrowseComponent>
                </div>
            }
        </div>
    }
</div>
@if (ShowPrint)
{
    <DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup"
             @bind-Visible="@ShowPrint"
             Width="80%" Height="90%"
             ShowFooter="false" Context="windowContext"
             HeaderText="Printer">
        <BodyTemplate>
            <ReportOptionComponent LSItems="LsData" Menu_id="@Menu_id.Replace('_', '.')" OnBack="@(() => { ShowPrint = false; })"></ReportOptionComponent>
        </BodyTemplate>
    </DxPopup>
}

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 20px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

