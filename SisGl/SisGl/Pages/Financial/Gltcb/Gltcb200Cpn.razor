        {
            CurUser = myStateMN.GetCurUser();
            MaDVCS = myStateMN.GetMa_Dvcs();
            Den_ngay = myStateMN.GetEndDate();
            ShowToolBar();
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync(IsDetail ? "oBrowseCT" : "oBrowse");
            await LoadTemplate();
            await Language();
            _curReportStyle = ReportTemplate[Report_index];
            Show(_curReportStyle);
        }
        else if (needApplyFilter)
        {
            needApplyFilter = false;
            _ = ApplyFilterWhenGridReady();
        }
    }
    bool needApplyFilter = true;
    async Task ApplyFilterWhenGridReady()
    {
        while (_FrmBrowse.Grid.GetColumns() == null ||
               !_FrmBrowse.Grid.GetColumns().Any(c => c.Name == "in_ck"))
        {
            await Task.Delay(10);
        }
        _FrmBrowse.Grid.FilterBy("in_ck", GridFilterRowOperatorType.Equal, "1");
    }

    void OnDvcsChanged(string ma_dvcs)
    {
        MaDVCS = ma_dvcs;
        myStateMN.SetDvcs(ma_dvcs, "");
        _curReportStyle = ReportTemplate[Report_index];
        Show(_curReportStyle);
        StateHasChanged();
    }
    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Quit:
                HideDetail();
                myStateMN.SetCurrentActionTask(ActionTask.None);
                ShowPrint = false;
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
            case ActionTask.Button1:
                _browser_F5();
                break;
        }
    }
    async void _browser_F5()
    {
        if (SelectedDataItem == null)
        {
            myStateMN.SetNewThongbao("Chưa chọn dòng cần xem chi tiết");
            return;
        }
        DataRowView rview = (DataRowView)SelectedDataItem;
        if (string.IsNullOrEmpty(rview["tk"].ToString()))
        {
            myStateMN.SetNewAlertMessage("Chưa chọn tài khoản.");
            return;
        }
        ShowLoadding = true;
        string str1 = rview["tk"].ToString().Trim();
        DateTime dateTime = (DateTime)dsGltcb.Tables[1].Rows[0][0];
        if (str1.Length == 0)
            return;

        TitleDetails = (!IsLangEn ? "Chi tiết: " : "Details: ") + str1;
        fbrowsedetails = sFieldArrays[1];
        string CommandText = "SELECT ROW_NUMBER() OVER(ORDER BY ct00.ngay_ct, stt_ct_nkc, ct00.so_ct) as stt, ct00.* , dmct.ma_ct_in AS ma_ct0, dmkh.ten_kh, dmkh.ten_kh2  FROM ct00 INNER JOIN dmct ON ct00.ma_ct = dmct.ma_ct LEFT JOIN dmkh ON ct00.ma_kh = dmkh.ma_kh WHERE ngay_ct BETWEEN '" + dateTime.ToString("yyyyMMdd") + "' AND '" + Ngay_ct.ToString("yyyyMMdd") + "' AND ct00.tk LIKE '" + str1 + "%' AND ct00.ma_dvcs LIKE '" + MaDVCS + "%' ORDER BY ct00.ngay_ct, stt_ct_nkc, ct00.so_ct;";
        DataSet dataSet1 = myDb.LoadDataSet(CommandText);
        if (dataSet1 != null && dataSet1.Tables.Count != 0)
            TblDataDetails = dataSet1.Tables[0].Copy();

        IsDetail = true;
        ShowLoadding = false;
        await ShowDetailToolBar();
        StateHasChanged();
    }
    async void ExportData(int type)
    {
        _FrmBrowse?.ExPortGrid(type);
        myStateMN.SetNewThongbao("Export successfully");
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;

            if (curCommand != null)
                fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // WPF -> Blazor: ConfirmGridView_OnOk equivalent
    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;

        myStateMN.SetEndDate(Den_ngay);
        _curReportStyle = ReportTemplate[Report_index];
        Show(_curReportStyle);
    }
    async void Show(ReportStyle _rpstyle)
    {
        ShowLoadding = true;
        Ngay_ct = Den_ngay;
        Condition = GetCondition();

        M_CHON_MAU = _rpstyle.File_mau;
        M_TT_QD = _rpstyle.Tt_qd;
        string _ky_bc = _rpstyle.Nh_bc.ToUpper().StartsWith("GND") ? "2" : "4";
        string _sql_check = string.Format("select DISTINCT ma_so, kind, cach_tinh, cong_no,khong_am,ts_nv, tk from dmmaubcct where ma_so IS NOT NULL and mau_bc = '{0}' AND ngoai_bang != 2", _rpstyle.File_mau);
        DataSet _ds = await myDb.LoadDataset(_sql_check);
        if (_ds != null && _ds.Tables.Count != 0)
            this.CheckTemplate(_ds.Tables[0]);
        myDb.ExecuteSqlQueryAsync(string.Format("UPDATE Dmmaubc SET [default] = CASE WHEN file_maubc = '{0}' THEN 1 ELSE 0 END WHERE ma_maubc = '{1}'", _rpstyle.File_mau, _rpstyle.Ma_maubc));

        switch (_ky_bc)
        {
            case "1":
                Ngay_ct1 = this.GetBeginPeriod(1, Ngay_ct);
                break;
            case "2":
                Ngay_ct1 = this.GetBeginPeriod(3, Ngay_ct);
                break;
            case "3":
                Ngay_ct1 = this.GetBeginPeriod(6, Ngay_ct);
                break;
            case "4":
                Ngay_ct1 = this.GetBeginPeriod(12, Ngay_ct);
                break;
        }
        await Loaddata();
        ShowLoadding = false;
        PopupVisible = false;
        InvokeAsync(StateHasChanged);
    }

    private bool CheckTemplate(DataTable data)
    {
        DataTable dataTable = data;
        DataTable data1 = dataTable.Copy();
        string str1 = "";
        string str2 = "";
        foreach (DataRow row in (InternalDataCollectionBase)dataTable.Rows)
        {
            object obj1 = row["cach_tinh"];
            object obj2 = row["ma_so"];
            if (row["kind"].ToString() == "3" && (obj1 is DBNull || obj1.ToString().Trim().Length == 0))
            {
                if (!this.IsInFomula(data1.DefaultView.ToTable(true, "cach_tinh"), obj2.ToString()))
                    str1 = str1 + "," + obj2.ToString().Trim();
            }
            else
            {
                if (!CheckNorm(data1.DefaultView.ToTable(true, "ma_so"), obj1.ToString(), false))
                    str2 = str2 + "," + obj2.ToString().Trim();
            }
        }
        if (str1.Length > 0)
        {
            myStateMN.SetNewAlertMessage(string.Format("Chỉ tiêu [{0}] chưa khai báo công thức tính!", (object)str1.Substring(1)));
        }
        if (str2.Length > 0)
        {
            myStateMN.SetNewAlertMessage(string.Format("Khai báo sai chỉ tiêu: [{0}]!", (object)str2.Substring(1)));
        }
        return this.Check2SideAcounts(data1) && str1.Length == 0 && str2.Length == 0;
    }
    private bool Check2SideAcounts(DataTable data)
    {
        var source = data.AsEnumerable().Where<DataRow>((Func<DataRow, bool>)(t =>
         {
             Decimal? nullable = t.Field<Decimal?>("khong_am");
             return (!(nullable.GetValueOrDefault() == new Decimal(1)) ? 0 : (nullable.HasValue ? 1 : 0)) != 0 && t.Field<string>("kind") == "1";
         })).GroupBy(t =>
         {
             var data1 = new
             {
                 tk = t.Field<string>("tk").Trim(),
                 ts_nv = t.Field<Decimal>("ts_nv")
             };
             return data1;
         }).Select(tk =>
         {
             var data1 = new
             {
                 Tk = tk.Key.tk,
                 Ts_nv = tk.Key.ts_nv
             };
             return data1;
         });
        string str = "";
        foreach (var data1 in source)
        {
            string tk = data1.Tk;
            if (data1.Ts_nv == new Decimal(1))
            {
                if (source.Where(t => t.Tk == tk && t.Ts_nv == new Decimal(2)).Select(t => t.Tk).Count<string>() == 0)
                    str = str + "," + data1.Tk.Trim();
            }
            else if (source.Where(t => t.Tk == tk && t.Ts_nv == new Decimal(1)).Select(t => t.Tk).Count<string>() == 0)
                str = str + "," + data1.Tk.Trim();
        }
        if (str.Length > 0)
        {
            myStateMN.SetNewAlertMessage(string.Format("Tk ở 2 vế (tk lưỡng tính): [{0}] nhưng chỉ khai báo 1 vế!", (object)str.Substring(1)));
        }
        return str.Length == 0;
    }
    private bool IsInFomula(DataTable data, string code)
    {
        foreach (DataRow row in (InternalDataCollectionBase)data.Rows)
        {
            object obj = row["cach_tinh"];
            if (!(obj is DBNull) && obj.ToString().Trim().Length != 0 && obj.ToString().Contains(code.Trim()))
                return true;
        }
        return false;
    }

    public bool CheckNorm(DataTable data, string norm, bool notify)
    {
        norm = norm.Trim();
        if (norm.Length == 0)
            return true;
        try
        {
            data.PrimaryKey = new DataColumn[1]
            {
          data.Columns["ma_so"]
            };
        }
        catch (Exception ex)
        {
            return true;
        }
        foreach (object key in norm.Split("+-*/".ToCharArray()))
        {
            if (!data.Rows.Contains(key))
            {
                if (notify)
                {
                    myStateMN.SetNewAlertMessage("Khai báo công thức sai!");
                }
                return false;
            }
        }
        return true;
    }

    public DateTime GetBeginPeriod(int nMonthForward, DateTime Ngay_ct)
    {
        DateTime _ngaytc = DateTime.Now;
        string _sql = "Select [value] from sysvar where [name] like 'M_NGAY_DN'";
        DataSet _ds = myDb.LoadDataSet(_sql);
        if (_ds == null || _ds.Tables[0].Rows.Count == 0)
            _ngaytc = new DateTime(DateTime.Now.Year, 1, 1);
        if (string.IsNullOrEmpty(_ds.Tables[0].Rows[0]["value"].ToString()))
            _ngaytc = new DateTime(DateTime.Now.Year, 1, 1);
        else
            _ngaytc = DateTime.Parse(_ds.Tables[0].Rows[0]["value"].ToString());

        SisGl.Model.NgayTC.SetStartDate(_ngaytc);
        DateTime dateTime1 = SisGl.Model.NgayTC.GetStartDate(Ngay_ct);
        for (DateTime dateTime2 = dateTime1.AddMonths(nMonthForward).AddDays(-1.0); Ngay_ct.CompareTo(dateTime1) < 0 || Ngay_ct.CompareTo(dateTime2) > 0; dateTime2 = dateTime1.AddMonths(nMonthForward).AddDays(-1.0))
            dateTime1 = dateTime1.AddMonths(nMonthForward);
        return dateTime1;
    }
