    async Task Loaddata()
    {
        try
        {
            sFieldArrays = !(IsLangEn == false) ? (Mau_bc != 0 ? curCommand.Ebrowse2.Split("|".ToCharArray()) : curCommand.Ebrowse1.Split("|".ToCharArray())) : (Mau_bc != 0 ? curCommand.Vbrowse2.Split("|".ToCharArray()) : curCommand.Vbrowse1.Split("|".ToCharArray()));
            fbrowse = sFieldArrays[0];
            string parram_name = "Ngay_ct1;Ngay_ct2;Mau;Ma_dvcs;Advance";
            string _Ma_dvcs = (MaDVCS == "ALL" ? "%" : MaDVCS);
            string parram_value = $"{(Tu_ngay != null ? Tu_ngay.ToString("yyyyMMdd") : "")};{(Den_ngay != null ? Den_ngay.ToString("yyyyMMdd") : "")};{M_CHON_MAU};{_Ma_dvcs};{Condition}";
            dsGltcb = await myDb.LoadStoreProcedure(_store_proc, parram_name, parram_value);
            if (dsGltcb != null && dsGltcb.Tables.Count != 0)
            {
                TblData = dsGltcb.Tables[0].Copy();
                string[] strArray1 = M_TT_QD.Split(':');
                if (strArray1.Length > 1)
                {
                    string[] strArray2 = strArray1[1].Split('/');
                    if (strArray2.Length > 1)
                    {
                        this.sTong_ts = strArray2[0].Trim();
                        this.sTong_nv = strArray2[1].Trim();
                    }
                }
                DataRow[] dataRowArray1 = TblData.Select("ma_so LIKE '" + this.sTong_ts + "%'");
                DataRow[] dataRowArray2 = TblData.Select("ma_so LIKE '" + this.sTong_nv + "%'");
                if (((IEnumerable<DataRow>)dataRowArray1).Any<DataRow>() && ((IEnumerable<DataRow>)dataRowArray2).Any<DataRow>())
                {
                    Decimal num1 = (Decimal)dataRowArray1[0]["tien"];
                    Decimal num2 = (Decimal)dataRowArray2[0]["tien"];
                    Decimal num3 = (Decimal)dataRowArray1[0]["tien0"];
                    Decimal num4 = (Decimal)dataRowArray2[0]["tien0"];
                    if (num1 != num2 || num3 != num4)
                    {
                        myStateMN.SetNewAlertMessage("Tổng tài sản không bằng tổng nguồn vốn!");
                    }
                }
                TblData.DefaultView.Sort = "stt, ma_so";
            }
            else
            {
                TblData = new DataTable();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

