    private async Task SetActiveComponentIdAsync(string id)
    {
        try
        {
            ActiveComponentId = id ?? ActiveComponentId;
            if (Pageobj != null)
            {
                await JavacriptS.InvokeVoidAsync("SetPageFModeObj", Pageobj, ActiveComponentId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("SetActiveComponentIdAsync error: " + ex.Message);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wg.bc.03";        
        curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
        if (curCommand != null)
        {
            Store_proc = curCommand.Store_proc?.Split('|')[0] ?? "";
            sFieldArrays = !(IsLangEn == false) ? (Mau_bc != 0 ? curCommand.Ebrowse2.Split("|".ToCharArray()) : curCommand.Ebrowse1.Split("|".ToCharArray())) : (Mau_bc != 0 ? curCommand.Vbrowse2.Split("|".ToCharArray()) : curCommand.Vbrowse1.Split("|".ToCharArray()));
            Fbrowse = sFieldArrays[0];
            Title = curCommand.Bar ?? Title;
        }
        LoadTemplate();
        await Language();

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            MaDVCS = myStateMN.GetMa_Dvcs();
            Ngay_ct1 = myStateMN.GetEndDate();
            Ngay_ct2 = myStateMN.GetEndDate();
            if (Ngay_ct1 == Ngay_ct2)
            {
                Ngay_ct2 = SisLib.Ctrl.NgayTC.EndOfPeriod(mySysvar, Ngay_ct2.Year, Ngay_ct2.Month);
                Ngay_ct1 = SisLib.Ctrl.NgayTC.StartOfYear(mySysvar, Ngay_ct2);
                if (Ngay_ct01 > Ngay_ct1)
                {
                    Ngay_ct01 = Ngay_ct1.AddMonths(-12);
                    Ngay_ct02 = Ngay_ct2.AddMonths(-12);
                }
                if (Ngay_bd_lk > Ngay_ct1)
                {
                    Ngay_bd_lk = Ngay_ct01;
                }
            }
            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true,"Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true,"F7"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.AddOrderToolBarButton("button1", Lap["Detail"] + "-F5", 1);
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }
            LanguageID = "frmFilter";
            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;
            Pageobj = DotNetObjectReference.Create(this);
            await SetActiveComponentIdAsync(IsDetail ? "oBrowseCT" : "oBrowse");
            await Lap.LoadLocalizationAsync(String.Format("{0}-{1}", String.IsNullOrEmpty(LanguageID) ? curCommand.Ma_phan_he.Trim().ToLower() : LanguageID, IsLangEn ? "en":"vi"));
            _curReportStyle = ReportTemplate[Report_index];
            Show(_curReportStyle);
            StateHasChanged();
        }
        else
        { 
            if (needApplyFilter)
            {
                needApplyFilter = false;
                _ = ApplyFilterWhenGridReady();
            }
            if (IsDetail)
            {
                await oBrowseCT.FocusGridAsync();
            }
            else
            {
                await oBrowse.FocusGridAsync();
            }
        }
    }

    bool needApplyFilter = true;
    async Task ApplyFilterWhenGridReady()
    {        
        while (oBrowse.Grid.GetColumns() == null ||
               !oBrowse.Grid.GetColumns().Any(c => c.Name == "in_ck"))
        {
            await Task.Delay(10);
        }        
        oBrowse.Grid.FilterBy("in_ck", GridFilterRowOperatorType.Equal, 1);        
    }
    public override async Task ShowToolBar()
    {
        if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
        {
            myStateMN.SetToolBar(new MyToolbar("toolbar", true));
            myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
            myStateMN.SetToolBar(new MyToolbar("Print", true, "F7"));
            myStateMN.SetToolBar(new MyToolbar("Export", true));
            myStateMN.AddOrderToolBarButton("button1", Lap["Detail"] + "-F5", 1);
        }
        else
        {
            myStateMN.SetToolBar(new MyToolbar("toolbar", false));
        }
    }
  
    public override void OnDvcsChanged(string ma_dvcs)
    {
        MaDVCS = ma_dvcs;
        myStateMN.SetDvcs(ma_dvcs, "");
        _curReportStyle = ReportTemplate[Report_index];
        Show(_curReportStyle);
        StateHasChanged();
    }
    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;           
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
            case ActionTask.Button1:
                oBrowse_F5();
                break;
            case ActionTask.Quit:
                HideDetail();
                StateHasChanged();
                break;
        }
    }
    public void HideDetail()
    {
        _ = SetActiveComponentIdAsync("oBrowse");
        IsDetail = false;
        needApplyFilter = true;
        ShowToolBar();        
    }
    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;

        myStateMN.SetStartDate(Ngay_ct1);
        myStateMN.SetEndDate(Ngay_ct2);
        _curReportStyle = ReportTemplate[Report_index];
        Show(_curReportStyle);
    }
    async void Show(ReportStyle _rpstyle)
    {
        ShowLoadding = true;        
        Condition = GetCondition();

        M_CHON_MAU = _rpstyle.File_mau;
        M_TT_QD = _rpstyle.Tt_qd;
        string _ky_bc = _rpstyle.Nh_bc.ToUpper().StartsWith("GND") ? "2" : "4";
        string _sql_check = string.Format("select DISTINCT ma_so, kind, cach_tinh, cong_no,khong_am,ts_nv, tk from dmmaubcct where ma_so IS NOT NULL and mau_bc = '{0}' AND ngoai_bang != 2", _rpstyle.File_mau);
        DataSet _ds = await myDb.LoadDataset(_sql_check);
        if (_ds != null && _ds.Tables.Count != 0)
            CheckTemplate(_ds.Tables[0]);
        myDb.ExecuteSqlQueryAsync(string.Format("UPDATE Dmmaubc SET [default] = CASE WHEN file_maubc = '{0}' THEN 1 ELSE 0 END WHERE ma_maubc = '{1}'", _rpstyle.File_mau, _rpstyle.Ma_maubc));

        await Loaddata(_rpstyle);
        ShowLoadding = false;
        PopupVisible = false;
        InvokeAsync(StateHasChanged);
    }
    async Task Loaddata(ReportStyle _rpstyle)
    {
        try
        {
            if (curCommand != null)
            {
                sFieldArrays = !(IsLangEn == false) ? (Mau_bc != 0 ? curCommand.Ebrowse2.ToString().Split("|".ToCharArray()) : curCommand.Ebrowse1.Split("|".ToCharArray())) : (Mau_bc != 0 ? curCommand.Vbrowse2.ToString().Split("|".ToCharArray()) : curCommand.Vbrowse1.Split("|".ToCharArray()));
                //Fbrowse = sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
                Fbrowse = !(_rpstyle.Nh_bc.ToUpper().Trim().StartsWith("GND")) ? (!(_rpstyle.Nh_bc.ToUpper().Trim().StartsWith("NOIBO")) ? sFieldArrays[0] : sFieldArrays[4]) : sFieldArrays[1];
            }             
            dsGltcc = new DataSet();
            Ma_dvcs = myStateMN.GetDvcs().Ma_dvcs;
            //string strsql = $"exec {Store_proc} @Ngay_ct1 ='{Ngay_ct1.ToString("yyyyMMdd")}',@Ngay_ct2 ='{Ngay_ct2.ToString("yyyyMMdd")}',@Ngay_ct3 ='{Ngay_ct01.ToString("yyyyMMdd")}',@Ngay_ct4 ='{Ngay_ct02.ToString("yyyyMMdd")}',@Ngay_ct5 ='{Ngay_bd_lk.ToString("yyyyMMdd")}',@Ma_dvcs = '{(Ma_dvcs == "ALL" ? "" : Ma_dvcs)}%',@Luyke=1,@Mau = '{_rpstyle.File_mau.Trim()}'";
            // dsGltcc = await myDb.LoadDataset(strsql);
            dsGltcc = await myDb.LoadDataset(Store_proc, new Dictionary<string, object>
                {
                    ["@Ngay_ct1"] = Ngay_ct1,
                    ["@Ngay_ct2"] = Ngay_ct2,
                    ["@Ngay_ct3"] = Ngay_ct01,
                    ["@Ngay_ct4"] = Ngay_ct02,                    
                    ["@Ngay_ct5"] = Ngay_bd_lk,
                    ["@Ma_dvcs"] = (Ma_dvcs == "ALL" ? "%" : Ma_dvcs.Trim()+"%"),
                    ["@Luyke"] = 0,
                    ["@Mau"] = _rpstyle.File_mau.Trim()
                });
            if (dsGltcc != null && dsGltcc.Tables.Count != 0)
            {
                TblData = dsGltcc.Tables[0].Copy();
                string[] strArray1 = M_TT_QD.Split(':');               

                TblData.DefaultView.Sort = "stt, ma_so";
            }
            else
            {
                TblData = new DataTable();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    public string GetCondition()
    {
        string cond = " 1=1 ";
        if (!string.IsNullOrEmpty(MaDVCS) && !MaDVCS.Equals("ALL"))
            cond = (string.IsNullOrEmpty(cond) ? "" : cond + " and ") + $"ma_dvcs like '{MaDVCS.Trim()}%'";
        return cond;
    }
    private bool CheckTemplate(DataTable data)
    {
        return true;
    }
    async void LoadTemplate()
    { 
        try
        {
            DataSet ds = await GetMauBC(m_maubc);
            if (ds != null && ds.Tables[0].Rows.Count > 0)
            {
                int index = 0;
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ReportTemplate.Add(new ReportStyle() { Label = row["ten_maubc"].ToString(), Value = index, File_mau = row["file_maubc"].ToString().Trim(), Ma_maubc = row["ma_maubc"].ToString(), Nh_bc = row["nh_bc"].ToString().Trim(), Tt_qd = row["tt_qd"].ToString(), Default = row["default"].ToString() });
                    if(row["default"].ToString().Trim() == "1")
                    {
                        Report_index = index;
                    }
                    index++;
                }
            }
            else
            {
                ReportTemplate.Add(new ReportStyle() { Label = "", Value = 0 });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    void Print()
    {
        //string strq = Converts.DataTable2Model(TblData);
        LsData = new List<Gltcd200Model>();
        Gltcd200Model model = new Gltcd200Model();
        DataTable _tblFilter = oBrowse.GetFilterTable();
        if (_tblFilter != null)
        {
            _tblFilter.DefaultView.Sort = "stt, ma_so";
            DataTable TblPrint = _tblFilter.Select("in_ck = 1").CopyToDataTable();
            List<Gltcc200> listObj = myDb.ConvertDataTable<Gltcc200>(TblPrint);
            model.LsData = listObj;
        }
        else
        {
            DataTable TblPrint = TblData.Select("in_ck = 1").CopyToDataTable();
            TblPrint.DefaultView.Sort = "stt, ma_so";
            List<Gltcc200> listObj = myDb.ConvertDataTable<Gltcc200>(TblPrint);
            model.LsData = listObj;
        }
        model.Tu_ngay = Ngay_ct1;
        model.Den_ngay = Ngay_ct2;
        model.Ngay_dkt = Ngay_ct01;
        model.Ngay_ckt = Ngay_ct02;
        model.Ngay_bd_lk = Ngay_bd_lk;
        model.MaDVCS = MaDVCS;
        model.Mau_bc = Mau_bc;
        model.Ma_nt0 = M_ma_nt0;
        //model.LsData = (TblData != null ? myDb.ConvertDataTable<Gltcc200>(TblData) : new List<Gltcc200>());
        LsData.Add(model);
        ShowPrint = true;
    }
    private async void oBrowse_F5()
    {
        if (CurItem == null)
        {
            myStateMN.SetNewThongbao(Lap["Please select a row to view detail"] + " !");
            return;
        }
        else
        {
            var selectedObj = CurItem as DataRowView;
            if (selectedObj != null)
            {
                if (selectedObj != null)
                {
                    var cells = selectedObj.Row;                    
                    if (cells["cach_tinh"].ToString().Trim().Length > 0 || cells["kind"].ToString().Trim() == "3")
                        return;

                    string str1 = cells["tk_no"].ToString().Trim().Replace(" ", "");
                    string str2 = cells["tk_co"].ToString().Trim().Replace(" ", "");
                    decimal num = Convert.ToDecimal(cells["giam_tru"]);
                    string str3 = myOption.GetOptionsValue("M_TK_KQKD").ToString().Trim();
                    string str4;
                    string madvcs = (Ma_dvcs == "ALL" ? "%" : Ma_dvcs);
                    if (str1.Length > 0)
                    {
                        string str5 = $"(ABS(ISNULL(ct00.ps_no, 0)) + ABS(ISNULL(ct00.ps_no_nt, 0)) != 0 AND (ct00.tk LIKE '{str1.Replace(",", "%' OR ct00.tk LIKE '")}%'))";
                        if (str2.Length > 0)
                            str4 = $" AND {str5} AND (ct00.tk_du LIKE '{str2.Replace(",", "%' OR ct00.tk_du LIKE '")}%')";
                        else
                            str4 = num != 1
                                ? $" AND {str5}"
                                : $" AND ({str5} OR (ABS(ISNULL(ct00.ps_co, 0)) + ABS(ISNULL(ct00.ps_co_nt, 0)) != 0 AND (ct00.tk LIKE '{str1.Replace(",", "%' OR ct00.tk LIKE '")}%') AND (ct00.tk_du NOT LIKE '{str3}%')))";
                    }
                    else
                    {
                        string str5 = $"(ABS(ct00.ps_co) + ABS(ct00.ps_co_nt) != 0 AND (ct00.tk LIKE '{str2.Replace(",", "%' OR ct00.tk LIKE '")}%'))";
                        str4 = num != 1
                            ? $" AND {str5}"
                            : $" AND ({str5} OR (ABS(ct00.ps_no) + ABS(ct00.ps_no_nt) != 0 AND (ct00.tk LIKE '{str2.Replace(",", "%' OR ct00.tk LIKE '")}%') AND (ct00.tk_du NOT LIKE '{str3}%')))";
                    }

                    string cmdText = $@"SELECT IDENTITY(int,1,1) stt, ct00.*, dmct.ma_ct_in AS ma_ct0, dmkh.ten_kh, dmkh.ten_kh2 INTO #tmp FROM ct00 INNER JOIN dmct ON ct00.ma_ct = dmct.ma_ct LEFT JOIN dmkh ON ct00.ma_kh = dmkh.ma_kh
                                        WHERE ngay_ct BETWEEN '{Ngay_ct1:yyyyMMdd}' AND '{Ngay_ct2:yyyyMMdd}' {str4} AND ct00.ma_dvcs LIKE '{madvcs}%' ORDER BY ngay_ct, dmct.stt_ct_nkc, so_ct;SELECT * FROM #tmp";
                    DataSet dataSet = await myDb.LoadDataset(cmdText);
                    if (dataSet.Tables.Count > 0)
                     TblDataCT = dataSet.Tables[0];
                    else
                        TblDataCT = new DataTable();

                    FbrowseCT = sFieldArrays.Length > 2 ? sFieldArrays[2] : string.Empty;
                    Tk_ct = Lap["Detail"] + ": " + str1 + (!(str1 != "") || !(str2 != "") ? "" : ",") + str2;
                }
            }
        }
        IsDetail = true;        
        ShowDetailToolBar();
        StateHasChanged();
    }
    public async Task ShowDetailToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Quit", true,"Esc"));      
    }
    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("Bold") && row["Bold"].ToString().Trim() == "1")
        {
            return "bold-item";
        }
        return "";
    }
    string FormatSummaryText(GridCustomizeSummaryDisplayTextEventArgs e)
    {
        if (e.Item.Name == "dien_giai")
        {
            return Lap["Summary"];
        }       
        return null;
    }
    private bool CheckValid()
    {
        Errors.Clear();
        bool flag = true;
        if (flag && Ngay_ct1 == default)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct2 == default)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct1 > Ngay_ct2)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct01 > Ngay_ct1)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct02 > Ngay_ct2)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        // if (flag && Ngay_bd_lk > Ngay_ct1)
        // {
        //     Errors.Add("Invalid date!");
        //     flag = false;
        // }
        if (Errors.Count > 0)
            myStateMN.SetNewThongbao(Errors[0]);
        StateHasChanged();
        return flag;
    }
    async Task<DataSet> GetMauBC(string ma_maubc)
    {
        string[] strArray = OptionsManager.GetOptionsValue("M_MAU_TT_QD").ToString().Split(';');
        string str = "1=1";
        if (strArray.Length > 1)
            str = !(strArray[1].Trim() == "2") ? string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim()) : string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim());
        string cmdText = string.Format("SELECT file_maubc, ten_maubc, ten_maubc2, tt_qd, nh_bc, ma_maubc, [default] FROM {0} WHERE ma_maubc = '{1}' AND {2} ORDER BY [order]", (object)"dmmaubc", (object)ma_maubc, (object)str);
        DataSet ds = await myDb.LoadDataset(cmdText);
        return ds;
    }
