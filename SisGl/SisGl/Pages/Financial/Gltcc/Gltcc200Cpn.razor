@page "/gltcc200"
@page "/gltcc200/{Menu_id}"
@using SisGl.Pages.Reports
@inject IOptionsManager OptionsManager
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,gltcc200")]
  <div class="row" onkeydown="_handleFunctionKeys(event);">
@if (!IsDetail)
{
    <div class="row">
        <FrmBrowseComponent @ref="@oBrowse" TblData="@TblData" SelectItem="@SelectedItem" Fbrowse="@Fbrowse" IsLangEn="@IsLangEn" RowStyleFunc="@GetRowStyle"></FrmBrowseComponent>
    </div>
}
else
{
    <div class="row mx-1">
        <h7 style="color:dodgerblue">@Tk_ct</h7>
        <hr />
     </div>
    <div class="row mt-1">
        <FrmBrowseComponent @ref="@oBrowseCT" TblData="@TblDataCT" SelectItem="@SelectItemCT" Fbrowse="@FbrowseCT" RowStyleFunc="@GetRowStyle" CustomSummaryTextFormatter="@FormatSummaryText" IsLangEn="@IsLangEn"></FrmBrowseComponent>
    </div>
}
</div>
<DxPopup @ref="popFilter" CloseOnOutsideClick="false" CssClass="dxPopup" onkeydown="ModifyEnterKeyPressAsTab(event);"
         @bind-Visible="@PopupVisible"
         Width="60%"
         Height="auto"
         ShowFooter="true"
         HeaderText="@Title">
    <BodyTemplate Context="popupContext">
        @if (ShowLoadding)
        {
            <div class="row m-0 p-0 justify-content-center">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height:4rem;border-width:3px;">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-3">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["From date"]">
                        <DxDateEdit @bind-Date="@Ngay_ct1" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"/>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["To date"]">
                        <DxDateEdit @bind-Date="@Ngay_ct2" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Prev. period start date"]">
                        <DxDateEdit @bind-Date="@Ngay_ct01" NullText=""/>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Prev. period end date"]">
                        <DxDateEdit @bind-Date="@Ngay_ct02" NullText=""/>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Accumulation from"]">
                        <DxDateEdit @bind-Date="@Ngay_bd_lk" NullText="" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"/>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="6" Caption="@Lap["Report template"]" Enabled="false">
                        <DxComboBox Data="@LstMauBC" @bind-Value="@Mau_bc" ValueFieldName="Value" TextFieldName="Text" Enabled="false"/>
                    </DxFormLayoutItem>                  

                    <DxFormLayoutItem ColSpanMd="12">
                        <hr />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Report form"]">
                        <DxComboBox Data="@ReportTemplate" @bind-Value="@Report_index" TextFieldName="Label" ValueFieldName="Value" />
                    </DxFormLayoutItem>
                </DxFormLayout>
                @if (Errors.Any())
                {
                    <div class="mt-2 alert alert-danger p-2">
                        <ul class="mb-0">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="row m-0 justify-content-end align-content-end">
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Success" Text="@Lap["OK"]" Click="@ConfirmGridView_OnOk" />
                <DxButton CssClass="popup-button-footer" RenderStyle="ButtonRenderStyle.Danger" Text="@Lap["Cancel"]" Click="@BtnCancel" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@if (ShowPrint)
{
    <DxPopup @ref="popPrint" CloseOnOutsideClick="false" CssClass="dxPopup"
    @bind-Visible="@ShowPrint"
    Width="80%" Height="90%"
    ShowFooter="false"
    HeaderText="Printer">
        <BodyTemplate>
            <ReportOptionComponent LSItems="LsData" Menu_id="@Menu_id.Replace('_', '.')" OnBack="@(() => { ShowPrint = false; })"></ReportOptionComponent>
        </BodyTemplate>
    </DxPopup>
}

<style>
    .popup-button-footer {
    width: 100px;
    margin-right: 20px;
    margin-top: 5px;
    margin-bottom: 5px;
    }
</style>

