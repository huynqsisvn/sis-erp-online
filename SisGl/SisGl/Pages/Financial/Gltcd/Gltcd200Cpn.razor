    private bool CheckValid()
    {
        Errors.Clear();
        bool flag = true;
        if (flag && Ngay_ct1 == default)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct2 == default)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct1 > Ngay_ct2)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct01 > Ngay_ct1)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (flag && Ngay_ct02 > Ngay_ct2)
        {
            Errors.Add("Invalid date!");
            flag = false;
        }
        if (Errors.Count > 0)
            myStateMN.SetNewThongbao(Errors[0]);
        StateHasChanged();
        return flag;
    }
    async Task<DataSet> GetMauBC(string ma_maubc)
    {
        string[] strArray = OptionsManager.GetOptionsValue("M_MAU_TT_QD").ToString().Split(';');
        string str = "1=1";
        if (strArray.Length > 1)
            str = !(strArray[1].Trim() == "2") ? string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim()) : string.Format("(nh_dh={0} OR isnull(nh_dh,'')='') AND (mau_ttqd like '{1}' OR isnull(mau_ttqd,'')='')", (object)strArray[1].Trim(), (object)strArray[0].Trim());
        string cmdText = string.Format("SELECT file_maubc, ten_maubc, ten_maubc2, tt_qd, nh_bc, ma_maubc, [default] FROM {0} WHERE ma_maubc = '{1}' AND {2} ORDER BY [order]", (object)"dmmaubc", (object)ma_maubc, (object)str);
        DataSet ds = await myDb.LoadDataset(cmdText);
        return ds;
    }
