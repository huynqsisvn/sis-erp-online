            model.LsData = listObj;
        }
        else
        {
            DataTable TblPrint = TblData.Select("in_ck = 1").CopyToDataTable();
            TblPrint.DefaultView.Sort = "stt, ma_so";
            List<Gltcd200> listObj = myDb.ConvertDataTable<Gltcd200>(TblPrint);
            model.LsData = listObj;
        }
        model.Tu_ngay = Ngay_ct1;
        model.Den_ngay = Ngay_ct2;
        model.Ngay_dkt = Ngay_ct01;
        model.Ngay_ckt = Ngay_ct02;
        model.Ngay_bd_lk = Ngay_bd_lk;
        model.MaDVCS = MaDVCS;
        model.Mau_bc = Mau_bc;
        model.Ma_nt0 = M_ma_nt0;
        LsData.Add(model);
        ShowPrint = true;
    }
    private async void oBrowse_F5()
    {
        if (CurItem == null)
        {
            myStateMN.SetNewThongbao(Lap["Please select a row to view detail"] + " !");
            return;
        }
        else
        {
            var selectedObj = CurItem as DataRowView;
            if (selectedObj != null)
            {
                MaDVCS = myStateMN.GetMa_Dvcs(); MaDVCS = MaDVCS == "ALL" ? "" : MaDVCS.Trim();
                var cells = selectedObj.Row;
                if (cells["kind"].ToString().Trim() != "2")
                    return;

                string tk1 = cells["tk_no"].ToString().Trim().Replace(" ", "");
                string tk2 = cells["tk_co"].ToString().Trim().Replace(" ", "");
                if (tk2 == "" && tk1 == "")
                    return;

                string str1;
                if (tk1.Length > 0 && tk1 != "#")
                {
                    str1 = " AND (ABS(ct00.ps_no) + ABS(ct00.ps_no_nt)) != 0" + " AND (ct00.tk LIKE '" + tk1.Replace(",", "%' OR ct00.tk LIKE '") + "%')";
                    if (tk2.Length > 0 && tk2 != "#")
                        str1 = str1 + " AND (ct00.tk_du LIKE '" + tk2.Replace(",", "%' OR ct00.tk_du LIKE '") + "%')";
                    else if (tk2.Length > 0)
                    {
                        string str2 = this.OtherAccounts(tk1, "CO");
                        str1 = str1 + " AND NOT (ct00.tk_du LIKE '" + str2.Replace(",", "%' OR ct00.tk_du LIKE '") + "%')";
                    }
                }
                else
                {
                    str1 = " AND (ABS(ct00.ps_co) + ABS(ct00.ps_co_nt)) != 0" + " AND (ct00.tk LIKE '" + tk2.Replace(",", "%' OR ct00.tk LIKE '") + "%')";
                    if (tk1 == "#")
                    {
                        string str2 = this.OtherAccounts(tk2, "NO");
                        str1 = str1 + " AND NOT (ct00.tk_du LIKE '" + str2.Replace(",", "%' OR ct00.tk_du LIKE '") + "%')";
                    }
                }
                string CommandText = "SELECT IDENTITY(INT,1,1) as stt, ct00.* , dmct.ma_ct_in AS ma_ct0, dmkh.ten_kh, dmkh.ten_kh2 INTO #tmp  FROM ct00 INNER JOIN dmct ON ct00.ma_ct = dmct.ma_ct LEFT JOIN dmkh ON ct00.ma_kh = dmkh.ma_kh WHERE ngay_ct BETWEEN '" + Ngay_ct1.ToString("yyyyMMdd") + "' AND '" + Ngay_ct2.ToString("yyyyMMdd") + "'" + str1 + " AND ct00.ma_dvcs LIKE '" + MaDVCS + "%' ORDER BY ngay_ct, so_ct; SELECT * FROM #tmp";
                DataSet dataSet = myDb.LoadDataSet(CommandText);
                if (dataSet.Tables.Count > 0)
                    TblDataCT = dataSet.Tables[0];
                else
                    TblDataCT = new DataTable();

                FbrowseCT = sFieldArrays.Length > 1 ? sFieldArrays[1] : string.Empty;
                Tk_ct = Lap["Detail"] + ": " + tk1 + (!(tk1 != "") || !(tk2 != "") ? "" : ",") + tk2;
            }
        }
        IsDetail = true;
        ShowDetailToolBar();

        // update active id to detail browse
        _ = SetActiveComponentIdAsync("oBrowseCT");

        StateHasChanged();
    }
    private string OtherAccounts(string tk, string type)
    {
        DataRow[] dataRowArray = !(type == "CO") ? TblData.Select("tk_no <> '#' AND TRIM(tk_co) <> '' AND kind = '2'") : TblData.Select("tk_co <> '#' AND TRIM(tk_no) <> '' AND kind = '2'");
        string str1 = "";
        foreach (DataRow dataRow in dataRowArray)
        {
            object obj1 = dataRow["tk_no"];
            object obj2 = dataRow["tk_co"];
            if (obj1 == null || obj1 is DBNull)
                obj1 = (object)"";
            if (obj2 == null || obj2 is DBNull)
                obj2 = (object)"";
            int num = 0;
            string str2;
            string str3;
            if (type == "CO")
            {
                str2 = obj1.ToString();
                str3 = obj2.ToString();
            }
            else
            {
                str2 = obj2.ToString();
                str3 = obj1.ToString();
            }
            string[] strArray = tk.Split(",".ToCharArray());
            foreach (string str4 in strArray)
            {
                foreach (string str5 in str2.Split(",".ToCharArray()))
                {
                    if (str5.StartsWith(str4))
                        ++num;
                }
            }
            if (num == strArray.Length)
                str1 = str1 + "," + str3.Trim();
        }
        return str1.Length == 0 ? "" : tk60 + tk + str1;
    }
    public async Task ShowDetailToolBar()
    {
        myStateMN.SetToolBar(new MyToolbar("toolbar", true));
        myStateMN.SetToolBar(new MyToolbar("Quit", true, "Esc"));
        myStateMN.SetToolBar(new MyToolbar("Export", true));
    }
    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("Bold") && row["Bold"].ToString().Trim() == "1")
        {
            return "bold-item";
        }
        return "";
