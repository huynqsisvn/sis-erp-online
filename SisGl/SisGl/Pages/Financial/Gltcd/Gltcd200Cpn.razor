                string[] strArray1 = M_TT_QD.Split(':');

                TblData.DefaultView.Sort = "stt, ma_so";
            }
            else
            {
                TblData = new DataTable();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
