@page "/fxbcccth2"
@page "/fxbcccth2/{Menu_id}"
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,fxbcccth2")]
@using SisFx.Pages.Report.FXBCCCTH2

<div class="row" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowseComponent @ref="@oBrowse"
                        TblData="@TblData"
                        Fbrowse="@Fbrowse"
                        SelectItem="@SelectedItem"
                        RowStyleFunc="@GetRowStyle"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@* ================================================================
   BỘ LỌC BÁO CÁO: BẢNG TỔNG HỢP GIÁ TRỊ CCDC - THEO NHIỀU CHỈ TIÊU
   ================================================================ *@
<DxPopup @ref="popFilter"
         CloseOnOutsideClick="false"
         CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="560px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="d-flex justify-content-center align-items-center p-4">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">@Lap["Filtering data..."]</span>
                </div>
                <span class="ms-3 fs-6 text-primary">@Lap["Loading data, please wait..."]</span>
            </div>
        }
        else
        {
            <div class="container pt-1 pb-2">
                <DxFormLayout CssClass="w-100" onkeydown="ModifyEnterKeyPressAsTab(event);">

                    @* --- NĂM --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Year:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <DxSpinEdit @bind-Value="@FilterNam" DisplayFormat="####" MinValue="1900" MaxValue="2079" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- KỲ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Period (1-12):"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy" MinValue="1" MaxValue="12"
                                                ValueChanged="@((int v) => { FilterKy = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy >= 1 && FilterKy <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy, 1).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- ĐẦU KỲ / CUỐI KỲ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Start/End period:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <DxComboBox Data="@LstDauCuoi" @bind-Value="@FilterDauCuoi"
                                            ValueFieldName="Value"
                                            TextFieldName="@(IsLangEn ? "Text2" : "Text")" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- CHỌN CÁC CHỈ TIÊU (CÓ THỂ CHỌN NHIỀU) --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Summary criteria:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%; position: relative;">
                                <div id="combo-nhom-cc2-target" @onclick="() => IsDropdownOpen = !IsDropdownOpen" style="cursor: pointer;">
                                    <DxTextBox Text="@GetSummaryText()" ReadOnly="true" CssClass="w-100" />
                                    <i class="fa fa-caret-down" style="position: absolute; right: 10px; top: 10px; color: #6c757d;"></i>
                                </div>
                                <DxDropDown @bind-IsOpen="@IsDropdownOpen"
                                            PositionTarget="#combo-nhom-cc2-target"
                                            PositionMode="DropDownPositionMode.Bottom"
                                            CloseMode="DropDownCloseMode.Close"
                                            Width="380px">
                                    <BodyTemplate Context="dropContext">
                                        <DxListBox Data="@DanhSachNhom"
                                                   @bind-Values="@NhomDuocChon"
                                                   ValueFieldName="Value"
                                                   TextFieldName="Text"
                                                   ShowCheckboxes="true"
                                                   SelectionMode="ListBoxSelectionMode.Multiple"
                                                   Style="max-height: 250px; overflow-y: auto; white-space: nowrap;" />
                                    </BodyTemplate>
                                </DxDropDown>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- MẪU VND/NGOẠI TỆ (read only) --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Currency type:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <DxTextBox Text="VND" ReadOnly="true" CssClass="w-100" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- ĐIỀU KIỆN LỌC NÂNG CAO --- *@

                    @* Nhóm công cụ *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tool group:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhomcc" @bind-Value="@FilterNhCc" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Loại cc *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tool type:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmplcc" @bind-Value="@FilterLoaiCc" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Mã BPSD *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Dep. using:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmbpts" @bind-Value="@FilterMaBpcc" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Tk phân bổ *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Alloc. acc:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmtk" @bind-Value="@FilterTkPb" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Tk chi phí *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Expense account:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmtk" @bind-Value="@FilterTkCp" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Nhóm cc 1 *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sub-group 1:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhcc1" @bind-Value="@FilterNhCc1" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Nhóm cc 2 *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sub-group 2:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhcc2" @bind-Value="@FilterNhCc2" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* Nhóm cc 3 *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sub-group 3:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhcc3" @bind-Value="@FilterNhCc3" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                </DxFormLayout>

                @if (Errors.Any())
                {
                    <div class="alert alert-danger mt-3 p-2 mb-0">
                        <ul class="mb-0 ps-3">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="d-flex justify-content-end gap-2 m-2">
                <DxButton RenderStyle="ButtonRenderStyle.Success"
                          Text="@Lap["OK"]"
                          IconCssClass="fa fa-check"
                          Click="@ConfirmGridView_OnOk" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="@Lap["Cancel"]"
                          IconCssClass="fa fa-times"
                          Click="@BtnCancel" TabIndex="-1" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 20px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@code {
    // ===== Filter fields =====
    private int FilterNam = DateTime.Now.Year;
    private int FilterKy = DateTime.Now.Month;
    private string FilterDauCuoi = "2";
    private string FilterMaDvcs = "";
    private string FilterNhCc = "";
    private string FilterLoaiCc = "";
    private string FilterMaBpcc = "";
    private string FilterTkPb = "";
    private string FilterTkCp = "";
    private string FilterNhCc1 = "";
    private string FilterNhCc2 = "";
    private string FilterNhCc3 = "";

    private List<string> Errors { get; set; } = new();

    private static readonly List<object> LstDauCuoi = new()
    {
        new { Value = "1", Text = "1 - Đầu kỳ",  Text2 = "1 - Beginning period" },
        new { Value = "2", Text = "2 - Cuối kỳ", Text2 = "2 - End period" },
    };

    // ===== Multi-criteria selection =====
    public class NhomTieuChi
    {
        public string Value { get; set; }
        public string Text { get; set; }
    }

    private IEnumerable<NhomTieuChi> DanhSachNhom { get; set; } = new List<NhomTieuChi>();
    private IEnumerable<string> NhomDuocChon { get; set; } = new List<string> { "1", "2", "3", "4", "5", "6", "7", "8" };
    private bool IsDropdownOpen = false;

    private void InitDanhSachNhom()
    {
        DanhSachNhom = new List<NhomTieuChi>
        {
            new NhomTieuChi { Value = "1", Text = IsLangEn ? "By tool type"        : "Theo loại cc"    },
            new NhomTieuChi { Value = "2", Text = IsLangEn ? "By dept. using"      : "Theo BPSD"       },
            new NhomTieuChi { Value = "3", Text = IsLangEn ? "By tool group"       : "Theo nhóm cc"    },
            new NhomTieuChi { Value = "4", Text = IsLangEn ? "By expense account"  : "Theo tk cp"      },
            new NhomTieuChi { Value = "5", Text = IsLangEn ? "By company unit"     : "Theo ĐVCS"       },
            new NhomTieuChi { Value = "6", Text = IsLangEn ? "By sub-group 1"      : "Theo nhóm cc 1"  },
            new NhomTieuChi { Value = "7", Text = IsLangEn ? "By sub-group 2"      : "Theo nhóm cc 2"  },
            new NhomTieuChi { Value = "8", Text = IsLangEn ? "By sub-group 3"      : "Theo nhóm cc 3"  },
        };
    }

    private string GetSummaryText()
    {
        if (NhomDuocChon == null || !NhomDuocChon.Any() || DanhSachNhom == null || !DanhSachNhom.Any())
            return IsLangEn ? "None selected" : "Chưa chọn";

        if (NhomDuocChon.Count() == DanhSachNhom.Count())
            return IsLangEn ? "All" : "Tất cả";

        var selectedTexts = DanhSachNhom
            .Where(x => NhomDuocChon.Contains(x.Value))
            .Select(x => x.Text);

        return string.Join(", ", selectedTexts);
    }

    // Maps selection index to the inGroup columns expected by the SP
    private static readonly Dictionary<string, string> NhomToColumns = new()
    {
        { "1", "loai_cc,ten_loai,ten_loai2"         },
        { "2", "ma_bpcc,ten_bpts,ten_bpts2"          },
        { "3", "nh_cc,ten_nh_cc,ten_nh_cc2"          },
        { "4", "tk_cp,ten_tk_cp,ten_tk_cp2"          },
        { "5", "ma_dvcs,ten_dvcs,ten_dvcs2"          },
        { "6", "nh_cc1,ten_nh1,ten_nh1_2"            },
        { "7", "nh_cc2,ten_nh2,ten_nh2_2"            },
        { "8", "nh_cc3,ten_nh3,ten_nh3_2"            },
    };

    private string GetInGroup()
    {
        if (NhomDuocChon == null || !NhomDuocChon.Any())
            return string.Join(",", NhomToColumns.Values);

        var cols = NhomDuocChon
            .OrderBy(v => v)
            .Where(v => NhomToColumns.ContainsKey(v))
            .Select(v => NhomToColumns[v]);

        return string.Join(",", cols);
    }

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wf_xb_15";
        base.OnInitialized();

        FilterNam = myStateMN.GetStartDate().Year;
        FilterKy  = myStateMN.GetStartDate().Month;

        InitDanhSachNhom();
    }

    [JSInvokable]
    public async void GridFMode(string value, string Id)
    {
        // No print function for this report
    }

    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;

            if (curCommand != null)
                Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;

            InitDanhSachNhom();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void OnDvcsChanged(string ma_dvcs)
    {
        FilterMaDvcs = (ma_dvcs == "ALL" ? "" : ma_dvcs);
        await Loaddata();
        StateHasChanged();
    }

    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(new DateTime(FilterNam, FilterKy, 1));
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;

        if (FilterNam < 1900 || FilterNam > 2079)
        {
            Errors.Add(Lap["Year is invalid (must be > 0)."]);
            ok = false;
        }
        if (FilterKy < 1 || FilterKy > 12)
        {
            Errors.Add(Lap["Period must be 1 to 12."]);
            ok = false;
        }
        if (NhomDuocChon == null || !NhomDuocChon.Any())
        {
            Errors.Add(Lap["Please select at least one summary criteria."]);
            ok = false;
        }

        StateHasChanged();
        return ok;
    }

    async Task Loaddata()
    {
        try
        {
            ShowLoadding = true;
            StateHasChanged();

            if (curCommand != null)
            {
                string[] sFieldArrays = IsLangEn
                    ? (Mau_bc != 0 ? curCommand.Ebrowse2?.Split("|") : curCommand.Ebrowse1?.Split("|"))
                    : (Mau_bc != 0 ? curCommand.Vbrowse2?.Split("|") : curCommand.Vbrowse1?.Split("|"));

                Fbrowse = sFieldArrays != null && sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
            }

            string condition = BuildCondition();
            string inGroup   = GetInGroup();

            string[] pNames  = new string[] { "nNam", "nKy", "cDau_cuoi", "ma_bp", "cKey", "inGroup" };
            object[] pValues = new object[] { FilterNam, FilterKy, FilterDauCuoi, FilterMaBpcc, condition, inGroup };

            string store = curCommand?.Store_proc?.Split('|')[0] ?? "FXBCCCTH2";

            var ds = await myDb.LoadStoreProcedure(store, pNames, pValues);

            if (ds != null && ds.Tables.Count > 0)
            {
                TblData = ds.Tables[0].Copy();
                TblData.TableName = "tbDetail";
            }
            else
            {
                TblData = new DataTable();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            myStateMN.SetNewThongbao(Lap["Error loading data:"] + " " + ex.Message);
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    private static string Esc(string s) => s?.Trim().Replace("'", "''") ?? "";

    private string BuildCondition()
    {
        var parts = new List<string> { "1=1" };

        if (!string.IsNullOrWhiteSpace(FilterMaDvcs))
            parts.Add($"ma_dvcs LIKE '{Esc(FilterMaDvcs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc))
            parts.Add($"nh_cc LIKE '{Esc(FilterNhCc)}%'");

        if (!string.IsNullOrWhiteSpace(FilterLoaiCc))
            parts.Add($"loai_cc LIKE '{Esc(FilterLoaiCc)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkPb))
            parts.Add($"tk_pb LIKE '{Esc(FilterTkPb)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkCp))
            parts.Add($"tk_cp LIKE '{Esc(FilterTkCp)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc1))
            parts.Add($"nh_cc1 LIKE '{Esc(FilterNhCc1)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc2))
            parts.Add($"nh_cc2 LIKE '{Esc(FilterNhCc2)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc3))
            parts.Add($"nh_cc3 LIKE '{Esc(FilterNhCc3)}%'");

        return string.Join(" AND ", parts);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            FilterMaDvcs = myStateMN.GetMa_Dvcs();
            FilterMaDvcs = (FilterMaDvcs == "ALL" ? "" : FilterMaDvcs);

            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync($"fx-{(IsLangEn ? "en" : "vi")}");

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged    += OnLangguachange;
            myStateMN.OnDvcsChanged       += OnDvcsChanged;

            PopupVisible = true;
            StateHasChanged();
        }
        else
        {
            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
    }

    public override void Dispose()
    {
        try
        {
            myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
            myStateMN.OnLangguaChanged    -= OnLangguachange;
            myStateMN.OnDvcsChanged       -= OnDvcsChanged;
        }
        catch { }
    }

    string GetRowStyle(DataRowView row)
    {
        if (row.Row.Table.Columns.Contains("bold") && row["bold"]?.ToString()?.Trim() == "1")
            return "bold-item";
        return "";
    }

    public override async void ExportData(int type)
    {
        oBrowse?.ExPortGrid(type);
        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }

    public override async void Print() { }

    void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
}
