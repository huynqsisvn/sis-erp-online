@page "/fxthecc"
@page "/fxthecc/{Menu_id}"
@inherits RepoBaseComponent
@attribute [Authorize(Roles = "admin,fxthecc")]
@using SisFx.Pages.Report.FXTHECC
@using System.Data

<div class="row" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowse3Component @ref="@oBrowse3"
                         TblData="@TblData"
                         Fbrowse="@Fbrowse"
                         SelectItem="@SelectedItem"
                         SelectCol="tag"
                         IsLangEn="@IsLangEn">
    </FrmBrowse3Component>
</div>

@* ================================================================
   BỘ LỌC BÁO CÁO: THẺ CÔNG CỤ, DỤNG CỤ
   ================================================================ *@
<DxPopup @ref="popFilter"
         CloseOnOutsideClick="false"
         CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="560px"
         Height="Auto"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Title">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="d-flex justify-content-center align-items-center p-4">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">@Lap["Filtering data..."]</span>
                </div>
                <span class="ms-3 fs-6 text-primary">@Lap["Loading data, please wait..."]</span>
            </div>
        }
        else
        {
            <div class="container pt-1 pb-2">
                <DxFormLayout CssClass="w-100" onkeydown="ModifyEnterKeyPressAsTab(event);">

                    @* --- NĂM --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Year:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <DxSpinEdit @bind-Value="@FilterNam" DisplayFormat="####" MinValue="1900" MaxValue="2079" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- MÃ CÔNG CỤ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tool code:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmcc" @bind-Value="@FilterMaCc" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- MẪU VND/NGOẠI TỆ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Currency type:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <DxComboBox Data="@LstMauBC" @bind-Value="@Mau_bc" ValueFieldName="Value" TextFieldName="Text" IsEnabled="false" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- NHÓM CÔNG CỤ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tool group:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhomcc" @bind-Value="@FilterNhCc" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- LOẠI CÔNG CỤ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tool type:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmplcc" @bind-Value="@FilterLoaiCc" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- MÃ BPSD --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Usage dept. code:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmbpsd" @bind-Value="@FilterMaBpsd" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- TK CHI PHÍ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Expense account:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmtk" @bind-Value="@FilterTkCp" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- NHÓM CC 1 --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sub-group 1:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhcc1" @bind-Value="@FilterNhCc1" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- NHÓM CC 2 --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sub-group 2:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhcc2" @bind-Value="@FilterNhCc2" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- NHÓM CC 3 --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Sub-group 3:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <AutocompleteComponent CssClass="col p-0" Ma_dm="dmnhcc3" @bind-Value="@FilterNhCc3" IsEnable="true" IsLangEn="@IsLangEn" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                </DxFormLayout>

                @if (Errors.Any())
                {
                    <div class="alert alert-danger mt-3 p-2 mb-0">
                        <ul class="mb-0 ps-3">
                            @foreach (var err in Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="d-flex justify-content-end gap-2 m-2">
                <DxButton RenderStyle="ButtonRenderStyle.Success"
                          Text="@Lap["OK"]"
                          IconCssClass="fa fa-check"
                          Click="@ConfirmGridView_OnOk" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="@Lap["Cancel"]"
                          IconCssClass="fa fa-times"
                          Click="@BtnCancel" TabIndex="-1" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@* ================================================================
   HÀNG ĐỢI IN — HIỆN POPUP LẦN LƯỢT CHO TỪNG BẢN GHI
   ================================================================ *@
@if (PrintQueue != null && PrintQueue.Any())
{
    var currentPrintJob = PrintQueue.First();
    <DxPopup @key="currentPrintJob.Id"
             Visible="true"
             VisibleChanged="@((bool v) => { if (!v) ClosePrintWindow(currentPrintJob); })"
             CloseOnOutsideClick="false"
             CloseOnEscape="true"
             CssClass="dxPopup"
             Width="80%" Height="90%"
             ShowFooter="false"
             HeaderText="@currentPrintJob.Title">
        <BodyTemplate>
            <ReportOptionComponent LSItems="@currentPrintJob.Data"
                                   Menu_id="@Menu_id.Replace('_', '.')"
                                   OnBack="@(() => ClosePrintWindow(currentPrintJob))" />
        </BodyTemplate>
    </DxPopup>
}

<style>
    .popup-button-footer {
        width: 100px;
        margin-right: 20px;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@code {
    // ===== Filter fields =====
    private int FilterNam = DateTime.Now.Year;
    private string FilterMaDvcs = "";
    private string FilterMaCc = "";
    private string FilterLoaiCc = "";
    private string FilterNhCc = "";
    private string FilterMaBpsd = "";
    private string FilterTkCp = "";
    private string FilterNhCc1 = "";
    private string FilterNhCc2 = "";
    private string FilterNhCc3 = "";

    private List<string> Errors { get; set; } = new();
    private List<FXTHECCModel> LsData;
    private FrmBrowse3Component oBrowse3;

    // ===== Hàng đợi in — gọi SP Print1 cho từng dòng =====
    public class PrintJob
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; }
        public List<object> Data { get; set; }
    }

    private List<PrintJob> PrintQueue = new();

    protected override async Task OnInitializedAsync()
    {
        Menu_id = Menu_id ?? "wf.xb.16";
        base.OnInitialized();

        FilterNam = myStateMN.GetStartDate().Year;
    }

    [JSInvokable]
    public async void GridFMode(string value, string Id)
    {
        if (!string.IsNullOrEmpty(value) && value.Equals("F7"))
        {
            Print();
            StateHasChanged();
        }
    }

    private void OnActionTaskchanged(ActionTask ac)
    {
        switch (ac)
        {
            case ActionTask.Search:
                PopupVisible = true;
                StateHasChanged();
                break;
            case ActionTask.Print:
                Print();
                StateHasChanged();
                break;
            case ActionTask.Export:
                ExportData(1);
                break;
            case ActionTask.Export2:
                ExportData(2);
                break;
            case ActionTask.Export3:
                ExportData(3);
                break;
        }
    }

    private async void OnLangguachange(MyLang lang)
    {
        if (lang.IsnewLang)
            await Language();
    }

    async Task Language()
    {
        try
        {
            IsLangEn = false;
            UserLang = await myLcStore.GetItemAsync<string>("userlang");
            if (!string.IsNullOrEmpty(UserLang) && UserLang.Equals("En"))
                IsLangEn = true;

            if (curCommand != null)
                Fbrowse = IsLangEn ? curCommand.Ebrowse1 : curCommand.Vbrowse1;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async void OnDvcsChanged(string ma_dvcs)
    {
        await InvokeAsync(async () =>
        {
            FilterMaDvcs = (ma_dvcs == "ALL" ? "" : ma_dvcs);
            await Loaddata();
            StateHasChanged();
        });
    }

    private async void ConfirmGridView_OnOk()
    {
        if (!CheckValid()) return;
        PopupVisible = false;

        myStateMN.SetStartDate(new DateTime(FilterNam, 1, 1));
        myStateMN.SetEndDate(new DateTime(FilterNam, 12, 31));
        await Loaddata();
        StateHasChanged();
    }

    private bool CheckValid()
    {
        Errors.Clear();
        bool ok = true;
        if (FilterNam < 1900 || FilterNam > 2079)
        {
            Errors.Add(Lap["Year is invalid (must be > 0)."]);
            ok = false;
        }
        StateHasChanged();
        return ok;
    }

    async Task Loaddata()
    {
        try
        {
            ShowLoadding = true;
            StateHasChanged();

            if (curCommand != null)
            {
                string[] sFieldArrays = IsLangEn
                    ? (Mau_bc != 0 ? curCommand.Ebrowse2?.Split("|") : curCommand.Ebrowse1?.Split("|"))
                    : (Mau_bc != 0 ? curCommand.Vbrowse2?.Split("|") : curCommand.Vbrowse1?.Split("|"));

                Fbrowse = sFieldArrays != null && sFieldArrays.Length > 0 ? sFieldArrays[0] : Fbrowse;
            }

            string condition = BuildCondition();
            string ma_bpcc = FilterMaBpsd?.Trim() ?? "";

            string paramName = "nNam;ma_bpcc;cKey";
            string paramValue = $"{FilterNam};{ma_bpcc};{condition}";

            string store = curCommand?.Store_proc?.Split('|')[0] ?? "FxTheCc";

            var ds = await myDb.LoadStoreProcedure(store, paramName, paramValue);

            if (ds != null && ds.Tables.Count > 0)
            {
                TblData = ds.Tables[0].Copy();
                TblData.TableName = "tbDetail";

                // Ensure tag column exists as bool
                if (!TblData.Columns.Contains("tag"))
                    TblData.Columns.Add("tag", typeof(bool));
                foreach (DataRow r in TblData.Rows)
                    if (r["tag"] == DBNull.Value) r["tag"] = false;
            }
            else
            {
                TblData = new DataTable();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            myStateMN.SetNewThongbao(Lap["Error loading data:"] + " " + ex.Message);
        }
        finally
        {
            ShowLoadding = false;
            StateHasChanged();
        }
    }

    private static string Esc(string s) => s?.Trim().Replace("'", "''") ?? "";

    private string BuildCondition()
    {
        var parts = new List<string> { "1=1" };

        if (!string.IsNullOrWhiteSpace(FilterMaDvcs))
            parts.Add($"ma_dvcs LIKE '{Esc(FilterMaDvcs)}%'");

        if (!string.IsNullOrWhiteSpace(FilterMaCc))
            parts.Add($"ma_cc_me LIKE '{Esc(FilterMaCc)}%'");

        if (!string.IsNullOrWhiteSpace(FilterLoaiCc))
            parts.Add($"loai_cc LIKE '{Esc(FilterLoaiCc)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc))
            parts.Add($"nh_cc LIKE '{Esc(FilterNhCc)}%'");

        if (!string.IsNullOrWhiteSpace(FilterTkCp))
            parts.Add($"tk_cp LIKE '{Esc(FilterTkCp)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc1))
            parts.Add($"nh_cc1 LIKE '{Esc(FilterNhCc1)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc2))
            parts.Add($"nh_cc2 LIKE '{Esc(FilterNhCc2)}%'");

        if (!string.IsNullOrWhiteSpace(FilterNhCc3))
            parts.Add($"nh_cc3 LIKE '{Esc(FilterNhCc3)}%'");

        return string.Join(" AND ", parts);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurUser = myStateMN.GetCurUser();
            FilterMaDvcs = myStateMN.GetMa_Dvcs();
            FilterMaDvcs = (FilterMaDvcs == "ALL" ? "" : FilterMaDvcs);

            await PageLoad();
            await Language();
            await Lap.LoadLocalizationAsync($"fx-{(IsLangEn ? "en" : "vi")}");

            if (CurUser.Is_admin == 1 || CurUser.CheckRight(Menu_id.Replace("_", "."), "VIEW"))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("Search", true, "Ctrl + F"));
                myStateMN.SetToolBar(new MyToolbar("Print", true));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;

            PopupVisible = true;
            StateHasChanged();
        }
    }

    public override void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }

    public override async void ExportData(int type)
    {
        oBrowse3?.ExPortGrid(type);
        myStateMN.SetNewThongbao(Lap["Export successfully"]);
        StateHasChanged();
    }

    /// <summary>
    /// Get tagged rows (tag = true) from the browse grid
    /// </summary>
    private List<DataRowView> GetTaggedRows()
    {
        var result = new List<DataRowView>();
        try
        {
            if (TblData == null) return result;
            foreach (DataRowView rv in TblData.DefaultView)
            {
                if (TblData.Columns.Contains("tag") && rv["tag"] != DBNull.Value && (bool)rv["tag"])
                    result.Add(rv);
            }
        }
        catch { }
        return result;
    }

    public override async void Print()
    {
        var taggedRows = GetTaggedRows();

        if (taggedRows.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["Select tools before printing"]);
            return;
        }

        // Clear print queue
        PrintQueue.Clear();

        // For each tagged row, call SP Print1 to get full data
        foreach (var rv in taggedRows)
        {
            string ma_cc = rv["ma_cc"]?.ToString()?.Trim() ?? "";

            try
            {
                // Call SP [FxTheCc-Print1] @nNam, @nKy, @sothecc
                // Returns 4 result sets: tMtemp1, qrcttmp, tmpInfo, tempEmpty
                var dsPrint = await myDb.LoadStoreProcedure("FxTheCc-Print1", 
                    "@nNam;@nKy;@sothecc",
                    $"{FilterNam};12;{ma_cc}");

                var model = new FXTHECCModel
                {
                    Nam = FilterNam,
                    Ky = 12,
                    Ma_bpcc = FilterMaBpsd,
                    Ma_dvcs = FilterMaDvcs,
                    LoaiBC = Mau_bc.ToString(),
                    tMtemp1 = myDb.ConvertDataTable<FXTHECCPrint1_TMtemp1>(dsPrint.Tables[0]),
                    Accessories = myDb.ConvertDataTable<FXTHECCPrint1_Accessory>(dsPrint.Tables[1]),
                    tmpInfo = myDb.ConvertDataTable<FXTHECCPrint1_Info>(dsPrint.Tables[2]),
                    tempEmpty = myDb.ConvertDataTable<FXTHECCPrint1_Empty>(dsPrint.Tables[3])
                };

                // Create print job
                var job = new PrintJob
                {
                    Title = $"In thẻ công cụ: {ma_cc}",
                    Data = new List<object> { model }
                };

                PrintQueue.Add(job);
            }
            catch (Exception ex)
            {
                myStateMN.SetNewThongbao($"Lỗi tải dữ liệu in cho {ma_cc}: {ex.Message}");
                Console.WriteLine($"Print SP error for {ma_cc}: {ex.Message}");
            }
        }

        // Trigger UI update to show first popup
        if (PrintQueue.Any())
            await InvokeAsync(StateHasChanged);
        else
            myStateMN.SetNewThongbao("Không có dữ liệu để in");
    }

    protected void ClosePrintWindow(PrintJob job)
    {
        if (PrintQueue.Contains(job))
        {
            PrintQueue.Remove(job);
            StateHasChanged();
        }
    }

    void BtnCancel()
    {
        PopupVisible = false;
        StateHasChanged();
    }
}
