@page "/fxplcc"
@page "/fxplcc/{Menu_id}"
@inherits ListBaseComponent
@attribute [Authorize(Roles = "admin,fxplcc")]

<div class="row mt-1">
    <FrmBrowseComponent @ref="oBrowse"
                        TblData="@TblData"
                        Fbrowse="@fbrowse"
                        Page_size="@Page_size"
                        SelectItem="CurItem"
                        OnRowDbClick="@OnRDBClick"
                        IsLangEn="@IsLangEn">
    </FrmBrowseComponent>
</div>

@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true" Width="30vw"
              MinWidth="300px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}

@if (IDVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="50vw"
             @bind-Visible="@IDVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmChangeListID @bind-Visible="@IDVisible"
                                 List_ID="@sqlTableName"
                                 Ma_ma="@SqlTableKeyValue"
                                 Title="@Lap["Change tool type code"]"
                                 Ten_item="@Ten_item"
                                 OnOK="@ChangeOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@if (IsImportPopupVisible)
{
    <DxPopup @ref="@OptwRef"
             ShowFooter="false"
             ShowHeader="false"
             MinWidth="40vw"
             @bind-Visible="@IsImportPopupVisible"
             CloseOnEscape="true"
             ShowCloseButton="false"
             AllowResize="true"
             AllowDrag="true"
             AllowDragByHeaderOnly="true">
        <BodyContentTemplate>
            <div class="row">
                <FrmImportDM @bind-IsImportPopupVisible="@IsImportPopupVisible"
                             CurDmimex="@CurDmimex"
                             OnImportCompleted="@ImportOK" />
            </div>
        </BodyContentTemplate>
    </DxPopup>
}

@code {
    private const string DefaultFbrowseVN = "loai_cc:100:h=Mã loại cc;ten_loai:250:h=Tên loại cc;ten_loai2:250:h=Tên 2;date:100:h=Ngày sửa:D;time:80:h=Giờ sửa;user_name:100:h=Người sửa;date0:100:h=Ngày tạo:D;time0:80:h=Giờ tạo;user_name0:100:h=Người tạo";
    private const string DefaultFbrowseEN = "loai_cc:100:h=Tool type code;ten_loai:250:h=Tool type name;ten_loai2:250:h=Name 2;date:100:h=Modified date:D;time:80:h=Modified time;user_name:100:h=Modified by;date0:100:h=Created date:D;time0:80:h=Created time;user_name0:100:h=Created by";

    protected override void OnInitialized()
    {
        mPage = "fxplcc";
        IsShowCopy = true;
        IsShowImport = true;
        sqlTableName = "dmplcc";
        sqlTableView = "dmplcc";
        SqlTableKey = "loai_cc";
        FrmType = typeof(SisFx.Pages.List.FXPLCC.EditFxplcc);

        if (String.IsNullOrEmpty(Menu_id))
            Menu_id = "wf.xd.03";

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Language();
            await PageLoad();
            await Lap.LoadLocalizationAsync($"fx-{(IsLangEn ? "en" : "vi")}");

            string Menuid = Menu_id.Replace("_", ".");
            if (curUser != null && (curUser.Is_admin == 1 || curUser.CheckRight(Menuid, "VIEW")))
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", true));
                myStateMN.SetToolBar(new MyToolbar("New", true, "F4"));
                myStateMN.SetToolBar(new MyToolbar("Copy", IsShowCopy, ""));
                myStateMN.SetToolBar(new MyToolbar("Import", false));
                myStateMN.SetToolBar(new MyToolbar("Edit", true, "F3"));
                myStateMN.SetToolBar(new MyToolbar("Save", false));
                myStateMN.SetToolBar(new MyToolbar("Delete", true, "F8"));
                myStateMN.SetToolBar(new MyToolbar("Change", true));
                myStateMN.SetToolBar(new MyToolbar("View", true, "F2"));
                myStateMN.SetToolBar(new MyToolbar("Aproval", false));
                myStateMN.SetToolBar(new MyToolbar("Print", false));
                myStateMN.SetToolBar(new MyToolbar("Export", true));
                myStateMN.SetToolBar(new MyToolbar("Search", false));
                myStateMN.SetToolBar(new MyToolbar("Quit", false));
            }
            else
            {
                myStateMN.SetToolBar(new MyToolbar("toolbar", false));
            }

            myStateMN.OnActionTaskChanged += OnActionTaskchanged;
            myStateMN.OnLangguaChanged += OnLangguachange;
            myStateMN.OnDvcsChanged += OnDvcsChanged;

            await Loaddata();
            StateHasChanged();
        }
    }

    public override async Task PageLoad()
    {
        try
        {
            curCommand = await myCommand.GetSubMenuBymenuId(Menu_id.Replace("_", "."));
            if (curCommand != null)
            {
                fbrowse = IsLangEn ? curCommand.Vbrowse2 : curCommand.Vbrowse1;
                string pSize = myOption.GetOptionsValue("M_GRID_NROW");
                Page_size = string.IsNullOrEmpty(pSize) ? 50 : int.Parse(pSize.Trim());
            }

            if (string.IsNullOrEmpty(fbrowse))
            {
                fbrowse = IsLangEn ? DefaultFbrowseEN : DefaultFbrowseVN;
                string pSize = myOption.GetOptionsValue("M_GRID_NROW");
                Page_size = string.IsNullOrEmpty(pSize) ? 50 : int.Parse(pSize.Trim());
            }
        }
        catch (Exception ex)
        {
            fbrowse = IsLangEn ? DefaultFbrowseEN : DefaultFbrowseVN;
            Console.WriteLine("PageLoad error: " + ex.Message);
        }
        StateHasChanged();
    }

    public override async Task Loaddata()
    {
        SelectedItem = null;
        try
        {
            string sql = $"SELECT * FROM {sqlTableView} ORDER BY loai_cc";
            DataSet dsList = await myDb.LoadDataset(sql);
            TblData = dsList?.Tables[0];

            if (TblData != null && TblData.DefaultView.Count > 0)
                SelectedItem = TblData.DefaultView[0];

            if (oBrowse != null)
                await oBrowse.FocusGridAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Loaddata error: " + ex.Message);
        }
        StateHasChanged();
    }

    private async void OnDvcsChanged(string _ma_dvcs)
    {
        await Loaddata();
        StateHasChanged();
    }

    public async void CloseForm()
    {
        IsShowFrm = false;
        await Loaddata();
        StateHasChanged();
    }

    private async void OnActionTaskchanged(ActionTask task)
    {
        if (task == ActionTask.Delete)
        {
            bool isValid = await ValidateBeforeDelete();
            if (!isValid)
            {
                myStateMN.SetCurrentActionTask(ActionTask.None);
                return;
            }
        }
        try { base.OnActionTaskchanged(task); } catch { }
    }

    async Task<bool> ValidateBeforeDelete()
    {
        if (SelectedItem == null) return false;

        System.Data.DataRowView row = SelectedItem as System.Data.DataRowView;
        if (row == null) return false;

        string loaiCc = row["loai_cc"].ToString().Trim();

        int checkResult = await CheckDeleteListIdAsync(loaiCc);

        if (checkResult > 0)
        {
            return true;
        }
        else
        {
            myStateMN.SetNewThongbao(Lap["Tool type has transactions, cannot delete"]);
            return false;
        }
    }

    private async Task<int> CheckDeleteListIdAsync(string loaiCc)
    {
        int result = 0;
        try
        {
            string sql = $"SET NOCOUNT ON; exec dbo.CheckDeleteListId 'dmplcc', '{loaiCc}'";
            DataSet ds = await myDb.LoadDataset(sql);

            if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                var val = ds.Tables[0].Rows[0][0];
                if (val != DBNull.Value)
                    result = Convert.ToInt32(val);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi kiểm tra xóa: " + ex.Message);
        }
        return result;
    }

    public override async void Dispose()
    {
        myStateMN.OnActionTaskChanged -= OnActionTaskchanged;
        myStateMN.OnLangguaChanged -= OnLangguachange;
        myStateMN.OnDvcsChanged -= OnDvcsChanged;
    }
}
