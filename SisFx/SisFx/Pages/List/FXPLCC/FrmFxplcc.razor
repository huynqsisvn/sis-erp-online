@page "/frmfxplcc"
@page "/frmfxplcc/{menu_id}"
@page "/frmfxplcc/{menu_id}/{loai_cc}"
@inject Statemanagerment myStatemanagerment
@inject NavigationManager navigation
@inject IDbManager myDb
@inject IJSRuntime JavacriptS
@inject IStringLocalizer<FxplccComponent> Lap

<DxPopup @bind-Visible="@PopVisible"
         ShowFooter="false" ShowHeader="false"
         CloseOnEscape="false"
         CloseOnOutsideClick="false"
         ShowCloseButton="false"
         Width="auto"
         MinWidth="650px"
         MinHeight="200px"
         MaxHeight="98vh"
         AllowResize="true"
         AllowDrag="true"
         AllowDragByHeaderOnly="true">
    <BodyTemplate>
        <div class="row">
            <EditFxplcc Ma_ma="@loai_cc" Menu_id="@menu_id" curActionTask="@curActionTask" ShowAdd="@ShowAdd" OnClose="ClickHandler"></EditFxplcc>
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string menu_id { get; set; }
    [Parameter] public string loai_cc { get; set; }
    [Parameter] public ActionTask curActionTask { get; set; } = ActionTask.None;
    [Parameter] public bool ShowAdd { get; set; }

    public bool PopVisible { get; set; } = true;

    protected override void OnInitialized()
    {
        if (curActionTask == ActionTask.None)
        {
            curActionTask = myStatemanagerment.GetCurrentActionTask();
        }
    }

    private void ClickHandler()
    {
        PopVisible = false;
        OnClose.InvokeAsync();
    }
}
