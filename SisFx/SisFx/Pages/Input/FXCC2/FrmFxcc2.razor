@inherits FrmListBaseComponent
@using SisFx.Pages.Input.FXCC
@using SisFx.Pages.Input.FXCC2
@using DevExpress.Blazor
@using System.Data
@using System.Linq
@inject IJSRuntime JSRuntime
@implements IDisposable
<FormList Title="@Title"
          @bind-curActionTask="@curActionTask"
          OnSave="@SaveDM"
          OnCancel="@CancelForm">

    <div class="row m-1 me-2" style="min-height: 360px; align-content: flex-start;">
        <DxFormLayout ItemSizeMode="@Itemsizemode" CssClass="frm-header">
            <DxFormLayoutTabPages ColSpanMd="12" CssClass="css-fxcc2-detail" @bind-ActiveTabIndex="@ActiveTabIndex">

                @* ===== TAB 1: THÔNG TIN CHÍNH ===== *@
                <DxFormLayoutTabPage Caption="@Lap["Main info"]" CaptionCssClass="fw-bold">
                    <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="mt-3">

                        <DxFormLayoutItem Caption="@Lap["Tool code:"]" ColSpanMd="6" CaptionCssClass="fw-bold">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ma_cc_me" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Alt code:"]" ColSpanMd="6">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ma_tra_cuu" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Tool name:"]" ColSpanMd="12" CaptionCssClass="fw-bold">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ten_cc" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Tool group:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhomcc" @bind-Value="@CurDmcc.Nh_cc"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Tool type:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmplcc" @bind-Value="@CurDmcc.Loai_cc"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Increase reason:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmtgcc" Filter="loai_tg_cc = 1"
                                                       @bind-Value="@CurDmcc.Ma_tg_cc"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Increase date:"]" ColSpanMd="4">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_mua" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Voucher date:"]" ColSpanMd="4">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_ct" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Voucher no:"]" ColSpanMd="4">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.So_ct" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Alloc. type:"]" ColSpanMd="4">
                            <Template>
                                <DxComboBox Data="@ListKieuKH"
                                            Value="@CurDmcc.Kieu_kh_str"
                                            ValueFieldName="Value"
                                            TextFieldName="Text"
                                            Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Alloc. periods:"]" ColSpanMd="4" Visible="@(CurDmcc.Kieu_kh_str == kieukh1)">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.So_ky_kh" DisplayFormat="N0" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Alloc. start date:"]" ColSpanMd="4">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_kh0" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Residual value <=:"]" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.Tien_cl" DisplayFormat="N0" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Alloc. end date:"]" ColSpanMd="4">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_kt_kh" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Unit:"]" ColSpanMd="4">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Dvt" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Deferred alloc. acc:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@CurDmcc.Tk_kh"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Expense account:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@CurDmcc.Tk_cp"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Original cost:"]" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.Nguyen_gia" DisplayFormat="N0" ShowSpinButtons="false" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Allocated value:"]" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.Gt_da_kh" DisplayFormat="N0" ShowSpinButtons="false" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Remaining value:"]" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.Gt_cl" DisplayFormat="N0" ShowSpinButtons="false" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Alloc. value/period:"]" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.Gt_kh_ky" DisplayFormat="N0" ShowSpinButtons="false" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Cost dept:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmbpht" Filter="1=1" @bind-Value="@CurDmcc.Ma_bpht"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Workshop (dc):"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmpx" Filter="1=1" @bind-Value="@CurDmcc.Ma_px"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Fee code:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmphi" @bind-Value="@CurDmcc.Ma_phi"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Project:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmvv" Filter="1=1" @bind-Value="@CurDmcc.Ma_vv"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Sub-group 1:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhcc" Filter="loai_nh = 1" @bind-Value="@CurDmcc.Nh_cc1"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Sub-group 2:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhcc" Filter="loai_nh = 2" @bind-Value="@CurDmcc.Nh_cc2"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Sub-group 3:"]" ColSpanMd="4">
                            <Template>
                                <AutocompleteComponent Ma_dm="dmnhcc" Filter="loai_nh = 3" @bind-Value="@CurDmcc.Nh_cc3"
                                                       IsEnable="false" IsLangEn="@IsLangEn" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Company unit:"]" ColSpanMd="4">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ma_dvcs" ReadOnly="true" />
                            </Template>
                        </DxFormLayoutItem>

                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage>

                @* ===== TAB 2: THÔNG TIN PHỤ ===== *@
                <DxFormLayoutTabPage Caption="@Lap["Additional info"]" CaptionCssClass="fw-bold">
                    <DxFormLayoutGroup ColSpanMd="12" Decoration="FormLayoutGroupDecoration.None" CssClass="mt-3">

                        <DxFormLayoutItem Caption="@Lap["Name 2 (EN):"]" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ten_cc2" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Handover record no:"]" ColSpanMd="6">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.So_bbbg" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Handover date:"]" ColSpanMd="6">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_bbbg" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Tool serial no:"]" ColSpanMd="6">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.So_hieu_cc" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Technical specs:"]" ColSpanMd="6">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Cc_kt" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Country of origin:"]" ColSpanMd="6">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Nuoc_sx" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Manufacture year:"]" ColSpanMd="6">
                            <Template>
                                <DxSpinEdit @bind-Value="@CurDmcc.Nam_sx" DisplayFormat="####" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["In-service date:"]" ColSpanMd="6">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_dvsd" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@Lap["Suspension date:"]" ColSpanMd="6">
                            <Template>
                                <DxDateEdit @bind-Date="@CurDmcc.Ngay_dc" Format="dd/MM/yyyy" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Suspension reason:"]" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ly_do_dc" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="@Lap["Note:"]" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@CurDmcc.Ghi_chu" Enabled="false" />
                            </Template>
                        </DxFormLayoutItem>

                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage>

                @* ===== TAB 3: PHỤ TÙNG KÈM THEO ===== *@
                <DxFormLayoutTabPage Caption="@Lap["Accessories"]" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div class="mt-2 mb-3">
                                <DxGrid Data="@LstCtCtcc"
                                        SizeMode="@Itemsizemode"
                                        CssClass="w-100 grid-height-dynamic"
                                        AllowSelectRowByClick="true"
                                        KeyboardNavigationEnabled="true"
                                        @bind-SelectedDataItem="@SelectedCtCtcc"
                                        ValidationEnabled="false"
                                        EditMode="GridEditMode.EditRow"
                                        SelectionMode="GridSelectionMode.Single"
                                        EditNewRowPosition="@((GridEditNewRowPosition)(-1))"
                                        ShowAllRows="true"
                                        TextWrapEnabled="false"
                                        AllowSort="false"
                                        HighlightRowOnHover="true"
                                        FooterDisplayMode="GridFooterDisplayMode.Always">
                                    <Columns>
                                        <DxGridDataColumn FieldName="Stt" Caption="STT" Width="50px" ReadOnly="true" />
                                        <DxGridDataColumn FieldName="Ten_ptkt" Caption="@Lap["Accessory name"]" MinWidth="200" />
                                        <DxGridDataColumn FieldName="Dvt" Caption="@Lap["UOM"]" Width="100px" />
                                        <DxGridDataColumn FieldName="So_luong" Caption="@Lap["Quantity"]" Width="120px" DisplayFormat="N0" />
                                        <DxGridDataColumn FieldName="Gia_tri" Caption="@Lap["Value"]" Width="150px" DisplayFormat="N0" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>

                @* ===== TAB 4: ĐIỀU CHUYỂN BPSD ===== *@
                <DxFormLayoutTabPage Caption="@Lap["Dept. Transfer"]" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div class="mt-2 mb-3">
                                @* Top grid: All cards *@
                                <div style="margin-bottom: 10px;">
                                    <h6 class="fw-bold text-primary m-0 mb-1">@Lap["Select tool card"]</h6>
                                    <DxGrid Data="@LstCtDmcc" SizeMode="@Itemsizemode"
                                            CssClass="w-100" Style="height: 200px;"
                                            AllowSelectRowByClick="true"
                                            KeyboardNavigationEnabled="true"
                                            @bind-SelectedDataItem="@SelectedDcccCard"
                                            ValidationEnabled="false"
                                            SelectionMode="GridSelectionMode.Single"
                                            ShowAllRows="true"
                                            TextWrapEnabled="false"
                                            AllowSort="false"
                                            HighlightRowOnHover="true">
                                        <Columns>
                                            <DxGridDataColumn FieldName="Stt" Caption="STT" Width="50px" ReadOnly="true" />
                                            <DxGridDataColumn FieldName="Ma_cc" Caption="@Lap["Card no."]" Width="110px" />
                                            <DxGridDataColumn FieldName="Sl_cc" Caption="@Lap["Qty"]" Width="80px" DisplayFormat="N2" />
                                            <DxGridDataColumn FieldName="Nguyen_gia" Caption="@Lap["Original cost"]" Width="120px" DisplayFormat="N0" />
                                            <DxGridDataColumn FieldName="Gt_da_kh" Caption="@Lap["Allocated"]" Width="110px" DisplayFormat="N0" />
                                            <DxGridDataColumn FieldName="Gt_cl" Caption="@Lap["Remaining"]" Width="110px" DisplayFormat="N0" />
                                            <DxGridDataColumn FieldName="Gt_kh_ky" Caption="@Lap["Alloc./period"]" Width="110px" DisplayFormat="N0" />
                                            <DxGridDataColumn FieldName="Ghi_chu" Caption="@Lap["Note"]" MinWidth="200" />
                                        </Columns>
                                    </DxGrid>
                                </div>

                                @* Bottom grid: Điều chuyển for selected card *@
                                <div>
                                    <h6 class="fw-bold text-primary m-0 mb-1">@Lap["Dept. Transfer"]</h6>
                                    <DxGrid @ref="GridDccc" Data="@FilteredLstDccc" SizeMode="@Itemsizemode"
                                            CssClass="w-100 grid-height-dynamic hide-default-footer"
                                            ShowGroupPanel="false" ValidationEnabled="false"
                                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                            HighlightRowOnHover="true">
                                        <Columns>
                                            <DxGridCommandColumn Width="100px" Caption="" EditButtonVisible="false" NewButtonVisible="false" DeleteButtonVisible="false">
                                                <CellDisplayTemplate Context="gCtx">
                                                    @{ var item = (CtBpcc)gCtx.DataItem; }
                                                    <div class="d-flex justify-content-around">
                                                        <a class="text-success fw-bold cursor-pointer" @onclick="@(() => OpenViewDccc(item))" title="Xem"><i class="fa fa-eye"></i></a>
                                                        @if (item?.Cc0 != "1")
                                                        {
                                                            <a class="text-primary fw-bold cursor-pointer" @onclick="@(() => OpenEditDccc(item))" title="Sửa"><i class="fa fa-edit"></i></a>
                                                            <a class="text-danger fw-bold cursor-pointer" @onclick="@(() => ConfirmDeleteDccc(item))" title="Xóa"><i class="fa fa-trash"></i></a>
                                                        }
                                                    </div>
                                                </CellDisplayTemplate>
                                            </DxGridCommandColumn>
                                            <DxGridDataColumn FieldName="Stt" Caption="STT" Width="50px" />
                                            <DxGridDataColumn FieldName="Ma_bpcc" Caption="@Lap["Use dept. code"]" Width="90px" />
                                            <DxGridDataColumn FieldName="Ten_bpcc" Caption="@Lap["Use dept. name"]" MinWidth="150" />
                                            <DxGridDataColumn FieldName="Sl_cc" Caption="@Lap["Qty"]" Width="80px" DisplayFormat="N2" />
                                            <DxGridDataColumn FieldName="Ngay_kh" Caption="@Lap["Alloc. start date"]" Width="120px" DisplayFormat="dd/MM/yyyy" />
                                            <DxGridDataColumn FieldName="Tk_cp" Caption="@Lap["Expense acc."]" Width="90px" />
                                            <DxGridDataColumn FieldName="Ma_bpht" Caption="@Lap["Cost dept"]" Width="80px" />
                                            <DxGridDataColumn FieldName="Ma_vv" Caption="@Lap["Project"]" Width="90px" />
                                            <DxGridDataColumn FieldName="Ghi_chu" Caption="@Lap["Note"]" MinWidth="100" />
                                            <DxGridDataColumn FieldName="Date0" Caption="@Lap["Created date"]" Width="100px" DisplayFormat="dd/MM/yyyy" />
                                            <DxGridDataColumn FieldName="Time0" Caption="@Lap["Created time"]" Width="80px" />
                                            <DxGridDataColumn FieldName="User_name0" Caption="@Lap["Created by"]" Width="80px" />
                                            <DxGridDataColumn FieldName="Date" Caption="@Lap["Modified date"]" Width="100px" DisplayFormat="dd/MM/yyyy" />
                                            <DxGridDataColumn FieldName="Time" Caption="@Lap["Modified time"]" Width="80px" />
                                            <DxGridDataColumn FieldName="User_name" Caption="@Lap["Modified by"]" Width="80px" />
                                        </Columns>
                                    </DxGrid>
                                    <div class="custom-add-row-bar" @onclick="AddNewDccc">
                                        <i class="fa fa-plus"></i>
                                        <span class="ms-2" style="color:black;font-size:11px;">@Lap["Click here to add a new row"]</span>
                                    </div>
                                </div>

                                @* Popup điều chuyển *@
                                <DxPopup @bind-Visible="@isShowPopupDccc" HeaderText="@Lap["Department Transfer"]"
                                         Width="580px" ShowFooter="true" CloseOnOutsideClick="false" Shown="OnPopupShownDccc">
                                    <BodyContentTemplate Context="popDccc">
                                        @{ bool dcLocked = isViewingDccc; }
                                        <DxFormLayout CssClass="w-100 p-2">
                                            <DxFormLayoutItem Caption="@Lap["Qty"]" ColSpanMd="12">
                                                <Template Context="c1"><DxSpinEdit @bind-Value="@editItemDccc.Sl_cc" DisplayFormat="N2" Enabled="false" /></Template>
                                            </DxFormLayoutItem>
                                            <DxFormLayoutItem Caption="@Lap["Use department:"]" ColSpanMd="12">
                                                <Template Context="c2">
                                                    <DxComboBox @ref="cbDcccBpcc"
                                                                Data="@LsBpts" @bind-Value="@editItemDccc.Ma_bpcc"
                                                                ValueFieldName="Ma_item" TextFieldName="Ma_item"
                                                                EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains"
                                                                Enabled="@(!dcLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="Ma_item" Caption="Mã" Width="80px" />
                                                            <DxListEditorColumn FieldName="Ten_item" Caption="Tên bộ phận" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>
                                            <DxFormLayoutItem Caption="@Lap["Alloc. start date:"]" ColSpanMd="12">
                                                <Template Context="c3">
                                                    <DxDateEdit @ref="deDcccNgayKh" @bind-Date="@editItemDccc.Ngay_kh" Format="dd/MM/yyyy" Enabled="@(!dcLocked)" />
                                                </Template>
                                            </DxFormLayoutItem>
                                            <DxFormLayoutItem Caption="@Lap["Expense acc.:"]" ColSpanMd="12">
                                                <Template Context="c4">
                                                    <DxComboBox Data="@LsTk" @bind-Value="@editItemDccc.Tk_cp"
                                                                ValueFieldName="Ma_item" TextFieldName="Ma_item"
                                                                EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains"
                                                                Enabled="@(!dcLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="Ma_item" Caption="TK" Width="80px" />
                                                            <DxListEditorColumn FieldName="Ten_item" Caption="Tên tài khoản" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>
                                            <DxFormLayoutItem Caption="@Lap["Cost dept:"]" ColSpanMd="12">
                                                <Template Context="c5">
                                                    <DxComboBox Data="@LsBpht" @bind-Value="@editItemDccc.Ma_bpht"
                                                                ValueFieldName="Ma_item" TextFieldName="Ma_item"
                                                                EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains"
                                                                Enabled="@(!dcLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="Ma_item" Caption="Mã" Width="80px" />
                                                            <DxListEditorColumn FieldName="Ten_item" Caption="Tên bpht" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>
                                            <DxFormLayoutItem Caption="@Lap["Project:"]" ColSpanMd="12">
                                                <Template Context="c6">
                                                    <DxComboBox Data="@LsVv" @bind-Value="@editItemDccc.Ma_vv"
                                                                ValueFieldName="Ma_item" TextFieldName="Ma_item"
                                                                EditFormat="{0} - {1}" FilteringMode="DataGridFilteringMode.Contains"
                                                                Enabled="@(!dcLocked)">
                                                        <Columns>
                                                            <DxListEditorColumn FieldName="Ma_item" Caption="Mã" Width="80px" />
                                                            <DxListEditorColumn FieldName="Ten_item" Caption="Tên dự án" />
                                                        </Columns>
                                                    </DxComboBox>
                                                </Template>
                                            </DxFormLayoutItem>
                                            <DxFormLayoutItem Caption="@Lap["Note:"]" ColSpanMd="12">
                                                <Template Context="c7"><DxTextBox @bind-Text="@editItemDccc.Ghi_chu" Enabled="@(!dcLocked)" /></Template>
                                            </DxFormLayoutItem>
                                        </DxFormLayout>
                                    </BodyContentTemplate>
                                    <FooterContentTemplate Context="footDccc">
                                        <div class="w-100 d-flex justify-content-end">
                                            @if (!isViewingDccc)
                                            {
                                                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@Lap["Accept"]" Click="SaveDccc" CssClass="me-2 fw-bold" />
                                            }
                                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="@(isViewingDccc ? Lap["Close"] : Lap["Cancel"])" Click="@(() => isShowPopupDccc = false)" />
                                        </div>
                                    </FooterContentTemplate>
                                </DxPopup>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>

                @* ===== TAB 5: TẠM DỪNG PHÂN BỔ ===== *@
                <DxFormLayoutTabPage Caption="@Lap["Suspend Alloc."]" CaptionCssClass="fw-bold">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div class="mt-2 mb-3">
                                @* Top grid: All cards *@
                                <div style="margin-bottom: 10px;">
                                    <h6 class="fw-bold text-primary m-0 mb-1">@Lap["Select tool card"]</h6>
                                    <DxGrid Data="@LstCtDmcc" SizeMode="@Itemsizemode"
                                            CssClass="w-100" Style="height: 200px;"
                                            AllowSelectRowByClick="true"
