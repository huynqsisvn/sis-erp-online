                                                <Template Context="th2"><DxTextBox @bind-Text="@editItemThoicc.Ly_do_thoi" Enabled="@(!thLocked)" /></Template>
                                            </DxFormLayoutItem>
                                        </DxFormLayout>
                                    </BodyContentTemplate>
                                    <FooterContentTemplate Context="footTh">
                                        <div class="w-100 d-flex justify-content-end">
                                            @if (!isViewingThoicc)
                                            {
                                                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@Lap["Accept"]" Click="SaveThoicc" CssClass="me-2 fw-bold" />
                                            }
                                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="@(isViewingThoicc ? Lap["Close"] : Lap["Cancel"])" Click="@(() => isShowPopupThoicc = false)" />
                                        </div>
                                    </FooterContentTemplate>
                                </DxPopup>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>

            </DxFormLayoutTabPages>
        </DxFormLayout>
    </div>

    @* ===== LƯỚI CHI TIẾT CCDC ===== *@
    <div class="mt-2 m-1 me-2 border rounded p-2">
        <h6 class="fw-bold text-primary m-0 mb-1">@Lap["Tool detail cards"]</h6>
        <div class="mt-2 mb-3">
            <DxGrid @ref="GridCt"
                    Data="@LstCtDmcc"
                    SizeMode="@Itemsizemode"
                    CssClass="w-100 grid-height-dynamic"
                    AllowSelectRowByClick="true"
                    KeyboardNavigationEnabled="true"
                    @bind-SelectedDataItem="@SelectedCtDmcc"
                    ValidationEnabled="false"
                    EditMode="GridEditMode.EditRow"
                    SelectionMode="GridSelectionMode.Single"
                    EditNewRowPosition="@((GridEditNewRowPosition)(-1))"
                    ShowFilterRow="false"
                    ShowAllRows="true"
                    TextWrapEnabled="false"
                    AllowSort="false"
                    HighlightRowOnHover="true"
                    FooterDisplayMode="GridFooterDisplayMode.Always">
                <Columns>
                    <DxGridDataColumn FieldName="Stt" Caption="STT" Width="50px" ReadOnly="true" />
                    <DxGridDataColumn FieldName="Ma_cc" Caption="@Lap["Tool card no."]" Width="130px" />
                    <DxGridDataColumn FieldName="Ngay_ct" Caption="@Lap["Voucher date"]" DisplayFormat="dd/MM/yyyy" Width="110px" />
                    <DxGridDataColumn FieldName="So_ct" Caption="@Lap["Voucher no."]" Width="100px" />
                    <DxGridDataColumn FieldName="Ma_bpcc" Caption="@Lap["Use dept. code"]" Width="110px" />
                    <DxGridDataColumn FieldName="Ten_bpcc" Caption="@Lap["Use dept. name"]" MinWidth="140" />
                    <DxGridDataColumn FieldName="Sl_cc" Caption="@Lap["Qty"]" Width="80px" DisplayFormat="N2" />
                    <DxGridDataColumn FieldName="Nguyen_gia" Caption="@Lap["Original cost"]" Width="130px" DisplayFormat="N0" />
                    <DxGridDataColumn FieldName="Gt_da_kh" Caption="@Lap["Allocated value"]" Width="130px" DisplayFormat="N0" />
                    <DxGridDataColumn FieldName="Gt_cl" Caption="@Lap["Remaining value"]" Width="130px" DisplayFormat="N0" />
                    <DxGridDataColumn FieldName="Gt_kh_ky" Caption="@Lap["Alloc. value/period"]" Width="130px" DisplayFormat="N0" />
                    <DxGridDataColumn FieldName="Tk_cp" Caption="@Lap["Expense acc."]" Width="110px" />
                    <DxGridDataColumn FieldName="Ma_bpht" Caption="@Lap["Cost dept"]" Width="100px" />
                    <DxGridDataColumn FieldName="Ma_px" Caption="@Lap["Workshop"]" Width="100px" />
                    <DxGridDataColumn FieldName="Ma_vv" Caption="@Lap["Project"]" Width="100px" />
                    <DxGridDataColumn FieldName="Ghi_chu" Caption="@Lap["Note"]" MinWidth="120" />
                </Columns>
                <TotalSummary>
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Sl_cc"      DisplayText="{0:N2}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Nguyen_gia" DisplayText="{0:N0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Gt_da_kh"   DisplayText="{0:N0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Gt_cl"      DisplayText="{0:N0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Gt_kh_ky"   DisplayText="{0:N0}" />
                </TotalSummary>
            </DxGrid>
        </div>
    </div>

</FormList>

@* ===== POPUP XÁC NHẬN XÓA DÙNG CHUNG ===== *@
<DxPopup @bind-Visible="@PopupConfirmVisible" HeaderText="@Lap["Confirm Delete"]"
         Width="400px" ShowFooter="true" CloseOnOutsideClick="false">
    <BodyContentTemplate>
        <div class="d-flex align-items-center p-2">
            <i class="fa fa-exclamation-triangle text-danger fa-2x me-3"></i>
            <span>@PopupConfirmMessage</span>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="w-100 d-flex justify-content-end">
            <DxButton Text="@Lap["Delete"]" RenderStyle="ButtonRenderStyle.Danger" Click="OnPopupConfirmOk" CssClass="me-2 fw-bold" />
            <DxButton Text="@Lap["Cancel"]" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => PopupConfirmVisible = false)" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<style>
    .css-fxcc2-detail .dxbl-formlayout-tabpage {
        display: block;
        padding: 0;
        min-height: inherit;
    }
    .css-fxcc2-detail .dxbl-formlayout-tabpage .dxbl-formlayout-group {
        margin: 0;
        padding: 0;
    }
    .css-fxcc2-detail {
        min-height: 460px;
    }
    .custom-add-row-bar {
        background-color: #f8f9fa;
        padding: 2px 15px;
        cursor: pointer;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        width: 100%;
        transition: background-color 0.2s;
    }
    .custom-add-row-bar:hover { background-color: #e9ecef; }
    .custom-add-row-bar i { font-size: 11px; }
</style>

@code {
    protected override void OnInitialized()
    {
        sqlTableName = "dmcc";
        SqlTableKey = "ma_cc_me";
        Itemsizemode = SizeMode.Medium;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (curActionTask == ActionTask.View && !string.IsNullOrEmpty(Ma_ma))
                await LoadData(Ma_ma);
            StateHasChanged();
        }
    }

    public void CloseForm()
    {
        if (ShowAdd == true) OnClose.InvokeAsync();
        else myNavi.NavigateTo("/" + ParentPage);
    }

    public void CancelForm()
    {
        CloseForm();
    }
}
