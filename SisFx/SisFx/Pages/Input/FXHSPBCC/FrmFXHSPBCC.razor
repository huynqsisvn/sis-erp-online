@inherits TranBaseComponent
@using SisFx.Pages.Input.FXHSPBCC
@using System.Data
@using DevExpress.Blazor

<div class="m-0 p-0 w-100 frm-fxhspbcc" data-spy="scroll" style="overflow:auto;">
<FormList Title="@Pagetitle"
          @bind-curActionTask="@curActionTask"
          OnSave="@OnSave" OnCancel="@OnCancel">

    <div class="row m-1 mt-2 me-2">
        <div class="frm-fxhspbcc-container">
            <DxFormLayout SizeMode="@Itemsizemode" CssClass="frm-header"
                          onkeydown="ModifyEnterKeyPressAsTab(event);">

                @* ============================================================
                   NHÓM HEADER — Mã công cụ + Mã BPSD
                   WinForm: txtma_ts (dmcc), txtma_bpts (dmbpts)
                   ============================================================ *@
                <DxFormLayoutGroup ColSpanMd="12"
                                   Caption="@Lap["Infomation"]"
                                   Decoration="FormLayoutGroupDecoration.Card"
                                   CssClass="dx-total-box"
                                   ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start"
                                   AnimationType="LayoutAnimationType.Slide">

                    <DxFormLayoutItem Caption="@Lap["Tool code"]" ColSpanMd="6">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                @*
                                    WinForm: txtma_ts ListID="dmcc"
                                    Filter theo ma_cc_me nếu StartUp.ma_cc_me có giá trị
                                *@
                                <AutocompleteComponent Id="ma_cc_me_input"
                                                       Ma_dm="dmcc"
                                                       Filter="@MaDvcsFilter"
                                                       @bind-Value="@CurPh.Ma_cc_me"
                                                       SelectChanged="OnAutoCompleteCcChanged"
                                                       IsEnable="@AllowEditMode"
                                                       IsLangEn="@IsLangEn">
                                </AutocompleteComponent>
                                <span class="text-muted small">@CurPh.Ten_cc</span>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="@Lap["Allocation code"]" ColSpanMd="6">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                @*
                                    WinForm: txtma_bpts ListID="dmbpts"
                                    Filter: "ma_bpts IN (SELECT ma_bpcc FROM ctbpcc WHERE EXISTS
                                        (SELECT 1 FROM ctdmcc WHERE ma_cc_me LIKE '...' AND ctdmcc.ma_cc = ctbpcc.ma_cc))"
                                *@
                                <AutocompleteComponent Id="ma_bpcc_input"
                                                       Ma_dm="dmbpts"
                                                       Filter="@BpccFilter"
                                                       @bind-Value="@CurPh.Ma_bpcc"
                                                       SelectChanged="OnAutoCompleteBpccChanged"
                                                       IsEnable="@AllowEditMode"
                                                       IsLangEn="@IsLangEn">
                                </AutocompleteComponent>
                                <span class="text-muted small">@CurPh.Ten_bpcc</span>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>

                @* ============================================================
                   NHÓM CHI TIẾT — GrdCt (hspbcc)
                   WinForm: GrdCt fields: tk_cp, ma_bpht, ma_px, ma_vv,
                            so_lsx, ma_sp, ngay_hl1, ngay_hl2, he_so
                   ============================================================ *@
                <DxFormLayoutGroup ColSpanMd="12"
                                   Caption="@Lap["Details"]"
                                   CaptionCssClass="fw-bold"
                                   Decoration="FormLayoutGroupDecoration.Card">
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div @ref="GridWrapper" id="grid-wrapper-bpcc"
                                 @onfocusout="OnGridCTLostFocus">
                                <DxGrid @ref="GridCT"
                                        SizeMode="@Itemsizemode"
                                        CssClass="@grd_Css"
                                        @onkeydown="GridCT_OnKeyDown"
                                        AllowSelectRowByClick="true"
                                        KeyboardNavigationEnabled="true"
                                        Data="@LSCt"
                                        @bind-SelectedDataItem="@SelectedDataItemCT"
                                        ValidationEnabled="false"
                                        EditMode="GridEditMode.EditRow"
                                        RowClick="@StartEditDataItemByClickCT"
                                        SelectionMode="GridSelectionMode.Single"
                                        CustomizeEditModel="Grid_CustomizeEditModelCT"
                                        EditModelSaving="Grid_EditModelSavingCT"
                                        DataItemDeleting="Grid_DataItemDeletingCT"
                                        EditNewRowPosition="@NewItemRowPosition"
                                        ShowAllRows="true"
                                        TextWrapEnabled="false"
                                        AllowSort="false"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        HighlightRowOnHover="true">
                                    <Columns>
                                        @* Nút xóa dòng *@
                                        <DxGridCommandColumn Width="40px"
                                                             NewButtonVisible="false"
                                                             Visible="@AllowEditMode"
                                                             VisibleIndex="0">
                                            <CellDisplayTemplate Context="cntedit">
                                                <div class="grid-cell-align-center">
                                                    <DxButton IconCssClass="grid-icon grid-icon-delete"
                                                              RenderStyle="ButtonRenderStyle.Link"
                                                              CssClass="grid-delete-btn"
                                                              aria-label="Delete"
                                                              Click="@(() => GridCT.ShowRowDeleteConfirmation(cntedit.VisibleIndex))" />
                                                </div>
                                            </CellDisplayTemplate>
                                            <CellEditTemplate Context="cntedit1">
                                                <div class="grid-cell-align-center">
                                                    <DxButton Enabled="false"
                                                              CssClass="grid-disabled-button"
                                                              IconCssClass="grid-icon grid-icon-delete"
                                                              aria-label="Delete"
                                                              RenderStyle="ButtonRenderStyle.Link" />
                                                </div>
                                            </CellEditTemplate>
                                        </DxGridCommandColumn>

                                        <DxGridDataColumn FieldName="Stt"
                                                          Caption="Stt"
                                                          Width="45px"
                                                          CaptionAlignment="GridTextAlignment.Center" />

                                        @* Tk cp *@
                                        <DxGridDataColumn FieldName="Tk_cp"
                                                          Caption="@Lap["Cost account"].ToString()"
                                                          Width="130"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <AutocompleteComponent Ma_dm="dmtk1"
                                                                       @bind-Value="@_ct.Tk_cp"
                                                                       SelectChanged="@((ExpandoObject v) => OnGridCT_DMDM_Changed(v, "Tk_cp"))"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn">
                                                </AutocompleteComponent>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Mã bpht *@
                                        <DxGridDataColumn FieldName="Ma_bpht"
                                                          Caption="@Lap["Accounting department"].ToString()"
                                                          Width="120"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <AutocompleteComponent Ma_dm="dmbpht"
                                                                       @bind-Value="@_ct.Ma_bpht"
                                                                       SelectChanged="@((ExpandoObject v) => OnGridCT_DMDM_Changed(v, "Ma_bpht"))"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn">
                                                </AutocompleteComponent>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Mã ĐVCS (readonly) *@
                                        <DxGridDataColumn FieldName="Ma_dvcs"
                                                          Caption="@Lap["Dvcs code"].ToString()"
                                                          Width="90px"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <DxTextBox @bind-Text="@_ct.Ma_dvcs"
                                                           ReadOnly="true"
                                                           Enabled="false" />
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Mã px *@
                                        <DxGridDataColumn FieldName="Ma_px"
                                                          Caption="@Lap["Workshop code"].ToString()"
                                                          Width="110"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <AutocompleteComponent Ma_dm="dmpx"
                                                                       @bind-Value="@_ct.Ma_px"
                                                                       SelectChanged="@((ExpandoObject v) => OnGridCT_DMDM_Changed(v, "Ma_px"))"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn">
                                                </AutocompleteComponent>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Mã dự án *@
                                        <DxGridDataColumn FieldName="Ma_vv"
                                                          Caption="@Lap["Project code"].ToString()"
                                                          Width="110"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <AutocompleteComponent Ma_dm="dmvv"
                                                                       @bind-Value="@_ct.Ma_vv"
                                                                       SelectChanged="@((ExpandoObject v) => OnGridCT_DMDM_Changed(v, "Ma_vv"))"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn">
                                                </AutocompleteComponent>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Số lsx *@
                                        <DxGridDataColumn FieldName="So_lsx"
                                                          Caption="@Lap["Manufacturing order"].ToString()"
                                                          Width="120"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <AutocompleteComponent Ma_dm="dmlsx"
                                                                       @bind-Value="@_ct.So_lsx"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn">
                                                </AutocompleteComponent>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Mã sản phẩm *@
                                        <DxGridDataColumn FieldName="Ma_sp"
                                                          Caption="@Lap["Product code"].ToString()"
                                                          Width="110"
                                                          CaptionAlignment="GridTextAlignment.Center">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <AutocompleteComponent Ma_dm="dmsp"
                                                                       @bind-Value="@_ct.Ma_sp"
                                                                       IsEnable="@AllowEditMode"
                                                                       IsLangEn="@IsLangEn">
                                                </AutocompleteComponent>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Hiệu lực từ ngày *@
                                        <DxGridDataColumn FieldName="Ngay_hl1"
                                                          Caption="@Lap["Valid from date"].ToString()"
                                                          Width="140"
                                                          CaptionAlignment="GridTextAlignment.Center"
                                                          DisplayFormat="dd-MM-yyyy">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <DxDateEdit @bind-Date="@_ct.Ngay_hl1"
                                                            DisplayFormat="dd-MM-yyyy"
                                                            Format="dd-MM-yyyy"
                                                            Enabled="@AllowEditMode">
                                                </DxDateEdit>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Hiệu lực đến ngày *@
                                        <DxGridDataColumn FieldName="Ngay_hl2"
                                                          Caption="@Lap["Valid to date"].ToString()"
                                                          Width="140"
                                                          CaptionAlignment="GridTextAlignment.Center"
                                                          DisplayFormat="dd-MM-yyyy">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <DxDateEdit @bind-Date="@_ct.Ngay_hl2"
                                                            DisplayFormat="dd-MM-yyyy"
                                                            Format="dd-MM-yyyy"
                                                            Enabled="@AllowEditMode">
                                                </DxDateEdit>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                        @* Hệ số *@
                                        <DxGridDataColumn FieldName="He_so"
                                                          Caption="@Lap["Coefficient"].ToString()"
                                                          Width="100"
                                                          CaptionAlignment="GridTextAlignment.Center"
                                                          DisplayFormat="N4">
                                            <CellEditTemplate Context="GrdCtx">
                                                @{ var _ct = (CtBpcc)GrdCtx.EditModel; }
                                                <DxSpinEdit Enabled="@AllowEditMode"
                                                            Value="@_ct.He_so"
                                                            ValueExpression="@(() => _ct.He_so)"
                                                            ValueChanged="@((decimal nv) => OnGridCT_Value_Changed(nv, "He_so"))"
                                                            DisplayFormat="N4"
                                                            Id="He_so">
                                                </DxSpinEdit>
                                            </CellEditTemplate>
                                        </DxGridDataColumn>

                                    </Columns>
                                </DxGrid>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

            </DxFormLayout>
        </div>
    </div>

</FormList>
</div>

<style>
    .frm-fxhspbcc-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 8px;
    }
    @@media (max-width: 768px) {
        .frm-fxhspbcc-container { padding: 0 4px; }
    }
    .disabled-grid { pointer-events: none; opacity: 0.7; }
    .frm-fxhspbcc .dxbl-grid { min-height: 100px; }
</style>

@code {
    #region Variables

    PhHspbcc CurPh = new PhHspbcc();
    List<CtBpcc> LSCt = new List<CtBpcc>();
    CtBpcc CurrentEditModel;

    public bool ParentReload = false;
    public ElementReference GridWrapper;
    public DotNetObjectReference<FrmFXHSPBCC> Pageobj;

    // Filter AutoComplete công cụ theo ĐVCS
    // WinForm: LoadForm() → txtma_ts.FilterAdd = "ma_dvcs LIKE '...%'"
    private string MaDvcsFilter =>
        !string.IsNullOrEmpty(Ma_dvcs) && Ma_dvcs != "ALL"
            ? $"ma_dvcs LIKE '{Ma_dvcs.Trim()}%'"
            : "";

    // Filter AutoComplete BPSD theo công cụ đang chọn
    // WinForm: txtma_bpts.Filter = "ma_bpts IN (SELECT ma_bpcc FROM ctbpcc WHERE EXISTS
    //    (SELECT 1 FROM ctdmcc WHERE ma_cc_me LIKE '...' AND ctdmcc.ma_cc = ctbpcc.ma_cc))"
    private string BpccFilter =>
        !string.IsNullOrEmpty(CurPh?.Ma_cc_me)
            ? $"ma_bpts IN (SELECT ma_bpcc FROM ctbpcc WHERE EXISTS (SELECT 1 FROM ctdmcc WHERE ma_cc_me LIKE '{CurPh.Ma_cc_me.Trim()}%' AND ctdmcc.ma_cc = ctbpcc.ma_cc))"
            : "";

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await Language();
        LoadOptions();

        string title = Lap["Allocation coefficient declaration for tools"].ToString();
        switch (curActionTask)
        {
            case ActionTask.View:
                Pagetitle = Lap["View"] + ": " + title;
                V_Xem();
                break;
            case ActionTask.Edit:
                Pagetitle = Lap["Edit"] + ": " + title;
                V_Sua();
                break;
            case ActionTask.New:
                Pagetitle = Lap["New"] + ": " + title;
                V_Moi();
                break;
            case ActionTask.Copy:
                Pagetitle = Lap["Copy"] + ": " + title;
                V_Copy();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Pageobj = DotNetObjectReference.Create(this);
            await JavacriptS.InvokeVoidAsync("SetPageObj", Pageobj);
            await JavacriptS.InvokeVoidAsync("AttachEnterAsTab");
            await JavacriptS.InvokeVoidAsync("eval",
                "document.getElementById('ma_cc_me_input')?.querySelector('input')?.focus()");
        }
        await JavacriptS.InvokeVoidAsync("changeTextNewRowButton",
            Lap["Click here to add a new row"].ToString());
    }

    [JSInvokable]
    public void CallGridEditMode(string value)
    {
        if (!string.IsNullOrEmpty(value) && AllowEditMode && value.Equals(end_GridCt))
            AddNewCT();
    }

    // ===================================================
    // TOOLBAR / FORM ACTIONS
    // ===================================================
    private Task OnNew()  { V_Moi();  curActionTask = ActionTask.New;  return Task.CompletedTask; }
    private Task OnCopy() { V_Copy(); curActionTask = ActionTask.Copy; return Task.CompletedTask; }
    private Task OnEdit() { V_Sua();  curActionTask = ActionTask.Edit; return Task.CompletedTask; }
    private async Task OnSave() { await Save(); }
    private async void OnCancel()
    {
        if (Closeform.HasDelegate) Closeform.InvokeAsync(ParentReload);
        if (DxWindowmodel != null) myModal.CloseModal(DxWindowmodel);
    }

    // ===================================================
    // V_Moi — WinForm: Them(), khai báo mới
    // ===================================================
    void V_Moi()
    {
        Ma_dvcs = myStateMN.GetMa_Dvcs();
        if (string.IsNullOrWhiteSpace(Ma_dvcs) || Ma_dvcs.Trim() == "ALL")
        {
            myStateMN.SetNewThongbao(Lap["Please, select Unit code"] + " !");
            return;
        }
        CurPh = new PhHspbcc { Ma_dvcs = Ma_dvcs };
        LSCt  = new List<CtBpcc>();
        AllowEditMode = true;
    }

    // ===================================================
    // V_Copy — WinForm: Copy, load bản gốc rồi xóa key
    // ===================================================
    void V_Copy()
    {
        AllowEditMode = true;
        if (!string.IsNullOrEmpty(Stt_rec))
            _ = CopyFrom();
        else
            V_Moi();
    }

    private async Task CopyFrom()
    {
        await LoaddataFrm();
        var srcPh = CurPh;
        var srcCt = LSCt.ToList();
        V_Moi();

        CurPh.Ma_cc_me  = srcPh.Ma_cc_me;
        CurPh.Ma_bpcc   = srcPh.Ma_bpcc;
        CurPh.Ten_cc    = srcPh.Ten_cc;
        CurPh.Ten_bpcc  = srcPh.Ten_bpcc;
        CurPh.Tk_cp     = srcPh.Tk_cp;
        CurPh.Ma_phi    = srcPh.Ma_phi;

        LSCt = srcCt.Select((x, i) => new CtBpcc
        {
            Stt      = i + 1,
            Ma_cc_me = CurPh.Ma_cc_me,
            Ma_bpcc  = CurPh.Ma_bpcc,
            Ma_dvcs  = CurPh.Ma_dvcs,
            Tk_cp    = x.Tk_cp,
            Ma_bpht  = x.Ma_bpht,
            Ma_px    = x.Ma_px,
            Ma_vv    = x.Ma_vv,
            So_lsx   = x.So_lsx,
            Ma_sp    = x.Ma_sp,
            Ngay_hl1 = x.Ngay_hl1,
            Ngay_hl2 = x.Ngay_hl2,
            He_so    = x.He_so
        }).ToList();

        await InvokeAsync(StateHasChanged);
    }

    async void V_Xem()
    {
        AllowEditMode = false;
        if (!string.IsNullOrEmpty(Stt_rec))
        {
            await LoaddataFrm();
            StateHasChanged();
        }
    }

    async void V_Sua()
    {
        if (!string.IsNullOrEmpty(Stt_rec))
        {
            await LoaddataFrm();
            AllowEditMode = true;
            StateHasChanged();
        }
    }

    public override async Task Loaddata() => await LoaddataFrm();

    // ===================================================
    // LOAD DATA FORM — WinForm: GetRow + Getbphtct
    // Stt_rec = "ma_cc_me|ma_bpcc"
    // ===================================================
    private async Task LoaddataFrm()
    {
        try
        {
            if (string.IsNullOrEmpty(Stt_rec)) return;

            var parts   = Stt_rec.Split('|');
            string maCc = parts.Length > 0 ? parts[0].Trim() : "";
            string maBp = parts.Length > 1 ? parts[1].Trim() : "";
            if (string.IsNullOrEmpty(maCc) || string.IsNullOrEmpty(maBp)) return;

            string sMaCc = maCc.Replace("'", "''");
            string sMaBp = maBp.Replace("'", "''");

            // Header: join dmcc + dmbpts để lấy tên (giống WinForm)
            string sqlPh = $@"SELECT TOP 1
                h.ma_cc_me, h.ma_bpcc, h.ma_dvcs,
                ISNULL(c.ten_cc,   '') AS ten_cc,
                ISNULL(c.ten_cc2,  '') AS ten_cc2,
                ISNULL(c.tk_cp,    '') AS tk_cp,
                ISNULL(c.ma_phi,   '') AS ma_phi,
                ISNULL(b.ten_bpts, '') AS ten_bpcc,
                ISNULL(b.ten_bpts2,'') AS ten_bpcc2
            FROM hspbcc h
            LEFT JOIN dmcc c ON c.ma_cc_me = h.ma_cc_me
            LEFT JOIN dmbpts b ON b.ma_bpts  = h.ma_bpcc
            WHERE h.ma_cc_me='{sMaCc}' AND h.ma_bpcc='{sMaBp}'";

            DataSet dsPh = myDb.LoadDataSet(sqlPh);
            if (dsPh?.Tables.Count > 0 && dsPh.Tables[0].Rows.Count > 0)
            {
                var list = myDb.ConvertDataTable<PhHspbcc>(dsPh.Tables[0]);
                if (list?.Count > 0) CurPh = list[0];
            }

            // Detail — WinForm: Getbphtct(ma_bpcc, ma_cc_me) → SELECT * FROM hspbcc
            string sqlCt = $"SELECT * FROM hspbcc WHERE ma_cc_me='{sMaCc}' AND ma_bpcc='{sMaBp}'";
            DataSet dsCt = myDb.LoadDataSet(sqlCt);
            if (dsCt?.Tables.Count > 0)
            {
                LSCt = myDb.ConvertDataTable<CtBpcc>(dsCt.Tables[0]) ?? new List<CtBpcc>();
                int stt = 1;
                foreach (var r in LSCt) r.Stt = stt++;
            }
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Error"] + ": " + ex.Message);
        }
    }

    // ===================================================
    // VALIDATE — WinForm: CheckValid() trong newForm.xaml.cs
    // ===================================================
    private async Task<bool> CheckValid()
    {
        // WinForm ID 52: chưa vào mã công cụ
        if (string.IsNullOrWhiteSpace(CurPh.Ma_cc_me))
        {
            myStateMN.SetNewThongbao(Lap["Tool code is required"] + " !");
            return false;
        }

        // WinForm ID 53: chưa vào mã BPSD
        if (string.IsNullOrWhiteSpace(CurPh.Ma_bpcc))
        {
            myStateMN.SetNewThongbao(Lap["Allocation code is required"] + " !");
            return false;
        }

        // WinForm ID 55: chưa vào chi tiết
        var validRows = LSCt?.Where(r =>
            !string.IsNullOrEmpty(r.Tk_cp)  || !string.IsNullOrEmpty(r.Ma_bpht) ||
            !string.IsNullOrEmpty(r.Ma_px)  || !string.IsNullOrEmpty(r.Ma_vv)   ||
            !string.IsNullOrEmpty(r.So_lsx) || !string.IsNullOrEmpty(r.Ma_sp)).ToList();

        if (validRows == null || validRows.Count == 0)
        {
            myStateMN.SetNewThongbao(Lap["No details entered"] + " !");
            return false;
        }

        foreach (var row in validRows)
        {
            // WinForm ID 1505: chưa nhập hiệu lực từ ngày
            if (!row.Ngay_hl1.HasValue)
            {
                myStateMN.SetNewThongbao(Lap["Valid from date is required"] + " !");
                return false;
            }

            // WinForm ID 20: ngày hiệu lực từ ngày phải là ngày đầu kỳ (ngày 1)
            if (row.Ngay_hl1.Value.Day != 1)
            {
                myStateMN.SetNewThongbao(Lap["Valid from date must be the first day of the period"] + " !");
                return false;
            }

            if (row.Ngay_hl2.HasValue)
            {
                // WinForm ID 24: ngày đến phải là ngày cuối tháng
                var lastDay = new DateTime(row.Ngay_hl2.Value.Year, row.Ngay_hl2.Value.Month,
                    DateTime.DaysInMonth(row.Ngay_hl2.Value.Year, row.Ngay_hl2.Value.Month));
                if (row.Ngay_hl2.Value.Date != lastDay.Date)
                {
                    myStateMN.SetNewThongbao(Lap["Valid to date must be the last day of the period"] + " !");
                    return false;
                }

                // WinForm ID 1515: ngày đến >= ngày từ
                if (row.Ngay_hl2.Value < row.Ngay_hl1.Value)
                {
                    myStateMN.SetNewThongbao(Lap["Valid to date must be greater than or equal to valid from date"] + " !");
                    return false;
                }
            }

            // WinForm ID 1516: hệ số > 0
            if (row.He_so <= 0)
            {
                myStateMN.SetNewThongbao(Lap["Coefficient must be greater than 0"] + " !");
                return false;
            }
        }

        // WinForm ID 1500: kiểm tra trùng chi tiết
        var sorted = validRows
            .OrderBy(r => r.Tk_cp).ThenBy(r => r.Ma_bpht)
            .ThenBy(r => r.Ma_vv).ThenBy(r => r.So_lsx).ThenBy(r => r.Ma_sp)
            .ThenBy(r => r.Ngay_hl1).ThenBy(r => r.Ngay_hl2).ToList();

        for (int i = 0; i < sorted.Count - 1; i++)
        {
            var cur = sorted[i];
            var nxt = sorted[i + 1];
            if (cur.Tk_cp == nxt.Tk_cp && cur.Ma_bpht == nxt.Ma_bpht &&
                cur.Ma_vv == nxt.Ma_vv && cur.So_lsx  == nxt.So_lsx  &&
                cur.Ma_sp == nxt.Ma_sp && cur.Ngay_hl1 <= nxt.Ngay_hl1 &&
                (!cur.Ngay_hl2.HasValue || nxt.Ngay_hl1 <= cur.Ngay_hl2))
            {
                myStateMN.SetNewThongbao(Lap["Duplicate detail entered"] + " !");
                return false;
            }
        }

        // WinForm ID 1675: kiểm tra trùng ma_cc_me + ma_bpcc khi Add/Copy
        if (curActionTask == ActionTask.New || curActionTask == ActionTask.Copy)
        {
            try
            {
                object existed = myDb.GetValue(
                    $"SELECT COUNT(*) FROM hspbcc WHERE ma_cc_me='{CurPh.Ma_cc_me.Trim().Replace("'", "''")}' AND ma_bpcc='{CurPh.Ma_bpcc.Trim().Replace("'", "''")}'");
                if (existed != null && Convert.ToInt32(existed) > 0)
                {
                    myStateMN.SetNewThongbao(Lap["Tool code and allocation code already exist"] + " !");
                    return false;
                }
            }
            catch { }
        }

        return true;
    }

    // ===================================================
    // SAVE — WinForm: saveCustomer()
    //   DELETE cũ rồi INSERT lại từng dòng
    // ===================================================
    private async Task Save()
    {
        if (GridCT != null && GridCT.IsEditing())
        {
            try { await GridCT.SaveChangesAsync(); } catch { }
        }

        if (!await CheckValid()) return;

        string maCcMe = CurPh.Ma_cc_me.Trim();
        string maBpcc = CurPh.Ma_bpcc.Trim();
        string maDvcs = CurPh.Ma_dvcs?.Trim() ?? myStateMN.GetMa_Dvcs()?.Trim() ?? "";
        string time   = DateTime.Now.ToString("HH:mm:ss");
        string userId = curUser?.User_id.ToString() ?? "";
        string sMaCc  = maCcMe.Replace("'", "''");
        string sMaBp  = maBpcc.Replace("'", "''");
        string sMaDv  = maDvcs.Replace("'", "''");

        var toInsert = LSCt.Where(r =>
            !string.IsNullOrEmpty(r.Tk_cp)  || !string.IsNullOrEmpty(r.Ma_bpht) ||
            !string.IsNullOrEmpty(r.Ma_px)  || !string.IsNullOrEmpty(r.Ma_vv)   ||
            !string.IsNullOrEmpty(r.So_lsx) || !string.IsNullOrEmpty(r.Ma_sp)).ToList();

        try
        {
            // WinForm saveCustomer(): DELETE FROM hspbcc WHERE ma_bpcc=... AND ma_cc_me=...
            await myDb.ExecuteSqlQueryAsync(
                $"DELETE FROM hspbcc WHERE ma_cc_me='{sMaCc}' AND ma_bpcc='{sMaBp}'");

            // INSERT từng dòng
            foreach (var ct in toInsert)
            {
                string sTkCp   = (ct.Tk_cp   ?? "").Replace("'", "''");
                string sMaBpht = (ct.Ma_bpht ?? "").Replace("'", "''");
                string sMaPx   = (ct.Ma_px   ?? "").Replace("'", "''");
                string sMaVv   = (ct.Ma_vv   ?? "").Replace("'", "''");
                string sSoLsx  = (ct.So_lsx  ?? "").Replace("'", "''");
                string sMaSp   = (ct.Ma_sp   ?? "").Replace("'", "''");
                string ngay1   = ct.Ngay_hl1.HasValue ? $"'{ct.Ngay_hl1.Value:yyyy-MM-dd}'" : "NULL";
                string ngay2   = ct.Ngay_hl2.HasValue ? $"'{ct.Ngay_hl2.Value:yyyy-MM-dd}'" : "NULL";
                string heSo    = ct.He_so.ToString(System.Globalization.CultureInfo.InvariantCulture);

                string sql = "INSERT INTO hspbcc" +
                    " (ma_cc_me, ma_bpcc, ma_dvcs, tk_cp, ma_bpht, ma_px, ma_vv, so_lsx, ma_sp," +
                    "  ngay_hl1, ngay_hl2, he_so, date0, time0, user_id0)" +
                    $" VALUES (N'{sMaCc}', N'{sMaBp}', N'{sMaDv}'," +
                    $" N'{sTkCp}', N'{sMaBpht}', N'{sMaPx}', N'{sMaVv}', N'{sSoLsx}', N'{sMaSp}'," +
                    $" {ngay1}, {ngay2}, {heSo}, GETDATE(), '{time}', '{userId}')";
                await myDb.ExecuteSqlQueryAsync(sql);
            }

            AllowEditMode = false;
            IsSaved       = true;
            ParentReload  = true;

            string msg = (curActionTask == ActionTask.Edit)
                ? string.Format(Lap["Edit successfully : {0}"].ToString(), maCcMe)
                : string.Format(Lap["Successfully added new : {0}"].ToString(), maCcMe);
            myStateMN.SetNewThongbao(msg);
            curActionTask = ActionTask.View;

            if (Closeform.HasDelegate)
                await Closeform.InvokeAsync(true);
            else if (DxWindowmodel != null)
                myModal.CloseModal(DxWindowmodel);
            return;
        }
        catch (Exception ex)
        {
            myStateMN.SetNewThongbao(Lap["Error"] + " : " + ex.Message);
        }

        StateHasChanged();
    }

