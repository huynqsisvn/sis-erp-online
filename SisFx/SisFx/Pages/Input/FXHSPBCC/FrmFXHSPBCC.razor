    /// <summary>WinForm: txtma_ts_PreviewLostKeyboardFocus</summary>
    void OnAutoCompleteCcChanged(ExpandoObject value)
    {
        if (value == null) return;
        CurPh.Ma_cc_me = value.FirstOrDefault(a => a.Key == "ma_cc_me").Value?.ToString()
                         ?? value.FirstOrDefault(a => a.Key == "ma_cc").Value?.ToString() ?? "";
        CurPh.Ten_cc   = value.FirstOrDefault(a => a.Key == "ten_cc").Value?.ToString() ?? "";
        CurPh.Tk_cp    = value.FirstOrDefault(a => a.Key == "tk_cp").Value?.ToString() ?? "";
        CurPh.Ma_phi   = value.FirstOrDefault(a => a.Key == "ma_phi").Value?.ToString() ?? "";

        string maBpht = value.FirstOrDefault(a => a.Key == "ma_bpht").Value?.ToString() ?? "";
        string maVv   = value.FirstOrDefault(a => a.Key == "ma_vv").Value?.ToString() ?? "";

        // WinForm: Add + grid trống → tự tạo dòng đầu với tk_cp, ma_bpht, ma_vv từ dmcc
        if ((curActionTask == ActionTask.New || curActionTask == ActionTask.Copy) && LSCt.Count == 0)
        {
            LSCt.Add(new CtBpcc
            {
                Ma_cc_me = CurPh.Ma_cc_me,
                Ma_bpcc  = CurPh.Ma_bpcc,
                Tk_cp    = CurPh.Tk_cp,
                Ma_bpht  = maBpht,
                Ma_vv    = maVv
            });
        }
        StateHasChanged();
    }

    /// <summary>WinForm: txtma_bpts_PreviewLostKeyboardFocus</summary>
    void OnAutoCompleteBpccChanged(ExpandoObject value)
    {
        if (value == null) return;
        CurPh.Ma_bpcc  = value.FirstOrDefault(a => a.Key == "ma_bpts").Value?.ToString() ?? "";
        CurPh.Ten_bpcc = value.FirstOrDefault(a => a.Key == "ten_bpts").Value?.ToString() ?? "";

        foreach (var ct in LSCt)
        {
            ct.Ma_bpcc  = CurPh.Ma_bpcc;
            ct.Ma_cc_me = CurPh.Ma_cc_me;
        }
        StateHasChanged();
    }

