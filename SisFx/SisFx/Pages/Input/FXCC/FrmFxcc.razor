                            <DxSpinEdit Value="@item.Gt_cl" DisplayFormat="N0" ShowSpinButtons="false" ReadOnly="true" Enabled="false" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Gt_kh_ky" Caption="@Lap["Alloc. value/period"]" Width="130px" DisplayFormat="N0">
                        <CellEditTemplate Context="ctx">
                            @{ var item = (CtDmcc)ctx.EditModel; }
                            <DxSpinEdit Value="@item.Gt_kh_ky" DisplayFormat="N0" ShowSpinButtons="false" ReadOnly="true" Enabled="false" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Tk_cp" Caption="@Lap["Expense acc."]" Width="110px">
                        <CellEditTemplate Context="ctx">
                            @{ var item = (CtDmcc)ctx.EditModel; }
                            <AutocompleteComponent Ma_dm="dmtk1" @bind-Value="@item.Tk_cp"
                                                   IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Ma_bpht" Caption="@Lap["Cost dept"]" Width="100px">
                        <CellEditTemplate Context="ctx">
                            @{ var item = (CtDmcc)ctx.EditModel; }
                            <AutocompleteComponent Ma_dm="dmbpht" Filter="1=1" @bind-Value="@item.Ma_bpht"
                                                   IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Ma_px" Caption="@Lap["Workshop"]" Width="100px">
                        <CellEditTemplate Context="ctx">
                            @{ var item = (CtDmcc)ctx.EditModel; }
                            <AutocompleteComponent Ma_dm="dmpx" Filter="1=1" @bind-Value="@item.Ma_px"
                                                   IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Ma_vv" Caption="@Lap["Project"]" Width="100px">
                        <CellEditTemplate Context="ctx">
                            @{ var item = (CtDmcc)ctx.EditModel; }
                            <AutocompleteComponent Ma_dm="dmvv" Filter="1=1" @bind-Value="@item.Ma_vv"
                                                   IsEnable="@AllowEditMode" IsLangEn="@IsLangEn" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Ghi_chu" Caption="@Lap["Note"]" MinWidth="120">
                        <CellEditTemplate Context="ctx">
                            @{ var item = (CtDmcc)ctx.EditModel; }
                            <DxTextBox @bind-Text="@item.Ghi_chu" CssClass="w-100" />
                        </CellEditTemplate>
                    </DxGridDataColumn>
                </Columns>
                <TotalSummary>
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Sl_cc"      DisplayText="{0:N2}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Nguyen_gia" DisplayText="{0:N0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Gt_da_kh"   DisplayText="{0:N0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Gt_cl"      DisplayText="{0:N0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Gt_kh_ky"   DisplayText="{0:N0}" />
                </TotalSummary>
            </DxGrid>
        </div>
    </div>

</FormList>

