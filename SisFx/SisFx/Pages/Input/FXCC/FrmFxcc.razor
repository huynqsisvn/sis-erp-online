@code {
    protected override void OnInitialized()
    {
        sqlTableName = "dmcc";
        SqlTableKey = "ma_cc_me";
        Itemsizemode = SizeMode.Medium;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            switch (curActionTask)
            {
                case ActionTask.New:
                    CreateNewDM();
                    break;
                case ActionTask.Edit:
                case ActionTask.View:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await LoadData(Ma_ma);
                    break;
                case ActionTask.Copy:
                    if (!string.IsNullOrEmpty(Ma_ma))
                        await CopyDM(Ma_ma);
                    break;
            }
            StateHasChanged();

            Pageobj = DotNetObjectReference.Create(this);
            await JavacriptS.InvokeVoidAsync("SetPageObj", Pageobj);
            await JavacriptS.InvokeVoidAsync("AttachEnterAsTab");
            await Task.Delay(200);

            if ((curActionTask == ActionTask.New || curActionTask == ActionTask.Copy) && txtMaCcMe != null)
                await txtMaCcMe.FocusAsync();
            else if (curActionTask == ActionTask.Edit && txtMaTraCuu != null)
                await txtMaTraCuu.FocusAsync();
        }

        if (AllowEditMode)
        {
            try { await JavacriptS.InvokeVoidAsync("changeTextNewRowButton", "Click vào đây để thêm dòng mới"); }
            catch { }
        }
    }

    public void CloseForm()
    {
        if (ShowAdd == true) OnClose.InvokeAsync();
        else myNavi.NavigateTo("/" + ParentPage);
    }

    public void CancelForm()
    {
        CloseForm();
    }
}

