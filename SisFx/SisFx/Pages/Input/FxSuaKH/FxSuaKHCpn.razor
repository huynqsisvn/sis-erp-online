@page "/fxsuakh"
@page "/fxsuakh/{Menu_id}"
@inherits FxSuaKHBase
@attribute [Authorize(Roles = "admin,fxsuakh")]
@using SisFx.Pages.Input.FxSuaKH
@using DevExpress.Blazor
@using System.Data

@* ================================================================
   LƯỚI KẾT QUẢ — FrmBrowse3Component có cột Chọn (tag)
   ================================================================ *@
<div class="row mt-1" tabindex="0" onkeydown="_handleFunctionKeys(event);">
    <FrmBrowse3Component @ref="oBrowse3"
                         TblData="@TblData"
                         Fbrowse="@fbrowse"
                         Page_size="@Page_size"
                         SelectItem="CurItem"
                         SelectCol="tag"
                         IsLangEn="@IsLangEn">
    </FrmBrowse3Component>
</div>

@* ================================================================
   POPUP FILTER
   ================================================================ *@
<DxPopup @ref="popFilter"
         CloseOnOutsideClick="false"
         CssClass="dxPopup"
         @bind-Visible="@PopupVisible"
         Width="560px"
         ShowFooter="true"
         Context="windowContext"
         HeaderText="@Lap["Adjust tool allocation - Filter"]">
    <BodyTemplate>
        @if (ShowLoadding)
        {
            <div class="d-flex justify-content-center align-items-center p-4">
                <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;border-width:3px;">
                    <span class="sr-only">@Lap["Filtering data..."]</span>
                </div>
                <span class="ms-3 fs-6 text-primary">@Lap["Loading data, please wait..."]</span>
            </div>
        }
        else
        {
            <div class="container pt-1 pb-2">
                <DxFormLayout CssClass="w-100" onkeydown="ModifyEnterKeyPressAsTab(event);">

                    @* --- NĂM --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Year:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div style="width:75%;">
                                <DxSpinEdit @bind-Value="@FilterNam"
                                            DisplayFormat="####"
                                            MinValue="2000"
                                            MaxValue="2099" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- TỪ KỲ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["From period (1-12):"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy1"
                                                MinValue="1" MaxValue="12"
                                                ValueChanged="@((int v) => { FilterKy1 = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy1 >= 1 && FilterKy1 <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy1, 1).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- ĐẾN KỲ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["To period (1-12):"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:75%;">
                                    <DxSpinEdit Value="@FilterKy2"
                                                MinValue="1" MaxValue="12"
                                                ValueChanged="@((int v) => { FilterKy2 = v; StateHasChanged(); })" />
                                </div>
                                @if (FilterNam > 0 && FilterKy2 >= 1 && FilterKy2 <= 12)
                                {
                                    <span class="badge text-dark">
                                        @(new DateTime(FilterNam, FilterKy2, 1).AddMonths(1).AddDays(-1).ToString("MM/yyyy"))
                                    </span>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- DANH SÁCH CÔNG CỤ --- *@
                    <DxFormLayoutItem ColSpanMd="12" Caption="@Lap["Tool list:"]" CaptionCssClass="fw-bold">
                        <Template>
                            <div class="d-flex gap-2">
                                <DxTextBox Value="@FilterKeyCc"
                                           ReadOnly="true"
                                           CssClass="flex-grow-1"
                                           NullText="@Lap["All tools"]" />
                                <DxButton Text="@Lap["Select tools"]"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          IconCssClass="fa fa-list"
                                          Click="@OpenDmccModal" />
                                @if (!string.IsNullOrEmpty(FilterKeyCc))
                                {
                                    <DxButton Text=""
                                              RenderStyle="ButtonRenderStyle.Danger"
                                              IconCssClass="fa fa-times"
                                              title="@Lap["Clear tool selection"]"
                                              Click="@ClearKeyCc" />
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    @* --- CHECKBOX LỌC CÔNG CỤ ĐÃ ĐIỀU CHỈNH --- *@
                    <DxFormLayoutItem ColSpanMd="12">
                        <Template>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="chkSuaKh"
                                       checked="@FilterSuaKh"
                                       @onchange="@((ChangeEventArgs e) => { FilterSuaKh = e.Value is bool b && b; StateHasChanged(); })" />
                                <label class="form-check-label" for="chkSuaKh">
                                    @Lap["Show tools already adjusted"]
                                </label>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                </DxFormLayout>

                @if (FilterErrors.Any())
                {
                    <div class="alert alert-danger mt-2 p-2 mb-0">
                        <ul class="mb-0 ps-3">
                            @foreach (var err in FilterErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!ShowLoadding)
        {
            <div class="d-flex justify-content-end gap-2 m-2">
                <DxButton RenderStyle="ButtonRenderStyle.Success"
                          Text="@Lap["Filter data"]"
                          IconCssClass="fa fa-search"
                          Click="@BtnFilter_Click" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="@Lap["Close"]"
                          Click="@CloseFilter" />
            </div>
        }
    </FooterTemplate>
</DxPopup>

@* ================================================================
   MODAL CHỌN CÔNG CỤ
   ================================================================ *@
@if (ShowModalDmcc)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title mb-0">
                        <i class="fa fa-list me-2"></i>@Lap["Select tools"]
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModalDmcc"></button>
                </div>
                <div class="modal-body p-2">
                    <div class="mb-2 d-flex gap-2">
                        <DxTextBox @bind-Text="@DmccSearch"
                                   NullText="@Lap["Find tool code/name..."]"
                                   CssClass="flex-grow-1" />
                        <DxButton Text="@Lap["Search"]"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  Click="@(_ => DoSearchDmcc())" />
                        <DxButton Text="@Lap["Select all"]"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@SelectAllDmcc" />
                        <DxButton Text="@Lap["Deselect"]"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  Click="@ClearDmccSelection" />
                    </div>

                    @if (TblDmcc == null)
                    {
                        <div class="text-center p-3 text-muted">@Lap["Loading tool list..."]</div>
                    }
                    else if (TblDmcc.Rows.Count == 0)
                    {
                        <div class="alert alert-warning p-2 mb-0">@Lap["No tools available."]</div>
                    }
                    else
                    {
                        <div style="max-height:380px; overflow-y:auto;">
                            <table class="table table-sm table-hover table-bordered mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width:42px;" class="text-center">
                                            <input type="checkbox"
                                                   checked="@IsAllDmccChecked"
                                                   @onchange="@ToggleAllDmcc" />
                                        </th>
                                        <th>@Lap["Tool Code"]</th>
                                        <th>@Lap["Tool Name"]</th>
                                        <th>@Lap["Company Unit"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow row in TblDmcc.Rows)
                                    {
                                        string maCc = row["ma_cc_me"]?.ToString() ?? "";
                                        bool isChecked = SelectedDmcc.Contains(maCc);
                                        <tr class="@(isChecked ? "table-primary" : "")"
                                            style="cursor:pointer;"
                                            @onclick="@(() => ToggleDmccRow(maCc))">
                                            <td class="text-center" @onclick:stopPropagation>
                                                <input type="checkbox"
                                                       checked="@isChecked"
                                                       @onchange="@(() => ToggleDmccRow(maCc))"
                                                       @onclick:stopPropagation />
                                            </td>
                                            <td>@maCc</td>
                                            <td>@(IsLangEn ? row["ten_cc2"]?.ToString() : row["ten_cc"]?.ToString())</td>
                                            <td>@row["ma_dvcs"]?.ToString()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-muted small mt-1">
                            @Lap["Selected"] <strong>@SelectedDmcc.Count</strong> / @TblDmcc.Rows.Count @Lap["tools"]
                        </div>
                    }
                </div>
                <div class="modal-footer py-2 gap-2">
                    <DxButton RenderStyle="ButtonRenderStyle.Success"
                              Text="@ConfirmBtnText"
                              IconCssClass="fa fa-check"
                              Click="@ConfirmDmccSelection" />
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@Lap["Close"]"
                              Click="@CloseModalDmcc" />
                </div>
            </div>
        </div>
    </div>
}

@* ================================================================
   FORM SỬA / ĐIỀU CHỈNH PHÂN BỔ (F3) — DxWindow
   ================================================================ *@
@if (IsShowFrm && FrmType != null)
{
    <DxWindow @bind-Visible="@IsShowFrm"
              CloseOnEscape="true"
              Width="25vw"
              MinWidth="350px"
              Scrollable="true"
              MaxHeight="98vh"
              AllowResize="true"
              AllowDrag="true"
              AllowDragByHeaderOnly="true"
              ShowFooter="false">
        <BodyTemplate>
            <DynamicComponent Type="@FrmType" Parameters="@Par" />
        </BodyTemplate>
    </DxWindow>
}
